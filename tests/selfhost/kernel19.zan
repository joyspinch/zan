class Animal { public string Name; public Animal(string n) { Name = n; } public virtual string Speak() { return "..."; } }
class Dog : Animal {
    public Dog(string n) : base(n) { }
    public override string Speak() { return "woof"; }
    public string Fetch() { return "ball"; }
}
class Cat : Animal {
    public Cat(string n) : base(n) { }
    public override string Speak() { return "meow"; }
}
class Box {
    public int V;
    public Box(int a, int b = 2) { V = a * b; }
}
internal class Helper {
    internal static int Mul(int a, int b = 2) { return a * b; }
}
class Program {
    static int Triple(int x, int step = 10) { return x + step; }
    static void Main() {
        Animal a = new Dog("rex");
        Animal c = new Cat("tom");
        // as: downcast success
        Dog d = a as Dog;
        Console.WriteLine(d != null);
        Console.WriteLine(d.Fetch());
        // as: downcast failure -> null
        Dog d2 = c as Dog;
        Console.WriteLine(d2 == null);
        // as: upcast/identity passes through
        Animal a2 = a as Animal;
        Console.WriteLine(a2.Name);
        // as with unrelated classes
        Box bx = new Box(3);
        object o = bx;
        Cat c3 = o as Cat;
        Console.WriteLine(c3 == null);
        // as on null
        Animal nul = null;
        Dog d3 = nul as Dog;
        Console.WriteLine(d3 == null);
        // binary literals
        int b1 = 0b1010;
        int b2 = 0b11111111;
        long b3 = 0b1000000000000000L;
        Console.WriteLine(b1 + b2);
        Console.WriteLine(b3);
        int hx = 0xFF378ADD;
        Console.WriteLine(hx);
        // internal modifier accepted
        Console.WriteLine(Helper.Mul(3));
        Console.WriteLine(Helper.Mul(3, 5));
        // default args on static method
        Console.WriteLine(Triple(1));
        Console.WriteLine(Triple(1, 100));
        // default args in constructor
        Box bxa = new Box(3);
        Box bxb = new Box(3, 10);
        Console.WriteLine(bxa.V);
        Console.WriteLine(bxb.V);
        // is still fine alongside as
        Console.WriteLine(a is Dog);
        Console.WriteLine(c is Dog);
    }
}
