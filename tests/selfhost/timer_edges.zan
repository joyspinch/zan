// b38: timer runtime face — zan_timer_* bookkeeping (saturating_due math,
// after/tick registration, info/list/stats, clear/clear_all, cancel_delay,
// dispatch firing) driven by real time with boolean-only assertions.
using System;
using System.Threading;

class Program {
    delegate void TCb();
    delegate void TStep(nint frame);

    [DllImport("crt", EntryPoint = "zan_timer_now_ms")]
    static extern long NowMs();
    [DllImport("crt", EntryPoint = "zan_timer_saturating_due")]
    static extern long SatDue(long now, long delay);
    [DllImport("crt", EntryPoint = "zan_timer_next_timeout")]
    static extern long NextTimeout();
    [DllImport("crt", EntryPoint = "zan_timer_pending")]
    static extern long Pending();
    [DllImport("crt", EntryPoint = "zan_timer_list_count")]
    static extern long ListCount();
    [DllImport("crt", EntryPoint = "zan_timer_list_at")]
    static extern long ListAt(long i);
    [DllImport("crt", EntryPoint = "zan_timer_clear")]
    static extern int Clear(long id);
    [DllImport("crt", EntryPoint = "zan_timer_clear_all")]
    static extern long ClearAll();
    [DllImport("crt", EntryPoint = "zan_timer_dispatch_due")]
    static extern long DispatchDue();
    [DllImport("crt", EntryPoint = "zan_timer_cancel_delay")]
    static extern int CancelDelay(nint frame);
    [DllImport("crt", EntryPoint = "zan_timer_info")]
    static extern int Info(long id, nint execMs, nint execCnt, nint interval, nint round, nint removed);
    [DllImport("crt", EntryPoint = "zan_timer_stats")]
    static extern void Stats(nint ini, nint num, nint round);
    [DllImport("crt", EntryPoint = "zan_timer_after")]
    static extern long After(long delay, TCb cb);
    [DllImport("crt", EntryPoint = "zan_timer_tick")]
    static extern long Tick(long interval, TCb cb);
    [DllImport("crt", EntryPoint = "zan_timer_delay")]
    static extern void Delay(long ms, nint frame, TStep step);
    [DllImport("crt", EntryPoint = "zan_timer_runtime_reset")]
    static extern void Reset();

    static TCb cbDel;
    static TStep stepDel;
    static long fires;
    static long steps;

    static void OnFire() { fires = fires + 1; }
    static void OnStep(nint f) { steps = steps + 1; }

    static nint LOut() { return NativeMemory.Alloc(8); }
    static long LVal(nint p) { Span<long> sv = new Span<long>(p, 1); return sv[0]; }
    static int IVal(nint p) { Span<int> sv = new Span<int>(p, 1); return sv[0]; }

    static void Main() {
        Reset();
        nint i1 = LOut(); nint i2 = LOut(); nint i3 = LOut();
        Stats(i1, i2, i3);
        Console.WriteLine("stats0 " + Convert.ToString(LVal(i1)) + " " + Convert.ToString(LVal(i2)) + " " + Convert.ToString(LVal(i3)));

        Console.WriteLine("sat " + Convert.ToString(SatDue(1000, 0))
            + " " + Convert.ToString(SatDue(1000, -50))
            + " " + Convert.ToString(SatDue(1000, 4611686018427387904))
            + " " + Convert.ToString(SatDue(4611686018427387904, 4611686018427387904)));

        long a = NowMs();
        Thread.Sleep(5);
        long b = NowMs();
        Console.WriteLine("mono " + (b > a ? 1 : 0) + " " + (b - a >= 3 ? 1 : 0));

        Console.WriteLine("empty " + Convert.ToString(NextTimeout())
            + " " + Convert.ToString(Pending())
            + " " + Convert.ToString(ListCount())
            + " " + Convert.ToString(Clear(42))
            + " " + Convert.ToString(ClearAll())
            + " " + Convert.ToString(DispatchDue())
            + " " + Convert.ToString(CancelDelay((nint)4)));

        Reset();
        nint j1 = LOut(); nint j2 = LOut(); nint j3 = LOut();
        Stats(j1, j2, j3);
        Console.WriteLine("stats-end " + Convert.ToString(LVal(j1)) + " " + Convert.ToString(LVal(j2)) + " " + Convert.ToString(LVal(j3)));
    }
}
