// kernel13: slice 12 -- char literals, short-circuit &&/||, Convert.*,
// x.ToString() scalars, X.Parse, Math trig/Round, Substring(start,len),
// static methods via class name
using System;
class Pt {
    int x;
    public Pt(int xv) { x = xv; }
    public static Pt Of(int v) { return new Pt(v); }
    public int Get() { return x; }
    public override string ToString() { return "Pt(" + x.ToString() + ")"; }
}
class P {
    static int failures = 0;
    static void Check(bool ok, string tag) {
        if (ok) { Console.WriteLine("ok " + tag); }
        else { failures = failures + 1; Console.WriteLine("FAIL " + tag); }
    }
    static int Main() {
        char c = 'A';
        Check(c == 65, "charlit-code");
        Console.WriteLine(c);
        Console.WriteLine("t" + 'x');
        bool t = true; bool f = false;
        Check(t && !f, "and");
        Check(f || t, "or");
        Check(!(t && f), "and-false");
        bool sc1 = false && Bump();
        bool sc2 = true || Bump();
        Check(bumps == 0, "short-circuit " + bumps.ToString());
        Check(Convert.ToString(42) == "42", "conv-int");
        Check(Convert.ToString(3.5) == "3.5", "conv-dbl");
        Check(Convert.ToString('c') == "c", "conv-char");
        Check(Convert.ToString("cp") == "cp", "conv-str");
        Check(Convert.ToInt32("123") == 123, "conv-i32");
        Check(Convert.ToInt64("-45") == -45, "conv-i64");
        Check(Convert.ToDouble("2.25") == 2.25, "conv-dbl-p");
        int n = 7;
        Check(n.ToString() == "7", "int-tostr");
        Check((n == 7).ToString() == "true", "bool-tostr");
        Check((2.5).ToString() == "2.5", "dbl-tostr");
        Check(int.Parse("124") == 124, "int-parse");
        Check(double.Parse("2.75") == 2.75, "dbl-parse");
        Check(Math.Sin(0.0) == 0.0, "sin0");
        Check(Math.Cos(0.0) == 1.0, "cos0");
        Check(Math.Round(2.567, 2) == 2.57, "round2");
        Check(Math.Round(2.5) == 3.0, "round1");
        Check("hello world".Substring(6, 5) == "world", "substr2");
        Check("hi".Substring(0, 100) == "", "substr2-clamp");
        Pt p = Pt.Of(9);
        Check(p.Get() == 9, "static-of");
        Check(p.ToString() == "Pt(9)", "cls-tostr");
        if (failures == 0) { Console.WriteLine("kernel13 ok"); }
        else { Console.WriteLine("kernel13 failures=" + Convert.ToString(failures)); }
        return 0;
    }
    static int bumps = 0;
    static bool Bump() { bumps = bumps + 1; return true; }
}
