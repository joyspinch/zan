// kernel7: doubles slice -- float literals, arithmetic with int coercion,
// ordered comparisons, WriteLine of double/bool, and double/string concat.
class K7 {
    static double Rate() { return 2.5; }
    static void Main() {
        double d = 2.5;
        Console.WriteLine(d);
        Console.WriteLine(d * 2);
        Console.WriteLine(d + 0.5);
        Console.WriteLine(d - 1);
        Console.WriteLine(d / 4);
        Console.WriteLine("d=" + d);
        Console.WriteLine(d + "!");
        int i = 7;
        Console.WriteLine(i + d);
        Console.WriteLine(d > 9.0);
        Console.WriteLine(d < 9.0);
        Console.WriteLine(d == 2.5);
        Console.WriteLine(d != 2.5);
        Console.WriteLine(d >= 2.5);
        Console.WriteLine(d <= 1.0);
        Console.WriteLine("rate=" + Rate());
        bool t = true;
        bool f = false;
        Console.WriteLine(t);
        Console.WriteLine(f);
        Console.WriteLine(i != 7);
        Console.WriteLine("done");
    }
}
