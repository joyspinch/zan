// b34: single-threaded determinism probe for the sync primitives —
// AtomicInt full op roundtrip, thread-id self-equality, and
// SharedTable cross-table isolation (two tables, same key, different
// values).
using System;
using System.Threading;

class Program {
    static void Main() {
        AtomicInt a = new AtomicInt(5);
        Console.WriteLine("valid: " + (a.IsValid() ? 1 : 0));
        Console.WriteLine("load: " + Convert.ToString(a.Load()));
        Console.WriteLine("add: " + Convert.ToString(a.Add(7)));
        Console.WriteLine("add-neg: " + Convert.ToString(a.Add(-100)));
        Console.WriteLine("exch: " + Convert.ToString(a.Exchange(100)));
        Console.WriteLine("cas-hit: " + Convert.ToString(a.CompareExchange(100, 42)));
        Console.WriteLine("load2: " + Convert.ToString(a.Load()));
        Console.WriteLine("cas-miss: " + Convert.ToString(a.CompareExchange(99, 1)));
        Console.WriteLine("load3: " + Convert.ToString(a.Load()));
        a.Store(-5);
        Console.WriteLine("load4: " + Convert.ToString(a.Load()));
        Console.WriteLine("inc: " + Convert.ToString(a.Increment()));
        Console.WriteLine("dec: " + Convert.ToString(a.Decrement()));

        long id1 = Thread.CurrentId();
        long id2 = Thread.CurrentId();
        Console.WriteLine("tid-eq: " + (id1 == id2 ? 1 : 0));
        Console.WriteLine("tid-nz: " + (id1 != 0 ? 1 : 0));

        SharedTable t1 = new SharedTable("st_sync_a", 16);
        t1.KeySize(32);
        t1.ColumnInt("v");
        SharedTable t2 = new SharedTable("st_sync_b", 16);
        t2.KeySize(32);
        t2.ColumnInt("v");
        Console.WriteLine("mk1: " + (t1.Create() ? 1 : 0));
        Console.WriteLine("mk2: " + (t2.Create() ? 1 : 0));
        Console.WriteLine("s1: " + (t1.SetInt("dup", "v", 11) ? 1 : 0));
        Console.WriteLine("s2: " + (t2.SetInt("dup", "v", 22) ? 1 : 0));
        Console.WriteLine("g1: " + Convert.ToString(t1.GetInt("dup", "v")));
        Console.WriteLine("g2: " + Convert.ToString(t2.GetInt("dup", "v")));
        Console.WriteLine("c1: " + Convert.ToString(t1.Count()));
        Console.WriteLine("c2: " + Convert.ToString(t2.Count()));
        Console.WriteLine("x1: " + (t1.Exists("dup") ? 1 : 0));
        Console.WriteLine("del-t2: " + (t2.Delete("dup") ? 1 : 0));
        Console.WriteLine("x1b: " + (t1.Exists("dup") ? 1 : 0));
        Console.WriteLine("d1: " + (t1.Destroy() ? 1 : 0));
        Console.WriteLine("d2: " + (t2.Destroy() ? 1 : 0));
    }
}
