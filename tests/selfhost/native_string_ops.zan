using System;
namespace NativeStringOps;

class Buffer {
    public string data;
}
class Program {
    static int order;
    static string changing;
    static string MutatingNeedle() { changing[1] = 0; return ""; }
    static string Receiver() { order = order * 10 + 1; return "ababa"; }
    static string Needle() { order = order * 10 + 3; return "ba"; }
    static int Start() { order = order * 10 + 2; return 2; }
    static int Value() { order = order * 10 + 1; return 90; }
    static int At() { order = order * 10 + 3; return 1; }
    static void Opaque(string s) { s[2] = 'Z'; s[-1] = 'P'; }

    // Optional isolated failure probes: the C/IR methods pass null through to
    // libc, so these must NOT be run in the ordinary golden-output process.
    // Run each with gen0 and native; compare abnormal termination, not stdout.
    static void NullProbe(string mode) {
        string n = null;
        if (mode == "null-replace-recv") { Console.WriteLine(n.Replace("a", "b")); }
        if (mode == "null-replace-old") { Console.WriteLine("abc".Replace(n, "b")); }
        if (mode == "null-replace-new") { Console.WriteLine("abc".Replace("a", n)); }
        if (mode == "null-index-recv") { Console.WriteLine(n.IndexOf("a")); }
        if (mode == "null-index-needle") { Console.WriteLine("abc".IndexOf(n)); }
        if (mode == "null-index2-recv") { Console.WriteLine(n.IndexOf("a", 0)); }
        if (mode == "null-index2-needle") { Console.WriteLine("abc".IndexOf(n, 0)); }
    }

    static void Main() {
        if (Environment.ArgCount() > 0) { NullProbe(Environment.ArgAt(0)); return; }
        Console.WriteLine("aaaaa".Replace("aa", "X"));
        Console.WriteLine("banana".Replace("a", "XYZ"));
        Console.WriteLine("banana".Replace("na", ""));
        Console.WriteLine("abc".Replace("missing", "x"));
        Console.WriteLine("[" + "".Replace("a", "b") + "]");
        Console.WriteLine("abc".Replace("abc", ""));
        Console.WriteLine("abc".Replace("", "insert"));
        Console.WriteLine("abc".Replace("b", "b"));
        Console.WriteLine("abc".Replace("a", "bb").Replace("bb", "Z"));
        Console.WriteLine("aba".Replace("a", "XYZ").Length);
        string original = "abc".Substring(0, 3);
        string copy = original.Replace("", "x");
        copy[0] = 'Z';
        Console.WriteLine(original); Console.WriteLine(copy);
        string nohit = original.Replace("absent", "x");
        nohit[1] = 'Q';
        Console.WriteLine(original); Console.WriteLine(nohit);

        Console.WriteLine("ababa".IndexOf("ba"));
        Console.WriteLine("ababa".IndexOf("ba", 2));
        Console.WriteLine("ababa".IndexOf("ba", 3));
        Console.WriteLine("ababa".IndexOf("ba", 4));
        Console.WriteLine("ababa".IndexOf("ba", -1));
        Console.WriteLine("ababa".IndexOf("ba", 6));
        Console.WriteLine("ababa".IndexOf("", 5));
        Console.WriteLine("ababa".IndexOf("a", 5));
        Console.WriteLine("ababa".IndexOf("", 0));
        Console.WriteLine("".IndexOf(""));
        Console.WriteLine("".IndexOf("", 0));
        Console.WriteLine("abc".IndexOf("missing"));
        Console.WriteLine("abc".IndexOf("abc"));
        Console.WriteLine("中文abc".IndexOf("a", 0));
        int sum = 0;
        for (int i = 0; i < 100; i++) { sum = sum + "0123456789abc".IndexOf("abc"); }
        Console.WriteLine(sum);
        order = 0;
        Console.WriteLine(Receiver().IndexOf(Needle(), Start()));
        Console.WriteLine(order);
        changing = "abcd".Substring(0, 4);
        Console.WriteLine(changing.IndexOf(MutatingNeedle(), 3)); // length precedes needle
        Console.WriteLine(changing.Length);

        string bytes = "abcd".Substring(0, 4);
        bytes[1] = 321; // truncates to 'A', never overwrites adjacent bytes
        Console.WriteLine(bytes);
        bytes[-1] = 'N'; // gen0 soft boundary: writes index zero
        Console.WriteLine(bytes);
        bytes[4] = 'E';
        Console.WriteLine(bytes);
        bytes[100000000] = 'H';
        Console.WriteLine(bytes);
        bytes[2] = 0; // cache must follow embedded NUL
        Console.WriteLine(bytes.Length);
        Console.WriteLine(bytes.Replace("A", "zz"));
        Console.WriteLine(bytes.IndexOf("", 2));
        Console.WriteLine(bytes.IndexOf("", 3));
        Buffer b = new Buffer();
        b.data = "abcd".Substring(0, 4);
        order = 0;
        b.data[At()] = Value();
        Console.WriteLine(order); Console.WriteLine(b.data);
        b.data[1] = 0;
        Opaque(b.data); // parameter upper bound is deliberately unchecked
        b.data[1] = 'R'; // field upper bound is deliberately unchecked too
        Console.WriteLine(b.data);
        Console.WriteLine(b.data.Length);
        string n = null;
        n[100000000] = 65; // writes scratch[0], does not change the null local
        Console.WriteLine(n == null);
        Console.WriteLine("string-ops-ok");
    }
}
