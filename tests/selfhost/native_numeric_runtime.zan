using System;

// Run through the native backend with EmitNumericRuntime integrated.
// Covers shortest precision, G's fixed [-4,14] window (not %g), both
// string-returning paths and Console's d0 ABI. The temporary C ABI probe
// additionally exercises bounded buffers and non-null parse end pointers.
class NativeNumericRuntime {
    static int failures = 0;
    static void Show(string input) {
        double value = double.Parse(input);
        string text = value.ToString();
        Console.WriteLine(text);
        if (double.Parse(text) != value) { failures = failures + 1; }
        if (Convert.ToString(value) != text) { failures = failures + 1; }
        // Exercise owned-string metadata and lifetime, not just raw printf.
        string wrapped = "[" + text + "]";
        if (wrapped.Length != text.Length + 2) { failures = failures + 1; }
    }
    static int Main() {
        Show("0");
        Show("-0");
        Show("1");
        Show("-1");
        Show("0.1");
        Show("1.2345678901234567");
        Show("3.141592653589793");
        Show("1.0000000000000002");
        Show("0.9999999999999999");
        Show("1.234567890123456e14");
        Show("1e14");
        Show("1e15");
        Show("1e-4");
        Show("1e-5");
        Show("-1e15");
        Show("-1e-5");
        Show("9.999999999999999e-5");
        Show("9.999999999999999e14");
        Show("1.234e-4");
        Show("1.234e-3");
        Show("12.5");
        Show("1200");
        Show("1e99");
        Show("1e100");
        Show("1e-99");
        Show("1e-100");
        Show("5e-324");
        Show("-5e-324");
        Show("2.225073858507201e-308");
        Show("2.2250738585072014e-308");
        Show("1.7976931348623157e308");
        Show("-1.7976931348623157e308");
        Show("Infinity");
        Show("+Infinity");
        Show("-Infinity");
        Show("1e309");
        Show("-1e-999");
        Show("  12.5suffix");
        Show("not-a-number");
        Show("0x1.8p+2");
        double nan = double.Parse("NaN");
        Console.WriteLine(nan);
        Console.WriteLine(nan.ToString());
        double direct = double.Parse("3.141592653589793");
        Console.WriteLine(direct);
        Console.WriteLine(Convert.ToDouble("-Infinity"));
        if (nan == nan) { failures = failures + 1; }
        Console.WriteLine("failures=" + failures.ToString());
        return failures;
    }
}
