using System;
using System.IO;
using Platform;

// ZAN_TARGET 条件编译(lexer 平台 define 跟目标走)的永久金标:
// (1) 平台谓词恰好一个为真(WINDOWS/WASI 不可达)——交叉编译报告目标
//     而非宿主(stdlib Platform/Runtime.zan 的契约),macOS 无环境跑
//     出 macos=1/linux=0,guest(ZAN_TARGET=aarch64-linux)跑出 0/1,
//     两车道总和恒 1,金标不变;
// (2) dirent 布局臂随目标翻转(macOS 20/21,Linux 18/19):两车道都
//     必须能枚举出刚写的文件——翻转前的 guest 车道用 Darwin 偏移读
//     musl 的 glibc 布局 dirent,枚举名从 +2 字节起必错。
class NativeRetarget {
    static void Main() {
        int macos = Runtime.IsMacOS() ? 1 : 0;
        int linux = Runtime.IsLinux() ? 1 : 0;
        Console.WriteLine(macos + linux);
        File.WriteAllText("native_retarget.tmp", "x");
        List<string> ls = Directory.GetFiles(".");
        int found = 0;
        for (int i = 0; i < ls.Count; i++) {
            if (ls[i] == "native_retarget.tmp") { found = found + 1; }
        }
        Console.WriteLine(found);
    }
}
