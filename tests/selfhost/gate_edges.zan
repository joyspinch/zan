// b38: coroutine gate face — counting wait primitive (new/signal/park/free)
// over the single-thread CO driver. Surplus signals bank before parking,
// waiters wake FIFO, free re-readies stragglers, null handle short-circuits.
using System;

class Program {
    delegate void TStep(nint frame);

    [DllImport("crt", EntryPoint = "zan_gate_new")]
    static extern long GateNew();
    [DllImport("crt", EntryPoint = "zan_gate_signal")]
    static extern void GateSignal(long h);
    [DllImport("crt", EntryPoint = "zan_gate_free")]
    static extern void GateFree(long h);
    [DllImport("crt", EntryPoint = "zan_gate_park")]
    static extern void GatePark(long h, nint frame, TStep step);
    [DllImport("crt", EntryPoint = "zan_co_sched_init")]
    static extern void CoInit();
    [DllImport("crt", EntryPoint = "zan_co_sched_run_until")]
    static extern void CoRunUntil(nint done);
    [DllImport("crt", EntryPoint = "zan_co_pending")]
    static extern long CoPending();

    static int Main() {
        CoInit();
        long h1 = GateNew();
        long h2 = GateNew();
        Console.WriteLine("handles " + (h1 != 0 ? 1 : 0) + " " + (h2 != 0 ? 1 : 0)
            + " " + (h1 != h2 ? 1 : 0));
        GateSignal(h1);
        GateSignal(h1);
        Console.WriteLine("signal-ok 1");
        GateSignal(0);
        GateFree(0);
        Console.WriteLine("null-noop 1");
        GateFree(h1);
        GateFree(h2);
        Console.WriteLine("end-pend " + Convert.ToString(CoPending()));
        return 0;
    }
}
