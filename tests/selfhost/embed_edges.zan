// b37: compressed-resource decoder (zan_embed_decode/rawlen) — the runtime
// side of the inline embed API. Payload = [u32 raw_len][u32 comp_len][raw
// deflate]; the length argument must carry the ARC managed-array tag bit
// (1<<62) or the call is rejected. Read API (read/has/bytes/list) is not
// probed: the oracle bakes it per-program (embedres.c), Zan-side that is
// ngen territory.
using System;

class Program {
    [DllImport("crt", EntryPoint = "zan_embed_rawlen")]
    static extern int RawLen(nint payload, nint len);
    [DllImport("crt", EntryPoint = "zan_embed_decode")]
    static extern nint Decode(nint payload, nint len);

    static nint TAG = ((nint)1) << 62;

    static string Phello3 = "120000000a000000cb48cdc9c957c8402201";
    static string Pempty = "00000000020000000300";
    static string Pbytes256 = "";
    static string Pbigtext = "35070000820000002bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a7eb8179a38a47158f2aa6aae297b3b73d5db7f7e9dae9cfd72c7bb2a3efc98eb5cfa6b53fdbbefd59df248594d4b49cc4925485a77dddcff7ac7cb1b5e5d9ae09cfb676bf583f15a466ce9ac70d4da3da47b58f6aa7a77600";
    static string Prand300 = "";
    static string Ptrunc = "1200000005000000cb48cdc9c957c8402201";
    static string Prawsmall = "110000000a000000cb48cdc9c957c8402201";
    static string Pcompleng = "1200000013000000cb48cdc9c957c8402201";
    static string Pemptystream = "1200000000000000";

    static int HexVal(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        return c - 55;
    }

    static nint BufOf(string hex) {
        int n = hex.Length / 2;
        nint p = NativeMemory.Alloc(n + 1);
        int i = 0;
        while (i < n) {
            NativeMemory.Fill(p + i, HexVal(hex[i + i]) * 16 + HexVal(hex[i + i + 1]), 1);
            i = i + 1;
        }
        return p;
    }

    static string Hex16(ulong h) {
        string digits = "0123456789abcdef";
        string s = "";
        int i = 0;
        while (i < 16) {
            s = s + digits.Substring((int)((h >>> (60 - i * 4)) & 15), 1);
            i = i + 1;
        }
        return s;
    }

    // FNV-1a 64 over the buffer, computed Zan-side (the oracle runtime does
    // not export zan_sha256 — added in the Zan lane batch 14 — so digests
    // must come from code both toolchains compile identically)
    static string Digest(nint p, long n) {
        Span<byte> sv = new Span<byte>(p, (int)n);
        ulong h = 14695981039346656037;
        int i = 0;
        while (i < n) {
            h = (h ^ sv[i]) * 1099511628211;
            i = i + 1;
        }
        return Hex16(h);
    }

    // one valid vector: expect rawlen==r and a full decode; digest covers
    // raw_len+1 bytes so the NUL terminator is pinned too
    static void Good(string name, string hex, int r) {
        nint p = BufOf(hex);
        nint tagged = TAG | hex.Length / 2;
        Console.WriteLine(name + " rawlen " + Convert.ToString(RawLen(p, tagged)));
        nint outp = Decode(p, tagged);
        if (outp == 0) {
            Console.WriteLine(name + " decode null");
        } else {
            Console.WriteLine(name + " decode " + Digest(outp, r + 1));
            NativeMemory.Free(outp);
        }
        NativeMemory.Free(p);
    }

    // one malformed vector: expect rawlen/decode to reject
    static void Bad(string name, string hex, int passLen, bool tag) {
        nint p = BufOf(hex);
        nint len = passLen;
        if (tag) { len = len | TAG; }
        Console.WriteLine(name + " rawlen " + Convert.ToString(RawLen(p, len))
            + " decode " + (Decode(p, len) == 0 ? "null" : "NONNULL"));
        NativeMemory.Free(p);
    }

    static void Main() {
        Good("hello3", Phello3, 18);
        Good("empty", Pempty, 0);
        Good("bytes256", Pbytes256, 1024);
        Good("bigtext", Pbigtext, 1845);
        Good("rand300", Prand300, 300);

        // rawlen/decode on an untagged length: rejected outright
        Bad("untagged", Phello3, Phello3.Length / 2, false);
        // payload shorter than the 8-byte header
        Bad("totalshort", Phello3, 4, true);
        // comp_len field beyond the payload
        Bad("compleng", Pcompleng, Pcompleng.Length / 2, true);
        // stream truncated mid-block
        Bad("trunc", Ptrunc, Ptrunc.Length / 2, true);
        // raw_len one short: stream would overflow the buffer
        Bad("rawsmall", Prawsmall, Prawsmall.Length / 2, true);
        // comp_len 0 with a nonzero raw_len: no stream at all
        Bad("emptystream", Pemptystream, Pemptystream.Length / 2, true);
        // rawlen reads the first u32 regardless of the rest
        Bad("rawlenonly", Pbigtext, 8, true);
    }
}
