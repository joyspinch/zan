// Repro attempt 2: mirror the accept-loop shape exactly — loop local assigned
// FROM AN AWAIT, single-ref callee uses the param after its own park.
// Correct: got: 100 / 200 / 300. Bug: same value three times.
using System;
using System.Threading;

class Program {
    static int next = 0;

    static async int NextVal() {
        await Task.Delay(5);
        next = next + 100;
        return next;
    }

    static List<string> slot1 = new List<string>();
    static List<string> slot2 = new List<string>();
    static List<string> slot3 = new List<string>();

    static List<string> SlotOf(int c) {
        if (c == 100) { return Program.slot1; }
        if (c == 200) { return Program.slot2; }
        return Program.slot3;
    }

    static async void ServeLike(int c, List<string> sink) {
        await Task.Delay(30);
        Program.SlotOf(c).Add(Convert.ToString(c));
    }

    static async int Run() {
        List<string> sink = new List<string>();
        for (int i = 0; i < 3; i = i + 1) {
            int c = await Program.NextVal();
            Task.Spawn(Program.ServeLike(c, sink));
        }
        int got = Program.slot1.Count + Program.slot2.Count + Program.slot3.Count;
        for (int i = 0; i < 100 && got < 3; i = i + 1) {
            await Task.Delay(10);
            got = Program.slot1.Count + Program.slot2.Count + Program.slot3.Count;
        }
        Console.WriteLine("got: " + (Program.slot1.Count > 0 ? Program.slot1[0] : "(empty)"));
        Console.WriteLine("got: " + (Program.slot2.Count > 0 ? Program.slot2[0] : "(empty)"));
        Console.WriteLine("got: " + (Program.slot3.Count > 0 ? Program.slot3[0] : "(empty)"));
        return 0;
    }

    static void Main() {
        int _rc = await Run();
    }
}
