using System;
class Pt {
    int x; int y;
    string tag;
    int Sum() { return x + y; }
    string Tag() { return tag; }
}
class Wrap {
    static int Total(Pt p) { return p.Sum(); }
    static void Main() {
        Pt a = new Pt { x = 3, y = 4 };
        Pt b = new Pt { x = 10, y = 20 };
        Console.WriteLine(a.Sum());
        Console.WriteLine(b.Sum());
        Console.WriteLine(Total(a) + Total(b));
    }
}
