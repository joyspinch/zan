class K {
    static int Fib(int n) { if (n < 2) { return n; } return Fib(n - 1) + Fib(n - 2); }
    static int Add(int a, int b) { return a + b; }
    static void Main() {
        Console.WriteLine(Fib(10));
        Console.WriteLine(Add(Fib(6), Fib(5)));
        int i = 0;
        int s = 0;
        while (i < 5) { s = s + i; i = i + 1; }
        Console.WriteLine(s);
    }
}
