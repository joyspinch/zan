using System;
using System.Collections;

class GlobalNames {
    public static int Ident() { return 900; }
}
class Reader {
    string Ident(int n) { return "reader:" + n; }
    public string Run() { return Ident(7); }
}
class NativeLexical {
    static bool GetInt(out int value) { value = 42; return true; }
    static bool GetText(out string value) { value = "out-text"; return true; }
    static T Keep<T>(T value) { return value; }
    static int FinallyReturn() {
        try {
            int same = 17;
            return same;
        } finally {
            string same = "finally";
            Console.WriteLine(same);
        }
    }
    static void Branch(bool choose) {
        if (choose) {
            int value = 12;
            Console.WriteLine(value);
        } else {
            string value = "else";
            Console.WriteLine(value);
        }
    }
    static void Main() {
        Branch(true);
        Branch(false);
        { int value = 3; Console.WriteLine(Keep(value)); }
        { string value = "block"; Console.WriteLine(Keep(value)); }
        for (int value = 0; value < 2; value = value + 1) Console.WriteLine(value);
        { string value = "after-for"; Console.WriteLine(value); }
        int repeat = 0;
        while (repeat < 1) {
            int value = 8;
            Console.WriteLine(value);
            repeat = repeat + 1;
        }
        { string value = "after-while"; Console.WriteLine(value); }
        foreach (int item in new int[] { 1, 2 }) {
            foreach (int inner in new int[] { 3, 4 }) Console.WriteLine(item * 10 + inner);
        }
        foreach (string item in new string[] { "foreach" }) Console.WriteLine(item);
        switch (1) {
            case 1: { string value = "case"; Console.WriteLine(value); break; }
            default: { int value = 99; Console.WriteLine(value); break; }
        }
        { string value = "after-switch"; Console.WriteLine(value); }
        { GetInt(out int value); Console.WriteLine(value); }
        { GetText(out string value); Console.WriteLine(value); }
        if (GetInt(out int condition)) Console.WriteLine(condition);
        { string condition = "after-if"; Console.WriteLine(condition); }
        try { throw "caught"; } catch (string value) { Console.WriteLine(value); }
        try { int value = 23; Console.WriteLine(value); }
        finally { string value = "normal-finally"; Console.WriteLine(value); }
        Console.WriteLine(FinallyReturn());
        Reader reader = new Reader();
        Console.WriteLine(reader.Run());
    }
}
