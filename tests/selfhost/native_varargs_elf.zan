using System;

// ELF (aarch64-linux) variadic probe: tails must allocate by natural class
// continuing the fixed sequences (clang oracle), not the Apple stack area.
class VaElf {
    [DllImport("crt", EntryPoint="snprintf", Variadic = true)]
    public static extern int Snprintf(nint buf, long size, string fmt);
    [DllImport("crt", EntryPoint="printf", Variadic = true)]
    public static extern int Printf(string fmt);
    [DllImport("crt")]
    public static extern nint malloc(long size);

    public static void Main() {
        nint buf = malloc(512);
        // fixed 3 int-class slots (buf,size,fmt): int tails continue x3..
        Snprintf(buf, 512, "i=%d j=%d s=%s L=%ld d=%.2f", 42, -7, "mid", 123456789012L, 2.5);
        Printf("[%s]\n", buf);
        // eight int tails: five fill x3..x7, three take packed overflow slots
        Snprintf(buf, 512, "%d|%d|%d|%d|%d|%d|%d|%d", 1, 2, 3, 4, 5, 6, 7, 8);
        Printf("[%s]\n", buf);
        // double tails ride d-regs despite int pressure; float widens to double
        float f = 1.5f;
        Snprintf(buf, 512, "d=%.1f f=%.1f d2=%.2f", 0.25, f, 3.75);
        Printf("[%s]\n", buf);
        // interleaved classes: call-order allocation, independent counters
        Snprintf(buf, 512, "m:%d %.1f %d %.1f %d %s", 9, 1.5, 10, 2.5, 11, "tail");
        Printf("[%s]\n", buf);
        // fixed-only variadic call
        int n = Snprintf(buf, 512, "plain");
        Printf("n=%d [%s]\n", n, buf);
    }
}
