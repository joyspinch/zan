// kernel14: slice 13 -- field receivers on locals/call results, class-qualified
// static field reads and writes, `x is T` (runtime class-site check, static
// same-or-base, unrelated), `x is null`, value/string `is` forms
using System;
class Animal {
    public string name;
    public Animal(string n) { name = n; }
}
class Dog : Animal {
    public Dog(string n) : base(n) { }
    public string Fetch() { return "ball"; }
}
class Cat : Animal {
    public Cat(string n) : base(n) { }
}
class Cfg {
    public static int built = 0;
    public bool showLegend;
    public static Cfg Make() { return new Cfg(); }
}
class P {
    static int failures = 0;
    static void Check(bool ok, string tag) {
        if (ok) { Console.WriteLine("ok " + tag); }
        else { failures = failures + 1; Console.WriteLine("FAIL " + tag); }
    }
    static void Bump() { Cfg.built = Cfg.built + 1; }
    static int Main() {
        // inheritance + runtime `is`
        Animal a = new Dog("rex");
        Animal b = new Cat("tom");
        Check(a is Dog, "is-dog-derived");
        Check(!(a is Cat), "is-dog-not-cat");
        Check(a is Animal, "is-same-base");
        Check(b is Animal, "is-cat-base");
        Check(!(b is Dog), "is-cat-not-dog");
        // null handling
        Animal n = null;
        Check(!(n is Dog), "is-null-class");
        Check(n is null, "is-null-true");
        Check(!(a is null), "is-null-false");
        // static type decides
        Dog d = new Dog("fido");
        Check(d is Dog, "is-same-static");
        Check(d is Animal, "is-derived-to-base");
        // value/string forms
        string s = "hello";
        Check(s is string, "is-string");
        int i = 5;
        Check(i is int, "is-int");
        Check(!(s is Animal), "is-string-not-class");
        // receiver's name field via inheritance (field from base)
        Check(a.name == "rex", "base-field-read");
        // class-qualified static read/write, incl. from another method
        Check(Cfg.built == 0, "static-zero");
        Bump();
        Bump();
        Check(Cfg.built == 2, "static-write-qualified");
        Cfg.built = Cfg.built + 10;
        Check(Cfg.built == 12, "static-write-direct");
        // static factory + call-receiver field write
        Cfg c = Cfg.Make();
        c.showLegend = true;
        Check(c.showLegend, "call-recv-field");
        if (failures == 0) { Console.WriteLine("kernel14 ok"); }
        return failures;
    }
}
