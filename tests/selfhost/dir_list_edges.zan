// b39: zan_dir_list_into glob face — rt_sync.c:2599. glob(3) semantics:
// basename output, '\n'-joined, cap-truncated, sorted (no GLOB_NOSORT),
// dotfiles NOT matched by '*', '.*' also matches '.' and '..'.
using System;

class Program {
    [DllImport("crt", EntryPoint = "zan_dir_list_into")]
    static extern long DirListInto(nint pattern, nint buf, long cap);

    static nint BufOf(string s) {
        nint p = NativeMemory.Alloc(s.Length + 1);
        int i = 0;
        while (i < s.Length) {
            NativeMemory.Fill(p + i, (int)s[i], 1);
            i = i + 1;
        }
        NativeMemory.Fill(p + s.Length, 0, 1);
        return p;
    }

    static void Case(string label, string pat, long cap) {
        nint pb = BufOf(pat);
        nint ob = NativeMemory.Alloc(4096);
        long r = DirListInto(pb, ob, cap);
        Console.WriteLine(label + "|len=" + r + "|out=" + NativeMemory.GetString(ob, 0, (int)r) + "|");
    }

    static int Main() {
        Directory.CreateDirectory("dlscratch");
        Directory.CreateDirectory("dlscratch/sub");
        Directory.CreateDirectory("dlempty");
        File.WriteAllText("dlscratch/a.zan", "a");
        File.WriteAllText("dlscratch/b.zan", "b");
        File.WriteAllText("dlscratch/c.txt", "c");
        File.WriteAllText("dlscratch/notes.md", "n");
        File.WriteAllText("dlscratch/.hidden.zan", "h");
        File.WriteAllText("dlscratch/sub/inner.zan", "i");

        Case("star-zan", "dlscratch/*.zan", 4096);
        Case("star-all", "dlscratch/*", 4096);
        Case("dot-star", "dlscratch/.*", 4096);
        Case("literal", "dlscratch/a.zan", 4096);
        Case("nomatch", "dlscratch/nope.zan", 4096);
        Case("empty-dir", "dlempty/*", 4096);
        Case("nested", "dlscratch/sub/*.zan", 4096);
        Case("prefix-a", "dlscratch/a*.zan", 4096);
        Case("relative", "*.zan", 4096);
        Case("dotpath", "dlscratch/./b.zan", 4096);
        Case("cap8", "dlscratch/*", 8);
        Case("cap0", "dlscratch/*", 0);
        Case("capneg", "dlscratch/*", -4);

        // null pattern and null out buffer
        nint ob = NativeMemory.Alloc(256);
        Console.WriteLine("nullpat|len=" + DirListInto((nint)0, ob, 256) + "|");
        nint pb = BufOf("dlscratch/*");
        Console.WriteLine("nullout|len=" + DirListInto(pb, (nint)0, 256) + "|");
        Console.WriteLine("end");
        return 0;
    }
}
