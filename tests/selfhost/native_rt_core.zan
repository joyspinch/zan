    static void WSlot(nint p, long v) {
        Span<long> s = new Span<long>(p, 1);
        s[0] = v;
    }

    static long RSlot(nint p) {
        Span<long> s = new Span<long>(p, 1);
        return s[0];
    }

    static nint V4(int a, int b, int c, int d) {
        nint p = Malloc(16);
        Memset(p, 0, 16);
        Span<byte> v = new Span<byte>(p, 16);
        v[1] = 2;
        v[4] = (byte)a;
        v[5] = (byte)b;
        v[6] = (byte)c;
        v[7] = (byte)d;
        return p;
    }

    static nint V6(long w0, long w1) {
        nint p = Malloc(28);
        Memset(p, 0, 28);
        Span<byte> v = new Span<byte>(p, 28);
        v[1] = 30;
        int i = 0;
        while (i < 8) {
            v[8 + i] = (byte)(w0 >>> (56 - i * 8));
            v[16 + i] = (byte)(w1 >>> (56 - i * 8));
            i = i + 1;
        }
        return p;
    }

    static string HexDigit(int n) {
        string digits = "0123456789abcdef";
        return digits.Substring(n, 1);
    }

    static string HexMd(nint md, int n) {
        Span<byte> d = new Span<byte>(md, n);
        string hex = "";
        int i = 0;
        while (i < n) {
            int b = d[i];
            hex = hex + HexDigit(b >>> 4) + HexDigit(b & 15);
            i = i + 1;
        }
        return hex;
    }

    static string Sha256Hex(string msg, int len) {
        nint buf = malloc(len > 0 ? len : 1);
        memcpy(buf, msg, len);
        nint md = malloc(32);
        Sha256(buf, len, md);
        string hex = HexMd(md, 32);
        free(md);
        free(buf);
        return hex;
    }

    static string Sha512Hex(string msg, int len) {
        nint buf = malloc(len > 0 ? len : 1);
        memcpy(buf, msg, len);
        nint md = malloc(64);
        Sha512(buf, len, md);
        string hex = HexMd(md, 64);
        free(md);
        free(buf);
        return hex;
    }

    public static void Main() {
        // 单调性 + 量纲:ns 单调递增,量级受界;us 与 ns 同源(同一
        // CLOCK_MONOTONIC 读数取整),后读的 us 不小于先读的 ns/1000。
        long a = MonoNs();
        long b = MonoNs();
        Console.WriteLine(b >= a);
        Console.WriteLine(b - a < 60000000000L);
        long u = MonoUs();
        Console.WriteLine(u >= b / 1000);
        // FIPS 180-4 已知答案
        Console.WriteLine(Sha256Hex("aaa", 3));
        Console.WriteLine(Sha256Hex("aaa", 0));
        string long56 = "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a"
            + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a"
            + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a"
            + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a";
        Console.WriteLine(Sha256Hex(long56, 56));
        Console.WriteLine(Sha512Hex("aaa", 3));
        string long120 = long56 + long56 + "a" + "a" + "a" + "a" + "a" + "a" + "a" + "a";
        Console.WriteLine(Sha512Hex(long120, 120));
        // CRC-32 已知答案:stdlib NativeMemory 的 EntryPoint 改名路径与
        // 直连符号必须一致;"123456789" → 0xCBF43926(int 域为负)。
        nint cbuf = malloc(9);
        memcpy(cbuf, "123456789", 9);
        Console.WriteLine(NativeMemory.Crc32(cbuf, 9));
        Console.WriteLine(Crc32Direct(cbuf, 9));
        Console.WriteLine(Crc32Direct(cbuf, 0));
        memcpy(cbuf, "aaa", 3);
        Console.WriteLine(Crc32Direct(cbuf, 3));
        free(cbuf);
        // zan_alloc/zan_free 往返:非零地址、calloc 清零、写读一致。
        nint abuf = NativeMemory.Alloc(16);
        Console.WriteLine(abuf != 0);
        new Span<byte>(abuf, 16)[0] = 0x5A;
        Console.WriteLine(new Span<byte>(abuf, 16)[0]);
        Console.WriteLine(new Span<byte>(abuf, 16)[1]);
        NativeMemory.Free(abuf);
        // ---- 第三批:文件族 ----
        // 写读往返 + 定位/EOF/长度/属性/mtime/read_path/BSD flock 文件锁。
        string tf = "zan_rt_core_b3.tmp";
        long fh = FileOpen(tf, "w");
        Console.WriteLine(FileWrite(fh, "zan-rt-file", 11) == 11);
        Console.WriteLine(FileClose(fh) == 0);
        long fr = FileOpen(tf, "r");
        nint rbuf = malloc(16);
        Console.WriteLine(FileRead(fr, rbuf, 16) == 11);
        string expect = "zan-rt-file";
        Span<byte> rv = new Span<byte>(rbuf, 11);
        bool same = true;
        int ci = 0;
        while (ci < 11) {
            int cb = expect[ci];
            if (rv[ci] != (byte)cb) { same = false; }
            ci = ci + 1;
        }
        Console.WriteLine(same);
        Console.WriteLine(FileEof(fr));
        Console.WriteLine(FileSeek(fr, 0, 2));
        Console.WriteLine(FileTell(fr));
        Console.WriteLine(FileSeek(fr, 0, 0));
        Console.WriteLine(FileEof(fr));
        FileClose(fr);
        free(rbuf);
        Console.WriteLine(FileLength(tf));
        Console.WriteLine(FileAttributes(tf));
        Console.WriteLine(FileTime(tf, 0) > 0);
        // set_time 的 syscall 在部分受限环境拒绝(相对路径 utimensat)，
        // 钉"返回值与回读一致"而非具体值:成功则 mtime 必为所设值，
        // 失败则 mtime 必保持当前时间——任何环境下的正确实现都为 true。
        // (不用 bool 三元:WriteLine 对三元结果按 int 传递,打印 0/1。)
        long st = FileSetTime(tf, 0, 1000000000);
        Console.WriteLine((st == 1 && FileTime(tf, 0) == 1000000000)
            || (st == 0 && FileTime(tf, 0) != 1000000000));
        // read_path:工作目录里存在 → "";缺失的相对路径($ZAN_PKG_DIR
        // 与可执行文件旁都没有)→ ""。
        nint rp1 = ReadPath(tf);
        Console.WriteLine(new Span<byte>(rp1, 1)[0] == 0);
        nint rp2 = ReadPath("zan_rt_core_missing.tmp");
        Console.WriteLine(new Span<byte>(rp2, 1)[0] == 0);
        nint pf1 = PkgFOpen(tf, "rb");
        nint pf2 = FileFOpen(tf, "rb");
        Console.WriteLine(pf1 != 0 && pf2 != 0);
        // 文件锁:句柄编码 (gen<<32)|slot;持锁期间二次加锁失败;同一
        // 句柄值的第二次 unlock 失败(代际);0 句柄失败。
        long lk = TryLock(tf);
        Console.WriteLine(lk != 0);
        Console.WriteLine(TryLock(tf) == 0);
        Console.WriteLine(Unlock(lk) == 1);
        Console.WriteLine(Unlock(lk) == 0);
        // embed 族诚实空集;mmap 诚实桩;remove 后属性 -1。
        Console.WriteLine(EmbedHas("no-such-embed") == 0);
        nint el = EmbedList("");
        Console.WriteLine(new Span<byte>(el, 1)[0] == 0);
        Console.WriteLine(MmapCreate("no-such-mm", 16) == 0);
        Console.WriteLine(FileRemove(tf) == 0);
        Console.WriteLine(FileAttributes(tf) == -1);
        // ---- 第四批:network 半边 ----
        // net_interfaces 结构不变量:非空、每行恰 4 个 '\t' 且以 '\n'
        // 结尾、含 lo0(macOS 回环接口恒在)。
        nint nit = NetInterfaces();
        Console.WriteLine(StrLen(nit) > 0);
        Span<byte> nv = new Span<byte>(nit, 65536);
        bool niOk = true;
        bool hasLo0 = false;
        long ni = 0;
        long lineTabs = 0;
        long niDone = 0;
        while (niDone == 0 && ni < 65536) {
            int c = nv[(int)ni];
            if (c == 0) {
                niDone = 1;
            }
            else if (c == 10) {
                if (lineTabs != 4) { niOk = false; }
                lineTabs = 0;
                ni = ni + 1;
            }
            else {
                if (c == 9) { lineTabs = lineTabs + 1; }
                if (c == 108 && ni + 3 < 65536 && nv[(int)ni + 1] == 111
                        && nv[(int)ni + 2] == 48 && nv[(int)ni + 3] == 9) {
                    hasLo0 = true;
                }
                ni = ni + 1;
            }
        }
        if (niDone == 0 || lineTabs != 0) { niOk = false; }
        Console.WriteLine(niOk);
        Console.WriteLine(hasLo0);
        // ping:确定性 -4 路径(空地址/非法字面量,不碰套接字)+
        // loopback 结果一致性(权限受限环境可能 -3,网络异常 -1/-2,
        // 成功为 0..timeout——任何环境下正确实现都满足)。
        Console.WriteLine(Ping("", 10) == -4);
        Console.WriteLine(Ping("999.1.2.3", 10) == -4);
        long pr = Ping("127.0.0.1", 2000);
        Console.WriteLine((pr >= 0 && pr <= 2000) || pr == -1 || pr == -2 || pr == -3);
        // ---- 第五批:zan_io_* 纯函数族 ----
        // 探活/就绪:坏 fd / 合法 fd(stdout)/ 越界 fd。
        Console.WriteLine(IoAlive(-1) == 0);
        Console.WriteLine(IoAlive(1) == 1);
        Console.WriteLine(IoAlive(9999) == 0);
        Console.WriteLine(IoReady(9999, 0) == -1);
        Console.WriteLine(IoReady(-1, 0) == -1);
        // sockaddr_family:fam 是 offset 1 的单字节;短缓冲/NULL 拒绝。
        nint a8888 = V4(8, 8, 8, 8);
        Console.WriteLine(IoFamily(a8888, 16) == 2);
        Console.WriteLine(IoFamily(a8888, 2) == 0);
        Console.WriteLine(IoFamily((nint)0, 16) == 0);
        // is_safe v4 规则矩阵(公网通过,私留段/文档段/多播拒绝)。
        Console.WriteLine(IoSafe(a8888, 16, 0) == 1);
        Console.WriteLine(IoSafe(V4(127, 0, 0, 1), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(127, 0, 0, 1), 16, 1) == 1);
        Console.WriteLine(IoSafe(V4(10, 0, 0, 1), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(192, 168, 1, 1), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(169, 254, 3, 4), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(172, 16, 9, 9), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(172, 32, 9, 9), 16, 0) == 1);
        Console.WriteLine(IoSafe(V4(224, 0, 0, 1), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(240, 1, 2, 3), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(0, 1, 2, 3), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(100, 64, 0, 1), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(100, 128, 0, 1), 16, 0) == 1);
        Console.WriteLine(IoSafe(V4(198, 51, 100, 7), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(203, 0, 113, 9), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(192, 0, 2, 5), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(192, 88, 99, 1), 16, 0) == 0);
        Console.WriteLine(IoSafe(V4(198, 18, 0, 1), 16, 0) == 0);
        // is_safe v6:全零/1::/回环/linklocal/ULA/多播/文档段/mapped/6to4/NAT64/Teredo。
        Console.WriteLine(IoSafe(V6(0, 0), 28, 0) == 0);
        Console.WriteLine(IoSafe(V6(1, 0), 28, 0) == 1);
        Console.WriteLine(IoSafe(V6(0, 1), 28, 0) == 0);
        Console.WriteLine(IoSafe(V6(0, 1), 28, 1) == 1);
        Console.WriteLine(IoSafe(V6(0xfe80000000000000L, 1), 28, 0) == 0);
        Console.WriteLine(IoSafe(V6(0xfc00000000000000L, 1), 28, 0) == 0);
        Console.WriteLine(IoSafe(V6(0xff02000000000000L, 1), 28, 0) == 0);
        Console.WriteLine(IoSafe(V6(0x20010db800000000L, 1), 28, 0) == 0);
        Console.WriteLine(IoSafe(V6(0, 0x0000ffff08080808L), 28, 0) == 1);
        Console.WriteLine(IoSafe(V6(0, 0x0000ffff7f000001L), 28, 0) == 0);
        Console.WriteLine(IoSafe(V6(0x2002080808080000L, 0), 28, 0) == 1);
        Console.WriteLine(IoSafe(V6(0x20020a0000000000L, 0), 28, 0) == 0);
        Console.WriteLine(IoSafe(V6(0x0064ff9b00000000L, 0x0000000008080808L), 28, 0) == 1);
        Console.WriteLine(IoSafe(V6(0x2001000044798a29L, 0x00000000f7f7f7f7L), 28, 0) == 1);
        Console.WriteLine(IoSafe(V6(0x2001000044798a29L, 0x0000000080808080L), 28, 0) == 0);
        // ip_str:v4 文本化(惰性串字节检查 + into 变体);未知族空串;短 cap/NULL。
        nint sb5 = Malloc(96);
        Console.WriteLine(IoIpStrInto(a8888, sb5, 96) == 7);
        Span<byte> sv5 = new Span<byte>(sb5, 10);
        Console.WriteLine(sv5[0] == 56 && sv5[1] == 46 && sv5[6] == 56 && sv5[7] == 0);
        Console.WriteLine(new Span<byte>(IoIpStr(a8888), 10)[1] == 46);
        nint su5 = Malloc(16);
        Memset(su5, 0, 16);
        Console.WriteLine(IoFamily(su5, 16) == 0);
        Console.WriteLine(IoIpStrInto(su5, sb5, 96) == 0);
        Console.WriteLine(IoIpStrInto(a8888, sb5, 0) == -1);
        Console.WriteLine(IoIpStrInto(a8888, (nint)0, 96) == -1);
        // peer:坏 fd 拒绝;惰性串空。
        Console.WriteLine(IoPeerIpInto(-1, sb5, 96) == -1);
        Console.WriteLine(new Span<byte>(IoPeerIp(-1), 1)[0] == 0);
        // resolver:NULL/空名拒绝;localhost→v4 16B、::1→v6 28B;数值 v4
        // 按小端读出 0x0100007f;resolve_all 结构性计数;async 与同步一致。
        nint nloc = Malloc(16);
        Span<byte> lv5 = new Span<byte>(nloc, 16);
        lv5[0] = 108;
        lv5[1] = 111;
        lv5[2] = 99;
        lv5[3] = 97;
        lv5[4] = 108;
        lv5[5] = 104;
        lv5[6] = 111;
        lv5[7] = 115;
        lv5[8] = 116;
        lv5[9] = 0;
        nint nempty = Malloc(4);
        Memset(nempty, 0, 4);
        Console.WriteLine(IoResolveSa((nint)0, 80, sb5, 96) == 0);
        Console.WriteLine(IoResolveSa(nempty, 80, sb5, 96) == 0);
        int rs4 = IoResolveSa(nloc, 80, sb5, 96);
        Console.WriteLine(rs4 == 16);
        Console.WriteLine(IoFamily(sb5, rs4) == 2);
        nint n6 = Malloc(8);
        Span<byte> v65 = new Span<byte>(n6, 8);
        v65[0] = 58;
        v65[1] = 58;
        v65[2] = 49;
        v65[3] = 0;
        int rs6 = IoResolveSa(n6, 80, sb5, 96);
        Console.WriteLine(rs6 == 28);
        Console.WriteLine(IoFamily(sb5, rs6) == 30);
        Console.WriteLine(IoResolveV4((nint)0) == 0);
        Console.WriteLine(IoResolveV4(nempty) == 0);
        Console.WriteLine(IoResolveV4(nloc) == 16777343);
        int ra5 = IoResolveAll(nloc, 80, sb5, 96);
        Console.WriteLine(ra5 >= 1 && ra5 <= 3);
        Console.WriteLine(IoFamily(sb5, 28) != 0);
        long raa = IoResolveAllAsync((long)nloc, 80, (long)sb5, 96);
        Console.WriteLine(raa == ra5);
        // send/recv 分类:坏 fd、零长、负长;recv 是 errno 透传。
        nint buf5 = Malloc(64);
        Console.WriteLine(IoSend(-1, buf5, 10, 0) == -2);
        Console.WriteLine(IoSend(-1, buf5, 0, 0) == 0);
        Console.WriteLine(IoSend(-1, buf5, -5, 0) == -2);
        Console.WriteLine(IoRecv(-1, buf5, 10, 0) == -1);
        Console.WriteLine(IoRecv(-1, buf5, -1, 0) == -2);
        // connect:fd 非法→-1;未知族→-1(family 检查先行,不碰 fd);
        // 状态查询坏 fd→-1。(非套接字的有效 fd 会改 flags,不测。)
        Console.WriteLine(IoConnectSa(-1, a8888, 16, 100) == -1);
        Console.WriteLine(IoConnectSa(1, a8888, 0, 100) == -1);
        Console.WriteLine(IoConnectStatus(-1) == -1);
        IoCleanup();
        Console.WriteLine(IoAlive(1) == 1);
        // ---- 第六批:zan_atomic_int_* ----
        // 单元语义:add 返回新值、exchange/Cas 返回旧值、失败 CAS 不落盘。
        nint ah = AtomicCreate(5);
        Console.WriteLine(ah != 0);
        Console.WriteLine(AtomicLoad(ah) == 5);
        AtomicStore(ah, 42);
        Console.WriteLine(AtomicLoad(ah) == 42);
        Console.WriteLine(AtomicAdd(ah, 8) == 50);
        Console.WriteLine(AtomicAdd(ah, -100) == -50);
        Console.WriteLine(AtomicExchange(ah, 7) == -50);
        Console.WriteLine(AtomicLoad(ah) == 7);
        Console.WriteLine(AtomicCas(ah, 7, 99) == 7);
        Console.WriteLine(AtomicLoad(ah) == 99);
        Console.WriteLine(AtomicCas(ah, 7, 1) == 99);
        Console.WriteLine(AtomicLoad(ah) == 99);
        nint ah2 = AtomicCreate(2);
        Console.WriteLine(AtomicAdd(ah, 10) == 109);
        Console.WriteLine(AtomicLoad(ah2) == 2);
        nint an = AtomicCreate(-2147483653);
        Console.WriteLine(AtomicAdd(an, 10) == -2147483643);
        // 空句柄全路径(store 为无操作,下一行能跑到即是证)。
        Console.WriteLine(AtomicLoad(0) == 0);
        Console.WriteLine(AtomicAdd(0, 5) == 0);
        Console.WriteLine(AtomicExchange(0, 1) == 0);
        Console.WriteLine(AtomicCas(0, 1, 2) == 0);
        AtomicStore(0, 9);
        AtomicDestroy(ah);
        AtomicDestroy(ah2);
        AtomicDestroy(an);
        nint ah3 = AtomicCreate(11);
        Console.WriteLine(AtomicLoad(ah3) == 11);
        AtomicDestroy(ah3);
        // ---- 第七批:audio 桩 / monitor / dispatch / eh_tls ----
        // audio 诚实桩:全零/全拒,driver/error 返回 "stub"(lit_buf@32)。
        Console.WriteLine(AudioOpen() == 0);
        Console.WriteLine(AudioIsOpen() == 0);
        Console.WriteLine(AudioActiveVoices() == 0);
        nint dn7 = AudioDriverName();
        Console.WriteLine(new Span<byte>(dn7, 6)[0] == 115
                && new Span<byte>(dn7, 6)[4] == 0);
        Console.WriteLine(new Span<byte>(AudioLastError(), 6)[0] == 115);
        Console.WriteLine(AudioVolume() == 0.0);
        Console.WriteLine(AudioClipDuration(5) == 0.0);
        Console.WriteLine(AudioClipChannels(5) == 0);
        Console.WriteLine(AudioClipFrequency(5) == 0);
        Console.WriteLine(AudioLoadWav(0, 0) == 0);
        Console.WriteLine(AudioLoadOggMem(0, 0) == 0);
        Console.WriteLine(AudioPlay(3, 1) == -1);
        Console.WriteLine(AudioVoicePlaying(9) == 0);
        // void 侧全部可调(可达性):close/stop_all/set_volume/free_clip/
        // voice_stop/voice_set_gain。
        AudioClose();
        AudioStopAll();
        AudioSetVolume(0.5);
        AudioFreeClip(7);
        AudioVoiceStop(2);
        AudioVoiceSetGain(2, 0.25);
        // monitor:同对象重入(计数语义)+ 未持有退出(钳到 0)+
        // 不同对象互不干扰——不产出输出,后续断言可达即无死锁/无破坏。
        MonitorEnter(a8888);
        MonitorEnter(a8888);
        MonitorEnter(su5);
        MonitorExit(a8888);
        MonitorExit(a8888);
        MonitorExit(a8888);
        MonitorExit(su5);
        MonitorEnter(nloc);
        MonitorExit(nloc);
        // dispatch:空环 take 为 0;null 拒;FIFO;翻倍两次保序;clear/init。
        DispatchInit();
        Console.WriteLine(DispatchTake() == 0);
        Console.WriteLine(DispatchPost(0) == 0);
        nint c1 = Malloc(8);
        nint c2 = Malloc(8);
        Console.WriteLine(DispatchPost(c1) == 1);
        Console.WriteLine(DispatchPost(c2) == 1);
        Console.WriteLine(DispatchTake() == c1);
        Console.WriteLine(DispatchTake() == c2);
        Console.WriteLine(DispatchTake() == 0);
        // 200 个带内容标签的单元压过 64 初始容量(翻倍 64→128→256),
        // 排空逐一核对 FIFO 序与计数。
        long k7 = 0;
        while (k7 < 200) {
            nint cell = Malloc(8);
            Span<long> cv = new Span<long>(cell, 1);
            cv[0] = k7 + 1;
            DispatchPost(cell);
            k7 = k7 + 1;
        }
        long dr7 = 0;
        long expect7 = 1;
        long dstate7 = 0;
        while (dstate7 == 0) {
            nint got = DispatchTake();
            if (got == 0) { dstate7 = 1; }
            else {
                Span<long> gv = new Span<long>(got, 1);
                if (gv[0] != expect7) { dstate7 = 2; }
                expect7 = expect7 + 1;
                dr7 = dr7 + 1;
            }
        }
        Console.WriteLine(dr7 == 200);
        Console.WriteLine(expect7 == 201);
        DispatchPost(c1);
        DispatchPost(c2);
        DispatchClear();
        Console.WriteLine(DispatchTake() == 0);
        DispatchPost(c1);
        DispatchInit();
        Console.WriteLine(DispatchTake() == 0);
        // eh_tls_state:同线程稳定、块清零(首/尾/槽区)。
        nint e1 = EhTlsState();
        nint e2 = EhTlsState();
        Console.WriteLine(e1 != 0);
        Console.WriteLine(e1 == e2);
        Console.WriteLine(new Span<byte>(e1, 262160)[0] == 0
                && new Span<byte>(e1, 262160)[16] == 0
                && new Span<byte>(e1, 262160)[262159] == 0);
        // ---- 第八批:zan_shared_table_* ----
        // 建/开/拒:O_EXCL 重名拒;坏 schema/越界参数拒;open 往返。
        long t1 = TableCreate("stb-a", 8, 32, "i:v;f:x;s:12:name;");
        Console.WriteLine(t1 != 0);
        Console.WriteLine(TableCreate("stb-a", 8, 32, "i:v;") == 0);
        Console.WriteLine(TableCreate("", 8, 32, "i:v;") == 0);
        Console.WriteLine(TableCreate("stb-b", 0, 32, "i:v;") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 0, "i:v;") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 4097, "i:v;") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 32, "") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 32, "x:v;") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 32, "i") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 32, "i:;") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 32, "i:a;i:a;") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 32, "s:0:a;") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 32, "s:70000:a;") == 0);
        Console.WriteLine(TableCreate("stb-b", 8, 32, "s:a;") == 0);
        Console.WriteLine(TableOpen("stb-a") == t1);
        Console.WriteLine(TableOpen("stb-none") == 0);
        // stat:行距 = int@0 + float@8 + s:12@16(13B)= 29。
        Console.WriteLine(TableStat(t1, 4) == 29);
        Console.WriteLine(TableStat(t1, 1) == 29 * 8);
        Console.WriteLine(TableStat(t1, 2) == 8);
        Console.WriteLine(TableStat(t1, 3) == 0);
        Console.WriteLine(TableStat(t1, 5) == 32);
        Console.WriteLine(TableStat(t1, 6) == 3);
        Console.WriteLine(TableStat(0, 2) == 0);
        // int/float/string 列读写;类型错位与越界串拒绝。
        Console.WriteLine(TableSetInt(t1, "k1", "v", 42) == 1);
        Console.WriteLine(TableGetInt(t1, "k1", "v") == 42);
        Console.WriteLine(TableSetInt(t1, "k1", "x", 1) == 0);
        Console.WriteLine(TableGetInt(t1, "nope", "v") == 0);
        Console.WriteLine(TableSetFloat(t1, "k1", "x", 2.5) == 1);
        // float 值的往返要过 double FFI 边界(编译器缺口四:double
        // 形参/返回走 x0 位型,P/Invoke 存根按 C ABI 读写 d0),此处置
        // 只验行管理语义;独立表上建行、计数、删除,不扰动 t1 复用链。
        long tf = TableCreateAnon(8, 32, "f:x;");
        Console.WriteLine(tf != 0);
        Console.WriteLine(TableSetFloat(tf, "kf", "x", 1.5) == 1);
        Console.WriteLine(TableCount(tf) == 1);
        Console.WriteLine(TableExists(tf, "kf") == 1);
        Console.WriteLine(TableDelete(tf, "kf") == 1);
        Console.WriteLine(TableCount(tf) == 0);
        Console.WriteLine(TableSetString(t1, "k1", "name", "hello") == 1);
        nint gs = TableGetString(t1, "k1", "name");
        Console.WriteLine(new Span<byte>(gs, 6)[0] == 104
                && new Span<byte>(gs, 6)[4] == 111
                && new Span<byte>(gs, 6)[5] == 0);
        Console.WriteLine(StrLen(gs) == 5);
        Console.WriteLine(TableSetString(t1, "k1", "name", "1234567890123") == 0);
        Console.WriteLine(TableSetString(t1, "k1", "name", "123456789012") == 1);
        // 计数/存在/自增/删除。
        Console.WriteLine(TableCount(t1) == 1);
        Console.WriteLine(TableExists(t1, "k1") == 1);
        Console.WriteLine(TableExists(t1, "k2") == 0);
        Console.WriteLine(TableIncrement(t1, "k1", "v", 8) == 50);
        Console.WriteLine(TableGetInt(t1, "k1", "v") == 50);
        Console.WriteLine(TableDelete(t1, "k1") == 1);
        Console.WriteLine(TableDelete(t1, "k1") == 0);
        Console.WriteLine(TableCount(t1) == 0);
        nint gs2 = TableGetString(t1, "k1", "name");
        Console.WriteLine(new Span<byte>(gs2, 1)[0] == 0);
        // hash:非零(值本身环境无关但函数是 API,不钉字面值)。
        long hk = TableHash("zz-key");
        Console.WriteLine(hk != 0);
        Console.WriteLine(TableHash("") != 0);
        // 匿名表 + OsHandle/Attach 同进程往返;具名表 Handle 为 0。
        long t2 = TableCreateAnon(8, 32, "i:v;");
        Console.WriteLine(t2 != 0);
        Console.WriteLine(TableHandle(t2) == t2);
        Console.WriteLine(TableAttach(t2) == t2);
        Console.WriteLine(TableHandle(t1) == 0);
        Console.WriteLine(TableCreateAnon(8, 32, "q:") == 0);
        // _at 族:哈希寻径建行、增量、极值、哈希间不串。
        Console.WriteLine(TableSetIntAt(t2, hk, "v", 7) == 1);
        Console.WriteLine(TableGetIntAt(t2, hk, "v") == 7);
        Console.WriteLine(TableExistsAt(t2, hk) == 1);
        Console.WriteLine(TableIncrementAt(t2, hk, "v", 3) == 10);
        // keep_larger=1:v>stored 才替换,返回替换后的 stored(10)。
        Console.WriteLine(TableExtremeAt(t2, hk, "v", 5, 1) == 10);
        Console.WriteLine(TableExtremeAt(t2, hk, "v", 3, 1) == 10);
        Console.WriteLine(TableExtremeAt(t2, hk, "v", 1, 0) == 1);
        Console.WriteLine(TableExtremeAt(t2, hk, "v", 9, 0) == 1);
        Console.WriteLine(TableGetIntAt(t2, hk, "v") == 1);
        long hk2 = TableHash("yy-key");
        Console.WriteLine(TableExistsAt(t2, hk2) == 0);
        Console.WriteLine(TableSetIntAt(t2, hk2, "v", 9) == 1);
        Console.WriteLine(TableGetIntAt(t2, hk2, "v") == 9);
        Console.WriteLine(TableGetIntAt(t2, hk, "v") == 1);
        // _at 串族 + match。
        Console.WriteLine(TableSetStringAt(t2, hk, "v", "abc") == 0);
        long t3 = TableCreateAnon(8, 32, "s:16:tag;");
        Console.WriteLine(t3 != 0);
        Console.WriteLine(TableSetStringAt(t3, hk, "tag", "abcdef") == 1);
        nint gs3 = TableGetStringAt(t3, hk, "tag");
        Console.WriteLine(new Span<byte>(gs3, 8)[2] == 99
                && new Span<byte>(gs3, 8)[3] == 100
                && new Span<byte>(gs3, 8)[6] == 0);
        Console.WriteLine(TableMatchAt(t3, hk, "tag", "abcdef") == 1);
        Console.WriteLine(TableMatchAt(t3, hk, "tag", "abcdeg") == 0);
        Console.WriteLine(TableMatchAt(t3, hk2, "tag", "abcdef") == 0);
        Console.WriteLine(TableDeleteAt(t3, hk) == 1);
        Console.WriteLine(TableDeleteAt(t3, hk) == 0);
        // 过期:显式时钟驱动。C 版墓碑复用不更新键副本,复用行对
        // find-by-key 不可见(C zt_row_for 语义),故 exp 行 ExpireAt
        // 找不到 → 0;行本身活着,计数 1。
        Console.WriteLine(TableSetInt(t1, "exp", "v", 1) == 1);
        Console.WriteLine(TableExpireAt(t1, "exp", 1) == 0);
        Console.WriteLine(TablePurgeExpired(t1, 1000) == 0);
        Console.WriteLine(TableCount(t1) == 1);
        Console.WriteLine(TableExpireAt(t1, "nope", 5) == 0);
        Console.WriteLine(TableExpire(t1, "exp", -1) == 0);
        Console.WriteLine(TableExpiresAt(t1, "nope") == -1);
        Console.WriteLine(TableSetInt(t1, "fut", "v", 2) == 1);
        Console.WriteLine(TableExpireAt(t1, "fut", 4000000000000) == 1);
        Console.WriteLine(TablePurgeExpired(t1, 1000) == 0);
        Console.WriteLine(TableExists(t1, "fut") == 1);
        Console.WriteLine(TableExpiresAt(t1, "fut") == 4000000000000);
        // rate_allow:count/window_start 双列,显式时钟走完窗口周期。
        long t4 = TableCreateAnon(8, 32, "i:count;i:window_start;");
        Console.WriteLine(TableRateAllow(t4, "r", 1000, 100, 3) == 1);
        Console.WriteLine(TableRateAllow(t4, "r", 1050, 100, 3) == 1);
        Console.WriteLine(TableRateAllow(t4, "r", 1090, 100, 3) == 1);
        Console.WriteLine(TableRateAllow(t4, "r", 1099, 100, 3) == 0);
        Console.WriteLine(TableRateAllow(t4, "r", 1100, 100, 3) == 1);
        Console.WriteLine(TableRateAllow(t4, "r2", 1000, 100, 0) == 1);
        Console.WriteLine(TableRateAllow(0, "r", 1000, 100, 3) == 0);
        // lock:仅 absent 建行(含对自己),owner 校验,释放后可再锁。
        long t5 = TableCreateAnon(8, 32, "i:owner;");
        // C 语义:acquire 内 purge(now) 先清到期租约 → 到期重夺返回 1;
        // release 用墙钟 purge,未到期租约也被清,后续 release 找不到行。
        Console.WriteLine(TableLockAcquire(t5, "L", 77, 1000, 50) == 1);
        Console.WriteLine(TableLockAcquire(t5, "L", 88, 1000, 50) == 0);
        Console.WriteLine(TableLockAcquire(t5, "L", 77, 1050, 50) == 1);
        Console.WriteLine(TableLockRelease(t5, "L", 88) == 0);
        Console.WriteLine(TableLockRelease(t5, "L", 77) == 0);
        Console.WriteLine(TableLockAcquire(t5, "L", 88, 1060, 50) == 1);
        Console.WriteLine(TableLockAcquire(0, "L", 1, 1000, 50) == 0);
        Console.WriteLine(TableLockAcquire(t5, "L", 0, 1000, 50) == 0);
        Console.WriteLine(TableLockAcquire(t5, "L2", 1, 1000, 0) == 0);
        // clear + tombstone 复用;destroy 是 unlink:句柄仍可读写。
        TableSetInt(t1, "c1", "v", 1);
        TableSetInt(t1, "c2", "v", 2);
        TableClear(t1);
        Console.WriteLine(TableCount(t1) == 0);
        Console.WriteLine(TableSetInt(t1, "c1", "v", 5) == 1);
        Console.WriteLine(TableCount(t1) == 1);
        Console.WriteLine(TableDestroy(t1) == 1);
        Console.WriteLine(TableDestroy(t1) == 0);
        Console.WriteLine(TableOpen("stb-a") == 0);
        Console.WriteLine(TableSetInt(t1, "c1", "v", 6) == 1);
        Console.WriteLine(TableGetInt(t1, "c1", "v") == 6);

        // ================= 第九批:native io reactor =================
        // 空表 poll:无观察项 → 0(调用方回落定时器睡眠);-1 超时也
        // 不会阻塞——表空在碰 timeout 之前就返回。
        Console.WriteLine(IoPoll(-1) == 0);
        Console.WriteLine(IoPoll(0) == 0);
        nint svbuf = malloc(8);
        nint hi = malloc(8);
        Span<byte> hv = new Span<byte>(hi, 3);
        hv[0] = 104;                              // "hi"
        hv[1] = 105;
        hv[2] = 121;                              // "hey" 第三字节
        nint slot = malloc(8);
        nint slot2 = malloc(8);
        nint p8 = malloc(8);
        // 死 fd:三形态都快败交付,不进观察表(poll 仍 0)。
        WSlot(slot, -999);
        IoWaitCo(-1, 1, 0, 0);
        Console.WriteLine(IoPoll(0) == 0);
        IoRecvCo(-1, svbuf, 16, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == 0);
        IoAcceptCo(-1, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == -1);
        Console.WriteLine(IoPoll(0) == 0);
        // recv 停泊 → 写端来数据 → poll 交付 2 字节;退休后 poll 归 0。
        Console.WriteLine(SocketPair(1, 1, 0, p8) == 0);      // AF_UNIX STREAM
        Span<int> svm = new Span<int>(p8, 2);
        long f0 = svm[0];
        long f1 = svm[1];
        WSlot(slot, -999);
        IoRecvCo(f0, svbuf, 16, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == -999);               // 仍停泊
        Console.WriteLine(IoPoll(0) == 1);                    // 无事:表非空
        Console.WriteLine(RSlot(slot) == -999);
        Console.WriteLine(Write(f1, hi, 2) == 2);
        Console.WriteLine(IoPoll(0) == 1);                    // 就绪交付
        Console.WriteLine(RSlot(slot) == 2);
        Span<byte> rv = new Span<byte>(svbuf, 3);
        Console.WriteLine(rv[0] == 104 && rv[1] == 105);
        Console.WriteLine(IoPoll(0) == 0);                    // 观察项已退休
        // 数据先到:recv_co 直通交付,不进表。
        Console.WriteLine(Write(f1, hi, 3) == 3);
        IoRecvCo(f0, svbuf, 16, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == 3);
        Console.WriteLine(IoPoll(0) == 0);
        // EOF:对端 close,recv_co 交付 0(关闭形)。
        Console.WriteLine(Close(f1) == 0);
        IoRecvCo(f0, svbuf, 16, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == 0);
        Console.WriteLine(IoPoll(0) == 0);
        Console.WriteLine(Close(f0) == 0);
        // recv_to:30ms 停泊;5ms poll 未到截止;睡 50ms 后 poll 截止
        // 交付 -1。
        Console.WriteLine(SocketPair(1, 1, 0, p8) == 0);
        WSlot(slot, -999);
        IoRecvToCo(svm[0], svbuf, 16, 30, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == -999);
        Console.WriteLine(IoPoll(5000000) == 1);              // 5ms:未到
        Console.WriteLine(RSlot(slot) == -999);
        Console.WriteLine(SleepMs(0, 0, 50) == 0);
        Console.WriteLine(IoPoll(0) == 1);                    // 截止交付
        Console.WriteLine(RSlot(slot) == -1);
        Console.WriteLine(IoPoll(0) == 0);
        // 数据赢过将过的截止:停泊后来数据,交付 2 而非 -1。
        WSlot(slot, -999);
        IoRecvToCo(svm[0], svbuf, 16, 30, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == -999);
        Console.WriteLine(Write(svm[1], hi, 2) == 2);
        Console.WriteLine(IoPoll(0) == 1);
        Console.WriteLine(RSlot(slot) == 2);
        Console.WriteLine(Close(svm[1]) == 0);
        Console.WriteLine(Close(svm[0]) == 0);
        // close_notify:停泊的 recv 立即以关闭形(0)醒,无需 poll。
        Console.WriteLine(SocketPair(1, 1, 0, p8) == 0);
        WSlot(slot, -999);
        IoRecvCo(svm[0], svbuf, 16, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == -999);
        IoCloseNotify(svm[0]);
        Console.WriteLine(RSlot(slot) == 0);
        Console.WriteLine(IoPoll(0) == 0);
        Console.WriteLine(Close(svm[1]) == 0);
        Console.WriteLine(Close(svm[0]) == 0);
        // wait_co:读 interest 停泊后来数据交付 0;写 interest 立即就绪。
        Console.WriteLine(SocketPair(1, 1, 0, p8) == 0);
        IoWaitCo(svm[0], 1, 0, 0);
        Console.WriteLine(IoPoll(0) == 1);
        Console.WriteLine(Write(svm[1], hi, 2) == 2);
        Console.WriteLine(IoPoll(0) == 1);                    // 交付(kind 无槽)
        Console.WriteLine(IoPoll(0) == 0);
        IoWaitCo(svm[0], 2, 0, 0);                            // WOUT:必就绪
        Console.WriteLine(IoPoll(1000000) == 1);
        Console.WriteLine(IoPoll(0) == 0);
        Console.WriteLine(Close(svm[1]) == 0);
        Console.WriteLine(Close(svm[0]) == 0);
        // accept_co:先停泊后 connect,poll 交付新 fd;再连一个走直通。
        nint lsa = V4(127, 0, 0, 1);
        int lfd = Socket(2, 1, 0);
        Console.WriteLine(Bind(lfd, lsa, 16) == 0);
        Console.WriteLine(Listen(lfd, 2) == 0);
        nint lenp = malloc(4);
        Span<int> lv = new Span<int>(lenp, 1);
        lv[0] = 16;
        Console.WriteLine(GetSockName(lfd, lsa, lenp) == 0);
        Span<byte> lbv = new Span<byte>(lsa, 16);
        int port = (lbv[2] << 8) | lbv[3];
        nint csa = V4(127, 0, 0, 1);
        Span<byte> cbv = new Span<byte>(csa, 16);
        cbv[2] = (byte)((port >>> 8) & 255);
        cbv[3] = (byte)(port & 255);
        WSlot(slot2, -999);
        IoAcceptCo(lfd, 0, 0, slot2);
        Console.WriteLine(RSlot(slot2) == -999);              // 无连接:停泊
        Console.WriteLine(IoPoll(0) == 1);
        Console.WriteLine(RSlot(slot2) == -999);
        int c1 = Socket(2, 1, 0);
        Console.WriteLine(Connect(c1, csa, 16) == 0);
        // 交付等待环:快路(fd_ready 命中)立即出环;偶发慢一拍的
        // 环境里 accept 停泊,首轮 poll 交付。两种交错输出一致。
        long g = 0;
        while (RSlot(slot2) == -999 && g < 500) {
            IoPoll(20000000);
            g = g + 1;
        }
        Console.WriteLine(g < 500);
        Console.WriteLine(RSlot(slot2) >= 0);
        Console.WriteLine(Close(RSlot(slot2)) == 0);
        Console.WriteLine(Close(c1) == 0);
        int c2 = Socket(2, 1, 0);
        Console.WriteLine(Connect(c2, csa, 16) == 0);
        WSlot(slot2, -999);
        IoAcceptCo(lfd, 0, 0, slot2);                         // 直通,不进表
        g = 0;
        while (RSlot(slot2) == -999 && g < 500) {
            IoPoll(20000000);
            g = g + 1;
        }
        Console.WriteLine(g < 500);
        Console.WriteLine(RSlot(slot2) >= 0);
        Console.WriteLine(IoPoll(0) == 0);
        Console.WriteLine(Close(RSlot(slot2)) == 0);
        Console.WriteLine(Close(c2) == 0);
        IoCloseNotify(lfd);
        Console.WriteLine(Close(lfd) == 0);
        // resolve_sa_co 字面量:无 DNS 无 worker,同步直通。v4 形 16B,
        // 端口大端在 [2..3];v6 形 28B。
        nint abuf = malloc(64);
        Span<byte> abv = new Span<byte>(abuf, 28);
        WSlot(slot, -999);
        ResolveSaCo("127.0.0.1", 80, abuf, 64, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == 16);
        Console.WriteLine(abv[1] == 2);
        Console.WriteLine(abv[2] == 0 && abv[3] == 80);
        WSlot(slot, -999);
        ResolveSaCo("::1", 80, abuf, 64, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == 28);
        Console.WriteLine(abv[1] == 30);
        WSlot(slot, -999);
        ResolveSaCo("", 80, abuf, 64, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == 0);
        nint z = 0;
        WSlot(slot, -999);
        ResolveSaCoRaw(z, 80, abuf, 64, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == 0);
        Console.WriteLine(IoPoll(0) == 0);
        // resolve worker 路径(自管道 + 脱离线程):管道观察项是常驻,
        // 从此 poll 恒返回 1,故整段放在最后。guard 上限只防死循环,
        // 正常一两轮内完工。
        WSlot(slot, -999);
        ResolveSaCo("localhost", 80, abuf, 64, 0, 0, slot);
        long guard = 0;
        while (RSlot(slot) == -999 && guard < 500) {
            IoPoll(20000000);
            guard = guard + 1;
        }
        Console.WriteLine(guard < 500);
        Console.WriteLine(RSlot(slot) > 0);
        WSlot(slot, -999);
        ResolveIpv4Co("localhost", 0, 0, slot);
        guard = 0;
        while (RSlot(slot) == -999 && guard < 500) {
            IoPoll(20000000);
            guard = guard + 1;
        }
        Console.WriteLine(guard < 500);
        // localhost 可能 ::1 在前(v4 形给出 0),只断言交付发生;
        // 点分字面量的 v4 形才是确定值:s_addr 内存序(LE 读 u32),
        // 7F 00 00 01 → 0x0100007F = 16777343。
        Console.WriteLine(RSlot(slot) >= 0);
        WSlot(slot, -999);
        ResolveIpv4Co("127.0.0.1", 0, 0, slot);
        guard = 0;
        while (RSlot(slot) == -999 && guard < 500) {
            IoPoll(20000000);
            guard = guard + 1;
        }
        Console.WriteLine(RSlot(slot) == 16777343);
        WSlot(slot, -999);
        ResolveIpv4CoRaw(z, 0, 0, slot);
        Console.WriteLine(RSlot(slot) == 0);
    }
}
