using System;

class FitNode {
    public int count;
    public FitNode Add(FitNode n) { count = count + 1; return n; }
}

class FitBox<T> : FitNode {
    public int items;
    public T Add(T item) { items = items + 1; return item; }
    public string Pick(int x) { return "box-int"; }
    public string Pick(string x) { return "box-string"; }
    public static string Select(int x) { return "static-int"; }
    public static string Select(string x) { return "static-string"; }
}

class FitOther<T> {
    public string Pick(int x) { return "other-int"; }
}

class Program {
    static void Main() {
        FitBox<string> b = new FitBox<string>();
        Console.WriteLine(b.Add("item"));
        b.Add(new FitNode());
        Console.WriteLine(b.items + " " + b.count);
        Console.WriteLine(b.Pick(1));
        Console.WriteLine(b.Pick("s"));
        Console.WriteLine(b.Pick(2));
        FitOther<string> other = new FitOther<string>();
        Console.WriteLine(other.Pick(3));
        Console.WriteLine(FitBox<string>.Select(1));
        Console.WriteLine(FitBox<string>.Select("s"));
        Console.WriteLine(FitBox<string>.Select(2));
    }
}
