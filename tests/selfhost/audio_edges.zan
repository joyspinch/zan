// b35: audio surface probe. Loads were stubbed to 0 on our side while
// the oracle parses WAV (PCM 8/16/24/32, float32, extensible) and OGG
// on every platform; the device layer is a stub on darwin for both.
// Reference output = C harness over the SAME oracle zan_audio.c (the
// oracle toolchain cannot link audio faces at all: zan_audio.o is not
// in its face-link object list on any target). Bytes are built in a
// native buffer because Zan strings are UTF-8 text and mangle binary.
using System;
using System.IO;

class Program {
    [DllImport("crt", EntryPoint = "zan_audio_open")]
    static extern int Open();
    [DllImport("crt", EntryPoint = "zan_audio_close")]
    static extern void CloseDev();
    [DllImport("crt", EntryPoint = "zan_audio_is_open")]
    static extern int IsOpen();
    [DllImport("crt", EntryPoint = "zan_audio_driver_name")]
    static extern string DriverName();
    [DllImport("crt", EntryPoint = "zan_audio_last_error")]
    static extern string LastError();
    [DllImport("crt", EntryPoint = "zan_audio_load_wav")]
    static extern nint LoadWav(string path);
    [DllImport("crt", EntryPoint = "zan_audio_load_wav_mem")]
    static extern nint LoadWavMemP(nint data, int len);
    [DllImport("crt", EntryPoint = "zan_audio_load_ogg_mem")]
    static extern nint LoadOggMemP(nint data, int len);
    [DllImport("crt", EntryPoint = "zan_audio_free_clip")]
    static extern void FreeClip(nint clip);
    [DllImport("crt", EntryPoint = "zan_audio_clip_frequency")]
    static extern int ClipFreq(nint c);
    [DllImport("crt", EntryPoint = "zan_audio_clip_channels")]
    static extern int ClipCh(nint c);
    [DllImport("crt", EntryPoint = "zan_audio_clip_duration_ms")]
    static extern int ClipDur(nint c);
    [DllImport("crt", EntryPoint = "zan_audio_play")]
    static extern long Play(nint c, double g, int loop);
    [DllImport("crt", EntryPoint = "zan_audio_voice_playing")]
    static extern int VoicePlaying(long v);
    [DllImport("crt", EntryPoint = "zan_audio_volume")]
    static extern double Volume();
    [DllImport("crt", EntryPoint = "zan_audio_set_volume")]
    static extern void SetVolume(double v);
    static nint buf;
    static int bidx;

    static void Emit(int v, int n) { NativeMemory.Fill(buf + bidx, v & 255, n); bidx = bidx + n; }
    static void EmitA(string s) { NativeMemory.PutString(buf, bidx, s, s.Length); bidx = bidx + s.Length; }
    static void U16(int v) { Emit(v & 255, 1); Emit((v >> 8) & 255, 1); }
    static void U32(int v) {
        Emit(v & 255, 1); Emit((v >> 8) & 255, 1);
        Emit((v >> 16) & 255, 1); Emit((v >> 24) & 255, 1);
    }
    static int Wav(int tag, int bits, int ch, int freq, int frames, int dn) {
        bidx = 0;
        int db = dn;
        int br = freq * ch * bits / 8;
        int fl = 16;
        if (tag == 0xFFFE) { fl = 48; }
        int riffsz = 4 + (8 + fl + (fl % 2)) + (8 + db + (db % 2));
        EmitA("RIFF"); U32(riffsz); EmitA("WAVE");
        EmitA("fmt "); U32(fl);
        U16(tag); U16(ch); U32(freq); U32(br);
        U16(ch * bits / 8); U16(bits);
        if (tag == 0xFFFE) {
            U16(22); U16(bits); U32(br); U32(1); U32(0x8000);
            Emit(0, 4);
            U32(tag == 3 ? 3 : 1); U32(0x0010); U32(0x8000);
        }
        if (fl % 2 == 1) { Emit(0, 1); }
        EmitA("data"); U32(db); Emit(0, db);
        if (db % 2 == 1) { Emit(0, 1); }
        return bidx;
    }

    static void Probe(string name, int len) {
        nint h = LoadWavMemP(buf, len);
        Console.WriteLine(name + " ok: " + (h != 0 ? 1 : 0)
            + " ch: " + Convert.ToString(ClipCh(h))
            + " freq: " + Convert.ToString(ClipFreq(h))
            + " dur: " + Convert.ToString(ClipDur(h)));
        if (h != 0) { FreeClip(h); }
    }

