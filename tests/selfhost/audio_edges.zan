    static void Main() {
        buf = NativeMemory.Alloc(262144);
        Console.WriteLine("open: " + Convert.ToString(Open()));
        Console.WriteLine("isopen: " + Convert.ToString(IsOpen()));
        Console.WriteLine("driver: '" + DriverName() + "'");
        Console.WriteLine("err: '" + LastError() + "'");
        Console.WriteLine("vol: " + Convert.ToString(Volume()));
        SetVolume(0.5);
        Console.WriteLine("vol2: " + Convert.ToString(Volume()));
        Console.WriteLine("voices: " + Convert.ToString(ActiveVoices()));
        StopAll();
        Console.WriteLine("vp: " + Convert.ToString(VoicePlaying(0)));
        Console.WriteLine("play0: " + Convert.ToString(Play((nint)0, 1.0, 0)));

        Probe("w16m", Wav(1, 16, 1, 8000, 8000, 8000*1*2));
        Probe("w16s", Wav(1, 16, 2, 4000, 8, 8*2*2));
        Probe("w8m", Wav(1, 8, 1, 8000, 8, 8*1*1));
        Probe("w24m", Wav(1, 24, 1, 8000, 8, 8*1*3));
        Probe("w32m", Wav(1, 32, 1, 8000, 8, 8*1*4));
        Probe("wf32", Wav(3, 32, 1, 8000, 8, 8*1*4));
        Probe("wext1", Wav(0xFFFE, 16, 1, 8000, 8, 8*1*2));
        Probe("wext3", Wav(0xFFFE, 32, 1, 8000, 8, 8*1*4));
        Console.WriteLine("e-float16: '" + LastError() + "'");
        Probe("w16m2", Wav(1, 16, 1, 44100, 4410, 4410*1*2));
        Console.WriteLine("dur-long: " + Convert.ToString(ClipDur((nint)0)));

        bidx = 0;
        EmitA("RIFX"); U32(4); EmitA("WAVE");
        Probe("bad", bidx);
        Console.WriteLine("e-bad: '" + LastError() + "'");

        bidx = 0;
        EmitA("RIFF"); U32(16); EmitA("WAVE");
        EmitA("data"); U32(4); Emit(0, 4);
        Probe("nofmt", bidx);
        Console.WriteLine("e-nofmt: '" + LastError() + "'");

        Probe("empty", 0);
        Console.WriteLine("e-empty: '" + LastError() + "'");
        Wav(1, 16, 1, 8000, 4, 8);
        Console.WriteLine("len0: " + (LoadWavMemP(buf, 0) != 0 ? 1 : 0));
        Console.WriteLine("e-len0: '" + LastError() + "'");
        Probe("b12", Wav(1, 12, 1, 8000, 8, 8*1*2));
        Console.WriteLine("e-b12: '" + LastError() + "'");
        Probe("ch0", Wav(1, 16, 0, 8000, 0, 0));
        Console.WriteLine("e-ch0: '" + LastError() + "'");
        Probe("fr0", Wav(1, 16, 1, 0, 0, 0));
        Console.WriteLine("e-fr0: '" + LastError() + "'");
        Probe("misalign", Wav(1, 24, 1, 8000, 8, 16));
        Console.WriteLine("e-mis: '" + LastError() + "'");

        nint p = LoadWav("/nonexistent/f35.wav");
        Console.WriteLine("path0: " + (p != 0 ? 1 : 0) + " '" + LastError() + "'");
        p = LoadWav("");
        Console.WriteLine("path1: " + (p != 0 ? 1 : 0) + " '" + LastError() + "'");

        nint og = LoadOggMemP(buf, 10);
        Console.WriteLine("ogg0: " + (og != 0 ? 1 : 0) + " '" + LastError() + "'");

        bidx = 0;
        string hexd = "0123456789ABCDEF";
        int k = 0;
        while (k < OGGSRC.Length) {
            int hi = 0;
            int lo = 0;
            int j = 0;
            while (j < 16) {
                if (hexd.Substring(j, 1) == OGGSRC.Substring(k, 1)) { hi = j; }
                if (hexd.Substring(j, 1) == OGGSRC.Substring(k + 1, 1)) { lo = j; }
                j = j + 1;
            }
            Emit(hi * 16 + lo, 1);
            k = k + 2;
        }
        nint og2 = LoadOggMemP(buf, bidx);
        Console.WriteLine("ogg-trunc: " + (og2 != 0 ? 1 : 0)
            + " ch: " + Convert.ToString(ClipCh(og2))
            + " freq: " + Convert.ToString(ClipFreq(og2))
            + " dur: " + Convert.ToString(ClipDur(og2))
            + " '" + LastError() + "'");
        if (og2 != 0) { FreeClip(og2); }
        CloseDev();
    }

    [DllImport("crt", EntryPoint = "zan_audio_active_voices")]
    static extern int ActiveVoices();
    [DllImport("crt", EntryPoint = "zan_audio_stop_all")]
    static extern void StopAll();
}
