// kernel12: slice 11 -- static fields, inheritance (base fields, implicit
// base-ctor chaining), bitwise & | ^, null literal, for loops with
// break/continue, foreach over List and arrays, ternary conditional,
// postfix ++/--.
class K12 {
    static int counter;
    static string tag;

    static void Bump() { counter = counter + 1; }

    static void Main() {
        Bump();
        Bump();
        Console.WriteLine(counter);
        tag = "v" + counter;
        Console.WriteLine(tag);
        int a = 12;
        int b = 10;
        Console.WriteLine(a & b);
        Console.WriteLine(a | b);
        Console.WriteLine(a ^ b);
        Derived dv = new Derived();
        Console.WriteLine(dv.Name());
        Console.WriteLine(dv.Kind());
        int total = 0;
        for (int i = 0; i < 10; i++) {
            if (i == 2) { continue; }
            if (i == 5) { break; }
            total = total + i;
        }
        Console.WriteLine(total);
        List<int> xs = new List<int>();
        xs.Add(10);
        xs.Add(20);
        xs.Add(30);
        int sum = 0;
        foreach (int x in xs) { sum = sum + x; }
        Console.WriteLine(sum);
        int[] arr = new int[3];
        arr[0] = 2;
        arr[1] = 3;
        arr[2] = 4;
        int prod = 1;
        foreach (int v in arr) { prod = prod * v; }
        Console.WriteLine(prod);
        Console.WriteLine(arr == null);
        int c = total > 5 ? 100 : 200;
        Console.WriteLine(c);
        c = total > 50 ? 100 : 200;
        Console.WriteLine(c);
        int j = 3;
        j++;
        Console.WriteLine(j);
        j--;
        Console.WriteLine(j);
        Console.WriteLine("done");
    }
}

class Base {
    string kind;

    public Base() { kind = "base"; }

    public string Kind() { return kind; }
}

class Derived : Base {
    string name;

    public Derived() { name = "derived"; }

    public string Name() { return name; }
}
