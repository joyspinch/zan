class Root {
    public string trace;
    public Root() { trace = "R"; }
    public Root(string s) { trace = "R" + s; }
}
class Value : Root {
    public int num;
    public string text;
    public int a;
    public int b;
    public Value(int n) { num = n; text = "n"; }
    public Value(string s) { num = -1; text = s; }
    public Value(int x, int y) : base(":b") { a = x; b = y; num = x * y; }
    public Value(double d) : base() { num = (int)d; text = "d"; }
}
class NoCtor {
    public int v;
}
class WithDef {
    public int sum;
    public WithDef(int x, int y = 10) { sum = x + y; }
}
class Program {
    static void Main() {
        Value v1 = new Value(5);
        Console.WriteLine(v1.num);
        Console.WriteLine(v1.text);
        Console.WriteLine(v1.trace);
        Value v2 = new Value("hi");
        Console.WriteLine(v2.num);
        Console.WriteLine(v2.text);
        Console.WriteLine(v2.trace);
        Value v3 = new Value(3, 4);
        Console.WriteLine(v3.num);
        Console.WriteLine(v3.trace);
        Console.WriteLine(v3.a + v3.b);
        Value v4 = new Value(2.5);
        Console.WriteLine(v4.num);
        Console.WriteLine(v4.text);
        NoCtor nc = new NoCtor();
        Console.WriteLine(nc.v);
        WithDef w1 = new WithDef(1);
        Console.WriteLine(w1.sum);
        WithDef w2 = new WithDef(1, 2);
        Console.WriteLine(w2.sum);
        Root r = new Root("T");
        Console.WriteLine(r.trace);
    }
}
