// kernel4: exceptions slice -- try/catch, typed catch variable, throw,
// bare rethrow, nested trys, and normal completion restoring the frame.
class K4 {
    static void Check(int v) {
        if (v > 5) { throw "too big"; }
        Console.WriteLine(v);
    }
    static void Main() {
        try {
            Check(3);
        } catch (string e) {
            Console.WriteLine(e);
        }
        try {
            Check(9);
        } catch (string e) {
            Console.WriteLine(e);
        }
        try {
            try {
                throw "inner";
            } catch (string e) {
                Console.WriteLine(e);
                throw;
            }
        } catch (string e) {
            Console.WriteLine(e);
        }
        try {
            Check(4);
        } catch (string e) {
            Console.WriteLine("no");
        }
        Console.WriteLine("done");
    }
}
