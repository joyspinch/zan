using System;
using System.Collections.Generic;

class App {
    static void Main() {
        var d = new Dictionary<string, int>();
        d.Add("a", 11);
        d.Add("b", 22);
        var arr = new int[3];
        arr[0] = 7; arr[1] = 7; arr[2] = 7;
        bool f1 = d.TryGetValue("b", out arr[1]);
        Console.WriteLine(f1);
        Console.WriteLine(arr[0]);
        Console.WriteLine(arr[1]);
        Console.WriteLine(arr[2]);
        bool f2 = d.TryGetValue("zz", out arr[0]);
        Console.WriteLine(f2);
        Console.WriteLine(arr[0]);
        var keys = d.Keys;
        Console.WriteLine(keys.Count);
        Console.WriteLine(d.Values.Count);
        Console.WriteLine(d.ContainsKey("a"));
        Console.WriteLine(d["a"]);
        var di = new Dictionary<int, string>();
        di[1] = "one";
        di[2] = "two";
        Console.WriteLine(di[1]);
        Console.WriteLine(di.ContainsKey(2));
        Console.WriteLine(di.Remove(1));
        Console.WriteLine(di.ContainsKey(1));
        Console.WriteLine(di.Count);
    }
}
