using System;

// Native async slice: params and locals survive suspensions; awaits inside a
// while loop; a bare `return await ...;` in a non-async Main.
class Program {
    static async int Touch(int k) {
        return k * 2;
    }

    static async int Step(int k) {
        int cur = k * 10;
        await Touch(k);
        cur = cur + 1;
        var note = "v";
        await Touch(cur);
        note = note + "!";
        if (note != "v!") {
            return -1;
        }
        return cur + k;
    }

    static async int Sum(int rounds) {
        int acc = 0;
        int i = 0;
        while (i < rounds) {
            int part = await Touch(i);
            acc = acc + part;
            i = i + 1;
        }
        return acc;
    }

    static int Main() {
        int a = await Step(3);
        Console.WriteLine(a);
        Console.WriteLine(await Sum(4));
        return await Sum(1);
    }
}
