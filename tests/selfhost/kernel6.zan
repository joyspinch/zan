// kernel6: division and modulo -- exact division, negatives, truncation
// toward zero, and the C-runtime zero guard (report to stderr, continue
// dividing by one, matching the IR backend's select guard).
class K6 {
    static void Main() {
        int a = 17; int b = 5;
        Console.WriteLine(a / b);
        Console.WriteLine(a % b);
        Console.WriteLine((0 - 17) / b);
        Console.WriteLine((0 - 17) % b);
        Console.WriteLine(100 / 7);
        Console.WriteLine(100 % 7);
        int z = 0;
        Console.WriteLine(a / z);
        Console.WriteLine(a % z);
        Console.WriteLine("done");
    }
}
