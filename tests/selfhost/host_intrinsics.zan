using System;
using System.IO;
using System.Text;
namespace HostIntrinsics;

// Run in a fresh temporary working directory:
//   ./host_intrinsics alpha beta
// Creates/overwrites only host-intrinsics.tmp in that directory. Compare stdout
// with host_intrinsics.out. Requires the ngen_host hooks and libSystem.
class Program {
    static void Main() {
        Console.WriteLine(Environment.ArgCount());
        Console.WriteLine(Environment.ArgAt(0));
        Console.WriteLine(Environment.ArgAt(1));
        Console.WriteLine(Environment.ExeDir().Length > 0);
        Console.WriteLine(File.Exists("host-intrinsics-missing.tmp"));
        File.WriteAllText("host-intrinsics.tmp", "");
        Console.WriteLine(File.ReadAllText("host-intrinsics.tmp").Length);
        string nl = new StringBuilder().AppendLine().ToString();
        File.WriteAllText("host-intrinsics.tmp", "hello" + nl + "world");
        Console.WriteLine(File.Exists("host-intrinsics.tmp"));
        Console.WriteLine(File.ReadAllText("host-intrinsics.tmp"));
        Console.WriteLine(Directory.ListNames("host-intrinsics.tmp") == "host-intrinsics.tmp" + nl);
        Console.WriteLine(Directory.ListNames("host-intrinsics-missing-*.tmp").Length);
        StringBuilder sb = new StringBuilder();
        Console.WriteLine(sb.Length);
        Console.WriteLine(sb.ToString() == "");
        sb.Append("A").AppendLine("B").AppendLine();
        Console.WriteLine(sb.Length);
        Console.WriteLine(sb.ToString() == "AB" + nl + nl);
        string snapshot = sb.ToString();
        sb.Append("C");
        Console.WriteLine(snapshot == "AB" + nl + nl);
        Console.WriteLine(sb.ToString() == "AB" + nl + nl + "C");
        StringBuilder big = new StringBuilder();
        int i = 0;
        while (i < 4096) {
            big.Append("0123456789abcdef");
            i = i + 1;
        }
        Console.WriteLine(big.Length);
        string result = big.ToString();
        Console.WriteLine(result.Length);
        Console.WriteLine(result.Substring(65520, 16));
        big.Append(42).AppendLine();
        Console.WriteLine(big.Length);
        Console.WriteLine(new StringBuilder().Append("chain").ToString());
    }
}
