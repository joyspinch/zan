using System;
namespace Conf;
class DictGrowth {
    static void Main() {
        Dictionary<string, int> d = new Dictionary<string, int>();
        int bad = 0;
        int i = 0;
        while (i < 40) {
            d.Add("key-" + Convert.ToString(i), i * 7);
            i = i + 1;
        }
        if (d.Count != 40) { bad = bad + 1; }
        i = 0;
        while (i < 40) {
            string k = "key-" + Convert.ToString(i);
            if (!d.ContainsKey(k)) { bad = bad + 1; }
            if (d[k] != i * 7) { bad = bad + 1; }
            i = i + 1;
        }
        int value = -1;
        if (!d.TryGetValue("key-23", out value)) { bad = bad + 1; }
        if (value != 161) { bad = bad + 1; }
        if (d.TryGetValue("missing", out value)) { bad = bad + 1; }
        if (value != 161) { bad = bad + 1; }
        d["key-23"] = 900;
        if (d["key-23"] != 900 || d.Count != 40) { bad = bad + 1; }
        if (!d.Remove("key-0")) { bad = bad + 1; }
        if (!d.Remove("key-23")) { bad = bad + 1; }
        if (!d.Remove("key-39")) { bad = bad + 1; }
        if (d.Remove("missing")) { bad = bad + 1; }
        if (d.Count != 37 || d["key-24"] != 168) { bad = bad + 1; }
        List<string> keys = d.Keys;
        List<int> values = d.Values;
        if (keys.Count != 37 || values.Count != 37) { bad = bad + 1; }
        if (keys[0] != "key-1" || values[0] != 7) { bad = bad + 1; }
        d.Clear();
        if (d.Count != 0 || d.ContainsKey("key-1")) { bad = bad + 1; }
        d.Add("again", 42);
        if (d["again"] != 42 || d.Count != 1) { bad = bad + 1; }
        if (keys.Count != 37 || values[0] != 7) { bad = bad + 1; }
        Console.WriteLine("dict-growth-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
