using System;
namespace Conf;
class ListStringSearch {
    static void Main() {
        List<string> words = new List<string>();
        words.Add("one");
        words.Add("two");
        words.Add("three");
        int bad = 0;
        if (words.IndexOf("three") != 2) { bad = bad + 1; }
        if (words.IndexOf("missing") != -1) { bad = bad + 1; }
        if (!words.Contains("two")) { bad = bad + 1; }
        if (words.Contains("missing")) { bad = bad + 1; }
        words.Remove("two");
        if (words.Count != 2 || words[1] != "three") { bad = bad + 1; }
        Console.WriteLine("list-search-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
