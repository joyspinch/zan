using System;
// Every shape the compile-time-bit FloatLit rewrite could have broken:
// literal immediates, nullable boxing (GenNulWrap sites: init, coalesce,
// lifted arithmetic, array elements, fields), float narrowing, and the
// internal double param/return path. Golden = oracle stdout.
struct Pt {
    public double x;
}
class Boxed {
    public double? score;
}
class Program {
    static double Twice(double v) { return v * 2; }
    static double Sum(double? a, double? b) { return (a ?? 0) + (b ?? 0); }
    static void Main() {
        double d = 1.5;
        Console.WriteLine(d);
        float f = 0.25f;
        Console.WriteLine(f);
        Console.WriteLine(Twice(1.25));
        Console.WriteLine(Sum(1.5, 2.5));
        double? e = 1.5;
        Console.WriteLine(e ?? 0.0);
        double? n = null;
        Console.WriteLine(n ?? -7.5);
        Console.WriteLine("v=" + e);
        double? a = 1.5;
        double? b = 2.5;
        Console.WriteLine((a + b) ?? 0.0);
        Console.WriteLine(a < b ? "lt" : "ge");
        Console.WriteLine(a.HasValue ? "has" : "none");
        Console.WriteLine(n.HasValue ? "has" : "none");
        Pt p;
        p.x = 2.5;
        Console.WriteLine(p.x);
        Boxed box = new Boxed();
        box.score = 2.5;
        Console.WriteLine(box.score ?? 0.0);
        box.score = null;
        Console.WriteLine(box.score ?? -1.0);
        double?[] arr = new double?[] { 1.5, 2.5 };
        Console.WriteLine(arr[0] ?? 0.0);
        Console.WriteLine(arr[1] ?? 0.0);
        double h = 3;
        Console.WriteLine(h);
        float? ff = 0.5f;
        Console.WriteLine(ff ?? 9.0f);
    }
}
