class Shape {
    public string name;
    public Shape(string n) { name = n; }
    public virtual double Area() { return 0; }
    public virtual string Describe() { return "shape:" + name; }
    public string Id() { return "#" + name; }
}
class Circle : Shape {
    public double r;
    public Circle(double rad) : base("circle") { r = rad; }
    public override double Area() { return 3 * r * r; }
    public override string Describe() { return "circle r=" + r; }
}
class Square : Shape {
    public double side;
    public Square(double s) : base("square") { side = s; }
    public override double Area() { return side * side; }
}
class Plain {
    public int v;
    public int Get() { return v; }
}
class Over {
    public string F(int x) { return "int:" + x; }
    public string F(string s) { return "str:" + s; }
    public string F(double d) { return "dbl:" + d; }
}
class Program {
    static int Report(Shape s) {
        Console.WriteLine(s.Describe());
        Console.WriteLine(s.Area());
        Console.WriteLine(s.Id());
        return 0;
    }
    static void Main() {
        Shape c = new Circle(2);
        Report(c);
        Shape sq = new Square(3);
        Report(sq);
        Shape sh = new Shape("gen");
        Report(sh);
        Circle c2 = new Circle(1);
        Console.WriteLine(c2.Id());
        Plain p = new Plain();
        p.v = 42;
        Console.WriteLine(p.Get());
        Over o = new Over();
        Console.WriteLine(o.F(5));
        Console.WriteLine(o.F("x"));
        Console.WriteLine(o.F(1.5));
    }
}
