using System;
class NativeDelegateBox {
    int value;
    public NativeDelegateBox(int n) { value = n; }
    public int Add(int n) { return value + n; }
    public Func<int> Read() { return () => Add(2); }
    public Func<int, int> transform;
}
class NativeDelegate {
    static int Twice(int n) { return n * 2; }
    static string Describe(int n) { return "value=" + n; }
    static int Apply(Func<int, int> f, int n) { return f(n); }
    static Func<int, int> Make(int start) {
        int offset = start + 2;
        return n => offset + n;
    }
    static Func<int, Func<int, int>> Nested(int start) {
        return n => x => start + n + x;
    }
    static int Churn(int n) {
        int a = n + 1; int b = n + 2; int c = n + 3;
        if (n == 0) { return a + b + c; }
        return Churn(n - 1) + a + b + c;
    }
    static void Main() {
        Func<int, int> square = x => x * x;
        Console.WriteLine(square(7));
        Func<int, int> group = Twice;
        Console.WriteLine(group.Invoke(9));
        Func<int, string> text = new Func<int, string>(Describe);
        Console.WriteLine(text(4));
        Action<int> print = x => Console.WriteLine(x);
        print(12);
        Func<int, int> closure = Make(40);
        Churn(30);
        Console.WriteLine(closure(5));
        Console.WriteLine(closure(8));
        Func<int, int> other = Make(10);
        Console.WriteLine(other(1));
        Console.WriteLine(Apply(x => x + 3, 8));
        Func<int, int> block = x => { int y = x + 1; return y * 2; };
        Console.WriteLine(block(4));
        Func<int, int> bound = new NativeDelegateBox(20).Add;
        Console.WriteLine(bound(5));
        Func<int, Func<int, int>> outer = Nested(100);
        Func<int, int> inner = outer(20);
        Churn(20);
        Console.WriteLine(inner(3));
        square = x => x + 1;
        Console.WriteLine(square(7));
        Func<double, double> dbl = x => x + 0.5;
        Console.WriteLine(dbl(2));
        Action done = () => { Console.WriteLine("done"); };
        done();
        Func<int, int, int, int, int, int, int, int> sum = (a, b, c, d, e, f, g) => a + b + c + d + e + f + g;
        Console.WriteLine(sum(1, 2, 3, 4, 5, 6, 7));
        NativeDelegateBox box = new NativeDelegateBox(30);
        box.transform = x => x + 7;
        Console.WriteLine(box.transform(2));
        Func<int> read = box.Read();
        Churn(30);
        Console.WriteLine(read());
        int shadow = 10;
        Func<int, int> shadowParam = shadow => shadow + 1;
        Func<int> shadowLocal = () => { int shadow = 30; return shadow; };
        Console.WriteLine(shadowParam(20));
        Console.WriteLine(shadowLocal());
        Console.WriteLine(Apply(Twice, 6));
    }
}
