// b46: fail-soft diagnostic face (consensus subset — the shipped oracle
// binary predates the ARC-headed scratch redesign in rt_timer.c, so the
// probe asserts only what binary and sources agree on: soft-by-default,
// stable non-null scratch pointer, zeroed payload).
using System;

class Program {
    [DllImport("crt", EntryPoint = "zan_rt_soft_is_hard")]
    static extern int SoftIsHard();
    [DllImport("crt", EntryPoint = "zan_rt_soft_scratch")]
    static extern nint SoftScratch();

    static int Main() {
        Console.WriteLine("hard0=" + (SoftIsHard() == 0 ? 1 : 0));
        nint p = SoftScratch();
        nint p2 = SoftScratch();
        Console.WriteLine("scr-ptr=" + (p != 0 && p == p2 ? 1 : 0));
        int z = 1;
        for (int i = 0; i < 64; i = i + 1) {
            if (new Span<byte>(p, 64)[i] != 0) { z = 0; }
        }
        Console.WriteLine("scr-zero=" + z);
        Console.WriteLine("end");
        return 0;
    }

    static nint st_ptr(long v) { return (nint)v; }
}
