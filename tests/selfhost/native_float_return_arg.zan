using System;
class Program {
    static double Two() { return 2; }
    static float Three() { return 3; }
    static float Take(float x) { return x; }
    static double WithFinally() {
        try { return 4; }
        finally { Console.WriteLine("finally"); }
    }
    static void Main() {
        Console.WriteLine(Two());
        Console.WriteLine(Three());
        Console.WriteLine(Take(5));
        Console.WriteLine(WithFinally());
    }
}
