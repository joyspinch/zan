// kernel15: slice 14 -- enums (running counter, explicit resets, duplicate
// values, casts, member constants, ToString naming with numeric fallback)
// and expression-bodied methods (=> expr)
using System;
enum Color { Red, Green = 10, Olive = 10, Blue }
enum Small { A, B, C }
class P {
    static int failures = 0;
    static void Check(bool ok, string tag) {
        if (ok) { Console.WriteLine("ok " + tag); }
        else { failures = failures + 1; Console.WriteLine("FAIL " + tag); }
    }
    // expression-bodied methods
    static string Tag() => "user-app";
    static int Twice(int v) => v * 2;
    static Color Pick(int n) { return (Color)n; }
    static int Main() {
        // expression-bodied members behave like normal methods
        Check(Tag() == "user-app", "arrow-method");
        Check(Twice(21) == 42, "arrow-args");
        // member constants follow the C# running counter
        Check((int)Color.Red == 0, "enum-counter");
        Check((int)Color.Green == 10, "enum-reset");
        Check((int)Color.Olive == 10, "enum-dup");
        Check((int)Color.Blue == 11, "enum-after-dup");
        Check((int)Small.B == 1, "enum-auto");
        // casts are numeric
        Check((int)((Color)42) == 42, "enum-cast");
        // ToString names the member (earliest declared wins a duplicate)
        Check(Color.Green.ToString() == "Green", "enum-name");
        Check(Pick(10).ToString() == "Green", "enum-first-wins");
        Check(Pick(0).ToString() == "Red", "enum-name-zero");
        Check(Pick(11).ToString() == "Blue", "enum-name-next");
        Check(Pick(42).ToString() == "42", "enum-fallback");
        // comparisons are value comparisons; WriteLine renders the number
        Check(Color.Blue == Color.Green + 1, "enum-cmp");
        Small s = Small.C;
        Check(s.ToString() == "C", "enum-local-name");
        Check(s == 2, "enum-as-int");
        if (failures == 0) { Console.WriteLine("kernel15 ok"); }
        return failures;
    }
}
