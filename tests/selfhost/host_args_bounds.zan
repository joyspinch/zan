using System;
namespace HostArgsBounds;

// Run both without arguments and with: alpha beta
// Both runs match host_args_bounds.out. Checks empty result value + header,
// exact upper bound, negative bounds, integer overflow, and valid argv reads.
class Program {
    static void Main() {
        int count = Environment.ArgCount();
        Console.WriteLine(Environment.ArgAt(-1) == "");
        Console.WriteLine(Environment.ArgAt(-2).Length);
        Console.WriteLine(Environment.ArgAt(count) == "");
        Console.WriteLine(Environment.ArgAt(count + 1).Length);
        long high = 9223372036854775807;
        long low = -9223372036854775807 - 1;
        Console.WriteLine(Environment.ArgAt(high) == "");
        Console.WriteLine(Environment.ArgAt(low).Length);
        if (count == 0) {
            Console.WriteLine(Environment.ArgAt(0) == "");
            Console.WriteLine(Environment.ArgAt(1) == "");
        } else {
            Console.WriteLine(Environment.ArgAt(0) == "alpha");
            Console.WriteLine(Environment.ArgAt(count - 1) == "beta");
        }
        Console.WriteLine("ok");
    }
}
