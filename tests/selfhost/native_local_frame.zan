using System;
class NativeLocalFrame {
    static int Many(int first, int second, int third, int fourth, int fifth, int sixth, int seventh, int eighth) {
        int a0 = 1; int a1 = 2; int a2 = 3; int a3 = 4;
        int a4 = 5; int a5 = 6; int a6 = 7; int a7 = 8;
        int a8 = 9; int a9 = 10; int a10 = 11; int a11 = 12;
        int a12 = 13; int a13 = 14; int a14 = 15; int a15 = 16;
        int a16 = 17; int a17 = 18; int a18 = 19; int a19 = 20;
        int a20 = 21; int a21 = 22; int a22 = 23; int a23 = 24;
        int a24 = 25; int a25 = 26; int a26 = 27; int a27 = 28;
        int a28 = 29; int a29 = 30; int a30 = 31; int a31 = 32;
        int a32 = 33; int a33 = 34; int a34 = 35; int a35 = 36;
        int a36 = 37; int a37 = 38; int a38 = 39; int a39 = 40;
        return first + second + third + fourth + fifth + sixth + seventh + eighth
            + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9
            + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19
            + a20 + a21 + a22 + a23 + a24 + a25 + a26 + a27 + a28 + a29
            + a30 + a31 + a32 + a33 + a34 + a35 + a36 + a37 + a38 + a39;
    }
    static void Main() { Console.WriteLine(Many(101, 102, 103, 104, 105, 106, 107, 108)); }
}
