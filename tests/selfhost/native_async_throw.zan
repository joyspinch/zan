using System;

// Native async slice: exception propagation across suspension frames. A throw
// before the first await and one after a suspension must both land in the
// root-level catch; a non-throwing chain still returns through the frames.
class Boom {
    string msg;
    Boom(string m) { this.msg = m; }
    string Message() { return this.msg; }
}

class Program {
    static async int Tick() {
        return 1;
    }

    static async int Leaf(int mode) {
        if (mode == 1) {
            throw new Boom("pre-await");
        }
        await Tick();
        if (mode == 2) {
            throw new Boom("post-await");
        }
        return 7;
    }

    static async int Mid(int mode) {
        int v = await Leaf(mode);
        return v + 1;
    }

    static void Main() {
        try {
            int a = await Mid(1);
            Console.WriteLine("unreachable " + Convert.ToString(a));
        } catch (Boom e) {
            Console.WriteLine("caught " + e.Message());
        }
        try {
            int b = await Mid(2);
            Console.WriteLine("unreachable " + Convert.ToString(b));
        } catch (Boom e) {
            Console.WriteLine("caught " + e.Message());
        }
        int ok = await Mid(0);
        Console.WriteLine("ok " + Convert.ToString(ok));
    }
}
