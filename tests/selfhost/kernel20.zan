class BizDef {
    static int KindCount(string key, params string[] kinds) {
        if (key == "arr") { return kinds.Count; }
        return kinds.Count;
    }
    static int Sum(params int[] xs) {
        int t = 0;
        int i = 0;
        while (i < xs.Count) { t = t + xs[i]; i = i + 1; }
        return t;
    }
    static int LastIndex(params int[] xs) {
        return xs.Count - 1;
    }
}
class Program {
    static int Mix(int a, params string[] rest) {
        return a + rest.Count;
    }
    static void Main() {
        Console.WriteLine(BizDef.KindCount("one", "k1", "k2", "k3"));
        Console.WriteLine(BizDef.KindCount("zero"));
        string[] nums = new string[] { "4", "5", "6", "7" };
        Console.WriteLine(BizDef.KindCount("arr", nums));
        Console.WriteLine(BizDef.LastIndex(9, 8, 7));
        Console.WriteLine(BizDef.Sum(1, 2, 3));
        Console.WriteLine(BizDef.Sum());
        int[] arr = new int[] { 5, 6, 7 };
        Console.WriteLine(BizDef.Sum(arr));
        Console.WriteLine(Mix(10));
        Console.WriteLine(Mix(10, "z"));
        Console.WriteLine(Mix(10, "a", "b"));
        int[] a = new int[] { 10, 20, 30 };
        Console.WriteLine(a.Count);
        Console.WriteLine(a.Length);
        Console.WriteLine(a[0] + a[2]);
        string[] s = new string[] { "x", "y" };
        Console.WriteLine(s[1]);
        int[] b = new int[3];
        b[1] = 7;
        Console.WriteLine(b[1]);
    }
}
