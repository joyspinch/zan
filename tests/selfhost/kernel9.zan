// kernel9: strings/lists slice -- stamped literals, Length, char indexing,
// Substring, IndexOf, string equality, List element get/set, Console.Write.
class K9 {
    static void Main() {
        string s = "hello world";
        Console.WriteLine(s.Length);
        Console.WriteLine(s[4]);
        Console.WriteLine(s.Substring(6));
        Console.WriteLine(s.IndexOf("o w"));
        Console.WriteLine(s.IndexOf("zz"));
        Console.WriteLine(s == "hello world");
        Console.WriteLine(s != "hello world");
        Console.WriteLine("len=" + s.Length);
        List<int> xs = new List<int>();
        xs.Add(10); xs.Add(20); xs.Add(30);
        Console.WriteLine(xs[1]);
        xs[1] = 99;
        Console.WriteLine(xs[1]);
        Console.WriteLine(xs.Count);
        List<string> ss = new List<string>();
        ss.Add("a"); ss.Add("b");
        Console.WriteLine(ss[1]);
        Console.Write("no");
        Console.Write(" newline");
        Console.WriteLine();
        Console.Write(7);
        Console.WriteLine("end");
        Console.WriteLine("done");
    }
}
