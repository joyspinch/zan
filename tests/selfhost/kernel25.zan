using System;

// slice 23: element reads and writes through containers that are not
// plain locals -- instance fields, call results, class-qualified
// statics, nested arrays and List<T> fields
class Buf {
    byte[] data;
    List<int> marks;

    Buf(int n) { data = new byte[n]; marks = new List<int>(); }

    byte[] Data() { return data; }

    void Xor(byte[] other) {
        int i = 0;
        while (i < data.Length) { data[i] = (byte)(data[i] ^ other[i]); i = i + 1; }
    }

    void Mark(int m) { marks.Add(m); }
    int MarkAt(int i) { return marks[i]; }
}

class Store {
    static int[] shared = new int[3];
    int[][] grid = new int[2][];

    static void Put(int i, int v) { shared[i] = v; }
    static int Get(int i) { return shared[i]; }

    void Fill() {
        grid[0] = new int[2];
        grid[1] = new int[2];
        grid[0][0] = 72;
        grid[1][1] = 34;
    }
}

class Program {
    static void Main() {
        Buf a = new Buf(4);
        Buf b = new Buf(4);
        int i = 0;
        while (i < 4) {
            a.Data()[i] = (byte)(200 + i);
            b.Data()[i] = 255;
            i = i + 1;
        }
        Console.WriteLine((int)a.Data()[0] + "," + (int)a.Data()[3]);
        a.Xor(b.Data());
        Console.WriteLine((int)a.Data()[0] + "," + (int)a.Data()[3]);

        Store.Put(1, 4242);
        Console.WriteLine(Store.shared.Length + "," + Store.Get(1));

        Store st = new Store();
        st.Fill();
        Console.WriteLine(Convert.ToString(st.grid[0][0]) + "," + Convert.ToString(st.grid[1][1]));

        a.Mark(7);
        a.Mark(9);
        Console.WriteLine(a.MarkAt(0) + "," + a.MarkAt(1));
    }
}
