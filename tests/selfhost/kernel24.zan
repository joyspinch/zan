class Box2 {
    public double v;
    public Box2(double x) { v = x; }
}
class Program {
    static double Twice(double x) { return x * 2; }
    static void Main() {
        Box2 b = new Box2(3);
        Console.WriteLine(b.v);
        Console.WriteLine(Twice(4));
        double d = 5;
        Console.WriteLine(d);
    }
}
