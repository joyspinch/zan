// b42: zan_thread_detach face (rt_sync.c:929) + zan_io_pump{,_timeout}
// idle contract. Main detaches (EH state drop, observable no-op), a
// worker detaches mid-body and keeps running; pump faces report 0 on
// an idle runtime (no registered reactor interest on either lane).
using System;
using System.Threading;

class Program {
    [DllImport("crt", EntryPoint = "zan_thread_detach")]
    static extern void Detach();
    [DllImport("crt", EntryPoint = "zan_io_pump")]
    static extern long Pump();
    [DllImport("crt", EntryPoint = "zan_io_pump_timeout")]
    static extern long PumpTimeout(long ms);

    static AtomicInt done = new AtomicInt(0);
    static AtomicInt afterDetach = new AtomicInt(0);

    static void Worker() {
        Detach();
        // still running after the detach: the slot hand-back must not
        // kill the thread or its TLS
        afterDetach.Store(41);
        done.Store(1);
    }

    static int Main() {
        Detach();
        Console.WriteLine("pump=" + Pump());
        Console.WriteLine("pumpt=" + PumpTimeout(0));
        Thread.Start(Worker);
        int spins = 0;
        while (done.Load() == 0 && spins < 5000) { Thread.Sleep(1); spins = spins + 1; }
        Console.WriteLine("worker=" + (done.Load() == 1 ? 1 : 0));
        Console.WriteLine("after=" + afterDetach.Load());
        Console.WriteLine("end");
        return 0;
    }
}
