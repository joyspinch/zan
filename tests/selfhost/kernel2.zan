// kernel2: object-model kernel slice -- classes, fields, constructors,
// instance methods, string literals and concatenation, new expressions.
class P {
    int x;
    string name;
    public P(int px, string pname) {
        x = px;
        name = pname;
    }
    public int Get() {
        return x;
    }
    public string Greet() {
        return "Hi " + name + "!";
    }
    public void SetX(int v) {
        x = v;
    }
}

class K2 {
    static int Sum(int a, int b) {
        return a + b;
    }
    static void Main() {
        P p = new P(7, "zan");
        Console.WriteLine(p.Get());
        p.SetX(p.Get() * 6);
        Console.WriteLine(p.Get());
        Console.WriteLine(p.Greet());
        Console.WriteLine(Sum(p.Get(), 1));
    }
}
