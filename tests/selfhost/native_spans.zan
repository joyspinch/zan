// Batch 12 permanent fixture: Span views are FRAME boxes (one private
// 16-byte slot per construction site, zero heap allocation) with pair-copy
// value semantics and by-value Span parameters -- the C# ref-struct shape.
// Golden covers: copy-on-assign, view parameters (callee reads the caller's
// frame box), hot-loop slot reuse (the old code leaked 16 bytes per
// construction here), ternary views, inline new-Span indexing, and the
// window-clamp soft path folding to the empty view.
using System;

class P {
    // a Span parameter: the callee's slot pair-copies the caller's box at
    // entry (prologue normalization), so reassigning it stays by-value
    static long TallyBytes(long[] w, Span<byte> b) {
        long t = 0;
        int j = 0;
        while (j < 4) {
            t = t + b[j];
            w[j] = b[j];
            j = j + 1;
        }
        b = b.Slice(1, 2);                       // by-value rebind inside callee
        return t * 100 + b[0];
    }

    // three view sites per call; a fresh frame each call rewrites them
    static long PerCall(long[] a) {
        Span<long> v = a.AsSpan(1, 3);
        long t = v[0] + v[2];
        Span<long> s = v.Slice(1, 2);
        t = t + s[0];
        t = t + new Span<long>(a, 4)[3];
        return t;
    }

    static long LoopReuse(long[] a) {
        long acc = 0;
        int i = 0;
        while (i < 100000) {
            // two sites rewritten every iteration: the pre-batch code
            // leaked 32 bytes per iteration (3.2 MB over this loop)
            Span<long> v = a.AsSpan(0, 4);
            Span<long> s = v.Slice(2, 2);
            acc = acc + s[1] + v[0];
            i = i + 1;
        }
        return acc;
    }

    static long CopySemantics(long[] a) {
        Span<long> x = a.AsSpan(0, 4);
        Span<long> y = x;                        // pair copy: y owns its slot
        x = x.Slice(2, 2);                       // rebind x; y keeps {a, 4}
        return y[3] * 100 + x[1];                // 40*100 + 40
    }

    static long TernaryView(long[] a, bool c) {
        Span<long> v = c ? a.AsSpan(0, 2) : a.AsSpan(3, 2);
        return v[1];
    }

    static long Main() {
        long[] a = new long[] { 10, 20, 30, 40, 50, 60 };
        byte[] ab = new byte[] { 7, 8, 9, 10 };
        long[] w = new long[8];

        Console.WriteLine(PerCall(a));                       // 130
        Console.WriteLine(LoopReuse(a));                     // 100000 * 50
        Console.WriteLine(CopySemantics(a));                 // 4040
        Console.WriteLine(TernaryView(a, true));             // 20
        Console.WriteLine(TernaryView(a, false));            // 50
        Console.WriteLine(TallyBytes(w, ab.AsSpan(0, 4)));   // 34*100 + 8 = 3408
        Console.WriteLine(w[2]);                             // 9

        // inline new-Span get + set (no declared local at all)
        byte[] ib = new byte[4];
        new Span<byte>(ib, 4)[0] = 0x5A;
        Console.WriteLine(new Span<byte>(ib, 4)[0] == 90 ? 1 : 0);

        // window past the remaining elements folds to the EMPTY view
        Span<long> e = a.AsSpan(4, 99);
        Console.WriteLine(e.Length == 0 ? 111 : 222);

        // narrow element view: int-span load sign-extends like the array path
        int[] ia = new int[] { -7, 9 };
        Span<int> iv = new Span<int>(ia, 2);
        Console.WriteLine(iv[0] + iv[1]);                    // 2
        return 0;
    }
}
