using System;

[StructLayout(LayoutKind.Explicit)]
struct Packed {
    [FieldOffset(0)] byte guard;
    [FieldOffset(1)] int bits;
    [FieldOffset(1)] float real;
    [FieldOffset(1)] byte low;
    [FieldOffset(4)] byte high;
    [FieldOffset(5)] byte after;
    [FieldOffset(9)] short signed;
    [FieldOffset(9)] ushort unsigned;
    [FieldOffset(11)] sbyte sb;
    [FieldOffset(40001)] int distant;
    [FieldOffset(40005)] byte end;
}
class Program {
    static void Main() {
        Packed p = new Packed();
        p.guard = 77; p.after = 88; p.end = 99;
        p.bits = -1;
        Console.WriteLine(p.bits);
        Console.WriteLine(p.low);
        Console.WriteLine(p.high);
        p.real = 1.5;
        Console.WriteLine(p.real);
        Console.WriteLine(p.bits);
        p.bits = 1075838976;
        Console.WriteLine(p.real);
        p.signed = -2;
        Console.WriteLine(p.signed);
        Console.WriteLine(p.unsigned);
        p.sb = -3;
        Console.WriteLine(p.sb);
        p.distant = -123;
        Console.WriteLine(p.distant);
        Console.WriteLine(p.guard);
        Console.WriteLine(p.after);
        Console.WriteLine(p.end);
        Packed q = p;
        q.low = 1;
        Console.WriteLine(p.low);
        Console.WriteLine(q.low);
    }
}
