// b34: digest/crypto boundary sweep. crypto_digests.zan covers only
// "abc"-length input; the risky paths are the padding/length boundaries
// (55/56/57, 63/64/65, 111/112/113, 127/128/129 for the 64/128-byte
// block families) and HMAC keys at the 64-byte boundary (long keys get
// hashed first). All vectors deterministic; byte-compare across
// toolchains.
using System;
using System.Security.Cryptography;

class Program {
    static string Pat(int len) {
        string s = "";
        while (s.Length < len) { s = s + "0123456789abcdef"; }
        return s.Substring(0, len);
    }

    static void Main() {
        int[] lens = new int[22];
        lens[0] = 0; lens[1] = 1; lens[2] = 2; lens[3] = 3; lens[4] = 31;
        lens[5] = 32; lens[6] = 54; lens[7] = 55; lens[8] = 56; lens[9] = 57;
        lens[10] = 63; lens[11] = 64; lens[12] = 65; lens[13] = 111;
        lens[14] = 112; lens[15] = 113; lens[16] = 119; lens[17] = 120;
        lens[18] = 127; lens[19] = 128; lens[20] = 129; lens[21] = 200;
        int i = 0;
        while (i < lens.Length) {
            int len = lens[i];
            string p = Pat(len);
            Console.WriteLine("l" + Convert.ToString(len)
                + " s256 " + Hex.Encode(Sha256.Hash(p, len), 32));
            Console.WriteLine("l" + Convert.ToString(len)
                + " s1   " + Hex.Encode(Sha1.Hash(p, len), 20));
            Console.WriteLine("l" + Convert.ToString(len)
                + " md5  " + Hex.Encode(Md5.Hash(p, len), 16));
            Console.WriteLine("l" + Convert.ToString(len)
                + " s512 " + Hex.Encode(Sha512.Hash(p, len), 64));
            i = i + 1;
        }

        int[] klens = new int[9];
        klens[0] = 0; klens[1] = 1; klens[2] = 31; klens[3] = 32;
        klens[4] = 63; klens[5] = 64; klens[6] = 65; klens[7] = 100;
        klens[8] = 200;
        string msg = "The quick brown fox jumps over the lazy dog";
        int j = 0;
        while (j < klens.Length) {
            int klen = klens[j];
            Console.WriteLine("k" + Convert.ToString(klen) + " hmac "
                + Hex.Encode(Hmac.Sha256Mac(Pat(klen), klen, msg, msg.Length), 32));
            j = j + 1;
        }

        int[] blens = new int[8];
        blens[0] = 0; blens[1] = 1; blens[2] = 2; blens[3] = 3;
        blens[4] = 4; blens[5] = 5; blens[6] = 6; blens[7] = 57;
        int b = 0;
        while (b < blens.Length) {
            int blen = blens[b];
            string raw = Pat(blen);
            string b64 = Base64.Encode(raw, blen);
            Console.WriteLine("b" + Convert.ToString(blen) + " b64 " + b64);
            Console.WriteLine("b" + Convert.ToString(blen) + " hex " + Hex.Encode(raw, blen));
            b = b + 1;
        }
    }
}
