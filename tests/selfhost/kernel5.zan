// kernel5: int -> string conversion in concatenation -- literals on either
// side, locals, arithmetic subexpressions, static method results, chained
// concat, and bools printing through the same i64 path as gen0.
class K5 {
    static int Base() { return 40; }
    static void Main() {
        int n = 7;
        Console.WriteLine("n=" + n);
        Console.WriteLine(n + "!");
        Console.WriteLine("sum=" + (n + 35));
        Console.WriteLine(Base() + 2);
        Console.WriteLine("base=" + Base());
        string s = "x" + n + "y";
        Console.WriteLine(s);
        bool b = n > 3;
        Console.WriteLine("b=" + b);
    }
}
