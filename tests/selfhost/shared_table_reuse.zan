// b33 regression: dead-row reuse must rewrite the key copy (oracle
// rt_sync.c zan_find_row memcpy's the new key on both tombstone claim
// paths). Before the fix a reused row kept its dead key: key-path
// lookups missed forever while hash-path lookups still hit. Also:
// empty-key insert refusal, same-key recreate, rate windows pinned to
// explicit timestamps so the golden stays deterministic.
using System;
using System.Threading;

class Program {
    static int Main() {
        SharedTable stale = SharedTable.Open("st_regress_b33");
        if (stale != null) { stale.Destroy(); }
        SharedTable t = new SharedTable("st_regress_b33", 16);
        t.KeySize(32);
        t.ColumnInt("count");
        t.ColumnInt("window_start");
        Console.WriteLine("create: " + Convert.ToString(t.Create() ? 1 : 0));

        Console.WriteLine("set1: " + Convert.ToString(t.SetInt("k", "count", 7) ? 1 : 0));
        Console.WriteLine("get1: " + Convert.ToString(t.GetInt("k", "count")));
        Console.WriteLine("del1: " + Convert.ToString(t.Delete("k") ? 1 : 0));
        Console.WriteLine("gone: " + Convert.ToString(t.Exists("k") ? 1 : 0));

        Console.WriteLine("set2: " + Convert.ToString(t.SetInt("m", "count", 9) ? 1 : 0));
        Console.WriteLine("has2: " + Convert.ToString(t.Exists("m") ? 1 : 0));
        Console.WriteLine("get2: " + Convert.ToString(t.GetInt("m", "count")));
        Console.WriteLine("oldgone: " + Convert.ToString(t.Exists("k") ? 1 : 0));
        Console.WriteLine("cnt2: " + Convert.ToString(t.Count()));

        Console.WriteLine("del2: " + Convert.ToString(t.Delete("m") ? 1 : 0));
        Console.WriteLine("set3: " + Convert.ToString(t.SetInt("m", "count", 11) ? 1 : 0));
        Console.WriteLine("get3: " + Convert.ToString(t.GetInt("m", "count")));
        Console.WriteLine("cnt3: " + Convert.ToString(t.Count()));

        Console.WriteLine("empty: " + Convert.ToString(t.SetInt("", "count", 1) ? 1 : 0));
        Console.WriteLine("ehas: " + Convert.ToString(t.Exists("") ? 1 : 0));

        Console.WriteLine("ra1: " + Convert.ToString(t.RateAllow("r", 1000, 100, 1) ? 1 : 0));
        Console.WriteLine("ra2: " + Convert.ToString(t.RateAllow("r", 1050, 100, 1) ? 1 : 0));
        Console.WriteLine("ra3: " + Convert.ToString(t.RateAllow("r", 1200, 100, 1) ? 1 : 0));
        Console.WriteLine("cnt4: " + Convert.ToString(t.Count()));
        Console.WriteLine("destroy: " + Convert.ToString(t.Destroy() ? 1 : 0));
        return 0;
    }
}
