using System;
using System.Collections.Generic;
class App {
 static int F2() { return 4294967295; }
 static int Echo2(int x) { return x; }
 static void Main() {
  int b = 4294967295;
  Console.WriteLine(b);
  Console.WriteLine(F2());
  Console.WriteLine(Echo2(4294967295));
  int[] arr = new int[2];
  arr[0] = 4294967295;
  Console.WriteLine(arr[0]);
  int s = 0;
  foreach (int n in arr) { s = s - n; }
  Console.WriteLine(s);
  List<int> vs = new List<int>();
  vs.Add(4294967295);
  vs[0] = 4294967295;
  Console.WriteLine(vs[0]);
  long g = 5000000000;
  int t = g;
  Console.WriteLine(t);
  long keep = 4294967295;
  Console.WriteLine(keep);
 }
}
