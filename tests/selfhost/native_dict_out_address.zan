using System;
using System.Collections;
class OutHolder { public int value; }
class NativeDictOutAddress {
    static OutHolder holder;
    static OutHolder Target() { Console.WriteLine("receiver"); return holder; }
    static int Index() { Console.WriteLine("index"); return 1; }
    static void Main() {
        holder = new OutHolder();
        Dictionary<string, int> d = new Dictionary<string, int>();
        d["key"] = 73;
        Console.WriteLine(d.TryGetValue("key", out Target().value));
        Console.WriteLine(holder.value);
        int[] values = new int[2];
        Console.WriteLine(d.TryGetValue("key", out values[Index()]));
        Console.WriteLine(values[1]);
    }
}
