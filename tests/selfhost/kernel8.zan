// kernel8: ulong/shift slice -- unsigned division with the zero guard,
// logical vs arithmetic right shift, unsigned comparisons (high bit set),
// WriteLine(ulong) and ulong/string concat.
class K8 {
    static ulong Pick() { return 100; }
    static void Main() {
        ulong u = 123;
        Console.WriteLine(u);
        Console.WriteLine(u / 7);
        Console.WriteLine(u % 7);
        Console.WriteLine(u >> 2);
        Console.WriteLine(u << 1);
        Console.WriteLine("u=" + u);
        Console.WriteLine(u > 100);
        Console.WriteLine(u >= 123);
        Console.WriteLine(u < 50);
        Console.WriteLine(u != 123);
        ulong m = 0 - 1;
        Console.WriteLine(m);
        Console.WriteLine(m > 0);
        Console.WriteLine(m / 3);
        Console.WriteLine("m=" + m);
        int s = -8;
        Console.WriteLine(s >> 1);
        Console.WriteLine(s << 2);
        Console.WriteLine(Pick());
        int neg = -5;
        Console.WriteLine(-neg);
        Console.WriteLine(!true);
        Console.WriteLine(!false);
        double dv = 3.75;
        Console.WriteLine((int)dv);
        Console.WriteLine((double)7);
        Console.WriteLine("d2i=" + (int)(dv / 2));
        Console.WriteLine("done");
    }
}
