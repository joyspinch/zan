// kernel18: slice 17 -- switch statements: int/string/enum discriminants,
// grouped cases, empty-case fallthrough, default, break targeting the switch
// exit rather than an enclosing loop
using System;
enum Color { Red, Green, Blue }
class P {
    static int failures = 0;
    static void Check(bool ok, string tag) {
        if (ok) { Console.WriteLine("ok " + tag); }
        else { failures = failures + 1; Console.WriteLine("FAIL " + tag); }
    }
    static string Name(int n) {
        switch (n) {
            case 0: return "zero";
            case 1: return "one";
            case 2:
            case 3: return "small";
            default: return "big";
        }
    }
    static int Main() {
        for (int i = 0; i < 5; i = i + 1) {
            switch (i) {
                case 0: Console.WriteLine("zero"); break;
                case 1: Console.WriteLine("one"); break;
                case 2:
                case 3: Console.WriteLine("two-or-three"); break;
                default: Console.WriteLine("many"); break;
            }
        }
        string s = "beta";
        switch (s) {
            case "alpha": Console.WriteLine("A"); break;
            case "beta": Console.WriteLine("B"); break;
            default: Console.WriteLine("?"); break;
        }
        Color c = Color.Green;
        switch (c) {
            case Color.Red: Console.WriteLine("red"); break;
            case Color.Green: Console.WriteLine("green"); break;
            default: Console.WriteLine("other"); break;
        }
        // break leaves the switch, not an enclosing loop
        for (int j = 0; j < 3; j = j + 1) {
            switch (j) {
                case 1: Console.WriteLine("hit " + j); break;
                default: Console.WriteLine("d"); break;
            }
            Console.WriteLine("after " + j);
        }
        // switch inside a method used as an expression
        Check(Name(0) == "zero", "sw-ret");
        Check(Name(2) == "small", "sw-fallthrough");
        Check(Name(3) == "small", "sw-fallthrough2");
        Check(Name(9) == "big", "sw-default");
        if (failures == 0) { Console.WriteLine("kernel18 ok"); }
        return failures;
    }
}
