using System;
using System.Collections;
namespace Zan;
class ParserConversionTest {
    static void Main() {
        string src = "[StructLayout(LayoutKind.Explicit)] struct S { [FieldOffset(8)] int x; int y; public static implicit operator double(S s) => 1.5; public static implicit operator long(S s) { return 2; } public static explicit operator int(S s) => 3; } class implicit { } class C { implicit Value; } interface I { int Run() { return 4; } int Go(); }";
        Diags d = new Diags();
        Lexer lx = new Lexer(src);
        Parser p = new Parser(lx.Run(), d);
        Node u = p.ParseUnit();
        Node s = u.kids[0];
        Console.WriteLine(d.HasErrors());
        Console.WriteLine(s.layoutExplicit);
        Console.WriteLine(s.kids[0].fieldOffset);
        Console.WriteLine(s.kids[1].fieldOffset);
        int i = 2;
        while (i < 5) {
            Node m = s.kids[i];
            Console.WriteLine(m.sval);
            Console.WriteLine(m.type.sval);
            Console.WriteLine(m.kids[0].type.sval);
            Console.WriteLine(m.d != null);
            i = i + 1;
        }
        Console.WriteLine(u.kids[2].kids[0].type.sval);
        Node iface = u.kids[3];
        Console.WriteLine((iface.kids[0].mods & MOD.Virtual()) != 0);
        Console.WriteLine((iface.kids[1].mods & MOD.Abstract()) != 0);
        Diags bad = new Diags();
        Lexer bl = new Lexer("class B { static implicit operator int() => 1; }");
        Parser bp = new Parser(bl.Run(), bad);
        bp.ParseUnit();
        Console.WriteLine(bad.HasErrors());
    }
}
