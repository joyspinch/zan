using System;

// Native async slice: a discarded async call (`Bump(n);`) runs as a detached
// coroutine when the enclosing method suspends. The first halves run before
// the first print; the second halves complete across later suspensions.
class Program {
    static int steps = 0;

    static async int Touch() {
        return 0;
    }

    static async void Bump(int n) {
        Program.steps = Program.steps + n;
        await Touch();
        Program.steps = Program.steps + n;
    }

    static async int Run() {
        Program.Bump(1);
        Program.Bump(10);
        await Touch();
        Console.WriteLine("steps=" + Convert.ToString(Program.steps));
        await Touch();
        Console.WriteLine("steps=" + Convert.ToString(Program.steps));
        return 0;
    }

    static int Main() {
        return await Program.Run();
    }
}
