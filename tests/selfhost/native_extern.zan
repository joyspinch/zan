using System;

// Same bare name, different class/return type: lookup must keep the signature.
class Other {
    public static int Tail(string s, int c) { return 99; }
}

class Native {
    [DllImport("crt")] public static extern long fopen(string path, string mode);
    [DllImport("crt")] public static extern int fputc(int b, long f);
    [DllImport("crt")] public static extern int fclose(long f);
    [DllImport("crt")] public static extern long tmpfile();
    [DllImport("crt")] public static extern void rewind(long f);
    [DllImport("crt")] public static extern int fgetc(long f);
    [DllImport("crt", EntryPoint="strlen")] public static extern long Length(string s);
    [DllImport("crt", EntryPoint="atoi")] public static extern int Number(string s);
    [DllImport("crt", EntryPoint="atol")] public static extern long Wide(string s);
    [DllImport("crt", EntryPoint="strchr")] public static extern string Tail(string s, int c);
    [DllImport("crt", EntryPoint="abs")] public static extern int Absolute(int n);
    [DllImport("crt", EntryPoint="labs")] public static extern long Absolute(long n);

    public static void Main() {
        // Unqualified imports, dynamic strings and libc FILE* round-trip.
        string mode = "w" + "b";
        long sink = fopen("/dev/null", mode);
        Console.WriteLine(sink != 0);
        Console.WriteLine(fputc(65, sink));
        Console.WriteLine(fclose(sink));
        long f = tmpfile();
        fputc(0, f);
        Native.fputc(255, f);
        rewind(f);
        Console.WriteLine(fgetc(f));
        Console.WriteLine(Native.fgetc(f));
        // EOF exercises sign-extension from C's w0 to ngen's x0.
        Console.WriteLine(fgetc(f));
        Console.WriteLine(fclose(f));
        Console.WriteLine(Native.Length("ab" + "cde"));
        Console.WriteLine(Number("-123"));
        Console.WriteLine(Native.Wide("4294967297"));
        Console.WriteLine(Native.Tail("hello", 108));
        Console.WriteLine(Native.Absolute(-7));
        Console.WriteLine(Absolute((long)-4294967297));
    }
}
