// kernel16: slice 15 -- field access and field assignment through cast
// receivers ((Derived)b).f and index receivers (list[i].f, arr[i].f) with
// class element types; struct elements stay unsupported (fail-closed)
using System;
using System.Collections;
class Animal {
    public string name;
    public Animal(string n) { name = n; }
}
class Dog : Animal {
    public Dog(string n) : base(n) { }
    public int barks;
}
class P {
    static int failures = 0;
    static void Check(bool ok, string tag) {
        if (ok) { Console.WriteLine("ok " + tag); }
        else { failures = failures + 1; Console.WriteLine("FAIL " + tag); }
    }
    static int Main() {
        // cast receivers: read and write
        Animal a = new Dog("rex");
        Dog d = (Dog)a;
        Check(d.name == "rex", "cast-recv-read");
        d.barks = 3;
        Check(((Dog)a).barks == 3, "cast-recv-field");
        ((Dog)a).barks = 7;
        Check(d.barks == 7, "cast-recv-write");
        // List element receivers (class elements alias the stored object)
        List<Dog> pack = new List<Dog>();
        pack.Add(new Dog("alpha"));
        pack.Add(new Dog("beta"));
        Check(pack[1].name == "beta", "list-idx-read");
        pack[1].name = "beta2";
        Check(pack[1].name == "beta2", "list-idx-write");
        pack[1].barks = 5;
        Check(pack[1].barks == 5, "list-idx-derived-field");
        Check(pack[0].name == "alpha", "list-idx-isolated");
        // array element receivers
        Dog[] kennel = new Dog[2];
        kennel[0] = new Dog("k0");
        Check(kennel[0].name == "k0", "arr-idx-read");
        kennel[0].name = "K0";
        Check(kennel[0].name == "K0", "arr-idx-write");
        // receiver reached through a base-typed local
        Animal a2 = pack[0];
        Check(a2.name == "alpha", "upcast-local");
        if (failures == 0) { Console.WriteLine("kernel16 ok"); }
        return failures;
    }
}
