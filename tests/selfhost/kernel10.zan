// kernel10: arrays slice -- new T[n], element get/set, Length, bounds
// guards (gen0 parity: report then continue with index 0), element types.
class K10 {
    static void Main() {
        int[] a = new int[5];
        a[0] = 42;
        a[4] = 7;
        Console.WriteLine(a.Length);
        Console.WriteLine(a[0] + a[4]);
        int n = 3;
        int[] b = new int[n];
        b[1] = 9;
        Console.WriteLine(b.Length);
        Console.WriteLine(b[1]);
        Console.WriteLine(a[2]);
        long[] l = new long[2];
        l[0] = 123456789012345;
        Console.WriteLine(l[0]);
        double[] d = new double[2];
        d[1] = 2.5;
        Console.WriteLine(d[1] + 0.5);
        string[] ss = new string[2];
        ss[0] = "hi";
        Console.WriteLine(ss[0]);
        Console.WriteLine("len=" + a.Length);
        a[5] = 1;
        Console.WriteLine(a[0]);
        Console.WriteLine(a[0-1]);
        Console.WriteLine("done");
    }
}
