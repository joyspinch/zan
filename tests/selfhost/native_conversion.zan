using System;
struct Distance {
    public double Value;
    public Distance(double x) { Value = x; }
    public static implicit operator double(Distance x) => x.Value;
    public static implicit operator long(Distance x) { return (long)x.Value + 100; }
    public static explicit operator int(Distance x) => (int)x.Value;
    public static explicit operator double(Distance x) => x.Value + 1000.0;
}
class Reading {
    public double Value;
    public Reading(double x) { Value = x; }
    public static implicit operator Reading(double x) => new Reading(x + 1.0);
    public static implicit operator Reading(int x) => new Reading(x + 20.0);
}
class Program {
    static int Calls;
    static Distance Make() { Calls = Calls + 1; return new Distance(5.5); }
    static double Ret(Distance d) { return d; }
    static void Show(double d) { Console.WriteLine(d); }
    static void ShowReading(Reading d) { Console.WriteLine(d.Value); }
    static void Main() {
        Distance d = Make();
        double x = d;
        Console.WriteLine(x);
        long l = d;
        Console.WriteLine(l);
        x = Make();
        Console.WriteLine(x);
        Console.WriteLine(Ret(d));
        Show(Make());
        Console.WriteLine((int)d);
        Console.WriteLine((double)d);
        Reading r = 7.25;
        Console.WriteLine(r.Value);
        ShowReading(2.5);
        ShowReading(2);
        Console.WriteLine(d + 2.0);
        Console.WriteLine(2.0 + d);
        x += d;
        Console.WriteLine(x);
        Console.WriteLine(d.Value);
        Console.WriteLine(Calls);
        Console.WriteLine("done");
    }
}
