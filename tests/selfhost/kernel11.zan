// kernel11: slice 10 -- string.Join(sep, List<string>), Math static
// methods (integer negate/csel forms + libm doubles), List.Contains and
// List.Clear, and Console.ReadLine (EOF reads back as the empty string;
// the buffer keeps fgets' trailing newline when input is present).
class K11 {
    static void Main() {
        List<string> ss = new List<string>();
        ss.Add("alpha");
        ss.Add("beta");
        ss.Add("gamma");
        Console.WriteLine(string.Join("-", ss));
        Console.WriteLine(string.Join("", ss));
        Console.WriteLine(ss.Contains("beta"));
        Console.WriteLine(ss.Contains("delta"));
        Console.WriteLine(Math.Max(3, 9));
        Console.WriteLine(Math.Min(3, 9));
        Console.WriteLine(Math.Max(-7, 2));
        Console.WriteLine(Math.Abs(0 - 42));
        Console.WriteLine(Math.Max(1.5, 2.5));
        Console.WriteLine(Math.Min(1.5, 2.5));
        Console.WriteLine(Math.Sqrt(144.0));
        Console.WriteLine(Math.Pow(2.0, 10.0));
        Console.WriteLine(Math.Floor(3.7));
        Console.WriteLine(Math.Ceiling(3.2));
        Console.WriteLine(Math.Abs(0 - 2.5));
        ss.Clear();
        Console.WriteLine(ss.Contains("beta"));
        Console.WriteLine(string.Join(",", ss));
        string line = Console.ReadLine();
        Console.Write("line:[");
        Console.Write(line);
        Console.WriteLine("]");
        Console.WriteLine("done");
    }
}
