using System;

class Program {
    [DllImport("crt")] static extern string getenv(string name);
    [DllImport("crt")] static extern string strchr(string s, int c);
    [DllImport("crt")] static extern string mmap(long addr, long size, int prot, int flags, int fd, long offset);
    [DllImport("crt")] static extern int mprotect(string addr, long size, int prot);
    [DllImport("crt")] static extern int munmap(string addr, long size);
    [DllImport("crt")] static extern int getpagesize();
    [DllImport("crt")] static extern string memset(string addr, int value, long size);
    [DllImport("crt")] static extern string strcpy(string dst, string src);
    static string saved;
    static void Main() {
        string p = getenv("PATH");
        int scanned = 0;
        for (int i = 0; i < p.Length; i++) { int c = p[i]; scanned++; }
        Console.WriteLine(scanned == p.Length);
        Console.WriteLine(p.Length > 0);
        string tail = strchr("0123456789abc", 97);
        Console.WriteLine(tail.Length);
        Console.WriteLine(tail[0] == 97 && tail[2] == 99);
        saved = tail;
        Console.WriteLine(saved.Length == 3 && saved[1] == 98);
        string owned = "abcd".Replace("b", "BB");
        Console.WriteLine(owned.Length == 5 && owned[4] == 100);
        Console.WriteLine(owned[-1] == 97 && owned[100000000] == 97);
        string n = null;
        Console.WriteLine(n.Length == 0 && n[0] == 0);
        // Optional native-only adversarial mode. Darwin gen0's ARC still
        // blindly probes the header of this pointer; do not run this mode
        // under gen0. Native must survive an unreadable preceding VM page.
        if (Environment.ArgCount() > 0) { PageBoundary(); }
        Console.WriteLine("cstring-read-ok");
    }
    static void PageBoundary() {
        long page = getpagesize();
        string region = mmap(0, page * 2, 3, 4098, -1, 0); // MAP_PRIVATE|MAP_ANON
        memset(region, 120, page);
        // strchr returns the first NUL, exactly at the second page boundary.
        string s = strchr(region, 0);
        strcpy(s, "abc");
        if (mprotect(region, page, 0) != 0) { Console.WriteLine("protect-failed"); return; }
        Console.WriteLine(s.Length == 3 && s[0] == 97 && s[2] == 99);
        Console.WriteLine(s.IndexOf("b", 0) == 1);
        s[1] = 90; // header refresh must also tolerate unreadable preceding page
        Console.WriteLine(s.Length == 3 && s[1] == 90);
        mprotect(region, page, 3);
        munmap(region, page * 2);
    }
}
