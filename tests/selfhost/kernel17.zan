// kernel17: slice 16 -- integer literal suffixes (L/l, U/u, UL/lu in either
// order, hex literals included), gen0's int-domain narrowing of unsuffixed
// hex literals in the uint range, and the LoadImm floor-shift fix for
// negative constants wider than 16 bits
using System;
class P {
    static int failures = 0;
    static void Check(bool ok, string tag) {
        if (ok) { Console.WriteLine("ok " + tag); }
        else { failures = failures + 1; Console.WriteLine("FAIL " + tag); }
    }
    static int Main() {
        // decimal suffixes
        Check(1L == 1, "dec-L");
        Check(0L - 5L == -5, "dec-L-neg");
        Check(9223372036854775807L == 9223372036854775807, "dec-L-max");
        Check(-9223372036854775807L - 1 == -9223372036854775808, "dec-i64min");
        Check(1UL + 2 == 3, "dec-UL");
        Check(3u == 3, "dec-u");
        Check(2ul == 2, "dec-ul-lower");
        Check(7lu == 7, "dec-lu");
        // hex suffixes
        Check(0xFFL == 255, "hex-L");
        Check(0x10UL == 16, "hex-UL");
        // unsuffixed hex in the uint range types as int (gen0 narrowing):
        // the literal 0xFF378ADD must compare equal to its int-domain value
        Check(0xFF378ADD == -13137187, "hex-narrow-eq");
        Check(0xFFFFFFFF == -1, "hex-narrow-neg1");
        Check(0x7FFFFFFF == 2147483647, "hex-int-max");
        // narrowed constants reach the renderer correctly (LoadImm chunking)
        Console.WriteLine(0xFF378ADD);
        Console.WriteLine(0xFFFFFFFF);
        Console.WriteLine(-9223372036854775807L - 1);
        // long arithmetic built from suffixed literals
        long big = 10L * 1000L * 1000L;
        Check(big == 10000000, "suffix-arith");
        if (failures == 0) { Console.WriteLine("kernel17 ok"); }
        return failures;
    }
}
