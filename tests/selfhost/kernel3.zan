// kernel3: List<T> slice -- new, Add (including the cap*2 grow path),
// Count, string elements.
class K3 {
    static void Main() {
        List<int> xs = new List<int>();
        int i = 0;
        while (i < 10) {
            xs.Add(i * 3);
            i = i + 1;
        }
        Console.WriteLine(xs.Count);
        Console.WriteLine(xs.Count * 100);
        List<string> ss = new List<string>();
        ss.Add("a");
        ss.Add("b");
        ss.Add("c");
        Console.WriteLine(ss.Count);
    }
}
