using System;

// slice 24: interface-typed references (and interface-typed List
// elements) dispatch through the receiver's vtable to the concrete
// implementation; an interface is an all-abstract class
interface IShape { int Area(); string Name(); }

class Rect : IShape {
    int w; int h;
    Rect(int a, int b) { w = a; h = b; }
    int Area() { return w * h; }
    string Name() { return "rect"; }
}

class Circle : IShape {
    int r;
    Circle(int n) { r = n; }
    int Area() { return 3 * r * r; }
    string Name() { return "circle"; }
}

class Program {
    static int TotalArea(List<IShape> xs) {
        int a = 0;
        int i = 0;
        while (i < xs.Count) { a = a + xs[i].Area(); i = i + 1; }
        return a;
    }
    static void Main() {
        IShape s = new Rect(3, 4);
        Console.WriteLine(Convert.ToString(s.Area()));
        Console.WriteLine(s.Name());
        IShape c = new Circle(2);
        Console.WriteLine(Convert.ToString(c.Area()));
        Console.WriteLine(c.Name());
        List<IShape> xs = new List<IShape>();
        xs.Add(s);
        xs.Add(c);
        Console.WriteLine(Convert.ToString(TotalArea(xs)));
        object o = c;
        IShape back = o as IShape;
        Console.WriteLine(back.Name());
    }
}
