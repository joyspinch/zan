// b42: zan_file_app_dir (rt_file.c:219) + zan_exe_dir_into
// (rt_sync.c:2572) faces. Paths are run-specific, so only derived
// booleans print. exe_dir_into's success path is platform-split
// (darwin: /proc absent -> 0; linux: real path), so only its
// platform-independent contracts are asserted here; app_dir works on
// both (dotenv override, _NSGetExecutablePath / /proc/self/exe).
using System;

class Program {
    [DllImport("crt", EntryPoint = "zan_exe_dir_into")]
    static extern long ExeDirInto(nint buf, long cap);
    [DllImport("crt", EntryPoint = "zan_file_app_dir")]
    static extern nint AppDir();

    static int HasSlash(nint p) {
        for (int i = 0; i < 4096; i = i + 1) {
            int b = new Span<byte>(p + i, 1)[0];
            if (b == 0) { return 0; }
            if (b == 47) { return 1; }
        }
        return 0;
    }

    static int Main() {
        nint buf = NativeMemory.Alloc(4096);
        // contracts on both platforms
        Console.WriteLine("exe-cap0=" + (ExeDirInto(buf, 0) == 0 ? 1 : 0));
        Console.WriteLine("exe-nullout=" + (ExeDirInto((nint)0, 64) == 0 ? 1 : 0));
        Console.WriteLine("exe-negcap=" + (ExeDirInto(buf, -8) == 0 ? 1 : 0));
        nint ad = AppDir();
        Console.WriteLine("app-nonnull=" + (ad != (nint)0 ? 1 : 0));
        if (ad != (nint)0) {
            Console.WriteLine("app-slash=" + HasSlash(ad));
        }
        // ZAN_APP_DIR env override wins on the first call
        System.Environment.SetEnvironmentVariable("ZAN_APP_DIR", "/zzz-b42");
        nint ad2 = AppDir();
        Console.WriteLine("app2=" + (ad2 == ad ? 1 : 0));
        Console.WriteLine("end");
        return 0;
    }
}
