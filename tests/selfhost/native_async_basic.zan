using System;

// Native async slice: root-drive awaits in Main, chained async awaits,
// detach (fire-and-forget) ordering, result propagation.
class Program {
    static async void Work(string tag) {
        Console.WriteLine("work " + tag);
    }

    static async int Inner(int x) {
        int r = x + 100;
        return r;
    }

    static async int Outer(int y) {
        int inner = await Inner(y);
        await Work("mid");
        int doubled = inner * 2;
        await Work("end");
        return doubled + 21;
    }

    static void Main() {
        Work("detach-early");
        Console.WriteLine("before pump");
        int v = await Outer(21);
        Console.WriteLine(v);
        int n = await Inner(0);
        Console.WriteLine(n);
        await Work("detach-late");
    }
}
