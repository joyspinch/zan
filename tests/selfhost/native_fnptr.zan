using System;

// 缺口五:语言级函数指针。(nint)静态方法组取裸代码地址(未 intern 的
// even 值);(委托类型)nint 把地址变回可调用值——bit0 置 1 的"裸"
// 形态,调用点按声明签名直接 blr、不带 env。内联 lambda 走的是
// interned {thunk, env} 委托对象(bit0=0,成对读取)。两条路径共用
// 同一个调用点分岔,本 fixture 让它们在同一方法里交错出现。
class NativeFnPtr {
    static long Add(long a, long b) { return a + b; }
    static long Sub(long a, long b) { return a - b; }
    static int got;
    static void Ping(nint tag) { got = (int)tag; }

    static long Apply(Func<long, long, long> f, long x, long y) {
        return f(x, y);
    }

    static void Main() {
        // 方法组 → 裸地址 → 委托值:往返后按声明签名裸调
        Func<long, long, long> fa = (Func<long, long, long>)(nint)Add;
        Console.WriteLine(fa(20, 22));
        // 裸地址穿过方法调用边界再变回委托
        Console.WriteLine(Apply((Func<long, long, long>)(nint)Sub, 50, 8));
        // interned lambda:同一调用点走 {thunk, env} 成对读取路径
        Func<long, long, long> lam = (a, b) => a * b;
        Console.WriteLine(lam(6, 7));
        Console.WriteLine(Apply(lam, 6, 7));
        // 同一地址可以反复变换成(不同的)委托值
        Func<long, long, long> fb = (Func<long, long, long>)(nint)Add;
        Console.WriteLine(fb(1, 1));
        // 单参 void 形状(线程 trampoline 所用的那管)
        Action<nint> ping = (Action<nint>)(nint)Ping;
        ping(7);
        Console.WriteLine(got);
    }
}
