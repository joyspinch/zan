class Node2 {
    public string tag;
    public int id;
    public Node2() : this(0) {
        tag = tag + ":zero";
    }
    public Node2(int n) : this("n" + n) {
        id = n;
    }
    public Node2(string s) {
        tag = s;
    }
}
class Base {
    public string bt;
    public Base() { bt = "B"; }
}
class Derived : Base {
    public string dt;
    public Derived() : this("x") { }
    public Derived(string s) { dt = s; }
}
class Program {
    static void Main() {
        Node2 a = new Node2();
        Console.WriteLine(a.tag);
        Console.WriteLine(a.id);
        Node2 b = new Node2(7);
        Console.WriteLine(b.tag);
        Console.WriteLine(b.id);
        Derived d = new Derived();
        Console.WriteLine(d.bt);
        Console.WriteLine(d.dt);
    }
}
