using System;

namespace System.Security.Cryptography;

/// <summary>AES（FIPS-197）分组密码，CBC/ECB/CTR 模式，128/192/256 位
/// 密钥。实现走 OpenSSL libcrypto 的 EVP 接口（AES-NI 硬件指令，
/// GB/s 级吞吐；OpenSSL 3 的 EVP_aes_* 家族仍是公开导出）。
///
/// 驱动：System/Net/Tls/drivers 捆绑的 libcrypto（driver.manifest
/// 声明 "crypto"，zanc --publish 自动携带）。静态发布未捆绑
/// libcrypto 时导入被 zanc 桩化（调用返回 0），本类各方法按参数
/// 不合法的同款契约返回 null。纯 Zan 参考实现见
/// examples/crypto_reference/。</summary>
class Aes {
    /* ---- libcrypto EVP 绑定 ----
       句柄用 string 承载（TlsContext 惯用法）。密钥/IV/数据参数按
       本类既有契约是"字节缓冲区当 string 传"——调用方常传 byte[]，
       其 .Length 是字节里的 strlen（可能因 0x00 截断），因此本类
       **绝不读参数的 .Length**，只按下标访问与 len 实参。C 的 int*
       出参用 nint 4 字节 cell + Span<int> 回读（Zan 的 List<int>
       不作 DllImport 出参封送）。 */
    [DllImport("crypto")]
    static extern string EVP_CIPHER_CTX_new();
    [DllImport("crypto")]
    static extern void EVP_CIPHER_CTX_free(string ctx);
    [DllImport("crypto")]
    static extern int EVP_EncryptInit_ex(string ctx, string cipher, string impl, string key, string iv);
    [DllImport("crypto")]
    static extern int EVP_EncryptUpdate(string ctx, byte[] outb, nint outl, byte[] inb, int inl);
    /* string 形态的输入绑定：byte[] 与 string 共享载荷 ABI，直接把
       调用方的数据缓冲喂给 EVP，省掉一次逐字节 Zan 拷贝（1 MiB 约
       8ms，是吞吐上限的主导项）。 */
    [DllImport("crypto", EntryPoint = "EVP_EncryptUpdate")]
    static extern int EVP_EncryptUpdateS(string ctx, byte[] outb, nint outl, string inb, int inl);
    [DllImport("crypto")]
    static extern int EVP_EncryptFinal_ex(string ctx, byte[] outb, nint outl);
    [DllImport("crypto")]
    static extern int EVP_DecryptInit_ex(string ctx, string cipher, string impl, string key, string iv);
    [DllImport("crypto")]
    static extern int EVP_DecryptUpdate(string ctx, byte[] outb, nint outl, byte[] inb, int inl);
    [DllImport("crypto", EntryPoint = "EVP_DecryptUpdate")]
    static extern int EVP_DecryptUpdateS(string ctx, byte[] outb, nint outl, string inb, int inl);
    [DllImport("crypto")]
    static extern int EVP_DecryptFinal_ex(string ctx, byte[] outb, nint outl);
    [DllImport("crypto")]
    static extern int EVP_CIPHER_CTX_set_padding(string ctx, int pad);
    [DllImport("crypto")]
    static extern string EVP_aes_128_cbc();
    [DllImport("crypto")]
    static extern string EVP_aes_192_cbc();
    [DllImport("crypto")]
    static extern string EVP_aes_256_cbc();
    [DllImport("crypto")]
    static extern string EVP_aes_128_ecb();
    [DllImport("crypto")]
    static extern string EVP_aes_192_ecb();
    [DllImport("crypto")]
    static extern string EVP_aes_256_ecb();
    [DllImport("crypto")]
    static extern string EVP_aes_128_ctr();
    [DllImport("crypto")]
    static extern string EVP_aes_192_ctr();
    [DllImport("crypto")]
    static extern string EVP_aes_256_ctr();
    /* 收缩拷贝（解密剥填充后明文短于密文）用 native memcpy：逐字节
       Zan 循环只有 ~130 MiB/s，会把大缓冲吞吐拖到同一水平。 */
    [DllImport("crt", EntryPoint = "memcpy")]
    static extern void BufCopy(byte[] dst, byte[] src, int n);

    /// cipher 构造子按 keyLen 分发；不合法的 keyLen 返回 null。
    static string CbcCipher(int keyLen) {
        if (keyLen == 16) { return EVP_aes_128_cbc(); }
        if (keyLen == 24) { return EVP_aes_192_cbc(); }
        if (keyLen == 32) { return EVP_aes_256_cbc(); }
        return null;
    }

    static string EcbCipher(int keyLen) {
        if (keyLen == 16) { return EVP_aes_128_ecb(); }
        if (keyLen == 24) { return EVP_aes_192_ecb(); }
        if (keyLen == 32) { return EVP_aes_256_ecb(); }
        return null;
    }

    static string CtrCipher(int keyLen) {
        if (keyLen == 16) { return EVP_aes_128_ctr(); }
        if (keyLen == 24) { return EVP_aes_192_ctr(); }
        if (keyLen == 32) { return EVP_aes_256_ctr(); }
        return null;
    }

    /// 读 nint cell 里的 4 字节 int 出参。
    static int CellRead(nint cell) {
        return new Span<int>(cell, 1)[0];
    }

    /// <summary>AES-ECB 单块加密（16 字节 → 16 字节）。微信消息
    /// 加解密用。keyLen 必须 16/24/32，否则返回 null；EVP 不可用
    /// （静态发布未捆绑 libcrypto）同样返回 null。</summary>
    static byte[] EncryptBlockEcb(string key, int keyLen, string in16) {
        if ((keyLen != 16 && keyLen != 24 && keyLen != 32) || in16 == null) {
            return null;
        }
        string cipher = Aes.EcbCipher(keyLen);
        if (cipher == null) { return null; }
        string ctx = EVP_CIPHER_CTX_new();
        if (ctx == null) { return null; }
        byte[] inb = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { inb[i] = in16[i] & 255; }
        byte[] outb = new byte[16];
        nint cell = NativeMemory.Alloc(4);
        int ok = EVP_EncryptInit_ex(ctx, cipher, null, key, null);
        if (ok == 1) { ok = EVP_CIPHER_CTX_set_padding(ctx, 0); }
        if (ok == 1) { ok = EVP_EncryptUpdate(ctx, outb, cell, inb, 16); }
        NativeMemory.Free(cell);
        EVP_CIPHER_CTX_free(ctx);
        if (ok != 1) { return null; }
        return outb;
    }

    /// <summary>AES-ECB 单块解密（EncryptBlockEcb 的逆）。
    /// 参数不合法或 EVP 不可用时返回 null。</summary>
    static byte[] DecryptBlockEcb(string key, int keyLen, string in16) {
        if ((keyLen != 16 && keyLen != 24 && keyLen != 32) || in16 == null) {
            return null;
        }
        string cipher = Aes.EcbCipher(keyLen);
        if (cipher == null) { return null; }
        string ctx = EVP_CIPHER_CTX_new();
        if (ctx == null) { return null; }
        byte[] inb = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { inb[i] = in16[i] & 255; }
        byte[] outb = new byte[16];
        nint cell = NativeMemory.Alloc(4);
        int ok = EVP_DecryptInit_ex(ctx, cipher, null, key, null);
        if (ok == 1) { ok = EVP_CIPHER_CTX_set_padding(ctx, 0); }
        if (ok == 1) { ok = EVP_DecryptUpdate(ctx, outb, cell, inb, 16); }
        NativeMemory.Free(cell);
        EVP_CIPHER_CTX_free(ctx);
        if (ok != 1) { return null; }
        return outb;
    }

    /// <summary>AES-CBC 加密，PKCS#7 填充。返回恰好 outLen[0] 字节的
    /// 密文；<paramref name="outLen"/>[0] 接收其长度。keyLen 必须
    /// 是 16/24/32（否则返回 null）。</summary>
    static byte[] EncryptCbc(string key, int keyLen, string iv, string data, int len, List<int> outLen) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { outLen[0] = -1; return null; }
        if (len < 0) { outLen[0] = -1; return null; }
        string cipher = Aes.CbcCipher(keyLen);
        if (cipher == null) { outLen[0] = -1; return null; }
        string ctx = EVP_CIPHER_CTX_new();
        if (ctx == null) { outLen[0] = -1; return null; }
        /* PKCS#7：EVP 默认垫齐到整块（len 已整块时也补一个整填充块），
           密文长度加密前即确定：(len/16+1)*16。输出缓冲按精确长度
           分配，EVP 直接写入、原样返回——热路径没有逐字节拷贝。 */
        byte[] outb = new byte[(len / 16 + 1) * 16];
        nint cell = NativeMemory.Alloc(4);
        int ok = EVP_EncryptInit_ex(ctx, cipher, null, key, iv);
        int total = -1;
        if (ok == 1) {
            ok = EVP_EncryptUpdateS(ctx, outb, cell, data, len);
            total = Aes.CellRead(cell);
        }
        if (ok == 1) {
            byte[] fin = new byte[32];
            ok = EVP_EncryptFinal_ex(ctx, fin, cell);
            int tail = Aes.CellRead(cell);
            for (int i = 0; i < tail; i = i + 1) { outb[total + i] = fin[i] & 255; }
            total = total + tail;
        }
        NativeMemory.Free(cell);
        EVP_CIPHER_CTX_free(ctx);
        if (ok != 1 || total != outb.Length) { outLen[0] = -1; return null; }
        outLen[0] = total;
        return outb;
    }

    /// <summary>AES-CBC 解密，去除 PKCS#7 填充。返回明文；
    /// <paramref name="outLen"/>[0] 接收其长度（密文长度非 16 整数倍、
    /// 或 PKCS#7 填充不一致时为 -1，并返回 null）。填充校验由 EVP
    /// 完成（DecryptFinal 非 1 即失败），与旧实现一样不产出填充
    /// 不合法的明文。</summary>
    static byte[] DecryptCbc(string key, int keyLen, string iv, string data, int len, List<int> outLen) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { outLen[0] = -1; return null; }
        // CBC 密文必须是 16 字节的整数倍；空输入也不合法（至少要有一个
        // 完整的填充块）。
        if (len <= 0 || (len % 16) != 0) { outLen[0] = -1; return null; }
        string cipher = Aes.CbcCipher(keyLen);
        if (cipher == null) { outLen[0] = -1; return null; }
        string ctx = EVP_CIPHER_CTX_new();
        if (ctx == null) { outLen[0] = -1; return null; }
        byte[] outb = new byte[len];
        nint cell = NativeMemory.Alloc(4);
        int ok = EVP_DecryptInit_ex(ctx, cipher, null, key, iv);
        int total = -1;
        if (ok == 1) {
            /* 带填充的解密会扣住最后一块直到 Final 校验填充 */
            ok = EVP_DecryptUpdateS(ctx, outb, cell, data, len);
            total = Aes.CellRead(cell);
        }
        if (ok == 1) {
            byte[] fin = new byte[32];
            ok = EVP_DecryptFinal_ex(ctx, fin, cell);
            int tail = Aes.CellRead(cell);
            for (int i = 0; i < tail; i = i + 1) { outb[total + i] = fin[i] & 255; }
            total = total + tail;
        }
        NativeMemory.Free(cell);
        EVP_CIPHER_CTX_free(ctx);
        if (ok != 1) { outLen[0] = -1; return null; }
        outLen[0] = total;
        if (total == outb.Length) { return outb; }
        /* 填充剥离后明文短于密文：收缩拷贝走 native memcpy */
        byte[] exact = new byte[total];
        Aes.BufCopy(exact, outb, total);
        return exact;
    }

    /// <summary>AES-CTR（加密==解密）。<paramref name="iv"/> 是 16 字节
    /// 的初始计数器块。返回恰好 <paramref name="len"/> 字节
    /// 的缓冲区；密钥长度或长度参数不合法时返回 null。</summary>
    static byte[] Ctr(string key, int keyLen, string iv, string data, int len) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { return null; }
        if (len < 0) { return null; }
        string cipher = Aes.CtrCipher(keyLen);
        if (cipher == null) { return null; }
        string ctx = EVP_CIPHER_CTX_new();
        if (ctx == null) { return null; }
        byte[] outb = new byte[len];
        nint cell = NativeMemory.Alloc(4);
        int ok = EVP_EncryptInit_ex(ctx, cipher, null, key, iv);
        int total = -1;
        if (ok == 1) {
            ok = EVP_EncryptUpdateS(ctx, outb, cell, data, len);
            total = Aes.CellRead(cell);
        }
        NativeMemory.Free(cell);
        EVP_CIPHER_CTX_free(ctx);
        if (ok != 1 || total != len) { return null; }
        return outb;
    }
}
