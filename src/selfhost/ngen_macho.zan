using System;
using System.Collections;
namespace Zan;

// Mach-O 64-bit object file writer for Ngen (arm64). Layout:
//
//   header (32) + LC_SEGMENT_64 (104, 2 sections) + LC_SYMTAB (24)
//   __text          at 160
//   __cstring       after text
//   text relocations after cstring (8 bytes each, sorted by r_address)
//   symbol table (16 bytes per nlist_64), then string table
//
// Relocations emitted:
//   BL extern   -> ARM64_RELOC_BRANCH26 (pcrel, extern)
//   adrp str    -> ARM64_RELOC_PAGE21    (pcrel, section-ordinal 2 = __cstring)
//   add  str    -> ARM64_RELOC_PAGEOFF12 (absolute, section-ordinal 2)
partial class Ngen {
    int TextFileOff = 288; // 32 header + 232 LC_SEGMENT_64 + 24 LC_SYMTAB

    // patch adrp/add pairs now that the cstring offset is known
    void PatchStrRefs(int cstrOff) {
        int i = 0;
        while (i < strRefs.Count) {
            StrRef r = strRefs[i];
            int strPos = StrOffset(r.strIdx);
            int pc = TextFileOff + r.adrpPos;
            int target = TextFileOff + cstrOff + strPos;
            int delta = (target - (target / 4096) * 4096) - (pc - (pc / 4096) * 4096);
            // ADRP: immimm = delta / 4096, split immlo (bits 30..29) + immhi (23..5)
            int imm = delta / 4096;
            int immlo = imm - (imm / 4) * 4;
            int immhi = (imm - immlo) / 4;
            int rd = ByteAt(WordAt(r.adrpPos), 0) - (ByteAt(WordAt(r.adrpPos), 0) / 32) * 32;
            SetWordAt(r.adrpPos, 0x90000000 | (immlo << 29) | (immhi << 5) | rd);
            // ADD: imm12 must be 0 in the object file; the linker fills the
            // lo12 offset via the PAGEOFF12 relocation (embedded addends in
            // ADD/LDR/STR are rejected by ld64).
            int old = WordAt(r.addPos);
            int rnrd = old - (old / 4096) * 4096; // Rn,Rd bits 9..0 kept
            SetWordAt(r.addPos, 0x91000000 | rnrd);
            i = i + 1;
        }
    }

    int StrOffset(int si) {
        int off = 0;
        int i = 0;
        while (i < si) {
            off = off + strs[i].Length + 1;
            i = i + 1;
        }
        return off;
    }

    // undefined extern names in first-reference order
    List<string> ExternSyms() {
        List<string> es = new List<string>();
        int i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            if (f.kind == 4) {
                int at = IndexOf(es, f.sym);
                if (at < 0) { es.Add(f.sym); }
            }
            i = i + 1;
        }
        return es;
    }

    int IndexOf(List<string> xs, string s) {
        int i = 0;
        while (i < xs.Count) { if (xs[i] == s) { return i; } i = i + 1; }
        return -1;
    }

    // build the whole object image; returns bytes
    List<int> BuildMachO() {
        int textLen = txt.Count;
        int cstrOff = TextFileOff + textLen;
        int cstrLen = 0;
        int i = 0;
        while (i < strs.Count) { cstrLen = cstrLen + strs[i].Length + 1; i = i + 1; }
        if (cstrLen == 0) { cstrLen = 1; } // keep the section non-empty
        // relocations for the text section, collected in address order
        List<int> rAddr = new List<int>();
        List<int> rWord = new List<int>();
        // extern BLs first (they are spread through the text); then string
        // refs; then sort by insertion (counts are tiny for the kernel slice)
        List<string> exts = ExternSyms();
        i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            if (f.kind == 4) {
                int symnum = syms.Count + 1 + IndexOf(exts, f.sym); // +1 for the __cstring section symbol
                // word: symbolnum:24 | pcrel:1 | length:2 | extern:1 | type:4
                int rw = symnum + (1 << 24) + (2 << 25) + (1 << 27) + (2 << 28);
                InsertReloc(rAddr, rWord, f.pos, rw);
            }
            i = i + 1;
        }
        i = 0;
        while (i < strRefs.Count) {
            StrRef r = strRefs[i];
            InsertReloc(rAddr, rWord, r.adrpPos, syms.Count + (1 << 24) + (2 << 25) + (1 << 27) + (3 << 28));
            InsertReloc(rAddr, rWord, r.addPos, syms.Count + (2 << 25) + (1 << 27) + (4 << 28)); // PAGEOFF12: pcrel=0
            i = i + 1;
        }
        int relocOff = cstrOff + cstrLen;
        int nrel = rAddr.Count;
        int symOff = relocOff + nrel * 8;
        int nsyms = syms.Count + 1 + exts.Count; // +1 = __cstring section symbol
        int strOff = symOff + nsyms * 16;

        List<int> img = new List<int>();
        // ---- header ----
        Put32(img, 0xFEEDFACF);          // MH_MAGIC_64
        Put32(img, 0x0100000C);          // CPU_TYPE_ARM64
        Put32(img, 0);                   // cpusubtype
        Put32(img, 1);                   // MH_OBJECT
        Put32(img, 2);                   // ncmds
        Put32(img, 232 + 24);            // sizeofcmds (72 + 2*80 sections + symtab)
        Put32(img, 0);                   // flags
        Put32(img, 0);                   // reserved
        // ---- LC_SEGMENT_64 ----
        Put32(img, 0x19);
        Put32(img, 232);
        PutName(img, "", 16);            // segname
        Put64(img, 0);                   // vmaddr
        Put64(img, 0);                   // vmsize
        Put64(img, 0);                   // fileoff
        Put64(img, strOff + strTotal(exts)); // filesize
        Put32(img, 7);                   // maxprot
        Put32(img, 7);                   // initprot
        Put32(img, 2);                   // nsects
        Put32(img, 0);                   // flags
        // section __TEXT,__text
        PutName(img, "__text", 16);
        PutName(img, "__TEXT", 16);
        Put64(img, TextFileOff);         // addr
        Put64(img, textLen);             // size
        Put32(img, TextFileOff);         // offset
        Put32(img, 4);                   // align = 2^4
        Put32(img, relocOff);            // reloff
        Put32(img, nrel);                // nreloc
        Put32(img, 0);                   // flags
        Put32(img, 0);                   // reserved1
        Put32(img, 0);                   // reserved2
        Put32(img, 0);                   // reserved3
        // section __TEXT,__cstring
        PutName(img, "__cstring", 16);
        PutName(img, "__TEXT", 16);
        Put64(img, cstrOff);
        Put64(img, cstrLen);
        Put32(img, cstrOff);
        Put32(img, 0);                   // align = 2^0
        Put32(img, 0);                   // reloff
        Put32(img, 0);                   // nreloc
        Put32(img, 2);                   // S_CSTRING_LITERALS
        Put32(img, 0);                   // reserved1
        Put32(img, 0);                   // reserved2
        Put32(img, 0);                   // reserved3
        // ---- LC_SYMTAB ----
        Put32(img, 0x2);
        Put32(img, 24);
        Put32(img, symOff);
        Put32(img, nsyms);
        Put32(img, strOff);
        Put32(img, strTotal(exts));
        // ---- payload ----
        Append(img, txt, 0, textLen);
        i = 0;
        while (i < strs.Count) {
            PutName(img, strs[i], strs[i].Length + 1);
            i = i + 1;
        }
        if (strs.Count == 0) { Put8(img, 0); }
        i = 0;
        while (i < nrel) {
            Put32(img, rAddr[i]);
            Put32(img, rWord[i]);
            i = i + 1;
        }
        // symbol table: defined externs first, then undefined externs
        i = 0;
        int stro = 1; // strtab[0] is the NUL byte
        while (i < syms.Count) {
            Put32(img, stro);
            Put8(img, 0x0F);             // N_SECT | N_EXT
            Put8(img, 1);                // n_sect = __text
            Put16(img, 0);               // n_desc
            Put64(img, TextFileOff + syms[i].pos);
            stro = stro + syms[i].name.Length + 1;
            i = i + 1;
        }
        // local section symbol for __cstring (string ADRP/ADD relocs target it)
        Put32(img, stro);
        Put8(img, 0x0E);                 // N_SECT (local)
        Put8(img, 2);                    // n_sect = __cstring
        Put16(img, 0);
        Put64(img, cstrOff);
        stro = stro + 11;                // "___cstring" + NUL
        i = 0;
        while (i < exts.Count) {
            Put32(img, stro);
            Put8(img, 0x01);             // N_UNDF | N_EXT
            Put8(img, 0);
            Put16(img, 0);
            Put64(img, 0);
            stro = stro + exts[i].Length + 1;
            i = i + 1;
        }
        // string table
        Put8(img, 0);
        i = 0;
        while (i < syms.Count) { PutName(img, syms[i].name, syms[i].name.Length + 1); i = i + 1; }
        PutName(img, "___cstring", 11);
        i = 0;
        while (i < exts.Count) { PutName(img, exts[i], exts[i].Length + 1); i = i + 1; }
        return img;
    }

    int strTotal(List<string> exts) {
        int n = 1;
        int i = 0;
        while (i < syms.Count) { n = n + syms[i].name.Length + 1; i = i + 1; }
        n = n + 11;                      // "___cstring" + NUL
        i = 0;
        while (i < exts.Count) { n = n + exts[i].Length + 1; i = i + 1; }
        return n;
    }

    void InsertReloc(List<int> addrs, List<int> words, int addr, int w) {
        int at = addrs.Count;
        int i = 0;
        while (i < addrs.Count) {
            if (addrs[i] > addr) { at = i; break; }
            i = i + 1;
        }
        addrs.Insert(at, addr);
        words.Insert(at, w);
    }

    void Put32(List<int> img, int v) {
        img.Add(ByteAt(v, 0)); img.Add(ByteAt(v, 1));
        img.Add(ByteAt(v, 2)); img.Add(ByteAt(v, 3));
    }
    void Put64(List<int> img, long v) {
        int n = 0;
        while (n < 8) {
            long b = v >> (n * 8);
            b = b - (b / 256) * 256;
            if (b < 0) { b = b + 256; }
            img.Add((int)b);
            n = n + 1;
        }
    }
    void Put16(List<int> img, int v) {
        img.Add(ByteAt(v, 0)); img.Add(ByteAt(v, 1));
    }
    void Put8(List<int> img, int v) { img.Add(v); }
    void PutName(List<int> img, string s, int n) {
        int i = 0;
        while (i < s.Length) { img.Add(ByteAt(s[i], 0)); i = i + 1; }
        while (i < n) { img.Add(0); i = i + 1; }
    }
    void Append(List<int> img, List<int> src, int at, int n) {
        int i = 0;
        while (i < n) { img.Add(src[at + i]); i = i + 1; }
    }
}
