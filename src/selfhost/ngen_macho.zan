using System;
using System.Collections;
namespace Zan;

// Mach-O 64-bit object file writer for Ngen (arm64). Layout:
//
//   header (32) + LC_SEGMENT_64 (312, 3 sections) + LC_SYMTAB (24)
//   __TEXT,__text    at 368
//   __TEXT,__cstring after text
//   __DATA,__data    after cstring, 8-aligned (module globals)
//   text relocations (8 bytes each, sorted by r_address)
//   symbol table (16 bytes per nlist_64), then string table
//
// Symbols: one defined symbol per method/runtime function (n_sect 1), one
// local symbol per string literal "l_.str.N" (n_sect 2) and per data global
// "l_.g.NAME" (n_sect 3), then the undefined externs. ADRP/ADD references
// stay imm=0 in the object; the linker fills them via the relocations
// (embedded addends in ADD are rejected by ld64).
//
// Relocations emitted:
//   BL extern   -> ARM64_RELOC_BRANCH26 (pcrel, extern)
//   adrp ref    -> ARM64_RELOC_PAGE21    (pcrel, extern, target symbol)
//   add  ref    -> ARM64_RELOC_PAGEOFF12 (absolute, extern, target symbol)
partial class Ngen {
    int TextFileOff = 368; // 32 header + 312 LC_SEGMENT_64 (3 sections) + 24 LC_SYMTAB

    string StrSym(int i) { return "l_.str." + i; }
    string DGlobalSym(string n) { return "l_.g." + n; }

    int StrOffset(int si) {
        int off = 0;
        int i = 0;
        while (i < si) {
            off = off + strs[i].Length + 1;
            i = i + 1;
        }
        return off;
    }

    // undefined extern names in first-reference order
    List<string> ExternSyms() {
        List<string> es = new List<string>();
        int i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            if (f.kind == 4) {
                int at = IndexOf(es, f.sym);
                if (at < 0) { es.Add(f.sym); }
            }
            i = i + 1;
        }
        // GOT-indirect references (dylib data symbols) are undefined too
        i = 0;
        while (i < strRefs.Count) {
            StrRef r = strRefs[i];
            if (r.got != 0 && DefinedSym(r.sym) == 0) {
                int at = IndexOf(es, r.sym);
                if (at < 0) { es.Add(r.sym); }
            }
            i = i + 1;
        }
        return es;
    }

    // 1 when the symbol is defined in this object (method, string, global)
    int DefinedSym(string name) {
        int i = 0;
        while (i < syms.Count) { if (syms[i].name == name) { return 1; } i = i + 1; }
        i = 0;
        while (i < strs.Count) { if (StrSym(i) == name) { return 1; } i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { if (DGlobalSym(dglbs[i].name) == name) { return 1; } i = i + 1; }
        return 0;
    }

    int IndexOf(List<string> xs, string s) {
        int i = 0;
        while (i < xs.Count) { if (xs[i] == s) { return i; } i = i + 1; }
        return -1;
    }

    // symbol-table index of a referenced symbol: defined syms first, then
    // string literals, then data globals, then undefined externs
    int RefSymNum(string name, List<string> exts, int extBase) {
        int i = 0;
        while (i < syms.Count) { if (syms[i].name == name) { return i; } i = i + 1; }
        i = 0;
        while (i < strs.Count) { if (StrSym(i) == name) { return syms.Count + i; } i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { if (DGlobalSym(dglbs[i].name) == name) { return syms.Count + strs.Count + i; } i = i + 1; }
        return extBase + IndexOf(exts, name);
    }

    // build the whole object image; returns bytes
    List<int> BuildMachO() {
        int textLen = txt.Count;
        int cstrOff = TextFileOff + textLen;
        int cstrLen = 0;
        int i = 0;
        while (i < strs.Count) { cstrLen = cstrLen + strs[i].Length + 1; i = i + 1; }
        if (cstrLen == 0) { cstrLen = 1; } // keep the section non-empty
        int dataOff = cstrOff + cstrLen;
        int pad = dataOff - (dataOff / 8) * 8;
        if (pad != 0) { pad = 8 - pad; dataOff = dataOff + pad; }

        // relocation symbol numbers: defined methods, then string literals,
        // then data globals, then undefined externs
        List<string> exts = ExternSyms();
        int extBase = syms.Count + strs.Count + dglbs.Count;

        List<int> rAddr = new List<int>();
        List<int> rWord = new List<int>();
        i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            if (f.kind == 4) {
                int symnum = extBase + IndexOf(exts, f.sym);
                // word: symbolnum:24 | pcrel:1 | length:2 | extern:1 | type:4
                int rw = symnum + (1 << 24) + (2 << 25) + (1 << 27) + (2 << 28);
                InsertReloc(rAddr, rWord, f.pos, rw);
            }
            i = i + 1;
        }
        i = 0;
        while (i < strRefs.Count) {
            StrRef r = strRefs[i];
            int symnum = RefSymNum(r.sym, exts, extBase);
            if (r.got != 0) {
                // GOT-indirect pair: adrp @GOTPAGE (type 5) then
                // ldr @GOTPAGEOFF (type 6), both pcrel
                InsertReloc(rAddr, rWord, r.adrpPos, symnum + (1 << 24) + (2 << 25) + (1 << 27) + (5 << 28));
                InsertReloc(rAddr, rWord, r.addPos, symnum + (2 << 25) + (1 << 27) + (6 << 28));
            } else {
                InsertReloc(rAddr, rWord, r.adrpPos, symnum + (1 << 24) + (2 << 25) + (1 << 27) + (3 << 28));
                InsertReloc(rAddr, rWord, r.addPos, symnum + (2 << 25) + (1 << 27) + (4 << 28)); // PAGEOFF12: pcrel=0
            }
            i = i + 1;
        }
        int relocOff = dataOff + dataLen;
        int nrel = rAddr.Count;
        int nsyms = extBase + exts.Count;
        int symOff = relocOff + nrel * 8;
        int strOff = symOff + nsyms * 16;
        int fileEnd = strOff + strTotal(exts);

        List<int> img = new List<int>();
        // ---- header ----
        Put32(img, 0xFEEDFACF);          // MH_MAGIC_64
        Put32(img, 0x0100000C);          // CPU_TYPE_ARM64
        Put32(img, 0);                   // cpusubtype
        Put32(img, 1);                   // MH_OBJECT
        Put32(img, 2);                   // ncmds
        Put32(img, 312 + 24);            // sizeofcmds (72 + 3*80 sections + symtab)
        Put32(img, 0);                   // flags
        Put32(img, 0);                   // reserved
        // ---- LC_SEGMENT_64 ----
        Put32(img, 0x19);
        Put32(img, 312);
        PutName(img, "", 16);            // segname
        Put64(img, 0);                   // vmaddr
        Put64(img, 0);                   // vmsize
        Put64(img, 0);                   // fileoff
        Put64(img, fileEnd);             // filesize
        Put32(img, 7);                   // maxprot
        Put32(img, 7);                   // initprot
        Put32(img, 3);                   // nsects
        Put32(img, 0);                   // flags
        // section __TEXT,__text
        PutName(img, "__text", 16);
        PutName(img, "__TEXT", 16);
        Put64(img, TextFileOff);         // addr
        Put64(img, textLen);             // size
        Put32(img, TextFileOff);         // offset
        Put32(img, 4);                   // align = 2^4
        Put32(img, relocOff);            // reloff
        Put32(img, nrel);                // nreloc
        Put32(img, 0);                   // flags
        Put32(img, 0);                   // reserved1
        Put32(img, 0);                   // reserved2
        Put32(img, 0);                   // reserved3
        // section __TEXT,__cstring
        PutName(img, "__cstring", 16);
        PutName(img, "__TEXT", 16);
        Put64(img, cstrOff);
        Put64(img, cstrLen);
        Put32(img, cstrOff);
        Put32(img, 0);                   // align = 2^0
        Put32(img, 0);                   // reloff
        Put32(img, 0);                   // nreloc
        Put32(img, 2);                   // S_CSTRING_LITERALS
        Put32(img, 0);                   // reserved1
        Put32(img, 0);                   // reserved2
        Put32(img, 0);                   // reserved3
        // section __DATA,__data
        PutName(img, "__data", 16);
        PutName(img, "__DATA", 16);
        Put64(img, dataOff);
        Put64(img, dataLen);
        Put32(img, dataOff);
        Put32(img, 3);                   // align = 2^3
        Put32(img, 0);                   // reloff
        Put32(img, 0);                   // nreloc
        Put32(img, 0);                   // flags
        Put32(img, 0);                   // reserved1
        Put32(img, 0);                   // reserved2
        Put32(img, 0);                   // reserved3
        // ---- LC_SYMTAB ----
        Put32(img, 0x2);
        Put32(img, 24);
        Put32(img, symOff);
        Put32(img, nsyms);
        Put32(img, strOff);
        Put32(img, strTotal(exts));
        // ---- payload ----
        Append(img, txt, 0, textLen);
        i = 0;
        while (i < strs.Count) {
            PutName(img, strs[i], strs[i].Length + 1);
            i = i + 1;
        }
        if (strs.Count == 0) { Put8(img, 0); }
        i = 0;
        while (i < pad) { Put8(img, 0); i = i + 1; }
        i = 0;
        while (i < dataLen) { Put8(img, 0); i = i + 1; }
        i = 0;
        while (i < nrel) {
            Put32(img, rAddr[i]);
            Put32(img, rWord[i]);
            i = i + 1;
        }
        // ---- symbol table ----
        int stro = 1; // strtab[0] is the NUL byte
        // defined method/runtime symbols (n_sect = __text)
        i = 0;
        while (i < syms.Count) {
            Put32(img, stro);
            Put8(img, 0x0F);             // N_SECT | N_EXT
            Put8(img, 1);
            Put16(img, 0);               // n_desc
            Put64(img, TextFileOff + syms[i].pos);
            stro = stro + syms[i].name.Length + 1;
            i = i + 1;
        }
        // string literal symbols (n_sect = __cstring, local)
        i = 0;
        while (i < strs.Count) {
            Put32(img, stro);
            Put8(img, 0x0E);             // N_SECT (local)
            Put8(img, 2);
            Put16(img, 0);
            Put64(img, cstrOff + StrOffset(i));
            stro = stro + StrSym(i).Length + 1;
            i = i + 1;
        }
        // data global symbols (n_sect = __data, local)
        i = 0;
        while (i < dglbs.Count) {
            Put32(img, stro);
            Put8(img, 0x0E);             // N_SECT (local)
            Put8(img, 3);
            Put16(img, 0);
            Put64(img, dataOff + dglbs[i].off);
            stro = stro + DGlobalSym(dglbs[i].name).Length + 1;
            i = i + 1;
        }
        // undefined externs
        i = 0;
        while (i < exts.Count) {
            Put32(img, stro);
            Put8(img, 0x01);             // N_UNDF | N_EXT
            Put8(img, 0);
            Put16(img, 0);
            Put64(img, 0);
            stro = stro + exts[i].Length + 1;
            i = i + 1;
        }
        // ---- string table ----
        Put8(img, 0);
        i = 0;
        while (i < syms.Count) { PutName(img, syms[i].name, syms[i].name.Length + 1); i = i + 1; }
        i = 0;
        while (i < strs.Count) { PutName(img, StrSym(i), StrSym(i).Length + 1); i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { PutName(img, DGlobalSym(dglbs[i].name), DGlobalSym(dglbs[i].name).Length + 1); i = i + 1; }
        i = 0;
        while (i < exts.Count) { PutName(img, exts[i], exts[i].Length + 1); i = i + 1; }
        return img;
    }

    int strTotal(List<string> exts) {
        int n = 1;
        int i = 0;
        while (i < syms.Count) { n = n + syms[i].name.Length + 1; i = i + 1; }
        i = 0;
        while (i < strs.Count) { n = n + StrSym(i).Length + 1; i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { n = n + DGlobalSym(dglbs[i].name).Length + 1; i = i + 1; }
        i = 0;
        while (i < exts.Count) { n = n + exts[i].Length + 1; i = i + 1; }
        return n;
    }

    void InsertReloc(List<int> addrs, List<int> words, int addr, int w) {
        int at = addrs.Count;
        int i = 0;
        while (i < addrs.Count) {
            if (addrs[i] > addr) { at = i; break; }
            i = i + 1;
        }
        addrs.Insert(at, addr);
        words.Insert(at, w);
    }

    void Put32(List<int> img, int v) {
        img.Add(ByteAt(v, 0)); img.Add(ByteAt(v, 1));
        img.Add(ByteAt(v, 2)); img.Add(ByteAt(v, 3));
    }
    void Put64(List<int> img, long v) {
        int n = 0;
        while (n < 8) {
            long b = v >> (n * 8);
            b = b - (b / 256) * 256;
            if (b < 0) { b = b + 256; }
            img.Add((int)b);
            n = n + 1;
        }
    }
    void Put16(List<int> img, int v) {
        img.Add(ByteAt(v, 0)); img.Add(ByteAt(v, 1));
    }
    void Put8(List<int> img, int v) { img.Add(v); }
    void PutName(List<int> img, string s, int n) {
        int i = 0;
        while (i < s.Length) { img.Add(ByteAt(s[i], 0)); i = i + 1; }
        while (i < n) { img.Add(0); i = i + 1; }
    }
    void Append(List<int> img, List<int> src, int at, int n) {
        int i = 0;
        while (i < n) { img.Add(src[at + i]); i = i + 1; }
    }
}
