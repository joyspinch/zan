using System;
using System.Collections;
namespace Zan;

// Ngen: native backend slice (M1). Emits arm64 machine code directly from the
// bound AST — no LLVM IR text, no clang. The object container (Mach-O) lives
// in ngen_macho.zan.
//
// Instruction words are stored as 32-bit two's-complement ints: Zan hex
// literals above 0x7FFFFFFF wrap, but the bit pattern survives the wrap and
// byte extraction takes the low 32 bits.
//
// Kernel subset: static methods, int params/locals/returns, int literals,
// `+ - * <`, if/while, plain calls (recursion ok), Console.WriteLine(int).
// Anything else is a compile error, not a silent fallback.
class Fixup {
    public int pos;    // text offset of the patched instruction
    public int kind;   // 0=B 1=CBZ 2=Bcond 3=BL-internal 4=BL-extern
    public int lbl;    // label id (kinds 0-2)
    public int cond;   // cond code (kind 2)
    public string sym; // target symbol (kinds 3-4)
    public Fixup(int p, int k, int l, int c, string s) {
        pos = p; kind = k; lbl = l; cond = c; sym = s;
    }
}

class StrRef {
    public int adrpPos;  // text offset of the adrp instruction
    public int addPos;   // text offset of the add/ldr instruction
    public string sym;   // target symbol name (l_.str.N / l_.g.NAME / __stdinp)
    public int got;      // 1: adrp + ldr through the GOT (dylib data symbols)
    public StrRef(int a, int b, string s) { adrpPos = a; addPos = b; sym = s; got = 0; }
}

class Sym {
    public string name;  // link-time symbol name (underscore prefixed)
    public int pos;      // text offset of the definition
    public Sym(string n, int p) { name = n; pos = p; }
}

partial class Ngen {
    Diags diags;

    List<int> txt;          // __text bytes
    List<Sym> syms;         // defined symbols (one per method)
    List<Fixup> fixups;     // branch/call fixups
    List<StrRef> strRefs;   // string address references (adrp+add pairs)
    List<string> strs;      // __cstring entries
    List<int> lblPos;       // label id -> text pos (-1 while open)
    List<int> brkL;         // innermost-enclosing-loop break targets
    List<int> cntL;         // innermost-enclosing-loop continue targets

    string curCls;
    List<string> locName;   // locals of the method being emitted
    List<string> locTy;     // declared type name per local ("" for this/params of unknown)
    List<int> locOff;       // frame offset (bytes from sp)
    int nloc;
    int frame;
    int nlabel;
    int curLine;
    int curCol;
    int guardDivIdx;
    int guardModIdx;
    int guardFileIdx;
    int guardStrIdx;
    int guardSubIdx;
    int guardListIdx;
    int guardArrIdx;
    int guardArrNeg;
    int guardArrOvf;
    int guardArrFail;
    int guardArrNull;
    string srcFile;

    List<Node> methNodes;
    List<string> methCls;
    List<int> methStat;     // 0 = instance, 1 = static, 2 = ctor
    string mainCls;

    List<string> enName;    // enum type name per declaration
    List<int> enOff;        // start index into the flat member arrays
    List<int> enCnt;        // member count
    List<string> enMem;     // flat member names
    List<long> enVal;       // flat member constants (C# running counter)

    public Ngen(Binder b, Diags d, string file) {
        diags = d;
        srcFile = file;
        txt = new List<int>();
        syms = new List<Sym>();
        fixups = new List<Fixup>();
        strRefs = new List<StrRef>();
        strs = new List<string>();
        lblPos = new List<int>();
        brkL = new List<int>();
        cntL = new List<int>();
        methNodes = new List<Node>();
        methCls = new List<string>();
        methStat = new List<int>();
        nlabel = 0;
    }

    // ---- entry: returns the object file bytes ----
    public List<int> Gen(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.ClassDecl()) { CollectMethods(dcl); }
            i = i + 1;
        }
        CollectClasses(unit);
        CollectEnums(unit);
        // one lazy vtable slot per polymorphic class (the table itself is
        // built by _vtinit_<Cls> at first `new`)
        int ci = 0;
        while (ci < classes.Count) {
            if (classes[ci].poly == 1) {
                dglbs.Add(new DGlob("vt." + classes[ci].name, 8, dataLen));
                dataLen = dataLen + 8;
            }
            ci = ci + 1;
        }
        EmitRtCore();
        guardDivIdx = InternStr("division by zero\n");
        guardModIdx = InternStr("division by zero (modulo)\n");
        // gen0 bakes guard sites with the source path shortened to its
        // last two components ("selfhost/kernel10.zan")
        string gfile = srcFile;
        int lastSlash = -1;
        int prevSlash = -1;
        int si = srcFile.IndexOf("/");
        while (si >= 0) { prevSlash = lastSlash; lastSlash = si; si = srcFile.IndexOf("/", si + 1); }
        if (lastSlash >= 0 && prevSlash >= 0) {
            gfile = srcFile.Substring(prevSlash + 1, srcFile.Length - prevSlash - 1);
        }
        guardFileIdx = InternStr(gfile);
        guardStrIdx = InternStr("string index out of bounds\n");
        guardSubIdx = InternStr("substring index out of bounds\n");
        guardListIdx = InternStr("list index out of bounds\n");
        guardArrIdx = InternStr("array index out of bounds\n");
        guardArrNeg = InternStr("negative array length\n");
        guardArrOvf = InternStr("array allocation overflow\n");
        guardArrFail = InternStr("array allocation failed\n");
        guardArrNull = InternStr("null reference where an array is required (.Length)\n");
        if (FindStatic("Main") == null) {
            diags.Error("ngen: no static Main() found", 0, 0);
            return txt;
        }
        EmitMainShim();
        int mi = 0;
        while (mi < methNodes.Count) {
            EmitMethod(methCls[mi], methNodes[mi], mi);
            mi = mi + 1;
        }
        ci = 0;
        while (ci < classes.Count) {
            if (classes[ci].poly == 1) { EmitVtInit(classes[ci]); }
            ci = ci + 1;
        }
        RtEmitStrpool();
        Patch();
        return BuildMachO();
    }

    void CollectMethods(Node cls) {
        int i = 0;
        bool hasCtor = false;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && !HasMod(m, MOD.Extern()) && !IsAsync(m)) {
                if (m.sval == "Main" && HasMod(m, MOD.Static())) { mainCls = cls.sval; }
                methNodes.Add(m);
                methCls.Add(cls.sval);
                methStat.Add(HasMod(m, MOD.Static()) ? 1 : 0);
            }
            if (m.kind == AK.CtorDecl()) {
                hasCtor = true;
                methNodes.Add(m);
                methCls.Add(cls.sval);
                methStat.Add(2);
            }
            i = i + 1;
        }
        // a class with no declared ctors gets the synthesized parameterless
        // one, which is what runs its instance field initializers (and the
        // base chain) when `new T()` finds it
        if (!hasCtor) {
            Node dc = new Node(AK.CtorDecl());
            dc.mods = HasMod(cls, MOD.Static()) ? MOD.Static() : 0;
            methNodes.Add(dc);
            methCls.Add(cls.sval);
            methStat.Add(2);
        }
    }

    bool HasMod(Node m, int flag) { return (m.mods / flag) - ((m.mods / flag) / 2) * 2 == 1; }
    bool IsAsync(Node m) { return HasMod(m, MOD.Async()); }

    Node FindStatic(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methNodes[i].sval == name && methStat[i] == 1) { return methNodes[i]; }
            i = i + 1;
        }
        return null;
    }

    // find an instance method by name (first match across classes)
    int FindInstanceIdx(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methNodes[i].sval == name && methStat[i] == 0) { return i; }
            i = i + 1;
        }
        return -1;
    }

    bool IsVirtualMod(Node m) { return HasMod(m, MOD.Virtual()) || HasMod(m, MOD.Override()); }
    // what occupies a vtable slot: virtual, override, or an abstract
    // declaration (interfaces are all-abstract classes)
    bool IsSlotMod(Node m) { return IsVirtualMod(m) || HasMod(m, MOD.Abstract()); }

    int IndexOfStrNg(List<string> xs, string s) {
        int i = 0;
        while (i < xs.Count) { if (xs[i] == s) { return i; } i = i + 1; }
        return -1;
    }

    int MethodCountNg(string cls, string name) {
        int n = 0; int i = 0;
        while (i < methNodes.Count) {
            if (methStat[i] != 2 && methCls[i] == cls && methNodes[i].sval == name) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // symbol for a method (static or instance). With a single declaration
    // the historical `_Cls_name` stands; with overloads the parameter tags
    // are appended so two methods cannot collide (mirrors CtorSymNg)
    string MethSymNg(string cls, Node m) {
        if (MethodCountNg(cls, m.sval) <= 1) { return "_" + cls + "_" + m.sval; }
        string s = "_" + cls + "_" + m.sval + "__";
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTagNg(p.type); }
            i = i + 1;
        }
        return s;
    }

    // virtual-slot names of cls, base classes first; a derived
    // re-declaration of an inherited virtual keeps the base slot
    void CollectVSlotsNg(string cls, List<string> slots) {
        Cls c = FindClass(cls);
        if (c != null && c.baseName != null) { CollectVSlotsNg(c.baseName, slots); }
        int i = 0;
        while (i < methNodes.Count) {
            if (methStat[i] == 0 && methCls[i] == cls && IsSlotMod(methNodes[i])
                    && IndexOfStrNg(slots, methNodes[i].sval) < 0) { slots.Add(methNodes[i].sval); }
            i = i + 1;
        }
    }

    // slot index of `name` in the receiver's static class's vtable, or -1
    // when the call is not virtual
    int VSlotOf(string rc, string name) {
        List<string> slots = new List<string>();
        CollectVSlotsNg(rc, slots);
        return IndexOfStrNg(slots, name);
    }

    // instance-method candidates for a call on receiver class rc, derived
    // class first (shadowing picks the most-derived declaration)
    void InstanceCands(string rc, string name, List<int> outIdx) {
        string cur = rc;
        while (cur != null) {
            int i = 0;
            while (i < methNodes.Count) {
                if (methStat[i] == 0 && methCls[i] == cur && methNodes[i].sval == name) { outIdx.Add(i); }
                i = i + 1;
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
    }

    string VSlotImplCls(string cls, string name) {
        string cur = cls;
        while (cur != null) {
            int i = 0;
            while (i < methNodes.Count) {
                // an abstract declaration does not implement its own slot;
                // the search continues down the chain to the concrete body
                if (methStat[i] == 0 && methCls[i] == cur && methNodes[i].sval == name
                        && !HasMod(methNodes[i], MOD.Abstract())) { return cur; }
                i = i + 1;
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    Node FindInstanceInCls(string cls, string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methStat[i] == 0 && methCls[i] == cls && methNodes[i].sval == name) { return methNodes[i]; }
            i = i + 1;
        }
        return null;
    }

    // does method m admit a call with argc arguments: the exact arity, a
    // `params` tail covering the rest, or trailing default parameters
    // filling the gap (gen0's method_accepts_arity)
    bool MethodAcceptsArity(Node m, int argc) {
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        if (variadic) { return argc >= pc - 1; }
        if (argc == pc) { return true; }
        if (argc > pc) { return false; }
        int j = argc;
        while (j < pc) {
            Node p = ParamAt(m, j);
            if (p == null || p.b == null) { return false; }
            j = j + 1;
        }
        return true;
    }

    // overload resolution among candidate method indices: exact-arity
    // candidates outrank default-filled ones, each scored by
    // argument/parameter type agreement (same shape as FitCtorIdx)
    int FitPickIdx(List<int> cands, Node callNode) {
        int argc = callNode.kids.Count;
        int exact = -1; int exactScore = -2000000000;
        int filled = -1; int filledScore = -2000000000;
        int i = 0;
        while (i < cands.Count) {
            Node m = methNodes[cands[i]];
            if (MethodAcceptsArity(m, argc)) {
                int pc = ParamCount(m);
                int score = 0;
                bool compatible = true;
                int j = 0;
                while (j < argc && compatible) {
                    if (j < pc) {
                        Node p = ParamAt(m, j);
                        string pt = p != null && p.type != null ? TypeFullName(p.type) : null;
                        if (p != null && p.op == 1 && IsArrTy(pt)) {
                            // the params tail takes every remaining argument
                            // as an element, so it is ranked against the
                            // element type -- comparing an element with the
                            // array type would disqualify the only candidate
                            // that can take the call (Calc.Sum(1, 2, 3),
                            // gen0's method_args_score). The bundle handed
                            // over whole stays exact.
                            string et = pt.Substring(0, pt.Length - 2);
                            while (j < argc) {
                                Node ta = callNode.kids[j];
                                string tat = StaticTyOf(ta);
                                if (tat != null && tat == pt) {
                                    score = score + 8;
                                } else {
                                    int es = ArgParamScore(ta, et);
                                    if (es <= -100) { compatible = false; }
                                    score = score + es;
                                }
                                j = j + 1;
                            }
                        } else {
                            int s = ArgParamScore(callNode.kids[j], pt);
                            if (s <= -100) { compatible = false; }
                            score = score + s;
                        }
                    }
                    j = j + 1;
                }
                if (compatible) {
                    if (pc == argc) {
                        if (score > exactScore) { exactScore = score; exact = cands[i]; }
                    } else {
                        if (score > filledScore) { filledScore = score; filled = cands[i]; }
                    }
                }
            }
            i = i + 1;
        }
        if (exact >= 0) { return exact; }
        return filled;
    }

    // find a static method declared by exactly this class (Class.Method()
    // form -- FindStaticIdx only matches by bare name)
    int FindStaticInCls(string cls, string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methStat[i] == 1 && methCls[i] == cls && methNodes[i].sval == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // does the named class declare a constructor?
    bool ClassHasCtor(string cls) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methStat[i] == 2 && methCls[i] == cls) { return true; }
            i = i + 1;
        }
        return false;
    }

    // does the program itself declare a member of class "Convert" with this
    // name? (gen0 steps its built-ins aside per member, so defining one
    // Convert method does not disable the others)
    bool UserDefinesConvert(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methCls[i] == "Convert" && methNodes[i].sval == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // which scalar flavour does this expression carry, for x.ToString()
    // rendering (null = not a scalar: leave the call to method dispatch)?
    string ScalarToStringTy(Node e) {
        if (e == null) { return null; }
        if (IsBoolExpr(e)) { return "bool"; }
        if (IsStrExpr(e)) { return "string"; }
        if (IsCharExpr(e)) { return "char"; }
        if (IsDblExpr(e)) { return "double"; }
        if (IsUlongExpr(e)) { return "ulong"; }
        if (e.kind == AK.CastExpr() && e.type != null) {
            // gen0 renders uint/ushort signed too (only ulong goes unsigned)
            string t = e.type.sval;
            if (t == "double" || t == "float") { return "double"; }
            if (t == "ulong") { return "ulong"; }
            if (t == "int" || t == "long" || t == "short" || t == "byte"
                    || t == "sbyte" || t == "uint" || t == "ushort") { return "int"; }
            return null;
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) {
                string t = locTy[li];
                if (t == "int" || t == "long" || t == "short" || t == "byte"
                        || t == "sbyte" || t == "uint" || t == "ushort") { return "int"; }
                return null;
            }
            Fld f = CurField(e.sval);
            if (f != null && (f.ty == "int" || f.ty == "long"
                    || f.ty == "short" || f.ty == "byte")) { return "int"; }
            string st = FindStaticTy(curCls, e.sval);
            if (st == "int" || st == "long") { return "int"; }
            return null;
        }
        if (e.kind == AK.Call() && e.a != null) {
            string rt = CallRetTy(e);
            if (rt == "int" || rt == "long" || rt == "short" || rt == "byte") { return "int"; }
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && (f.ty == "int" || f.ty == "long"
                    || f.ty == "short" || f.ty == "byte")) { return "int"; }
        }
        return null;
    }

    // ---- method emission ----
    void EmitMainShim() {
        syms.Add(new Sym("_main", txt.Count));
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]! (save lr: bl below clobbers it)
        BLInternal("_zan_rt_strpool_init");              // stamp literals first
        // static field initializers run before Main, in declaration order
        int si2 = 0;
        while (si2 < sfInitCls.Count) {
            curCls = sfInitCls[si2];
            GenExpr(sfInitExpr[si2]);
            LoadSymRef(sfInitSym[si2], 9);
            StrU(0, 9, 0);
            si2 = si2 + 1;
        }
        curCls = mainCls;
        BLInternal("_" + mainCls + "_Main");
        E4(0xD2800000);                                  // movz x0, #0
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    void EmitMethod(string cls, Node m, int mi) {
        curCls = cls;
        bool inst = methStat[mi] != 1;
        if (methStat[mi] == 2) {
            syms.Add(new Sym(CtorSymNg(cls, m), txt.Count));
        } else {
            syms.Add(new Sym(MethSymNg(cls, m), txt.Count));
        }
        locName = new List<string>();
        locTy = new List<string>();
        locOff = new List<int>();
        nloc = 0;
        // instance methods and ctors take `this` as their first argument
        if (inst) {
            locName.Add("this");
            locTy.Add("");
            locOff.Add(16 * nloc);
            nloc = nloc + 1;
        }
        // params get frame slots; the prologue stores x0.. into them in order
        int pi = 0;
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                locName.Add(p.sval);
                locTy.Add(TypeFullName(p.type));
                locOff.Add(16 * nloc);
                nloc = nloc + 1;
            }
            pi = pi + 1;
        }
        ReserveLocals(m.d);
        frame = 16 * nloc;
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]!
        E4(0x910003FD);                                  // mov x29, sp
        if (frame > 0) { AddSPImm(frame, false); }       // sub sp, sp, #frame
        pi = 0;
        int argReg = 0;
        if (inst) {
            StoreLocal(0, 0);        // this
            argReg = 1;
        }
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                E4(0xF8000000 | ((LocFpOff(locOff[argReg]) & 0x1FF) << 12) | (29 << 5) | argReg);
                argReg = argReg + 1;
            }
            pi = pi + 1;
        }
        // ctor initializer chaining (gen0 parity). `: this(args)` runs
        // another ctor of the same class first (it owns the base chain) and
        // is mutually exclusive with base chaining; otherwise `: base(args)`
        // explicitly, or the parameterless base ctor implicitly -- base
        // fields are a layout prefix, so the base ctor runs on `this`
        // before the body
        if (methStat[mi] == 2 && m.c != null) {
            int tix = FitCtorIdx(cls, m.c, false, m);
            if (tix >= 0) {
                int tpushed = PushCallArgs(methNodes[tix], m.c);
                int tr = tpushed;
                while (tr >= 1) { E4(0xF84107E0 | tr); tr = tr - 1; } // args reversed
                LoadLocal(0, 0);                                 // this -> x0
                BLInternal(CtorSymNg(cls, methNodes[tix]));
            } else {
                diags.Error("ngen: no matching 'this' constructor with "
                    + m.c.kids.Count + " argument(s)", m.line, m.col);
            }
        } else if (methStat[mi] == 2) {
            Cls c = FindClass(cls);
            if (c != null && c.baseName != null) {
                int bix;
                Node zerocall = new Node(AK.Call());
                if (m.b != null) {
                    bix = FitCtorIdx(c.baseName, m.b, false, null);
                } else {
                    bix = FitCtorIdx(c.baseName, zerocall, true, null);
                }
                if (bix >= 0) {
                    int bpushed;
                    if (m.b != null) {
                        bpushed = PushCallArgs(methNodes[bix], m.b);
                    } else {
                        bpushed = 0;
                    }
                    int br = bpushed;
                    while (br >= 1) { E4(0xF84107E0 | br); br = br - 1; } // args reversed
                    LoadLocal(0, 0);                             // this -> x0
                    BLInternal(CtorSymNg(c.baseName, methNodes[bix]));
                }
            }
        }
        // instance field initializers run after the base chain and before
        // the body, once per ctor (a `: this(...)` delegator lets the
        // chain target run them, so it skips its own)
        if (methStat[mi] == 2 && m.c == null) {
            int fi2 = 0;
            while (fi2 < ifInitCls.Count) {
                if (ifInitCls[fi2] == cls) {
                    GenExpr(ifInitExpr[fi2]);
                    E4(0xF81F0FE0);                          // push value
                    LoadLocal(0, 0);                         // this -> x0
                    E4(0xF84107E1);                          // pop value -> x1
                    StrU(1, 0, FieldOff(cls, ifInitName[fi2]));
                }
                fi2 = fi2 + 1;
            }
        }
        if (m.d != null) { GenStmt(m.d); }
        E4(0xD2800000);                                  // movz x0, #0 (fallthrough)
        Epilogue();
    }

    void ReserveLocals(Node blk) {
        if (blk == null) { return; }
        int i = 0;
        while (i < blk.kids.Count) {
            Node s = blk.kids[i];
            if (s.kind == AK.VarDecl()) {
                locName.Add(s.sval);
                locTy.Add(TypeFullName(s.type));
                locOff.Add(16 * nloc);
                nloc = nloc + 1;
            } else if (s.kind == AK.Block()) {
                ReserveLocals(s);
            } else if (s.kind == AK.IfStmt()) {
                ReserveLocals(s.b);
                ReserveLocals(s.c);
            } else if (s.kind == AK.WhileStmt()) {
                ReserveLocals(s.b);
            } else if (s.kind == AK.ForStmt()) {
                // the init VarDecl is a bare node (no kids block), so it
                // must be reserved inline rather than via ReserveLocals
                if (s.a != null && s.a.kind == AK.VarDecl()) {
                    locName.Add(s.a.sval);
                    locTy.Add(TypeFullName(s.a.type));
                    locOff.Add(16 * nloc);
                    nloc = nloc + 1;
                }
                ReserveLocals(s.d);
            } else if (s.kind == AK.ForeachStmt()) {
                locName.Add(s.sval);
                locTy.Add(TypeFullName(s.type));
                locOff.Add(16 * nloc);
                nloc = nloc + 1;
                locName.Add("#fei");
                locTy.Add("int");
                locOff.Add(16 * nloc);
                nloc = nloc + 1;
                ReserveLocals(s.c);
            } else if (s.kind == AK.TryStmt()) {
                ReserveLocals(s.a);
                if (s.b != null) {
                    if (s.b.sval != null && s.b.sval != "") {
                        locName.Add(s.b.sval);
                        // catch variable type: the declared type (string for
                        // bare throws, Exception for typed throws)
                        if (s.b.type != null) { locTy.Add(TypeFullName(s.b.type)); }
                        else { locTy.Add("string"); }
                        locOff.Add(16 * nloc);
                        nloc = nloc + 1;
                    }
                    ReserveLocals(s.b.a);
                }
            }
            i = i + 1;
        }
    }

    int LocalIdx(string name) {
        int i = locName.Count - 1;
        while (i >= 0) { if (locName[i] == name) { return i; } i = i - 1; }
        return -1;
    }

    void Epilogue() {
        // reset sp from the frame pointer first: a `return` from inside a
        // switch/loop construct can leave its stack temporaries (e.g. the
        // switch discriminant) still pushed, and `add sp, sp, #frame` alone
        // would make the ldp below read x29/x30 from the wrong slot
        E4(0x910003BF);                                  // mov sp, x29
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    // ---- statements ----
    void GenStmt(Node s) {        if (s == null) { return; }
        if (s.line > 0) { curLine = s.line; curCol = s.col; }
        int k = s.kind;
        if (k == AK.Block()) {
            int i = 0;
            while (i < s.kids.Count) { GenStmt(s.kids[i]); i = i + 1; }
        } else if (k == AK.VarDecl()) {
            if (s.b != null) {
                GenExpr(s.b);
                if (s.type != null && TypeFullName(s.type) == "double" && !IsDblExpr(s.b)) { ConvI2D(); }
                StoreLocal(LocalIdx(s.sval), 0);
            }
        } else if (k == AK.ExprStmt()) {
            GenExpr(s.a);
        } else if (k == AK.ReturnStmt()) {
            if (s.a != null) { GenExpr(s.a); }
            Epilogue();
        } else if (k == AK.IfStmt()) {
            int els = NL(); int end = NL();
            GenExpr(s.a);
            EmitCBZ(0, els);
            GenStmt(s.b);
            EmitB(end);
            Mark(els);
            if (s.c != null) { GenStmt(s.c); }
            Mark(end);
        } else if (k == AK.SwitchStmt()) {
            GenSwitchStmt(s);
        } else if (k == AK.WhileStmt()) {
            int top = NL(); int outL = NL(); int cnt = NL();
            brkL.Add(outL); cntL.Add(cnt);
            Mark(top);
            GenExpr(s.a);
            EmitCBZ(0, outL);
            GenStmt(s.b);
            Mark(cnt);
            EmitB(top);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
        } else if (k == AK.ForStmt()) {
            // for (init; cond; step) body: init runs once, cond guards the
            // top, step runs at the continue point before looping back
            if (s.a != null) { GenStmt(s.a); }
            int top = NL(); int outL = NL(); int cnt = NL();
            brkL.Add(outL); cntL.Add(cnt);
            Mark(top);
            if (s.b != null) {
                GenExpr(s.b);
                EmitCBZ(0, outL);
            }
            GenStmt(s.d);
            Mark(cnt);
            if (s.c != null) { GenExpr(s.c); }
            EmitB(top);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
        } else if (k == AK.ForeachStmt()) {
            GenForeach(s);
        } else if (k == AK.BreakStmt()) {
            if (brkL.Count == 0) {
                diags.Error("ngen: break outside loop", s.line, s.col);
            } else {
                EmitB(brkL[brkL.Count - 1]);
            }
        } else if (k == AK.ContinueStmt()) {
            if (cntL.Count == 0) {
                diags.Error("ngen: continue outside loop", s.line, s.col);
            } else {
                EmitB(cntL[cntL.Count - 1]);
            }
        } else if (k == AK.TryStmt()) {
            GenTry(s);
        } else if (k == AK.ThrowStmt()) {
            GenThrow(s);
        } else {
            diags.Error("ngen: unsupported statement kind " + k, s.line, s.col);
        }
    }

    // foreach (T x in coll) body: collection re-evaluated each iteration
    // into a stack slot, hidden index local drives the bounds; arrays use
    // their -16 length header, lists the count field
    void GenForeach(Node s) {
        Node coll = s.b;
        bool isArr = IsArrExpr(coll);
        int esz = isArr ? ArrElemSize(ArrTyOf(coll)) : 8;
        int elemVar = LocalIdx(s.sval);
        int idxVar = LocalIdx("#fei");
        int top = NL(); int outL = NL(); int cnt = NL();
        brkL.Add(outL); cntL.Add(cnt);
        LoadImm(0, 0);
        StoreLocal(idxVar, 0);
        Mark(top);
        GenExpr(coll);
        E4(0xF81F0FE0);                              // push coll
        if (isArr) {
            E4(0xF85F0002);                          // ldur x2, [x0, #-16] (len)
        } else {
            LdrU(2, 0, 0);                           // x2 = count
        }
        LoadLocal(idxVar, 0);                        // x0 = i (coll now only on the stack)
        E4(0xEB02001F);                              // cmp x0, x2
        int popOut = NL();
        EmitBcond(10, popOut);                       // b.ge popOut (coll still pushed)
        if (isArr && esz == 4) {
            E4(0xF84107E2);                          // pop coll -> x2
            E4(0xB8607840);                          // ldr w0, [x2, x0, lsl #2]
        } else if (isArr) {
            E4(0xF84107E2);                          // pop coll -> x2
            E4(0xF8607840);                          // ldr x0, [x2, x0, lsl #3]
        } else {
            LdrU(3, 31, 0);                          // x3 = coll (stack slot)
            LdrU(3, 3, 16);                          // x3 = data
            E4(0xF8607860);                          // ldr x0, [x3, x0, lsl #3]
            E4(0xF84107E2);                          // pop coll (discard)
        }
        StoreLocal(elemVar, 0);
        GenStmt(s.c);
        Mark(cnt);
        LoadLocal(idxVar, 0);
        AddImm(0, 0, 1);
        StoreLocal(idxVar, 0);
        EmitB(top);
        Mark(popOut);
        E4(0xF84107E2);                              // pop coll (discard)
        EmitB(outL);
        Mark(outL);
        brkL.RemoveAt(brkL.Count - 1);
        cntL.RemoveAt(cntL.Count - 1);
    }

    // ---- expressions: result in x0 ----
    // switch (disc) { case C: ... default: ... }: a compare chain like
    // gen0's constant lowering (the selfhost parser only produces constant
    // cases). The discriminant stays at [sp] for the whole statement; every
    // case body and the default arm end at the shared exit, where it is
    // popped. `break` inside a case targets the switch exit, not an
    // enclosing loop; `continue` keeps targeting the loop.
    void GenSwitchStmt(Node s) {
        int endL = NL();
        int defL = NL();
        GenExpr(s.a);
        E4(0xF81F0FE0);                                  // push discriminant
        int nc = s.kids.Count;
        int[] bodies = new int[nc];
        int defIdx = -1;
        int i = 0;
        while (i < nc) {
            Node c = s.kids[i];
            if (c.a == null) { defIdx = i; i = i + 1; continue; }
            bodies[i] = NL();
            if (IsStrExpr(s.a)) {
                GenExpr(c.a);                            // x0 = case label
                LdrU(1, 31, 0);                          // x1 = discriminant
                BLExtern("_strcmp");
                E4(0xEB1F001F);                          // cmp x0, xzr
            } else {
                GenExpr(c.a);                            // x0 = case label
                E4(0xF81F0FE0);                          // push label
                LdrU(1, 31, 16);                         // x1 = discriminant
                E4(0xF84107E0);                          // pop label -> x0
                E4(0xEB01001F);                          // cmp x0, x1
            }
            EmitBcond(0, bodies[i]);                     // b.eq body
            i = i + 1;
        }
        EmitB(defIdx >= 0 ? defL : endL);
        brkL.Add(endL);
        i = 0;
        while (i < nc) {
            Node c = s.kids[i];
            if (c.a == null) { i = i + 1; continue; }
            Mark(bodies[i]);
            GenStmt(c.b);
            // an empty case body falls through to the next case (C# rule);
            // only a body that emitted code needs the jump to the exit
            if (c.b == null || c.b.kids.Count > 0) { EmitB(endL); }
            i = i + 1;
        }
        if (defIdx >= 0) {
            Mark(defL);
            GenStmt(s.kids[defIdx].b);
            EmitB(endL);
        }
        brkL.RemoveAt(brkL.Count - 1);
        Mark(endL);
        E4(0xF84107E0);                                  // pop discriminant
    }

    void GenExpr(Node e) {
        int k = e.kind;
        if (k == AK.IntLit()) {
            // gen0's int-literal rule: an unsuffixed radix-2/8/16 literal in
            // the uint range types as int, so its runtime value is the
            // int-domain (two's-complement) one
            long v = e.ival;
            int sfx = e.suffix - (e.suffix / 4) * 4;
            int rad = e.suffix >= 16 ? 16 : (e.suffix >= 8 ? 8 : 0);
            if (sfx == 0 && rad != 0 && v > 2147483647 && v <= 4294967295) {
                v = v - 4294967296;
            }
            LoadImm(0, v);
        } else if (k == AK.NullLit()) {
            LoadImm(0, 0);
        } else if (k == AK.StringLit()) {
            LoadStr(InternStr(e.sval), 0);
        } else if (k == AK.BoolLit()) {
            LoadImm(0, e.ival);
        } else if (k == AK.CharLit()) {
            // a char is its codepoint in the value slot (rendering decides
            // string vs decimal per context, like gen0)
            LoadImm(0, e.ival);
        } else if (k == AK.FloatLit()) {
            // materialise the IEEE bits through libc strtod -- lazily, into
            // a zero-initialised __DATA slot (0.0 simply reconverts, so the
            // conversion path stays idempotent)
            int di = InternStr(e.sval);
            dglbs.Add(new DGlob("dbl." + di, 8, dataLen));
            dataLen = dataLen + 8;
            LoadSymRef(DGlobalSym("dbl." + di), 9);
            LdrU(0, 9, 0);
            int need = NL();
            int done = NL();
            CbzReg(0, need);
            EmitB(done);
            Mark(need);
            LoadStr(di, 0);                          // x0 = literal text
            LoadImm(1, 0);
            BLExtern("_strtod");
            E4(0x9E660000);                          // fmov x0, d0
            LoadSymRef(DGlobalSym("dbl." + di), 9);  // x9 is caller-saved: reload the slot
            StrU(0, 9, 0);
            LdrU(0, 9, 0);
            Mark(done);
        } else if (k == AK.ThisExpr()) {
            LoadLocal(LocalIdx("this"), 0);
        } else if (k == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li < 0) {
                // implicit field reference inside instance methods
                Fld fld = CurField(e.sval);
                if (fld != null) {
                    LoadLocal(LocalIdx("this"), 0);
                    LdrU(0, 0, fld.off);
                    return;
                }
                // static field: the value lives in a data-global slot
                string ssym = FindStaticSym(curCls, e.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    LdrU(0, 0, 0);
                    return;
                }
                diags.Error("ngen: unknown identifier '" + e.sval + "'", e.line, e.col);
                LoadImm(0, 0);
                return;
            }
            LoadLocal(li, 0);
        } else if (k == AK.MemberAccess()) {
            if (e.sval == "Count" && ExprCls(e.a) == "List") { GenListCount(e.a); }
            else if ((e.sval == "Length" || e.sval == "Count") && ArrContainerTy(e.a) != null) {
                // gen0: null report (reads the zeroed scratch afterwards),
                // length is the i64 count at arr-16; .Count is aliased to
                // .Length so a params bundle answers the List spelling too
                GenExpr(e.a);
                int badn = NL();
                int contn = NL();
                int donen = NL();
                CbzReg(0, badn);
                EmitB(contn);
                Mark(badn);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, curLine);
                LoadImm(2, curCol);
                LoadSymRef("l_.str." + guardArrNull, 3);
                BLExtern("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(donen);
                Mark(contn);
                E4(0xF85F0000);                      // ldur x0, [x0, #-16]
                Mark(donen);
            }
            else if (e.sval == "Length" && IsStrExpr(e.a)) {
                // gen0 probes the SNAZ header: length lives in the low 32
                // bits of the i64 at s-8
                GenExpr(e.a);
                E4(0xD1002009);                      // sub x9, x0, #8
                E4(0xF9400120);                      // ldr x0, [x9]
                E4(0xD3407C00);                      // ubfm x0, x0, #0, #31
            }
            else if (e.a != null && e.a.kind == AK.Ident()
                    && FindEnumMemIdx(e.a.sval, e.sval) >= 0) {
                // EnumType.Member constant
                LoadImm(0, enVal[FindEnumMemIdx(e.a.sval, e.sval)]);
            }
            else { GenFieldLoad(e); }
        } else if (k == AK.Binary() && e.op == TK.AmpAmp()) {
            // short-circuit AND: the right operand runs only when the left
            // is truthy; result normalises to 0/1
            int falsL = NL();
            int endL = NL();
            GenExpr(e.a);
            CbzReg(0, falsL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(falsL);
            LoadImm(0, 0);
            Mark(endL);
        } else if (k == AK.Binary() && e.op == TK.PipePipe()) {
            int trueL = NL();
            int endL = NL();
            GenExpr(e.a);
            EmitCbnz(0, trueL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(trueL);
            LoadImm(0, 1);
            Mark(endL);
        } else if (k == AK.Binary()) {
            if (e.op == TK.Plus() && (IsStrExpr(e.a) || IsStrExpr(e.b))) {
                // string concatenation: non-string operands convert through
                // zan_rt_int2str (gen0 prints them with "%lld"), then
                // lhs -> x0, rhs -> x1, zan_rt_strcat2(lhs, rhs)
                GenExpr(e.a);
                if (!IsStrExpr(e.a)) {
                    if (IsDblExpr(e.a)) { BLInternal("_zan_rt_dbl2str"); }
                    else if (IsCharExpr(e.a)) { BLInternal("_zan_rt_chrstr"); }
                    else if (IsUlongExpr(e.a)) { BLInternal("_zan_rt_uint2str"); }
                    else { BLInternal("_zan_rt_int2str"); }
                }
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                GenExpr(e.b);
                if (!IsStrExpr(e.b)) {
                    if (IsDblExpr(e.b)) { BLInternal("_zan_rt_dbl2str"); }
                    else if (IsCharExpr(e.b)) { BLInternal("_zan_rt_chrstr"); }
                    else if (IsUlongExpr(e.b)) { BLInternal("_zan_rt_uint2str"); }
                    else { BLInternal("_zan_rt_int2str"); }
                }
                E4(0xF84107E1);                          // ldr x1, [sp], #16 (lhs)
                E4(0xAA0003E9);                          // mov x9, x0
                E4(0xAA0103E0);                          // mov x0, x1
                E4(0xAA0903E1);                          // mov x1, x9
                BLInternal("_zan_rt_strcat2");
            } else if (IsStrExpr(e.a) && IsStrExpr(e.b)
                    && (e.op == TK.EqEq() || e.op == TK.BangEq())) {
                // lexicographic equality via strcmp (gen0 parity)
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push a
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop a -> x1 (x0 = b)
                BLExtern("_strcmp");                 // w0 = 0 iff equal
                E4(0x7100001F);                      // cmp w0, #0
                if (e.op == TK.EqEq()) { E4(0x9A9F17E0); }   // cset x0, eq
                else { E4(0x9A9F07E0); }                     // cset x0, ne
            } else if (IsDblExpr(e.a) || IsDblExpr(e.b)) {
                // double arithmetic/comparison: values travel as i64 bit
                // patterns in x0; the op materialises d-regs, coercing int
                // operands with scvtf. Comparisons are the ordered ones (a
                // NaN input always answers false, true only for !=).
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // str x0, [sp, #-16]!
                GenExpr(e.b);
                E4(0xF84107E1);                      // ldr x1, [sp], #16
                int op = e.op;
                if (IsDblExpr(e.a)) { E4(0x9E670020); }  // fmov d0, x1
                else { E4(0x9E620020); }                 // scvtf d0, x1
                if (IsDblExpr(e.b)) { E4(0x9E670001); }  // fmov d1, x0
                else { E4(0x9E620001); }                 // scvtf d1, x0
                if (op == TK.Plus()) {
                    E4(0x1E602820);                  // fadd d0, d1, d0
                    E4(0x9E660000);                  // fmov x0, d0
                } else if (op == TK.Minus()) {
                    E4(0x1E613800);                  // fsub d0, d0, d1
                    E4(0x9E660000);
                } else if (op == TK.Star()) {
                    E4(0x1E600820);                  // fmul d0, d1, d0
                    E4(0x9E660000);
                } else if (op == TK.Slash()) {
                    E4(0x1E611800);                  // fdiv d0, d0, d1 (IEEE: no guard, like gen0)
                    E4(0x9E660000);
                } else if (op == TK.Less()) {
                    E4(0x1E612000);                  // fcmp d0, d1
                    E4(0x9A9F57E0);                  // cset x0, mi
                } else if (op == TK.Greater()) {
                    E4(0x1E612000);                  // fcmp d0, d1
                    E4(0x9A9FD7E0);                  // cset x0, gt
                } else if (op == TK.LessEq()) {
                    E4(0x1E602020);                  // fcmp d1, d0 (swapped: a<=b <=> b>=a)
                    E4(0x9A9FB7E0);                  // cset x0, ge
                } else if (op == TK.GreaterEq()) {
                    E4(0x1E612000);                  // fcmp d0, d1
                    E4(0x9A9FB7E0);                  // cset x0, ge
                } else if (op == TK.EqEq()) {
                    int set0 = NL();
                    int done2 = NL();
                    E4(0x1E602020);                  // fcmp d1, d0
                    EmitBcond(6, set0);              // b.vs -> unordered: false
                    E4(0x9A9F17E0);                  // cset x0, eq
                    EmitB(done2);
                    Mark(set0);
                    LoadImm(0, 0);
                    Mark(done2);
                } else if (op == TK.BangEq()) {
                    int set1 = NL();
                    int done3 = NL();
                    E4(0x1E602020);                  // fcmp d1, d0
                    EmitBcond(6, set1);              // b.vs -> unordered: true
                    E4(0x9A9F07E0);                  // cset x0, ne
                    EmitB(done3);
                    Mark(set1);
                    LoadImm(0, 1);
                    Mark(done3);
                } else {
                    diags.Error("ngen: unsupported double operator " + op, e.line, e.col);
                }
            } else {
                GenExpr(e.a);
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                GenExpr(e.b);
                E4(0xF84107E1);                          // ldr x1, [sp], #16
                int op = e.op;
                if (IsUlongExpr(e.a) || IsUlongExpr(e.b)) {
                    // unsigned 64-bit: add/sub/mul wrap identically, but
                    // division drops the MIN/-1 fold, comparisons go
                    // unsigned, and >> is logical (mirrors gen0's IR)
                    if (op == TK.Plus()) {
                        E4(0x8B000020);                  // add x0, x1, x0
                    } else if (op == TK.Minus()) {
                        E4(0xCB000020);                  // sub x0, x1, x0
                    } else if (op == TK.Star()) {
                        E4(0x9B007C20);                  // mul x0, x1, x0
                    } else if (op == TK.Slash() || op == TK.Percent()) {
                        int bad = NL();
                        int cont = NL();
                        CbzReg(0, bad);
                        EmitB(cont);
                        Mark(bad);
                        E4(0xF81F0FE1);                  // str x1, [sp, #-16]! (keep dividend)
                        LoadSymRef("l_.str." + guardFileIdx, 0);
                        LoadImm(1, curLine);
                        LoadImm(2, curCol);
                        if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                        else { LoadSymRef("l_.str." + guardModIdx, 3); }
                        BLExtern("_zan_rt_guard_fail3");
                        E4(0xF84107E1);                  // ldr x1, [sp], #16
                        LoadImm(0, 1);                   // safe divisor
                        Mark(cont);
                        if (op == TK.Slash()) {
                            E4(0x9AC00820);              // udiv x0, x1, x0
                        } else {
                            E4(0x9AC00824);              // udiv x4, x1, x0
                            E4(0x9B008480);              // msub x0, x4, x0, x1
                        }
                    } else if (op == TK.Less()) {
                        E4(0xEB00003F);                  // cmp x1, x0
                        E4(0x9A9F27E0);                  // cset x0, lo
                    } else if (op == TK.Greater()) {
                        E4(0xEB00003F);
                        E4(0x9A9F97E0);                  // cset x0, hi
                    } else if (op == TK.LessEq()) {
                        E4(0xEB00003F);
                        E4(0x9A9F87E0);                  // cset x0, ls
                    } else if (op == TK.GreaterEq()) {
                        E4(0xEB00003F);
                        E4(0x9A9F37E0);                  // cset x0, hs
                    } else if (op == TK.EqEq()) {
                        E4(0xEB00003F);
                        E4(0x9A9F17E0);                  // cset x0, eq
                    } else if (op == TK.BangEq()) {
                        E4(0xEB00003F);
                        E4(0x9A9F07E0);                  // cset x0, ne
                    } else if (op == TK.LessLess()) {
                        E4(0x9AC02020);                  // lslv x0, x1, x0
                    } else if (op == TK.GreaterGreater()) {
                        E4(0x9AC02420);                  // lsrv x0, x1, x0
                    } else {
                        diags.Error("ngen: unsupported ulong operator " + op, e.line, e.col);
                    }
                } else if (op == TK.Plus()) {
                    E4(0x8B000020);                      // add x0, x1, x0
                } else if (op == TK.Minus()) {
                    E4(0xCB000020);                      // sub x0, x1, x0
                } else if (op == TK.Star()) {
                    E4(0x9B007C20);                      // mul x0, x1, x0
                } else if (op == TK.Slash() || op == TK.Percent()) {
                    // divide/modulo: x1 = dividend, x0 = divisor. A zero
                    // divisor reports through zan_rt_guard_fail3 -- the same
                    // C-runtime guard the IR backend links -- and continues
                    // with divisor 1; INT_MIN / -1 also divides by 1 to
                    // avoid the SIGFPE trap, mirroring gen0's select guard.
                    int bad = NL();
                    int cont = NL();
                    int safe = NL();
                    CbzReg(0, bad);
                    EmitB(cont);
                    Mark(bad);
                    E4(0xF81F0FE1);                      // str x1, [sp, #-16]! (keep dividend across the call)
                    LoadSymRef("l_.str." + guardFileIdx, 0);
                    LoadImm(1, curLine);
                    LoadImm(2, curCol);
                    if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                    else { LoadSymRef("l_.str." + guardModIdx, 3); }
                    BLExtern("_zan_rt_guard_fail3");
                    E4(0xF84107E1);                      // ldr x1, [sp], #16 (own push; cont must not pop)
                    LoadImm(0, 1);                       // safe divisor
                    Mark(cont);
                    LoadImm(2, 0x8000000000000000);      // i64 min
                    LoadImm(3, -1);
                    E4(0xEB03001F);                      // cmp x0, x3
                    EmitBcond(1, safe);                  // b.ne safe
                    E4(0xEB02003F);                      // cmp x1, x2
                    EmitBcond(1, safe);
                    LoadImm(0, 1);
                    Mark(safe);
                    if (op == TK.Slash()) {
                        E4(0x9AC00C20);                  // sdiv x0, x1, x0
                    } else {
                        E4(0x9AC00C24);                  // sdiv x4, x1, x0
                        E4(0x9B008480);                  // msub x0, x4, x0, x1
                    }
                } else if (op == TK.Less()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FA7E0);                      // cset x0, lt
                } else if (op == TK.Greater()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FD7E0);                      // cset x0, gt
                } else if (op == TK.LessEq()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FC7E0);                      // cset x0, le
                } else if (op == TK.GreaterEq()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FB7E0);                      // cset x0, ge
                } else if (op == TK.EqEq()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9F17E0);                      // cset x0, eq
                } else if (op == TK.BangEq()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9F07E0);                      // cset x0, ne
                } else if (op == TK.LessLess()) {
                    E4(0x9AC02020);                      // lslv x0, x1, x0
                } else if (op == TK.GreaterGreater()) {
                    E4(0x9AC02820);                      // asrv x0, x1, x0
                } else if (op == TK.Amp()) {
                    E4(0x8A000020);                      // and x0, x1, x0
                } else if (op == TK.Pipe()) {
                    E4(0xAA000020);                      // orr x0, x1, x0
                } else if (op == TK.Caret()) {
                    E4(0xCA000020);                      // eor x0, x1, x0
                } else {
                    diags.Error("ngen: unsupported operator " + op, e.line, e.col);
                }
            }
        } else if (k == AK.Unary()) {
            GenExpr(e.a);
            if (e.op == TK.Minus()) {
                E4(0xCB0003E0);                      // neg x0, x0 (sub x0, xzr, x0)
            } else if (e.op == TK.Bang()) {
                // cset needs fresh flags: cmp against 1 so any nonzero-ish
                // bool (0/1 in practice) negates correctly
                E4(0xF100041F);                      // cmp x0, #1
                E4(0x9A9F07E0);                      // cset x0, ne
            }
            // unary plus is a no-op on the bit pattern
        } else if (k == AK.CastExpr() && e.type != null) {
            // numeric casts: int<->ulong share the slot bits; to/from
            // double converts via scvtf/fcvtzs (like gen0's fptosi/sitofp)
            string ty = e.type.sval;
            bool toDbl = ty == "double";
            bool fromDbl = IsDblExpr(e.b);
            if (toDbl && !fromDbl) {
                GenExpr(e.b);
                E4(0x9E620000);                      // scvtf d0, x0
                E4(0x9E660000);                      // fmov x0, d0
            } else if (!toDbl && fromDbl) {
                GenExpr(e.b);
                E4(0x9E670000);                      // fmov d0, x0
                E4(0x9E780000);                      // fcvtzs x0, d0
            } else {
                GenExpr(e.b);                        // int<->ulong (and dbl->dbl): bits unchanged
            }
        } else if (k == AK.Index()) {
            if (IsStrExpr(e.a)) {
                // char access: bounds-checked byte load (gen0 reports the
                // same guard message and continues with index 0)
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push s
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop s -> x1 (x0 = idx)
                E4(0xD1002022);                      // sub x2, x1, #8
                E4(0xF9400042);                      // ldr x2, [x2]
                E4(0xD3407C42);                      // ubfm x2, x2, #0, #31 (len)
                int bad = NL();
                int cont = NL();
                E4(0xEB02001F);                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE1);                      // keep s across the call
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardStrIdx, 3);
                BLExtern("_zan_rt_guard_fail3");
                E4(0xF84107E1);                      // pop s
                LoadImm(0, 0);                       // safe index
                Mark(cont);
                E4(0x38606820);                      // ldrb w0, [x1, x0]
            } else if (ArrContainerTy(e.a) != null) {
                // array element get: len = i64 at arr-16; a bad index reports
                // and continues with index 0 (gen0 parity). int[] stores i32.
                int esz = ArrElemSize(ArrContainerTy(e.a));
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push arr
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop arr -> x1 (x0 = idx)
                E4(0xF85F0022);                      // ldur x2, [x1, #-16] (len)
                int bad = NL();
                int cont = NL();
                E4(0xEB02001F);                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE1);                      // keep arr (guard clobbers x1)
                E4(0xF81F0FE0);                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLExtern("_zan_rt_guard_fail3");
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E1);                      // pop arr
                LoadImm(0, 0);
                Mark(cont);
                if (esz == 4) {
                    E4(0xB8607820);                  // ldr w0, [x1, x0, lsl #2]
                } else {
                    E4(0xF8607820);                  // ldr x0, [x1, x0, lsl #3]
                }
            } else if (ExprCls(e.a) == "List") {
                // element get: data = obj+16, count = obj+0, 8-byte slots
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push obj
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop obj -> x1 (x0 = idx)
                LdrU(2, 1, 0);                       // count
                LdrU(3, 1, 16);                      // data
                int bad = NL();
                int cont = NL();
                E4(0xEB02001F);                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE3);                      // keep data (guard clobbers x3)
                E4(0xF81F0FE0);                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardListIdx, 3);
                BLExtern("_zan_rt_guard_fail3");
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E3);                      // pop data
                LoadImm(0, 0);
                Mark(cont);
                E4(0xF8607860);                      // ldr x0, [x3, x0, lsl #3]
            } else {
                diags.Error("ngen: unsupported index target", e.line, e.col);
            }
        } else if (k == AK.Assignment()) {
            string tgtTy = AssignTargetTy(e.a);
            GenExpr(e.b);
            if (tgtTy == "double" && !IsDblExpr(e.b)) { ConvI2D(); }
            if (e.a != null && e.a.kind == AK.Ident()) {
                int li = LocalIdx(e.a.sval);
                if (li < 0) {
                    // implicit field store inside instance methods
                    Fld fld = CurField(e.a.sval);
                    if (fld != null) {
                        E4(0xF81F0FE0);                  // str x0, [sp, #-16]! (value)
                        LoadLocal(LocalIdx("this"), 0);  // receiver -> x0
                        E4(0xF84107E1);                  // ldr x1, [sp], #16 (value)
                        StrU(1, 0, fld.off);             // str x1, [x0, #off]
                        return;
                    }
                    // static field store through its data-global slot
                    string ssym = FindStaticSym(curCls, e.a.sval);
                    if (ssym != null) {
                        LoadSymRef(ssym, 9);
                        StrU(0, 9, 0);
                        return;
                    }
                    diags.Error("ngen: unknown identifier '" + e.a.sval + "'", e.line, e.col);
                    return;
                }
                StoreLocal(li, 0);
            } else if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null) {
                // array element set: same bounds rule as the get; the value
                // and index survive the guard call on the stack
                int esz = ArrElemSize(ArrContainerTy(e.a.a));
                E4(0xF81F0FE0);                      // push value
                GenExpr(e.a.a);
                E4(0xF81F0FE0);                      // push arr
                GenExpr(e.a.b);                      // x0 = idx
                E4(0xF84107E1);                      // pop arr -> x1
                E4(0xF84107E2);                      // pop value -> x2
                E4(0xF85F0023);                      // ldur x3, [x1, #-16] (len)
                int bad = NL();
                int cont = NL();
                E4(0xEB03001F);                      // cmp x0, x3
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE1);                      // keep arr (guard clobbers x1)
                E4(0xF81F0FE0);                      // keep idx
                E4(0xF81F0FE2);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLExtern("_zan_rt_guard_fail3");
                E4(0xF84107E2);                      // pop value
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E1);                      // pop arr
                LoadImm(0, 0);
                Mark(cont);
                if (esz == 4) {
                    E4(0xB8207822);                  // str w2, [x1, x0, lsl #2]
                } else {
                    E4(0xF8207822);                  // str x2, [x1, x0, lsl #3]
                }
            } else if (e.a != null && e.a.kind == AK.Index() && ExprCls(e.a.a) == "List") {
                // element set: bounds check like the get, then store into
                // the 8-byte slot (value preserved across the guard call)
                E4(0xF81F0FE0);                      // push value
                GenExpr(e.a.a);
                E4(0xF81F0FE0);                      // push obj
                GenExpr(e.a.b);                      // x0 = idx
                E4(0xF84107E1);                      // pop obj -> x1
                E4(0xF84107E2);                      // pop value -> x2
                LdrU(3, 1, 0);                       // count
                LdrU(4, 1, 16);                      // data
                int bad = NL();
                int cont = NL();
                E4(0xEB03001F);                      // cmp x0, x3
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE4);                      // keep data (guard clobbers x4)
                E4(0xF81F0FE0);                      // keep idx
                E4(0xF81F0FE2);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardListIdx, 3);
                BLExtern("_zan_rt_guard_fail3");
                E4(0xF84107E2);                      // pop value
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E4);                      // pop data
                LoadImm(0, 0);
                Mark(cont);
                E4(0xF8207882);                      // str x2, [x4, x0, lsl #3]
            } else if (e.a != null && e.a.kind == AK.MemberAccess()) {
                // class-qualified static write: Program.starting = v
                // (the value was already evaluated into x0 at the top)
                if (e.a.a != null && e.a.a.kind == AK.Ident()) {
                    string ssym = FindStaticSym(e.a.a.sval, e.a.sval);
                    if (ssym != null) {
                        E4(0xF81F0FE0);                  // push value across LoadSymRef
                        LoadSymRef(ssym, 1);             // x1 = &slot
                        E4(0xF84107E0);                  // pop value -> x0
                        StrU(0, 1, 0);
                        return;
                    }
                }
                Fld f = FieldOf(e.a);
                if (f == null) {
                    diags.Error("ngen: unknown field '" + e.a.sval + "'", e.line, e.col);
                    return;
                }
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]! (value)
                GenExpr(e.a.a);                          // receiver -> x0
                E4(0xF84107E1);                          // ldr x1, [sp], #16 (value)
                StrU(1, 0, f.off);                       // str x1, [x0, #off]
            } else {
                diags.Error("ngen: unsupported assignment target", e.line, e.col);
            }
        } else if (k == AK.NewExpr()) {
            GenNew(e);
        } else if (k == AK.IsExpr()) {
            GenIs(e);
        } else if (k == AK.AsExpr()) {
            GenAs(e);
        } else if (k == AK.Call()) {
            GenCall(e);
        } else if (k == AK.Conditional()) {
            // c ? a : b -- truthiness is the 0/1 bool convention
            int elseL = NL();
            int endL = NL();
            GenExpr(e.a);
            EmitCBZ(0, elseL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(elseL);
            GenExpr(e.c);
            Mark(endL);
        } else if (k == AK.PostfixUnary()) {
            // x++ / x--: yield the old value, then store old ± 1
            Node tgt = e.a;
            if (tgt != null && tgt.kind == AK.Ident()) {
                int li = LocalIdx(tgt.sval);
                if (li >= 0) {
                    LoadLocal(li, 0);
                    E4(0xF81F0FE0);                      // push old
                    if (e.op == TK.PlusPlus()) { AddImm(0, 0, 1); } else { SubImm(0, 0, 1); }
                    StoreLocal(li, 0);
                    E4(0xF84107E0);                      // pop old -> x0
                } else {
                    Fld fld = CurField(tgt.sval);
                    if (fld != null) {
                        LoadLocal(LocalIdx("this"), 0);  // receiver -> x0
                        LdrU(0, 0, fld.off);             // old value
                        E4(0xF81F0FE0);                  // push old
                        if (e.op == TK.PlusPlus()) { AddImm(0, 0, 1); } else { SubImm(0, 0, 1); }
                        StrU(0, 0, fld.off);             // store new
                        E4(0xF84107E0);                  // pop old -> x0
                    } else {
                        diags.Error("ngen: unsupported ++/-- target", e.line, e.col);
                        LoadImm(0, 0);
                    }
                }
            } else {
                diags.Error("ngen: unsupported ++/-- target", e.line, e.col);
                LoadImm(0, 0);
            }
        } else {
            diags.Error("ngen: unsupported expression kind " + k, e.line, e.col);
        }
    }

    void GenNew(Node e) {
        string cls = e.type != null ? e.type.sval : null;
        if (cls == "List") { GenListNew(); return; }
        if (e.ival == 1) {
            if (e.kids.Count > 0) {
                // array initializer: `new T[] { a, b, c }` (an explicit size,
                // if any, must equal the element count)
                GenArrInit(e, ArrElemSize(TypeFullName(e.type) + "[]"));
                return;
            }
            GenArrNew(e.b, ArrElemSize(TypeFullName(e.type) + "[]"));
            return;
        }
        Cls c = cls != null ? FindClass(cls) : null;
        if (c == null) {
            diags.Error("ngen: unknown class in 'new' expression", e.line, e.col);
            LoadImm(0, 0);
            return;
        }
        // allocate: x0 = size + 16 (header), x1 = descriptor (0: no dtor)
        LoadImm(0, c.size + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        // stamp the runtime class site into the upper half of obj-8 (the
        // descriptor slot, 0 for plain news) so `x is T` can identify the
        // object's class later
        RtLdur(1, 0, -8);                                // ldur x1, [x0, #-8]
        E4((int)(0xD2C00000 | (((long)c.site) << 5) | 2)); // movz x2, #site, lsl #32
        E4(0xAA020021);                                  // orr x1, x1, x2
        RtStur(1, 0, -8);                                // stur x1, [x0, #-8]
        if (c.poly == 1) {
            // polymorphic: stamp the class's (lazily built) vtable at obj+0
            E4(0xF81F0FE0);                              // push obj
            LoadSymRef(DGlobalSym("vt." + cls), 9);      // x9 = &slot
            LdrU(1, 9, 0);                               // x1 = table (0 before init)
            int vtDone = NL();
            CbnzReg(1, vtDone);
            BLInternal("_vtinit_" + cls);                // x0 = table
            MovRR(1, 0);                                 // x1 = table
            Mark(vtDone);
            E4(0xF84107E0);                              // pop obj -> x0
            StrU(1, 0, 0);                               // obj->vptr = table
        }
        E4(0xF81F0FE0);                                  // str x0, [sp, #-16]! (obj)
        // ctor arguments: for a brace object initializer (`new C(a) { X = v }`)
        // the first e.op kids are the paren args and the rest are field
        // initializers; otherwise every kid is an argument. Provided args
        // first, trailing defaults filled in; a class without any ctor
        // allocates bare (no call).
        Node callN = e;
        if (e.ival == 2) {
            Node tmp = new Node(AK.Call());
            tmp.line = e.line;
            tmp.col = e.col;
            int ai = 0;
            while (ai < e.op && ai < e.kids.Count) { tmp.Add(e.kids[ai]); ai = ai + 1; }
            callN = tmp;
        }
        int cix = FitCtorIdx(cls, callN, false, null);
        int pushed;
        if (cix >= 0) {
            pushed = PushCallArgs(methNodes[cix], callN);
        } else if (CtorCountNg(cls) > 0) {
            diags.Error("ngen: no constructor of '" + cls + "' takes "
                + callN.kids.Count + " argument(s)", e.line, e.col);
            return;
        } else {
            pushed = 0;
        }
        int r = pushed;
        while (r >= 1) { E4(0xF84107E0 | r); r = r - 1; } // ldr xr, [sp], #16 (args reversed)
        E4(0xF84107E0);                                  // ldr x0, [sp], #16 (obj)
        E4(0xF81F0FE0);                                  // str x0, [sp, #-16]! (keep obj across the void ctor)
        if (cix >= 0) {
            BLInternal(CtorSymNg(cls, methNodes[cix]));
        }
        // field initializers store through the object still on the stack
        if (e.ival == 2) {
            int bi = e.op;
            while (bi < e.kids.Count) {
                Node it = e.kids[bi];
                if (it.kind == AK.Assignment() && it.a != null && it.a.kind == AK.Ident()) {
                    int foff = FieldOff(cls, it.a.sval);
                    if (foff < 0) {
                        diags.Error("ngen: unknown field '" + it.a.sval + "' in initializer", it.line, it.col);
                    } else {
                        GenExpr(it.b);
                        E4(0xF81F0FE0);                  // push value
                        E4(0xF84107E1);                  // pop value -> x1 (top)
                        E4(0xF84107E0);                  // pop obj -> x0
                        StrU(1, 0, foff);                // obj->field = value
                        E4(0xF81F0FE0);                  // push obj back for the next item
                    }
                } else {
                    diags.Error("ngen: unsupported object initializer item", it.line, it.col);
                }
                bi = bi + 1;
            }
        }
        E4(0xF84107E0);                                  // ldr x0, [sp], #16 (obj)
    }

    // `new T[] { a, b, c }`: allocate with the element count, then store each
    // initializer expression at its slot (no bounds check -- the count is
    // static). The array stays on the stack across element evaluation.
    void GenArrInit(Node e, int esz) {
        int n = e.kids.Count;
        Node cnt = new Node(AK.IntLit());
        cnt.ival = n;
        GenArrNew(cnt, esz);
        E4(0xF81F0FE0);                                  // push arr
        int k = 0;
        while (k < n) {
            GenExpr(e.kids[k]);                          // x0 = element value
            E4(0xF84107E1);                              // pop arr -> x1
            E4((int)(0xD2800000 | (((long)k) << 5) | 2)); // movz x2, #k
            if (esz == 4) {
                E4(0xB8227820);                          // str w0, [x1, x2, lsl #2]
            } else {
                E4(0xF8227820);                          // str x0, [x1, x2, lsl #3]
            }
            E4(0xF81F0FE1);                              // push arr back
            k = k + 1;
        }
        E4(0xF84107E0);                                  // pop arr -> x0
    }

    void GenFieldLoad(Node mem) {
        Fld f = FieldOf(mem);
        if (f == null) {
            // qualified static read: ClsName.field
            if (mem.a != null && mem.a.kind == AK.Ident()) {
                string ssym = FindStaticSym(mem.a.sval, mem.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    LdrU(0, 0, 0);
                    return;
                }
            }
            diags.Error("ngen: unknown field '" + mem.sval + "'", mem.line, mem.col);
            LoadImm(0, 0);
            return;
        }
        GenExpr(mem.a);                                  // receiver -> x0
        LdrU(0, 0, f.off);                               // ldr x0, [x0, #off]
    }

    // static type name of an expression when it denotes a user class, else null
    string ExprCls(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.ThisExpr()) { return curCls; }
        if (e.kind == AK.NewExpr()) { return e.type != null ? e.type.sval : null; }
        if (e.kind == AK.CastExpr() && e.type != null) { return ClassTyOf(e.type.sval); }
        if (e.kind == AK.AsExpr() && e.type != null) { return ClassTyOf(e.type.sval); }
        if (e.kind == AK.Index()) { return ClassTyOf(ElemTyOf(e)); }
        if (e.kind == AK.Call() && e.a != null) {
            // method results carry a class identity when the method's
            // declared return type names one (ChartOption.Create().x)
            return ClassTyOf(CallRetTy(e));
        }
        if (e.kind == AK.Ident()) {
            return ClassTyOf(NamedSlotTy(e.sval));
        }
        return null;
    }

    // element type name of an index expression ("l[i]" with l declared as
    // "List<Pt>" or "Pt[]"), or null; struct elements return null too, since
    // gen0 keeps them inline in the container with value semantics -- pointer
    // field access would silently alias
    string ElemTyOf(Node e) {
        if (e == null || e.a == null) { return null; }
        string el = null;
        if (ArrContainerTy(e.a) != null) {
            string at = ArrContainerTy(e.a);
            if (at != null && at.Length > 2) { el = at.Substring(0, at.Length - 2); }
        } else if (ExprCls(e.a) == "List") {
            string ct = StaticTyOf(e.a);
            if (ct != null && ct.Length > 5 && ct.Substring(0, 5) == "List<"
                    && ct.Substring(ct.Length - 1, 1) == ">") {
                el = ct.Substring(5, ct.Length - 6);
            }
        }
        if (el == null) { return null; }
        Cls ec = FindClass(el);
        if (ec != null && ec.isStruct == 1) { return null; }
        return el;
    }

    // normalize a declared type name to its class identity ("List<string>"
    // behaves as its open type; primitive arrays carry none), else null
    string ClassTyOf(string t) {
        if (t == null || t == "" || t == "int" || t == "string" || t == "bool"
                || t == "void" || t == "char" || t == "double" || t == "long"
                || t == "ulong") { return null; }
        if (t.Length > 5 && t.Substring(0, 5) == "List<") { return "List"; }
        if (IsArrTy(t) && (t == "int[]" || t == "long[]" || t == "ulong[]"
                || t == "double[]" || t == "string[]" || t == "bool[]"
                || t == "char[]")) { return null; }
        return t;
    }

    // x is T / x is null. With single inheritance the receiver's static type
    // decides statically whenever the target is equal to or a base of it
    // (any instance of the receiver is then also a T, so only null fails).
    // When the receiver's type is a strict base of T the object's runtime
    // class has to be consulted via the site stamped by 'new'; unrelated
    // static types answer false, like gen0.
    void GenIs(Node e) {
        if (e.type == null) {                            // `x is null`
            GenExpr(e.a);
            E4(0xEB1F001F);                              // cmp x0, xzr
            E4(0x9A9F17E0);                              // cset x0, eq
            return;
        }
        string tt = e.type.sval;
        string st = StaticTyOf(e.a);
        Cls tc = FindClass(tt);
        if (tc == null) {
            // non-class target: strings and value types are decided by the
            // static types alone
            if (tt == "string" && st == "string") {
                GenExpr(e.a);
                E4(0xEB1F001F);                          // cmp x0, xzr
                E4(0x9A9F07E0);                          // cset x0, ne
            } else if (st != null && st == tt) {
                LoadImm(0, 1);                           // same value type: always
            } else {
                LoadImm(0, 0);
            }
            return;
        }
        string sc = ClassTyOf(st);
        if (sc == null) {
            // a string can never hold a class instance; anything else with
            // no class identity cannot either
            LoadImm(0, 0);
            return;
        }
        GenExpr(e.a);                                    // x0 = receiver
        if (st == "object") {
            // object-typed source: identity is unknown statically, always
            // consult the runtime site (gen0 rule)
            GenIsSite(tc);
            return;
        }
        if (sc == tt || DerivesFrom(sc, tt)) {
            E4(0xEB1F001F);                              // cmp x0, xzr
            E4(0x9A9F07E0);                              // cset x0, ne
            return;
        }
        if (DerivesFrom(tt, sc)) {
            GenIsSite(tc);
            return;
        }
        LoadImm(0, 0);
    }

    // x as T -- like gen0: upcasts/identity, unrelated static types and
    // non-class targets pass the value through; a downcast consults the
    // runtime class site and yields null on failure
    void GenAs(Node e) {
        string tt = e.type != null ? e.type.sval : null;
        string st = StaticTyOf(e.a);
        Cls tc = tt != null ? FindClass(tt) : null;
        if (tt == null || tc == null || st == null) { GenExpr(e.a); return; }
        string sc = ClassTyOf(st);
        if (sc == null) { GenExpr(e.a); return; }
        if (st != "object") {
            if (sc == tt || DerivesFrom(sc, tt)) { GenExpr(e.a); return; }
            if (!DerivesFrom(tt, sc)) { GenExpr(e.a); return; }
        }
        // downcast: keep the value on the stack across the site test
        GenExpr(e.a);
        E4(0xF81F0FE0);                                  // push v
        LdrU(0, 31, 0);                                  // x0 = v
        GenIsSite(tc);                                   // x0 = 0/1
        int failL = NL();
        int endL = NL();
        CbzReg(0, failL);
        E4(0xF84107E0);                                  // pop v -> x0
        EmitB(endL);
        Mark(failL);
        E4(0xF84107E0);                                  // pop v (discard)
        LoadImm(0, 0);                                   // null
        Mark(endL);
    }

    // runtime site check for `x is T` with the object in x0: extract the
    // site from obj-8's upper half and compare against T's site set (T and
    // every class deriving from it)
    void GenIsSite(Cls c) {
        int zeroL = NL();
        int foundL = NL();
        int endL = NL();
        CbzReg(0, zeroL);                                // null -> false
        RtLdur(1, 0, -8);                                // ldur x1, [x0, #-8]
        E4(0xD360FC21);                                  // lsr x1, x1, #32 (site)
        int i = 0;
        while (i < classes.Count) {
            Cls cc = classes[i];
            if (cc.site > 0 && DerivesFrom(cc.name, c.name)) {
                LoadImm(2, cc.site);
                E4(0xEB02003F);                          // cmp x1, x2
                EmitBcond(0, foundL);                    // b.eq
            }
            i = i + 1;
        }
        Mark(zeroL);
        LoadImm(0, 0);
        EmitB(endL);
        Mark(foundL);
        LoadImm(0, 1);
        Mark(endL);
    }

    // declared static type name of an expression (before class identity
    // normalization), or null when nothing is known
    string StaticTyOf(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.ThisExpr()) { return curCls; }
        if (e.kind == AK.NewExpr()) {
            if (e.type == null) { return null; }
            if (e.ival != 1) { return TypeFullName(e.type); }
            return TypeFullName(e.type) + ArrSuffix(1 + e.op);
        }
        if (e.kind == AK.CastExpr() && e.type != null) { return e.type.sval; }
        if (e.kind == AK.AsExpr() && e.type != null) { return e.type.sval; }
        if (e.kind == AK.Ident()) { return NamedSlotTy(e.sval); }
        if (e.kind == AK.Call()) { return CallRetTy(e); }
        if (e.kind == AK.MemberAccess()) {
            // EnumType.Member constants carry their enum identity
            if (e.a != null && e.a.kind == AK.Ident() && FindEnum(e.a.sval) >= 0) { return e.a.sval; }
            Fld f = FieldOf(e);
            return f != null ? f.ty : null;
        }
        if (e.kind == AK.Index()) { return ElemTyOf(e); }
        return null;
    }

    // ---- enums ----
    void CollectEnums(Node unit) {
        enName = new List<string>();
        enOff = new List<int>();
        enCnt = new List<int>();
        enMem = new List<string>();
        enVal = new List<long>();
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.EnumDecl()) {
                enName.Add(dcl.sval);
                enOff.Add(enMem.Count);
                int cnt = 0;
                long val = 0;
                int k = 0;
                while (k < dcl.kids.Count) {
                    Node m = dcl.kids[k];
                    if (m.sval != null && m.sval != "") {
                        // an explicit `= n` (int literal, possibly negated)
                        // resets the running counter, like gen0's fold
                        if (m.a != null && m.a.kind == AK.IntLit()) { val = m.a.ival; }
                        else if (m.a != null && m.a.kind == AK.Unary()
                                && m.a.op == TK.Minus() && m.a.a != null
                                && m.a.a.kind == AK.IntLit()) { val = -m.a.a.ival; }
                        enMem.Add(m.sval);
                        enVal.Add(val);
                        cnt = cnt + 1;
                        val = val + 1;
                    }
                    k = k + 1;
                }
                enCnt.Add(cnt);
            }
            i = i + 1;
        }
    }

    int FindEnum(string n) {
        int i = 0;
        while (i < enName.Count) { if (enName[i] == n) { return i; } i = i + 1; }
        return -1;
    }

    // flat index of member `mem` of enum `en`, or -1
    int FindEnumMemIdx(string en, string mem) {
        int ei = FindEnum(en);
        if (ei < 0) { return -1; }
        int i = 0;
        while (i < enCnt[ei]) {
            if (enMem[enOff[ei] + i] == mem) { return enOff[ei] + i; }
            i = i + 1;
        }
        return -1;
    }

    // the enum type an expression's static type names, or null
    string EnumTyOf(Node e) {
        if (e == null) { return null; }
        string t = StaticTyOf(e);
        if (t != null && FindEnum(t) >= 0) { return t; }
        return null;
    }

    // enum x.ToString(): the name of the first member whose constant equals
    // the value (declaration order wins duplicates, like gen0); an unmatched
    // value formats as its number
    void GenEnumToString(Node recv, string et) {
        int ei = FindEnum(et);
        GenExpr(recv);
        E4(0xF81F0FE0);                                  // push v
        int numL = NL();
        int joinL = NL();
        int cnt = enCnt[ei];
        int[] hits = new int[cnt];
        int i = 0;
        while (i < cnt) {
            hits[i] = NL();
            LdrU(1, 31, 0);                              // x1 = [sp] (peek v)
            LoadImm(2, enVal[enOff[ei] + i]);
            E4(0xEB02003F);                              // cmp x1, x2
            EmitBcond(0, hits[i]);                       // b.eq
            i = i + 1;
        }
        E4(0xF84107E0);                                  // pop v -> x0
        BLInternal("_zan_rt_int2str");                   // numeric fallback
        EmitB(joinL);
        i = 0;
        while (i < cnt) {
            Mark(hits[i]);
            E4(0xF84107E0);                              // pop v (discard)
            LoadStr(InternStr(enMem[enOff[ei] + i]), 0);
            EmitB(joinL);
            i = i + 1;
        }
        Mark(joinL);
    }

    // true when sub's base chain reaches anc (equal counts)
    bool DerivesFrom(string sub, string anc) {
        if (sub == null || anc == null) { return false; }
        string cur = sub;
        while (cur != null) {
            if (cur == anc) { return true; }
            Cls cc = FindClass(cur);
            if (cc == null) { return false; }
            cur = cc.baseName;
        }
        return false;
    }

    // declared type of a local, field or static of that name (locals shadow
    // fields shadow statics, matching the binder's lookup order)
    string NamedSlotTy(string name) {
        int li = LocalIdx(name);
        if (li >= 0) { return locTy[li]; }
        Fld f = CurField(name);
        if (f != null) { return f.ty; }
        return FindStaticTy(curCls, name);
    }

    // full type name including one generic argument ("List<string>")
    string TypeFullName(Node t) {
        if (t == null) { return ""; }
        string n = t.sval;
        if (t.kids != null && t.kids.Count > 0 && t.kids[0] != null
                && t.kids[0].sval != null && t.kids[0].sval != "") {
            n = n + "<" + t.kids[0].sval + ">";
        }
        n = n + ArrSuffix(t.ival);                       // array levels
        return n;
    }

    // array-type helpers ("int[]" style declared types)
    bool IsArrTy(string t) {
        if (t == null || t.Length < 2) { return false; }
        return t.Substring(t.Length - 2, 2) == "[]";
    }
    bool IsArrExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return IsArrTy(locTy[li]); }
            Fld f = CurField(e.sval);
            return f != null && IsArrTy(f.ty);
        }
        if (e.kind == AK.NewExpr()) {
            return e.ival == 1;
        }
        return false;
    }
    // n copies of the array suffix ("[][]" for 2)
    string ArrSuffix(int n2) {
        string s2 = "";
        int i = 0;
        while (i < n2) { s2 = s2 + "[]"; i = i + 1; }
        return s2;
    }

    string ArrTyOf(Node e) {
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && IsArrTy(locTy[li])) { return locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            return "int[]";
        }
        if (e.kind == AK.NewExpr() && e.type != null && e.ival == 1) {
            return TypeFullName(e.type) + ArrSuffix(1 + e.op);
        }
        return "int[]";
    }

    // declared array type of an expression usable as an element container:
    // a local, an instance field (implicit this or through a receiver), a
    // static field (of the current class or class-qualified), `new T[]`,
    // a cast/as to an array type, a nested element read of an
    // array-of-arrays, or a call returning an array. Unlike ArrTyOf this
    // never guesses -- null means "not a known array".
    string ArrContainerTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && IsArrTy(locTy[li])) { return locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            string st = FindStaticTy(curCls, e.sval);
            if (st != null && IsArrTy(st)) { return st; }
            return null;
        }
        if (e.kind == AK.NewExpr() && e.type != null && e.ival == 1) {
            return TypeFullName(e.type) + ArrSuffix(1 + e.op);
        }
        if (e.kind == AK.CastExpr() && e.type != null) {
            string ct = TypeFullName(e.type);
            if (IsArrTy(ct)) { return ct; }
            return null;
        }
        if (e.kind == AK.AsExpr() && e.type != null) {
            string at2 = TypeFullName(e.type);
            if (IsArrTy(at2)) { return at2; }
            return null;
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            if (e.a != null && e.a.kind == AK.Ident() && FindClass(e.a.sval) != null) {
                string st = FindStaticTy(e.a.sval, e.sval);
                if (st != null && IsArrTy(st)) { return st; }
            }
            return null;
        }
        if (e.kind == AK.Index()) {
            string et = ElemTyOf(e);
            if (et != null && IsArrTy(et)) { return et; }
            return null;
        }
        if (e.kind == AK.Call()) {
            string rt = CallRetTy(e);
            if (IsArrTy(rt)) { return rt; }
            return null;
        }
        return null;
    }
    int ArrElemSize(string t) {
        string el = t.Substring(0, t.Length - 2);
        if (el == "int") { return 4; }
        return 8;
    }

    Fld FieldOf(Node mem) {
        string cls = ExprCls(mem.a);
        if (cls == null) { return null; }
        Cls c = FindClass(cls);
        if (c == null) { return null; }
        return FindField(c, mem.sval);
    }

    // field of the class being emitted (implicit `this` references)
    Fld CurField(string name) {
        return FindField(FindClass(curCls), name);
    }

    // does this expression evaluate to a string? (local type / field type /
    // string literal / concatenation / method with a string return type)
    bool IsStrExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.StringLit()) { return true; }
        if (e.kind == AK.Binary()) { return e.op == TK.Plus() && (IsStrExpr(e.a) || IsStrExpr(e.b)); }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && f.ty == "string";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "string"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "string") { return true; }
            return FindStaticTy(curCls, e.sval) == "string";
        }
        if (e.kind == AK.Call() && e.a != null) {
            if (e.a.kind == AK.MemberAccess()) {
                // string.Join(sep, List<string>) yields a heap string;
                // Substring too; any other member call falls through to
                // the user-method return type below
                if (e.a.sval == "Substring") { return true; }
                Node rj = e.a.a;
                if (rj != null && rj.kind == AK.Ident() && rj.sval == "string" && e.a.sval == "Join") { return true; }
                // Convert.ToString(x) yields a heap string
                if (rj != null && rj.kind == AK.Ident() && rj.sval == "Convert"
                        && e.a.sval == "ToString" && e.kids.Count == 1) { return true; }
            }
            return CallRetTy(e) == "string";
        }
        // List<string> element reads yield heap strings (string indexing
        // yields a char codepoint -- see IsCharExpr, not a string)
        if (e.kind == AK.Index()) { return IsStrListOf(e.a); }
        return false;
    }

    // does this expression denote a List<string> (element reads are strings)?
    bool IsStrListOf(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "List<string>" || locTy[li] == "string[]"; }
            Fld f = CurField(e.sval);
            return f != null && (f.ty == "List<string>" || f.ty == "string[]");
        }
        if (e.kind == AK.NewExpr()) {
            return e.type != null
                && (TypeFullName(e.type) == "List<string>"
                    || (e.ival == 1 && TypeFullName(e.type) + "[]" == "string[]"));
        }
        return false;
    }

    // does this expression evaluate to a double? (float literal / double
    // typed local or field / double-returning method / double arithmetic)
    bool IsDblExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.FloatLit()) { return true; }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star() || op == TK.Slash()) {
                return IsDblExpr(e.a) || IsDblExpr(e.b);
            }
            return false;
        }
        if (e.kind == AK.CastExpr() && e.type != null) { return e.type.sval == "double"; }
        if (e.kind == AK.Index()) { return IsArrExpr(e.a) && ArrTyOf(e.a) == "double[]"; }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && f.ty == "double";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "double"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "double") { return true; }
            return FindStaticTy(curCls, e.sval) == "double";
        }
        if (e.kind == AK.Call() && e.a != null) {
            if (e.a.kind == AK.MemberAccess()) {
                Node rm = e.a.a;
                // Convert.ToDouble(x) is always double (gen0 lowerings)
                if (rm != null && rm.kind == AK.Ident() && rm.sval == "Convert"
                        && e.a.sval == "ToDouble" && e.kids.Count == 1) { return true; }
                // double.Parse(s) is always double
                if (rm != null && rm.kind == AK.Ident() && e.a.sval == "Parse"
                        && e.kids.Count == 1
                        && (rm.sval == "double" || rm.sval == "float"
                            || rm.sval == "Double" || rm.sval == "Single")) { return true; }
                // Math library calls: Sqrt/Floor/Ceiling/Pow/Sin/Cos/Tan/
                // Log/Exp/Round are always double; Abs/Max/Min are double
                // when any argument is
                if (rm != null && rm.kind == AK.Ident() && rm.sval == "Math") {
                    string mn = e.a.sval;
                    if (mn == "Sqrt" || mn == "Floor" || mn == "Ceiling" || mn == "Pow"
                            || mn == "Sin" || mn == "Cos" || mn == "Tan"
                            || mn == "Log" || mn == "Exp" || mn == "Round") { return true; }
                    if (mn == "Abs" && e.kids.Count == 1) { return IsDblExpr(e.kids[0]); }
                    if ((mn == "Max" || mn == "Min") && e.kids.Count == 2) {
                        return IsDblExpr(e.kids[0]) || IsDblExpr(e.kids[1]);
                    }
                }
            }
            return CallRetTy(e) == "double";
        }
        return false;
    }

    // does this expression evaluate to a char? (char literals, string
    // indexing, char-typed locals/fields/statics -- rendering goes through
    // zan_rt_chrstr)
    bool IsCharExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.CharLit()) { return true; }
        if (e.kind == AK.Index()) { return IsStrExpr(e.a); }
        if (e.kind == AK.CastExpr() && e.type != null) { return e.type.sval == "char"; }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && f.ty == "char";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "char"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "char") { return true; }
            return FindStaticTy(curCls, e.sval) == "char";
        }
        return false;
    }

    // does this expression evaluate to a ulong? (ulong typed locals,
    // fields and method results; arithmetic carrying a ulong operand --
    // ulong is the only integer type whose slot can set the high bit)
    bool IsUlongExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.IntLit()) {
            // a UL/lu-suffixed literal types as ulong (gen0's checker)
            return e.suffix - (e.suffix / 4) * 4 == 3;
        }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star()
                    || op == TK.Slash() || op == TK.Percent()
                    || op == TK.LessLess() || op == TK.GreaterGreater()) {
                return IsUlongExpr(e.a) || IsUlongExpr(e.b);
            }
            return false;
        }
        if (e.kind == AK.CastExpr() && e.type != null) {
            return e.type.sval == "ulong" && !IsDblExpr(e.b);
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && f.ty == "ulong";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "ulong"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "ulong") { return true; }
            return FindStaticTy(curCls, e.sval) == "ulong";
        }
        if (e.kind == AK.Call() && e.a != null) {
            return CallRetTy(e) == "ulong";
        }
        return false;
    }

    // does this expression evaluate to a bool? (comparisons / bool locals,
    // fields and method results -- WriteLine renders those true/false)
    bool IsBoolExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.BoolLit()) { return true; }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            return op == TK.Less() || op == TK.Greater() || op == TK.LessEq()
                || op == TK.GreaterEq() || op == TK.EqEq() || op == TK.BangEq()
                || op == TK.AmpAmp() || op == TK.PipePipe();
        }
        if (e.kind == AK.Unary()) { return e.op == TK.Bang(); }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && f.ty == "bool";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "bool"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "bool") { return true; }
            return FindStaticTy(curCls, e.sval) == "bool";
        }
        if (e.kind == AK.Call() && e.a != null) {
            return CallRetTy(e) == "bool";
        }
        return false;
    }

    string MethRetTy(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            // TypeFullName keeps the array suffix and generic argument;
            // type.sval alone would turn a `byte[]` return into "byte"
            if (methNodes[i].sval == name && methNodes[i].type != null) { return TypeFullName(methNodes[i].type); }
            i = i + 1;
        }
        return "";
    }

    // declared return type of a call with the receiver's type arguments
    // substituted for the declaring class's type parameters: with
    // `Box<string> b`, `b.At(i)` reads as `string`, not the bare `T`
    // (gen0 instantiates generics; ngen substitutes textually). Falls
    // back to the raw declared type whenever either side is unknown.
    string CallRetTy(Node e) {
        string rty = MethRetTy(e.a != null ? e.a.sval : null);
        if (rty == null || rty == "") { return rty; }
        if (e.a == null || e.a.kind != AK.MemberAccess() || e.a.a == null) { return rty; }
        string recv = StaticTyOf(e.a.a);
        if (recv == null) { return rty; }
        int lt = recv.IndexOf("<");
        if (lt <= 0 || recv.Substring(recv.Length - 1, 1) != ">") { return rty; }
        Cls rc = FindClass(recv.Substring(0, lt));
        if (rc == null || rc.tps.Count == 0) { return rty; }
        List<string> targs = SplitTyArgs(recv.Substring(lt + 1, recv.Length - lt - 2));
        return SubstTy(rty, rc.tps, targs);
    }

    // top-level comma split of a generic argument list ("Node, Box<Node>")
    List<string> SplitTyArgs(string s) {
        List<string> parts = new List<string>();
        string cur = "";
        int depth = 0;
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "<") { depth = depth + 1; }
            else if (ch == ">") { depth = depth - 1; }
            if (ch == "," && depth == 0) { parts.Add(cur); cur = ""; }
            else { cur = cur + ch; }
            i = i + 1;
        }
        if (cur != "") { parts.Add(cur); }
        return parts;
    }

    // rewrite type-parameter names inside a declared type string: bare
    // `T`, `T[]` and `Head<A, T>` forms all substitute
    string SubstTy(string t, List<string> ps, List<string> as2) {
        if (t == null || t == "") { return t; }
        if (IsArrTy(t)) { return SubstTy(t.Substring(0, t.Length - 2), ps, as2) + "[]"; }
        int lt = t.IndexOf("<");
        if (lt > 0 && t.Substring(t.Length - 1, 1) == ">") {
            string head = t.Substring(0, lt);
            List<string> kids = SplitTyArgs(t.Substring(lt + 1, t.Length - lt - 2));
            string res = SubstTy(head, ps, as2) + "<";
            int i = 0;
            while (i < kids.Count) {
                if (i > 0) { res = res + ","; }
                res = res + SubstTy(kids[i], ps, as2);
                i = i + 1;
            }
            return res + ">";
        }
        int pi = IndexOfStrNg(ps, t);
        if (pi >= 0) { return as2[pi]; }
        return t;
    }

    void GenCall(Node e) {
        Node callee = e.a;
        if (callee != null && callee.kind == AK.MemberAccess()) {
            Node recv = callee.a;
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "WriteLine" && e.kids.Count == 1) {
                // own runtime core: print_int(i64) / println(str)
                if (IsStrExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_println");
                } else if (IsCharExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_chrstr");
                    BLInternal("_zan_rt_println");
                } else if (IsBoolExpr(e.kids[0])) {
                    // gen0 prints bools as true/false (select of literals)
                    GenExpr(e.kids[0]);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                    BLInternal("_zan_rt_println");
                } else if (IsDblExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    E4(0x9E670000);                      // fmov d0, x0
                    BLExtern("_zan_rt_print_double");
                } else if (IsUlongExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_uint");
                } else {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_int");
                }
                return;
            }
            // Console.WriteLine() with no arguments prints just the newline
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "WriteLine" && e.kids.Count == 0) {
                LoadStr(InternStr(""), 0);
                BLInternal("_zan_rt_println");
                return;
            }
            // Console.Write: no newline; gen0 routes every argument type
            // through its string form and printf("%s", s)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "Write" && e.kids.Count == 1) {
                Node arg = e.kids[0];
                if (IsStrExpr(arg)) { GenExpr(arg); }
                else if (IsCharExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_chrstr");
                } else if (IsBoolExpr(arg)) {
                    GenExpr(arg);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                } else if (IsDblExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_dbl2str");
                } else if (IsUlongExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_uint2str");
                } else {
                    GenExpr(arg); BLInternal("_zan_rt_int2str");
                }
                E4(0xF81F0FE0);                      // push s (stack variadic)
                LoadSymRef("l_.str." + fmtwIdx, 0);  // x0 = "%s"
                BLExtern("_printf");
                AddSPImm(16, true);
                return;
            }
            // Math static methods. Integer forms: Abs is a negate and
            // Max/Min are a csel over a signed compare (gen0 lowers them
            // the same way for i64). Double forms call libm with the value
            // in d0 (Pow takes d0 + d1) and come back as the bit pattern
            // in x0.
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Math") {
                string mn = callee.sval;
                if (mn == "Abs" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    if (IsDblExpr(e.kids[0])) {
                        DblLibm1("_fabs");
                    } else {
                        E4(0xCB0003E0);                  // neg x0, x0
                    }
                    return;
                }
                if ((mn == "Max" || mn == "Min") && e.kids.Count == 2) {
                    if (IsDblExpr(e.kids[0]) || IsDblExpr(e.kids[1])) {
                        // both arguments move to d0/d1 only after BOTH are
                        // evaluated: GenExpr may call strtod (returning in
                        // d0) for lazy double literals, which would clobber
                        // a value parked in d0 early
                        GenExpr(e.kids[0]);
                        E4(0xF81F0FE0);                  // push a
                        GenExpr(e.kids[1]);
                        E4(0xF84107E1);                  // pop a -> x1 (x0 = b)
                        E4(0x9E670001);                  // fmov d1, x0
                        E4(0xAA0103E0);                  // mov x0, x1
                        E4(0x9E670000);                  // fmov d0, x0
                        if (mn == "Max") { BLExtern("_fmax"); } else { BLExtern("_fmin"); }
                        E4(0x9E660000);                  // fmov x0, d0
                    } else {
                        GenExpr(e.kids[0]);
                        E4(0xF81F0FE0);                  // push a
                        GenExpr(e.kids[1]);
                        E4(0xF84107E1);                  // pop a -> x1 (x0 = b)
                        E4(0xEB01001F);                  // cmp x0, x1
                        if (mn == "Max") { E4(0x9A81C000); } // csel x0, x0, x1, gt
                        else { E4(0x9A81B000); }             // csel x0, x0, x1, lt
                    }
                    return;
                }
                if (mn == "Sqrt" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_sqrt");
                    return;
                }
                if (mn == "Floor" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_floor");
                    return;
                }
                if (mn == "Ceiling" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_ceil");
                    return;
                }
                // gen0 routes Sin/Cos/Tan/Log/Exp to libm (double -> double),
                // coercing integer arguments with sitofp
                if ((mn == "Sin" || mn == "Cos" || mn == "Tan" || mn == "Log" || mn == "Exp")
                        && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        E4(0x9E620000);                  // scvtf d0, x0
                        E4(0x9E660000);                  // fmov x0, d0
                    }
                    string lf = "_sin";
                    if (mn == "Cos") { lf = "_cos"; } else if (mn == "Tan") { lf = "_tan"; }
                    else if (mn == "Log") { lf = "_log"; } else if (mn == "Exp") { lf = "_exp"; }
                    DblLibm1(lf);
                    return;
                }
                // Math.Round(x[, digits]): round(x * 10^d) / 10^d via libm
                // round/pow (integer arguments coerce with sitofp, like gen0).
                // No value may sit in a d-reg across a GenExpr call (lazy
                // double literals return theirs in d0), so both operands are
                // spilled first; the scale lives in callee-saved x19 across
                // the round call since the divide needs it again (x is the
                // deepest stack slot, so a second spill copy would bury it).
                if (mn == "Round" && (e.kids.Count == 1 || e.kids.Count == 2)) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        E4(0x9E620000);                  // scvtf d0, x0
                        E4(0x9E660000);                  // fmov x0, d0
                    }
                    if (e.kids.Count == 1) {
                        DblLibm1("_round");
                        return;
                    }
                    E4(0xF81F0FE0);                      // push x (bits)
                    GenExpr(e.kids[1]);
                    if (!IsDblExpr(e.kids[1])) {
                        E4(0x9E620000);                  // scvtf d0, x0
                        E4(0x9E660000);                  // fmov x0, d0
                    }
                    E4(0xF81F0FE0);                      // push digits (bits)
                    LoadImm(0, 4621819117588971520);     // 10.0 IEEE bits
                    E4(0xF84107E1);                      // pop digits -> x1 (x0 = 10.0)
                    E4(0x9E670000);                      // fmov d0, x0
                    E4(0x9E670021);                      // fmov d1, x1
                    BLExtern("_pow");
                    E4(0x9E660000);                      // fmov x0, d0 (scale)
                    MovRR(19, 0);                        // x19 = scale (call-preserved)
                    E4(0xF84107E0);                      // pop x -> x0
                    E4(0x9E670000);                      // fmov d0, x0 (d0 = x)
                    E4(0x9E670261);                      // fmov d1, x19 (d1 = scale)
                    E4(0x1E600820);                      // fmul d0, d1, d0 (x * scale)
                    E4(0x9E660000);                      // fmov x0, d0
                    DblLibm1("_round");                  // round(x * scale)
                    E4(0x9E670000);                      // fmov d0, x0 (rounded)
                    E4(0x9E670261);                      // fmov d1, x19 (scale)
                    E4(0x1E611800);                      // fdiv d0, d0, d1
                    E4(0x9E660000);                      // fmov x0, d0
                    return;
                }
                if (mn == "Pow" && e.kids.Count == 2) {
                    // same ordering discipline as the double Max/Min path:
                    // no value may sit in d0 across a GenExpr call
                    GenExpr(e.kids[0]);
                    E4(0xF81F0FE0);                      // push a
                    GenExpr(e.kids[1]);
                    E4(0xF84107E1);                      // pop a -> x1 (x0 = b)
                    E4(0x9E670001);                      // fmov d1, x0
                    E4(0xAA0103E0);                      // mov x0, x1
                    E4(0x9E670000);                      // fmov d0, x0
                    BLExtern("_pow");
                    E4(0x9E660000);                      // fmov x0, d0
                    return;
                }
            }
            // string.Join(sep, List<string>): gen0 runs two passes over the
            // list -- one strlen pass for the total size, one copy pass --
            // and mirrors that here (joining a string[] crashes gen0's own
            // runtime, so the List form is the only shape to match).
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "string"
                    && callee.sval == "Join" && e.kids.Count == 2) {
                GenExpr(e.kids[1]);                      // list
                E4(0xF81F0FE0);                          // push list
                GenExpr(e.kids[0]);                      // sep
                E4(0xF84107E1);                          // pop list -> x1 (x0 = sep)
                BLInternal("_zan_rt_strjoin");
                return;
            }
            // Console.ReadLine: gen0 allocates a 1024-byte string, NUL-
            // terminates it up front, fgets()s into it keeping the trailing
            // newline, and yields the buffer regardless of the fgets result
            // (an EOF reads back as the empty string).
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "ReadLine" && e.kids.Count == 0) {
                LoadImm(0, 1024);
                BLInternal("_zan_rt_str_alloc");         // x0 = buf
                E4(0xF81F0FE0);                          // push buf
                Strb0(0);                                // buf[0] = NUL
                // the Mach-O symbol is the C name plus one underscore
                // (LLVM adds it automatically for @__stdinp)
                LoadSymRefGOT("___stdinp", 2);
                LdrU(2, 2, 0);                           // x2 = stdin
                LdrU(0, 31, 0);                          // x0 = buf
                LoadImm(1, 1024);
                BLExtern("_fgets");
                E4(0xF84107E0);                          // pop buf -> x0
                return;
            }
            // Convert built-ins: gen0 lowers ToString/ToInt32/ToInt64/ToInt/
            // ToDouble with one argument inline (stepping aside per member
            // when the program declares its own Convert member).
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Convert") {
                string mn = callee.sval;
                if (e.kids.Count == 1 && !UserDefinesConvert(mn)) {
                    Node arg = e.kids[0];
                    if (mn == "ToString") {
                        // gen0's ordering: string -> owned copy, char ->
                        // the character, double -> shortest-round-trip
                        // text, ulong unsigned decimal, rest signed
                        if (IsStrExpr(arg)) {
                            GenExpr(arg);
                            E4(0xF81F0FE0);              // push s
                            LoadStr(InternStr(""), 0);   // x0 = ""
                            E4(0xF84107E1);              // pop -> x1 (x0="", x1=s)
                            BLInternal("_zan_rt_strcat2");
                        } else if (IsCharExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_chrstr");
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_dbl2str");
                        } else if (IsUlongExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_uint2str");
                        } else {
                            GenExpr(arg);
                            BLInternal("_zan_rt_int2str");
                        }
                        return;
                    }
                    if (mn == "ToInt32" || mn == "ToInt64" || mn == "ToInt") {
                        if (IsStrExpr(arg)) {
                            // strtoll(s, NULL, 10): full signed 64-bit
                            GenExpr(arg);
                            E4(0xF81F0FE0);              // push s
                            LoadImm(1, 0);               // endptr = NULL
                            LoadImm(2, 10);
                            E4(0xF84107E0);              // pop -> x0 = s
                            BLExtern("_strtoll");
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);
                            E4(0x9E670000);              // fmov d0, x0
                            E4(0x9E780000);              // fcvtzs x0, d0
                        } else {
                            GenExpr(arg);                // int slots are i64 already
                        }
                        return;
                    }
                    if (mn == "ToDouble") {
                        if (IsStrExpr(arg)) {
                            GenExpr(arg);
                            LoadImm(1, 0);               // endptr = NULL
                            BLExtern("_zan_rt_dbl_parse");
                            E4(0x9E660000);              // fmov x0, d0
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);                // bits unchanged
                        } else {
                            GenExpr(arg);
                            E4(0x9E620000);              // scvtf d0, x0
                            E4(0x9E660000);              // fmov x0, d0
                        }
                        return;
                    }
                }
            }
            // X.Parse(s) for the numeric primitive types: gen0 fronts
            // strtoll for the integer forms and zan_rt_dbl_parse (strtod
            // with NaN/Infinity spellings) for the floating forms
            if (recv != null && recv.kind == AK.Ident() && callee.sval == "Parse"
                    && e.kids.Count == 1) {
                string rn = recv.sval;
                bool intRecv = rn == "int" || rn == "long" || rn == "Int32" || rn == "Int64";
                bool dblRecv = rn == "double" || rn == "float" || rn == "Double" || rn == "Single";
                if (intRecv || dblRecv) {
                    GenExpr(e.kids[0]);
                    if (intRecv) {
                        E4(0xF81F0FE0);                  // push s
                        LoadImm(1, 0);                   // endptr = NULL
                        LoadImm(2, 10);
                        E4(0xF84107E0);                  // pop -> x0 = s
                        BLExtern("_strtoll");
                    } else {
                        LoadImm(1, 0);                   // endptr = NULL
                        BLExtern("_zan_rt_dbl_parse");
                        E4(0x9E660000);                  // fmov x0, d0
                    }
                    return;
                }
            }
            // enum x.ToString(): member-name lookup with numeric fallback,
            // like gen0 (run before the scalar paths, which would render the
            // raw number)
            if (callee.sval == "ToString" && e.kids.Count == 0) {
                string et = EnumTyOf(recv);
                if (et != null) {
                    GenEnumToString(recv, et);
                    return;
                }
            }
            // scalar x.ToString(): gen0 routes these through the same
            // renderers as Console.Write (class receivers dispatch instead,
            // which ScalarToStringTy's null answer leaves to the fallthrough)
            if (callee.sval == "ToString" && e.kids.Count == 0
                    && ScalarToStringTy(recv) != null) {
                string sty = ScalarToStringTy(recv);
                if (sty == "bool") {
                    GenExpr(recv);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                } else if (sty == "string") {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                      // push s
                    LoadStr(InternStr(""), 0);           // x0 = ""
                    E4(0xF84107E1);                      // pop -> x1 (owned copy)
                    BLInternal("_zan_rt_strcat2");
                } else if (sty == "char") {
                    GenExpr(recv);
                    BLInternal("_zan_rt_chrstr");
                } else if (sty == "double") {
                    GenExpr(recv);
                    BLInternal("_zan_rt_dbl2str");
                } else if (sty == "ulong") {
                    GenExpr(recv);
                    BLInternal("_zan_rt_uint2str");
                } else {
                    GenExpr(recv);
                    BLInternal("_zan_rt_int2str");
                }
                return;
            }
            // List<T> built-ins (gen0-compatible inline sequences)
            if (ExprCls(recv) == "List") {
                if (callee.sval == "Add" && e.kids.Count == 1) {
                    GenListAdd(recv, e.kids[0]);
                    return;
                }
                if (callee.sval == "Clear" && e.kids.Count == 0) {
                    GenExpr(recv);
                    E4(0xF900001F);                      // str xzr, [x0] (count = 0)
                    return;
                }
                if (callee.sval == "Contains" && e.kids.Count == 1) {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                      // push list
                    GenExpr(e.kids[0]);
                    E4(0xF84107E1);                      // pop list -> x1 (x0 = value)
                    // loop state lives in callee-saved x19..x23: the string
                    // form calls strcmp, which clobbers every caller-saved
                    // register the loop would otherwise keep there
                    MovRR(19, 1);                        // x19 = list
                    MovRR(22, 0);                        // x22 = value
                    LdrU(20, 19, 0);                     // x20 = count
                    LdrU(21, 19, 16);                    // x21 = data
                    E4(0xD2800017);                      // movz x23, #0 (i)
                    int lp = NL();
                    int nof = NL();
                    int yes = NL();
                    int donec = NL();
                    Mark(lp);
                    E4(0xEB1402FF);                      // cmp x23, x20
                    EmitBcond(10, nof);                  // b.ge nof
                    E4(0xF8777AA0);                      // ldr x0, [x21, x23, lsl #3]
                    if (IsStrExpr(e.kids[0])) {
                        MovRR(1, 22);                    // x1 = value
                        BLExtern("_strcmp");
                        E4(0x7100001F);                  // cmp w0, #0
                        EmitBcond(0, yes);               // b.eq yes
                    } else {
                        E4(0xEB16001F);                  // cmp x0, x22
                        EmitBcond(0, yes);               // b.eq yes
                    }
                    AddImm(23, 23, 1);
                    EmitB(lp);
                    Mark(nof);
                    E4(0xD2800000);                      // movz x0, #0
                    EmitB(donec);
                    Mark(yes);
                    E4(0xD2800020);                      // movz x0, #1
                    Mark(donec);
                    return;
                }
                diags.Error("ngen: unsupported List operation '" + callee.sval + "'", e.line, e.col);
                return;
            }
            // string instance methods (gen0: Substring checks start <= len
            // and folds to 0; IndexOf is strstr with a -1 miss)
            if (e.kids.Count == 2 && IsStrExpr(recv) && callee.sval == "Substring") {
                // two-argument form: substr3 clamps the window against the
                // string's own length (an out-of-range window answers empty,
                // not a crash -- gen0's soft-continue behavior)
                GenExpr(recv);
                E4(0xF81F0FE0);                  // push s
                GenExpr(e.kids[0]);
                E4(0xF81F0FE0);                  // push start
                GenExpr(e.kids[1]);
                E4(0xF81F0FE0);                  // push len
                E4(0xF84107E2);                  // pop len -> x2
                E4(0xF84107E1);                  // pop start -> x1
                E4(0xF84107E0);                  // pop s -> x0
                BLInternal("_zan_rt_substr3");
                return;
            }
            if (e.kids.Count == 1 && IsStrExpr(recv)) {
                if (callee.sval == "Substring") {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                  // push s
                    GenExpr(e.kids[0]);
                    E4(0xF84107E1);                  // pop s -> x1 (x0 = start)
                    E4(0xD1002022);                  // sub x2, x1, #8
                    E4(0xF9400042);                  // ldr x2, [x2]
                    E4(0xD3407C42);                  // ubfm x2, x2, #0, #31 (len)
                    int bad = NL();
                    int cont = NL();
                    E4(0xEB02001F);                  // cmp x0, x2
                    EmitBcond(12, bad);              // b.gt bad
                    EmitB(cont);
                    Mark(bad);
                    E4(0xF81F0FE0);                  // keep start
                    LoadSymRef("l_.str." + guardFileIdx, 0);
                    LoadImm(1, curLine);
                    LoadImm(2, curCol);
                    LoadSymRef("l_.str." + guardSubIdx, 3);
                    BLExtern("_zan_rt_guard_fail3");
                    E4(0xF84107E0);                  // pop start
                    LoadImm(0, 0);
                    Mark(cont);
                    // substr2 takes (s, start); the probe left them swapped
                    E4(0xAA0003E9);                  // mov x9, x0
                    E4(0xAA0103E0);                  // mov x0, x1
                    E4(0xAA0903E1);                  // mov x1, x9
                    BLInternal("_zan_rt_substr2");
                    return;
                }
                if (callee.sval == "IndexOf") {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                  // push s
                    GenExpr(e.kids[0]);
                    E4(0xF84107E1);                  // pop s -> x1 (x0 = needle)
                    E4(0xAA0103E9);                  // mov x9, x1
                    E4(0xAA0003E1);                  // mov x1, x0
                    E4(0xAA0903E0);                  // mov x0, x9
                    BLExtern("_strstr");
                    int miss = NL();
                    int done = NL();
                    CbzReg(0, miss);
                    E4(0xCB090000);                  // sub x0, x0, x9
                    EmitB(done);
                    Mark(miss);
                    LoadImm(0, -1);
                    Mark(done);
                    return;
                }
            }
            // static call through the class name: Cls.Method(args) -- the
            // receiver names a user class and the member is one of its
            // static methods (e.g. Point.Of(9)); overloads resolve by fit,
            // walking the base chain for inherited statics
            if (recv != null && recv.kind == AK.Ident() && FindClass(recv.sval) != null) {
                List<int> scands2 = new List<int>();
                string curc2 = recv.sval;
                while (curc2 != null) {
                    int i5 = 0;
                    while (i5 < methNodes.Count) {
                        if (methStat[i5] == 1 && methCls[i5] == curc2 && methNodes[i5].sval == callee.sval) { scands2.Add(i5); }
                        i5 = i5 + 1;
                    }
                    Cls cc5 = FindClass(curc2);
                    curc2 = cc5 != null ? cc5.baseName : null;
                }
                if (scands2.Count == 1) {
                    int si = scands2[0];
                    int pushed = PushCallArgs(methNodes[si], e);
                    int r = pushed - 1;
                    while (r >= 0) {
                        E4(0xF84107E0 | r);                  // ldr xr, [sp], #16
                        r = r - 1;
                    }
                    BLInternal(MethSymNg(methCls[si], methNodes[si]));
                    return;
                }
                if (scands2.Count > 1) {
                    int si = FitPickIdx(scands2, e);
                    int pushed = PushCallArgs(methNodes[si], e);
                    int r = pushed - 1;
                    while (r >= 0) {
                        E4(0xF84107E0 | r);                  // ldr xr, [sp], #16
                        r = r - 1;
                    }
                    BLInternal(MethSymNg(methCls[si], methNodes[si]));
                    return;
                }
            }
            // instance method call: x0 = receiver, x1.. = args. Candidates
            // come from the receiver's static class chain (derived first) and
            // resolve by overload fit; a virtual slot dispatches through the
            // receiver's runtime vtable
            string rc = ExprCls(recv);
            List<int> icands = new List<int>();
            if (rc != null) { InstanceCands(rc, callee.sval, icands); }
            int mi = icands.Count > 0 ? FitPickIdx(icands, e) : FindInstanceIdx(callee.sval);
            if (mi < 0) {
                diags.Error("ngen: unknown method '" + callee.sval + "'", e.line, e.col);
                return;
            }
            int vslot = rc != null ? VSlotOf(rc, callee.sval) : -1;
            GenExpr(recv);
            E4(0xF81F0FE0);                              // str x0, [sp, #-16]! (receiver)
            int pushed = PushCallArgs(methNodes[mi], e);
            int r = pushed;
            while (r >= 1) { E4(0xF84107E0 | r); r = r - 1; } // ldr xr, [sp], #16 (args reversed)
            E4(0xF84107E0);                              // ldr x0, [sp], #16 (receiver)
            if (vslot >= 0) {
                LdrU(9, 0, 0);                           // x9 = vptr
                LdrU(9, 9, vslot * 8);                   // x9 = target fn
                E4(0xD63F0120);                          // blr x9
            } else {
                BLInternal(MethSymNg(methCls[mi], methNodes[mi]));
            }
            return;
        }
        if (callee == null || callee.kind != AK.Ident()) {
            diags.Error("ngen: unsupported call target", e.line, e.col);
            return;
        }
        // static call: candidates from the current class chain first, then
        // (legacy) any class declaring the bare name; overloads resolve by fit
        List<int> scands = new List<int>();
        string curc = curCls;
        while (curc != null) {
            int i2 = 0;
            while (i2 < methNodes.Count) {
                if (methStat[i2] == 1 && methCls[i2] == curc && methNodes[i2].sval == callee.sval) { scands.Add(i2); }
                i2 = i2 + 1;
            }
            Cls cc2 = FindClass(curc);
            curc = cc2 != null ? cc2.baseName : null;
        }
        if (scands.Count == 0) {
            int i3 = 0;
            while (i3 < methNodes.Count) {
                if (methStat[i3] == 1 && methNodes[i3].sval == callee.sval) { scands.Add(i3); }
                i3 = i3 + 1;
            }
        }
        if (scands.Count == 0) {
            diags.Error("ngen: unknown static method '" + callee.sval + "'", e.line, e.col);
            return;
        }
        int si = scands.Count == 1 ? scands[0] : FitPickIdx(scands, e);
        if (si < 0) { si = scands[0]; }
        Node m = methNodes[si];
        // evaluate args left to right (defaults fill omitted trailing
        // arguments, a params tail bundles the extras), spilling each;
        // reload into x0.. reversed
        int pushed = PushCallArgs(m, e);
        int q = pushed - 1;
        while (q >= 0) {
            E4(0xF84107E0 | q);                          // ldr xq, [sp], #16
            q = q - 1;
        }
        BLInternal(MethSymNg(methCls[si], methNodes[si]));
    }

    int FindStaticIdx(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methNodes[i].sval == name && methStat[i] == 1) { return i; }
            i = i + 1;
        }
        return -1;
    }

    int ParamCount(Node m) {
        int n = 0; int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // i-th declared parameter of method m (this excluded), or null
    Node ParamAt(Node m, int idx) {
        int seen = 0; int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) {
                if (seen == idx) { return m.kids[i]; }
                seen = seen + 1;
            }
            i = i + 1;
        }
        return null;
    }

    // is this expression already the params bundle (an array value)? A call
    // whose single tail argument is the array itself passes it through
    // unpacked, as in C#
    bool IsArrValExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.NewExpr() && e.ival == 1) { return true; }
        string t = StaticTyOf(e);
        return t != null && IsArrTy(t);
    }

    // int (x0) -> double (x0), in place: the value is an integer bit pattern
    // but the destination slot carries a double
    void ConvI2D() {
        E4(0x9E620000);                                  // scvtf d0, x0
        E4(0x9E660000);                                  // fmov x0, d0
    }

    // implicit int->double conversion for argument `idx` of method m when
    // the declared parameter is double but the argument expression is not
    void ConvArg(Node m, int idx, Node arg) {
        Node p = ParamAt(m, idx);
        if (p == null || p.type == null) { return; }
        if (TypeFullName(p.type) == "double" && !IsDblExpr(arg)) { ConvI2D(); }
    }

    // declared type of an assignment target ("double", ...), or null
    string AssignTargetTy(Node a) {
        if (a == null) { return null; }
        if (a.kind == AK.Ident()) {
            int li = LocalIdx(a.sval);
            if (li >= 0) { return locTy[li]; }
            Fld fld = CurField(a.sval);
            if (fld != null) { return fld.ty; }
            return FindStaticTy(curCls, a.sval);
        }
        if (a.kind == AK.MemberAccess() && a.sval != null) {
            Fld f2 = FieldOf(a);
            if (f2 != null) { return f2.ty; }
        }
        if (a.kind == AK.Index() && IsArrExpr(a.a)) {
            string at = ArrTyOf(a.a);
            if (at != null && at.Length > 2) { return at.Substring(0, at.Length - 2); }
        }
        return null;
    }

    // evaluate call arguments left to right, spilling each onto the stack;
    // omitted trailing arguments fall back to the callee's default parameter
    // values, and a `params T[]` tail bundles every extra argument into a
    // freshly allocated array (gen0 packs the bundle at the call site).
    // Returns the count pushed -- the caller pops exactly that many into
    // x0.. in reverse.
    int PushCallArgs(Node m, Node e) {
        string calleeName = e.a != null ? e.a.sval : "constructor";
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        int fixedc = variadic ? pc - 1 : pc;
        int prov = e.kids.Count;
        if (!variadic && prov > pc) {
            diags.Error("ngen: too many arguments calling '" + calleeName + "'", e.line, e.col);
            return pc;
        }
        if (variadic && prov < fixedc) {
            diags.Error("ngen: arity mismatch calling '" + calleeName + "'", e.line, e.col);
            return pc;
        }
        // whole-bundle passthrough: the single tail argument is already an
        // array value, so it is handed over as-is
        if (variadic && prov == pc && IsArrValExpr(e.kids[prov - 1])) {
            int k = 0;
            while (k < prov) {
                GenExpr(e.kids[k]);
                ConvArg(m, k, e.kids[k]);
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                k = k + 1;
            }
            return prov;
        }
        int i = 0;
        while (i < prov && i < fixedc) {
            GenExpr(e.kids[i]);
            ConvArg(m, i, e.kids[i]);
            E4(0xF81F0FE0);                              // str x0, [sp, #-16]!
            i = i + 1;
        }
        while (i < fixedc) {
            Node p = ParamAt(m, i);
            if (p == null || p.b == null) {
                diags.Error("ngen: arity mismatch calling '" + calleeName + "'", e.line, e.col);
                return i;
            }
            GenExpr(p.b);
            ConvArg(m, i, p.b);
            E4(0xF81F0FE0);
            i = i + 1;
        }
        if (variadic) {
            int esz = ArrElemSize(TypeFullName(lastP.type));
            string elTy = TypeFullName(lastP.type);
            elTy = elTy.Length > 2 ? elTy.Substring(0, elTy.Length - 2) : elTy;
            int n = prov > fixedc ? prov - fixedc : 0;
            // spill the tail elements left to right, then allocate the
            // bundle array and store them at their slots
            int j2 = fixedc;
            while (j2 < prov) {
                GenExpr(e.kids[j2]);
                if (elTy == "double" && !IsDblExpr(e.kids[j2])) { ConvI2D(); }
                E4(0xF81F0FE0);
                j2 = j2 + 1;
            }
            Node cnt = new Node(AK.IntLit());
            cnt.ival = n;
            GenArrNew(cnt, esz);
            E4(0xF81F0FE0);                              // push arr
            int k2 = n - 1;                              // stack top holds the last element
            while (k2 >= 0) {
                E4(0xF84107E1);                          // pop arr -> x1
                E4(0xF84107E0);                          // pop element -> x0
                E4((int)(0xD2800000 | (((long)k2) << 5) | 2)); // movz x2, #k2
                if (esz == 4) {
                    E4(0xB8227820);                      // str w0, [x1, x2, lsl #2]
                } else {
                    E4(0xF8227820);                      // str x0, [x1, x2, lsl #3]
                }
                E4(0xF81F0FE1);                          // push arr back
                k2 = k2 - 1;
            }
            E4(0xF84107E0);                              // pop arr -> x0
            E4(0xF81F0FE0);                              // push the bundle as the tail arg
            i = i + 1;
        }
        return i;
    }

    int FindCtorIdx(string cls) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methStat[i] == 2 && methCls[i] == cls) { return i; }
            i = i + 1;
        }
        return -1;
    }

    int CtorCountNg(string cls) {
        int n = 0; int i = 0;
        while (i < methNodes.Count) {
            if (methStat[i] == 2 && methCls[i] == cls) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // parameter-type tag for ctor symbol mangling (mirrors the llvm
    // backend's TypeTag so the shapes stay analogous)
    string TypeTagNg(Node t) {
        if (t == null || t.sval == null || t.sval == "") { return "v"; }
        string s = t.sval;
        int i = 0;
        while (i < t.kids.Count) { s = s + "." + TypeTagNg(t.kids[i]); i = i + 1; }
        return s;
    }

    // symbol for a constructor. With a single ctor this stays the historical
    // `_Type_ctor`; with overloads the parameter types are appended so two
    // ctors cannot collide on one symbol (mirrors CtorSym in the llvm path)
    string CtorSymNg(string cls, Node ctor) {
        if (CtorCountNg(cls) <= 1) { return "_" + cls + "_ctor"; }
        string s = "_" + cls + "_ctor__";
        int i = 0;
        while (i < ctor.kids.Count) {
            Node p = ctor.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTagNg(p.type); }
            i = i + 1;
        }
        return s;
    }

    // is pt a concrete type ngen can score by: a primitive, List<...>, a
    // declared class/struct, or an array of one of those. Anything else --
    // an open generic's type parameter like Box<T>'s `T` -- has no family
    // to rank by and must stay neutral, never disqualify (gen0 scores
    // FAM_UNKNOWN as 0; a bare T matches anything).
    bool KnownParamTy(string pt) {
        if (pt == "int" || pt == "long" || pt == "ulong" || pt == "double"
                || pt == "bool" || pt == "char" || pt == "string"
                || pt == "object" || pt == "void") { return true; }
        if (pt == "List" || (pt.Length > 5 && pt.Substring(0, 5) == "List<")) { return true; }
        if (IsArrTy(pt)) { return KnownParamTy(pt.Substring(0, pt.Length - 2)); }
        return FindClass(pt) != null;
    }

    // how well one argument fits one parameter type: exact static/literal
    // agreement scores high, a known literal/type mismatch disqualifies the
    // candidate, anything unknown is neutral. gen0 resolves ctor overloads
    // with full type scoring; ngen sees the declared types and literals.
    int ArgParamScore(Node arg, string pt) {
        if (pt == null || pt == "") { return 0; }
        if (!KnownParamTy(pt)) { return 0; }
        string at = StaticTyOf(arg);
        if (at != null) { return at == pt ? 8 : 0; }
        int k = arg.kind;
        if (k == AK.IntLit()) {
            if (pt == "int") { return 8; }
            if (pt == "long" || pt == "ulong") { return 6; }
            if (pt == "double") { return 4; }
            return -100;
        }
        if (k == AK.FloatLit()) { return pt == "double" ? 8 : -100; }
        if (k == AK.StringLit()) { return pt == "string" ? 8 : -100; }
        if (k == AK.BoolLit()) { return pt == "bool" ? 8 : -100; }
        if (k == AK.CharLit()) { return pt == "char" ? 8 : (pt == "int" ? 4 : -100); }
        if (k == AK.NullLit()) {
            if (ClassTyOf(pt) != null || pt == "List") { return 8; }
            return -100;
        }
        if (IsStrExpr(arg)) { return pt == "string" ? 8 : -100; }
        return 0;
    }

    // does candidate ctor `m` accept `argc` arguments: the exact arity, or
    // trailing default parameters filling the gap (gen0 fills defaults
    // before ctor resolution; a params tail on a ctor is not a thing)
    bool CtorAcceptsArity(Node m, int argc) {
        int pc = ParamCount(m);
        if (pc == argc) { return true; }
        if (argc > pc) { return false; }
        int j = argc;
        while (j < pc) {
            Node p = ParamAt(m, j);
            if (p == null || p.b == null) { return false; }
            j = j + 1;
        }
        return true;
    }

    // constructor overload resolution for `new C(args)`: among the ctors
    // whose arity admits the call, pick the best argument-type match
    // (exact-arity candidates outrank default-filled ones; ties keep the
    // first declared). `exactOnly` matches gen0's implicit base chain, which
    // looks for a true parameterless ctor; `exclude` rules a ctor out (a
    // `: this(...)` chain must not retarget itself). Returns -1 when
    // nothing fits.
    int FitCtorIdx(string cls, Node callNode, bool exactOnly, Node exclude) {
        int argc = callNode != null ? callNode.kids.Count : 0;
        int exact = -1; int exactScore = -2000000000;
        int filled = -1; int filledScore = -2000000000;
        int i = 0;
        while (i < methNodes.Count) {
            if (methStat[i] == 2 && methCls[i] == cls && methNodes[i] != exclude
                    && CtorAcceptsArity(methNodes[i], argc)) {
                int score = 0;
                bool compatible = true;
                int j = 0;
                while (j < argc && compatible) {
                    Node p = ParamAt(methNodes[i], j);
                    string pt = p != null && p.type != null ? TypeFullName(p.type) : null;
                    int s = ArgParamScore(callNode.kids[j], pt);
                    if (s <= -100) { compatible = false; }
                    score = score + s;
                    j = j + 1;
                }
                if (compatible) {
                    bool isExact = ParamCount(methNodes[i]) == argc;
                    if (isExact) {
                        if (score > exactScore) { exactScore = score; exact = i; }
                    } else if (!exactOnly) {
                        if (score > filledScore) { filledScore = score; filled = i; }
                    }
                }
            }
            i = i + 1;
        }
        if (exact >= 0) { return exact; }
        return filled;
    }

    // ---- exceptions: try / catch / throw ----
    // EH state (single-thread approximation): one global pointer in
    // __DATA,__data (l_.g.zan_eh) to a lazily calloc'd { i32 top, ptr exc,
    // buf[64] of 1024-byte setjmp slots } = 16 + 64*1024 bytes. Mirrors the
    // observable semantics of gen0's TLS-backed %zan.eh.state.
    void GenTry(Node s) {
        BLInternal("_zan_rt_eh_state");              // x0 = state (lazy alloc)
        E4(0xF81F0FE0);                              // push state
        LdrU(1, 0, 0);                               // top
        E4(0xF81F0FE1);                              // push saved top
        LoadImm(3, 1024);
        E4(0x9B037C22);                              // mul x2, x1, x3
        AddRR(2, 0, 2);                              // state + top*1024
        AddImm(2, 2, 16);                            // &bufs[top]
        AddImm(1, 1, 1);                             // top + 1
        StrU(1, 0, 0);                               // state->top = top + 1
        MovRR(0, 2);
        BLExtern("_setjmp");                         // returns 0 (direct) / 1 (thrown)
        EmitCbnz(0, NL());
        int catchL = lblPos.Count - 1;
        int endL = NL();
        // ---- normal path: run the try body, then pop the frame ----
        GenStmt(s.a);
        EhRestoreTop();
        EmitB(endL);
        Mark(catchL);
        // ---- thrown path: pop the frame FIRST (a throw inside the handler
        // must unwind to the enclosing try, not re-enter this one), then bind
        // exc to the catch variable and run the body ----
        EhRestoreTop();
        LdrU(0, 1, 8);                               // exc (x1 = state, kept for bare rethrow)
        Node cc = s.b;
        if (cc != null && cc.sval != null && cc.sval != "") {
            int ci = LocalIdx(cc.sval);
            if (ci >= 0) { StoreLocal(ci, 0); }
        }
        if (cc != null) { GenStmt(cc.a); }
        Mark(endL);
        AddSPImm(32, true);                          // pop saved top + state
    }

    void EhRestoreTop() {
        LdrU(1, 31, 16);                             // state (pushed first: [sp+16])
        LdrU(3, 31, 0);                              // saved top
        StrU(3, 1, 0);                               // state->top = saved
    }

    void GenThrow(Node s) {
        if (s.a != null) {
            GenExpr(s.a);
            E4(0xF81F0FE0);                          // push exc string
            BLInternal("_zan_rt_eh_state");          // x0 = state
            MovRR(1, 0);
            LdrU(2, 31, 0);                          // exc string
            StrU(2, 1, 8);                           // state->exc = str
        } else {
            // bare rethrow: exc is already set by the original throw
            BLInternal("_zan_rt_eh_state");
            MovRR(1, 0);
        }
        LdrU(2, 1, 0);                               // top
        CbzReg(2, NL());
        int uncaught = lblPos.Count - 1;
        SubImm(2, 2, 1);                             // top - 1
        LoadImm(3, 1024);
        E4(0x9B037C42);                              // mul x2, x2, x3
        AddRR(2, 1, 2);
        AddImm(2, 2, 16);                            // &bufs[top-1]
        MovRR(0, 2);
        LoadImm(1, 1);
        BLExtern("_longjmp");
        Mark(uncaught);
        // no active try: print the exception and exit(1)
        LdrU(0, 1, 8);
        BLInternal("_zan_rt_println");
        LoadImm(0, 1);
        BLExtern("_exit");
    }

    // ---- labels ----
    int NL() { lblPos.Add(-1); nlabel = nlabel + 1; return nlabel - 1; }
    void Mark(int l) { lblPos[l] = txt.Count; }

    // emit one instruction word, little-endian
    void E4(int w) {
        txt.Add(ByteAt(w, 0)); txt.Add(ByteAt(w, 1));
        txt.Add(ByteAt(w, 2)); txt.Add(ByteAt(w, 3));
    }

    // ---- local load/store ----
    // Locals are addressed relative to the frame pointer (x29) with a signed
    // unscaled imm9 (LDUR/STUR), so push/pop scratch traffic on sp never
    // changes how a local is found. x29 points at the saved x29/x30 pair and
    // the frame starts right below it: local i lives at x29 + (16*i - frame).
    int LocFpOff(int off) {
        return off - frame;
    }
    void LoadLocal(int li, int reg) {
        if (li < 0 || li >= locOff.Count) {
            // fail closed: the runtime list guard would silently read slot 0
            diags.Error("ngen: local slot " + li + " out of range", curLine, curCol);
            LoadImm(reg, 0);
            return;
        }
        E4(0xF8400000 | ((LocFpOff(locOff[li]) & 0x1FF) << 12) | (29 << 5) | reg);
    }
    void StoreLocal(int li, int reg) {
        if (li < 0 || li >= locOff.Count) {
            diags.Error("ngen: local slot " + li + " out of range", curLine, curCol);
            return;
        }
        E4(0xF8000000 | ((LocFpOff(locOff[li]) & 0x1FF) << 12) | (29 << 5) | reg);
    }

    // ---- immediates ----
    void LoadImm(int reg, long v) {
        if (v >= 0 && v < 65536) {
            E4((int)(0xD2800000 | (v << 5) | reg));      // movz x, #v
            return;
        }
        if (v < 0 && v >= -65536) {
            E4((int)(0x92800000 | (((-v) - 1) << 5) | reg)); // movn x, #~v
            return;
        }
        // 16-bit chunks: plain truncating division mis-extracts negative
        // values (e.g. i64min's top chunk comes out as -32768), so fold the
        // chunk back into [0, 65536).
        long chunk0 = v - (v / 65536) * 65536;
        if (chunk0 < 0) { chunk0 = chunk0 + 65536; }
        E4((int)(0xD2800000 | (chunk0 << 5) | reg));     // movz x, #c0
        int h = 1;
        while (h < 4) {
            long sh = ShiftRight(v, h * 16);
            long chunk = sh - (sh / 65536) * 65536;
            if (chunk < 0) { chunk = chunk + 65536; }
            E4((int)(0xF2800000 | (((long)h) << 21) | (chunk << 5) | reg)); // movk
            h = h + 1;
        }
    }

    long ShiftRight(long v, int bits) {
        // arithmetic (floor) shift: plain halving truncates toward zero, so
        // e.g. 0xFF378ADD's narrowed int32 value -13137187 >> 16 must give
        // -201 (chunk 0xFF37), not -200 (chunk 0xFF38)
        long r = v;
        int n = bits;
        while (n > 0) {
            long prev = r;
            r = prev / 2;
            if (prev < 0 && r * 2 != prev) { r = r - 1; }
            n = n - 1;
        }
        return r;
    }

    // add/sub sp immediate (imm < 4096)
    void AddSPImm(int imm, bool isAdd) {
        if (isAdd) { E4(0x91000000 | (imm << 10) | (31 << 5) | 31); }
        else { E4(0xD1000000 | (imm << 10) | (31 << 5) | 31); }
    }

    // add immediate between registers (imm < 4096)
    void AddImm(int rd, int rn, int imm) {
        E4(0x91000000 | (imm << 10) | (rn << 5) | rd);
    }

    // ---- branches and calls ----
    void EmitB(int label) { E4(0x14000000); fixups.Add(new Fixup(txt.Count - 4, 0, label, 0, null)); }
    void EmitBcond(int cond, int label) {
        E4(0x54000000 | cond);                       // B.cond: cond in the low byte
        fixups.Add(new Fixup(txt.Count - 4, 2, label, cond, null));
    }
    void EmitCBZ(int reg, int label) {
        E4(0xB4000000 | reg);
        fixups.Add(new Fixup(txt.Count - 4, 1, label, 0, null));
    }
    void EmitCbnz(int reg, int label) {
        E4(0xB5000000 | reg);
        fixups.Add(new Fixup(txt.Count - 4, 1, label, 0, null));
    }
    void BLInternal(string sym) { E4(0x94000000); fixups.Add(new Fixup(txt.Count - 4, 3, 0, 0, sym)); }
    void BLExtern(string sym) { E4(0x94000000); fixups.Add(new Fixup(txt.Count - 4, 4, 0, 0, sym)); }

    // ---- strings ----
    int InternStr(string s) {
        strs.Add(s);
        return strs.Count - 1;
    }
    void LoadSymRef(string sym, int reg) {
        E4(0x90000000 | reg);                            // adrp reg, sym@PAGE
        int a = txt.Count - 4;
        E4(0x91000000 | (reg << 5) | reg);               // add reg, reg, sym@PAGEOFF
        strRefs.Add(new StrRef(a, txt.Count - 4, sym));
    }
    // adrp + ldr through the GOT. dylib DATA symbols (__stdinp etc.) cannot
    // bind through adrp+add: their page offsets are filled at runtime by the
    // dynamic loader, so the address must come from a GOT slot instead.
    void LoadSymRefGOT(string sym, int reg) {
        E4(0x90000000 | reg);                            // adrp reg, sym@GOTPAGE
        int a = txt.Count - 4;
        E4(0xF9400000 | (reg << 5) | reg);               // ldr reg, [reg, sym@GOTPAGEOFF]
        StrRef r = new StrRef(a, txt.Count - 4, sym);
        r.got = 1;
        strRefs.Add(r);
    }
    void LoadStr(int si, int reg) {
        // literals live in the startup pool as stamped heap strings; the
        // l_.g.strp.N slot holds the pointer (see RtEmitStrpool)
        LoadSymRef("l_.g.strp." + si, reg);
        LdrU(reg, reg, 0);
    }

    // one-argument libm double call: the value arrives as its bit pattern
    // in x0, moves to d0, and the result comes back the same way
    void DblLibm1(string f) {
        E4(0x9E670000);                                  // fmov d0, x0
        BLExtern(f);
        E4(0x9E660000);                                  // fmov x0, d0
    }

    // ---- fixup resolution (text offsets are final here) ----
    int WordAt(int pos) {
        return (txt[pos + 3] << 24) | (txt[pos + 2] << 16) | (txt[pos + 1] << 8) | txt[pos];
    }
    void SetWordAt(int pos, int w) {
        txt[pos] = ByteAt(w, 0); txt[pos + 1] = ByteAt(w, 1);
        txt[pos + 2] = ByteAt(w, 2); txt[pos + 3] = ByteAt(w, 3);
    }
    int ByteAt(int v, int i) {
        int b = v >> (i * 8);
        b = b - (b / 256) * 256;
        if (b < 0) { b = b + 256; }
        return b;
    }

    void Patch() {
        int i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            int word = WordAt(f.pos);
            if (f.kind == 0) {
                // B: opcode occupies the top 6 bits, imm26 the rest
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                word = (ByteAt(word, 3) / 4) * 67108864 + ModLow(imm, 26);
            } else if (f.kind == 1 || f.kind == 2) {
                // CBZ / B.cond: imm19 at bits 23..5; low byte (Rt / cond) kept.
                // The word is negative (top byte >= 0x80), so the low 5 bits
                // must come from ByteAt -- (word - (word/32)*32) breaks on
                // truncating division for negatives.
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                int lo = ByteAt(word, 0);
                lo = lo - (lo / 32) * 32;
                word = (ByteAt(word, 3) << 24) | (ByteAt(word, 2) << 16)
                     | (ModLow(imm, 19) << 5)
                     | lo;
            } else if (f.kind == 3) {
                // internal BL: same layout as B
                int imm = (SymPos(f.sym) - f.pos) / 4;
                word = (ByteAt(word, 3) / 4) * 67108864 + ModLow(imm, 26);
            } else {
                // extern BL: imm26 stays zero, resolved by relocation
            }
            SetWordAt(f.pos, word);
            i = i + 1;
        }
    }

    // imm mod 2^n, normalized to [0, 2^n) (two's-complement field value)
    int ModLow(int imm, int bits) {
        int m = imm - (imm / (1 << bits)) * (1 << bits);
        if (m < 0) { m = m + (1 << bits); }
        return m;
    }

    int SymPos(string name) {
        int i = 0;
        while (i < syms.Count) {
            if (syms[i].name == name) { return syms[i].pos; }
            i = i + 1;
        }
        return 0;
    }
}
