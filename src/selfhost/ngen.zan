using System;
using System.Collections;
namespace Zan;

// Ngen: native backend slice (M1). Emits arm64 machine code directly from the
// bound AST — no LLVM IR text, no clang. The object container (Mach-O) lives
// in ngen_macho.zan.
//
// Instruction words are stored as 32-bit two's-complement ints: Zan hex
// literals above 0x7FFFFFFF wrap, but the bit pattern survives the wrap and
// byte extraction takes the low 32 bits.
//
// Kernel subset: static methods, int params/locals/returns, int literals,
// `+ - * <`, if/while, plain calls (recursion ok), Console.WriteLine(int).
// Anything else is a compile error, not a silent fallback.

// Open-addressed string -> insertion-ordered bucket index over the method
// tables. Our builtin Dictionary is a linear walk (_zan_rt_dict_index), so
// it cannot speed up the very scans it appears in; this table gives O(1)
// key probes. Buckets chain in append order, so iteration inside a bucket
// matches the old flat table scan exactly.
class MethIndex {
    List<string> keys;
    List<int> head;
    List<int> tail;
    List<int> entVal;
    List<int> entNext;
    List<int> slots;

    public MethIndex() {
        keys = new List<string>();
        head = new List<int>();
        tail = new List<int>();
        entVal = new List<int>();
        entNext = new List<int>();
        slots = new List<int>();
        int i = 0;
        while (i < 4096) { slots.Add(-1); i = i + 1; }
    }

    int HashOf(string s) {
        int h = 17;
        int i = 0;
        while (i < s.Length) { h = h * 31 + (int)s[i] + 1; i = i + 1; }
        if (h < 0) { h = 0 - h; }
        if (h < 0) { h = 0; }
        return h;
    }

    // find-or-insert the key id
    int KeyId(string k) {
        int n = slots.Count;
        int j = HashOf(k) % n;
        while (slots[j] >= 0) {
            if (keys[slots[j]] == k) { return slots[j]; }
            j = j + 1;
            if (j == n) { j = 0; }
        }
        int id = keys.Count;
        keys.Add(k);
        head.Add(-1);
        tail.Add(-1);
        slots[j] = id;
        if (keys.Count * 2 >= n) { Rehash(); }
        return id;
    }

    void Rehash() {
        List<string> oldKeys = keys;
        slots = new List<int>();
        int n = oldKeys.Count * 8 + 1;
        int i = 0;
        while (i < n) { slots.Add(-1); i = i + 1; }
        int q = 0;
        while (q < oldKeys.Count) {
            int j = HashOf(oldKeys[q]) % n;
            while (slots[j] >= 0) { j = j + 1; if (j == n) { j = 0; } }
            slots[j] = q;
            q = q + 1;
        }
    }

    public void Add(string k, int v) {
        int id = KeyId(k);
        int e = entVal.Count;
        entVal.Add(v);
        entNext.Add(-1);
        if (tail[id] < 0) { head[id] = e; } else { entNext[tail[id]] = e; }
        tail[id] = e;
    }

    // method indices for k in insertion order, or null on miss
    public List<int> Get(string k) {
        int n = slots.Count;
        int j = HashOf(k) % n;
        while (slots[j] >= 0) {
            if (keys[slots[j]] == k) {
                List<int> r = new List<int>();
                int e = head[slots[j]];
                while (e >= 0) { r.Add(entVal[e]); e = entNext[e]; }
                return r;
            }
            j = j + 1;
            if (j == n) { j = 0; }
        }
        return null;
    }
}

class Fixup {
    public int pos;    // text offset of the patched instruction
    public int kind;   // 0=B 1=CBZ 2=Bcond 3=BL-internal 4=BL-extern
    public int lbl;    // label id (kinds 0-2)
    public int cond;   // cond code (kind 2)
    public string sym; // target symbol (kinds 3-4)
    public Fixup(int p, int k, int l, int c, string s) {
        pos = p; kind = k; lbl = l; cond = c; sym = s;
    }
}

class StrRef {
    public int adrpPos;  // text offset of the adrp instruction
    public int addPos;   // text offset of the add/ldr instruction
    public string sym;   // target symbol name (l_.str.N / l_.g.NAME / __stdinp)
    public int got;      // 1: adrp + ldr through the GOT (dylib data symbols)
    public StrRef(int a, int b, string s) { adrpPos = a; addPos = b; sym = s; got = 0; }
}

class Sym {
    public string name;  // link-time symbol name (underscore prefixed)
    public int pos;      // text offset of the definition
    public Sym(string n, int p) { name = n; pos = p; }
}

partial class Ngen {
    Diags diags;

    List<int> txt;          // __text bytes
    List<Sym> syms;         // defined symbols (one per method)
    List<Fixup> fixups;     // branch/call fixups
    List<StrRef> strRefs;   // string address references (adrp+add pairs)
    List<string> strs;      // __cstring entries
    List<int> lblPos;       // label id -> text pos (-1 while open)
    List<int> brkL;         // innermost-enclosing-loop break targets
    List<Node> finBodies;   // enclosing try/finally bodies, innermost last
    List<int> finInHandler; // 1 once that try's frame is conceptually disarmed
    List<int> ehStack;      // try frames open in this activation (compile time)
    List<bool> brkLoop;     // brkL[i] belongs to a loop (vs a switch)
    List<int> brkFinBase;   // finallys base for each break target
    List<int> cntFinBase;   // finallys base at each loop's continue point
    int finCur = -1;        // index of the finally body being emitted right now
    int lockSeq = 0;        // unique temp names for lowered lock statements
    List<int> cntL;         // innermost-enclosing-loop continue targets
    bool curHasTry;         // method being emitted contains a try anywhere
    int ehTopLocal;         // #ehtop: mirror of the runtime EH top
    int ehBaseLocal;        // #ehbase: top at the outermost open try's arm
    int ehBrkLocal;         // #ehbrk: top at loop entry (break/continue disarm)
    int ctmpSeq;            // hidden single-eval temps for compound assigns

    string curCls;
    int stTyDepth;          // StaticTyOf recursion guard: cyclic static-type
                            // chains bottom out as unknown, never hang
    List<string> locName;   // locals of the method being emitted
    List<string> locTy;     // declared type name per local ("" for this/params of unknown)
    List<int> locOff;       // frame offset (bytes from sp)
    List<bool> locRef;      // by-ref slots (out/ref params): the slot holds an address
    List<int> locOpaq;      // string slot holding an extern-call result: no
                            // length header, no trusted NUL bound (the stdlib
                            // slices readdir's struct dirent* byte by byte)
    // A persistent lexical environment is a chain of declaration slots.
    // Every AST node records its visible chain before emission, so sibling
    // scopes and re-emitted finally bodies never borrow one another's types.
    List<Node> locDecl;
    List<int> locPrev;
    List<Node> envNodes;
    List<int> envHeads;
    int locHead = -1;
    int nloc;
    int frame;
    int nlabel;
    int curLine;
    int curCol;
    int guardDivIdx;
    int guardModIdx;
    int guardFileIdx;
    int guardStrIdx;
    int guardSubIdx;
    int guardListIdx;
    int guardArrIdx;
    int guardArrNeg;
    int guardArrOvf;
    int guardArrFail;
    int guardArrNull;
    int guardStrNull;
    string srcFile;

    List<Node> methNodes;
    List<string> methCls;
    List<int> methStat;     // 0 = instance, 1 = static, 2 = ctor
    // incremental indexes over methNodes. Big inputs (Chart/Gui families)
    // made every call-site resolution walk the whole method table
    // (O(sites x methods)); lookups now touch only same-shape candidates.
    // Buckets append in table order, so iteration inside a bucket matches
    // the old flat scan exactly. Everything goes through AddMethNg so an
    // append can never bypass the indexes.
    MethIndex mIdxClsName;   // cls | name -> indices
    MethIndex mIdxName;      // name -> indices
    MethIndex mIdxCls;       // cls -> indices
    string mainCls;
    bool mainAsync;     // Main is async: the shim ramps + pumps instead of calling it
    Node curMeth;           // method being emitted (spec sval2 = this type)

    List<string> enName;    // enum type name per declaration
    List<int> enOff;        // start index into the flat member arrays
    List<int> enCnt;        // member count
    List<string> enMem;     // flat member names
    List<long> enVal;       // flat member constants (C# running counter)

    public Ngen(Binder b, Diags d, string file) {
        diags = d;
        layoutBinder = b;
        srcFile = file;
        txt = new List<int>();
        syms = new List<Sym>();
        fixups = new List<Fixup>();
        strRefs = new List<StrRef>();
        strs = new List<string>();
        lblPos = new List<int>();
        brkL = new List<int>();
        finBodies = new List<Node>();
        finInHandler = new List<int>();
        cntL = new List<int>();
        ehStack = new List<int>();
        brkLoop = new List<bool>();
        brkFinBase = new List<int>();
        cntFinBase = new List<int>();
        methNodes = new List<Node>();
        methCls = new List<string>();
        methStat = new List<int>();
        mIdxClsName = new MethIndex();
        mIdxName = new MethIndex();
        mIdxCls = new MethIndex();
        specMeth = new List<string>();
        instCls = new List<string>();
        ctorSpecKey = new List<string>();
        ctorSpecSym = new List<string>();
        nlabel = 0;
    }

    // single mutation point for the method tables so the indexes can never
    // fall behind the flat lists
    void AddMethNg(Node m, string cls, int stat) {
        methNodes.Add(m);
        methCls.Add(cls);
        methStat.Add(stat);
        int i = methNodes.Count - 1;
        mIdxClsName.Add(cls + "|" + m.sval, i);
        mIdxName.Add(m.sval, i);
        mIdxCls.Add(cls, i);
    }

    List<int> MethCandsClsName(string cls, string name) {
        return mIdxClsName.Get(cls + "|" + name);
    }

    List<int> MethCandsName(string name) {
        return mIdxName.Get(name);
    }

    List<int> MethCandsCls(string cls) {
        return mIdxCls.Get(cls);
    }

    // ---- entry: returns the object file bytes ----
    public List<int> Gen(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.ClassDecl() || dcl.kind == AK.StructDecl()) { CollectMethods(dcl); }
            i = i + 1;
        }
        CollectClasses(unit);
        CollectEnums(unit);
        RunSpecPipeline();
        MaterializeInstStatics();
        // one lazy vtable slot per polymorphic class (the table itself is
        // built by _vtinit_<Cls> at first `new`)
        int ci = 0;
        while (ci < classes.Count) {
            if (classes[ci].poly == 1) {
                dglbs.Add(new DGlob("vt." + classes[ci].name, 8, dataLen));
                dataLen = dataLen + 8;
            }
            ci = ci + 1;
        }
        EmitRtCore();
        guardDivIdx = InternStr("division by zero\n");
        guardModIdx = InternStr("division by zero (modulo)\n");
        // gen0 bakes guard sites with the source path shortened to its
        // last two components ("selfhost/kernel10.zan")
        string gfile = srcFile;
        int lastSlash = -1;
        int prevSlash = -1;
        int si = srcFile.IndexOf("/");
        while (si >= 0) { prevSlash = lastSlash; lastSlash = si; si = srcFile.IndexOf("/", si + 1); }
        if (lastSlash >= 0 && prevSlash >= 0) {
            gfile = srcFile.Substring(prevSlash + 1, srcFile.Length - prevSlash - 1);
        }
        guardFileIdx = InternStr(gfile);
        guardStrIdx = InternStr("string index out of bounds\n");
        guardSubIdx = InternStr("substring index out of bounds\n");
        guardListIdx = InternStr("list index out of bounds\n");
        guardArrIdx = InternStr("array index out of bounds\n");
        guardArrNeg = InternStr("negative array length\n");
        guardArrOvf = InternStr("array allocation overflow\n");
        guardArrFail = InternStr("array allocation failed\n");
        guardArrNull = InternStr("null reference where an array is required (.Length)\n");
        guardStrNull = InternStr("null reference where a string is required\n");
        if (mainCls == null || mainCls == "") {
            diags.Error("ngen: no static Main() found", 0, 0);
            return txt;
        }
        EmitMainShim();
        int mi = 0;
        while (mi < methNodes.Count) {
            // generic declarations are templates: only their
            // specializations carry bodies (RunSpecPipeline built them)
            if (!HasTypeParams(methNodes[mi]) && !HasMod(methNodes[mi], MOD.Extern())) {
                // ngen_async hook D: an async method emits its ramp + $resume
                // state machine instead of an ordinary body
                if (IsAsync(methNodes[mi])) {
                    EmitAsyncMethodNg(methCls[mi], methNodes[mi], mi);
                } else {
                    EmitMethod(methCls[mi], methNodes[mi], mi);
                }
            }
            mi = mi + 1;
        }
        ci = 0;
        while (ci < classes.Count) {
            if (classes[ci].poly == 1) { EmitVtInit(classes[ci]); }
            ci = ci + 1;
        }
        EmitDelegateThunks();
        EmitBindingAccessors();
        HostEmitPackedSlice();
        EmitClsNameFn();
        RtEmitStrpool();
        Patch();
        return BuildMachO();
    }

    void CollectMethods(Node cls) {
        int i = 0;
        bool hasCtor = false;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl()) {
                // ngen_async hook E: async methods join the signature tables
                // (their ramps are call targets); an async Main is driven by
                // the entry shim (hook F) instead of a direct call
                if (HasMod(m, MOD.Extern())) { CheckExternNg(m); }
                if (m.sval == "Main" && HasMod(m, MOD.Static()) && !HasMod(m, MOD.Extern())) {
                    mainCls = cls.sval;
                    mainAsync = IsAsync(m);
                }
                AddMethNg(m, cls.sval, HasMod(m, MOD.Static()) ? 1 : 0);
            }
            if (m.kind == AK.CtorDecl()) {
                // `static T()` is a type initializer (methStat 3), not a
                // constructor: it takes no `this`, is never selected by
                // `new T(...)`, and runs once at program entry in
                // declaration order (gen0 parity)
                if (!HasMod(m, MOD.Static())) { hasCtor = true; }
                AddMethNg(m, cls.sval, HasMod(m, MOD.Static()) ? 3 : 2);
            }
            i = i + 1;
        }
        // a class with no declared ctors gets the synthesized parameterless
        // one, which is what runs its instance field initializers (and the
        // base chain) when `new T()` finds it
        if (!hasCtor) {
            Node dc = new Node(AK.CtorDecl());
            dc.mods = HasMod(cls, MOD.Static()) ? MOD.Static() : 0;
            AddMethNg(dc, cls.sval, 2);
        }
    }

    bool HasMod(Node m, int flag) { return (m.mods / flag) - ((m.mods / flag) / 2) * 2 == 1; }
    bool IsAsync(Node m) { return HasMod(m, MOD.Async()); }

    // Same raw C name as Irgen.ExternName; Mach-O adds exactly one '_'.
    string ExternSymNg(Node m) {
        return "_" + (m.sval2 != null && m.sval2 != "" ? m.sval2 : m.sval);
    }

    // Types an extern can take or return, matched to the oracle zanc ABI as
    // probed from its arm64 codegen: integer-class values (pointers, nint,
    // narrow ints) pass in x/w registers; float/double take the independent
    // v0-v7 fp registers (AAPCS64: ldexp(3.5, 3) emits fmov d0 + mov w0);
    // arrays pass their data pointer exactly like strings (element 0 sits at
    // the array value itself, length at value-16).
    bool ExternTyNg(string t) {
        if (t == "string" || t == "int" || t == "long") { return true; }
        if (t == "nint" || t == "UIntPtr" || t == "ulong" || t == "uint") { return true; }
        if (t == "short" || t == "ushort" || t == "byte" || t == "sbyte"
                || t == "char" || t == "bool") { return true; }
        if (t == "float" || t == "double") { return true; }
        // delegates pass as their closure value: a pointer to the
        // {thunk, env} block, an ordinary integer-class word
        if (IsDelegateTyNg(t)) { return true; }
        return IsArrTy(t);
    }

    bool ExternFpTy(string t) { return t == "float" || t == "double"; }

    // Span<T> raw-memory view (binder builtin generic; gen0
    // irgen_expr.c emit_struct_elem_ptr span path): `new Span<T>(base, len)`
    // holds a raw pointer and element i sits at base + i*esz, bounds-checked
    // against the view length. The value representation is the base pointer;
    // the length expression is re-read at each indexed access (stdlib views
    // are built from pure pointer arithmetic).
    bool IsSpanNew(Node e) {
        return e != null && e.kind == AK.NewExpr() && e.type != null
            && e.type.sval == "Span" && e.kids != null && e.kids.Count == 2;
    }

    string SpanElemTy(Node sn) {
        if (sn.type != null && sn.type.kids != null && sn.type.kids.Count > 0) {
            return TypeFullName(sn.type.kids[0]);
        }
        return "long";
    }

    int SpanElemSize(Node sn) {
        string el = SpanElemTy(sn);
        if (el == "byte" || el == "sbyte") { return 1; }
        if (el == "short" || el == "ushort" || el == "char") { return 2; }
        if (el == "int" || el == "uint" || el == "float") { return 4; }
        return 8;
    }

    // element type/size of a declared "Span<T>" type-name string
    string SpanTyElem(string st) {
        int p = st.IndexOf("<");
        if (p < 0) { return "long"; }
        return st.Substring(p + 1, st.Length - p - 2);
    }
    int SpanTyElemSize(string st) {
        string el = SpanTyElem(st);
        if (el == "byte" || el == "sbyte") { return 1; }
        if (el == "short" || el == "ushort" || el == "char") { return 2; }
        if (el == "int" || el == "uint" || el == "float") { return 4; }
        return 8;
    }

    // declared Span<T> type of a plain local or field used as an indexing
    // target (`Span<byte> sp; sp[i]`), or null. The view's base pointer is
    // the value; the length is not carried with it (single-word value
    // convention -- a deviation from the oracle's {base,len} struct), so
    // accesses through these views are not bounds-guarded; the stdlib view
    // creators (ByteBuffer) range-check before spanning.
    string SpanContainerTy(Node e) {
        if (e == null || e.kind != AK.Ident()) { return null; }
        int li = LocalIdx(e.sval);
        if (li >= 0 && locTy[li] != null && locTy[li].IndexOf("Span<") == 0) { return locTy[li]; }
        Fld f = CurField(e.sval);
        if (f != null && f.ty != null && f.ty.IndexOf("Span<") == 0) { return f.ty; }
        return null;
    }

    // x0 = element at [x1 base + x0 idx * esz], shaped to the internal value
    // convention (narrow ints extended, float/double as bit patterns)
    void EmitSpanElemLoad(string el, int esz) {
        if (el == "byte") { E4(0x38606820); return; }          // ldrb w0, [x1, x0]
        if (el == "sbyte") { E4(0x38A06820); return; }         // ldrsb x0, [x1, x0]
        if (el == "short") { E4(0x78A07820); return; }         // ldrsh x0, [x1, x0, lsl #1]
        if (el == "ushort" || el == "char") { E4(0x78607820); return; }    // ldrh w0, [x1, x0, lsl #1]
        if (el == "int") { E4(0xB8A07820); return; }           // ldrsw x0, [x1, x0, lsl #2]
        if (el == "uint") { E4(0xB8607820); return; }          // ldr w0, [x1, x0, lsl #2]
        if (el == "float") {
            E4(0xBC607820);                                    // ldr s0, [x1, x0, lsl #2]
            E4(0x1E22C000);                                    // fcvt d0, s0
            E4(0x9E660000);                                    // fmov x0, d0
            return;
        }
        if (el == "double") {
            E4(0xFC607820);                                    // ldr d0, [x1, x0, lsl #3]
            E4(0x9E660000);                                    // fmov x0, d0
            return;
        }
        if (esz == 4) { E4(0xB8A07820); return; }
        E4(0xF8607820);                                        // ldr x0, [x1, x0, lsl #3]
    }

    // [x1 base + x0 idx * esz] = x3 (value register), shaped from the
    // internal value convention
    void EmitSpanElemStore(string el, int esz) {
        if (el == "byte" || el == "sbyte") { E4(0x38206823); return; }     // strb w3, [x1, x0]
        if (el == "short" || el == "ushort" || el == "char") { E4(0x78207823); return; }   // strh w3, [x1, x0, lsl #1]
        if (el == "int" || el == "uint") { E4(0xB8207823); return; }       // str w3, [x1, x0, lsl #2]
        if (el == "float") {
            E4(0x9E670064);                                    // fmov d4, x3
            E4(0x1E624084);                                    // fcvt s4, d4
            E4(0xBC207824);                                    // str s4, [x1, x0, lsl #2]
            return;
        }
        if (el == "double") {
            E4(0x9E670064);                                    // fmov d4, x3
            E4(0xFC207824);                                    // str d4, [x1, x0, lsl #3]
            return;
        }
        if (esz == 4) { E4(0xB8207823); return; }
        E4(0xF8207823);                                        // str x3, [x1, x0, lsl #3]
    }

    void CheckExternNg(Node m) {
        if (!HasMod(m, MOD.Static()) || HasTypeParams(m)) {
            diags.Error("ngen: extern requires a non-generic static method '" + m.sval + "'", m.line, m.col);
        }
        string rt = TypeFullName(m.type);
        if (rt != "void" && !ExternTyNg(rt)) {
            diags.Error("ngen: unsupported extern return ABI '" + rt + "' in '" + m.sval
                + "' (supported: void, string, byte[]/arrays-as-pointers, int/long/nint, narrow ints, float/double)", m.line, m.col);
        }
        int pc = ParamCount(m);
        if (pc > 24) { diags.Error("ngen: extern ABI supports at most 24 arguments in '" + m.sval + "'", m.line, m.col); }
        int i = 0;
        while (i < pc) {
            Node p = ParamAt(m, i);
            if (p == null) { return; }
            string pt = TypeFullName(p.type);
            // ref/out (p.ival) and params (p.op) pass through the existing
            // PushCallArgs machinery: GenRefArg hands the storage address,
            // the variadic tail is bundled into a packed array whose value
            // is the data pointer
            if (!ExternTyNg(pt)) {
                diags.Error("ngen: unsupported extern parameter ABI '" + pt + "' in '" + m.sval
                    + "' (supported: by-value scalars incl. nint/float/double, arrays as data pointers, ref/out, params)", m.line, m.col);
            }
            i = i + 1;
        }
    }

    // Mirror of PushCallArgs' push order: one entry per stack slot left by
    // the push phase, tagged with the extern parameter type that value was
    // converted to (that type -- not the argument expression's type -- picks
    // the AAPCS64 register class). The variadic tail contributes a single
    // bundle-array slot, matching the net stack shape.
    List<string> ExternArgClassTys(Node m, Node e) {
        List<string> res = new List<string>();
        if (e == null || e.a == null) { return res; }
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        int fixedc = variadic ? pc - 1 : pc;
        int prov = e.kids.Count;
        List<Node> ak = e.kids;
        bool hasNamed = false;
        int k = 0;
        while (k < prov) {
            if (e.kids[k].sval2 != null && e.kids[k].sval2 != "") { hasNamed = true; }
            k = k + 1;
        }
        if (hasNamed) {
            int slots = pc > prov ? pc : prov;
            int[] slot = new int[slots];
            bool[] usedName = new bool[prov];
            k = 0;
            while (k < slots) { slot[k] = -1; k = k + 1; }
            k = 0;
            while (k < prov) {
                string an = e.kids[k].sval2;
                if (an == null || an == "") { k = k + 1; continue; }
                int found = -1;
                int j = 0;
                while (j < pc) {
                    Node pp = ParamAt(m, j);
                    if (pp != null && pp.sval == an) { found = j; break; }
                    j = j + 1;
                }
                if (found >= 0 && slot[found] < 0) {
                    slot[found] = k;
                    usedName[k] = true;
                }
                k = k + 1;
            }
            int j2 = 0;
            k = 0;
            while (k < prov) {
                if (usedName[k]) { k = k + 1; continue; }
                while (j2 < pc && slot[j2] >= 0) { j2 = j2 + 1; }
                if (j2 >= pc) { break; }
                slot[j2] = k;
                j2 = j2 + 1;
                k = k + 1;
            }
            bool dense = true;
            k = 0;
            while (k < prov) {
                if (slot[k] < 0 || slot[k] >= prov) { dense = false; break; }
                k = k + 1;
            }
            if (dense) {
                ak = new List<Node>();
                k = 0;
                while (k < prov) {
                    ak.Add(e.kids[slot[k]]);
                    k = k + 1;
                }
            }
        }
        if (variadic && prov == pc && IsArrValExpr(ak[prov - 1])) {
            int i = 0;
            while (i < prov) {
                Node pp = ParamAt(m, i);
                res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
                i = i + 1;
            }
            return res;
        }
        int n = 0;
        while (n < prov && n < fixedc) {
            Node pp = ParamAt(m, n);
            res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
            n = n + 1;
        }
        while (n < fixedc) {
            Node pp = ParamAt(m, n);
            res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
            n = n + 1;
        }
        if (variadic) {
            res.Add(TypeFullName(lastP.type));           // the bundle array
        }
        return res;
    }

    // the NativeMemory.Sha256 intrinsic: zan_sha256(data, len, out32) into
    // an sp scratch block, then the oracle's string shape — str_alloc(33),
    // memcpy of the 32 raw digest bytes, header stamped len=32 — so the
    // caller owns an ARC string exactly like any other produced string
    void EmitSha256CallNg(Node e) {
        GenExpr(e.kids[0]);                          // x0 = data ptr (nint)
        AddSPImm(48, false);                         // sub sp, sp, #48
        StrU(0, 31, 0);                              // sp[0] = data
        GenExpr(e.kids[1]);                          // x0 = len
        E4(0xF100001F);                              // cmp x0, #0
        E4(0x9A80B042);                              // csel x2, xzr, x0, lt
        LdrU(0, 31, 0);                              // x0 = data
        E4(0xAA0203E1);                              // mov x1, x2 (clamped len)
        AddImm(2, 31, 16);                           // x2 = sp+16 (out32)
        BLExtern("_zan_sha256");                     // FIPS 180-4 digest
        LoadImm(0, 33);                              // 32 bytes + NUL
        BLInternal("_zan_rt_str_alloc");             // x0 = buf
        AddImm(1, 31, 16);                           // x1 = sp+16
        LoadImm(2, 32);
        BLExtern("_memcpy");                         // returns buf
        LoadImm(1, 0x5A414E5300000000);
        LoadImm(2, 32);
        E4(0xAA020021);                              // orr x1, x1, x2
        SubImm(0, 0, 8);
        StrU(1, 0, 0);                               // stamp [buf-8] len=32
        AddSPImm(48, true);                          // add sp, sp, #48
        AddImm(0, 0, 8);                             // x0 = buf
    }

    void CallStaticNg(int mi, Node e) {
        Node m = methNodes[mi];
        bool ext = HasMod(m, MOD.Extern());
        // the [DllImport] Sha256 decl only types the call: like the oracle
        // (irgen_expr.c emit_native_memory_call) the compiler lowers it as
        // an intrinsic producing an owned 32-raw-byte string
        if (m.sval == "Sha256" && methCls[mi] == "NativeMemory"
                && e.kids.Count == 2) {
            EmitSha256CallNg(e);
            return;
        }
        List<string> ats = ext ? ExternArgClassTys(m, e) : null;
        int pushed = PushCallArgs(m, e);
        // AAPCS64 allocation (extern only): the first eight integer-class
        // slots land in x0..x7 by their position among integer args; the
        // first eight float/double slots in d/s0..7 by their position among
        // fp args (moved over through scratch x10; floats narrow through
        // d31 so fcvt reads a dead temp). Quota-exhausted slots go to the
        // callee's packed stack-arg area: the reservation is made below the
        // pushes first (8-byte stride, argument order, padded so sp stays
        // 16-aligned), then every slot is read back by OFFSET from sp --
        // pops would walk into the reservation -- into its register or dest
        // slot. The caller reclaims reservation + push slots with one add
        // after the call.
        int[] ireg = null;
        int[] freg = null;
        int[] sidx = null;
        int sres = 0;
        if (ext) {
            ireg = new int[pushed];
            freg = new int[pushed];
            sidx = new int[pushed];
            int ci = 0;
            int cf = 0;
            int cs = 0;
            int pi = 0;
            while (pi < pushed) {
                string at = ats != null && pi < ats.Count ? ats[pi] : "";
                if (ExternFpTy(at)) {
                    if (cf < 8) { ireg[pi] = -1; freg[pi] = cf; cf = cf + 1; }
                    else { ireg[pi] = -2; sidx[pi] = cs; cs = cs + 1; }
                } else {
                    if (ci < 8) { ireg[pi] = ci; ci = ci + 1; }
                    else { ireg[pi] = -2; sidx[pi] = cs; cs = cs + 1; }
                }
                pi = pi + 1;
            }
            sres = cs + (cs % 2);
            if (sres > 0) {
                AddSPImm(8 * sres, false);               // sub sp, #8*sres
            }
        }
        int r = pushed - 1;
        while (r >= 0) {
            if (!ext) {
                E4(0xF84107E0 | r);                      // pop xr, keep sp 16-aligned
            } else if (sres > 0) {
                int off = 8 * sres + 16 * (pushed - 1 - r);   // slot r: arg r was pushed r-th from the bottom
                if (ireg[r] == -2) {
                    LdrU(10, 31, off);                   // ldr x10, [sp, #src]
                    if (ats[r] == "float") {
                        E4(0x9E670150);                  // fmov d16, x10
                        E4(0x1E624211);                  // fcvt s17, d16
                        E4(0xBD000000 | ((8 * sidx[r] / 4) << 10) | 17);   // str s17, [sp, #dst]
                    } else {
                        StrU(10, 31, 8 * sidx[r]);       // str x10, [sp, #dst]
                    }
                } else if (ireg[r] == -1) {
                    LdrU(10, 31, off);                   // ldr x10, [sp, #src]
                    if (ats[r] == "double") {
                        E4(0x9E670000 | (10 << 5) | freg[r]);    // fmov dN, x10
                    } else {
                        E4(0x9E670000 | (10 << 5) | 31);         // fmov d31, x10
                        E4(0x1E624000 | (31 << 5) | freg[r]);    // fcvt sN, d31
                    }
                } else {
                    LdrU(ireg[r], 31, off);              // ldr xN, [sp, #src]
                }
            } else if (ireg[r] == -1) {
                E4(0xF84107E0 | 10);                     // pop scratch x10
                if (ats[r] == "double") {
                    E4(0x9E670000 | (10 << 5) | freg[r]);    // fmov dN, x10
                } else {
                    E4(0x9E670000 | (10 << 5) | 31);         // fmov d31, x10
                    E4(0x1E624000 | (31 << 5) | freg[r]);    // fcvt sN, d31
                }
            } else {
                E4(0xF84107E0 | ireg[r]);                // pop xr, keep sp 16-aligned
            }
            r = r - 1;
        }
        if (!ext) {
            BLInternal(MethSymNg(methCls[mi], m));
            return;
        }
        // Native strings/arrays already point at their bytes; nint/long carry
        // the full pointer/integer width. C int arguments use the low wN.
        BLExtern(ExternSymNg(m));
        if (sres > 0) {
            AddSPImm(8 * sres + 16 * pushed, true);      // caller cleans dest + pushes
        }
        string rt = TypeFullName(m.type);
        // the stdlib decl says int, but the oracle lowers this call as an
        // intrinsic returning the full i64 CRC -- no sext may narrow it
        // (conformance native_memory compares it against 3421780262)
        if (m.sval == "Crc32" && methCls[mi] == "NativeMemory") { rt = "long"; }
        if (rt == "int") {
            E4(0x93407C00);                              // sxtw x0, w0 (e.g. EOF == -1)
        } else if (rt == "short") {
            E4(0x93403C00);                              // sxth x0, w0
        } else if (rt == "ushort" || rt == "char") {
            E4(0x53003C00);                              // uxth w0, w0 (zero-extends)
        } else if (rt == "uint" || rt == "bool" || rt == "byte") {
            E4(0x2A0003E0);                              // mov w0, w0 (zero-extends)
        } else if (rt == "sbyte") {
            E4(0x93401C00);                              // sxtb x0, w0
        } else if (rt == "float") {
            E4(0x1E22C000);                              // fcvt d0, s0
            E4(0x9E660000);                              // fmov x0, d0
        } else if (rt == "double") {
            E4(0x9E660000);                              // fmov x0, d0
        }
        if (ExternSymNg(m) == "_free" && e != null && e.kids.Count == 1) {
            GenInvalidateFreedStringNg(e.kids[0]);
        }
    }

    // a call to libc free() consumes its string argument: the reference nulls
    // the source reference afterwards (irgen_builtins.c
    // emit_invalidate_freed_string), so a following `== null` check agrees
    void GenInvalidateFreedStringNg(Node arg) {
        if (arg == null) { return; }
        if (arg.kind == AK.Ident()) {
            int li = LocalIdx(arg.sval);
            if (li >= 0) {
                if (locTy[li] != "string") { return; }
                LoadImm(0, 0);
                if (locRef[li]) {
                    LoadLocal(li, 1);
                    StrU(0, 1, 0);                       // store through the ref
                } else {
                    StoreLocal(li, 0);
                }
                return;
            }
            Fld fld = CurField(arg.sval);
            if (fld != null) {
                if (fld.ty != "string" || LocalIdx("this") < 0) { return; }
                LoadLocal(LocalIdx("this"), 0);          // receiver -> x0
                LoadImm(1, 0);                           // null -> x1
                StoreFieldNg(1, 0, fld);
                return;
            }
            string ssym = FindStaticSym(curCls, arg.sval);
            if (ssym != null) {
                if (FindStaticTy(curCls, arg.sval) != "string") { return; }
                LoadSymRef(ssym, 9);
                LoadImm(0, 0);
                StrU(0, 9, 0);
            }
            return;
        }
        if (arg.kind == AK.MemberAccess() && arg.a != null) {
            Fld fld = FieldOf(arg);
            if (fld == null || fld.ty != "string") { return; }
            GenExpr(arg.a);                              // receiver -> x0
            LoadImm(1, 0);                               // null -> x1
            StoreFieldNg(1, 0, fld);                     // str x1, [x0]
        }
    }

    Node FindStatic(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) { return methNodes[cs[i]]; }
            i = i + 1;
        }
        return null;
    }

    // find an instance method by name (first match across classes)
    int FindInstanceIdx(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 0) { return cs[i]; }
            i = i + 1;
        }
        return -1;
    }

    bool IsVirtualMod(Node m) { return HasMod(m, MOD.Virtual()) || HasMod(m, MOD.Override()); }
    // what occupies a vtable slot: virtual, override, or an abstract
    // declaration (interfaces are all-abstract classes)
    bool IsSlotMod(Node m) { return IsVirtualMod(m) || HasMod(m, MOD.Abstract()); }

    int IndexOfStrNg(List<string> xs, string s) {
        int i = 0;
        while (i < xs.Count) { if (xs[i] == s) { return i; } i = i + 1; }
        return -1;
    }

    int MethodCountNg(string cls, string name) {
        int n = 0;
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return 0; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] != 2) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // symbol for a method (static or instance). With a single declaration
    // the historical `_Cls_name` stands; with overloads the parameter tags
    // are appended so two methods cannot collide (mirrors CtorSymNg)
    string MethSymNg(string cls, Node m) {
        string cs = ConversionSymNg(cls, m);
        if (cs != null) { return cs; }
        if (MethodCountNg(cls, m.sval) <= 1) { return "_" + cls + "_" + m.sval; }
        string s = "_" + cls + "_" + m.sval + "__";
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTagNg(p.type); }
            i = i + 1;
        }
        return s;
    }

    // virtual-slot names of cls, base classes first; a derived
    // re-declaration of an inherited virtual keeps the base slot
    void CollectVSlotsNg(string cls, List<string> slots) {
        Cls c = FindClass(cls);
        if (c != null && c.baseName != null) { CollectVSlotsNg(c.baseName, slots); }
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return; }
        int i = 0;
        while (i < mine.Count) {
            int mi = mine[i];
            if (methStat[mi] == 0 && IsSlotMod(methNodes[mi])
                    && IndexOfStrNg(slots, methNodes[mi].sval) < 0) { slots.Add(methNodes[mi].sval); }
            i = i + 1;
        }
    }

    // slot index of `name` in the receiver's static class's vtable, or -1
    // when the call is not virtual
    int VSlotOf(string rc, string name) {
        List<string> slots = new List<string>();
        CollectVSlotsNg(rc, slots);
        return IndexOfStrNg(slots, name);
    }

    // instance-method candidates for a call on receiver class rc, derived
    // class first (shadowing picks the most-derived declaration)
    void InstanceCands(string rc, string name, List<int> outIdx) {
        string cur = rc;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == 0) { outIdx.Add(cs[i]); }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
    }

    // extension-method dispatch: `recv.Name(args)` with no instance or
    // static-through-instance match names a static method whose first
    // parameter is `this T` with T the receiver's static type (declared by
    // fn.ival == 1 in ParseParams). Candidates are ranked by temporarily
    // letting the receiver occupy the first argument slot, so the remaining
    // arguments score against parameters 1.. exactly like FitPickIdx.
    // Returns the chosen method index without mutating callNode, or -1.
    int ResolveExtNg(Node recv, string name, Node callNode) {
        string rt = ExtRecvTy(recv);
        if (rt == null) { return -1; }
        List<int> cands = new List<int>();
        List<int> nc = MethCandsName(name);
        if (nc != null) {
            int i = 0;
            while (i < nc.Count) {
                int mi = nc[i];
                Node m = methNodes[mi];
                if (methStat[mi] == 1 && m.ival == 1 && m.kids.Count > 0) {
                    Node p0 = ParamAt(m, 0);
                    string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                    if (pt == rt || (pt != null && IndexOfStrNg(DeclTps(m), pt) >= 0)) { cands.Add(mi); }
                }
                i = i + 1;
            }
        }
        if (cands.Count == 0) { return -1; }
        callNode.kids.Insert(0, recv);
        int pick = FitPickIdx(cands, callNode);
        callNode.kids.RemoveAt(0);
        return pick;
    }

    // static type name of an extension-method receiver: StaticTyOf plus the
    // literal shapes it does not cover ("hey".Shout(), (3).Twice())
    string ExtRecvTy(Node e) {
        if (e == null) { return null; }
        string t = StaticTyOf(e);
        if (t != null) { return t; }
        if (e.kind == AK.IntLit()) {
            if (e.suffix == 2 || e.suffix == 3) { return "ulong"; }
            if (e.suffix == 1) { return "long"; }
            return "int";
        }
        if (e.kind == AK.StringLit()) { return "string"; }
        if (e.kind == AK.FloatLit()) { return "double"; }
        if (e.kind == AK.BoolLit()) { return "bool"; }
        if (e.kind == AK.CharLit()) { return "char"; }
        return null;
    }

    // the op_index / op_index_set instance method of cls (its base chain),
    // or null -- the indexer protocol obj[i] dispatches through
    Node OpIndexMethod(string cls) { return OpMethodInChain(cls, "op_index"); }
    Node OpIndexSetMethod(string cls) { return OpMethodInChain(cls, "op_index_set"); }
    Node OpMethodInChain(string cls, string name) {
        string cur = cls;
        while (cur != null) {
            Node m = FindInstanceInCls(cur, name);
            if (m != null) { return m; }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    // first method of any kind whose declared name matches, or -1
    // (specialization lookups by mangled name)
    int FindMethByNameNg(string name) {
        List<int> cs = MethCandsName(name);
        return cs != null && cs.Count > 0 ? cs[0] : -1;
    }

    // property-accessor lookup: `name` (get_X / set_X) in cls's base chain,
    // statics and instance methods both qualify; the declaring class lands
    // in accOwnerCls so the symbol mangles against the right class
    string accOwnerCls;
    Node AccessorInChain(string cls, string name) {
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int st = methStat[cs[i]];
                    if (st == 0 || st == 1) {
                        accOwnerCls = cur;
                        return methNodes[cs[i]];
                    }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    // among a class's op_index / op_index_set overloads, the one whose index
    // (and, for setters, value) parameters best fit the operand types, or
    // null -- indexer overloads are distinguished by their parameter types
    Node OpIndexFit(string cls, string name, Node idxExpr, Node valExpr) {
        Node best = null;
        int bestScore = -2000000000;
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int mi = cs[i];
                    if (methStat[mi] == 0) {
                        Node m = methNodes[mi];
                        Node ip = ParamAt(m, 0);
                        if (ip == null || ip.type == null) { i = i + 1; continue; }
                        int s1 = ArgParamScore(idxExpr, TypeFullName(ip.type));
                        if (s1 <= -100) { i = i + 1; continue; }
                        int score = s1;
                        if (valExpr != null) {
                            Node vp = ParamAt(m, 1);
                            if (vp == null || vp.type == null) { i = i + 1; continue; }
                            int s2 = ArgParamScore(valExpr, TypeFullName(vp.type));
                            if (s2 <= -100) { i = i + 1; continue; }
                            score = score + s2;
                        }
                        if (score > bestScore) { bestScore = score; best = m; }
                    }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return best;
    }

    string VSlotImplCls(string cls, string name) {
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    // an abstract declaration does not implement its own slot;
                    // the search continues down the chain to the concrete body
                    if (methStat[cs[i]] == 0 && !HasMod(methNodes[cs[i]], MOD.Abstract())) { return cur; }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    Node FindInstanceInCls(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 0) { return methNodes[cs[i]]; }
            i = i + 1;
        }
        return null;
    }

    // does method m admit a call with argc arguments: the exact arity, a
    // `params` tail covering the rest, or trailing default parameters
    // filling the gap (gen0's method_accepts_arity)
    bool MethodAcceptsArity(Node m, int argc) {
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        if (variadic) { return argc >= pc - 1; }
        if (argc == pc) { return true; }
        if (argc > pc) { return false; }
        int j = argc;
        while (j < pc) {
            Node p = ParamAt(m, j);
            if (p == null || p.b == null) { return false; }
            j = j + 1;
        }
        return true;
    }

    // overload resolution among candidate method indices: exact-arity
    // candidates outrank default-filled ones, each scored by
    // argument/parameter type agreement (same shape as FitCtorIdx)
    int FitPickIdx(List<int> cands, Node callNode) {
        int argc = callNode.kids.Count;
        int exact = -1; int exactScore = -2000000000;
        int filled = -1; int filledScore = -2000000000;
        int i = 0;
        while (i < cands.Count) {
            Node m = methNodes[cands[i]];
            if (MethodAcceptsArity(m, argc)) {
                int pc = ParamCount(m);
                int score = 0;
                bool compatible = true;
                int j = 0;
                while (j < argc && compatible) {
                    if (j < pc) {
                        Node p = ParamAt(m, j);
                        string pt = p != null && p.type != null ? TypeFullName(p.type) : null;
                        if (p != null && p.op == 1 && IsArrTy(pt)) {
                            // the params tail takes every remaining argument
                            // as an element, so it is ranked against the
                            // element type -- comparing an element with the
                            // array type would disqualify the only candidate
                            // that can take the call (Calc.Sum(1, 2, 3),
                            // gen0's method_args_score). The bundle handed
                            // over whole stays exact.
                            string et = pt.Substring(0, pt.Length - 2);
                            while (j < argc) {
                                Node ta = callNode.kids[j];
                                string tat = StaticTyOf(ta);
                                if (tat != null && tat == pt) {
                                    score = score + 8;
                                } else {
                                    int es = ArgParamScore(ta, et);
                                    if (es <= -100) { compatible = false; }
                                    score = score + es;
                                }
                                j = j + 1;
                            }
                        } else {
                            int s = ArgParamScore(callNode.kids[j], pt);
                            if (s <= -100) { compatible = false; }
                            score = score + s;
                        }
                    }
                    j = j + 1;
                }
                if (compatible) {
                    if (pc == argc) {
                        if (score > exactScore) { exactScore = score; exact = cands[i]; }
                    } else {
                        if (score > filledScore) { filledScore = score; filled = cands[i]; }
                    }
                }
            }
            i = i + 1;
        }
        if (exact >= 0) { return exact; }
        return filled;
    }

    // Shared by call emission and return-type inference, so an extern's
    // signature cannot be replaced by an unrelated same-named method.
    int ResolveStaticNg(Node e) {
        if (e.a == null) { return -1; }
        Node callee = e.a;
        string cls = curCls;
        bool bare = callee.kind == AK.Ident();
        if (!bare) {
            if (callee.kind != AK.MemberAccess() || callee.a == null
                    || callee.a.kind != AK.Ident() || FindClass(callee.a.sval) == null) { return -1; }
            cls = callee.a.sval;
        }
        List<int> cands = new List<int>();
        while (cls != null) {
            List<int> cs = MethCandsClsName(cls, callee.sval);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == 1) { cands.Add(cs[i]); }
                    i = i + 1;
                }
            }
            Cls c = FindClass(cls);
            cls = c != null ? c.baseName : null;
        }
        if (bare && cands.Count == 0) {
            // An implicit this member outranks the legacy global-static
            // fallback (Lexer.Ident must not resolve to TK.Ident).
            if (LocalIdx("this") >= 0) {
                List<int> inst = new List<int>();
                InstanceCands(curCls, callee.sval, inst);
                if (inst.Count > 0) { return -1; }
            }
            List<int> gs = MethCandsName(callee.sval);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    if (methStat[gs[i]] == 1) { cands.Add(gs[i]); }
                    i = i + 1;
                }
            }
        }
        if (cands.Count == 0) { return -1; }
        int pick = cands.Count == 1 ? cands[0] : FitPickIdx(cands, e);
        return pick >= 0 ? pick : cands[0];
    }

    // find a static method declared by exactly this class (Class.Method()
    // form -- FindStaticIdx only matches by bare name)
    int FindStaticInCls(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) { return cs[i]; }
            i = i + 1;
        }
        return -1;
    }

    // does the named class declare a constructor?
    bool ClassHasCtor(string cls) {
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return false; }
        int i = 0;
        while (i < mine.Count) {
            if (methStat[mine[i]] == 2) { return true; }
            i = i + 1;
        }
        return false;
    }

    // does the program itself declare a member of that class with this
    // name? (gen0 steps its built-ins aside per member, so defining one
    // Convert or Math method does not disable the others)
    bool UserDefinesClsMember(string cls, string name) {
        return MethCandsClsName(cls, name) != null;
    }

    // which scalar flavour does this expression carry, for x.ToString()
    // rendering (null = not a scalar: leave the call to method dispatch)?
    string ScalarToStringTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.IntLit()) { return "int"; }
        if (IsBoolExpr(e)) { return "bool"; }
        if (IsStrExpr(e)) { return "string"; }
        if (IsCharExpr(e)) { return "char"; }
        if (IsDblExpr(e)) { return "double"; }
        if (IsUlongExpr(e)) { return "ulong"; }
        if (e.kind == AK.CastExpr() && e.type != null) {
            // gen0 renders uint/ushort signed too (only ulong goes unsigned)
            string t = e.type.sval;
            if (t == "double" || t == "float") { return "double"; }
            if (t == "ulong") { return "ulong"; }
            if (t == "int" || t == "long" || t == "short" || t == "byte"
                    || t == "sbyte" || t == "uint" || t == "ushort") { return "int"; }
            return null;
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) {
                string t = locTy[li];
                if (t == "int" || t == "long" || t == "short" || t == "byte"
                        || t == "sbyte" || t == "uint" || t == "ushort") { return "int"; }
                return null;
            }
            Fld f = CurField(e.sval);
            if (f != null && (f.ty == "int" || f.ty == "long"
                    || f.ty == "short" || f.ty == "byte")) { return "int"; }
            string st = FindStaticTy(curCls, e.sval);
            if (st == "int" || st == "long") { return "int"; }
            return null;
        }
        if (e.kind == AK.Call() && e.a != null) {
            string rt = CallRetTy(e);
            if (rt == "int" || rt == "long" || rt == "short" || rt == "byte") { return "int"; }
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && (f.ty == "int" || f.ty == "long"
                    || f.ty == "short" || f.ty == "byte")) { return "int"; }
        }
        return null;
    }

    // ---- method emission ----
    void EmitMainShim() {
        syms.Add(new Sym("_main", txt.Count));
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]! (save lr: bl below clobbers it)
        EmitHostEntryArgs();
        BLInternal("_zan_rt_strpool_init");              // stamp literals first
        // static field initializers run before Main, in declaration order,
        // then each `static T()` type initializer in declaration order (gen0
        // parity: entry-time runs give the same observable order for a
        // single-file program and avoid a per-type guard on static access)
        int si2 = 0;
        while (si2 < sfInitCls.Count) {
            curCls = sfInitCls[si2];
            Cls initClass = FindClass(curCls);
            bool openGeneric = initClass != null && initClass.tps.Count > 0 && curCls.IndexOf("<") < 0;
            if (!openGeneric) {
                GenExpr(sfInitExpr[si2]);
                // narrow a long-valued literal into a declared int static
                string ity = si2 < sfInitTy.Count ? sfInitTy[si2] : null;
                if (ity == "int" && !IsDblExpr(sfInitExpr[si2]) && !IsStrExpr(sfInitExpr[si2])) {
                    E4(0x93407C00);                      // sxtw x0, w0
                }
                if (ity == "float") { NarrowF32(); }
                LoadSymRef(sfInitSym[si2], 9);
                StrU(0, 9, 0);
            }
            si2 = si2 + 1;
        }
        int ci3 = 0;
        while (ci3 < methStat.Count) {
            if (methStat[ci3] == 3) { BLInternal("_" + methCls[ci3] + "_cctor"); }
            ci3 = ci3 + 1;
        }
        curCls = mainCls;
        int mainIdx = FindStaticInCls(mainCls, "Main");
        if (mainIdx >= 0 && ParamCount(methNodes[mainIdx]) == 1) {
            Node p = ParamAt(methNodes[mainIdx], 0);
            if (p.type != null && TypeFullName(p.type) == "string[]") { EmitMainArgsNg(); }
        }
        if (mainAsync && mainIdx >= 0) {
            // ngen_async hook F: async Main runs through the shim's pump
            EmitAsyncMainDriveNg(mainIdx);               // x0 = exit code
        } else {
            BLInternal("_" + mainCls + "_Main");
            // Main's int return IS the process exit status (oracle parity:
            // `static int Main() { return 7; }` exits 7); void Main and the
            // no-Main-shape leave a defined 0
            if (mainIdx < 0 || TypeFullName(methNodes[mainIdx].type) == "void") {
                E4(0xD2800000);                          // movz x0, #0
            }
        }
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    // Materialize Main(string[] args), excluding argv[0]. Use the ordinary
    // array header and owning host string copies, not the borrowed C argv.
    void EmitMainArgsNg() {
        Node env = new Node(AK.Ident()); env.sval = "Environment";
        Node member = new Node(AK.MemberAccess()); member.a = env; member.sval = "ArgCount";
        Node count = new Node(AK.Call()); count.a = member;
        GenArrNew(count, 8);
        E4(0xF81F0FE0);                              // stack[16] = array
        LoadImm(0, 0);
        E4(0xF81F0FE0);                              // stack[0] = index
        int loop = NL(); int done = NL();
        Mark(loop);
        LdrU(9, 31, 16);
        SubImm(10, 9, 16); LdrU(10, 10, 0);         // array count
        LdrU(0, 31, 0);
        E4(0xEB0A001F);                              // cmp x0, x10
        EmitBcond(10, done);                         // b.ge done
        BLInternal("_zan_host_argat");              // owning string copy
        LdrU(9, 31, 16); LdrU(10, 31, 0);
        E4(0xF82A7920);                              // str x0, [x9, x10, lsl #3]
        AddImm(10, 10, 1); StrU(10, 31, 0);
        EmitB(loop);
        Mark(done);
        AddSPImm(16, true);
        E4(0xF84107E0);                              // array -> first Main argument
    }

    void EmitMethod(string cls, Node m, int mi) {
        curCls = cls;
        curMeth = m;
        bool inst = methStat[mi] == 0 || methStat[mi] == 2;
        if (methStat[mi] == 2) {
            // a per-instantiation ctor spec emits under its own symbol
            // (the open class's _Cls_ctor symbol would collide); the tag
            // shape must match what InstCtorSpecNg emitted at call sites
            syms.Add(new Sym(m.sval2 != null && m.sval2 != ""
                ? CtorSpecSymOf(m.sval, cls, m) : CtorSymNg(cls, m), txt.Count));
        } else if (methStat[mi] == 3) {
            syms.Add(new Sym("_" + cls + "_cctor", txt.Count));
        } else {
            syms.Add(new Sym(MethSymNg(cls, m), txt.Count));
        }
        InitLocalsNg();
        // instance methods and ctors take `this` as their first argument;
        // a specialization of a generic-class method types `this` as the
        // instantiation ("Pool<Conn>") so field types substitute
        if (inst) {
            AddLoc("this", m.sval2 != null && m.sval2 != "" ? m.sval2 : cls, false);
        }
        // params get frame slots; the prologue stores x0.. into them in order.
        // An out/ref parameter's slot holds the caller's storage ADDRESS
        // (gen0's byref protocol): reads and writes go through it
        int pi = 0;
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                AddLoc(p.sval, TypeFullName(p.type), p.ival == 1);
                if (locTy[nloc - 1] == "string") { locOpaq[nloc - 1] = 1; }
            }
            pi = pi + 1;
        }
        ReserveLocals(m.d);
        curHasTry = HasTry(m.d);
        if (curHasTry) {
            // EH bookkeeping locals: the top mirror, the outermost open
            // try's arm base, and the loop-entry top for break/continue
            AddLoc("#ehtop", "int", false);
            AddLoc("#ehbase", "int", false);
            AddLoc("#ehbrk", "int", false);
            ehTopLocal = nloc - 3;
            ehBaseLocal = nloc - 2;
            ehBrkLocal = nloc - 1;
        }
        frame = 16 * nloc;
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]!
        E4(0x910003FD);                                  // mov x29, sp
        if (frame > 0) { AddSPImm(frame, false); }       // sub sp, sp, #frame
        pi = 0;
        int argReg = 0;
        if (inst) {
            StoreLocal(0, 0);        // this
            argReg = 1;
        }
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                StoreLocal(argReg, argReg);
                argReg = argReg + 1;
            }
            pi = pi + 1;
        }
        if (curHasTry) {
            BLInternal("_zan_rt_eh_state");              // x0 = state
            LdrU(1, 0, 0);                               // top at entry
            StoreLocal(ehTopLocal, 1);                   // start the mirror
        }
        // ctor initializer chaining (gen0 parity). `: this(args)` runs
        // another ctor of the same class first (it owns the base chain) and
        // is mutually exclusive with base chaining; otherwise `: base(args)`
        // explicitly, or the parameterless base ctor implicitly -- base
        // fields are a layout prefix, so the base ctor runs on `this`
        // before the body
        if (methStat[mi] == 2 && m.c != null) {
            int tix = FitCtorIdx(cls, m.c, false, m);
            if (tix >= 0) {
                int tpushed = PushCallArgs(methNodes[tix], m.c);
                int tr = tpushed;
                while (tr >= 1) { E4(0xF84107E0 | tr); tr = tr - 1; } // args reversed
                LoadLocal(0, 0);                                 // this -> x0
                BLInternal(CtorSymNg(cls, methNodes[tix]));
            } else {
                diags.Error("ngen: no matching 'this' constructor with "
                    + m.c.kids.Count + " argument(s)", m.line, m.col);
            }
        } else if (methStat[mi] == 2) {
            Cls c = FindClass(cls);
            if (c != null && c.baseName != null) {
                int bix;
                Node zerocall = new Node(AK.Call());
                if (m.b != null) {
                    bix = FitCtorIdx(c.baseName, m.b, false, null);
                } else {
                    bix = FitCtorIdx(c.baseName, zerocall, true, null);
                }
                if (bix >= 0) {
                    int bpushed;
                    if (m.b != null) {
                        bpushed = PushCallArgs(methNodes[bix], m.b);
                    } else {
                        bpushed = 0;
                    }
                    int br = bpushed;
                    while (br >= 1) { E4(0xF84107E0 | br); br = br - 1; } // args reversed
                    LoadLocal(0, 0);                             // this -> x0
                    BLInternal(CtorSymNg(c.baseName, methNodes[bix]));
                }
            }
        }
        // instance field initializers run after the base chain and before
        // the body, once per ctor (a `: this(...)` delegator lets the
        // chain target run them, so it skips its own)
        if (methStat[mi] == 2 && m.c == null) {
            // a per-instantiation ctor spec substitutes T in field
            // initializers too -- they lower through the same open nodes
            // (a `new Dict<T, int>()` initializer must specialize as well)
            bool specCtor = m.sval2 != null && m.sval2 != "";
            Cls sc = specCtor ? FindClass(cls) : null;
            List<string> sargs = null;
            if (specCtor) {
                int slt = m.sval2.IndexOf("<");
                sargs = SplitTyArgs(m.sval2.Substring(slt + 1, m.sval2.Length - slt - 2));
            }
            int fi2 = 0;
            while (fi2 < ifInitCls.Count) {
                if (ifInitCls[fi2] == cls) {
                    Fld initFld = FindField(FindClass(cls), ifInitName[fi2]);
                    string fty = initFld.ty;
                    Node iex = ifInitExpr[fi2];
                    if (specCtor) {
                        fty = SubstTy(fty, sc.tps, sargs);
                        iex = CloneNode(iex);
                        if (iex != null) { SubstTypeNode(iex, sc.tps, sargs); }
                    }
                    GenExpr(iex);
                    if (IsDblTy(fty) && !IsDblExpr(iex)) {
                        ConvI2D();
                    } else if (fty == "int" && !IsDblExpr(iex) && !IsStrExpr(iex)) {
                        E4(0x93407C00);                  // sxtw x0, w0 (long literal -> int)
                    }
                    E4(0xF81F0FE0);                          // push value
                    LoadLocal(0, 0);                         // this -> x0
                    E4(0xF84107E1);                          // pop value -> x1
                    StoreFieldNg(1, 0, initFld);
                }
                fi2 = fi2 + 1;
            }
        }
        if (m.d != null) { GenStmt(m.d); }
        E4(0xD2800000);                                  // movz x0, #0 (fallthrough)
        Epilogue();
    }

    // does this statement subtree contain a try anywhere (clauses chain
    // through their .b slot)?
    bool HasTry(Node n) {
        if (n == null) { return false; }
        if (n.kind == AK.TryStmt()) { return true; }
        // lock lowers to try/finally at emission: its EH bookkeeping slots
        // and the state-top mirror must be reserved exactly like a try's
        if (n.kind == AK.LockStmt()) { return true; }
        if (n.kind == AK.CatchClause()) {
            Node cc = n;
            while (cc != null) {
                if (HasTry(cc.a)) { return true; }
                cc = cc.b;
            }
            return false;
        }
        int i = 0;
        while (i < n.kids.Count) { if (HasTry(n.kids[i])) { return true; } i = i + 1; }
        return HasTry(n.a) || HasTry(n.b) || HasTry(n.c) || HasTry(n.d);
    }

    void InitLocalsNg() {
        locName = new List<string>(); locTy = new List<string>();
        locOff = new List<int>(); locRef = new List<bool>();
        locDecl = new List<Node>(); locPrev = new List<int>();
        locOpaq = new List<int>();
        envNodes = new List<Node>(); envHeads = new List<int>();
        locHead = -1; nloc = 0;
    }

    // Frame allocation and visibility are separate. Leaving a lexical scope
    // restores its chain head, never its allocated storage.
    void AddLoc(string name, string ty, bool isRef) {
        locName.Add(name); locTy.Add(ty); locOff.Add(16 * nloc);
        locRef.Add(isRef); locDecl.Add(null); locPrev.Add(locHead);
        locOpaq.Add(0);
        locHead = nloc; nloc = nloc + 1;
    }

    // A string slot declared with an extern-call initializer carries a raw
    // host buffer: no stamped length header and bytes possibly past the
    // first NUL. Marked at the declaration only, like the C host's
    // call_targets_extern + local->opaque_string pair; reassignment never
    // clears the flag.
    void MarkOpaqIfExtern(string name, Node init) {
        if (init == null) { return; }
        int li = LocalIdx(name);
        if (li >= 0 && locTy[li] == "string" && CallTargetsExtern(init)) {
            locOpaq[li] = 1;
        }
    }

    // does this call expression directly invoke an extern-declared method?
    bool CallTargetsExtern(Node e) {
        if (e == null || e.kind != AK.Call()) { return false; }
        Node callee = e.a;
        if (callee == null) { return false; }
        string cls = null;
        string name = callee.sval;
        bool bare = callee.kind == AK.Ident();
        if (bare) {
            cls = curCls;
        } else if (callee.kind == AK.MemberAccess() && callee.a != null
                && callee.a.kind == AK.Ident() && FindClass(callee.a.sval) != null) {
            cls = callee.a.sval;
        } else {
            return false;
        }
        int found = 0;
        while (cls != null && found == 0) {
            List<int> cs = MethCandsClsName(cls, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == 1 && HasMod(methNodes[cs[i]], MOD.Extern())) { found = 1; break; }
                    i = i + 1;
                }
            }
            if (found == 0) {
                Cls c = FindClass(cls);
                cls = c != null ? c.baseName : null;
            }
        }
        if (found == 0 && bare) {
            // legacy global-static fallback for bare names
            List<int> gs = MethCandsName(name);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    if (methStat[gs[i]] == 1 && HasMod(methNodes[gs[i]], MOD.Extern())) { found = 1; break; }
                    i = i + 1;
                }
            }
        }
        return found == 1;
    }

    void AddDeclNg(Node n, string name, string ty) {
        AddLoc(name, ty, false);
        locDecl[nloc - 1] = n;
    }

    int DeclSlotNg(Node n) {
        int i = 0;
        while (i < locDecl.Count) {
            if (locDecl[i] == n) { return i; }
            i = i + 1;
        }
        return -1;
    }

    void RecordEnvNg(Node n) {
        envNodes.Add(n); envHeads.Add(locHead);
    }

    int EnterEnvNg(Node n) {
        int saved = locHead;
        if (envNodes == null) { return saved; }
        int i = envNodes.Count - 1;
        while (i >= 0) {
            if (envNodes[i] == n) { locHead = envHeads[i]; return saved; }
            i = i - 1;
        }
        return saved; // synthesized expression inherits its call site's scope
    }

    // Walk expressions left-to-right: an out declaration activates its own
    // slot for following arguments and statements, not an unrelated namesake.
    void ReserveOutDecls(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.OutArg() && n.type != null && n.sval != null && n.sval != "") {
            AddDeclNg(n, n.sval, TypeFullName(n.type));
        }
        RecordEnvNg(n);
        ReserveOutDecls(n.a); ReserveOutDecls(n.b);
        ReserveOutDecls(n.c); ReserveOutDecls(n.d);
        int i = 0;
        while (i < n.kids.Count) { ReserveOutDecls(n.kids[i]); i = i + 1; }
    }

    void ReserveScopedNg(Node n) {
        int saved = locHead;
        ReserveLocals(n);
        locHead = saved;
    }

    // `var` declarations carry no declared type; infer the slot type from the
    // initializer (or the foreach collection) exactly where the reference
    // compiler's checker does. Returns the declared name unchanged otherwise.
    string InferDeclTyNg(Node s) {
        string decl = s.type != null ? TypeFullName(s.type) : null;
        if (decl != null && decl != "") { return decl; }
        // the parser represents `var` as a null type node
        if (s.b == null) {
            diags.Error("ngen: 'var' declaration '" + s.sval + "' needs an initializer", s.line, s.col);
            return "int";
        }
        string inf = InferExprTyNg(s.b);
        if (inf == null || inf == "") {
            diags.Error("ngen: cannot infer the type of 'var' declaration '" + s.sval + "'", s.line, s.col);
            return "int";
        }
        return inf;
    }

    string InferForeachTyNg(Node s) {
        string decl = s.type != null ? TypeFullName(s.type) : null;
        if (decl != "var" && decl != null && decl != "") { return decl; }
        string el = null;
        string at = ArrContainerTy(s.b);
        if (at != null && at.Length > 2) { el = at.Substring(0, at.Length - 2); }
        else {
            string ct = StaticTyOf(s.b);
            if (ct != null && ct.IndexOf("List<") == 0 && ct.Substring(ct.Length - 1, 1) == ">") {
                el = ct.Substring(5, ct.Length - 6);
            }
        }
        if (el == null) {
            diags.Error("ngen: cannot infer the item type of the foreach collection", s.line, s.col);
            return "int";
        }
        return el;
    }

    string InferExprTyNg(Node e) {
        if (e == null) { return null; }
        int k = e.kind;
        if (k == AK.StringLit()) { return "string"; }
        if (k == AK.CharLit()) { return "char"; }
        if (k == AK.IntLit()) { return "int"; }
        if (k == AK.BoolLit()) { return "bool"; }
        if (k == AK.FloatLit()) { return "double"; }
        if (k == AK.NullLit()) { return "object"; }
        if (k == AK.NewExpr()) {
            if (e.type == null) { return null; }
            return e.ival == 1 ? TypeFullName(e.type) + ArrSuffix(1 + e.op) : TypeFullName(e.type);
        }
        if (k == AK.CastExpr() || k == AK.AsExpr()) { return e.type != null ? TypeFullName(e.type) : null; }
        if (k == AK.Call()) { return CallRetTy(e); }
        if (k == AK.Ident()) { return NamedSlotTy(e.sval); }
        if (k == AK.Index()) { return ElemTyOf(e); }
        if (k == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null ? f.ty : StaticTyOf(e);
        }
        if (k == AK.Conditional()) {
            string a = InferExprTyNg(e.b);
            return a != null ? a : InferExprTyNg(e.c);
        }
        if (k == AK.Binary() && e.op == TK.QQ()) {
            string qa = InferExprTyNg(e.a);
            return qa != null ? qa : InferExprTyNg(e.b);
        }
        if (k == AK.Binary() && e.op == TK.Plus()) {
            string la = InferExprTyNg(e.a);
            string lb = InferExprTyNg(e.b);
            if (la == "string" || lb == "string") { return "string"; }
            return la != null ? la : lb;
        }
        if (IsDblExpr(e)) { return "double"; }
        // ngen_async hook C: `await F()` yields F's element type
        if (k == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a); }
        return null;
    }

    void ReserveLocals(Node s) {
        if (s == null) { return; }
        // compound-assign single-eval temps join the scope BEFORE the env
        // snapshot, so the statement's codegen pass can resolve them
        if (s.kind == AK.ExprStmt()) { StampCompoundTemps(s.a); }
        RecordEnvNg(s);
        int k = s.kind;
        if (k == AK.Block()) {
            int saved = locHead;
            int i = 0;
            while (i < s.kids.Count) { ReserveLocals(s.kids[i]); i = i + 1; }
            locHead = saved;
        } else if (k == AK.VarDecl()) {
            ReserveOutDecls(s.b);
            AddDeclNg(s, s.sval, InferDeclTyNg(s));
            MarkOpaqIfExtern(s.sval, s.b);
            int di = 0;
            while (di < s.kids.Count) {
                Node d = s.kids[di];
                ReserveOutDecls(d.b);
                AddDeclNg(d, d.sval, InferDeclTyNg(d));
                MarkOpaqIfExtern(d.sval, d.b);
                di = di + 1;
            }
        } else if (k == AK.IfStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.a);
            ReserveScopedNg(s.b); ReserveScopedNg(s.c);
            locHead = saved;
        } else if (k == AK.WhileStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.a); ReserveScopedNg(s.b);
            locHead = saved;
        } else if (k == AK.DoWhileStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.a); ReserveScopedNg(s.b);
            locHead = saved;
        } else if (k == AK.ForStmt()) {
            int saved = locHead;
            ReserveLocals(s.a); ReserveOutDecls(s.b);
            ReserveScopedNg(s.d); ReserveOutDecls(s.c);
            locHead = saved;
        } else if (k == AK.ForeachStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.b);
            AddDeclNg(s, s.sval, InferForeachTyNg(s));
            AddLoc("#fei", "int", false);
            ReserveScopedNg(s.c);
            locHead = saved;
        } else if (k == AK.TryStmt()) {
            ReserveScopedNg(s.a);
            Node cc = s.b;
            while (cc != null) {
                int saved = locHead;
                RecordEnvNg(cc);
                if (cc.sval != null && cc.sval != "") {
                    AddDeclNg(cc, cc.sval, cc.type != null ? TypeFullName(cc.type) : "string");
                }
                ReserveScopedNg(cc.a);
                locHead = saved;
                cc = cc.b;
            }
            ReserveScopedNg(s.c);
        } else if (k == AK.LockStmt()) {
            // the lock's temp lives in the frame: allocate the slot NOW
            // (ReserveLocals runs before the frame size freezes and before
            // the #ehtop/#ehbase/#ehbrk slots are appended) and stash the
            // decl node in s.c for the emission pass
            ReserveOutDecls(s.a);
            Node d = new Node(AK.VarDecl());
            d.sval = "$lock" + lockSeq;
            lockSeq = lockSeq + 1;
            d.b = s.a;
            AddDeclNg(d, d.sval, InferExprTyNg(s.a));
            s.c = d;
            int saved = locHead;
            ReserveScopedNg(s.b);
            locHead = saved;
        } else if (k == AK.SwitchStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.a);
            int i = 0;
            while (i < s.kids.Count) {
                ReserveOutDecls(s.kids[i].a);
                ReserveScopedNg(s.kids[i].b);
                i = i + 1;
            }
            locHead = saved;
        } else if (k == AK.ExprStmt()) {
            ReserveOutDecls(s.a);
        } else {
            ReserveOutDecls(s.a); ReserveOutDecls(s.b);
            ReserveOutDecls(s.c); ReserveOutDecls(s.d);
        }
    }

    // a compound assignment whose target is an element/field place gets its
    // container and index pre-evaluated into hidden slots so the read and
    // the store see one evaluation each (`box.data[Next()] += 5` must call
    // Next() once); the stamped names ride on the statement's sval2
    void StampCompoundTemps(Node e) {
        if (e == null || e.kind != AK.Assignment()) { return; }
        if (e.op == TK.Eq() || e.op == TK.QQEq()) { return; }
        Node t = e.a;
        if (t == null) { return; }
        int seq = ctmpSeq;
        if (t.kind == AK.Index()) {
            string ct = InferExprTyNg(t.a);
            if (ct == null || ct == "") { return; }
            string cn = "#ca" + seq;
            string inm = "#cb" + seq;
            ctmpSeq = seq + 1;
            AddLoc(cn, ct, false);
            AddLoc(inm, "int", false);
            e.sval2 = cn + "|" + inm;
        } else if (t.kind == AK.MemberAccess()) {
            string ct = InferExprTyNg(t.a);
            if (ct == null || ct == "") { return; }
            string cn = "#ca" + seq;
            ctmpSeq = seq + 1;
            AddLoc(cn, ct, false);
            e.sval2 = cn;
        }
    }

    // evaluate the compound-assign container and index exactly once into
    // their pre-reserved hidden slots (order: container, then index)
    void GenCompoundTemps(Node e) {
        Node t = e.a;
        string tns = e.sval2;
        int bar = tns.IndexOf("|");
        string cn = bar > 0 ? tns.Substring(0, bar) : tns;
        GenExpr(t.a);
        StoreLocal(LocalIdx(cn), 0);
        if (t.kind == AK.Index()) {
            GenExpr(t.b);
            StoreLocal(LocalIdx(tns.Substring(bar + 1)), 0);
        }
    }

    // the codegen twin of StampCompoundTemps: rewrite the compound assign
    // into one whose target reads the hidden slots (each evaluated once)
    Node FlatCompoundAssign(Node e) {
        if (e == null || e.kind != AK.Assignment()) { return null; }
        if (e.op == TK.Eq() || e.op == TK.QQEq()) { return null; }
        string tns = e.sval2;
        if (tns == null || tns == "") { return null; }
        Node t = e.a;
        int bar = tns.IndexOf("|");
        string cn = bar > 0 ? tns.Substring(0, bar) : tns;
        Node cident = new Node(AK.Ident());
        cident.sval = cn;
        Node nt = null;
        if (t.kind == AK.Index() && bar > 0) {
            Node iident = new Node(AK.Ident());
            iident.sval = tns.Substring(bar + 1);
            Node ni = new Node(AK.Index());
            ni.a = cident; ni.b = iident;
            nt = ni;
        } else if (t.kind == AK.MemberAccess()) {
            Node nm = new Node(AK.MemberAccess());
            nm.a = cident; nm.sval = t.sval;
            nt = nm;
        }
        if (nt == null) { return null; }
        Node flat = new Node(AK.Assignment());
        flat.op = e.op; flat.a = nt; flat.b = e.b;
        flat.line = e.line; flat.col = e.col;
        return flat;
    }

    int LocalIdx(string name) {
        int i = locHead;
        while (i >= 0) {
            if (locName[i] == name) { return i; }
            i = locPrev[i];
        }
        return -1;
    }

    void Epilogue() {
        // reset sp from the frame pointer first: a `return` from inside a
        // switch/loop construct can leave its stack temporaries (e.g. the
        // switch discriminant) still pushed, and `add sp, sp, #frame` alone
        // would make the ldp below read x29/x30 from the wrong slot
        E4(0x910003BF);                                  // mov sp, x29
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    // ---- statements ----
    void GenStmt(Node s) {
        if (s == null) { return; }
        int saved = EnterEnvNg(s);
        GenStmtInEnvNg(s);
        locHead = saved;
    }

    void GenStmtInEnvNg(Node s) {
        PrepareDelegateStmt(s);
        if (s.line > 0) { curLine = s.line; curCol = s.col; }
        // ngen_async hook B: a discarded async call statement detaches
        if (PrepareAsyncStmtNg(s)) { return; }
        int k = s.kind;
        if (k == AK.Block()) {
            int i = 0;
            while (i < s.kids.Count) { GenStmt(s.kids[i]); i = i + 1; }
        } else if (k == AK.VarDecl()) {
            if (s.b != null) {
                string vt = s.type != null ? TypeFullName(s.type) : null;
                if (vt == null || vt == "") { vt = InferExprTyNg(s.b); }   // silent: ReserveLocals already diagnosed
                if (!TryGenBindingValue(s.b, vt)) { GenConversionValueNg(s.b, vt); }
                StoreLocal(DeclSlotNg(s), 0);
            }
            int dsi = 0;
            while (dsi < s.kids.Count) {
                Node d = s.kids[dsi];
                if (d.b != null) {
                    string dvt = d.type != null ? TypeFullName(d.type) : null;
                    if (dvt == null || dvt == "") { dvt = InferExprTyNg(d.b); }
                    if (!TryGenBindingValue(d.b, dvt)) { GenConversionValueNg(d.b, dvt); }
                    StoreLocal(DeclSlotNg(d), 0);
                }
                dsi = dsi + 1;
            }
            if (s.b == null) {
                // `S x;` with S a struct: a fresh zero-filled value (gen0
                // zero-inits inline storage); other types start unassigned
                Cls dc = s.type != null ? FindClass(TypeFullName(s.type)) : null;
                if (dc != null && dc.isStruct == 1) {
                    LoadImm(0, dc.size + 16);
                    LoadImm(1, 0);
                    BLInternal("_zan_rt_alloc");
                    StoreLocal(DeclSlotNg(s), 0);
                }
            }
        } else if (k == AK.ExprStmt()) {
            Node flat = FlatCompoundAssign(s.a);
            if (flat != null) { GenCompoundTemps(s.a); }
            GenExpr(flat != null ? flat : s.a);
        } else if (k == AK.ReturnStmt()) {
            if (s.a != null) {
                GenConversionValueNg(s.a, curMeth != null ? TypeFullName(curMeth.type) : null);
            }
            E4(0xF81F0FE0);                          // hold the result value
            EmitPendingFins(false);                  // C# runs every finally
            EhDisarmBase();                          // and disarms what they leave
            E4(0xF84107E0);
            Epilogue();
        } else if (k == AK.IfStmt()) {
            int els = NL(); int end = NL();
            GenExpr(s.a);
            EmitCBZ(0, els);
            GenStmt(s.b);
            EmitB(end);
            Mark(els);
            if (s.c != null) { GenStmt(s.c); }
            Mark(end);
        } else if (k == AK.SwitchStmt()) {
            GenSwitchStmt(s);
        } else if (k == AK.WhileStmt()) {
            int top = NL(); int outL = NL(); int cnt = NL();
            brkL.Add(outL); cntL.Add(cnt);
            brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
            cntFinBase.Add(finBodies.Count);
            if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
            Mark(top);
            GenExpr(s.a);
            EmitCBZ(0, outL);
            GenStmt(s.b);
            Mark(cnt);
            EmitB(top);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
            brkLoop.RemoveAt(brkLoop.Count - 1);
            brkFinBase.RemoveAt(brkFinBase.Count - 1);
            cntFinBase.RemoveAt(cntFinBase.Count - 1);
        } else if (k == AK.DoWhileStmt()) {
            // do body while (cond);: the continue point is the condition,
            // like the reference lowering (body -> cond -> branch)
            int top = NL(); int outL = NL(); int cnt = NL();
            brkL.Add(outL); cntL.Add(cnt);
            brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
            cntFinBase.Add(finBodies.Count);
            if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
            Mark(top);
            GenStmt(s.b);
            Mark(cnt);
            GenExpr(s.a);
            EmitCBZ(0, outL);
            EmitB(top);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
            brkLoop.RemoveAt(brkLoop.Count - 1);
            brkFinBase.RemoveAt(brkFinBase.Count - 1);
            cntFinBase.RemoveAt(cntFinBase.Count - 1);
        } else if (k == AK.ForStmt()) {
            // for (init; cond; step) body: init runs once, cond guards the
            // top, step runs at the continue point before looping back
            if (s.a != null) { GenStmt(s.a); }
            int top = NL(); int outL = NL(); int cnt = NL();
            brkL.Add(outL); cntL.Add(cnt);
            brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
            cntFinBase.Add(finBodies.Count);
            if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
            Mark(top);
            if (s.b != null) {
                GenExpr(s.b);
                EmitCBZ(0, outL);
            }
            GenStmt(s.d);
            Mark(cnt);
            if (s.c != null) { GenExpr(s.c); }
            EmitB(top);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
            brkLoop.RemoveAt(brkLoop.Count - 1);
            brkFinBase.RemoveAt(brkFinBase.Count - 1);
            cntFinBase.RemoveAt(cntFinBase.Count - 1);
        } else if (k == AK.ForeachStmt()) {
            GenForeach(s);
        } else if (k == AK.BreakStmt()) {
            if (brkL.Count == 0) {
                diags.Error("ngen: break outside loop", s.line, s.col);
            } else {
                EmitPendingFinsFrom(brkFinBase[brkFinBase.Count - 1], false);
                // a loop break also leaves every try opened inside the loop;
                // a switch break does not leave any try by itself
                if (brkLoop[brkLoop.Count - 1]) { EhDisarmLoop(); }
                EmitB(brkL[brkL.Count - 1]);
            }
        } else if (k == AK.ContinueStmt()) {
            if (cntL.Count == 0) {
                diags.Error("ngen: continue outside loop", s.line, s.col);
            } else {
                EmitPendingFinsFrom(cntFinBase[cntFinBase.Count - 1], false);
                EhDisarmLoop();
                EmitB(cntL[cntL.Count - 1]);
            }
        } else if (k == AK.TryStmt()) {
            GenTry(s);
        } else if (k == AK.LockStmt()) {
            GenLockStmt(s);
        } else if (k == AK.MonitorExitStmt()) {
            LoadLocal(DeclSlotNg(s.a), 0);
            BLExtern("_zan_monitor_exit");
        } else if (k == AK.ThrowStmt()) {
            GenThrow(s);
        } else {
            diags.Error("ngen: unsupported statement kind " + k, s.line, s.col);
        }
    }

    // foreach (T x in coll) body: collection re-evaluated each iteration
    // into a stack slot, hidden index local drives the bounds; arrays use
    // their -16 length header, lists the count field
    void GenForeach(Node s) {
        Node coll = s.b;
        bool isArr = IsArrExpr(coll);
        // strings iterate as chars: the length header and byte loads
        bool isStr = !isArr && IsStrExpr(coll);
        int esz = isArr ? ArrElemSize(ArrTyOf(coll)) : 8;
        int elemVar = DeclSlotNg(s);
        int idxVar = elemVar + 1; // this foreach's reserved hidden index
        int top = NL(); int outL = NL(); int cnt = NL();
        brkL.Add(outL); cntL.Add(cnt);
        brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
        cntFinBase.Add(finBodies.Count);
        if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
        LoadImm(0, 0);
        StoreLocal(idxVar, 0);
        Mark(top);
        GenExpr(coll);
        E4(0xF81F0FE0);                              // push coll
        if (isArr) {
            E4(0xF85F0002);                          // ldur x2, [x0, #-16] (len)
        } else if (isStr) {
            E4(0xD1002002);                          // sub x2, x0, #8
            E4(0xF9400042);                          // ldr x2, [x2]
            E4(0xD3407C42);                          // ubfm x2, x2, #0, #31
        } else {
            LdrU(2, 0, 0);                           // x2 = count
        }
        LoadLocal(idxVar, 0);                        // x0 = i (coll now only on the stack)
        E4(0xEB02001F);                              // cmp x0, x2
        int popOut = NL();
        EmitBcond(10, popOut);                       // b.ge popOut (coll still pushed)
        if (isArr) {
            E4(0xF84107E2);                          // pop coll -> x2
            EmitArrElemLoad(esz, ArrElemName(ArrTyOf(coll)), 2, 0, 0);
        } else if (isStr) {
            E4(0xF84107E2);                          // pop coll -> x2
            E4(0x38606840);                          // ldrb w0, [x2, x0]
        } else {
            LdrU(3, 31, 0);                          // x3 = coll (stack slot)
            LdrU(3, 3, 16);                          // x3 = data
            E4(0xF8607860);                          // ldr x0, [x3, x0, lsl #3]
            E4(0xF84107E2);                          // pop coll (discard)
        }
        StoreLocal(elemVar, 0);
        GenStmt(s.c);
        Mark(cnt);
        LoadLocal(idxVar, 0);
        AddImm(0, 0, 1);
        StoreLocal(idxVar, 0);
        EmitB(top);
        Mark(popOut);
        E4(0xF84107E2);                              // pop coll (discard)
        EmitB(outL);
        Mark(outL);
        brkL.RemoveAt(brkL.Count - 1);
        cntL.RemoveAt(cntL.Count - 1);
        brkLoop.RemoveAt(brkLoop.Count - 1);
        brkFinBase.RemoveAt(brkFinBase.Count - 1);
        cntFinBase.RemoveAt(cntFinBase.Count - 1);
    }

    // ---- expressions: result in x0 ----
    // switch (disc) { case C: ... default: ... }: a compare chain like
    // gen0's constant lowering (the selfhost parser only produces constant
    // cases). The discriminant stays at [sp] for the whole statement; every
    // case body and the default arm end at the shared exit, where it is
    // popped. `break` inside a case targets the switch exit, not an
    // enclosing loop; `continue` keeps targeting the loop.
    void GenSwitchStmt(Node s) {
        int endL = NL();
        int defL = NL();
        GenExpr(s.a);
        E4(0xF81F0FE0);                                  // push discriminant
        int nc = s.kids.Count;
        int[] bodies = new int[nc];
        int defIdx = -1;
        int i = 0;
        while (i < nc) {
            Node c = s.kids[i];
            if (c.a == null) { defIdx = i; i = i + 1; continue; }
            bodies[i] = NL();
            if (IsStrExpr(s.a)) {
                GenExpr(c.a);                            // x0 = case label
                LdrU(1, 31, 0);                          // x1 = discriminant
                BLExtern("_strcmp");
                E4(0xEB1F001F);                          // cmp x0, xzr
            } else {
                GenExpr(c.a);                            // x0 = case label
                E4(0xF81F0FE0);                          // push label
                LdrU(1, 31, 16);                         // x1 = discriminant
                E4(0xF84107E0);                          // pop label -> x0
                E4(0xEB01001F);                          // cmp x0, x1
            }
            EmitBcond(0, bodies[i]);                     // b.eq body
            i = i + 1;
        }
        EmitB(defIdx >= 0 ? defL : endL);
        brkL.Add(endL);
        brkLoop.Add(false); brkFinBase.Add(finBodies.Count);
        i = 0;
        while (i < nc) {
            Node c = s.kids[i];
            if (c.a == null) { i = i + 1; continue; }
            Mark(bodies[i]);
            GenStmt(c.b);
            // an empty case body falls through to the next case (C# rule);
            // only a body that emitted code needs the jump to the exit
            if (c.b == null || c.b.kids.Count > 0) { EmitB(endL); }
            i = i + 1;
        }
        if (defIdx >= 0) {
            Mark(defL);
            GenStmt(s.kids[defIdx].b);
            EmitB(endL);
        }
        brkL.RemoveAt(brkL.Count - 1);
        brkLoop.RemoveAt(brkLoop.Count - 1);
        brkFinBase.RemoveAt(brkFinBase.Count - 1);
        Mark(endL);
        E4(0xF84107E0);                                  // pop discriminant
    }

    void GenExpr(Node e) {
        int saved = EnterEnvNg(e);
        GenExprInEnvNg(e);
        locHead = saved;
    }

    void GenExprInEnvNg(Node e) {
        // ngen_async hook A: `await <async call>` (root drive; diagnosed
        // inside an async body, where only statement-head awaits suspend)
        if (TryGenAwaitExprNg(e)) { return; }
        if (TryGenDelegateExpr(e)) { return; }
        if (TryGenStringRead(e)) { return; }
        int k = e.kind;
        if (k == AK.IntLit()) {
            // gen0's int-literal rule: an unsuffixed radix-2/8/16 literal in
            // the uint range types as int, so its runtime value is the
            // int-domain (two's-complement) one
            long v = e.ival;
            int sfx = e.suffix - (e.suffix / 4) * 4;
            int rad = e.suffix >= 16 ? 16 : (e.suffix >= 8 ? 8 : 0);
            if (sfx == 0 && rad != 0 && v > 2147483647 && v <= 4294967295) {
                v = v - 4294967296;
            }
            LoadImm(0, v);
        } else if (k == AK.NullLit()) {
            LoadImm(0, 0);
        } else if (k == AK.StringLit()) {
            LoadStr(InternStr(DecodeLiteralNg(e.sval)), 0);
        } else if (k == AK.BoolLit()) {
            LoadImm(0, e.ival);
        } else if (k == AK.CharLit()) {
            // a char is its codepoint in the value slot (rendering decides
            // string vs decimal per context, like gen0)
            LoadImm(0, e.ival);
        } else if (k == AK.FloatLit()) {
            // materialise the IEEE bits through libc strtod -- lazily, into
            // a zero-initialised __DATA slot (0.0 simply reconverts, so the
            // conversion path stays idempotent)
            int di = InternStr(e.sval);
            dglbs.Add(new DGlob("dbl." + di, 8, dataLen));
            dataLen = dataLen + 8;
            LoadSymRef(DGlobalSym("dbl." + di), 9);
            LdrU(0, 9, 0);
            int need = NL();
            int done = NL();
            CbzReg(0, need);
            EmitB(done);
            Mark(need);
            LoadStr(di, 0);                          // x0 = literal text
            LoadImm(1, 0);
            BLExtern("_strtod");
            E4(0x9E660000);                          // fmov x0, d0
            LoadSymRef(DGlobalSym("dbl." + di), 9);  // x9 is caller-saved: reload the slot
            StrU(0, 9, 0);
            LdrU(0, 9, 0);
            Mark(done);
        } else if (k == AK.ThisExpr()) {
            LoadLocal(LocalIdx("this"), 0);
        } else if (k == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li < 0) {
                // implicit field reference inside instance methods
                Fld fld = CurField(e.sval);
                if (fld != null) {
                    LoadLocal(LocalIdx("this"), 0);
                    LoadFieldNg(0, 0, fld);
                    return;
                }
                // static field: the value lives in a data-global slot
                string ssym = FindStaticSym(curCls, e.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    LdrU(0, 0, 0);
                    return;
                }
                // bare property read: the desugared get_Name accessor
                // (static tried first, then instance through `this`)
                Node bg = AccessorInChain(curCls, "get_" + e.sval);
                if (bg != null) {
                    if (HasMod(bg, MOD.Static())) {
                        LoadImm(0, 0);
                    } else {
                        LoadLocal(LocalIdx("this"), 0);
                    }
                    BLInternal(MethSymNg(accOwnerCls, bg));
                    return;
                }
                diags.Error("ngen: unknown identifier '" + e.sval + "'", e.line, e.col);
                LoadImm(0, 0);
                return;
            }
            if (locRef[li]) {
                LoadLocal(li, 1);                            // slot holds an address
                LdrU(0, 1, 0);                               // read through it
                return;
            }
            LoadLocal(li, 0);
        } else if (k == AK.MemberAccess()) {
            if (e.op == TK.QDot()) {
                // null-conditional access needs T? tracking (a null member
                // read is not 0 for value shapes): diagnose, never miscompile
                diags.Error("ngen: '?.' null-conditional access is not supported by the native backend", e.line, e.col);
                LoadImm(0, 0);
                return;
            }
            if (TryGenHostMember(e)) { return; }
            if (e.sval == "Count" && ExprCls(e.a) == "List") { GenListCount(e.a); }
            else if (e.sval == "Count" && ExprCls(e.a) == "Dict") { GenExpr(e.a); LdrU(0, 0, 0); }
            else if (e.sval == "Count" && e.a != null && e.a.kind == AK.MemberAccess()
                    && (e.a.sval == "Keys" || e.a.sval == "Values") && ExprCls(e.a.a) == "Dict") {
                GenListCount(e.a);                       // d.Keys.Count / d.Values.Count
            }
            else if ((e.sval == "Keys" || e.sval == "Values") && ExprCls(e.a) == "Dict") {
                // snapshot list: _zan_rt_dict_keys / _dict_values build a
                // List whose slots alias the dict's own keys/values
                GenExpr(e.a);
                BLInternal(e.sval == "Keys" ? "_zan_rt_dict_keys" : "_zan_rt_dict_values");
            }
            else if ((e.sval == "Length" || e.sval == "Count") && ArrContainerTy(e.a) != null) {
                // gen0: null report (reads the zeroed scratch afterwards),
                // length is the i64 count at arr-16; .Count is aliased to
                // .Length so a params bundle answers the List spelling too
                GenExpr(e.a);
                int badn = NL();
                int contn = NL();
                int donen = NL();
                CbzReg(0, badn);
                EmitB(contn);
                Mark(badn);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, curLine);
                LoadImm(2, curCol);
                LoadSymRef("l_.str." + guardArrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(donen);
                Mark(contn);
                E4(0xF85F0000);                      // ldur x0, [x0, #-16]
                Mark(donen);
            }
            else if (e.sval == "Length" && IsStrExpr(e.a)) {
                // gen0 probes the SNAZ header: length lives in the low 32
                // bits of the i64 at s-8; a null string reports and answers 0
                GenExpr(e.a);
                int bads = NL();
                int conts = NL();
                int dones = NL();
                CbzReg(0, bads);
                EmitB(conts);
                Mark(bads);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, curLine);
                LoadImm(2, curCol);
                LoadSymRef("l_.str." + guardStrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(dones);
                Mark(conts);
                E4(0xD1002009);                      // sub x9, x0, #8
                E4(0xF9400120);                      // ldr x0, [x9]
                E4(0xD3407C00);                      // ubfm x0, x0, #0, #31
                Mark(dones);
            }
            else if (e.a != null && e.a.kind == AK.Ident()
                    && FindEnumMemIdx(e.a.sval, e.sval) >= 0) {
                // EnumType.Member constant
                LoadImm(0, enVal[FindEnumMemIdx(e.a.sval, e.sval)]);
            }
            else { GenFieldLoad(e); }
        } else if (k == AK.Binary() && e.op == TK.AmpAmp()) {
            // short-circuit AND: the right operand runs only when the left
            // is truthy; result normalises to 0/1
            int falsL = NL();
            int endL = NL();
            GenExpr(e.a);
            CbzReg(0, falsL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(falsL);
            LoadImm(0, 0);
            Mark(endL);
        } else if (k == AK.Binary() && e.op == TK.PipePipe()) {
            int trueL = NL();
            int endL = NL();
            GenExpr(e.a);
            EmitCbnz(0, trueL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(trueL);
            LoadImm(0, 1);
            Mark(endL);
        } else if (k == AK.Binary()) {
            if (TryOpOverloadNg(e)) {
                // the overload call left its result (value or object) in x0
            } else if (TryGenConversionBinaryNg(e)) {
            } else if (e.op == TK.QQ() && QQRefShapeNg(e.a) && !IsDblExpr(e.b)) {
                // null coalescing on reference shapes: a != null ? a : b
                int useB = NL();
                int doneQQ = NL();
                GenExpr(e.a);
                EmitCBZ(0, useB);
                EmitB(doneQQ);
                Mark(useB);
                GenExpr(e.b);
                Mark(doneQQ);
            } else if ((e.op == TK.EqEq() || e.op == TK.BangEq())
                    && StructEqPair(e.a, e.b) != null) {
                // struct equality without an overload: field-wise value
                // compare (gen0's aggregate equality; a pointer compare
                // would answer false for equal copies)
                Cls sa = StructEqPair(e.a, e.b);
                if (sa != null) {
                    GenExpr(e.a);
                    E4(0xF81F0FE0);                  // push a
                    GenExpr(e.b);
                    MovRR(1, 0);                     // x1 = b (a peeked below)
                    int neq = NL();
                    int doneq = NL();
                    int fi = 0;
                    while (fi < sa.flds.Count) {
                        LoadFieldNg(2, 1, sa.flds[fi]);     // b.f
                        E4(0xF84003E3);                  // ldur x3, [sp] (a)
                        LoadFieldNg(3, 3, sa.flds[fi]);     // a.f
                        if (IsDblTy(sa.flds[fi].ty)) {
                            // floating fields compare with IEEE semantics:
                            // an unordered pair (NaN) counts as unequal, like
                            // the scalar == lowering
                            E4(0x9E670060);              // fmov d0, x3
                            E4(0x9E670041);              // fmov d1, x2
                            E4(0x1E602020);              // fcmp d1, d0
                            EmitBcond(6, neq);           // b.vs -> unequal
                            EmitBcond(1, neq);           // b.ne -> unequal
                        } else {
                            E4(0xEB02007F);              // cmp x3, x2
                            EmitBcond(1, neq);           // b.ne
                        }
                        fi = fi + 1;
                    }
                    LoadImm(0, 1);
                    EmitB(doneq);
                    Mark(neq);
                    LoadImm(0, 0);
                    Mark(doneq);
                    AddSPImm(16, true);                  // drop a
                    if (e.op == TK.BangEq()) {
                        E4(0x7100001F);                  // cmp w0, #0
                        E4(0x9A9F17E0);                  // cset x0, eq (1 = equal)
                    }
                }
            } else if (e.op == TK.Plus() && (IsStrExpr(e.a) || IsStrExpr(e.b))) {
                // string concatenation: non-string operands convert through
                // zan_rt_int2str (gen0 prints them with "%lld"), then
                // lhs -> x0, rhs -> x1, zan_rt_strcat2(lhs, rhs)
                GenExpr(e.a);
                if (!IsStrExpr(e.a)) {
                    if (IsDblExpr(e.a)) { BLInternal("_zan_rt_dbl2str"); }
                    else if (IsCharExpr(e.a)) { BLInternal("_zan_rt_chrstr"); }
                    else if (IsUlongExpr(e.a)) { BLInternal("_zan_rt_uint2str"); }
                    else { BLInternal("_zan_rt_int2str"); }
                }
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                GenExpr(e.b);
                if (!IsStrExpr(e.b)) {
                    if (IsDblExpr(e.b)) { BLInternal("_zan_rt_dbl2str"); }
                    else if (IsCharExpr(e.b)) { BLInternal("_zan_rt_chrstr"); }
                    else if (IsUlongExpr(e.b)) { BLInternal("_zan_rt_uint2str"); }
                    else { BLInternal("_zan_rt_int2str"); }
                }
                E4(0xF84107E1);                          // ldr x1, [sp], #16 (lhs)
                E4(0xAA0003E9);                          // mov x9, x0
                E4(0xAA0103E0);                          // mov x0, x1
                E4(0xAA0903E1);                          // mov x1, x9
                BLInternal("_zan_rt_strcat2");
            } else if (IsStrExpr(e.a) && IsStrExpr(e.b)
                    && (e.op == TK.EqEq() || e.op == TK.BangEq())) {
                // lexicographic equality via strcmp (gen0 parity)
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push a
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop a -> x1 (x0 = b)
                BLInternal("_zan_rt_strcmp0");       // w0 = 0 iff equal
                E4(0x7100001F);                      // cmp w0, #0
                if (e.op == TK.EqEq()) { E4(0x9A9F17E0); }   // cset x0, eq
                else { E4(0x9A9F07E0); }                     // cset x0, ne
            } else if (IsStrExpr(e.a) && IsStrExpr(e.b)
                    && (e.op == TK.Less() || e.op == TK.LessEq()
                     || e.op == TK.Greater() || e.op == TK.GreaterEq())) {
                // relational string comparison: strcmp order, not pool
                // addresses (gen0 parity); null sorts before every string
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push a
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop a -> x1 (x0 = b)
                E4(0xAA0003E9);                      // mov x9, x0
                E4(0xAA0103E0);                      // mov x0, x1
                E4(0xAA0903E1);                      // mov x1, x9
                BLInternal("_zan_rt_strcmp0");       // w0 = strcmp(a, b)
                E4(0x7100001F);                      // cmp w0, #0
                if (e.op == TK.Less()) { E4(0x9A9FA7E0); }          // cset x0, lt
                else if (e.op == TK.LessEq()) { E4(0x9A9FC7E0); }   // cset x0, le
                else if (e.op == TK.Greater()) { E4(0x9A9FD7E0); }  // cset x0, gt
                else { E4(0x9A9FB7E0); }                            // cset x0, ge
            } else if (IsDblExpr(e.a) || IsDblExpr(e.b)) {
                // double arithmetic/comparison: values travel as i64 bit
                // patterns in x0; the op materialises d-regs, coercing int
                // operands with scvtf. Comparisons are the ordered ones (a
                // NaN input always answers false, true only for !=).
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // str x0, [sp, #-16]!
                GenExpr(e.b);
                E4(0xF84107E1);                      // ldr x1, [sp], #16
                int op = e.op;
                if (IsDblExpr(e.a)) { E4(0x9E670020); }  // fmov d0, x1
                else { E4(0x9E620020); }                 // scvtf d0, x1
                if (IsDblExpr(e.b)) { E4(0x9E670001); }  // fmov d1, x0
                else { E4(0x9E620001); }                 // scvtf d1, x0
                if (op == TK.Plus()) {
                    E4(0x1E602820);                  // fadd d0, d1, d0
                    E4(0x9E660000);                  // fmov x0, d0
                } else if (op == TK.Minus()) {
                    E4(0x1E613800);                  // fsub d0, d0, d1
                    E4(0x9E660000);
                } else if (op == TK.Star()) {
                    E4(0x1E600820);                  // fmul d0, d1, d0
                    E4(0x9E660000);
                } else if (op == TK.Slash()) {
                    E4(0x1E611800);                  // fdiv d0, d0, d1 (IEEE: no guard, like gen0)
                    E4(0x9E660000);
                } else if (op == TK.Less()) {
                    E4(0x1E612000);                  // fcmp d0, d1
                    E4(0x9A9F57E0);                  // cset x0, mi
                } else if (op == TK.Greater()) {
                    E4(0x1E612000);                  // fcmp d0, d1
                    E4(0x9A9FD7E0);                  // cset x0, gt
                } else if (op == TK.LessEq()) {
                    E4(0x1E602020);                  // fcmp d1, d0 (swapped: a<=b <=> b>=a)
                    E4(0x9A9FB7E0);                  // cset x0, ge
                } else if (op == TK.GreaterEq()) {
                    E4(0x1E612000);                  // fcmp d0, d1
                    E4(0x9A9FB7E0);                  // cset x0, ge
                } else if (op == TK.EqEq()) {
                    int set0 = NL();
                    int done2 = NL();
                    E4(0x1E602020);                  // fcmp d1, d0
                    EmitBcond(6, set0);              // b.vs -> unordered: false
                    E4(0x9A9F17E0);                  // cset x0, eq
                    EmitB(done2);
                    Mark(set0);
                    LoadImm(0, 0);
                    Mark(done2);
                } else if (op == TK.BangEq()) {
                    int set1 = NL();
                    int done3 = NL();
                    E4(0x1E602020);                  // fcmp d1, d0
                    EmitBcond(6, set1);              // b.vs -> unordered: true
                    E4(0x9A9F07E0);                  // cset x0, ne
                    EmitB(done3);
                    Mark(set1);
                    LoadImm(0, 1);
                    Mark(done3);
                } else {
                    diags.Error("ngen: unsupported double operator " + op, e.line, e.col);
                }
            } else {
                GenExpr(e.a);
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                GenExpr(e.b);
                E4(0xF84107E1);                          // ldr x1, [sp], #16
                int op = e.op;
                if (IsUlongExpr(e.a) || IsUlongExpr(e.b)
                        || (Int32Kind(e.a) == 2 && Int32Kind(e.b) == 2)) {
                    // unsigned 64-bit: add/sub/mul keep the full i64 result
                    // (gen0's uint reads are 64-bit; the declared-width slot
                    // store truncates), division drops the MIN/-1 fold,
                    // comparisons go unsigned, and >> is logical
                    bool bothU = Int32Kind(e.a) == 2 && Int32Kind(e.b) == 2;
                    if (op == TK.Plus()) {
                        E4(0x8B000020);                  // add x0, x1, x0
                    } else if (op == TK.Minus()) {
                        E4(0xCB000020);                  // sub x0, x1, x0
                    } else if (op == TK.Star()) {
                        E4(0x9B007C20);                  // mul x0, x1, x0
                    } else if (op == TK.Slash() || op == TK.Percent()) {
                        int bad = NL();
                        int cont = NL();
                        CbzReg(0, bad);
                        EmitB(cont);
                        Mark(bad);
                        E4(0xF81F0FE1);                  // str x1, [sp, #-16]! (keep dividend)
                        LoadSymRef("l_.str." + guardFileIdx, 0);
                        LoadImm(1, curLine);
                        LoadImm(2, curCol);
                        if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                        else { LoadSymRef("l_.str." + guardModIdx, 3); }
                        BLInternal("_zan_rt_guard_fail3");
                        E4(0xF84107E1);                  // ldr x1, [sp], #16
                        LoadImm(0, 1);                   // safe divisor
                        Mark(cont);
                        if (op == TK.Slash()) {
                            E4(0x9AC00820);              // udiv x0, x1, x0
                        } else {
                            E4(0x9AC00824);              // udiv x4, x1, x0
                            E4(0x9B008480);              // msub x0, x4, x0, x1
                        }
                    } else if (op == TK.Less()) {
                        E4(0xEB00003F);                  // cmp x1, x0
                        E4(0x9A9F27E0);                  // cset x0, lo
                    } else if (op == TK.Greater()) {
                        E4(0xEB00003F);
                        E4(0x9A9F97E0);                  // cset x0, hi
                    } else if (op == TK.LessEq()) {
                        E4(0xEB00003F);
                        E4(0x9A9F87E0);                  // cset x0, ls
                    } else if (op == TK.GreaterEq()) {
                        E4(0xEB00003F);
                        E4(0x9A9F37E0);                  // cset x0, hs
                    } else if (op == TK.EqEq()) {
                        E4(0xEB00003F);
                        E4(0x9A9F17E0);                  // cset x0, eq
                    } else if (op == TK.BangEq()) {
                        E4(0xEB00003F);
                        E4(0x9A9F07E0);                  // cset x0, ne
                    } else if (op == TK.LessLess()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02020);                  // lslv x0, x1, x0
                    } else if (op == TK.GreaterGreater()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02420);                  // lsrv x0, x1, x0
                    } else if (op == TK.GreaterGreaterGreater()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02420);                  // lsrv x0, x1, x0
                    } else {
                        diags.Error("ngen: unsupported ulong operator " + op, e.line, e.col);
                    }
                } else if (op == TK.Plus()) {
                    E4(0x8B000020);                      // add x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Minus()) {
                    E4(0xCB000020);                      // sub x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Star()) {
                    E4(0x9B007C20);                      // mul x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Slash() || op == TK.Percent()) {
                    // divide/modulo: x1 = dividend, x0 = divisor. A zero
                    // divisor reports through zan_rt_guard_fail3 -- the same
                    // C-runtime guard the IR backend links -- and continues
                    // with divisor 1; INT_MIN / -1 also divides by 1 to
                    // avoid the SIGFPE trap, mirroring gen0's select guard.
                    int bad = NL();
                    int cont = NL();
                    int safe = NL();
                    CbzReg(0, bad);
                    EmitB(cont);
                    Mark(bad);
                    E4(0xF81F0FE1);                      // str x1, [sp, #-16]! (keep dividend across the call)
                    LoadSymRef("l_.str." + guardFileIdx, 0);
                    LoadImm(1, curLine);
                    LoadImm(2, curCol);
                    if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                    else { LoadSymRef("l_.str." + guardModIdx, 3); }
                    BLInternal("_zan_rt_guard_fail3");
                    E4(0xF84107E1);                      // ldr x1, [sp], #16 (own push; cont must not pop)
                    LoadImm(0, 1);                       // safe divisor
                    Mark(cont);
                    LoadImm(2, 0x8000000000000000);      // i64 min
                    LoadImm(3, -1);
                    E4(0xEB03001F);                      // cmp x0, x3
                    EmitBcond(1, safe);                  // b.ne safe
                    E4(0xEB02003F);                      // cmp x1, x2
                    EmitBcond(1, safe);
                    LoadImm(0, 1);
                    Mark(safe);
                    if (op == TK.Slash()) {
                        E4(0x9AC00C20);                  // sdiv x0, x1, x0
                        // the 64-bit quotient of INT_MIN / -1 is +2^31;
                        // int semantics wrap it back to INT_MIN
                        if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                    } else {
                        E4(0x9AC00C24);                  // sdiv x4, x1, x0
                        E4(0x9B008480);                  // msub x0, x4, x0, x1
                    }
                } else if (op == TK.Less()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FA7E0);                      // cset x0, lt
                } else if (op == TK.Greater()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FD7E0);                      // cset x0, gt
                } else if (op == TK.LessEq()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FC7E0);                      // cset x0, le
                } else if (op == TK.GreaterEq()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FB7E0);                      // cset x0, ge
                } else if (op == TK.EqEq()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9F17E0);                      // cset x0, eq
                } else if (op == TK.BangEq()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9F07E0);                      // cset x0, ne
                } else if (op == TK.LessLess()) {
                    // shifts compute at 64 bits; only the count masks, by the
                    // left operand's DECLARED width (a bare literal declares
                    // int), and an int target narrows the result at the store
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02020);                      // lslv x0, x1, x0
                } else if (op == TK.GreaterGreater()) {
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02820);                      // asrv x0, x1, x0
                } else if (op == TK.GreaterGreaterGreater()) {
                    // always logical; the 64-bit result stays untruncated
                    // here -- an int target narrows it at the store
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02420);                      // lsrv x0, x1, x0
                } else if (op == TK.Amp()) {
                    E4(0x8A000020);                      // and x0, x1, x0
                } else if (op == TK.Pipe()) {
                    E4(0xAA000020);                      // orr x0, x1, x0
                } else if (op == TK.Caret()) {
                    E4(0xCA000020);                      // eor x0, x1, x0
                } else {
                    diags.Error("ngen: unsupported operator " + op, e.line, e.col);
                }
            }
        } else if (k == AK.Unary()) {
            GenExpr(e.a);
            if (e.op == TK.Minus()) {
                if (IsDblExpr(e.a)) {
                    E4(0x9E670000);                  // fmov d0, x0
                    E4(0x1E614000);                  // fneg d0, d0
                    E4(0x9E660000);                  // fmov x0, d0
                } else {
                    E4(0xCB0003E0);                  // neg x0, x0 (sub x0, xzr, x0)
                    // only a 32-bit-domain signed operand wraps at the neg
                    // (uint reads are 64-bit; literals are 64-bit)
                    if (Int32Kind(e.a) == 1) { Wrap32(1); }
                }
            } else if (e.op == TK.Bang()) {
                // logical not on every operand shape: `!x` is (x == 0),
                // matching the IR's icmp eq 0 (irgen_expr) -- this is what
                // makes `!d.ContainsKey(k)` behave on an int-shaped 0/1
                // predicate
                E4(0xF100001F);                      // cmp x0, #0
                E4(0x9A9F17E0);                      // cset x0, eq
            } else if (e.op == TK.Tilde()) {
                // source-level `~`: the C# bitwise complement
                E4(0xAA2003E0);                      // orn x0, xzr, x0 (mvn)
            } else if (e.op == TK.PlusPlus() || e.op == TK.MinusMinus()) {
                // prefix ++/--: yield the NEW value
                GenIncDec(e.a, e.op == TK.PlusPlus(), true);
            }
            // unary plus is a no-op on the bit pattern
        } else if (k == AK.CastExpr() && e.type != null) {
            if (TryGenConversionCastNg(e)) { return; }
            // numeric casts: int<->ulong share the slot bits; to/from
            // double converts via scvtf/fcvtzs (like gen0's fptosi/sitofp)
            string ty = e.type.sval;
            bool toDbl = IsDblTy(ty);
            bool fromDbl = IsDblExpr(e.b);
            if (toDbl && !fromDbl) {
                GenExpr(e.b);
                E4(0x9E620000);                      // scvtf d0, x0
                E4(0x9E660000);                      // fmov x0, d0
            } else if (!toDbl && fromDbl) {
                GenExpr(e.b);
                E4(0x9E670000);                      // fmov d0, x0
                E4(0x9E780000);                      // fcvtzs x0, d0
                if (ty == "int") { E4(0x93407C00); } // wrap the saturated i64 down to i32
            } else {
                // a static method group casts to its raw code address (the
                // oracle's native method-group value), not a delegate pair
                int rawMg = StaticGroupCastIdxNg(e);
                if (rawMg >= 0) { LoadSymRef(MethSymNg(methCls[rawMg], methNodes[rawMg]), 0); }
                else { GenExpr(e.b); }               // int<->ulong (and dbl->dbl): bits unchanged
                // narrow casts wrap at the declared width, like gen0's
                // truncating integer conversions
                if (ty == "int") { E4(0x93407C00); }             // sbfm #31
                else if (ty == "uint") { E4(0xD3407C00); }       // ubfm #31
                else if (ty == "short") { E4(0x93403C00); }      // sbfm #15
                else if (ty == "ushort" || ty == "char") { E4(0xD3403C00); }  // ubfm #15
                else if (ty == "sbyte") { E4(0x93401C00); }      // sbfm #7
                else if (ty == "byte") { E4(0xD3401C00); }       // ubfm #7
            }
        } else if (k == AK.Index()) {
            if (IsStrExpr(e.a)) {
                // char access: bounds-checked byte load (gen0 reports the
                // same guard message and continues with index 0); a null
                // base reports too and answers 0 like the zeroed scratch
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push s
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop s -> x1 (x0 = idx)
                int bad = NL();
                int ldok = NL();
                int done = NL();
                int nulls = NL();
                CbzReg(1, nulls);                    // null base
                EmitB(ldok);
                Mark(nulls);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardStrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(done);
                Mark(ldok);
                E4(0xD1002022);                      // sub x2, x1, #8
                E4(0xF9400042);                      // ldr x2, [x2]
                E4(0xD3407C42);                      // ubfm x2, x2, #0, #31 (len)
                E4(0xEB02001F);                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                E4(0x38606820);                      // ldrb w0, [x1, x0]
                EmitB(done);
                Mark(bad);
                E4(0xF81F0FE1);                      // keep s across the call
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardStrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                E4(0xF84107E1);                      // pop s
                LoadImm(0, 0);                       // safe index
                Mark(done);
            } else if (ArrContainerTy(e.a) != null) {
                // array element get: len = i64 at arr-16; a bad index reports
                // and continues with index 0 (gen0 parity). int[] stores i32.
                int esz = ArrElemSize(ArrContainerTy(e.a));
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push arr
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop arr -> x1 (x0 = idx)
                E4(0xF85F0022);                      // ldur x2, [x1, #-16] (len)
                int bad = NL();
                int cont = NL();
                E4(0xEB02001F);                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE1);                      // keep arr (guard clobbers x1)
                E4(0xF81F0FE0);                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E1);                      // pop arr
                LoadImm(0, 0);
                Mark(cont);
                EmitArrElemLoad(esz, ArrElemName(ArrContainerTy(e.a)), 1, 0, 0);
            } else if (e.a != null && e.a.kind == AK.NewExpr() && IsSpanNew(e.a)) {
                // Span<T> element get: base/length re-evaluated from the view
                // expression, bounds-checked like an array
                int sesz = SpanElemSize(e.a);
                string sel = SpanElemTy(e.a);
                GenExpr(e.a.kids[0]);                // base -> x0
                E4(0xF81F0FE0);                      // push base
                GenExpr(e.a.kids[1]);                // len -> x0
                E4(0xF81F0FE0);                      // push len
                GenExpr(e.b);                        // idx -> x0
                E4(0xF84107E2);                      // pop len -> x2
                E4(0xF84107E1);                      // pop base -> x1
                int sbad = NL();
                int scont = NL();
                E4(0xEB02001F);                      // cmp x0, x2
                EmitBcond(10, sbad);                 // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, sbad);                 // b.lt bad
                EmitB(scont);
                Mark(sbad);
                E4(0xF81F0FE1);                      // keep base (guard clobbers x1)
                E4(0xF81F0FE0);                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E1);                      // pop base
                LoadImm(0, 0);
                Mark(scont);
                EmitSpanElemLoad(sel, sesz);
            } else if (SpanContainerTy(e.a) != null) {
                // local/field Span<T> element get: the value is the base
                // pointer; unguarded (see SpanContainerTy)
                string sct = SpanContainerTy(e.a);
                GenExpr(e.a);                        // base -> x0
                E4(0xF81F0FE0);                      // push base
                GenExpr(e.b);                        // idx -> x0
                E4(0xF84107E1);                      // pop base -> x1
                EmitSpanElemLoad(SpanTyElem(sct), SpanTyElemSize(sct));
            } else if (ExprCls(e.a) == "Dict") {
                DictCheckOperand(e.a, e.b, true);
                // d[key] get: _zan_rt_dict_get returns 0 for a missing key
                // (zero-value semantics, gen0 parity)
                GenExpr(e.a);                        // dict -> x0
                E4(0xF81F0FE0);                      // push dict
                GenExpr(e.b);                        // key -> x0
                MovRR(1, 0);                         // x1 = key
                E4(0xF84107E0);                      // pop dict -> x0
                BLInternal("_zan_rt_dict_get");
            } else if (ExprCls(e.a) == "List") {
                // element get: data = obj+16, count = obj+0, 8-byte slots
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push obj
                GenExpr(e.b);
                E4(0xF84107E1);                      // pop obj -> x1 (x0 = idx)
                LdrU(2, 1, 0);                       // count
                LdrU(3, 1, 16);                      // data
                int bad = NL();
                int cont = NL();
                E4(0xEB02001F);                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE3);                      // keep data (guard clobbers x3)
                E4(0xF81F0FE0);                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardListIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E3);                      // pop data
                LoadImm(0, 0);
                Mark(cont);
                int gEnd = NL();
                CbzReg(3, gEnd);                     // empty list: backing is null
                E4(0xF8607860);                      // ldr x0, [x3, x0, lsl #3]
                Mark(gEnd);                          // null backing reads as zero
            } else if (OpIndexFit(ExprCls(e.a), "op_index", e.b, null) != null) {
                // class instance with an indexer: `obj[i]` lowers to the
                // op_index instance-method protocol (x0 receiver, x1 index);
                // overloads are picked by the index argument's type
                string oc = ExprCls(e.a);
                Node om = OpIndexFit(oc, "op_index", e.b, null);
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push receiver
                GenExpr(e.b);
                MovRR(1, 0);                         // x1 = index
                E4(0xF84107E0);                      // pop receiver -> x0
                BLInternal(MethSymNg(oc, om));
            } else {
                diags.Error("ngen: unsupported index target", e.line, e.col);
            }
        } else if (k == AK.Assignment()) {
            string tgtTy = AssignTargetTy(e.a);
            if (tgtTy != null && tgtTy == "float") { tgtTy = "double"; }
            if (e.op != TK.Eq() && e.op != TK.QQEq()) {
                // compound assignment reads the target through the ordinary
                // Binary path (which knows ints, doubles, ulongs and string
                // concat) and stores through the same chain as `=`
                int bop2 = CompoundBinOp(e.op);
                if (bop2 == 0) {
                    diags.Error("ngen: unsupported compound assignment operator", e.line, e.col);
                    return;
                }
                Node bin2 = new Node(AK.Binary());
                bin2.op = bop2;
                bin2.line = e.line;
                bin2.col = e.col;
                bin2.a = e.a;
                bin2.b = e.b;
                GenExpr(bin2);
                if (tgtTy == "double" && !IsDblExpr(bin2)) { ConvI2D(); }
                else if (tgtTy == "float") {
                    // packed float[] slots take single bits; 8-byte float
                    // slots (locals, lists, fields) keep the widened double
                    if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null) { NarrowF32Bits(); }
                    else { NarrowF32(); }
                }
                else if (tgtTy == "int" && !IsDblExpr(bin2) && !IsStrExpr(bin2)) { E4(0x93407C00); }   // sxtw x0, w0
                else if (tgtTy == "uint" && !IsDblExpr(bin2) && !IsStrExpr(bin2)) { E4(0xD3407C00); }  // ubfm: zero-extend low 32
            } else if (TryGenBindingValue(e.b, tgtTy)) {
                // Binding<T> sugar: x0 already holds the fresh binding object
            } else {
                GenConversionValueNg(e.b, tgtTy);
            }
            if (TryGenStringStore(e.a)) { return; }
            if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null
                    && ArrElemName(ArrContainerTy(e.a.a)) == "float") {
                NarrowF32Bits();                     // packed float slots hold single bits
            }
            if (e.a != null && e.a.kind == AK.Ident()) {
                int li = LocalIdx(e.a.sval);
                if (li < 0) {
                    // implicit field store inside instance methods
                    Fld fld = CurField(e.a.sval);
                    if (fld != null) {
                        E4(0xF81F0FE0);                  // str x0, [sp, #-16]! (value)
                        LoadLocal(LocalIdx("this"), 0);  // receiver -> x0
                        E4(0xF84107E1);                  // ldr x1, [sp], #16 (value)
                        StoreFieldNg(1, 0, fld);             // str x1, [x0, #off]
                        return;
                    }
                    // static field store through its data-global slot
                    string ssym = FindStaticSym(curCls, e.a.sval);
                    if (ssym != null) {
                        LoadSymRef(ssym, 9);
                        StrU(0, 9, 0);
                        return;
                    }
                    // bare property store: the desugared set_Name accessor
                    // (instance: x0 = receiver, x1 = value; static: the
                    // value is the first parameter, so it stays in x0)
                    Node bs = AccessorInChain(curCls, "set_" + e.a.sval);
                    if (bs != null) {
                        if (HasMod(bs, MOD.Static())) {
                            // value already in x0
                        } else {
                            E4(0xF81F0FE0);              // push value
                            LoadLocal(LocalIdx("this"), 0);
                            E4(0xF84107E1);              // x1 = value
                        }
                        BLInternal(MethSymNg(accOwnerCls, bs));
                        return;
                    }
                    diags.Error("ngen: unknown identifier '" + e.a.sval + "'", e.line, e.col);
                    return;
                }
                if (locRef[li]) {
                    LoadLocal(li, 1);                        // address in the slot
                    StrU(0, 1, 0);                           // store through it
                    return;
                }
                StoreLocal(li, 0);
            } else if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null) {
                // array element set: same bounds rule as the get; the value
                // and index survive the guard call on the stack
                int esz = ArrElemSize(ArrContainerTy(e.a.a));
                E4(0xF81F0FE0);                      // push value
                GenExpr(e.a.a);
                E4(0xF81F0FE0);                      // push arr
                GenExpr(e.a.b);                      // x0 = idx
                E4(0xF84107E1);                      // pop arr -> x1
                E4(0xF84107E2);                      // pop value -> x2
                E4(0xF85F0023);                      // ldur x3, [x1, #-16] (len)
                int bad = NL();
                int cont = NL();
                E4(0xEB03001F);                      // cmp x0, x3
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE1);                      // keep arr (guard clobbers x1)
                E4(0xF81F0FE0);                      // keep idx
                E4(0xF81F0FE2);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                E4(0xF84107E2);                      // pop value
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E1);                      // pop arr
                LoadImm(0, 0);
                Mark(cont);
                if (esz == 1) {
                    E4(0x38206822);                  // strb w2, [x1, x0]
                } else if (esz == 2) {
                    E4(0x78206822);                  // strh w2, [x1, x0]
                } else if (esz == 4) {
                    E4(0xB8207822);                  // str w2, [x1, x0, lsl #2]
                } else {
                    E4(0xF8207822);                  // str x2, [x1, x0, lsl #3]
                }
            } else if (e.a != null && e.a.kind == AK.Index() && e.a.a != null
                    && e.a.a.kind == AK.NewExpr() && IsSpanNew(e.a.a)) {
                // Span<T> element set: the value survives on the stack while
                // base, length and index evaluate; same bounds rule as the get
                string sel = SpanElemTy(e.a.a);
                int sesz = SpanElemSize(e.a.a);
                E4(0xF81F0FE0);                      // push value
                GenExpr(e.a.a.kids[0]);              // base -> x0
                E4(0xF81F0FE0);                      // push base
                GenExpr(e.a.a.kids[1]);              // len -> x0
                E4(0xF81F0FE0);                      // push len
                GenExpr(e.a.b);                      // idx -> x0
                E4(0xF84107E2);                      // pop len -> x2
                E4(0xF84107E1);                      // pop base -> x1
                E4(0xF84107E3);                      // pop value -> x3
                int sbad = NL();
                int scont = NL();
                E4(0xEB02001F);                      // cmp x0, x2
                EmitBcond(10, sbad);                 // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, sbad);                 // b.lt bad
                EmitB(scont);
                Mark(sbad);
                E4(0xF81F0FE1);                      // keep base (guard clobbers x1)
                E4(0xF81F0FE0);                      // keep idx
                E4(0xF81F0FE3);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                E4(0xF84107E3);                      // pop value
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E1);                      // pop base
                LoadImm(0, 0);
                Mark(scont);
                EmitSpanElemStore(sel, sesz);
            } else if (e.a != null && e.a.kind == AK.Index() && SpanContainerTy(e.a.a) != null) {
                // local/field Span<T> element set: value survives on the
                // stack while base and index evaluate; unguarded (see
                // SpanContainerTy)
                string sct2 = SpanContainerTy(e.a.a);
                E4(0xF81F0FE0);                      // push value
                GenExpr(e.a.a);                      // base -> x0
                E4(0xF81F0FE0);                      // push base
                GenExpr(e.a.b);                      // idx -> x0
                E4(0xF84107E1);                      // pop base -> x1
                E4(0xF84107E3);                      // pop value -> x3
                EmitSpanElemStore(SpanTyElem(sct2), SpanTyElemSize(sct2));
            } else if (e.a != null && e.a.kind == AK.Index() && ExprCls(e.a.a) == "Dict") {
                DictCheckOperand(e.a.a, e.a.b, true);
                DictCheckOperand(e.a.a, e.b, false);
                // d[key] = v: value survives on the stack while the dict and
                // key evaluate; _zan_rt_dict_set inserts or updates
                E4(0xF81F0FE0);                      // push value
                GenExpr(e.a.a);                      // dict -> x0
                E4(0xF81F0FE0);                      // push dict
                GenExpr(e.a.b);                      // key -> x0
                MovRR(1, 0);                         // x1 = key
                E4(0xF84107E0);                      // pop dict -> x0
                E4(0xF84107E2);                      // pop value -> x2
                BLInternal("_zan_rt_dict_set");
            } else if (e.a != null && e.a.kind == AK.Index() && ExprCls(e.a.a) == "List") {
                // element set: bounds check like the get, then store into
                // the 8-byte slot (value preserved across the guard call);
                // List<int> narrows a long-valued literal to int32 first
                bool lint = ElemTyOf(e.a) == "int";
                E4(0xF81F0FE0);                      // push value
                GenExpr(e.a.a);
                E4(0xF81F0FE0);                      // push obj
                GenExpr(e.a.b);                      // x0 = idx
                E4(0xF84107E1);                      // pop obj -> x1
                E4(0xF84107E2);                      // pop value -> x2
                if (lint) { E4(0x93407C42); }        // sxtw x2, w2
                LdrU(3, 1, 0);                       // count
                LdrU(4, 1, 16);                      // data
                int bad = NL();
                int cont = NL();
                E4(0xEB03001F);                      // cmp x0, x3
                EmitBcond(10, bad);                  // b.ge bad
                E4(0xEB1F001F);                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                E4(0xF81F0FE4);                      // keep data (guard clobbers x4)
                E4(0xF81F0FE0);                      // keep idx
                E4(0xF81F0FE2);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardListIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                E4(0xF84107E2);                      // pop value
                E4(0xF84107E0);                      // pop idx
                E4(0xF84107E4);                      // pop data
                LoadImm(0, 0);
                Mark(cont);
                int sEnd = NL();
                CbzReg(4, sEnd);                     // empty list: backing is null, drop the store
                E4(0xF8207882);                      // str x2, [x4, x0, lsl #3]
                Mark(sEnd);
            } else if (e.a != null && e.a.kind == AK.Index()
                    && OpIndexFit(ExprCls(e.a.a), "op_index_set", e.a.b, e.b) != null) {
                // indexer set: obj[i] = v (or += v -- the read half went
                // through the ordinary Index path above). The value was
                // evaluated into x0 at the top; lower to the op_index_set
                // protocol: x0 receiver, x1 index, x2 value. Overloads are
                // picked by the index and value argument types.
                string oc = ExprCls(e.a.a);
                Node osm = OpIndexFit(oc, "op_index_set", e.a.b, e.b);
                E4(0xF81F0FE0);                      // push value
                GenExpr(e.a.a);                      // receiver -> x0
                E4(0xF81F0FE0);                      // push receiver
                GenExpr(e.a.b);                      // index -> x0
                MovRR(1, 0);                         // x1 = index
                E4(0xF84107E0);                      // pop receiver -> x0
                E4(0xF84107E2);                      // pop value -> x2
                BLInternal(MethSymNg(oc, osm));
            } else if (e.a != null && e.a.kind == AK.MemberAccess()) {
                // class-qualified static write: Program.starting = v
                // (the value was already evaluated into x0 at the top)
                if (e.a.a != null && e.a.a.kind == AK.Ident()) {
                    string ssym = FindStaticSym(QualifiedCls(e.a.a.sval, e.a.sval2), e.a.sval);
                    if (ssym != null) {
                        E4(0xF81F0FE0);                  // push value across LoadSymRef
                        LoadSymRef(ssym, 1);             // x1 = &slot
                        E4(0xF84107E0);                  // pop value -> x0
                        StrU(0, 1, 0);
                        return;
                    }
                }
                Fld f = FieldOf(e.a);
                if (f == null) {
                    // property setter fallback: obj.Prop = v / Cls.Prop = v
                    // dispatches to the desugared set_Prop accessor
                    Node sm2 = null;
                    string sc2 = null;
                    if (e.a.a != null && e.a.a.kind == AK.Ident() && LocalIdx(e.a.a.sval) < 0
                            && FindClass(e.a.a.sval) != null) {
                        sm2 = AccessorInChain(e.a.a.sval, "set_" + e.a.sval);
                    }
                    if (sm2 == null) {
                        sc2 = ExprCls(e.a.a);
                        sm2 = sc2 != null ? AccessorInChain(sc2, "set_" + e.a.sval) : null;
                    }
                    if (sm2 != null) {
                        if (HasMod(sm2, MOD.Static())) {
                            // value already in x0 (first parameter)
                        } else {
                            E4(0xF81F0FE0);              // push value
                            GenExpr(e.a.a);              // receiver -> x0
                            E4(0xF84107E1);              // x1 = value
                        }
                        BLInternal(MethSymNg(accOwnerCls, sm2));
                        return;
                    }
                    diags.Error("ngen: unknown field '" + e.a.sval + "'", e.line, e.col);
                    return;
                }
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]! (value)
                GenExpr(e.a.a);                          // receiver -> x0
                E4(0xF84107E1);                          // ldr x1, [sp], #16 (value)
                StoreFieldNg(1, 0, f);                       // str x1, [x0, #off]
            } else {
                diags.Error("ngen: unsupported assignment target", e.line, e.col);
            }
        } else if (k == AK.NewExpr()) {
            GenNew(e);
        } else if (k == AK.IsExpr()) {
            GenIs(e);
        } else if (k == AK.AsExpr()) {
            GenAs(e);
        } else if (k == AK.Call()) {
            GenCall(e);
        } else if (k == AK.Conditional()) {
            // c ? a : b -- truthiness is the 0/1 bool convention
            int elseL = NL();
            int endL = NL();
            GenExpr(e.a);
            EmitCBZ(0, elseL);
            GenExpr(e.b);
            if (IsDblExpr(e) && !IsDblExpr(e.b)) { ConvI2D(); }
            EmitB(endL);
            Mark(elseL);
            GenExpr(e.c);
            if (IsDblExpr(e) && !IsDblExpr(e.c)) { ConvI2D(); }
            Mark(endL);
        } else if (k == AK.PostfixUnary()) {
            // x++ / x--: yield the OLD value, then store old +/- 1; any
            // place (local, ref local, field, static, element) goes through
            // its address so the target evaluates exactly once
            GenIncDec(e.a, e.op == TK.PlusPlus(), false);
        } else if (k == AK.WithExpr()) {
            // `recv with { f = v, ... }`: a memberwise copy of recv with the
            // named fields overwritten (record copy); the copy is a fresh
            // object even for classes
            string wtn = StaticTyOf(e.a);
            Cls wc = wtn != null ? FindClass(wtn) : null;
            if (wc == null) {
                diags.Error("ngen: 'with' receiver has no record type", e.line, e.col);
                LoadImm(0, 0);
            } else {
                GenExpr(e.a);
                E4(0xF81F0FE0);                      // push src
                LoadImm(0, wc.size + 16);
                LoadImm(1, 0);
                BLInternal("_zan_rt_alloc");
                E4(0xF84107E1);                      // pop src -> x1
                LoadImm(2, wc.size + 16);
                SubImm(0, 0, 8);
                SubImm(1, 1, 8);
                BLExtern("_memcpy");
                AddImm(0, 0, 8);                     // x0 = the copy
                E4(0xF81F0FE0);                      // hold the copy
                int wi = 0;
                while (wi < e.kids.Count) {
                    Node wasg = e.kids[wi];
                    Fld wf = wasg.a != null ? FindField(wc, wasg.a.sval) : null;
                    if (wf == null) {
                        diags.Error("ngen: unknown field '" + wasg.a.sval + "' in with expression", wasg.line, wasg.col);
                    } else {
                        GenExpr(wasg.b);
                        GenCloneIfStruct(wasg.b);
                        if (IsDblTy(wf.ty) && !IsDblExpr(wasg.b)) { ConvI2D(); }
                        E4(0xF84003E1);              // ldur x1, [sp] (peek copy)
                        StoreFieldNg(0, 1, wf);
                    }
                    wi = wi + 1;
                }
                E4(0xF84107E0);                      // pop copy -> x0
            }
        } else if (k == AK.OutArg()) {
            // an out/ref argument evaluated in expression position yields
            // its storage ADDRESS (gen0's emit_expr of a ref arg)
            GenRefArg(e);
        } else {
            diags.Error("ngen: unsupported expression kind " + k, e.line, e.col);
        }
    }

    void GenNew(Node e) {
        if (TryGenDelegateNew(e)) { return; }
        if (TryGenHostNew(e)) { return; }
        string cls = e.type != null ? e.type.sval : null;
        if (cls == "List") { GenListNew(e); return; }
        if (cls == "Dict" || cls == "Dictionary") { GenDictNew(e); return; }
        if (cls == "Span") {
            // raw-memory view: the value is the base pointer (the length
            // only feeds the index bounds check at the access site)
            GenExpr(e.kids[0]);
            return;
        }
        if (e.ival == 1) {
            if (e.kids.Count > 0) {
                // array initializer: `new T[] { a, b, c }` (an explicit size,
                // if any, must equal the element count)
                GenArrInit(e, ArrElemSize(TypeFullName(e.type) + "[]"));
                return;
            }
            GenArrNew(e.b, ArrElemSize(TypeFullName(e.type) + "[]"));
            return;
        }
        Cls c = cls != null ? FindClass(cls) : null;
        if (c == null) {
            diags.Error("ngen: unknown class in 'new' expression", e.line, e.col);
            LoadImm(0, 0);
            return;
        }
        // allocate: x0 = size + 16 (header), x1 = descriptor (0: no dtor)
        LoadImm(0, c.size + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        // stamp the runtime class site into the upper half of obj-8 (the
        // descriptor slot, 0 for plain news) so `x is T` can identify the
        // object's class later
        RtLdur(1, 0, -8);                                // ldur x1, [x0, #-8]
        E4((int)(0xD2C00000 | (((long)c.site) << 5) | 2)); // movz x2, #site, lsl #32
        E4(0xAA020021);                                  // orr x1, x1, x2
        RtStur(1, 0, -8);                                // stur x1, [x0, #-8]
        if (c.poly == 1) {
            // polymorphic: stamp the class's (lazily built) vtable at obj+0
            E4(0xF81F0FE0);                              // push obj
            LoadSymRef(DGlobalSym("vt." + cls), 9);      // x9 = &slot
            LdrU(1, 9, 0);                               // x1 = table (0 before init)
            int vtDone = NL();
            CbnzReg(1, vtDone);
            BLInternal("_vtinit_" + cls);                // x0 = table
            MovRR(1, 0);                                 // x1 = table
            Mark(vtDone);
            E4(0xF84107E0);                              // pop obj -> x0
            StrU(1, 0, 0);                               // obj->vptr = table
        }
        E4(0xF81F0FE0);                                  // str x0, [sp, #-16]! (obj)
        // ctor arguments: for a brace object initializer (`new C(a) { X = v }`)
        // the first e.op kids are the paren args and the rest are field
        // initializers; otherwise every kid is an argument. Provided args
        // first, trailing defaults filled in; a class without any ctor
        // allocates bare (no call).
        Node callN = e;
        if (e.ival == 2) {
            Node tmp = new Node(AK.Call());
            tmp.line = e.line;
            tmp.col = e.col;
            int ai = 0;
            while (ai < e.op && ai < e.kids.Count) { tmp.Add(e.kids[ai]); ai = ai + 1; }
            callN = tmp;
        }
        int cix = FitCtorIdx(cls, callN, false, null);
        string ctorSym = null;
        if (cix >= 0) {
            ctorSym = CtorSymNg(cls, methNodes[cix]);
            // a generic-class instantiation needs its OWN ctor body: the
            // open ctor is a template compiled with erasure, so any
            // type-sensitive lowering inside it degrades to the reference
            // form (a `new Dict<T, int>()` keeps the key-kind bits clear
            // and int-key instantiations strcmp their keys)
            string inst = TypeFullName(e.type);
            if (inst != null && inst.IndexOf("<") > 0) {
                Cls gc = FindClass(cls);
                if (gc != null && gc.tps.Count > 0) {
                    ctorSym = InstCtorSpecNg(inst, cls, gc, cix);
                }
            }
        }
        int pushed;
        if (cix >= 0) {
            pushed = PushCallArgs(methNodes[cix], callN);
        } else if (CtorCountNg(cls) > 0) {
            diags.Error("ngen: no constructor of '" + cls + "' takes "
                + callN.kids.Count + " argument(s)", e.line, e.col);
            return;
        } else {
            pushed = 0;
        }
        int r = pushed;
        while (r >= 1) { E4(0xF84107E0 | r); r = r - 1; } // ldr xr, [sp], #16 (args reversed)
        E4(0xF84107E0);                                  // ldr x0, [sp], #16 (obj)
        E4(0xF81F0FE0);                                  // str x0, [sp, #-16]! (keep obj across the void ctor)
        if (ctorSym != null) {
            BLInternal(ctorSym);
        }
        // field initializers store through the object still on the stack
        if (e.ival == 2) {
            int bi = e.op;
            while (bi < e.kids.Count) {
                Node it = e.kids[bi];
                if (it.kind == AK.Assignment() && it.a != null && it.a.kind == AK.Ident()) {
                    Fld initFld = FindField(FindClass(cls), it.a.sval);
                    if (initFld == null) {
                        diags.Error("ngen: unknown field '" + it.a.sval + "' in initializer", it.line, it.col);
                    } else {
                        if (!TryGenBindingValue(it.b, initFld.ty)) {
                            GenExpr(it.b);
                        }
                        if (IsDblTy(initFld.ty) && !IsDblExpr(it.b)) { ConvI2D(); }
                        if (initFld.ty == "float") { NarrowF32(); }
                        E4(0xF81F0FE0);                  // push value
                        E4(0xF84107E1);                  // pop value -> x1 (top)
                        E4(0xF84107E0);                  // pop obj -> x0
                        StoreFieldNg(1, 0, initFld);     // obj->field = value
                        E4(0xF81F0FE0);                  // push obj back for the next item
                    }
                } else {
                    diags.Error("ngen: unsupported object initializer item", it.line, it.col);
                }
                bi = bi + 1;
            }
        }
        E4(0xF84107E0);                                  // ldr x0, [sp], #16 (obj)
    }

    // `new T[] { a, b, c }`: allocate with the element count, then store each
    // initializer expression at its slot (no bounds check -- the count is
    // static). The array stays on the stack across element evaluation.
    void GenArrInit(Node e, int esz) {
        int n = e.kids.Count;
        Node cnt = new Node(AK.IntLit());
        cnt.ival = n;
        GenArrNew(cnt, esz);
        bool f32 = esz == 4 && ArrElemName(TypeFullName(e.type) + "[]") == "float";
        E4(0xF81F0FE0);                                  // push arr
        int k = 0;
        while (k < n) {
            GenExpr(e.kids[k]);                          // x0 = element value
            if (f32) { NarrowF32Bits(); }
            E4(0xF84107E1);                              // pop arr -> x1
            E4((int)(0xD2800000 | (((long)k) << 5) | 2)); // movz x2, #k
            if (esz == 1) {
                E4(0x38227820);                      // strb w0, [x1, x2]
            } else if (esz == 2) {
                E4(0x78227820);                      // strh w0, [x1, x2]
            } else if (esz == 4) {
                E4(0xB8227820);                      // str w0, [x1, x2, lsl #2]
            } else {
                E4(0xF8227820);                      // str x0, [x1, x2, lsl #3]
            }
            E4(0xF81F0FE1);                              // push arr back
            k = k + 1;
        }
        E4(0xF84107E0);                                  // pop arr -> x0
    }

    // a literal node for a primitive-type constant read (`int.MaxValue`),
    // or null when `mem` is not one
    Node PrimitiveConstLit(Node mem) {
        if (mem == null || mem.a == null || mem.a.kind != AK.Ident()) { return null; }
        string recv = mem.a.sval;
        // host math constants fold like primitive constants (no storage);
        // a user-declared Math member keeps its own identity
        if (recv == "Math" && (mem.sval == "PI" || mem.sval == "E")
                && FindStaticTy("Math", mem.sval) == null) {
            return FloatLitNg(mem.sval == "PI" ? "3.141592653589793" : "2.718281828459045");
        }
        if (recv != "int" && recv != "long" && recv != "double") { return null; }
        if (mem.sval != "MaxValue" && mem.sval != "MinValue" && mem.sval != "Epsilon") { return null; }
        if (recv == "int") {
            if (mem.sval == "MaxValue") { return IntLitNg(2147483647); }
            if (mem.sval == "MinValue") { return IntLitNg(0 - 2147483648); }
            return null;
        }
        if (recv == "long") {
            if (mem.sval == "MaxValue") { return IntLitNg(9223372036854775807); }
            if (mem.sval == "MinValue") { return IntLitNg(-9223372036854775807 - 1); }
            return null;
        }
        if (mem.sval == "MaxValue") { return FloatLitNg("1.7976931348623157e308"); }
        if (mem.sval == "MinValue") { return FloatLitNg("-1.7976931348623157e308"); }
        return FloatLitNg("2.2250738585072014e-308");
    }

    Node IntLitNg(long v) {
        Node n = new Node(AK.IntLit());
        n.ival = v;
        return n;
    }

    Node FloatLitNg(string txt) {
        Node n = new Node(AK.FloatLit());
        n.sval = txt;
        return n;
    }

    void GenFieldLoad(Node mem) {
        Fld f = FieldOf(mem);
        if (f == null) {
            // primitive-type constants: int.MaxValue / long.MinValue /
            // double.MaxValue ... fold to literals (no runtime storage)
            Node pcl = PrimitiveConstLit(mem);
            if (pcl != null) { GenExpr(pcl); return; }
            // qualified static read: ClsName.field
            if (mem.a != null && mem.a.kind == AK.Ident()) {
                string ssym = FindStaticSym(QualifiedCls(mem.a.sval, mem.sval2), mem.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    LdrU(0, 0, 0);
                    return;
                }
            }
            // qualified static property read: ClsName.Prop -> get_Prop()
            if (mem.a != null && mem.a.kind == AK.Ident() && LocalIdx(mem.a.sval) < 0
                    && FindClass(mem.a.sval) != null) {
                Node sg = AccessorInChain(mem.a.sval, "get_" + mem.sval);
                if (sg != null && HasMod(sg, MOD.Static())) {
                    LoadImm(0, 0);
                    BLInternal(MethSymNg(accOwnerCls, sg));
                    return;
                }
            }
            // property getter fallback: `obj.Prop` with no backing field
            // names the desugared get_Prop accessor
            string gc = ExprCls(mem.a);
            Node gm = gc != null ? AccessorInChain(gc, "get_" + mem.sval) : null;
            if (gm != null) {
                GenExpr(mem.a);
                BLInternal(MethSymNg(accOwnerCls, gm));
                return;
            }
            diags.Error("ngen: unknown field '" + mem.sval + "'", mem.line, mem.col);
            LoadImm(0, 0);
            return;
        }
        GenExpr(mem.a);                                  // receiver -> x0
        if (mem.a.kind != AK.ThisExpr()) {
            // null receiver fails soft with a zero field value (gen0
            // parity: `t.name` on a null reference reports and reads null)
            int gEnd = NL();
            CbzReg(0, gEnd);
            LoadFieldNg(0, 0, f);                        // ldr x0, [x0, #off]
            Mark(gEnd);
            // fallthrough leaves x0 = 0 when the receiver was null
        } else {
            LoadFieldNg(0, 0, f);                        // ldr x0, [x0, #off]
        }
    }

    // static type name of an expression when it denotes a user class, else null
    string ExprCls(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.ThisExpr()) { return curCls; }
        if (e.kind == AK.NewExpr()) { return e.type != null ? e.type.sval : null; }
        if (e.kind == AK.CastExpr() && e.type != null) { return ClassTyOf(e.type.sval); }
        if (e.kind == AK.AsExpr() && e.type != null) { return ClassTyOf(e.type.sval); }
        if (e.kind == AK.AwaitExpr()) { return ClassTyOf(AsyncAwaitElemTyNg(e.a)); }
        if (e.kind == AK.Index()) { return ClassTyOf(ElemTyOf(e)); }
        if (e.kind == AK.Call() && e.a != null) {
            // method results carry a class identity when the method's
            // declared return type names one (ChartOption.Create().x)
            return ClassTyOf(CallRetTy(e));
        }
        if (e.kind == AK.Ident()) {
            return ClassTyOf(NamedSlotTy(e.sval));
        }
        if (e.kind == AK.MemberAccess()) {
            // field chains resolve to the field's declared class
            // (`x.next.n` needs ExprCls of `x.next`)
            Fld mf = FieldOf(e);
            if (mf != null) { return ClassTyOf(mf.ty); }
            // qualified static field chains: `Store.items.Count` types the
            // receiver from the static field's declared type
            if (e.a != null && e.a.kind == AK.Ident() && LocalIdx(e.a.sval) < 0
                    && FindClass(e.a.sval) != null) {
                return ClassTyOf(FindStaticTy(QualifiedCls(e.a.sval, e.sval2), e.sval));
            }
            return null;
        }
        return null;
    }

    // element type name of an index expression ("l[i]" with l declared as
    // "List<Pt>" or "Pt[]"), or null. Struct elements resolve too: values
    // clone at every storage boundary now, so slots hold independent
    // objects and member access goes through the element pointer.
    string ElemTyOf(Node e) {
        if (e == null || e.a == null) { return null; }
        string el = null;
        if (ArrContainerTy(e.a) != null) {
            string at = ArrContainerTy(e.a);
            if (at != null && at.Length > 2) { el = at.Substring(0, at.Length - 2); }
        } else if (ExprCls(e.a) == "List") {
            string ct = StaticTyOf(e.a);
            if (ct != null && ct.Length > 5 && ct.Substring(0, 5) == "List<"
                    && ct.Substring(ct.Length - 1, 1) == ">") {
                el = ct.Substring(5, ct.Length - 6);
            }
        } else if (ExprCls(e.a) == "Dict") {
            // Dictionary<string, V>[key] yields the value type
            string ct = StaticTyOf(e.a);
            if (ct != null && IsDictTyName(ct)
                    && ct.Substring(ct.Length - 1, 1) == ">") {
                string inner = ct.Substring(ct.IndexOf("<") + 1, ct.Length - ct.IndexOf("<") - 2);
                int comma = inner.IndexOf(",");
                el = comma >= 0 ? inner.Substring(comma + 1) : null;
            }
        }
        if (el == null) {
            // an indexer's element type is the op_index method's declared
            // return type (fit against the index expression for overloads)
            Node om = OpIndexFit(ExprCls(e.a), "op_index", e.b, null);
            if (om != null && om.type != null) { el = TypeFullName(om.type); }
        }
        if (el == null) { return null; }
        return el;
    }

    // "Dictionary<..."/"Dict<...": the builtin dict under either spelling
    bool IsDictTyName(string t) {
        return t != null && (t.IndexOf("Dictionary<") == 0 || t.IndexOf("Dict<") == 0);
    }

    // normalize a declared type name to its class identity ("List<string>"
    // behaves as its open type; primitive arrays carry none), else null
    string ClassTyOf(string t) {
        if (t == null || t == "" || t == "int" || t == "string" || t == "bool"
                || t == "void" || t == "char" || t == "double" || t == "long"
                || t == "ulong") { return null; }
        if (t.Length > 5 && t.Substring(0, 5) == "List<") { return "List"; }
        if (IsDictTyName(t)) { return "Dict"; }
        if (IsArrTy(t) && (t == "int[]" || t == "long[]" || t == "ulong[]"
                || t == "double[]" || t == "string[]" || t == "bool[]"
                || t == "char[]")) { return null; }
        // generics are erased: `GBox<bool>` names the open class `GBox`
        int lt = t.IndexOf("<");
        if (lt > 0) {
            string open = t.Substring(0, lt);
            if (FindClass(open) != null) { return open; }
        }
        return t;
    }

    // binary operator behind a compound assignment (+= -> +, ...), or 0
    int CompoundBinOp(int k2) {
        if (k2 == TK.PlusEq()) { return TK.Plus(); }
        if (k2 == TK.MinusEq()) { return TK.Minus(); }
        if (k2 == TK.StarEq()) { return TK.Star(); }
        if (k2 == TK.SlashEq()) { return TK.Slash(); }
        if (k2 == TK.PercentEq()) { return TK.Percent(); }
        if (k2 == TK.AmpEq()) { return TK.Amp(); }
        if (k2 == TK.PipeEq()) { return TK.Pipe(); }
        if (k2 == TK.CaretEq()) { return TK.Caret(); }
        if (k2 == TK.LessLessEq()) { return TK.LessLess(); }
        if (k2 == TK.GreaterGreaterEq()) { return TK.GreaterGreater(); }
        if (k2 == TK.GreaterGreaterGreaterEq()) { return TK.GreaterGreaterGreater(); }
        return 0;
    }

    // x is T / x is null. With single inheritance the receiver's static type
    // decides statically whenever the target is equal to or a base of it
    // (any instance of the receiver is then also a T, so only null fails).
    // When the receiver's type is a strict base of T the object's runtime
    // class has to be consulted via the site stamped by 'new'; unrelated
    // static types answer false, like gen0.
    void GenIs(Node e) {
        if (e.type == null) {                            // `x is null`
            GenExpr(e.a);
            E4(0xEB1F001F);                              // cmp x0, xzr
            E4(0x9A9F17E0);                              // cset x0, eq
            return;
        }
        string tt = e.type.sval;
        string st = StaticTyOf(e.a);
        Cls tc = FindClass(tt);
        if (tc == null) {
            // non-class target: strings and value types are decided by the
            // static types alone
            if (tt == "string" && st == "string") {
                GenExpr(e.a);
                E4(0xEB1F001F);                          // cmp x0, xzr
                E4(0x9A9F07E0);                          // cset x0, ne
            } else if (st != null && st == tt) {
                LoadImm(0, 1);                           // same value type: always
            } else {
                LoadImm(0, 0);
            }
            return;
        }
        string sc = ClassTyOf(st);
        if (sc == null) {
            // a string can never hold a class instance; anything else with
            // no class identity cannot either
            LoadImm(0, 0);
            return;
        }
        GenExpr(e.a);                                    // x0 = receiver
        if (st == "object") {
            // object-typed source: identity is unknown statically, always
            // consult the runtime site (gen0 rule)
            GenIsSite(tc);
            return;
        }
        if (sc == tt || DerivesFrom(sc, tt)) {
            E4(0xEB1F001F);                              // cmp x0, xzr
            E4(0x9A9F07E0);                              // cset x0, ne
            return;
        }
        if (DerivesFrom(tt, sc)) {
            GenIsSite(tc);
            return;
        }
        LoadImm(0, 0);
    }

    // x as T -- like gen0: upcasts/identity, unrelated static types and
    // non-class targets pass the value through; a downcast consults the
    // runtime class site and yields null on failure
    void GenAs(Node e) {
        string tt = e.type != null ? e.type.sval : null;
        string st = StaticTyOf(e.a);
        Cls tc = tt != null ? FindClass(tt) : null;
        if (tt == null || tc == null || st == null) { GenExpr(e.a); return; }
        string sc = ClassTyOf(st);
        if (sc == null) { GenExpr(e.a); return; }
        if (st != "object") {
            if (sc == tt || DerivesFrom(sc, tt)) { GenExpr(e.a); return; }
            if (!DerivesFrom(tt, sc)) { GenExpr(e.a); return; }
        }
        // downcast: keep the value on the stack across the site test
        GenExpr(e.a);
        E4(0xF81F0FE0);                                  // push v
        LdrU(0, 31, 0);                                  // x0 = v
        GenIsSite(tc);                                   // x0 = 0/1
        int failL = NL();
        int endL = NL();
        CbzReg(0, failL);
        E4(0xF84107E0);                                  // pop v -> x0
        EmitB(endL);
        Mark(failL);
        E4(0xF84107E0);                                  // pop v (discard)
        LoadImm(0, 0);                                   // null
        Mark(endL);
    }

    // runtime site check for `x is T` with the object in x0: extract the
    // site from obj-8's upper half and compare against T's site set (T and
    // every class deriving from it)
    void GenIsSite(Cls c) {
        int zeroL = NL();
        int foundL = NL();
        int endL = NL();
        CbzReg(0, zeroL);                                // null -> false
        RtLdur(1, 0, -8);                                // ldur x1, [x0, #-8]
        E4(0xD360FC21);                                  // lsr x1, x1, #32 (site)
        int i = 0;
        while (i < classes.Count) {
            Cls cc = classes[i];
            if (cc.site > 0 && DerivesFrom(cc.name, c.name)) {
                LoadImm(2, cc.site);
                E4(0xEB02003F);                          // cmp x1, x2
                EmitBcond(0, foundL);                    // b.eq
            }
            i = i + 1;
        }
        Mark(zeroL);
        LoadImm(0, 0);
        EmitB(endL);
        Mark(foundL);
        LoadImm(0, 1);
        Mark(endL);
    }

    // declared static type name of an expression (before class identity
    // normalization), or null when nothing is known
    string StaticTyOf(Node e) {
        // Depth guard: cyclic type chains bottom out as unknown instead of
        // recursing forever. Fluent chains are typed WITHOUT memoization:
        // position keys mislabel sub-nodes sharing an expression start, and
        // the chain walkers reuse already-computed receiver types instead.
        if (stTyDepth > 96) { return null; }
        stTyDepth = stTyDepth + 1;
        string r = StaticTyOfInner(e);
        stTyDepth = stTyDepth - 1;
        return r;
    }

    string StaticTyOfInner(Node e) {
        if (e == null) { return null; }
        if (HostIsLength(e)) { return "int"; }
        if (e.kind == AK.ThisExpr()) {
            // a specialization's `this` carries the instantiation type
            string tt = NamedSlotTy("this");
            return tt != null && tt != "" ? tt : curCls;
        }
        if (e.kind == AK.NewExpr()) {
            if (e.type == null) { return null; }
            if (e.ival != 1) { return TypeFullName(e.type); }
            return TypeFullName(e.type) + ArrSuffix(1 + e.op);
        }
        if (e.kind == AK.CastExpr() && e.type != null) { return e.type.sval; }
        if (e.kind == AK.AsExpr() && e.type != null) { return e.type.sval; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a); }
        if (e.kind == AK.Ident()) { return NamedSlotTy(e.sval); }
        if (e.kind == AK.Call()) { return CallRetTy(e); }
        if (e.kind == AK.MemberAccess()) {
            // primitive-type constants type as their primitive
            // (double.MaxValue prints as a double)
            if (PrimitiveConstLit(e) != null) {
                if (e.a.sval == "double" || e.a.sval == "Math") { return "double"; }
                if (e.a.sval == "long") { return "long"; }
                return "int";
            }
            if ((e.sval == "Keys" || e.sval == "Values") && ExprCls(e.a) == "Dict") {
                return "List<" + DictSlotTy(e.a, e.sval == "Keys") + ">";
            }
            // EnumType.Member constants carry their enum identity
            if (e.a != null && e.a.kind == AK.Ident() && FindEnum(e.a.sval) >= 0) { return e.a.sval; }
            Fld f = FieldOf(e);
            if (f != null) { return f.ty; }
            // qualified static field read: ClsName.field carries the
            // field's declared type (Store.items.Count)
            if (e.a != null && e.a.kind == AK.Ident() && LocalIdx(e.a.sval) < 0
                    && FindClass(e.a.sval) != null) {
                string qst = FindStaticTy(QualifiedCls(e.a.sval, e.sval2), e.sval);
                if (qst != null) { return qst; }
            }
            return PropGetterTy(e);
        }
        if (e.kind == AK.Index()) { return ElemTyOf(e); }
        return null;
    }

    // declared type of an instance property read (obj.Prop with no backing
    // field): resolve the desugared get_Prop accessor in the receiver's
    // class chain and substitute generic arguments
    // (KeyValuePair<string,int>.Key -> string). Only Ident/this receivers
    // are typed -- cheap slot lookups; chaining into deeper expressions
    // would re-walk fluent prefixes from every StaticTyOf query.
    string PropGetterTy(Node mem) {
        if (mem == null || mem.kind != AK.MemberAccess()) { return null; }
        if (mem.a == null || (mem.a.kind != AK.Ident() && mem.a.kind != AK.ThisExpr())) { return null; }
        string recvTy = StaticTyOf(mem.a);
        if (recvTy == null) { return null; }
        string cn = ClassTyOf(recvTy);
        if (cn == null) { return null; }
        Node gm = AccessorInChain(cn, "get_" + mem.sval);
        if (gm == null || gm.type == null) { return null; }
        string rty = TypeFullName(gm.type);
        int lt = recvTy.IndexOf("<");
        Cls rc = FindClass(cn);
        if (lt <= 0 || rc == null || rc.tps.Count == 0) { return rty; }
        List<string> targs = SplitTyArgs(recvTy.Substring(lt + 1, recvTy.Length - lt - 2));
        return SubstTy(rty, rc.tps, targs);
    }

    // map an interpolation format specifier to a printf pattern, mirroring
    // gen0's interp_format_to_printf exactly (the conformance suite pins the
    // mapping); "" means the default rendering
    string FormatSpecToPrintf(string spec, bool isUlong) {
        if (spec == null || spec.Length == 0) { return ""; }
        string code = spec.Substring(0, 1);
        int digits = 0;
        int i = 1;
        while (i < spec.Length) {
            int d = spec[i] - 48;
            if (d >= 0 && d <= 9) { digits = digits * 10 + d; }
            i = i + 1;
        }
        if (code == "D" || code == "d") {
            // decimal, zero-padded to `digits`
            if (isUlong) { return digits <= 0 ? "" : "%0" + Convert.ToString(digits) + "llu"; }
            return digits <= 0 ? "" : "%0" + Convert.ToString(digits) + "lld";
        }
        if (code == "X" || code == "x") {
            // hex (upper/lower), zero-padded to `digits`
            return digits <= 0 ? "" : "%0" + Convert.ToString(digits) + "llX";
        }
        if (code == "F" || code == "f") { return "%." + Convert.ToString(digits) + "lf"; }
        if (code == "E" || code == "e") { return "%." + Convert.ToString(digits) + "E"; }
        if (code == "G" || code == "g") {
            // general: default is the shortest round-trip render; a digit
            // count means significant digits ({v:G3} -> %.3g)
            return digits > 0 ? "%." + Convert.ToString(digits) + "g" : "";
        }
        if (code == "0" || code == "#") {
            // custom numeric: 0 = required digit, # = optional
            int ipad = 0;
            int frac = 0;
            bool afterDot = false;
            bool haveDot = false;
            i = 0;
            while (i < spec.Length) {
                string ch = spec.Substring(i, 1);
                if (ch == ".") { afterDot = true; haveDot = true; }
                else if (ch == "0" || ch == "#") {
                    if (afterDot) { frac = frac + 1; }
                    else if (ch == "0") { ipad = ipad + 1; }
                }
                i = i + 1;
            }
            if (haveDot) { return "%." + Convert.ToString(frac) + "lf"; }
            if (ipad > 0) {
                string u = isUlong ? "llu" : "lld";
                return "%0" + Convert.ToString(ipad) + u;
            }
            return "";
        }
        return "";                             // unrecognized: default format
    }

    // does the mapped printf pattern render as a double (fixed/scientific
    // spec on an integer widens it first, like C#)?
    bool SpecWantsDouble(string spec) {
        if (spec == null || spec.Length == 0) { return false; }
        string code = spec.Substring(0, 1);
        if (code == "F" || code == "f" || code == "E" || code == "e") { return true; }
        if (code == "0" || code == "#") {
            int i = 0;
            while (i < spec.Length) {
                if (spec.Substring(i, 1) == ".") { return true; }
                i = i + 1;
            }
        }
        return false;
    }

    // scalar x.ToString("spec"): the compiler-mapped printf render (the
    // lexer splice turns an interpolation hole `{v:D4}` into
    // `v.ToString("D4")`). bool/string/char ignore the spec like gen0;
    // int-family receivers widen to double for fixed/scientific patterns.
    void GenScalarToStringFmt(Node e, Node recv, string spec) {
        string sty = ScalarToStringTy(recv);
        if (sty == "bool") {
            GenExpr(recv);
            int fls = NL();
            int doneb = NL();
            CbzReg(0, fls);
            LoadStr(InternStr("true"), 0);
            EmitB(doneb);
            Mark(fls);
            LoadStr(InternStr("false"), 0);
            Mark(doneb);
            return;
        }
        if (sty == "string") { GenExpr(recv); return; }
        if (sty == "char") {
            GenExpr(recv);
            BLInternal("_zan_rt_chrstr");
            return;
        }
        // gen0's is_float rule: a double receiver ignores decimal/hex
        // padding specs (D/X) and renders with the default path
        string c0 = spec != null && spec.Length > 0 ? spec.Substring(0, 1) : "";
        bool dblNoFmt = sty == "double"
            && (c0 == "D" || c0 == "d" || c0 == "X" || c0 == "x");
        string pf = dblNoFmt ? "" : FormatSpecToPrintf(spec, sty == "ulong");
        if (pf == "") {
            // default rendering: the plain paths
            if (sty == "double") {
                GenExpr(recv);
                BLInternal("_zan_rt_dbl2str");
            } else if (sty == "ulong") {
                GenExpr(recv);
                BLInternal("_zan_rt_uint2str");
            } else {
                GenExpr(recv);
                BLInternal("_zan_rt_int2str");
            }
            return;
        }
        GenExpr(recv);
        // gen0 widens an integer receiver to double for fixed/scientific
        // patterns (its SIToFP sees the same signed bits scvtf does)
        if (SpecWantsDouble(spec) && (sty == "int" || sty == "ulong")) { ConvI2D(); }
        LoadStr(InternStr(pf), 1);
        BLInternal("_zan_rt_fmt");
    }

    // the struct class when the expression is struct-typed, else null
    Cls StructOf(Node e) {
        string t = StaticTyOf(e);
        Cls c = t != null ? FindClass(t) : null;
        return c != null && c.isStruct == 1 ? c : null;
    }

    // the shared struct type when BOTH operands are the same struct, else
    // null (guards field-wise ==/!= emission)
    // null coalescing only lowers when the left operand's null really is 0:
    // reference shapes (string, class/interface, array, List/Dict/Task)
    bool QQRefShapeNg(Node a) {
        if (a == null) { return false; }
        if (IsStrExpr(a)) { return true; }
        string t = StaticTyOf(a);
        if (t == null) { return false; }
        if (ClassTyOf(t) != null) { return true; }
        return t == "object" || t == "ptr"
            || (t.Length > 2 && t.Substring(t.Length - 2, 2) == "[]")
            || t.IndexOf("List<") == 0 || IsDictTyName(t)
            || t.IndexOf("Task") == 0;
    }

    Cls StructEqPair(Node a, Node b) {
        Cls sa = StructOf(a);
        if (sa == null) { return null; }
        Cls sb = StructOf(b);
        if (sb == null || sb != sa) { return null; }
        return sa;
    }

    // struct value semantics: when expression e is struct-typed, replace x0
    // with a fresh copy of the object (gen0 keeps structs inline with value
    // semantics; ngen models them as heap objects, so every slot a struct
    // lands in -- assignment, initialization, argument, return -- copies).
    // The clone duplicates the descriptor word (class site) and all fields.
    void GenCloneIfStruct(Node e) {
        string t = StaticTyOf(e);
        Cls c = t != null ? FindClass(t) : null;
        if (c == null || c.isStruct != 1) { return; }
        E4(0xF81F0FE0);                          // push src BEFORE x0 is reused
        LoadImm(0, c.size + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");             // x0 = dst
        E4(0xF84107E1);                          // pop src -> x1
        LoadImm(2, c.size + 16);
        SubImm(0, 0, 8);                         // dst - 8 (descriptor)
        SubImm(1, 1, 8);                         // src - 8
        BLExtern("_memcpy");
        AddImm(0, 0, 8);                         // x0 = dst
    }

    // ---- generic method monomorphization ----
    // A generic method's body is per-instantiation: calls that carry explicit
    // type arguments get a specialized copy (type parameters substituted with
    // the concrete classes) under a mangled name, and the call site is
    // rewritten to that name. Worklist order handles nested generic calls
    // inside specialized bodies.

    bool HasTypeParams(Node m) {
        int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.TypeParam()) { return true; }
            i = i + 1;
        }
        return false;
    }

    Node CloneNode(Node n) {
        if (n == null) { return null; }
        Node c = new Node(n.kind);
        c.sval = n.sval;
        c.sval2 = n.sval2;
        c.ival = n.ival;
        c.op = n.op;
        c.mods = n.mods;
        c.layoutExplicit = n.layoutExplicit;
        c.fieldOffset = n.fieldOffset;
        c.line = n.line;
        c.col = n.col;
        c.type = CloneNode(n.type);
        c.a = CloneNode(n.a);
        c.b = CloneNode(n.b);
        c.c = CloneNode(n.c);
        c.d = CloneNode(n.d);
        int i = 0;
        while (i < n.kids.Count) { c.Add(CloneNode(n.kids[i])); i = i + 1; }
        return c;
    }

    // rewrite type-parameter names inside type references of a cloned body
    void SubstTypeNode(Node n, List<string> tps, List<string> args) {
        if (n == null) { return; }
        if (n.kind == AK.TypeRef() && n.sval != null) {
            int pi = IndexOfStrNg(tps, n.sval);
            if (pi >= 0 && pi < args.Count) { n.sval = args[pi]; }
        }
        SubstTypeNode(n.type, tps, args);
        SubstTypeNode(n.a, tps, args);
        SubstTypeNode(n.b, tps, args);
        SubstTypeNode(n.c, tps, args);
        SubstTypeNode(n.d, tps, args);
        if (n.kind == AK.MemberAccess() && n.sval2 != null && n.sval2 != ""
                && n.a != null && n.a.kind == AK.Ident()) {
            // class-qualified static access inside a spec body: rewrite
            // `Stat<T>.s` to the concrete instantiation `Stat<double>.s`
            string s2 = n.sval2;
            int i = 0;
            while (i < tps.Count && i < args.Count) {
                s2 = s2.Replace("__" + tps[i], "__" + args[i])
                      .Replace(tps[i] + "__", args[i] + "__");
                if (s2 == tps[i]) { s2 = args[i]; }
                i = i + 1;
            }
            n.a.sval = n.a.sval + "<" + Undunder(s2) + ">";
            n.sval2 = null;
            RegisterInstCls(n.a.sval);
        }
        if (n.kind == AK.Call() && n.sval2 != null && n.sval2 != "") {
            // explicit instantiation args ride on sval2 ("__"-joined):
            // substitute the same way so nested generic calls specialize
            string s = n.sval2;
            int i = 0;
            while (i < tps.Count && i < args.Count) {
                s = s.Replace("__" + tps[i], "__" + args[i])
                      .Replace(tps[i] + "__", args[i] + "__");
                if (s == tps[i]) { s = args[i]; }
                i = i + 1;
            }
            n.sval2 = s;
        }
        int i2 = 0;
        while (i2 < n.kids.Count) { SubstTypeNode(n.kids[i2], tps, args); i2 = i2 + 1; }
    }

    List<string> specMeth;  // mangled names of registered specializations
    List<string> instCls;   // instantiated generic classes in use ("Stat<int>")
    List<string> ctorSpecKey;  // per-instantiation ctor specs built ("Inst$di")
    List<string> ctorSpecSym;  // emit symbol of the matching ctor spec

    // find the generic method declaration for a call name: an instance or
    // static method with type parameters; first match wins
    // is this a concrete type name (class, enum, primitive, container of
    // those)? open type parameters like "T" resolve to nothing
    bool KnownTyName(string t) {
        if (t == null || t == "") { return false; }
        if (IsArrTy(t)) { return KnownTyName(t.Substring(0, t.Length - 2)); }
        int lt = t.IndexOf("<");
        if (lt > 0) {
            if (t.Substring(t.Length - 1, 1) != ">") { return false; }
            List<string> inner = SplitTyArgs(t.Substring(lt + 1, t.Length - lt - 2));
            int i = 0;
            while (i < inner.Count) {
                if (!KnownTyName(inner[i])) { return false; }
                i = i + 1;
            }
            t = t.Substring(0, lt);
        }
        if (t == "int" || t == "long" || t == "ulong" || t == "double"
                || t == "bool" || t == "char" || t == "string" || t == "object"
                || t == "byte" || t == "sbyte" || t == "short" || t == "ushort"
                || t == "uint" || t == "float" || t == "nint") { return true; }
        if (t == "List") { return true; }
        return FindClass(t) != null;
    }

    List<string> DeclTps(Node m) {
        List<string> tps = new List<string>();
        int k = 0;
        while (k < m.kids.Count) {
            if (m.kids[k].kind == AK.TypeParam()) { tps.Add(m.kids[k].sval); }
            k = k + 1;
        }
        return tps;
    }

    // resolve name+type-args to a specialization: register the mangled copy
    // on first use and rewrite the call site's callee to the mangled name.
    // Open type parameters as arguments mean the call lives in an
    // unspecialized template body -- skip; the template's own
    // specialization re-scans with concrete args. `di` is the declaration
    // to instantiate, scoped by the caller (the receiver's own chain, or
    // the global bare-name rule for extension methods) so a same-named
    // method in an unrelated class is never hijacked.
    void SpecRegister(string name, List<string> args, Node callNode, int di) {
        bool open = false;
        int oi = 0;
        while (oi < args.Count) {
            if (!KnownTyName(args[oi])) { open = true; }
            oi = oi + 1;
        }
        if (open || di < 0) { return; }
        string mangled = name + "$";
        int mj = 0;
        while (mj < args.Count) {
            if (mj > 0) { mangled = mangled + "__"; }
            mangled = mangled + args[mj];
            mj = mj + 1;
        }
        Node decl = methNodes[di];
        if (IndexOfStrNg(specMeth, mangled) < 0) {
            List<string> tps = DeclTps(decl);
            Node spec = CloneNode(decl);
            if (spec == null) { spec = new Node(decl.kind); }
            int nk = 0;
            while (nk < spec.kids.Count) {
                if (spec.kids[nk].kind == AK.TypeParam()) { spec.kids.RemoveAt(nk); }
                else { nk = nk + 1; }
            }
            spec.sval = mangled;
            SubstTypeNode(spec, tps, args);
            // the call may sit on an instantiated generic receiver
            // (`ps.Pair<int>(3)` with ps: Pool<string>): carry that
            // instantiation on the spec so its `this`-relative field types
            // resolve (CurField reads sval2), like SpecRegisterClass does
            if (callNode.a != null && callNode.a.kind == AK.MemberAccess()
                    && callNode.a.a != null) {
                string rt = StaticTyOf(callNode.a.a);
                if (rt != null && rt.IndexOf("<") > 0 && FindClass(rt.Substring(0, rt.IndexOf("<"))) != null) {
                    spec.sval2 = rt;
                    RegisterInstCls(rt);
                }
            }
            AddMethNg(spec, methCls[di], methStat[di]);
            specMeth.Add(mangled);
        }
        callNode.a.sval = mangled;
        callNode.a.b = null;
    }

    // "__"-joined type-arg string back to comma form ("int__double" -> "int,double")
    string Undunder(string s) {
        return s.Replace("__", ",");
    }

    // class-qualified name including instantiation args when present
    // ("Stat" + "int" -> "Stat<int>")
    string QualifiedCls(string cls, string sval2) {
        if (sval2 != null && sval2 != "") { return cls + "<" + Undunder(sval2) + ">"; }
        return cls;
    }

    void RegisterInstCls(string instName) {
        if (IndexOfStrNg(instCls, instName) < 0) { instCls.Add(instName); }
    }

    // specialize method methName of the instantiated generic class instName
    // ("Pool<Conn>") for the class's type parameters, rewriting the call site
    void SpecRegisterClass(string instName, string methName, bool isStatic, Node callNode) {
        int lt = instName.IndexOf("<");
        if (lt <= 0) { return; }
        string open = instName.Substring(0, lt);
        Cls c = FindClass(open);
        if (c == null || c.tps.Count == 0) { return; }
        int wantStat = isStatic ? 1 : 0;
        // Rank the original overload set BEFORE rewriting the callee. A
        // generic receiver can still select an inherited non-generic method
        // (Box<T>.Add(Item<T>) versus Node.Add(Node)). Specializing the first
        // name match hides the base overload from later call resolution.
        List<int> cands = new List<int>();
        string owner = open;
        while (owner != null) {
            List<int> cs = MethCandsClsName(owner, methName);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == wantStat && !HasTypeParams(methNodes[cs[i]])) { cands.Add(cs[i]); }
                    i = i + 1;
                }
            }
            Cls oc = FindClass(owner);
            owner = oc != null ? oc.baseName : null;
        }
        int di = FitPickIdx(cands, callNode);
        if (di < 0 || methCls[di] != open) { return; }
        // Include the declaring class and selected declaration: overloads
        // and same-named methods in other classes must not share a cache key.
        string mangled = methName + "$" + instName + "$" + di;
        if (IndexOfStrNg(specMeth, mangled) >= 0) {
            callNode.a.sval = mangled;
            return;
        }
        List<string> args = SplitTyArgs(instName.Substring(lt + 1, instName.Length - lt - 2));
        Node spec = CloneNode(methNodes[di]);
        if (spec == null) { spec = new Node(methNodes[di].kind); }
        spec.sval = mangled;
        if (!isStatic) { spec.sval2 = instName; }   // spec's `this` type
        SubstTypeNode(spec, c.tps, args);
        AddMethNg(spec, open, wantStat);         // dispatch walks the open name
        specMeth.Add(mangled);
        callNode.a.sval = mangled;
    }

    // emit symbol of a per-instantiation ctor spec: the instantiation
    // keeps the class unique; multi-ctor classes append the substituted
    // param tags exactly like CtorSymNg (an empty tag run stays "__")
    string CtorSpecSymOf(string instName, string cls, Node spec) {
        string sym = "_" + instName + "_ctor";
        if (CtorCountNg(cls) > 1) {
            sym = sym + "__";
            int pk = 0;
            while (pk < spec.kids.Count) {
                Node p = spec.kids[pk];
                if (p.kind == AK.Param()) { sym = sym + "_" + TypeTagNg(p.type); }
                pk = pk + 1;
            }
        }
        return sym;
    }

    // open class name of an instantiation ("Transfer<string>" -> "Transfer")
    string QualifiedClsNameNg(string instName) {
        int lt = instName.IndexOf("<");
        return lt > 0 ? instName.Substring(0, lt) : instName;
    }

    // per-instantiation ctor specialization. Generic-class ctors are
    // templates too: the open ctor is compiled once with erasure, so any
    // type-sensitive lowering inside it degrades to the reference form and
    // value-type instantiations misbehave at runtime. Mirror
    // SpecRegisterClass for stat-2 methods: clone+substitute per
    // instantiation, emit under a per-instantiation symbol.
    string InstCtorSpecNg(string instName, string cls, Cls c, int cix) {
        string key = instName + "$" + cix;
        int hit = IndexOfStrNg(ctorSpecKey, key);
        if (hit >= 0) { return ctorSpecSym[hit]; }
        int lt = instName.IndexOf("<");
        List<string> args = SplitTyArgs(instName.Substring(lt + 1, instName.Length - lt - 2));
        bool open = false;
        int oi = 0;
        while (oi < args.Count) {
            if (!KnownTyName(args[oi])) { open = true; }
            oi = oi + 1;
        }
        string sym = CtorSymNg(cls, methNodes[cix]);
        if (!open) {
            Node spec = CloneNode(methNodes[cix]);
            if (spec == null) { spec = new Node(methNodes[cix].kind); }
            int nk = 0;
            while (nk < spec.kids.Count) {
                if (spec.kids[nk].kind == AK.TypeParam()) { spec.kids.RemoveAt(nk); }
                else { nk = nk + 1; }
            }
            spec.sval = instName;    // unique "class name" per instantiation
            spec.sval2 = instName;   // spec's `this` type: field types substitute
            SubstTypeNode(spec, c.tps, args);
            sym = CtorSpecSymOf(instName, cls, spec);
            AddMethNg(spec, cls, 2);   // dispatch walks the open name
            ctorSpecKey.Add(key);
            ctorSpecSym.Add(sym);
        }
        return sym;
    }

    int FindGenericDecl(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            int mi = cs[i];
            if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) { return mi; }
            i = i + 1;
        }
        return -1;
    }

    // strip an instantiation suffix ("Pool<Conn>" -> "Pool") for table walks
    string OpenClsNameNg(string t) {
        if (t == null) { return null; }
        int lt = t.IndexOf("<");
        return lt > 0 ? t.Substring(0, lt) : t;
    }

    // the class a call's receiver scopes resolution to: explicit receivers
    // use their static type, bare calls the enclosing class (an instance
    // body via `this`, a static body directly)
    string SpecRecvClsNg(Node call) {
        if (call.a.kind == AK.MemberAccess() && call.a.a != null) {
            string rc = StaticTyOf(call.a.a);
            if (rc == null) { rc = ExtRecvTy(call.a.a); }
            if (rc == null && call.a.a.kind == AK.Ident()
                    && FindClass(call.a.a.sval) != null) {
                return call.a.a.sval;    // class-qualified static call
            }
            return OpenClsNameNg(rc);
        }
        if (call.a.kind == AK.Ident()) { return curCls; }
        return null;
    }

    // first generic declaration of `name` on the receiver's class chain --
    // normal scoping: the receiver, not the global bare name, selects the
    // overload set. -1 when the chain declares no generic of that name.
    int OwnedGenericDeclNg(Node call, string name) {
        string rc = SpecRecvClsNg(call);
        while (rc != null) {
            List<int> cs = MethCandsClsName(rc, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int mi = cs[i];
                    if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) { return mi; }
                    i = i + 1;
                }
            }
            Cls oc = FindClass(rc);
            rc = oc != null ? oc.baseName : null;
        }
        return -1;
    }

    // does the receiver's class chain declare `name` at all (any overload)?
    bool ReceiverHasNameNg(Node call, string name) {
        string rc = SpecRecvClsNg(call);
        while (rc != null) {
            List<int> cs = MethCandsClsName(rc, name);
            if (cs != null && cs.Count > 0) { return true; }
            Cls oc = FindClass(rc);
            rc = oc != null ? oc.baseName : null;
        }
        return false;
    }

    int inferDi;       // planned decl for the next inference registration
    string inferArgTy; // planned inferred type argument

    // plan an un-annotated generic call: the receiver's own scope must
    // declare a single-type-param generic of that name (extension
    // inference keeps the global rule when the chain names nothing) and
    // the first argument's concrete type fills the parameter. Returns
    // false when nothing can be registered, so the caller's else-if
    // chain keeps falling through to the instantiated-class branches.
    bool TryPlanInferenceSpecNg(Node n) {
        int udi = OwnedGenericDeclNg(n, n.a.sval);
        if (udi < 0 && n.a.kind == AK.MemberAccess() && !ReceiverHasNameNg(n, n.a.sval)) {
            udi = FindGenericDecl(n.a.sval);
        }
        if (udi < 0) { return false; }
        List<string> tps0 = DeclTps(methNodes[udi]);
        if (tps0.Count != 1) { return false; }
        string st = StaticTyOf(n.kids[0]);
        if (st == null) { st = ExtRecvTy(n.kids[0]); }
        if (st == null || !KnownTyName(st)) { return false; }
        inferDi = udi;
        inferArgTy = st;
        return true;
    }

    void CollectSpecs(Node n) {
        if (n == null) { return; }
        int saved = EnterEnvNg(n);
        CollectSpecsInEnvNg(n);
        locHead = saved;
    }

    void CollectSpecsInEnvNg(Node n) {
        if (n.kind == AK.MemberAccess() && n.sval2 != null && n.sval2 != ""
                && n.a != null && n.a.kind == AK.Ident()
                && KnownTyName(Undunder(n.sval2))) {
            // class-qualified static access through a concrete
            // instantiation: remember it so its statics get materialized
            RegisterInstCls(n.a.sval + "<" + Undunder(n.sval2) + ">");
        }
        if (n.kind == AK.Call() && n.a != null
                && (n.a.kind == AK.Ident() || n.a.kind == AK.MemberAccess())
                && n.sval2 != null && n.sval2 != "") {
            string name = n.a.sval;
            List<string> args = new List<string>();
            // the parser pre-joins the explicit args with "__"
            int i = 0;
            int start = 0;
            string s2 = n.sval2;
            while (i <= s2.Length - 2) {
                if (s2.Substring(i, 2) == "__") {
                    args.Add(s2.Substring(start, i - start));
                    start = i + 2;
                    i = i + 2;
                } else { i = i + 1; }
            }
            args.Add(s2.Substring(start, s2.Length - start));
            // the receiver scopes the overload set: instantiate the generic
            // the receiver's own chain declares. Only when the chain names
            // nothing does the global bare-name rule apply (extension
            // methods: db.Query<T> lives in another class) -- a same-named
            // method in an unrelated class (Com.Get vs Control.Get<T>) must
            // never be hijacked by the bare-name match.
            int odi = OwnedGenericDeclNg(n, name);
            if (odi < 0 && !ReceiverHasNameNg(n, name)) { odi = FindGenericDecl(name); }
            SpecRegister(name, args, n, odi);
        } else if (n.kind == AK.Call() && n.a != null
                && (n.a.kind == AK.Ident() || n.a.kind == AK.MemberAccess())
                && (n.sval2 == null || n.sval2 == "")
                && n.kids.Count > 0
                && TryPlanInferenceSpecNg(n)) {
            // un-annotated call: infer the single type parameter from the
            // first argument (gen0's inference) -- but only when the
            // receiver's own scope declares a single-type-param generic of
            // that name; a same-named non-generic (JsonValue.Get(key),
            // Com.Get) resolves normally, and calls that infer nothing must
            // FALL THROUGH to the instantiated-class branches below (the
            // old FindGenericDecl gate doubled as that filter).
            List<string> iargs = new List<string>();
            iargs.Add(inferArgTy);
            SpecRegister(n.a.sval, iargs, n, inferDi);
        } else if (n.a != null && n.a.kind == AK.MemberAccess() && n.a.a != null
                && n.a.a.kind == AK.Ident() && n.a.sval2 != null && n.a.sval2 != "") {
            // qualified static call on an instantiated generic class:
            // Stat<double>.F() -- specialize F for this instantiation
            string cinst = n.a.a.sval + "<" + Undunder(n.a.sval2) + ">";
            RegisterInstCls(cinst);
            SpecRegisterClass(cinst, n.a.sval, true, n);
        } else if (n.a != null && n.a.kind == AK.MemberAccess() && n.a.a != null
                && (n.sval2 == null || n.sval2 == "")) {
            // instance call on an instantiated generic receiver:
            // pc.Describe() with pc typed Pool<Conn>
            string rc = StaticTyOf(n.a.a);
            if (rc != null && rc.IndexOf("<") > 0) {
                Cls oc = FindClass(rc);
                if (oc != null && oc.tps.Count > 0) {
                    RegisterInstCls(rc);
                    SpecRegisterClass(rc, n.a.sval, false, n);
                }
            }
        }
        CollectSpecs(n.a);
        CollectSpecs(n.b);
        CollectSpecs(n.c);
        CollectSpecs(n.d);
        int ki = 0;
        while (ki < n.kids.Count) { CollectSpecs(n.kids[ki]); ki = ki + 1; }
    }

    void RunSpecPipeline() {
        // process the worklist: each appended spec's body is scanned for
        // further explicit-generic calls until fixpoint. A light locals
        // table (params + declarations) backs StaticTyOf during the scan,
        // so inference can read a call argument's type.
        int processed = 0;
        while (processed < methNodes.Count) {
            Node m = methNodes[processed];
            if (methStat[processed] != 3) {
                bool inst = methStat[processed] == 0 || methStat[processed] == 2;
                curCls = methCls[processed];
                InitLocalsNg();
                if (inst) {
                    string thisTy = m.sval2 != null && m.sval2 != "" ? m.sval2 : curCls;
                    AddLoc("this", thisTy, false);
                }
                int pi = 0;
                while (pi < m.kids.Count) {
                    if (m.kids[pi].kind == AK.Param()) {
                        AddLoc(m.kids[pi].sval, TypeFullName(m.kids[pi].type), m.kids[pi].ival == 1);
                        if (locTy[nloc - 1] == "string") { locOpaq[nloc - 1] = 1; }
                    }
                    pi = pi + 1;
                }
                ReserveLocals(m.d);
                CollectSpecs(m);
            }
            processed = processed + 1;
        }
    }

    // ---- enums ----
    void CollectEnums(Node unit) {
        enName = new List<string>();
        enOff = new List<int>();
        enCnt = new List<int>();
        enMem = new List<string>();
        enVal = new List<long>();
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.EnumDecl()) {
                enName.Add(dcl.sval);
                enOff.Add(enMem.Count);
                int cnt = 0;
                long val = 0;
                int k = 0;
                while (k < dcl.kids.Count) {
                    Node m = dcl.kids[k];
                    if (m.sval != null && m.sval != "") {
                        // an explicit `= n` (int literal, possibly negated)
                        // resets the running counter, like gen0's fold
                        if (m.a != null && m.a.kind == AK.IntLit()) { val = m.a.ival; }
                        else if (m.a != null && m.a.kind == AK.Unary()
                                && m.a.op == TK.Minus() && m.a.a != null
                                && m.a.a.kind == AK.IntLit()) { val = -m.a.a.ival; }
                        enMem.Add(m.sval);
                        enVal.Add(val);
                        cnt = cnt + 1;
                        val = val + 1;
                    }
                    k = k + 1;
                }
                enCnt.Add(cnt);
            }
            i = i + 1;
        }
    }

    int FindEnum(string n) {
        int i = 0;
        while (i < enName.Count) { if (enName[i] == n) { return i; } i = i + 1; }
        return -1;
    }

    // flat index of member `mem` of enum `en`, or -1
    int FindEnumMemIdx(string en, string mem) {
        int ei = FindEnum(en);
        if (ei < 0) { return -1; }
        int i = 0;
        while (i < enCnt[ei]) {
            if (enMem[enOff[ei] + i] == mem) { return enOff[ei] + i; }
            i = i + 1;
        }
        return -1;
    }

    // the enum type an expression's static type names, or null
    string EnumTyOf(Node e) {
        if (e == null) { return null; }
        string t = StaticTyOf(e);
        if (t != null && FindEnum(t) >= 0) { return t; }
        return null;
    }

    // enum x.ToString(): the name of the first member whose constant equals
    // the value (declaration order wins duplicates, like gen0); an unmatched
    // value formats as its number
    void GenEnumToString(Node recv, string et) {
        int ei = FindEnum(et);
        GenExpr(recv);
        E4(0xF81F0FE0);                                  // push v
        int numL = NL();
        int joinL = NL();
        int cnt = enCnt[ei];
        int[] hits = new int[cnt];
        int i = 0;
        while (i < cnt) {
            hits[i] = NL();
            LdrU(1, 31, 0);                              // x1 = [sp] (peek v)
            LoadImm(2, enVal[enOff[ei] + i]);
            E4(0xEB02003F);                              // cmp x1, x2
            EmitBcond(0, hits[i]);                       // b.eq
            i = i + 1;
        }
        E4(0xF84107E0);                                  // pop v -> x0
        BLInternal("_zan_rt_int2str");                   // numeric fallback
        EmitB(joinL);
        i = 0;
        while (i < cnt) {
            Mark(hits[i]);
            E4(0xF84107E0);                              // pop v (discard)
            LoadStr(InternStr(enMem[enOff[ei] + i]), 0);
            EmitB(joinL);
            i = i + 1;
        }
        Mark(joinL);
    }

    // EnumType.TryParse(text, out value): a case-sensitive probe over the
    // declaration-order member names, like gen0 -- a hit stores the member
    // constant through the out address and yields 1, a miss stores
    // default(T) and yields 0
    void GenEnumTryParse(Node e) {
        string en = e.a.a.sval;
        int ei = FindEnum(en);
        GenRefArg(e.kids[1]);                            // x0 = out address
        E4(0xF81F0FE0);                                  // push addr
        GenExpr(e.kids[0]);                              // x0 = text
        E4(0xF81F0FE0);                                  // push text (strcmp0
                                                        // clobbers x0-x17, so
                                                        // every probe peeks)
        int cnt = enCnt[ei];
        int miss = NL();
        int join = NL();
        int[] hits = new int[cnt];
        int i = 0;
        while (i < cnt) {
            hits[i] = NL();
            E4(0xF84003E1);                              // ldur x1, [sp] (text)
            LoadStr(InternStr(enMem[enOff[ei] + i]), 0);
            BLInternal("_zan_rt_strcmp0");               // w0 = 0 iff equal
            E4(0x7100001F);                              // cmp w0, #0
            EmitBcond(0, hits[i]);                       // b.eq hit
            i = i + 1;
        }
        E4(0xF84107E0);                                  // pop text (discard)
        E4(0xF84107E1);                                  // pop addr -> x1
        StrU(31, 1, 0);                                  // str xzr, [x1] (default)
        LoadImm(0, 0);
        EmitB(join);
        i = 0;
        while (i < cnt) {
            Mark(hits[i]);
            E4(0xF84107E0);                              // pop text (discard)
            E4(0xF84107E1);                              // pop addr -> x1
            LoadImm(2, enVal[enOff[ei] + i]);
            StrU(2, 1, 0);                               // member constant
            LoadImm(0, 1);
            EmitB(join);
            i = i + 1;
        }
        Mark(join);
    }

    // true when sub's base chain reaches anc (equal counts)
    bool DerivesFrom(string sub, string anc) {
        if (sub == null || anc == null) { return false; }
        string cur = sub;
        while (cur != null) {
            if (cur == anc) { return true; }
            Cls cc = FindClass(cur);
            if (cc == null) { return false; }
            cur = cc.baseName;
        }
        return false;
    }

    // declared type of a local, field or static of that name (locals shadow
    // fields shadow statics, matching the binder's lookup order)
    string NamedSlotTy(string name) {
        int li = LocalIdx(name);
        if (li >= 0) { return locTy[li]; }
        Fld f = CurField(name);
        if (f != null) { return f.ty; }
        return FindStaticTy(curCls, name);
    }

    string TypeFullName(Node t) {
        if (t == null) { return ""; }
        string n = t.sval;
        if (t.kids != null && t.kids.Count > 0) {
            n = n + "<";
            int i = 0;
            while (i < t.kids.Count) {
                if (i > 0) { n = n + ","; }
                n = n + TypeFullName(t.kids[i]);
                i = i + 1;
            }
            n = n + ">";
        }
        return n + ArrSuffix(t.ival);
    }

    // array-type helpers ("int[]" style declared types)
    bool IsArrTy(string t) {
        if (t == null || t.Length < 2) { return false; }
        return t.Substring(t.Length - 2, 2) == "[]";
    }
    bool IsArrExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return IsArrTy(locTy[li]); }
            Fld f = CurField(e.sval);
            return f != null && IsArrTy(f.ty);
        }
        if (e.kind == AK.NewExpr()) {
            return e.ival == 1;
        }
        return false;
    }
    // n copies of the array suffix ("[][]" for 2)
    string ArrSuffix(int n2) {
        string s2 = "";
        int i = 0;
        while (i < n2) { s2 = s2 + "[]"; i = i + 1; }
        return s2;
    }

    string ArrTyOf(Node e) {
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && IsArrTy(locTy[li])) { return locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            return "int[]";
        }
        if (e.kind == AK.NewExpr() && e.type != null && e.ival == 1) {
            return TypeFullName(e.type) + ArrSuffix(1 + e.op);
        }
        return "int[]";
    }

    // declared array type of an expression usable as an element container:
    // a local, an instance field (implicit this or through a receiver), a
    // static field (of the current class or class-qualified), `new T[]`,
    // a cast/as to an array type, a nested element read of an
    // array-of-arrays, or a call returning an array. Unlike ArrTyOf this
    // never guesses -- null means "not a known array".
    string ArrContainerTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && IsArrTy(locTy[li])) { return locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            string st = FindStaticTy(curCls, e.sval);
            if (st != null && IsArrTy(st)) { return st; }
            return null;
        }
        if (e.kind == AK.NewExpr() && e.type != null && e.ival == 1) {
            return TypeFullName(e.type) + ArrSuffix(1 + e.op);
        }
        if (e.kind == AK.CastExpr() && e.type != null) {
            string ct = TypeFullName(e.type);
            if (IsArrTy(ct)) { return ct; }
            return null;
        }
        if (e.kind == AK.AsExpr() && e.type != null) {
            string at2 = TypeFullName(e.type);
            if (IsArrTy(at2)) { return at2; }
            return null;
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            if (e.a != null && e.a.kind == AK.Ident() && FindClass(e.a.sval) != null) {
                string st = FindStaticTy(QualifiedCls(e.a.sval, e.a.sval2), e.sval);
                if (st != null && IsArrTy(st)) { return st; }
            }
            return null;
        }
        if (e.kind == AK.Index()) {
            string et = ElemTyOf(e);
            if (et != null && IsArrTy(et)) { return et; }
            return null;
        }
        if (e.kind == AK.Call()) {
            string rt = CallRetTy(e);
            if (IsArrTy(rt)) { return rt; }
            return null;
        }
        return null;
    }
    int ArrElemSize(string t) {
        string el = t.Substring(0, t.Length - 2);
        if (el == "int" || el == "uint" || el == "float" || el == "char") { return 4; }
        if (el == "short" || el == "ushort") { return 2; }
        if (el == "byte" || el == "sbyte" || el == "bool") { return 1; }
        return 8;
    }

    // element type name of an array type ("byte[]" -> "byte")
    string ArrElemName(string t) {
        if (t == null || t.Length < 3) { return ""; }
        return t.Substring(0, t.Length - 2);
    }

    // base-2 log of the element size (1->0, 2->1, 4->2, 8->3): the lsl
    // shift used in scaled register addressing
    int ArrElemShift(int esz) {
        if (esz == 2) { return 1; }
        if (esz == 4) { return 2; }
        if (esz == 8) { return 3; }
        return 0;
    }

    // element load with the reference compiler's packed layout and value
    // extension rules: x1 = array data, x0 = index -> x0 = element.
    // byte/bool zero-extend, sbyte/short sign-extend, ushort/uint/char
    // zero-extend, int sign-extends; long/ulong/double load full words.
    void EmitArrElemLoad(int esz, string el, int arrReg, int idxReg, int dstReg) {
        if (esz == 1) {
            if (el == "sbyte") {
                E4(0x38C06800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrsb xd, [xn, xi]
            } else {
                E4(0x38606800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrb wd, [xn, xi]
            }
        } else if (esz == 2) {
            if (el == "short") {
                E4(0x78C06800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrsh xd, [xn, xi]
            } else {
                E4(0x78606800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrh wd, [xn, xi]
            }
        } else if (esz == 4) {
            if (el == "int") {
                E4(0xB8A07800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrsw xd, [xn, xi, lsl #2]
            } else if (el == "float") {
                // widen on the way out: single bits in the packed slot
                // (x16 is scratch: register 31 would be the zero register)
                E4(0xB8607800 | (idxReg << 16) | (arrReg << 5) | 16);  // ldr w16, [xn, xi, lsl #2]
                E4(0x1E27021F);                                        // fmov s31, w16
                E4(0x1E22C3FF);                                        // fcvt d31, s31
                E4(0x9E6603E0 | dstReg);                               // fmov xd, d31
            } else {
                E4(0xB8607800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldr wd (uint/char bits)
            }
        } else {
            E4(0xF8607800 | (idxReg << 16) | (arrReg << 5) | dstReg);      // ldr xd, [xn, xi, lsl #3]
        }
    }

    // byte[].ToStr() / ToStr(start, len) with the reference compiler's
    // PACKED byte layout (1 byte per element, probe-verified): the snapshot
    // host lowering walks 8-byte slots, so this call is claimed here and
    // routed to the packed reader below instead of _zan_ext_arr_slice_str.
    bool TryGenPackedSlice(Node e) {
        if (e == null || e.kind != AK.Call() || e.a == null
                || e.a.kind != AK.MemberAccess()) { return false; }
        string name = e.a.sval;
        Node r = e.a.a;
        int n = e.kids.Count;
        if (!((n == 0 || n == 2) && name == "ToStr" && ExtIsBytes(r)
                && !UserDefinesClsMember(null, "ToStr"))) { return false; }
        GenExpr(r);
        ExtPush(0);                              // arr
        if (n == 2) {
            GenExpr(e.kids[0]);
            ExtPush(0);
            GenExpr(e.kids[1]);
            ExtPush(0);
        } else {
            ExtCountOf(0, 9);                    // whole-array length
            LoadImm(0, 0);                       // start
            ExtPush(0);
            ExtPush(9);                          // len (top -> x2)
        }
        // stack (top down): len, start, arr
        ExtPop(2); ExtPop(1); ExtPop(0);
        BLInternal("_zan_packed_slice_str");
        return true;
    }

    // x0 = arr, x1 = start, x2 = len -> stamped string copy of the packed
    // bytes at arr[start..start+len). Same clamps as the host lowering:
    // start<0 -> 0, start>count -> count, len<0 -> 0, tail truncates.
    void HostEmitPackedSlice() {
        HostBegin("_zan_packed_slice_str");
        HostSave(0, 0);
        HostSave(1, 1);
        HostSave(2, 2);
        HostLoad(0, 0);
        ExtCountOf(0, 9);                        // x9 = count
        HostLoad(1, 1);
        ExtCmpImm(1, 0);
        int sPos = NL();
        EmitBcond(10, sPos);
        LoadImm(1, 0);
        Mark(sPos);
        HostCmp(1, 9);
        int sIn = NL();
        EmitBcond(9, sIn);
        ExtMov(1, 9);
        Mark(sIn);
        HostLoad(2, 2);
        ExtCmpImm(2, 0);
        int lPos = NL();
        EmitBcond(10, lPos);
        LoadImm(2, 0);
        Mark(lPos);
        ExtSubRR(9, 9, 1);                       // avail = count - start
        HostCmp(2, 9);
        int lIn = NL();
        EmitBcond(9, lIn);
        ExtMov(2, 9);
        Mark(lIn);
        HostSave(1, 1);                          // clamped start
        HostSave(2, 2);                          // clamped len
        HostLoad(0, 2);
        AddImm(0, 0, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.pslice.malloc");
        HostSave(0, 3);                          // out
        ExtMov(10, 0);                           // out cursor
        HostLoad(11, 2);                         // remaining
        HostLoad(12, 0);                         // arr
        HostLoad(13, 1);                         // start
        AddRR(12, 12, 13);                       // packed: cursor = arr + start
        int slDone = NL();
        int slLoop = NL();
        Mark(slLoop);
        CbzReg(11, slDone);
        E4(0x3940018E);                          // ldrb w14, [x12]
        ExtStrbImm(14, 10, 0);
        AddImm(10, 10, 1);
        AddImm(12, 12, 1);                       // one byte per element
        AddImm(11, 11, -1);
        EmitB(slLoop);
        Mark(slDone);
        ExtStrbImm(31, 10, 0);                   // NUL
        HostLoad(0, 3);
        HostLoad(1, 2);
        BLInternal("_zan_host_copy");            // stamps + NUL
        HostSave(0, 4);
        HostLoad(0, 3);
        BLExtern("_free");
        HostLoad(0, 4);
        HostEnd();
    }

    Fld FieldOf(Node mem) {
        // keep the receiver's instantiation args (Box<double>) -- ClassTyOf
        // would strip them before the type-parameter substitution runs
        string cls = StaticTyOf(mem.a);
        if (cls == null) { return null; }
        return FieldOfInst(cls, mem.sval);
    }

    // field of the instantiated class: the declared field type comes back
    // with the receiver's concrete generic arguments substituted
    // ("List<T>" on Box<double> reads as "List<double>")
    Fld FieldOfInst(string cls, string name) {
        int lt = cls.IndexOf("<");
        string open = lt > 0 ? cls.Substring(0, lt) : cls;
        List<string> args = lt > 0
            ? SplitTyArgs(cls.Substring(lt + 1, cls.Length - lt - 2))
            : new List<string>();
        Cls c = FindClass(open);
        if (c == null) { return null; }
        Fld f = FindField(c, name);
        if (f == null || c.tps.Count == 0 || args.Count == 0) { return f; }
        Fld nf = new Fld(f.name, f.off, SubstTy(f.ty, c.tps, args), f.width, f.explicitLayout);
        return nf;
    }

    // field of the class being emitted (implicit `this` references). A
    // specialization's `this` carries the instantiation (meth.sval2, e.g.
    // "Pool<string>"), so a field declared with the class's type parameter
    // ("T item") resolves through it: `item.ToString()` in Pair$int sees a
    // string field, not an unresolvable "T"
    Fld CurField(string name) {
        Cls c = FindClass(curCls);
        Fld f = FindField(c, name);
        if (f == null || c == null || c.tps.Count == 0) { return f; }
        if (curMeth == null || curMeth.sval2 == null || curMeth.sval2 == "") { return f; }
        return FieldOfInst(curMeth.sval2, name);
    }

    // does ty name a type parameter of the class being emitted? Open
    // generic bodies emit before any instantiation fixes the parameter,
    // so type params stand for erased words (delegate signatures, dict
    // slots); concrete instantiations take the spec pipeline
    bool IsTypeParamErasedNg(string ty) {
        if (ty == null || curCls == null) { return false; }
        Cls c = FindClass(curCls);
        if (c == null) { return false; }
        int i = 0;
        while (i < c.tps.Count) { if (c.tps[i] == ty) { return true; } i = i + 1; }
        return false;
    }

    // One RAW byte as a fresh 1-byte string (strings are byte sequences).
    // Convert.ToString((char)b) is honest UTF-8 since the chrstr rewrite (b >= 0x80 renders multi-byte),
    // but the escape decoder needs literal-POOL bytes, not an encoded code
    // point: slice a fresh 1-byte string and overwrite the byte (string
    // index-write truncates to u8, native_string_ops semantics).
    string RawByteStr(int b) {
        string t = Convert.ToString((char)b);
        string s = t.Substring(0, 1);
        s[0] = b;
        return s;
    }

    // UTF-8 encoding of a code point as a byte string
    string CharBytesNg(int cp) {
        if (cp < 0x80) { return RawByteStr(cp); }
        if (cp < 0x800) {
            return RawByteStr(0xC0 + cp / 64) + RawByteStr(0x80 + cp % 64);
        }
        if (cp < 0x10000) {
            return RawByteStr(0xE0 + cp / 4096) + RawByteStr(0x80 + (cp / 64) % 64)
                + RawByteStr(0x80 + cp % 64);
        }
        return RawByteStr(0xF0 + cp / 262144) + RawByteStr(0x80 + (cp / 4096) % 64)
            + RawByteStr(0x80 + (cp / 64) % 64) + RawByteStr(0x80 + cp % 64);
    }

    bool IsHexDigNg(int c) {
        if (c >= 48 && c <= 57) { return true; }
        if (c >= 97 && c <= 102) { return true; }
        if (c >= 65 && c <= 70) { return true; }
        return false;
    }

    int HexValNg(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 97 + 10; }
        return c - 65 + 10;
    }

    string DecodeLiteralNg(string raw) {
        string result = "";
        int i = 0;
        while (i < raw.Length) {
            string c = raw.Substring(i, 1);
            if ((int)raw[i] == 92 && i + 1 < raw.Length) {
                i = i + 1;
                int next = (int)raw[i];
                c = raw.Substring(i, 1);
                if (next == 110) { c = "\n"; }
                else if (next == 116) { c = "\t"; }
                else if (next == 114) { c = "\r"; }
                else if (next == 48) { c = "\0"; }
                else if (next == 120 || next == 88) {
                    // \xH[HH..]: greedy 1..4 hex digits (C# rule)
                    int hv = 0;
                    int cnt = 0;
                    i = i + 1;
                    while (cnt < 4 && i < raw.Length && IsHexDigNg((int)raw[i])) {
                        hv = hv * 16 + HexValNg((int)raw[i]);
                        i = i + 1;
                        cnt = cnt + 1;
                    }
                    c = CharBytesNg(hv);
                    result = result + c;
                    continue;
                }
                else if (next == 117 || next == 85) {
                    // \uHHHH / \UHHHHHHHH: fixed-width hex code point
                    int width = next == 117 ? 4 : 8;
                    int hv2 = 0;
                    int cnt2 = 0;
                    i = i + 1;
                    while (cnt2 < width && i < raw.Length && IsHexDigNg((int)raw[i])) {
                        hv2 = hv2 * 16 + HexValNg((int)raw[i]);
                        i = i + 1;
                        cnt2 = cnt2 + 1;
                    }
                    c = CharBytesNg(hv2);
                    result = result + c;
                    continue;
                }
            }
            result = result + c;
            i = i + 1;
        }
        return result;
    }

    // Whether a string-typed expression's NUL terminator is a reliable bound
    // for the substring window check (mirrors the C host's
    // expr_has_reliable_string_bounds): only string literals and plain local
    // identifiers of string type qualify. Everything else -- string
    // parameters, extern call results and raw FFI buffers kept in `string`
    // slots (the stdlib slices `struct dirent*` byte by byte) -- may carry
    // bytes past the first NUL or lack a length header entirely, so a
    // header-backed window check would reject in-range reads; those slice
    // raw.
    bool IsBoundedStrExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.StringLit()) { return true; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            return li >= 0 && locTy[li] == "string" && locOpaq[li] == 0;
        }
        return false;
    }

    // does this expression evaluate to a string? (local type / field type /
    // string literal / concatenation / method with a string return type)
    bool IsStrExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a) == "string"; }
        if (e.kind == AK.Call() && HostCallRetTy(e) == "string") { return true; }
        if (e.kind == AK.StringLit()) { return true; }
        if (e.kind == AK.Binary()) {
            if (e.op == TK.QQ()) { return IsStrExpr(e.a) || IsStrExpr(e.b); }
            return e.op == TK.Plus() && (IsStrExpr(e.a) || IsStrExpr(e.b));
        }
        // both arms strings: the conditional yields a heap string either way
        if (e.kind == AK.Conditional()) { return IsStrExpr(e.b) && IsStrExpr(e.c); }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && f.ty == "string") { return true; }
            // class-qualified static field (`Registry.tag`); an unresolved
            // name may still be an instance property read (kv.Key)
            if (e.a != null && e.a.kind == AK.Ident()) {
                string st2 = FindStaticTy(QualifiedCls(e.a.sval, e.a.sval2), e.sval);
                if (st2 != null) { return st2 == "string"; }
            }
            return PropGetterTy(e) == "string";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "string"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "string") { return true; }
            return FindStaticTy(curCls, e.sval) == "string";
        }
        if (e.kind == AK.Index()) {
            // instantiated generic containers carry string elements
            // (List<string> read through Box<string>.values)
            return ElemTyOf(e) == "string";
        }
        if (e.kind == AK.Call() && e.a != null) {
            if (e.a.kind == AK.MemberAccess()) {
                // string.Join(sep, List<string>) yields a heap string;
                // Substring too; any other member call falls through to
                // the user-method return type below
                if (e.a.sval == "Substring") { return true; }
                Node rj = e.a.a;
                if (rj != null && rj.kind == AK.Ident() && rj.sval == "string" && e.a.sval == "Join") { return true; }
                // Convert.ToString(x) yields a heap string
                if (rj != null && rj.kind == AK.Ident() && rj.sval == "Convert"
                        && e.a.sval == "ToString" && e.kids.Count == 1
                        && !UserDefinesClsMember("Convert", "ToString")) { return true; }
                // scalar x.ToString("spec"): the printf-render intrinsic
                // (spliced from interpolation holes) yields a heap string
                if (e.a.sval == "ToString" && e.kids.Count == 1
                        && e.kids[0] != null && e.kids[0].kind == AK.StringLit()
                        && ScalarToStringTy(e.a.a) != null) { return true; }
            }
            return CallRetTy(e) == "string";
        }
        // List<string> element reads yield heap strings (string indexing
        // yields a char codepoint -- see IsCharExpr, not a string)
        if (e.kind == AK.Index()) { return IsStrListOf(e.a); }
        return false;
    }

    // does this expression denote a List<string> (element reads are strings)?
    // does this expression evaluate to a List<double>/double[]? (element
    // reads are double bit patterns either way)
    bool IsDblListOf(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li < 0) { return false; }
            return IsDblListTy(locTy[li]);
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && IsDblListTy(f.ty);
        }
        if (e.kind == AK.NewExpr()) {
            return e.type != null && IsDblListTy(TypeFullName(e.type) + (e.ival == 1 ? "[]" : ""));
        }
        return false;
    }

    bool IsDblListTy(string t) {
        return t == "List<double>" || t == "List<float>" || t == "double[]" || t == "float[]";
    }

    bool IsStrListOf(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "List<string>" || locTy[li] == "string[]"; }
            Fld f = CurField(e.sval);
            return f != null && (f.ty == "List<string>" || f.ty == "string[]");
        }
        if (e.kind == AK.NewExpr()) {
            return e.type != null
                && (TypeFullName(e.type) == "List<string>"
                    || (e.ival == 1 && TypeFullName(e.type) + "[]" == "string[]"));
        }
        return false;
    }

    // does this expression evaluate to a double? (float literal / double
    // typed local or field / double-returning method / double arithmetic)
    // declared floating type: `float` rides the same f64 registers and
    // conversions as `double` (ngen keeps one floating representation)
    bool IsDblTy(string t) { return t == "double" || t == "float"; }

    bool IsDblExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) {
            string at2 = AsyncAwaitElemTyNg(e.a);
            return at2 == "double" || at2 == "float";
        }
        if (e.kind == AK.Conditional()) { return IsDblExpr(e.b) || IsDblExpr(e.c); }
        if (e.kind == AK.FloatLit()) { return true; }
        if (e.kind == AK.Unary() && e.op == TK.Minus()) { return IsDblExpr(e.a); }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star() || op == TK.Slash()) {
                return IsDblExpr(e.a) || IsDblExpr(e.b);
            }
            return false;
        }
        if (e.kind == AK.CastExpr() && e.type != null) { return IsDblTy(e.type.sval); }
        if (e.kind == AK.Index()) {
            if (ExprCls(e.a) == "Dict") { return IsDblTy(ElemTyOf(e)); }
            if (IsArrExpr(e.a)) {
                string at3 = ArrTyOf(e.a);
                return at3 == "double[]" || at3 == "float[]";
            }
            return IsDblListOf(e.a);
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null) { return IsDblTy(f.ty); }
            string pt = PropGetterTy(e);
            if (pt != null && pt != "") { return IsDblTy(pt); }
            // qualified static reads (Store.d, double.MaxValue) type
            // through StaticTyOf
            return IsDblTy(StaticTyOf(e));
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return IsDblTy(locTy[li]); }
            Fld f = CurField(e.sval);
            if (f != null && IsDblTy(f.ty)) { return true; }
            return IsDblTy(FindStaticTy(curCls, e.sval));
        }
        if (e.kind == AK.Call() && e.a != null) {
            if (e.a.kind == AK.MemberAccess()) {
                Node rm = e.a.a;
                // Convert.ToDouble(x) is always double (gen0 lowerings)
                if (rm != null && rm.kind == AK.Ident() && rm.sval == "Convert"
                        && e.a.sval == "ToDouble" && e.kids.Count == 1) { return true; }
                // double.Parse(s) is always double
                if (rm != null && rm.kind == AK.Ident() && e.a.sval == "Parse"
                        && e.kids.Count == 1
                        && (rm.sval == "double" || rm.sval == "float"
                            || rm.sval == "Double" || rm.sval == "Single")) { return true; }
                // Math library calls: Sqrt/Floor/Ceiling/Pow/Sin/Cos/Tan/
                // Log/Exp/Round are always double; Abs/Max/Min are double
                // when any argument is
                if (rm != null && rm.kind == AK.Ident() && rm.sval == "Math") {
                    string mn = e.a.sval;
                    if (mn == "Sqrt" || mn == "Floor" || mn == "Ceiling" || mn == "Pow"
                            || mn == "Sin" || mn == "Cos" || mn == "Tan"
                            || mn == "Log" || mn == "Exp" || mn == "Round") { return true; }
                    if (mn == "Abs" && e.kids.Count == 1) { return IsDblExpr(e.kids[0]); }
                    if ((mn == "Max" || mn == "Min") && e.kids.Count == 2) {
                        return IsDblExpr(e.kids[0]) || IsDblExpr(e.kids[1]);
                    }
                }
            }
            return IsDblTy(CallRetTy(e));
        }
        return false;
    }

    // does this expression evaluate to a char? (char literals, string
    // indexing, char-typed locals/fields/statics -- rendering goes through
    // zan_rt_chrstr)
    bool IsCharExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a) == "char"; }
        if (e.kind == AK.CharLit()) { return true; }
        if (e.kind == AK.Index()) { return IsStrExpr(e.a); }
        if (e.kind == AK.CastExpr() && e.type != null) { return e.type.sval == "char"; }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && f.ty == "char";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "char"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "char") { return true; }
            return FindStaticTy(curCls, e.sval) == "char";
        }
        if (e.kind == AK.Call() && e.a != null) { return CallRetTy(e) == "char"; }
        return false;
    }

    // does this expression evaluate to a ulong? (ulong typed locals,
    // fields and method results; arithmetic carrying a ulong operand --
    // ulong is the only integer type whose slot can set the high bit)
    bool IsUlongExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a) == "ulong"; }
        if (e.kind == AK.IntLit()) {
            // a UL/lu-suffixed literal types as ulong (gen0's checker)
            return e.suffix - (e.suffix / 4) * 4 == 3;
        }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star()
                    || op == TK.Slash() || op == TK.Percent()
                    || op == TK.LessLess() || op == TK.GreaterGreater()) {
                return IsUlongExpr(e.a) || IsUlongExpr(e.b);
            }
            return false;
        }
        if (e.kind == AK.CastExpr() && e.type != null) {
            return e.type.sval == "ulong" && !IsDblExpr(e.b);
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && f.ty == "ulong";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "ulong"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "ulong") { return true; }
            return FindStaticTy(curCls, e.sval) == "ulong";
        }
        if (e.kind == AK.Call() && e.a != null) {
            return CallRetTy(e) == "ulong";
        }
        return false;
    }

    // 32-bit-ness of an integer expression: 1 = signed int, 2 = unsigned
    // uint, 0 = long/ulong/unknown (leave 64-bit arithmetic alone). gen0
    // wraps int/uint arithmetic at the declared width.
    int Int32Kind(Node e) {
        if (e == null) { return 0; }
        if (e.kind == AK.IntLit()) {
            // literals emit as 64-bit values in gen0: `a * 3` reconciles the
            // i32 local up to i64 and never wraps, while `a + b` (two i32
            // locals) wraps at the operation. Only a shift's declared-width
            // count masking still treats a bare literal as int (ShiftMask32).
            return 0;
        }
        if (e.kind == AK.Unary() && e.op == TK.Minus()) { return Int32Kind(e.a); }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star()
                    || op == TK.Slash() || op == TK.Percent()) {
                int ka = Int32Kind(e.a);
                int kb = Int32Kind(e.b);
                if (ka == 2 && kb == 2) { return 2; }
                if (ka == 1 && kb == 1) { return 1; }
                return 0;
            }
            return 0;
        }
        if (e.kind == AK.CastExpr() && e.type != null) {
            if (e.type.sval == "int") { return 1; }
            if (e.type.sval == "uint") { return 2; }
            return 0;
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && f.ty == "int") { return 1; }
            if (f != null && f.ty == "uint") { return 2; }
            return 0;
        }
        if (e.kind == AK.Ident()) {
            string t = null;
            int li = LocalIdx(e.sval);
            if (li >= 0) { t = locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null) { t = f.ty; }
            if (t == null) { t = FindStaticTy(curCls, e.sval); }
            if (t == "int") { return 1; }
            if (t == "uint") { return 2; }
            return 0;
        }
        if (e.kind == AK.Call() && e.a != null) {
            string rt = CallRetTy(e);
            if (rt == "int") { return 1; }
            if (rt == "uint") { return 2; }
            return 0;
        }
        return 0;
    }

    // truncate x0 to its 32-bit slot width: signed re-extends the sign,
    // unsigned fills with zeros (gen0's declared-width arithmetic)
    void Wrap32(int kind) {
        if (kind == 1) { E4(0x93407C00); }           // sbfm x0, x0, #0, #31
        else if (kind == 2) { E4(0xD3407C00); }      // ubfm x0, x0, #0, #31
    }

    // does this shift's LEFT operand declare a <=32-bit width? gen0 masks
    // the count by the declared width (a bare literal declares int; only
    // an L/UL suffix declares long), regardless of its 64-bit register form
    bool ShiftMask32(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.IntLit()) {
            int sfx = e.suffix - (e.suffix / 4) * 4;   // 1 = L, 3 = UL
            return sfx != 1 && sfx != 3;
        }
        return Int32Kind(e) != 0;
    }

    // does this expression evaluate to a bool? (comparisons / bool locals,
    // fields and method results -- WriteLine renders those true/false)
    bool IsBoolExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a) == "bool"; }
        if (e.kind == AK.BoolLit()) { return true; }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            return op == TK.Less() || op == TK.Greater() || op == TK.LessEq()
                || op == TK.GreaterEq() || op == TK.EqEq() || op == TK.BangEq()
                || op == TK.AmpAmp() || op == TK.PipePipe();
        }
        if (e.kind == AK.Unary()) { return e.op == TK.Bang(); }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null) { return f.ty == "bool"; }
            return PropGetterTy(e) == "bool";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "bool"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "bool") { return true; }
            return FindStaticTy(curCls, e.sval) == "bool";
        }
        if (e.kind == AK.Call() && e.a != null) {
            // string.IsNullOrEmpty(s): gen0's inference fails on the
            // extension-method-in-static form, so WriteLine renders its
            // 0/1 result numerically instead of true/false
            if (e.a.kind == AK.MemberAccess() && e.a.sval == "IsNullOrEmpty"
                    && e.kids.Count == 1 && e.a.a != null
                    && e.a.a.kind == AK.Ident()
                    && (e.a.a.sval == "string" || e.a.a.sval == "String")) {
                return false;
            }
            // gen0 lowers string/List Contains to a 0/1 int probe, so
            // WriteLine renders it numerically (log_rolling_file golden
            // prints 0/1, not true/false)
            if (e.a.kind == AK.MemberAccess() && e.a.sval != null) {
                string cn9 = e.a.sval;
                int d9 = cn9.IndexOf("$");
                if (d9 > 0) { cn9 = cn9.Substring(0, d9); }
                if (cn9 == "Contains") { return false; }
            }
            return CallRetTy(e) == "bool";
        }
        return false;
    }

    string MethRetTy(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return ""; }
        int i = 0;
        while (i < cs.Count) {
            // TypeFullName keeps the array suffix and generic argument;
            // type.sval alone would turn a `byte[]` return into "byte"
            if (methNodes[cs[i]].type != null) { return TypeFullName(methNodes[cs[i]].type); }
            i = i + 1;
        }
        return "";
    }

    // declared return type of a call with the receiver's type arguments
    // substituted for the declaring class's type parameters: with
    // `Box<string> b`, `b.At(i)` reads as `string`, not the bare `T`
    // (gen0 instantiates generics; ngen substitutes textually). Falls
    // back to the raw declared type whenever either side is unknown.
    // type of a call's callee VALUE, typing the receiver chain once; mirrors
    // StaticTyOfInner's MemberAccess arm for member callees. CallRetTy needs
    // both the callee's type (delegate dispatch) and the receiver's class
    // (generic SubstTy tail); typing each independently re-walks a fluent
    // chain's prefix per level and turns a 12-call chain into an
    // exponential number of walks (DownloadJob.SnapshotPolicy hang).
    string CalleeTyOf(Node cc) {
        if (cc == null) { return null; }
        if (cc.kind != AK.MemberAccess()) { return StaticTyOf(cc); }
        if ((cc.sval == "Keys" || cc.sval == "Values") && ExprCls(cc.a) == "Dict") {
            return "List<" + DictSlotTy(cc.a, cc.sval == "Keys") + ">";
        }
        if (cc.a != null && cc.a.kind == AK.Ident() && FindEnum(cc.a.sval) >= 0) { return cc.a.sval; }
        Fld f = FieldOf(cc);
        return f != null ? f.ty : null;
    }

    string CallRetTy(Node e) {
        Node cc = DelegateCalleeNg(e);
        if (cc == null) { cc = e.a; }
        string recvTy = null;
        string valTy = null;
        if (cc != null && cc.kind == AK.MemberAccess() && cc.a != null) {
            // one walk down the receiver chain; FieldOf's substitution is
            // applied directly so the chain is not re-typed
            recvTy = StaticTyOf(cc.a);
            if (recvTy != null) {
                Fld cf = FieldOfInst(recvTy, cc.sval);
                if (cf != null) { valTy = cf.ty; }
            }
        } else {
            valTy = StaticTyOf(cc);
        }
        if (valTy != null && IsDelegateTyNg(valTy)) { return DelegateRetNg(valTy); }
        string ht = HostCallRetTy(e);
        if (ht != null) { return ht; }
        string st = StringCallRetTy(e);
        if (st != null) { return st; }
        // builtin ToString renders a string although no user method
        // declares it: enum receivers do a member-name lookup and scalar
        // receivers go through the shared renderers (GenCall's builtin
        // branches run before user dispatch, so the type model must agree
        // -- otherwise consumers like WriteLine see "no type" and print
        // the returned pointer as an integer)
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.sval == "ToString"
                && e.kids != null && e.kids.Count == 0 && e.a.a != null
                && (EnumTyOf(e.a.a) != null || ScalarToStringTy(e.a.a) != null)) {
            return "string";
        }
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.sval == "TryParse"
                && e.kids != null && e.kids.Count == 2 && e.a.a != null
                && e.a.a.kind == AK.Ident() && FindEnum(e.a.a.sval) >= 0) {
            return "bool";
        }
        // Dictionary Remove the runtime lowers directly; the reference types
        // it bool (prints true/false) while ContainsKey/TryGetValue stay int
        // (prints 0/1). Keep the model exact. The callee may carry a generic
        // spec suffix ("Remove$string"), so compare the bare name.
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.sval != null
                && e.kids != null && e.kids.Count == 1) {
            string rname = e.a.sval;
            int rd = rname.IndexOf("$");
            if (rd > 0) { rname = rname.Substring(0, rd); }
            // name check BEFORE ExprCls: typing the receiver here re-walks
            // fluent-chain prefixes and compounds per level
            if (rname == "Remove" && e.a.a != null && ExprCls(e.a.a) == "Dict") { return "bool"; }
        }
        // File.Exists the runtime answers with a 0/1 bool (feeds `!`/if directly)
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.sval == "Exists"
                && e.a.a != null && e.a.a.kind == AK.Ident() && e.a.a.sval == "File"
                && e.kids != null && e.kids.Count == 1) {
            return "bool";
        }
        int staticIdx = ResolveStaticNg(e);
        if (staticIdx < 0 && e.a != null && e.a.kind == AK.Ident() && LocalIdx("this") >= 0) {
            List<int> inst = new List<int>();
            InstanceCands(curCls, e.a.sval, inst);
            if (inst.Count > 0) {
                int ii = inst.Count == 1 ? inst[0] : FitPickIdx(inst, e);
                if (ii >= 0) { return TypeFullName(methNodes[ii].type); }
            }
            // curCls's own statics (incl. inherited) outrank the global name
            // table: same-named methods across classes are common once the
            // real stdlib compiles (jsongen.GenClass vs irgen.GenClass)
            string wcls = curCls;
            while (wcls != null && staticIdx < 0) {
                List<int> wc2 = MethCandsClsName(wcls, e.a.sval);
                if (wc2 != null) {
                    int wi = 0;
                    while (wi < wc2.Count) {
                        if (methStat[wc2[wi]] == 1) { staticIdx = wc2[wi]; break; }
                        wi = wi + 1;
                    }
                }
                Cls wc = FindClass(wcls);
                wcls = wc != null ? wc.baseName : null;
            }
        }
        string rty = null;
        if (staticIdx >= 0) {
            rty = TypeFullName(methNodes[staticIdx].type);
        } else if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.a != null) {
            // the receiver's class chain outranks the global name table:
            // same-named methods across classes are common (SignalString.Get
            // vs SignalInt.Get) and the global pick is arbitrary
            string rcv = recvTy != null ? recvTy : StaticTyOf(e.a.a);
            if (rcv != null && !IsDelegateTyNg(rcv)) {
                string w2 = rcv;
                int lt9 = w2.IndexOf("<");
                if (lt9 > 0) { w2 = w2.Substring(0, lt9); }
                List<int> ic = new List<int>();
                while (w2 != null && ic.Count == 0) {
                    InstanceCands(w2, e.a.sval, ic);
                    if (ic.Count == 0) { Cls c9 = FindClass(w2); w2 = c9 != null ? c9.baseName : null; }
                }
                int pick9 = ic.Count == 1 ? ic[0] : (ic.Count > 1 ? FitPickIdx(ic, e) : -1);
                if (pick9 >= 0) { rty = TypeFullName(methNodes[pick9].type); }
            }
        }
        if (rty == null || rty == "") { rty = MethRetTy(e.a != null ? e.a.sval : null); }
        if (rty == null || rty == "") { return rty; }
        if (e.a == null || e.a.kind != AK.MemberAccess() || e.a.a == null) { return rty; }
        // recvTy (typed above, cc == e.a here) IS StaticTyOf(e.a.a): re-typing
        // it re-walks fluent-chain prefixes at every level, compounding
        // exponentially (DownloadJob.SnapshotPolicy hang). Only the
        // .Invoke-stripped shape needs a fresh type.
        string recv = recvTy;
        if (recv == null && e.a.sval == "Invoke") { recv = StaticTyOf(e.a.a); }
        if (recv == null) { return rty; }
        int lt = recv.IndexOf("<");
        if (lt <= 0 || recv.Substring(recv.Length - 1, 1) != ">") { return rty; }
        Cls rc = FindClass(recv.Substring(0, lt));
        if (rc == null || rc.tps.Count == 0) { return rty; }
        List<string> targs = SplitTyArgs(recv.Substring(lt + 1, recv.Length - lt - 2));
        return SubstTy(rty, rc.tps, targs);
    }

    // top-level comma split of a generic argument list ("Node, Box<Node>")
    List<string> SplitTyArgs(string s) {
        List<string> parts = new List<string>();
        string cur = "";
        int depth = 0;
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "<") { depth = depth + 1; }
            else if (ch == ">") { depth = depth - 1; }
            if (ch == "," && depth == 0) { parts.Add(cur); cur = ""; }
            else { cur = cur + ch; }
            i = i + 1;
        }
        if (cur != "") { parts.Add(cur); }
        return parts;
    }

    // rewrite type-parameter names inside a declared type string: bare
    // `T`, `T[]` and `Head<A, T>` forms all substitute
    string SubstTy(string t, List<string> ps, List<string> as2) {
        if (t == null || t == "") { return t; }
        if (ps == null || as2 == null) { return t; }
        if (IsArrTy(t)) { return SubstTy(t.Substring(0, t.Length - 2), ps, as2) + "[]"; }
        int lt = t.IndexOf("<");
        if (lt > 0 && t.Substring(t.Length - 1, 1) == ">") {
            string head = t.Substring(0, lt);
            List<string> kids = SplitTyArgs(t.Substring(lt + 1, t.Length - lt - 2));
            string res = SubstTy(head, ps, as2) + "<";
            int i = 0;
            while (i < kids.Count) {
                if (i > 0) { res = res + ","; }
                res = res + SubstTy(kids[i], ps, as2);
                i = i + 1;
            }
            return res + ">";
        }
        int pi = IndexOfStrNg(ps, t);
        if (pi >= 0) { return as2[pi]; }
        return t;
    }

    // dispatch a binary operator to a static op_* overload declared on
    // either operand's class (mirrors irgen's TryOpOverload): the call goes
    // through the ordinary static-call machinery, so overload fit, argument
    // narrowing and double conversion all behave like a written-out call.
    // Returns false when no overload applies and the builtin paths must run.
    bool TryOpOverloadNg(Node e) {
        if (IsStrExpr(e.a) || IsStrExpr(e.b)) { return false; }
        // comparisons against the null literal stay reference compares, so
        // an op_eq body can null-check without recursing into itself
        // (gen0 irgen's null_cmp rule)
        if ((e.a != null && e.a.kind == AK.NullLit())
                || (e.b != null && e.b.kind == AK.NullLit())) { return false; }
        string mn = OpMethodNameNg(e.op);
        if (mn == "") { return false; }
        string owner = null;
        string ca = ExprCls(e.a);
        if (ca != null && OpOverloadExists(ca, mn)) { owner = ca; }
        if (owner == null) {
            string cb = ExprCls(e.b);
            if (cb != null && OpOverloadExists(cb, mn)) { owner = cb; }
        }
        // gen0 semantics: only the exact op_* dispatches; `!=`/`==` without
        // their own overload fall back to reference comparison (the builtin
        // path), NOT to the negation of the paired operator
        if (owner == null) { return false; }
        Node callN = new Node(AK.Call());
        Node tgt = new Node(AK.Ident());
        tgt.line = e.line;
        tgt.col = e.col;
        tgt.sval = mn;
        callN.a = tgt;
        callN.line = e.line;
        callN.col = e.col;
        callN.kids.Add(e.a);
        callN.kids.Add(e.b);
        GenCall(callN);
        return true;
    }

    // operator token -> op_* overload method name ("" when not overloadeable)
    string OpMethodNameNg(int op) {
        if (op == TK.Plus()) { return "op_add"; }
        if (op == TK.Minus()) { return "op_sub"; }
        if (op == TK.Star()) { return "op_mul"; }
        if (op == TK.Slash()) { return "op_div"; }
        if (op == TK.Percent()) { return "op_mod"; }
        if (op == TK.EqEq()) { return "op_eq"; }
        if (op == TK.BangEq()) { return "op_neq"; }
        if (op == TK.Less()) { return "op_lt"; }
        if (op == TK.Greater()) { return "op_gt"; }
        if (op == TK.LessEq()) { return "op_le"; }
        if (op == TK.GreaterEq()) { return "op_ge"; }
        return "";
    }

    // does this class (or any base) declare a member with that name?
    bool OpOverloadExists(string cls, string name) {
        string c2 = cls;
        while (c2 != null) {
            if (UserDefinesClsMember(c2, name)) { return true; }
            Cls cc = FindClass(c2);
            c2 = cc != null ? cc.baseName : null;
        }
        return false;
    }

    // symbol of a static op_* method declared on cls, or null
    string OpStaticSym(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) {
                return MethSymNg(cls, methNodes[cs[i]]);
            }
            i = i + 1;
        }
        return null;
    }

    // shared IndexOf/Contains loop: value equality per element kind --
    // strings by strcmp, structs by their op_eq (when declared) else
    // field-wise, primitives by register compare (gen0 parity)
    void GenListFind(Node recv, Node arg, bool wantIndex) {
        GenListSearch(recv, arg, wantIndex, false);
    }

    void GenListSearch(Node recv, Node arg, bool wantIndex, bool remove) {
        int save = 19;
        while (save <= 23) { E4(0xF81F0FE0 | save); save = save + 1; }
        GenExpr(recv);
        E4(0xF81F0FE0);                          // push list
        GenExpr(arg);
        E4(0xF84107E1);                          // pop list -> x1 (x0 = value)
        MovRR(19, 1);                            // x19 = list
        MovRR(22, 0);                            // x22 = value
        LdrU(20, 19, 0);                         // x20 = count
        LdrU(21, 19, 16);                        // x21 = data
        E4(0xD2800017);                          // movz x23, #0 (i)
        Cls es = StructOf(arg);
        string eqSym = es != null ? OpStaticSym(es.name, "op_eq") : null;
        int lp = NL();
        int nof = NL();
        int yes = NL();
        int done = NL();
        Mark(lp);
        E4(0xEB1402FF);                          // cmp x23, x20
        EmitBcond(10, nof);                      // b.ge nof
        E4(0xF8777AA0);                          // ldr x0, [x21, x23, lsl #3]
        if (IsStrExpr(arg)) {
            MovRR(1, 22);
            BLExtern("_strcmp");
            E4(0x7100001F);                      // cmp w0, #0
            EmitBcond(0, yes);                   // b.eq
        } else if (eqSym != null) {
            MovRR(1, 22);
            BLInternal(eqSym);                   // bool op_eq(elem, value)
            EmitCbnz(0, yes);                    // non-zero -> hit
        } else if (es != null) {
            // field-wise: every slot must match
            int fail = NL();
            int fi = 0;
            while (fi < es.flds.Count) {
                LoadFieldNg(2, 0, es.flds[fi]);
                LoadFieldNg(3, 22, es.flds[fi]);
                E4(0xEB03005F);                  // cmp x3, x2
                EmitBcond(1, fail);              // b.ne
                fi = fi + 1;
            }
            EmitB(yes);
            Mark(fail);
        } else {
            E4(0xEB16001F);                      // cmp x0, x22
            EmitBcond(0, yes);                   // b.eq
        }
        AddImm(23, 23, 1);
        EmitB(lp);
        Mark(nof);
        if (wantIndex) { LoadImm(0, -1); } else { LoadImm(0, 0); }
        EmitB(done);
        Mark(yes);
        if (remove) {
            MovRR(0, 19);
            MovRR(1, 23);
            BLInternal("_zan_rt_list_removeat");
            LoadImm(0, 1);
        } else if (wantIndex) { MovRR(0, 23); } else { LoadImm(0, 1); }
        Mark(done);
        save = 23;
        while (save >= 19) { E4(0xF84107E0 | save); save = save - 1; }
    }

    // nearest instance implementation of `name` strictly above curCls in the
    // base chain (base-call semantics: curCls's own overrides are skipped,
    // abstract declarations do not terminate the walk)
    int ResolveBaseImplNg(string name, Node call) {
        Cls mine = curCls != null ? FindClass(curCls) : null;
        string cur = mine != null ? mine.baseName : null;
        while (cur != null) {
            Cls cc = FindClass(cur);
            string cn = cc != null ? cc.name : cur;
            List<int> cands = new List<int>();
            List<int> cc2 = MethCandsClsName(cn, name);
            if (cc2 != null) {
                int q = 0;
                while (q < cc2.Count) {
                    if (methStat[cc2[q]] != 1) { cands.Add(cc2[q]); }
                    q = q + 1;
                }
            }
            int pick = cands.Count > 0 ? FitPickIdx(cands, call) : -1;
            if (pick >= 0 && !HasMod(methNodes[pick], MOD.Abstract())) { return pick; }
            cur = cc != null ? cc.baseName : null;
        }
        return -1;
    }

    void GenCall(Node e) {
        if (TryGenDelegateCall(e)) { return; }
        if (TryGenPackedSlice(e)) { return; }
        if (TryGenHostCall(e)) { return; }
        if (TryGenStringCall(e)) { return; }
        Node callee = e.a;
        if (callee != null && callee.kind == AK.MemberAccess()) {
            Node recv = callee.a;
            // base.Method(args): invoke the nearest implementation above
            // curCls directly (nonvirtual) with `this` as the receiver
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "base") {
                int bi2 = ResolveBaseImplNg(callee.sval, e);
                if (bi2 >= 0) {
                    GenExpr(new Node(AK.ThisExpr()));
                    E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                    int pushed2 = PushCallArgs(methNodes[bi2], e);
                    int r2 = pushed2;
                    while (r2 >= 1) { E4(0xF84107E0 | r2); r2 = r2 - 1; }
                    E4(0xF84107E0);                          // ldr x0, [sp], #16 (this)
                    BLInternal(MethSymNg(methCls[bi2], methNodes[bi2]));
                    return;
                }
            }
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "WriteLine" && e.kids.Count == 1) {
                // own runtime core: print_int(i64) / println(str)
                if (IsStrExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_println");
                } else if (IsCharExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_chrstr");
                    BLInternal("_zan_rt_println");
                } else if (IsBoolExpr(e.kids[0])) {
                    // gen0 prints bools as true/false (select of literals)
                    GenExpr(e.kids[0]);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                    BLInternal("_zan_rt_println");
                } else if (IsDblExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    E4(0x9E670000);                      // fmov d0, x0
                    BLExtern("_zan_rt_print_double");
                } else if (IsUlongExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_uint");
                } else {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_int");
                }
                return;
            }
            // Console.WriteLine() with no arguments prints just the newline
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "WriteLine" && e.kids.Count == 0) {
                LoadStr(InternStr(""), 0);
                BLInternal("_zan_rt_println");
                return;
            }
            // Console.Write: no newline; gen0 routes every argument type
            // through its string form and printf("%s", s)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "Write" && e.kids.Count == 1) {
                Node arg = e.kids[0];
                if (IsStrExpr(arg)) { GenExpr(arg); }
                else if (IsCharExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_chrstr");
                } else if (IsBoolExpr(arg)) {
                    GenExpr(arg);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                } else if (IsDblExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_dbl2str");
                } else if (IsUlongExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_uint2str");
                } else {
                    GenExpr(arg); BLInternal("_zan_rt_int2str");
                }
                E4(0xF81F0FE0);                      // push s (stack variadic)
                if (EnvTargetElf() == 1) {
                    LdrU(1, 31, 0);                  // Linux: x1 = s (register vararg)
                }
                LoadSymRef("l_.str." + fmtwIdx, 0);  // x0 = "%s"
                BLExtern("_printf");
                if (EnvTargetElf() == 0) {
                    AddSPImm(16, true);              // drop the Darwin stack slot
