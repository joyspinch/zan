                    GenExpr(e.kids[0]);
                    MovRR(2, 0);                     // x2 = src
                    E4(0xF84107E0);                  // pop dst -> x0
                    MovRR(1, 2);                     // x1 = src
                    BLInternal("_zan_rt_list_addrange");
                    return;
                }
                if (callee.sval == "ToArray" && e.kids.Count == 0) {
                    GenExpr(recv);
                    // float elements repack into a real packed float[]
                    BLInternal(StaticTyOf(recv) == "List<float>"
                        ? "_zan_rt_list_toarray_f32" : "_zan_rt_list_toarray");
                    return;
                }
                diags.Error("ngen: unsupported List operation '" + callee.sval + "'", e.line, e.col);
                return;
            }
            // Dictionary<string, T> built-ins on a dict receiver: set/add,
            // contains/remove/query/clear route to the runtime helpers
            if (ExprCls(recv) == "Dict") {
                if (!DictCheckType(recv)) { return; }
                if (e.kids.Count > 0) { DictCheckOperand(recv, e.kids[0], true); }
                if (callee.sval == "Add" && e.kids.Count == 2) {
                    DictCheckOperand(recv, e.kids[1], false);
                    // dict.Add(key, value): receiver under the args so a
                    // nested call inside any operand cannot clobber the
                    // dict; value pushes first, then key, then the dict
                    GenExpr(e.kids[1]);              // value -> x0
                    E4(0xF81F0FE0);                  // push value
                    GenExpr(e.kids[0]);              // key -> x0
                    E4(0xF81F0FE0);                  // push key
                    GenExpr(recv);                   // dict -> x0
                    E4(0xF81F0FE0);                  // push dict
                    RtDictSet3();
                    return;
                }
                if (callee.sval == "ContainsKey" && e.kids.Count == 1) {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                  // push dict
                    GenExpr(e.kids[0]);              // key -> x0
                    MovRR(1, 0);                     // x1 = key
                    E4(0xF84107E0);                  // pop dict -> x0
                    BLInternal("_zan_rt_dict_contains");
                    return;
                }
                if (callee.sval == "Remove" && e.kids.Count == 1) {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                  // push dict
                    GenExpr(e.kids[0]);              // key -> x0
                    MovRR(1, 0);                     // x1 = key
                    E4(0xF84107E0);                  // pop dict -> x0
                    BLInternal("_zan_rt_dict_remove");
                    return;
                }
                if (callee.sval == "Clear" && e.kids.Count == 0) {
                    GenExpr(recv);
                    BLInternal("_zan_rt_dict_clear");
                    return;
                }
                if (callee.sval == "TryGetValue" && e.kids.Count == 2) {
                    // dict.TryGetValue(key, out v): found -> 1 and *out = value
                    Node outa = e.kids[1];
                    Node place = outa.type == null ? outa.a : null;
                    bool narrow = place != null && place.kind == AK.Index()
                        && ArrContainerTy(place.a) != null
                        && ArrElemSize(ArrContainerTy(place.a)) != 8;
                    if (narrow) {
                        // The runtime store is a full 8-byte slot; a packed
                        // narrow element destination (byte[]/short[]/int[]...)
                        // would overwrite its neighbors. Stage the value in a
                        // scratch slot and store only the element's width.
                        GenExpr(recv);
                        E4(0xF81F0FE0);                  // push dict
                        GenExpr(e.kids[0]);              // key -> x0
                        E4(0xF81F0FE0);                  // push key across out-address evaluation
                        GenRefArg(outa);                 // x0 = dest element address
                        E4(0xAA0003F4);                  // mov x20, x0 (callee-saved across the call)
                        E4(0xF84107E1);                  // pop key -> x1
                        E4(0xF84107E0);                  // pop dict -> x0
                        E4(0xD10043FF);                  // sub sp, sp, #16 (scratch BELOW the frame)
                        E4(0x910003E2);                  // add x2, sp, #0 (scratch slot)
                        BLInternal("_zan_rt_dict_tryget");
                        int skip = NL(); int done = NL();
                        CbzReg(0, skip);                 // miss: dest unchanged
                        E4(0xF94003E9);                  // ldr x9, [sp] (staged value)
                        int wesz = ArrElemSize(ArrContainerTy(place.a));
                        if (wesz == 1) {
                            E4(0x39000289);              // strb w9, [x20] (1-byte dest store)
                        } else if (wesz == 2) {
                            E4(0x79000289);              // strh w9, [x20] (2-byte dest store)
                        } else {
                            E4(0xB9000289);              // str w9, [x20] (4-byte dest store)
                        }
                        Mark(skip);
                        E4(0x910043FF);                  // add sp, sp, #16 (free scratch)
                        Mark(done);
                        return;
                    }
                    GenExpr(recv);
                    E4(0xF81F0FE0);                  // push dict
                    GenExpr(e.kids[0]);              // key -> x0
                    E4(0xF81F0FE0);                  // push key across out-address evaluation
                    GenRefArg(e.kids[1]);            // receiver/index calls may clobber x1
                    MovRR(2, 0);                     // x2 = out addr
                    E4(0xF84107E1);                  // pop key -> x1
                    E4(0xF84107E0);                  // pop dict -> x0
                    BLInternal("_zan_rt_dict_tryget");
                    return;
                }
                diags.Error("ngen: unsupported Dictionary operation '" + callee.sval + "'", e.line, e.col);
                return;
            }
            // string instance methods (gen0: Substring checks start <= len
            // and folds to 0; IndexOf is strstr with a -1 miss)
            if (e.kids.Count == 2 && IsStrExpr(recv) && callee.sval == "Substring") {
                // two-argument form. A receiver with reliable bounds (string
                // literal or string local) clamps the window against the
                // string's own length -- an out-of-range window answers
                // empty, gen0's soft-continue behavior. An unbounded
                // receiver (raw FFI buffer typed as `string`, e.g. the
                // stdlib's struct dirent* sliced byte by byte) has no
                // length header to trust: slice raw, mirroring the C host's
                // expr_has_reliable_string_bounds policy.
                if (IsBoundedStrExpr(recv)) {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                  // push s
                    GenExpr(e.kids[0]);
                    E4(0xF81F0FE0);                  // push start
                    GenExpr(e.kids[1]);
                    E4(0xF81F0FE0);                  // push len
                    E4(0xF84107E2);                  // pop len -> x2
                    E4(0xF84107E1);                  // pop start -> x1
                    E4(0xF84107E0);                  // pop s -> x0
                    BLInternal("_zan_rt_substr3");
                    return;
                }
                GenExpr(recv);
                E4(0xF81F0FE0);                      // push s
                GenExpr(e.kids[0]);
                E4(0xF81F0FE0);                      // push start
                GenExpr(e.kids[1]);
                E4(0xF81F0FE0);                      // push len
                E4(0xF84107E2);                      // pop len -> x2
                E4(0xF84107E1);                      // pop start -> x1
                E4(0xF84107E0);                      // pop s -> x0
                BLInternal("_zan_rt_substr_raw");
                return;
            }
            if (e.kids.Count == 1 && IsStrExpr(recv)) {
                if (callee.sval == "Substring") {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                  // push s
                    GenExpr(e.kids[0]);
                    E4(0xF84107E1);                  // pop s -> x1 (x0 = start)
                    E4(0xD1002022);                  // sub x2, x1, #8
                    E4(0xF9400042);                  // ldr x2, [x2]
                    E4(0xD3407C42);                  // ubfm x2, x2, #0, #31 (len)
                    int bad = NL();
                    int cont = NL();
                    E4(0xEB02001F);                  // cmp x0, x2
                    EmitBcond(12, bad);              // b.gt bad
                    EmitB(cont);
                    Mark(bad);
                    E4(0xF81F0FE0);                  // keep start
                    LoadSymRef("l_.str." + guardFileIdx, 0);
                    LoadImm(1, curLine);
                    LoadImm(2, curCol);
                    LoadSymRef("l_.str." + guardSubIdx, 3);
                    BLInternal("_zan_rt_guard_fail3");
                    E4(0xF84107E0);                  // pop start
                    LoadImm(0, 0);
                    Mark(cont);
                    // substr2 takes (s, start); the probe left them swapped
                    E4(0xAA0003E9);                  // mov x9, x0
                    E4(0xAA0103E0);                  // mov x0, x1
                    E4(0xAA0903E1);                  // mov x1, x9
                    BLInternal("_zan_rt_substr2");
                    return;
                }
                if (callee.sval == "IndexOf") {
                    GenExpr(recv);
                    E4(0xF81F0FE0);                  // push s
                    GenExpr(e.kids[0]);
                    E4(0xF84107E1);                  // pop s -> x1 (x0 = needle)
                    E4(0xAA0103E9);                  // mov x9, x1
                    E4(0xAA0003E1);                  // mov x1, x0
                    E4(0xAA0903E0);                  // mov x0, x9
                    BLExtern("_strstr");
                    int miss = NL();
                    int done = NL();
                    CbzReg(0, miss);
                    E4(0xCB090000);                  // sub x0, x0, x9
                    EmitB(done);
                    Mark(miss);
                    LoadImm(0, -1);
                    Mark(done);
                    return;
                }
            }
            // a call whose callee was already rewritten to a STATIC
            // specialization (`Singleton$string`) by the spec pipeline: an
            // extension-method rewrite names the spec directly, so dispatch
            // as a static call with the receiver occupying the first
            // parameter slot. Instance specializations keep the ordinary
            // instance path -- their receiver is passed separately.
            if (IndexOfStrNg(specMeth, callee.sval) >= 0) {
                int prespec = FindMethByNameNg(callee.sval);
                if (prespec >= 0 && methStat[prespec] == 1) { CallStaticNg(prespec, e); return; }
            }
            // static call through the class name: Cls.Method(args) -- the
            // receiver names a user class and the member is one of its
            // static methods (e.g. Point.Of(9)); overloads resolve by fit,
            // walking the base chain for inherited statics
            int staticIdx = ResolveStaticNg(e);
            if (staticIdx >= 0) {
                CallStaticNg(staticIdx, e);
                return;
            }
            // instance method call: x0 = receiver, x1.. = args. Candidates
            // come from the receiver's static class chain (derived first) and
            // resolve by overload fit; a virtual slot dispatches through the
            // receiver's runtime vtable
            string rc = ExprCls(recv);
            List<int> icands = new List<int>();
            if (rc != null) { InstanceCands(rc, callee.sval, icands); }
            int mi = icands.Count > 0 ? FitPickIdx(icands, e) : -1;
            if (mi < 0 && rc != null) {
                // a static method reached through an instance
                // (`d.StaticMethod(...)`) is legal: it has no receiver
                // parameter, so the receiver is not passed and the written
                // arguments stay unshifted
                List<int> scands = new List<int>();
                string sc = rc;
                while (sc != null) {
                    List<int> scc = MethCandsClsName(sc, callee.sval);
                    if (scc != null) {
                        int si3 = 0;
                        while (si3 < scc.Count) {
                            if (methStat[scc[si3]] == 1) { scands.Add(scc[si3]); }
                            si3 = si3 + 1;
                        }
                    }
                    Cls cc3 = FindClass(sc);
                    sc = cc3 != null ? cc3.baseName : null;
                }
                if (scands.Count > 0) {
                    int spick = FitPickIdx(scands, e);
                    if (spick >= 0) { CallStaticNg(spick, e); return; }
                }
            }
            if (mi < 0) { mi = FindInstanceIdx(callee.sval); }
            if (mi < 0) {
                // extension method: `recv.Ext(args)` with no instance match
                // names a static method whose first parameter is `this T`
                // with T the receiver's static type. The call node is
                // rewritten to ExtCls.Ext(recv, args...) -- the receiver
                // occupies the first parameter slot -- and emitted as a
                // plain static call. A bare type-parameter receiver
                // (`this T item`) additionally registers a specialization
                // for the concrete receiver type before the call.
                int xi = ResolveExtNg(recv, callee.sval, e);
                if (xi >= 0) {
                    Node xdecl = methNodes[xi];
                    Node p0 = ParamAt(xdecl, 0);
                    string pt0 = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                    Node ci = new Node(AK.Ident());
                    ci.sval = methCls[xi];
                    ci.line = e.line;
                    ci.col = e.col;
                    Node ma2 = new Node(AK.MemberAccess());
                    ma2.a = ci;
                    ma2.sval = callee.sval;
                    ma2.line = e.line;
                    ma2.col = e.col;
                    e.a = ma2;
                    e.kids.Insert(0, recv);
                    if (pt0 != null && IndexOfStrNg(DeclTps(xdecl), pt0) >= 0) {
                        string rt2 = ExtRecvTy(recv);
                        List<string> xargs = new List<string>();
                        xargs.Add(rt2);
                        SpecRegister(callee.sval, xargs, e, xi);
                        int spx = FindMethByNameNg(e.a.sval);
                        if (spx >= 0) { xi = spx; }
                    }
                    CallStaticNg(xi, e);
                    return;
                }
                diags.Error("ngen: unknown method '" + callee.sval + "'", e.line, e.col);
                return;
            }
            int vslot = rc != null ? VSlotOf(rc, callee.sval) : -1;
            GenExpr(recv);
            E4(0xF81F0FE0);                              // str x0, [sp, #-16]! (receiver)
            int pushed = PushCallArgs(methNodes[mi], e);
            int r = pushed;
            while (r >= 1) { E4(0xF84107E0 | r); r = r - 1; } // ldr xr, [sp], #16 (args reversed)
            E4(0xF84107E0);                              // ldr x0, [sp], #16 (receiver)
            if (vslot >= 0) {
                LdrU(9, 0, 0);                           // x9 = vptr
                LdrU(9, 9, vslot * 8);                   // x9 = target fn
                E4(0xD63F0120);                          // blr x9
            } else {
                BLInternal(MethSymNg(methCls[mi], methNodes[mi]));
            }
            return;
        }
        if (callee == null || callee.kind != AK.Ident()) {
            diags.Error("ngen: unsupported call target", e.line, e.col);
            return;
        }
        // static call: candidates from the current class chain first, then
        // (legacy) any class declaring the bare name; overloads resolve by fit
        int si = ResolveStaticNg(e);
        if (si < 0) {
            // no static candidate: an unqualified call inside an instance
            // method may still name an instance method -- the implicit
            // `this` receiver (gen0's rule). Rewrite the callee to
            // this.Method and re-dispatch through the instance path.
            List<int> tc = new List<int>();
            if (curCls != null) { InstanceCands(curCls, callee.sval, tc); }
            if (tc.Count > 0) {
                Node th = new Node(AK.Ident());
                th.sval = "this";
                th.line = e.line;
                th.col = e.col;
                Node ma = new Node(AK.MemberAccess());
                ma.a = th;
                ma.sval = callee.sval;
                ma.line = e.line;
                ma.col = e.col;
                e.a = ma;
                GenCall(e);
                return;
            }
            diags.Error("ngen: unknown static method '" + callee.sval + "'", e.line, e.col);
            return;
        }
        CallStaticNg(si, e);
    }

    int FindStaticIdx(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) { return cs[i]; }
            i = i + 1;
        }
        return -1;
    }

    int ParamCount(Node m) {
        int n = 0; int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // i-th declared parameter of method m (this excluded), or null
    Node ParamAt(Node m, int idx) {
        int seen = 0; int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) {
                if (seen == idx) { return m.kids[i]; }
                seen = seen + 1;
            }
            i = i + 1;
        }
        return null;
    }

    // is this expression already the params bundle (an array value)? A call
    // whose single tail argument is the array itself passes it through
    // unpacked, as in C#
    bool IsArrValExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.NewExpr() && e.ival == 1) { return true; }
        string t = StaticTyOf(e);
        return t != null && IsArrTy(t);
    }

    // int (x0) -> double (x0), in place: the value is an integer bit pattern
    // but the destination slot carries a double
    void ConvI2D() {
        E4(0x9E620000);                                  // scvtf d0, x0
        E4(0x9E660000);                                  // fmov x0, d0
    }

    // double -> float -> double round trip in x0: a float-typed value rounds
    // to single precision on the way into any float slot and widens on the
    // way out (registers keep the double-bit representation throughout, so
    // this is idempotent on already-narrowed values)
    void NarrowF32() {
        E4(0x9E67001F);                                  // fmov d31, x0
        E4(0x1E6243FF);                                  // fcvt s31, d31
        E4(0x1E22C3FF);                                  // fcvt d31, s31
        E4(0x9E6603E0);                                  // fmov x0, d31
    }

    // same round trip but x0 ends holding the SINGLE bits (low 32, zero
    // extended) -- the representation packed 4-byte array slots store
    void NarrowF32Bits() {
        E4(0x9E67001F);                                  // fmov d31, x0
        E4(0x1E6243FF);                                  // fcvt s31, d31
        E4(0x1E2603E0);                                  // fmov w0, s31
    }

    // implicit int->double conversion for argument `idx` of method m when
    // the declared parameter is double but the argument expression is not
    void ConvArg(Node m, int idx, Node arg) {
        Node p = ParamAt(m, idx);
        if (p == null || p.type == null) { return; }
        if (TryEmitConversionNg(arg, TypeFullName(p.type), false, false)) { return; }
        string pt = TypeFullName(p.type);
        if (IsDblTy(pt) && !IsDblExpr(arg)) {
            ConvI2D();
            if (pt == "float") { NarrowF32(); }          // float params round on entry
            return;
        }
        if (pt == "float" && !IsStrExpr(arg)) { NarrowF32(); return; }
        if (pt == "int" && !IsDblExpr(arg) && !IsStrExpr(arg)) { E4(0x93407C00); }     // sxtw x0, w0
    }

    // evaluate an out/ref call argument into x0 = the callee's storage
    // address (gen0 emit_ref_arg contract): `out T x` declares a fresh
    // zero-filled caller slot; a bare local passes its frame address (a
    // by-ref parameter's slot already holds an address and passes it
    // through); a field name means this.field; a class-qualified name
    // means the static's data-global slot; member and index places resolve
    // obj+off / element addresses with the same bounds guards as the
    // corresponding stores
    void GenRefArg(Node oa) {
        int saved = EnterEnvNg(oa);
        GenRefArgInEnvNg(oa);
        locHead = saved;
    }

    void GenRefArgInEnvNg(Node oa) {
        if (oa.type != null) {
            int li = DeclSlotNg(oa);
            if (li < 0) {
                diags.Error("ngen: out declaration '" + oa.sval + "' has no slot", oa.line, oa.col);
                LoadImm(0, 0);
                return;
            }
            LoadImm(0, 0);                               // default(T): 0 / null
            StoreLocal(li, 0);
            LoadImm(0, LocFpOff(locOff[li]));
            AddRR(0, 29, 0);                             // x0 = x29 + slot offset
            return;
        }
        if (oa.a == null) {
            diags.Error("ngen: out/ref argument has no target", oa.line, oa.col);
            LoadImm(0, 0);
            return;
        }
        AddrOf(oa.a);
    }

    // ++/-- on a place: plain locals load/store their slot; everything else
    // (ref locals, fields, statics, elements) goes through AddrOf so the
    // target's receiver and index evaluate exactly once. int[] elements are
    // the only 4-byte places (ArrElemSize), everything else is 8 bytes.
    void GenIncDec(Node tgt, bool isInc, bool yieldNew) {
        if (tgt == null) {
            diags.Error("ngen: unsupported ++/-- target", 0, 0);
            LoadImm(0, 0);
            return;
        }
        if (tgt.kind == AK.Ident()) {
            int li = LocalIdx(tgt.sval);
            if (li >= 0 && !locRef[li]) {
                LoadLocal(li, 0);
                if (!yieldNew) { E4(0xF81F0FE0); }   // save old
                if (isInc) { AddImm(0, 0, 1); } else { SubImm(0, 0, 1); }
                StoreLocal(li, 0);
                if (!yieldNew) { E4(0xF84107E0); }   // old -> x0
                return;
            }
        }
        // bare property ++/--: get_Name + 1, then set_Name (the accessor
        // pair implements the read-modify-write); static accessors run
        // without a receiver
        if (tgt.kind == AK.Ident()) {
            Node bgp = AccessorInChain(curCls, "get_" + tgt.sval);
            string gOwner = accOwnerCls;
            Node bsp = bgp != null ? AccessorInChain(curCls, "set_" + tgt.sval) : null;
            if (bgp != null && bsp != null) {
                string sOwner = accOwnerCls;
                bool bstat = HasMod(bsp, MOD.Static());
                if (bstat) {
                    LoadImm(0, 0);
                    BLInternal(MethSymNg(gOwner, bgp));  // x0 = current
                    if (!yieldNew) { E4(0xF81F0FE0); }   // save old
                    if (isInc) { AddImm(0, 0, 1); } else { SubImm(0, 0, 1); }
                    // new value already in x0 (first parameter)
                } else {
                    LoadLocal(LocalIdx("this"), 0);
                    BLInternal(MethSymNg(gOwner, bgp));  // x0 = current
                    if (!yieldNew) { E4(0xF81F0FE0); }   // save old
                    if (isInc) { AddImm(0, 0, 1); } else { SubImm(0, 0, 1); }
                    MovRR(1, 0);                         // x1 = new
                    LoadLocal(LocalIdx("this"), 0);      // x0 = receiver
                }
                BLInternal(MethSymNg(sOwner, bsp));
                if (!yieldNew) { E4(0xF84107E0); }       // old -> x0
                return;
            }
        }
        GenIncDecAt(tgt, isInc, yieldNew);
    }

    void GenIncDecAt(Node tgt, bool isInc, bool yieldNew) {
        AddrOf(tgt);                                 // x0 = address
        int nesz = 8;
        if (tgt.kind == AK.Index() && ArrContainerTy(tgt.a) != null) {
            nesz = ArrElemSize(ArrContainerTy(tgt.a));
        }
        string nel = nesz < 8 && tgt.kind == AK.Index()
                ? ArrElemName(ArrContainerTy(tgt.a)) : "";
        E4(0xAA0003E9);                              // mov x9, x0 (address)
        if (nesz == 1) {
            if (nel == "sbyte") {
                E4(0x38800120);                      // ldrsb x0, [x9]
            } else {
                E4(0x39400120);                      // ldrb w0, [x9]
            }
        } else if (nesz == 2) {
            if (nel == "short") {
                E4(0x79800120);                      // ldrsh x0, [x9]
            } else {
                E4(0x79400120);                      // ldrh w0, [x9]
            }
        } else if (nesz == 4) {
            E4(0xB9400120);                          // ldr w0, [x9]
            E4(0x93407C00);                          // sxtw x0, w0
        } else {
            LdrU(0, 9, 0);                           // ldr x0, [x9]
        }
        if (!yieldNew) { E4(0xF81F0FE0); }           // save old
        if (isInc) { AddImm(0, 0, 1); } else { SubImm(0, 0, 1); }
        MovRR(1, 0);                                 // x1 = new
        if (nesz == 1) {
            E4(0x39000121);                          // strb w1, [x9]
        } else if (nesz == 2) {
            E4(0x79000121);                          // strh w1, [x9]
        } else if (nesz == 4) {
            E4(0xB9000121);                          // str w1, [x9]
        } else {
            StrU(1, 9, 0);
        }
        if (!yieldNew) { E4(0xF84107E0); }           // old -> x0
    }

    // x0 = the address of place t (a variable, field, static, or element)
    void AddrOf(Node t) {
        if (t.kind == AK.Ident()) {
            int li = LocalIdx(t.sval);
            if (li >= 0) {
                if (locRef[li]) {
                    LoadLocal(li, 0);                    // slot holds the address
                } else {
                    LoadImm(0, LocFpOff(locOff[li]));
                    AddRR(0, 29, 0);
                }
                return;
            }
            Fld fld = CurField(t.sval);
            if (fld != null) {
                LoadLocal(LocalIdx("this"), 0);
                FieldAddressNg(fld, t);
                return;
            }
            string ssym = FindStaticSym(curCls, t.sval);
            if (ssym != null) {
                LoadSymRef(ssym, 0);                     // the slot is the storage
                return;
            }
            diags.Error("ngen: out/ref target '" + t.sval + "' is not a variable or field", t.line, t.col);
            LoadImm(0, 0);
            return;
        }
        if (t.kind == AK.MemberAccess()) {
            // Class.static first: the receiver names a class (not a local)
            // and the member is one of its statics
            if (t.a != null && t.a.kind == AK.Ident() && LocalIdx(t.a.sval) < 0) {
                string ssym = FindStaticSym(QualifiedCls(t.a.sval, t.a.sval2), t.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    return;
                }
            }
            Fld f2 = FieldOf(t);
            if (f2 != null) {
                GenExpr(t.a);                            // receiver -> x0
                FieldAddressNg(f2, t);
                return;
            }
            diags.Error("ngen: unknown field '" + t.sval + "' in out/ref target", t.line, t.col);
            LoadImm(0, 0);
            return;
        }
        if (t.kind == AK.Index() && ExprCls(t.a) == "List") {
            GenExpr(t.a);                                // list -> x0
            E4(0xF81F0FE0);                              // push list
            GenExpr(t.b);                                // idx -> x0
            E4(0xF84107E1);                              // pop list -> x1
            LdrU(3, 1, 0);                               // count
            LdrU(4, 1, 16);                              // data
            int badl = NL();
            int contl = NL();
            E4(0xEB03001F);                              // cmp x0, x3
            EmitBcond(10, badl);
            E4(0xEB1F001F);                              // cmp x0, xzr
            EmitBcond(11, badl);
            EmitB(contl);
            Mark(badl);
            E4(0xF81F0FE4);                              // keep data (guard clobbers x4)
            E4(0xF81F0FE0);                              // keep idx
            LoadSymRef("l_.str." + guardFileIdx, 0);
            LoadImm(1, t.line);
            LoadImm(2, t.col);
            LoadSymRef("l_.str." + guardListIdx, 3);
            BLInternal("_zan_rt_guard_fail3");
            E4(0xF84107E0);                              // pop idx
            E4(0xF84107E4);                              // pop data
            LoadImm(0, 0);
            Mark(contl);
            E4(0x8B000C89);                              // add x9, x4, x0, lsl #3
            MovRR(0, 9);
            return;
        }
        if (t.kind == AK.Index() && ArrContainerTy(t.a) != null) {
            int esz = ArrElemSize(ArrContainerTy(t.a));
            GenExpr(t.a);                                // container -> x0
            E4(0xF81F0FE0);                              // push container
            GenExpr(t.b);                                // idx -> x0
            E4(0xF84107E1);                              // pop container -> x1
            E4(0xF85F0023);                              // ldur x3, [x1, #-16] (len)
            int bad = NL();
            int cont = NL();
            E4(0xEB03001F);                              // cmp x0, x3
            EmitBcond(10, bad);
            E4(0xEB1F001F);                              // cmp x0, xzr
            EmitBcond(11, bad);
            EmitB(cont);
            Mark(bad);
            E4(0xF81F0FE1);                              // keep arr (guard clobbers x1)
            E4(0xF81F0FE0);                              // keep idx
            LoadSymRef("l_.str." + guardFileIdx, 0);
            LoadImm(1, t.line);
            LoadImm(2, t.col);
            LoadSymRef("l_.str." + guardArrIdx, 3);
            BLInternal("_zan_rt_guard_fail3");
            E4(0xF84107E0);                              // pop idx
            E4(0xF84107E1);                              // pop arr
            LoadImm(0, 0);
            Mark(cont);
            // add x9, x1, idx, lsl #esz (arr points at the data; len at arr-16)
            E4(0x8B000029 | (ArrElemShift(esz) << 10));
            MovRR(0, 9);
            return;
        }
        diags.Error("ngen: out/ref argument must be a variable, a field, or an element", t.line, t.col);
        LoadImm(0, 0);
    }

    // declared type of an assignment target ("double", ...), or null
    string AssignTargetTy(Node a) {
        if (a == null) { return null; }
        if (a.kind == AK.Ident()) {
            int li = LocalIdx(a.sval);
            if (li >= 0) { return locTy[li]; }
            Fld fld = CurField(a.sval);
            if (fld != null) { return fld.ty; }
            return FindStaticTy(curCls, a.sval);
        }
        if (a.kind == AK.MemberAccess() && a.sval != null) {
            Fld f2 = FieldOf(a);
            if (f2 != null) { return f2.ty; }
        }
        if (a.kind == AK.Index() && IsArrExpr(a.a)) {
            string at = ArrTyOf(a.a);
            if (at != null && at.Length > 2) { return at.Substring(0, at.Length - 2); }
        }
        if (a.kind == AK.Index() && ExprCls(a.a) == "Dict") {
            return ElemTyOf(a);                          // Dictionary<K,V>[k] = V
        }
        return null;
    }

    // scalar/enum type names a one-argument class constructor can materialize
    // (gen0's is_implicit_ctor_source)
    bool CtorSrcTy(string t) {
        if (t == null) { return false; }
        if (t == "bool" || t == "sbyte" || t == "byte" || t == "short"
                || t == "ushort" || t == "int" || t == "uint" || t == "long"
                || t == "ulong" || t == "nint" || t == "char") { return true; }
        return FindEnum(t) >= 0;
    }

    // static type of an argument for ctor-wrap purposes: literals carry no
    // StaticTyOf answer, so name the usual scalar shapes directly
    string ArgSrcTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.BoolLit()) { return "bool"; }
        if (e.kind == AK.IntLit()) { return "int"; }
        if (e.kind == AK.CharLit()) { return "char"; }
        if (e.kind == AK.Unary()) {
            if (e.op == TK.Bang()) { return "bool"; }
            if (e.op == TK.Minus() && e.a != null && e.a.kind == AK.IntLit()) { return "int"; }
            return null;
        }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.EqEq() || op == TK.BangEq() || op == TK.Less()
                    || op == TK.Greater() || op == TK.LessEq()
                    || op == TK.GreaterEq() || op == TK.AmpAmp()
                    || op == TK.PipePipe()) { return "bool"; }
            return null;
        }
        if (e.kind == AK.Conditional()) {
            string ct = ArgSrcTy(e.b);
            return ct != null && ct == ArgSrcTy(e.c) ? ct : null;
        }
        return StaticTyOf(e);
    }

    // a bool/integer/char/enum argument converts to a class parameter through
    // a matching one-argument constructor: rewrite the call-site argument to
    // `new Target(arg)` (gen0 wrap_implicit_ctor_arg), giving the same ARC
    // ownership and value as an explicit new. Returns the replacement node,
    // or null when the argument is left as written.
    Node WrapImplicitCtorArg(Node p, Node arg) {
        if (arg == null) { return null; }
        if (ConversionIndexNg(ConversionExprTyNg(arg), TypeFullName(p.type), false) != -1) { return null; }
        if (arg.kind == AK.NewExpr() || arg.kind == AK.NullLit()
                || arg.kind == AK.OutArg() || arg.kind == AK.ThisExpr()
                || arg.kind == AK.Lambda()) { return null; }
        string pt = ClassTyOf(TypeFullName(p.type));
        if (pt == null || FindClass(pt) == null) { return null; }
        string st = ArgSrcTy(arg);
        if (st == null || !CtorSrcTy(st) || st == pt) { return null; }
        Node c1 = new Node(AK.Call());
        c1.line = arg.line;
        c1.col = arg.col;
        c1.Add(arg);
        if (FitCtorIdx(pt, c1, false, null) < 0) {
            diags.Error("ngen: cannot convert '" + st + "' to '" + pt
                + "' in argument: no matching constructor", arg.line, arg.col);
            return null;
        }
        Node tr = new Node(AK.TypeRef());
        tr.sval = pt;
        Node ne = new Node(AK.NewExpr());
        ne.type = tr;
        ne.line = arg.line;
        ne.col = arg.col;
        ne.Add(arg);
        return ne;
    }

    // evaluate call arguments left to right, spilling each onto the stack;
    // omitted trailing arguments fall back to the callee's default parameter
    // values, and a `params T[]` tail bundles every extra argument into a
    // freshly allocated array (gen0 packs the bundle at the call site).
    // Returns the count pushed -- the caller pops exactly that many into
    // x0.. in reverse.
    int PushCallArgs(Node m, Node e) {
        string calleeName = e.a != null ? e.a.sval : "constructor";
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        int fixedc = variadic ? pc - 1 : pc;
        int prov = e.kids.Count;
        if (!variadic && prov > pc) {
            diags.Error("ngen: too many arguments calling '" + calleeName + "'", e.line, e.col);
            return pc;
        }
        if (variadic && prov < fixedc) {
            diags.Error("ngen: arity mismatch calling '" + calleeName + "'", e.line, e.col);
            return pc;
        }
        // named arguments bind by parameter name (mirrors gen0's
        // reorder_named_args): a named arg claims the slot of the parameter
        // it names, then positionals fill the leftmost free slots. The
        // rewrite only applies when the bound slots are exactly 0..prov-1
        // -- any other shape (unknown or duplicate name, a defaulted
        // parameter ahead of a bound one) keeps the written order and the
        // diagnostics stand.
        List<Node> ak = e.kids;
        bool hasNamed = false;
        int k = 0;
        while (k < prov) {
            if (e.kids[k].sval2 != null && e.kids[k].sval2 != "") { hasNamed = true; }
            k = k + 1;
        }
        if (hasNamed) {
            int slots = pc > prov ? pc : prov;
            int[] slot = new int[slots];
            bool[] usedName = new bool[prov];
            k = 0;
            while (k < slots) { slot[k] = -1; k = k + 1; }
            k = 0;
            while (k < prov) {
                string an = e.kids[k].sval2;
                if (an == null || an == "") { k = k + 1; continue; }
                int found = -1;
                int j = 0;
                while (j < pc) {
                    Node pp = ParamAt(m, j);
                    if (pp != null && pp.sval == an) { found = j; break; }
                    j = j + 1;
                }
                if (found < 0) {
                    diags.Error("ngen: no parameter named '" + an + "' calling '" + calleeName + "'", e.line, e.col);
                } else if (slot[found] >= 0) {
                    diags.Error("ngen: parameter '" + an + "' is already assigned calling '" + calleeName + "'", e.line, e.col);
                } else {
                    slot[found] = k;
                    usedName[k] = true;
                }
                k = k + 1;
            }
            int j2 = 0;
            k = 0;
            while (k < prov) {
                if (usedName[k]) { k = k + 1; continue; }
                while (j2 < pc && slot[j2] >= 0) { j2 = j2 + 1; }
                if (j2 >= pc) { break; }
                slot[j2] = k;
                j2 = j2 + 1;
                k = k + 1;
            }
            bool dense = true;
            k = 0;
            while (k < prov) {
                if (slot[k] < 0 || slot[k] >= prov) { dense = false; break; }
                k = k + 1;
            }
            if (dense) {
                ak = new List<Node>();
                k = 0;
                while (k < prov) {
                    ak.Add(e.kids[slot[k]]);
                    k = k + 1;
                }
            }
        }
        // whole-bundle passthrough: the single tail argument is already an
        // array value, so it is handed over as-is
        if (variadic && prov == pc && IsArrValExpr(ak[prov - 1])) {
            int k = 0;
            while (k < prov) {
                GenExpr(ak[k]);
                GenCloneIfStruct(ak[k]);
                ConvArg(m, k, ak[k]);
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                k = k + 1;
            }
            return prov;
        }
        int i = 0;
        while (i < prov && i < fixedc) {
            Node ae = ak[i];
            Node pa2 = ParamAt(m, i);
            if (pa2 != null) {
                Node wrapped = WrapImplicitCtorArg(pa2, ae);
                if (wrapped != null) { ak[i] = wrapped; ae = wrapped; }
                PrepareDelegateValue(ae, TypeFullName(pa2.type));
            }
            if (ae.kind == AK.OutArg()) {
                GenRefArg(ae);                        // x0 = storage address
            } else {
                GenExpr(ae);
                GenCloneIfStruct(ae);                 // structs pass by value
                ConvArg(m, i, ae);
            }
            E4(0xF81F0FE0);                              // str x0, [sp, #-16]!
            i = i + 1;
        }
        while (i < fixedc) {
            Node p = ParamAt(m, i);
            if (p == null || p.b == null) {
                diags.Error("ngen: arity mismatch calling '" + calleeName + "'", e.line, e.col);
                return i;
            }
            GenExpr(p.b);
            GenCloneIfStruct(p.b);
            ConvArg(m, i, p.b);
            E4(0xF81F0FE0);
            i = i + 1;
        }
        if (variadic) {
            int esz = ArrElemSize(TypeFullName(lastP.type));
            string elTy = TypeFullName(lastP.type);
            elTy = elTy.Length > 2 ? elTy.Substring(0, elTy.Length - 2) : elTy;
            int n = prov > fixedc ? prov - fixedc : 0;
            // spill the tail elements left to right, then allocate the
            // bundle array and store them at their slots
            int j2 = fixedc;
            while (j2 < prov) {
                if (ak[j2].kind == AK.OutArg()) {
                    GenRefArg(ak[j2]);                   // x0 = storage address
                } else {
                    GenExpr(ak[j2]);
                    GenCloneIfStruct(ak[j2]);
                    if (elTy == "double" && !IsDblExpr(ak[j2])) { ConvI2D(); }
                }
                E4(0xF81F0FE0);
                j2 = j2 + 1;
            }
            Node cnt = new Node(AK.IntLit());
            cnt.ival = n;
            GenArrNew(cnt, esz);
            E4(0xF81F0FE0);                              // push arr
            int k2 = n - 1;                              // stack top holds the last element
            while (k2 >= 0) {
                E4(0xF84107E1);                          // pop arr -> x1
                E4(0xF84107E0);                          // pop element -> x0
                E4((int)(0xD2800000 | (((long)k2) << 5) | 2)); // movz x2, #k2
                if (esz == 4) {
                    E4(0xB8227820);                      // str w0, [x1, x2, lsl #2]
                } else {
                    E4(0xF8227820);                      // str x0, [x1, x2, lsl #3]
                }
                E4(0xF81F0FE1);                          // push arr back
                k2 = k2 - 1;
            }
            E4(0xF84107E0);                              // pop arr -> x0
            E4(0xF81F0FE0);                              // push the bundle as the tail arg
            i = i + 1;
        }
        return i;
    }

    int FindCtorIdx(string cls) {
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return -1; }
        int i = 0;
        while (i < mine.Count) {
            if (methStat[mine[i]] == 2) { return mine[i]; }
            i = i + 1;
        }
        return -1;
    }

    int CtorCountNg(string cls) {
        // per-instantiation ctor specs live here too (stat 2, sval2 set):
        // they must not flip the open class's single-vs-multi mangling
        int n = 0;
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return 0; }
        int i = 0;
        while (i < mine.Count) {
            Node m2 = methNodes[mine[i]];
            if (methStat[mine[i]] == 2 && (m2.sval2 == null || m2.sval2 == "")) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // parameter-type tag for ctor symbol mangling (mirrors the llvm
    // backend's TypeTag so the shapes stay analogous)
    string TypeTagNg(Node t) {
        if (t == null || t.sval == null || t.sval == "") { return "v"; }
        string s = t.sval;
        int i = 0;
        while (i < t.kids.Count) { s = s + "." + TypeTagNg(t.kids[i]); i = i + 1; }
        return s;
    }

    // symbol for a constructor. With a single ctor this stays the historical
    // `_Type_ctor`; with overloads the parameter types are appended so two
    // ctors cannot collide on one symbol (mirrors CtorSym in the llvm path)
    string CtorSymNg(string cls, Node ctor) {
        if (CtorCountNg(cls) <= 1) { return "_" + cls + "_ctor"; }
        string s = "_" + cls + "_ctor__";
        int i = 0;
        while (i < ctor.kids.Count) {
            Node p = ctor.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTagNg(p.type); }
            i = i + 1;
        }
        return s;
    }

    // is pt a concrete type ngen can score by: a primitive, List<...>, a
    // declared class/struct, or an array of one of those. Anything else --
    // an open generic's type parameter like Box<T>'s `T` -- has no family
    // to rank by and must stay neutral, never disqualify (gen0 scores
    // FAM_UNKNOWN as 0; a bare T matches anything).
    bool KnownParamTy(string pt) {
        if (pt == "int" || pt == "long" || pt == "ulong" || pt == "double"
                || pt == "bool" || pt == "char" || pt == "string"
                || pt == "object" || pt == "void") { return true; }
        if (pt == "List" || (pt.Length > 5 && pt.Substring(0, 5) == "List<")) { return true; }
        if (IsArrTy(pt)) { return KnownParamTy(pt.Substring(0, pt.Length - 2)); }
        return FindClass(pt) != null;
    }

    // how well one argument fits one parameter type: exact static/literal
    // agreement scores high, a known literal/type mismatch disqualifies the
    // candidate, anything unknown is neutral. gen0 resolves ctor overloads
    // with full type scoring; ngen sees the declared types and literals.
    int ArgParamScore(Node arg, string pt) {
        if (pt == null || pt == "") { return 0; }
        int conversionScore = ConversionArgScoreNg(arg, pt);
        if (conversionScore != 0) { return conversionScore; }
        if (!KnownParamTy(pt)) { return 0; }
        string at = StaticTyOf(arg);
        if (at != null) { return at == pt ? 8 : 0; }
        int k = arg.kind;
        if (k == AK.IntLit()) {
            if (pt == "int") { return 8; }
            if (pt == "long" || pt == "ulong") { return 6; }
            if (pt == "double") { return 4; }
            return -100;
        }
        if (k == AK.FloatLit()) { return pt == "double" ? 8 : -100; }
        if (k == AK.StringLit()) { return pt == "string" ? 8 : -100; }
        if (k == AK.BoolLit()) { return pt == "bool" ? 8 : -100; }
        if (k == AK.CharLit()) { return pt == "char" ? 8 : (pt == "int" ? 4 : -100); }
        if (k == AK.NullLit()) {
            if (ClassTyOf(pt) != null || pt == "string" || pt == "object"
                    || pt == "List" || pt == "StringBuilder"
                    || pt.IndexOf("List<") == 0 || IsDictTyName(pt)
                    || IsArrTy(pt)) { return 8; }
            return -100;
        }
        if (IsStrExpr(arg)) { return pt == "string" ? 8 : -100; }
        return 0;
    }

    // does candidate ctor `m` accept `argc` arguments: the exact arity, or
    // trailing default parameters filling the gap (gen0 fills defaults
    // before ctor resolution; a params tail on a ctor is not a thing)
    bool CtorAcceptsArity(Node m, int argc) {
        int pc = ParamCount(m);
        if (pc == argc) { return true; }
        if (argc > pc) { return false; }
        int j = argc;
        while (j < pc) {
            Node p = ParamAt(m, j);
            if (p == null || p.b == null) { return false; }
            j = j + 1;
        }
        return true;
    }

    // constructor overload resolution for `new C(args)`: among the ctors
    // whose arity admits the call, pick the best argument-type match
    // (exact-arity candidates outrank default-filled ones; ties keep the
    // first declared). `exactOnly` matches gen0's implicit base chain, which
    // looks for a true parameterless ctor; `exclude` rules a ctor out (a
    // `: this(...)` chain must not retarget itself). Returns -1 when
    // nothing fits.
    int FitCtorIdx(string cls, Node callNode, bool exactOnly, Node exclude) {
        int argc = callNode != null ? callNode.kids.Count : 0;
        int exact = -1; int exactScore = -2000000000;
        int filled = -1; int filledScore = -2000000000;
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return -1; }
        int i = 0;
        while (i < mine.Count) {
            int ti = mine[i];
            if (methStat[ti] == 2 && methNodes[ti] != exclude
                    && (methNodes[ti].sval2 == null || methNodes[ti].sval2 == "")
                    && CtorAcceptsArity(methNodes[ti], argc)) {
                int score = 0;
                bool compatible = true;
                int j = 0;
                while (j < argc && compatible) {
                    Node p = ParamAt(methNodes[ti], j);
                    string pt = p != null && p.type != null ? TypeFullName(p.type) : null;
                    int s = ArgParamScore(callNode.kids[j], pt);
                    if (s <= -100) { compatible = false; }
                    score = score + s;
                    j = j + 1;
                }
                if (compatible) {
                    bool isExact = ParamCount(methNodes[ti]) == argc;
                    if (isExact) {
                        if (score > exactScore) { exactScore = score; exact = ti; }
                    } else if (!exactOnly) {
                        if (score > filledScore) { filledScore = score; filled = ti; }
                    }
                }
            }
            i = i + 1;
        }
        if (exact >= 0) { return exact; }
        return filled;
    }

    // ---- exceptions: try / catch / throw ----
    // EH state is per-thread: the block ({ i32 top, ptr exc, 256 x 1024-byte
    // setjmp slots }) comes from _zan_eh_tls_state in the transition runtime
    // (a static block in the qemu stub). Mirrors the observable semantics of
    // gen0's TLS-backed %zan.eh.state.
    // lock (obj) body: the striped recursive monitor (zan_monitor_enter/
    // exit, oracle rt_sync.c), with the release riding a REAL try/finally so
    // every exit path releases it exactly like the oracle's lowering
    // (irgen_stmt.c AST_LOCK_STMT lowers lock to try/finally): a throw runs
    // the release at the throw site, return/break/continue walk it via the
    // pending-fin machinery, and a nested unwind lands in this try's own
    // armed buf. Desugared here, after checking:
    //   { var $lockN = obj; monitor_enter($lockN);
    //     try body finally monitor_exit($lockN) }
    // The temp's slot is allocated in ReserveLocals (see the LockStmt arm
    // there) and stashed in s.c; HasTry counts LockStmt so the method gets
    // the EH bookkeeping slots and the frame covers everything.
    void GenLockStmt(Node s) {
        string vt = InferExprTyNg(s.a);
        if (!TryGenBindingValue(s.a, vt)) { GenConversionValueNg(s.a, vt); }
        StoreLocal(DeclSlotNg(s.c), 0);
        BLExtern("_zan_monitor_enter");              // x0 = obj
        Node fin = new Node(AK.MonitorExitStmt());
        fin.a = s.c;
        Node t = new Node(AK.TryStmt());
        t.a = s.b;
        t.b = null;
        t.c = fin;
        GenStmt(t);
    }

    void GenTry(Node s) {
        BLInternal("_zan_rt_eh_state");              // x0 = state (lazy alloc)
        E4(0xF81F0FE0);                              // push state
        LoadLocal(ehTopLocal, 1);                    // top (mirror: it also
                                                     // survives return/break
                                                     // paths that skip the
                                                     // normal-path restore)
        E4(0xF81F0FE1);                              // push saved top
        LoadImm(3, 1024);
        E4(0x9B037C22);                              // mul x2, x1, x3
        AddRR(2, 0, 2);                              // state + top*1024
        AddImm(2, 2, 16);                            // &bufs[top]
        if (ehStack.Count == 0) {
            // outermost try opened in this activation: remember the top it
            // was armed at, so return/break/continue can disarm from here
            StoreLocal(ehBaseLocal, 1);
        }
        AddImm(1, 1, 1);                             // top + 1
        StrU(1, 0, 0);                               // state->top = top + 1
        StoreLocal(ehTopLocal, 1);                   // mirror = top + 1
        ehStack.Add(1);
        MovRR(0, 2);
        BLExtern("_setjmp");                         // returns 0 (direct) / 1 (thrown)
        EmitCbnz(0, NL());
        int catchL = lblPos.Count - 1;
        // stamp the buf as live for this activation: the rethrow path checks
        // the arming fp before longjmping, so a leaked disarm turns into a
        // clean uncaught exit instead of a wild PC from a dead frame
        BLInternal("_zan_rt_eh_state");              // x0 = state
        LoadLocal(ehTopLocal, 1);                    // mirror (= top + 1)
        SubImm(1, 1, 1);                             // pre-arm top
        LoadImm(3, 1024);
        E4(0x9B037C22);                              // mul x2, x1, x3
        AddRR(2, 0, 2);
        AddImm(2, 2, 16);                            // &bufs[top]
        E4(0xAA1D03E3);                              // mov x3, x29 (fp)
        StrU(3, 2, 1008);                            // arming fp stamp
        LoadImm(3, 1514933314);                      // "ZANB"
        StrU(3, 2, 1016);                            // magic stamp
        int endL = NL();
        int finIdx = -1;
        if (s.c != null) {
            finBodies.Add(s.c);
            finInHandler.Add(0);
            finIdx = finBodies.Count - 1;
        }
        // ---- normal path: run the try body, disarm, then the finally ----
        GenStmt(s.a);
        EhRestoreTop();
        LdrU(1, 31, 0);                              // saved top
        StoreLocal(ehTopLocal, 1);                   // mirror = saved top
        if (s.c != null) {
            finCur = finIdx;                         // a throw in the finally propagates
            GenStmt(s.c);
            finCur = -1;
        }
        EmitB(endL);
        Mark(catchL);
        // ---- thrown path: disarm first (a throw from a handler or the
        // finally must unwind to the enclosing try, not re-enter this one),
        // then dispatch the clauses. x0 holds the in-flight exception and
        // x2 its class site: 0 when null; a thrown string keeps its magic
        // site, which sorts above every declared class, so a typed walk
        // never matches it and it lands in the first clause (gen0's rule).
        EhRestoreTop();
        LdrU(1, 31, 0);                              // saved top
        StoreLocal(ehTopLocal, 1);                   // mirror = saved top
        LdrU(1, 31, 16);                             // x1 = state again
        if (finIdx >= 0) { finInHandler[finIdx] = 1; }
        LdrU(0, 1, 8);                               // exc (x1 = state)
        LoadImm(2, 0);
        int hasObj = NL();
        CbzReg(0, hasObj);
        E4(0xF85F8002);                              // ldur x2, [x0, #-8] (desc)
        E4(0xD360FC42);                              // lsr x2, x2, #32 (site)
        Mark(hasObj);
        int doneL = NL();
        int noMatch = NL();
        if (s.b == null) {
            // no clauses at all: the exception is nobody's to handle here;
            // the finally (if any) runs on the noMatch path, then unwinding
            // continues
            EmitB(noMatch);
        }
        Node cc = s.b;
        bool first = true;
        while (cc != null) {
            string ctname = cc.type != null ? cc.type.sval : null;
            Cls ctcls = ctname != null ? FindClass(ctname) : null;
            int hitL = NL();
            int missL = cc.b != null ? NL() : noMatch;
            if (ctcls != null) {
                if (first) {
                    LoadImm(3, classes.Count);
                    E4(0xEB03005F);                  // cmp x2, x3
                    EmitBcond(8, hitL);              // b.hi (string/legacy site)
                    CbzReg(0, hitL);                 // null exception object
                }
                List<int> msn = MatchSites(ctname);
                int k = 0;
                while (k < msn.Count) {
                    LoadImm(3, msn[k]);
                    E4(0xEB03005F);                  // cmp x2, x3
                    EmitBcond(0, hitL);              // b.eq
                    k = k + 1;
                }
                EmitB(missL);
            }
            // an untyped clause (or one of unknown type) catches everything
            Mark(hitL);
            if (cc.sval != null && cc.sval != "") {
                int ci = DeclSlotNg(cc);
                if (ci >= 0) { StoreLocal(ci, 0); }
            }
            GenStmt(cc.a);
            EmitB(doneL);
            first = false;
            if (cc.b != null) { Mark(missL); }
            cc = cc.b;
        }
        Mark(doneL);
        if (s.c != null) {
            finCur = finIdx;                         // finally after a handled catch
            GenStmt(s.c);
            finCur = -1;
        }
        EmitB(endL);
        Mark(noMatch);
        if (s.c != null) {
            // the exception leaves this try unmatched (or there was never a
            // clause): the finally runs while it keeps unwinding
            finCur = finIdx;
            GenStmt(s.c);
            finCur = -1;
        }
        EhRethrowNg();
        Mark(endL);
        if (finIdx >= 0) {
            finBodies.RemoveAt(finBodies.Count - 1);
            finInHandler.RemoveAt(finInHandler.Count - 1);
        }
        AddSPImm(32, true);                          // pop saved top + state
        ehStack.RemoveAt(ehStack.Count - 1);
    }

    // disarm every try this return leaves: the runtime top goes back to the
    // outermost open try's armed base. Without this, a later throw longjmps
    // into a stale jmp_buf captured by a frame that already returned -- the
    // wild-PC crashes gen0 avoids with emit_eh_disarm_from.
    void EhDisarmBase() {
        if (ehStack.Count == 0) { return; }
        BLInternal("_zan_rt_eh_state");              // x0 = state
        MovRR(1, 0);                                 // x1 = state (before the
                                                     // base load clobbers x0)
        LoadLocal(ehBaseLocal, 0);                   // x0 = base top
        StrU(0, 1, 0);                               // state->top = base
        LoadLocal(ehBaseLocal, 0);
        StoreLocal(ehTopLocal, 0);                   // keep the mirror current
    }

    // break/continue leaves every try opened inside the loop: restore the
    // loop-entry top
    void EhDisarmLoop() {
        if (!curHasTry) { return; }
        BLInternal("_zan_rt_eh_state");              // x0 = state
        MovRR(1, 0);                                 // x1 = state (before the
                                                     // top load clobbers x0)
        LoadLocal(ehBrkLocal, 0);
        StrU(0, 1, 0);
        LoadLocal(ehBrkLocal, 0);
        StoreLocal(ehTopLocal, 0);
    }

    // every class site a thrown descriptor may carry for this clause to hit:
    // the clause class itself plus every subclass, transitively
    List<int> MatchSites(string name) {
        List<int> r = new List<int>();
        Cls c = FindClass(name);
        if (c != null) { r.Add(c.site); }
        int i = 0;
        while (i < classes.Count) {
            Cls t = classes[i];
            bool hit2 = false;
            while (t != null && t.baseName != null) {
                if (t.baseName == name) { hit2 = true; break; }
                t = FindClass(t.baseName);
            }
            if (hit2) { r.Add(classes[i].site); }
            i = i + 1;
        }
        return r;
    }

    // does this subtree reference the builtin Exception class? (ctor, catch
    // clause, cast, or any type mention -- drives the builtin synthesis)
    bool TreeNeedsException(Node n) {
        if (n == null) { return false; }
        if (n.kind == AK.TypeRef() && n.sval == "Exception") { return true; }
        if (n.kind == AK.TryStmt()) {
            Node cc = n.b;
            while (cc != null) {
                if (TreeNeedsException(cc.type)) { return true; }
                cc = cc.b;
            }
        }
        if (TreeNeedsException(n.a) || TreeNeedsException(n.b)
                || TreeNeedsException(n.c) || TreeNeedsException(n.d)
                || TreeNeedsException(n.type)) { return true; }
        int k = 0;
        while (k < n.kids.Count) {
            if (TreeNeedsException(n.kids[k])) { return true; }
            k = k + 1;
        }
        return false;
    }

    // run the finally bodies this exit path leaves, innermost first. With
    // stopAtBody, the walk stops at the first try whose body we are still
    // inside -- its clause dispatch owns the finally. A finally never
    // re-runs itself: while body i executes, entries at i and above are
    // frozen (gen0's finally_count truncation).
    void EmitPendingFins(bool stopAtBody) {
        EmitPendingFinsFrom(0, stopAtBody);
    }

    // run the finally bodies from index `from` down (innermost first); a
    // loop's break/continue only runs the finallys opened inside it
    void EmitPendingFinsFrom(int from, bool stopAtBody) {
        int i = finBodies.Count - 1;
        while (i >= from) {
            if (i <= finCur) { break; }
            if (stopAtBody && finInHandler[i] == 0) { break; }
            if (finBodies[i] != null) {
                int saved = finCur;
                finCur = i;
                ExcSave();
                GenStmt(finBodies[i]);
                ExcRestore();
                finCur = saved;
            }
            i = i - 1;
        }
    }

    // keep the in-flight exception across a finally body: the body may run
    // try/catch of its own, which overwrites the stored exception
    void ExcSave() {
        BLInternal("_zan_rt_eh_state");
        LdrU(1, 0, 8);                               // exc (x0 = state; read
                                                     // before the push -- [sp+8]
                                                     // would read the caller's
                                                     // slot, not state->exc)
        E4(0xF81F0FE0);                              // push state
        E4(0xF81F0FE1);                              // push exc
    }

    void ExcRestore() {
        E4(0xF84107E1);                              // pop exc -> x1
        E4(0xF84107E0);                              // pop state -> x0
        StrU(1, 0, 8);                               // state->exc = saved
    }

    void EhRestoreTop() {
        LdrU(1, 31, 16);                             // state (pushed first: [sp+16])
        LdrU(3, 31, 0);                              // saved top
        StrU(3, 1, 0);                               // state->top = saved
    }

    void GenThrow(Node s) {
        if (s.a != null) {
            GenExpr(s.a);
        } else {
            // bare rethrow: the in-flight exception stays in the state block
            BLInternal("_zan_rt_eh_state");
            LdrU(0, 0, 8);
        }
        E4(0xF81F0FE0);                              // push exception value
        // a throw leaves every try whose handler is already disarmed (we
        // are in its catch or finally body): their finallys run here, at
        // the throw site, before the exception goes on. The first try whose
        // body we are still inside keeps its own -- its landing dispatch
        // runs the finally after its clause (or before re-raising).
        EmitPendingFins(true);
        BLInternal("_zan_rt_eh_state");              // x0 = state
        MovRR(1, 0);
        LdrU(2, 31, 0);                              // exception value
        StrU(2, 1, 8);                               // state->exc = value
        EhRethrowNg();
    }

    // unwind one frame: longjmp into the handler below the current top; with
    // no handler left, report and exit(1). A string exception prints its
    // text; a class object prints its class name via the clsn registry --
    // both to stdout with the "Unhandled exception: " prefix, matching the
    // oracle's uncaught tail (irgen_stmt.c reh.*).
    void EhRethrowNg() {
        BLInternal("_zan_rt_eh_state");
        MovRR(1, 0);
        LdrU(2, 1, 0);                               // top
        LoadImm(3, 64);                              // bufs capacity: an
                                                     // overflown top means a
                                                     // disarm leak -- exit
                                                     // loudly instead of
                                                     // longjmping into heap
                                                     // bytes past the block
        E4(0xEB03005F);                              // cmp x2, x3
        EmitBcond(3, NL());                          // b.ls (unsigned <=)
        int okTop = lblPos.Count - 1;
        LoadImm(0, 99);
        BLExtern("_exit");
        Mark(okTop);
        CbzReg(2, NL());
        int uncaught = lblPos.Count - 1;
        SubImm(2, 2, 1);                             // top - 1
        LoadImm(3, 1024);
        E4(0x9B037C42);                              // mul x2, x2, x3
        AddRR(2, 1, 2);
        AddImm(2, 2, 16);                            // &bufs[top-1]
        MovRR(0, 2);
        // liveness stamp: an armed buf carries the arming activation's fp and
        // a magic word. A target whose stamp is missing or whose fp lies
        // BELOW the current sp was captured by a dead, deeper frame -- a
        // disarm leak. Longjmping there lands on the dead frame's registers
        // (the wild-PC crashes), so treat it as uncaught instead.
        LoadImm(3, 1514933314);                      // "ZANB" magic
        LdrU(4, 0, 1016);                            // stamp magic
        E4(0xEB03009F);                              // cmp x4, x3
        EmitBcond(1, uncaught);                      // b.ne: never armed
        LdrU(4, 0, 1008);                            // arming fp
        E4(0xCB3F0084);                              // sub x4, x4, sp
        E4(0xD37FFC84);                              // lsr x4, x4, #63
        EmitCbnz(4, uncaught);                       // fp < sp: dead frame
        LoadImm(1, 1);
        BLExtern("_longjmp");
        Mark(uncaught);
        // report like the oracle (irgen_stmt.c reh.*): a string throw prints
        // its text, a class throw the class name via _zan_eh_cls_name,
        // nothing in flight the bare note -- then exit(1). Everything rides
        // strpool heap strings + _zan_rt_strcat2/_zan_rt_println, the exact
        // path Console.WriteLine uses, so no printf/raw-cstring variables.
        LdrU(0, 1, 8);                               // exc
        int none = NL();
        CbzReg(0, none);
        E4(0xF85F8002);                              // ldur x2, [x0, #-8] (desc)
        E4(0xD360FC42);                              // lsr x2, x2, #32 (site)
        LoadImm(3, classes.Count + 1);
        E4(0xEB03005F);                              // cmp x2, x3
        int isStr = NL();
        EmitBcond(8, isStr);                         // b.hi: not a class site
        MovRR(0, 2);                                 // x0 = site
        BLInternal("_zan_eh_cls_name");              // x0 = heap name or 0
        int anon = NL();
        CbzReg(0, anon);
        MovRR(1, 0);                                 // x1 = name
        LoadStr(fmtUnhandledIdx, 0);                 // x0 = prefix
        BLInternal("_zan_rt_strcat2");
        BLInternal("_zan_rt_println");
        int done = NL();
        EmitB(done);
        Mark(anon);
        LoadStr(fmtUnhandledClsIdx, 0);
        BLInternal("_zan_rt_println");
        EmitB(done);
        Mark(isStr);
        MovRR(1, 0);                                 // x1 = exc string
        LoadStr(fmtUnhandledIdx, 0);                 // x0 = prefix
        BLInternal("_zan_rt_strcat2");
        BLInternal("_zan_rt_println");
        EmitB(done);
        Mark(none);
        LoadStr(fmtUnhandledBareIdx, 0);
        BLInternal("_zan_rt_println");
        Mark(done);
        LoadImm(0, 1);
        BLExtern("_exit");
    }

    // ---- labels ----
    int NL() { lblPos.Add(-1); nlabel = nlabel + 1; return nlabel - 1; }
    void Mark(int l) { lblPos[l] = txt.Count; }

    // emit one instruction word, little-endian
    void E4(int w) {
        txt.Add(ByteAt(w, 0)); txt.Add(ByteAt(w, 1));
        txt.Add(ByteAt(w, 2)); txt.Add(ByteAt(w, 3));
    }

    // ---- local load/store ----
    // Locals are addressed relative to the frame pointer (x29) with a signed
    // unscaled imm9 (LDUR/STUR), so push/pop scratch traffic on sp never
    // changes how a local is found. x29 points at the saved x29/x30 pair and
    // the frame starts right below it: local i lives at x29 + (16*i - frame).
    int LocFpOff(int off) {
        return off - frame;
    }
    void LoadLocal(int li, int reg) {
        if (li < 0 || li >= locOff.Count) {
            // fail closed: the runtime list guard would silently read slot 0
            diags.Error("ngen: local slot " + li + " out of range", curLine, curCol);
            LoadImm(reg, 0);
            return;
        }
        int off = LocFpOff(locOff[li]);
        if (off >= -256 && off <= 255) {
            E4(0xF8400000 | ((off & 0x1FF) << 12) | (29 << 5) | reg);
        } else {
            int addr = reg == 16 ? 17 : 16;
            LoadImm(addr, off);
            AddRR(addr, 29, addr);
            LdrU(reg, addr, 0);
        }
    }
    void StoreLocal(int li, int reg) {
        if (li < 0 || li >= locOff.Count) {
            diags.Error("ngen: local slot " + li + " out of range", curLine, curCol);
            return;
        }
        int off = LocFpOff(locOff[li]);
        if (off >= -256 && off <= 255) {
            E4(0xF8000000 | ((off & 0x1FF) << 12) | (29 << 5) | reg);
        } else {
            // x16/x17 are scratch, never an incoming x0..x7 argument.
            int addr = reg == 16 ? 17 : 16;
            LoadImm(addr, off);
            AddRR(addr, 29, addr);
            StrU(reg, addr, 0);
        }
    }

    // ---- immediates ----
    void LoadImm(int reg, long v) {
        if (v >= 0 && v < 65536) {
            E4((int)(0xD2800000 | (v << 5) | reg));      // movz x, #v
            return;
        }
        if (v < 0 && v >= -65536) {
            E4((int)(0x92800000 | (((-v) - 1) << 5) | reg)); // movn x, #~v
            return;
        }
        // 16-bit chunks: plain truncating division mis-extracts negative
        // values (e.g. i64min's top chunk comes out as -32768), so fold the
        // chunk back into [0, 65536).
        long chunk0 = v - (v / 65536) * 65536;
        if (chunk0 < 0) { chunk0 = chunk0 + 65536; }
        E4((int)(0xD2800000 | (chunk0 << 5) | reg));     // movz x, #c0
        int h = 1;
        while (h < 4) {
            long sh = ShiftRight(v, h * 16);
            long chunk = sh - (sh / 65536) * 65536;
            if (chunk < 0) { chunk = chunk + 65536; }
            E4((int)(0xF2800000 | (((long)h) << 21) | (chunk << 5) | reg)); // movk
            h = h + 1;
        }
    }

    long ShiftRight(long v, int bits) {
        // arithmetic (floor) shift: plain halving truncates toward zero, so
        // e.g. 0xFF378ADD's narrowed int32 value -13137187 >> 16 must give
        // -201 (chunk 0xFF37), not -200 (chunk 0xFF38)
        long r = v;
        int n = bits;
        while (n > 0) {
            long prev = r;
            r = prev / 2;
            if (prev < 0 && r * 2 != prev) { r = r - 1; }
            n = n - 1;
        }
        return r;
    }

    // add/sub sp immediate (imm < 4096)
    void AddSPImm(int imm, bool isAdd) {
        if (isAdd) { E4(0x91000000 | (imm << 10) | (31 << 5) | 31); }
        else { E4(0xD1000000 | (imm << 10) | (31 << 5) | 31); }
    }

    // add immediate between registers (imm < 4096)
    void AddImm(int rd, int rn, int imm) {
        // imm12 is unsigned; negative values encode as SUB imm
        if (imm < 0) { E4(0xD1000000 | ((-imm) << 10) | (rn << 5) | rd); }
        else { E4(0x91000000 | (imm << 10) | (rn << 5) | rd); }
    }

    // ---- branches and calls ----
    void EmitB(int label) { E4(0x14000000); fixups.Add(new Fixup(txt.Count - 4, 0, label, 0, null)); }
    void EmitBcond(int cond, int label) {
        E4(0x54000000 | cond);                       // B.cond: cond in the low byte
        fixups.Add(new Fixup(txt.Count - 4, 2, label, cond, null));
    }
    void EmitCBZ(int reg, int label) {
        E4(0xB4000000 | reg);
        fixups.Add(new Fixup(txt.Count - 4, 1, label, 0, null));
    }
    void EmitCbnz(int reg, int label) {
        E4(0xB5000000 | reg);
        fixups.Add(new Fixup(txt.Count - 4, 1, label, 0, null));
    }
    void BLInternal(string sym) { E4(0x94000000); fixups.Add(new Fixup(txt.Count - 4, 3, 0, 0, sym)); }
    void BLExtern(string sym) { E4(0x94000000); fixups.Add(new Fixup(txt.Count - 4, 4, 0, 0, sym)); }

    // ---- strings ----
    int InternStr(string s) {
        strs.Add(s);
        return strs.Count - 1;
    }
    void LoadSymRef(string sym, int reg) {
        E4(0x90000000 | reg);                            // adrp reg, sym@PAGE
        int a = txt.Count - 4;
        E4(0x91000000 | (reg << 5) | reg);               // add reg, reg, sym@PAGEOFF
        strRefs.Add(new StrRef(a, txt.Count - 4, sym));
    }
    // adrp + ldr through the GOT. dylib DATA symbols (__stdinp etc.) cannot
    // bind through adrp+add: their page offsets are filled at runtime by the
    // dynamic loader, so the address must come from a GOT slot instead.
    void LoadSymRefGOT(string sym, int reg) {
        E4(0x90000000 | reg);                            // adrp reg, sym@GOTPAGE
        int a = txt.Count - 4;
        E4(0xF9400000 | (reg << 5) | reg);               // ldr reg, [reg, sym@GOTPAGEOFF]
        StrRef r = new StrRef(a, txt.Count - 4, sym);
        r.got = 1;
        strRefs.Add(r);
    }
    void LoadStr(int si, int reg) {
        // literals live in the startup pool as stamped heap strings; the
        // l_.g.strp.N slot holds the pointer (see RtEmitStrpool)
        LoadSymRef("l_.g.strp." + si, reg);
        LdrU(reg, reg, 0);
    }

    // one-argument libm double call: the value arrives as its bit pattern
    // in x0, moves to d0, and the result comes back the same way
    void DblLibm1(string f) {
        E4(0x9E670000);                                  // fmov d0, x0
        BLExtern(f);
        E4(0x9E660000);                                  // fmov x0, d0
    }

    // ---- fixup resolution (text offsets are final here) ----
    int WordAt(int pos) {
        return (txt[pos + 3] << 24) | (txt[pos + 2] << 16) | (txt[pos + 1] << 8) | txt[pos];
    }
    void SetWordAt(int pos, int w) {
        txt[pos] = ByteAt(w, 0); txt[pos + 1] = ByteAt(w, 1);
        txt[pos + 2] = ByteAt(w, 2); txt[pos + 3] = ByteAt(w, 3);
    }
    int ByteAt(int v, int i) {
        int b = v >> (i * 8);
        b = b - (b / 256) * 256;
        if (b < 0) { b = b + 256; }
        return b;
    }

    void Patch() {
        int i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            int word = WordAt(f.pos);
            if (f.kind == 0) {
                // B: opcode occupies the top 6 bits, imm26 the rest
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                word = (ByteAt(word, 3) / 4) * 67108864 + ModLow(imm, 26);
            } else if (f.kind == 1 || f.kind == 2) {
                // CBZ / B.cond: imm19 at bits 23..5; low byte (Rt / cond) kept.
                // The word is negative (top byte >= 0x80), so the low 5 bits
                // must come from ByteAt -- (word - (word/32)*32) breaks on
                // truncating division for negatives.
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                int lo = ByteAt(word, 0);
                lo = lo - (lo / 32) * 32;
                word = (ByteAt(word, 3) << 24) | (ByteAt(word, 2) << 16)
                     | (ModLow(imm, 19) << 5)
                     | lo;
            } else if (f.kind == 3) {
                // Missing internal symbols must not silently branch to text
                // offset zero. Unlike externs, no linker relocation can fix it.
                int target = SymPos(f.sym);
                if (target < 0) {
                    diags.Error("ngen: unresolved internal symbol '" + f.sym + "'", 0, 0);
                } else {
                    int imm = (target - f.pos) / 4;
                    word = (ByteAt(word, 3) / 4) * 67108864 + ModLow(imm, 26);
                }
            } else {
                // extern BL: imm26 stays zero, resolved by relocation
            }
            SetWordAt(f.pos, word);
            i = i + 1;
        }
    }

    // imm mod 2^n, normalized to [0, 2^n) (two's-complement field value)
    int ModLow(int imm, int bits) {
        int m = imm - (imm / (1 << bits)) * (1 << bits);
        if (m < 0) { m = m + (1 << bits); }
        return m;
    }

    MethIndex symPosIdx;   // name -> syms index; built at first SymPos call
                           // (Patch time, after all symbols are declared)

    int SymPos(string name) {
        if (symPosIdx == null) {
            symPosIdx = new MethIndex();
            int i = 0;
            while (i < syms.Count) { symPosIdx.Add(syms[i].name, i); i = i + 1; }
        }
        List<int> hit = symPosIdx.Get(name);
        return hit != null ? syms[hit[0]].pos : -1;
    }
}
