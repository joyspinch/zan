using System;
using System.Collections;
namespace Zan;

// Ngen: native backend slice (M1). Emits arm64 machine code directly from the
// bound AST — no LLVM IR text, no clang. The object container (Mach-O) lives
// in ngen_macho.zan.
//
// Instruction words are stored as 32-bit two's-complement ints: Zan hex
// literals above 0x7FFFFFFF wrap, but the bit pattern survives the wrap and
// byte extraction takes the low 32 bits.
//
// Kernel subset: static methods, int params/locals/returns, int literals,
// `+ - * <`, if/while, plain calls (recursion ok), Console.WriteLine(int).
// Anything else is a compile error, not a silent fallback.
class Fixup {
    public int pos;    // text offset of the patched instruction
    public int kind;   // 0=B 1=CBZ 2=Bcond 3=BL-internal 4=BL-extern
    public int lbl;    // label id (kinds 0-2)
    public int cond;   // cond code (kind 2)
    public string sym; // target symbol (kinds 3-4)
    public Fixup(int p, int k, int l, int c, string s) {
        pos = p; kind = k; lbl = l; cond = c; sym = s;
    }
}

class StrRef {
    public int adrpPos;  // text offset of the adrp instruction
    public int addPos;   // text offset of the add instruction
    public string sym;   // target symbol name (l_.str.N / l_.g.NAME)
    public StrRef(int a, int b, string s) { adrpPos = a; addPos = b; sym = s; }
}

class Sym {
    public string name;  // link-time symbol name (underscore prefixed)
    public int pos;      // text offset of the definition
    public Sym(string n, int p) { name = n; pos = p; }
}

partial class Ngen {
    Diags diags;

    List<int> txt;          // __text bytes
    List<Sym> syms;         // defined symbols (one per method)
    List<Fixup> fixups;     // branch/call fixups
    List<StrRef> strRefs;   // string address references (adrp+add pairs)
    List<string> strs;      // __cstring entries
    List<int> lblPos;       // label id -> text pos (-1 while open)

    string curCls;
    List<string> locName;   // locals of the method being emitted
    List<string> locTy;     // declared type name per local ("" for this/params of unknown)
    List<int> locOff;       // frame offset (bytes from sp)
    int nloc;
    int frame;
    int nlabel;

    List<Node> methNodes;
    List<string> methCls;
    List<int> methStat;     // 0 = instance, 1 = static, 2 = ctor
    string mainCls;

    public Ngen(Binder b, Diags d) {
        diags = d;
        txt = new List<int>();
        syms = new List<Sym>();
        fixups = new List<Fixup>();
        strRefs = new List<StrRef>();
        strs = new List<string>();
        lblPos = new List<int>();
        methNodes = new List<Node>();
        methCls = new List<string>();
        methStat = new List<int>();
        nlabel = 0;
    }

    // ---- entry: returns the object file bytes ----
    public List<int> Gen(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.ClassDecl()) { CollectMethods(dcl); }
            i = i + 1;
        }
        CollectClasses(unit);
        EmitRtCore();
        if (FindStatic("Main") == null) {
            diags.Error("ngen: no static Main() found", 0, 0);
            return txt;
        }
        EmitMainShim();
        int mi = 0;
        while (mi < methNodes.Count) {
            EmitMethod(methCls[mi], methNodes[mi], mi);
            mi = mi + 1;
        }
        Patch();
        return BuildMachO();
    }

    void CollectMethods(Node cls) {
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && !HasMod(m, MOD.Extern()) && !IsAsync(m)) {
                if (m.sval == "Main" && HasMod(m, MOD.Static())) { mainCls = cls.sval; }
                methNodes.Add(m);
                methCls.Add(cls.sval);
                methStat.Add(HasMod(m, MOD.Static()) ? 1 : 0);
            }
            if (m.kind == AK.CtorDecl()) {
                methNodes.Add(m);
                methCls.Add(cls.sval);
                methStat.Add(2);
            }
            i = i + 1;
        }
    }

    bool HasMod(Node m, int flag) { return (m.mods / flag) - ((m.mods / flag) / 2) * 2 == 1; }
    bool IsAsync(Node m) { return HasMod(m, MOD.Async()); }

    Node FindStatic(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methNodes[i].sval == name && methStat[i] == 1) { return methNodes[i]; }
            i = i + 1;
        }
        return null;
    }

    // find an instance method by name (first match across classes)
    int FindInstanceIdx(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methNodes[i].sval == name && methStat[i] == 0) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // ---- method emission ----
    void EmitMainShim() {
        syms.Add(new Sym("_main", txt.Count));
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]! (save lr: bl below clobbers it)
        BLInternal("_" + mainCls + "_Main");
        E4(0xD2800000);                                  // movz x0, #0
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    void EmitMethod(string cls, Node m, int mi) {
        curCls = cls;
        bool inst = methStat[mi] != 1;
        if (methStat[mi] == 2) {
            syms.Add(new Sym("_" + cls + "_ctor", txt.Count));
        } else {
            syms.Add(new Sym("_" + cls + "_" + m.sval, txt.Count));
        }
        locName = new List<string>();
        locTy = new List<string>();
        locOff = new List<int>();
        nloc = 0;
        // instance methods and ctors take `this` as their first argument
        if (inst) {
            locName.Add("this");
            locTy.Add("");
            locOff.Add(16 * nloc);
            nloc = nloc + 1;
        }
        // params get frame slots; the prologue stores x0.. into them in order
        int pi = 0;
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                locName.Add(p.sval);
                locTy.Add(p.type != null ? p.type.sval : "");
                locOff.Add(16 * nloc);
                nloc = nloc + 1;
            }
            pi = pi + 1;
        }
        ReserveLocals(m.d);
        frame = 16 * nloc;
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]!
        E4(0x910003FD);                                  // mov x29, sp
        if (frame > 0) { AddSPImm(frame, false); }       // sub sp, sp, #frame
        pi = 0;
        int argReg = 0;
        if (inst) {
            StoreLocal(0, 0);        // this
            argReg = 1;
        }
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                E4(0xF8000000 | ((LocFpOff(locOff[argReg]) & 0x1FF) << 12) | (29 << 5) | argReg);
                argReg = argReg + 1;
            }
            pi = pi + 1;
        }
        GenStmt(m.d);
        E4(0xD2800000);                                  // movz x0, #0 (fallthrough)
        Epilogue();
    }

    void ReserveLocals(Node blk) {
        if (blk == null) { return; }
        int i = 0;
        while (i < blk.kids.Count) {
            Node s = blk.kids[i];
            if (s.kind == AK.VarDecl()) {
                locName.Add(s.sval);
                locTy.Add(s.type != null ? s.type.sval : "");
                locOff.Add(16 * nloc);
                nloc = nloc + 1;
            }
            i = i + 1;
        }
    }

    int LocalIdx(string name) {
        int i = locName.Count - 1;
        while (i >= 0) { if (locName[i] == name) { return i; } i = i - 1; }
        return -1;
    }

    void Epilogue() {
        if (frame > 0) { AddSPImm(frame, true); }        // add sp, sp, #frame
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    // ---- statements ----
    void GenStmt(Node s) {
        if (s == null) { return; }
        int k = s.kind;
        if (k == AK.Block()) {
            int i = 0;
            while (i < s.kids.Count) { GenStmt(s.kids[i]); i = i + 1; }
        } else if (k == AK.VarDecl()) {
            if (s.b != null) {
                GenExpr(s.b);
                StoreLocal(LocalIdx(s.sval), 0);
            }
        } else if (k == AK.ExprStmt()) {
            GenExpr(s.a);
        } else if (k == AK.ReturnStmt()) {
            if (s.a != null) { GenExpr(s.a); }
            Epilogue();
        } else if (k == AK.IfStmt()) {
            int els = NL(); int end = NL();
            GenExpr(s.a);
            EmitCBZ(0, els);
            GenStmt(s.b);
            EmitB(end);
            Mark(els);
            if (s.c != null) { GenStmt(s.c); }
            Mark(end);
        } else if (k == AK.WhileStmt()) {
            int top = NL(); int outL = NL();
            Mark(top);
            GenExpr(s.a);
            EmitCBZ(0, outL);
            GenStmt(s.b);
            EmitB(top);
            Mark(outL);
        } else {
            diags.Error("ngen: unsupported statement kind " + k, s.line, s.col);
        }
    }

    // ---- expressions: result in x0 ----
    void GenExpr(Node e) {
        int k = e.kind;
        if (k == AK.IntLit()) {
            LoadImm(0, e.ival);
        } else if (k == AK.StringLit()) {
            LoadStr(InternStr(e.sval), 0);
        } else if (k == AK.ThisExpr()) {
            LoadLocal(LocalIdx("this"), 0);
        } else if (k == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li < 0) {
                // implicit field reference inside instance methods
                Fld fld = CurField(e.sval);
                if (fld != null) {
                    LoadLocal(LocalIdx("this"), 0);
                    LdrU(0, 0, fld.off);
                    return;
                }
                diags.Error("ngen: unknown identifier '" + e.sval + "'", e.line, e.col);
                LoadImm(0, 0);
                return;
            }
            LoadLocal(li, 0);
        } else if (k == AK.MemberAccess()) {
            if (e.sval == "Count" && ExprCls(e.a) == "List") { GenListCount(e.a); }
            else { GenFieldLoad(e); }
        } else if (k == AK.Binary()) {
            if (e.op == TK.Plus() && IsStrExpr(e.a)) {
                // string concatenation: lhs -> x0, rhs -> x1, then
                // zan_rt_strcat2(lhs, rhs)
                GenExpr(e.a);
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                GenExpr(e.b);
                E4(0xF84107E1);                          // ldr x1, [sp], #16 (lhs)
                E4(0xAA0003E9);                          // mov x9, x0
                E4(0xAA0103E0);                          // mov x0, x1
                E4(0xAA0903E1);                          // mov x1, x9
                BLInternal("_zan_rt_strcat2");
            } else {
                GenExpr(e.a);
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]!
                GenExpr(e.b);
                E4(0xF84107E1);                          // ldr x1, [sp], #16
                int op = e.op;
                if (op == TK.Plus()) {
                    E4(0x8B000020);                      // add x0, x1, x0
                } else if (op == TK.Minus()) {
                    E4(0xCB000020);                      // sub x0, x1, x0
                } else if (op == TK.Star()) {
                    E4(0x9B007C20);                      // mul x0, x1, x0
                } else if (op == TK.Less()) {
                    E4(0xEB00003F);                      // cmp x1, x0
                    E4(0x9A9FA7E0);                      // cset x0, lt
                } else {
                    diags.Error("ngen: unsupported operator " + op, e.line, e.col);
                }
            }
        } else if (k == AK.Assignment()) {
            GenExpr(e.b);
            if (e.a != null && e.a.kind == AK.Ident()) {
                int li = LocalIdx(e.a.sval);
                if (li < 0) {
                    // implicit field store inside instance methods
                    Fld fld = CurField(e.a.sval);
                    if (fld != null) {
                        E4(0xF81F0FE0);                  // str x0, [sp, #-16]! (value)
                        LoadLocal(LocalIdx("this"), 0);  // receiver -> x0
                        E4(0xF84107E1);                  // ldr x1, [sp], #16 (value)
                        StrU(1, 0, fld.off);             // str x1, [x0, #off]
                        return;
                    }
                    diags.Error("ngen: unknown identifier '" + e.a.sval + "'", e.line, e.col);
                    return;
                }
                StoreLocal(li, 0);
            } else if (e.a != null && e.a.kind == AK.MemberAccess()) {
                Fld f = FieldOf(e.a);
                if (f == null) {
                    diags.Error("ngen: unknown field '" + e.a.sval + "'", e.line, e.col);
                    return;
                }
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]! (value)
                GenExpr(e.a.a);                          // receiver -> x0
                E4(0xF84107E1);                          // ldr x1, [sp], #16 (value)
                StrU(1, 0, f.off);                       // str x1, [x0, #off]
            } else {
                diags.Error("ngen: unsupported assignment target", e.line, e.col);
            }
        } else if (k == AK.NewExpr()) {
            GenNew(e);
        } else if (k == AK.Call()) {
            GenCall(e);
        } else {
            diags.Error("ngen: unsupported expression kind " + k, e.line, e.col);
        }
    }

    void GenNew(Node e) {
        string cls = e.type != null ? e.type.sval : null;
        if (cls == "List") { GenListNew(); return; }
        Cls c = cls != null ? FindClass(cls) : null;
        if (c == null) {
            diags.Error("ngen: unknown class in 'new' expression", e.line, e.col);
            LoadImm(0, 0);
            return;
        }
        // allocate: x0 = size + 16 (header), x1 = descriptor (0: no dtor)
        LoadImm(0, c.size + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        E4(0xF81F0FE0);                                  // str x0, [sp, #-16]! (obj)
        int i = 0;
        while (i < e.kids.Count) {
            GenExpr(e.kids[i]);
            E4(0xF81F0FE0);                              // str x0, [sp, #-16]! (arg)
            i = i + 1;
        }
        int r = e.kids.Count;
        while (r >= 1) { E4(0xF84107E0 | r); r = r - 1; } // ldr xr, [sp], #16 (args reversed)
        E4(0xF84107E0);                                  // ldr x0, [sp], #16 (obj)
        E4(0xF81F0FE0);                                  // str x0, [sp, #-16]! (keep obj across the void ctor)
        BLInternal("_" + cls + "_ctor");
        E4(0xF84107E0);                                  // ldr x0, [sp], #16 (obj)
    }

    void GenFieldLoad(Node mem) {
        Fld f = FieldOf(mem);
        if (f == null) {
            diags.Error("ngen: unknown field '" + mem.sval + "'", mem.line, mem.col);
            LoadImm(0, 0);
            return;
        }
        GenExpr(mem.a);                                  // receiver -> x0
        LdrU(0, 0, f.off);                               // ldr x0, [x0, #off]
    }

    // static type name of an expression when it denotes a user class, else null
    string ExprCls(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.ThisExpr()) { return curCls; }
        if (e.kind == AK.NewExpr()) { return e.type != null ? e.type.sval : null; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && locTy[li] != null && locTy[li] != "") {
                string t = locTy[li];
                if (t != "int" && t != "string" && t != "bool" && t != "void") { return t; }
            }
        }
        return null;
    }

    Fld FieldOf(Node mem) {
        string cls = ExprCls(mem.a);
        if (cls == null) { return null; }
        Cls c = FindClass(cls);
        if (c == null) { return null; }
        return FindField(c, mem.sval);
    }

    // field of the class being emitted (implicit `this` references)
    Fld CurField(string name) {
        return FindField(FindClass(curCls), name);
    }

    // does this expression evaluate to a string? (local type / field type /
    // string literal / concatenation / method with a string return type)
    bool IsStrExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.StringLit()) { return true; }
        if (e.kind == AK.Binary()) { return e.op == TK.Plus() && (IsStrExpr(e.a) || IsStrExpr(e.b)); }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && f.ty == "string";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            return li >= 0 && locTy[li] == "string";
        }
        if (e.kind == AK.Call() && e.a != null) {
            return MethRetTy(e.a.sval) == "string";
        }
        return false;
    }

    string MethRetTy(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methNodes[i].sval == name && methNodes[i].type != null) { return methNodes[i].type.sval; }
            i = i + 1;
        }
        return "";
    }

    void GenCall(Node e) {
        Node callee = e.a;
        if (callee != null && callee.kind == AK.MemberAccess()) {
            Node recv = callee.a;
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "WriteLine" && e.kids.Count == 1) {
                // own runtime core: print_int(i64) / println(str)
                if (IsStrExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_println");
                } else {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_int");
                }
                return;
            }
            // List<T> built-ins (gen0-compatible inline sequences)
            if (ExprCls(recv) == "List") {
                if (callee.sval == "Add" && e.kids.Count == 1) {
                    GenListAdd(recv, e.kids[0]);
                    return;
                }
                diags.Error("ngen: unsupported List operation '" + callee.sval + "'", e.line, e.col);
                return;
            }
            // instance method call: x0 = receiver, x1.. = args
            int mi = FindInstanceIdx(callee.sval);
            if (mi < 0) {
                diags.Error("ngen: unknown method '" + callee.sval + "'", e.line, e.col);
                return;
            }
            if (e.kids.Count != ParamCount(methNodes[mi])) {
                diags.Error("ngen: arity mismatch calling '" + callee.sval + "'", e.line, e.col);
                return;
            }
            GenExpr(recv);
            E4(0xF81F0FE0);                              // str x0, [sp, #-16]! (receiver)
            int i = 0;
            while (i < e.kids.Count) {
                GenExpr(e.kids[i]);
                E4(0xF81F0FE0);                          // str x0, [sp, #-16]! (arg)
                i = i + 1;
            }
            int r = e.kids.Count;
            while (r >= 1) { E4(0xF84107E0 | r); r = r - 1; } // ldr xr, [sp], #16 (args reversed)
            E4(0xF84107E0);                              // ldr x0, [sp], #16 (receiver)
            BLInternal("_" + methCls[mi] + "_" + callee.sval);
            return;
        }
        if (callee == null || callee.kind != AK.Ident()) {
            diags.Error("ngen: unsupported call target", e.line, e.col);
            return;
        }
        int si = FindStaticIdx(callee.sval);
        if (si < 0) {
            diags.Error("ngen: unknown static method '" + callee.sval + "'", e.line, e.col);
            return;
        }
        Node m = methNodes[si];
        if (e.kids.Count != ParamCount(m)) {
            diags.Error("ngen: arity mismatch calling '" + callee.sval + "'", e.line, e.col);
            return;
        }
        // evaluate args left to right, spilling each; reload into x0.. reversed
        int j = 0;
        while (j < e.kids.Count) {
            GenExpr(e.kids[j]);
            E4(0xF81F0FE0);                              // str x0, [sp, #-16]!
            j = j + 1;
        }
        int q = e.kids.Count - 1;
        while (q >= 0) {
            E4(0xF84107E0 | q);                          // ldr xq, [sp], #16
            q = q - 1;
        }
        BLInternal("_" + methCls[si] + "_" + callee.sval);
    }

    int FindStaticIdx(string name) {
        int i = 0;
        while (i < methNodes.Count) {
            if (methNodes[i].sval == name && methStat[i] == 1) { return i; }
            i = i + 1;
        }
        return -1;
    }

    int ParamCount(Node m) {
        int n = 0; int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // ---- labels ----
    int NL() { lblPos.Add(-1); nlabel = nlabel + 1; return nlabel - 1; }
    void Mark(int l) { lblPos[l] = txt.Count; }

    // emit one instruction word, little-endian
    void E4(int w) {
        txt.Add(ByteAt(w, 0)); txt.Add(ByteAt(w, 1));
        txt.Add(ByteAt(w, 2)); txt.Add(ByteAt(w, 3));
    }

    // ---- local load/store ----
    // Locals are addressed relative to the frame pointer (x29) with a signed
    // unscaled imm9 (LDUR/STUR), so push/pop scratch traffic on sp never
    // changes how a local is found. x29 points at the saved x29/x30 pair and
    // the frame starts right below it: local i lives at x29 + (16*i - frame).
    int LocFpOff(int off) {
        return off - frame;
    }
    void LoadLocal(int li, int reg) {
        E4(0xF8400000 | ((LocFpOff(locOff[li]) & 0x1FF) << 12) | (29 << 5) | reg);
    }
    void StoreLocal(int li, int reg) {
        E4(0xF8000000 | ((LocFpOff(locOff[li]) & 0x1FF) << 12) | (29 << 5) | reg);
    }

    // ---- immediates ----
    void LoadImm(int reg, long v) {
        if (v >= 0 && v < 65536) {
            E4((int)(0xD2800000 | (v << 5) | reg));      // movz x, #v
            return;
        }
        if (v < 0 && v >= -65536) {
            E4((int)(0x92800000 | (((-v) - 1) << 5) | reg)); // movn x, #~v
            return;
        }
        long chunk0 = v - (v / 65536) * 65536;
        E4((int)(0xD2800000 | (chunk0 << 5) | reg));     // movz x, #c0
        int h = 1;
        while (h < 4) {
            long sh = ShiftRight(v, h * 16);
            long chunk = sh - (sh / 65536) * 65536;
            E4((int)(0xF2800000 | (((long)h) << 21) | (chunk << 5) | reg)); // movk
            h = h + 1;
        }
    }

    long ShiftRight(long v, int bits) {
        long r = v;
        int n = bits;
        while (n > 0) { r = r / 2; n = n - 1; }
        return r;
    }

    // add/sub sp immediate (imm < 4096)
    void AddSPImm(int imm, bool isAdd) {
        if (isAdd) { E4(0x91000000 | (imm << 10) | (31 << 5) | 31); }
        else { E4(0xD1000000 | (imm << 10) | (31 << 5) | 31); }
    }

    // add immediate between registers (imm < 4096)
    void AddImm(int rd, int rn, int imm) {
        E4(0x91000000 | (imm << 10) | (rn << 5) | rd);
    }

    // ---- branches and calls ----
    void EmitB(int label) { E4(0x14000000); fixups.Add(new Fixup(txt.Count - 4, 0, label, 0, null)); }
    void EmitBcond(int cond, int label) {
        E4(0x54000000 | cond);                       // B.cond: cond in the low byte
        fixups.Add(new Fixup(txt.Count - 4, 2, label, cond, null));
    }
    void EmitCBZ(int reg, int label) {
        E4(0xB4000000 | reg);
        fixups.Add(new Fixup(txt.Count - 4, 1, label, 0, null));
    }
    void BLInternal(string sym) { E4(0x94000000); fixups.Add(new Fixup(txt.Count - 4, 3, 0, 0, sym)); }
    void BLExtern(string sym) { E4(0x94000000); fixups.Add(new Fixup(txt.Count - 4, 4, 0, 0, sym)); }

    // ---- strings ----
    int InternStr(string s) {
        strs.Add(s);
        return strs.Count - 1;
    }
    void LoadSymRef(string sym, int reg) {
        E4(0x90000000 | reg);                            // adrp reg, sym@PAGE
        int a = txt.Count - 4;
        E4(0x91000000 | (reg << 5) | reg);               // add reg, reg, sym@PAGEOFF
        strRefs.Add(new StrRef(a, txt.Count - 4, sym));
    }
    void LoadStr(int si, int reg) {
        LoadSymRef("l_.str." + si, reg);
    }

    // ---- fixup resolution (text offsets are final here) ----
    int WordAt(int pos) {
        return (txt[pos + 3] << 24) | (txt[pos + 2] << 16) | (txt[pos + 1] << 8) | txt[pos];
    }
    void SetWordAt(int pos, int w) {
        txt[pos] = ByteAt(w, 0); txt[pos + 1] = ByteAt(w, 1);
        txt[pos + 2] = ByteAt(w, 2); txt[pos + 3] = ByteAt(w, 3);
    }
    int ByteAt(int v, int i) {
        int b = v >> (i * 8);
        b = b - (b / 256) * 256;
        if (b < 0) { b = b + 256; }
        return b;
    }

    void Patch() {
        int i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            int word = WordAt(f.pos);
            if (f.kind == 0) {
                // B: opcode occupies the top 6 bits, imm26 the rest
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                word = (word / 67108864) * 67108864 + ModLow(imm, 26);
            } else if (f.kind == 1 || f.kind == 2) {
                // CBZ / B.cond: imm19 at bits 23..5; low byte (Rt / cond) kept
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                word = (ByteAt(word, 3) << 24) | (ByteAt(word, 2) << 16)
                     | (ModLow(imm, 19) << 5)
                     | (word - (word / 32) * 32);
            } else if (f.kind == 3) {
                // internal BL: same layout as B
                int imm = (SymPos(f.sym) - f.pos) / 4;
                word = (word / 67108864) * 67108864 + ModLow(imm, 26);
            } else {
                // extern BL: imm26 stays zero, resolved by relocation
            }
            SetWordAt(f.pos, word);
            i = i + 1;
        }
    }

    // imm mod 2^n, normalized to [0, 2^n) (two's-complement field value)
    int ModLow(int imm, int bits) {
        int m = imm - (imm / (1 << bits)) * (1 << bits);
        if (m < 0) { m = m + (1 << bits); }
        return m;
    }

    int SymPos(string name) {
        int i = 0;
        while (i < syms.Count) {
            if (syms[i].name == name) { return syms[i].pos; }
            i = i + 1;
        }
        return 0;
    }
}
