using System;
using System.Collections;
namespace Zan;

// M2: class/object support for Ngen -- class layout, allocation, instance
// methods, field access, string concat, Console.WriteLine, and the
// Ngen-emitted object runtime core (alloc / str ops / print). The runtime
// core mirrors gen0's IR-embedded runtime (zan_rt_alloc: 16-byte header,
// [-16]=refcount, [-8]=descriptor; strings stamped with the ZANS magic) so
// both backends stay ABI-identical.
//
// Object layout: fields in declaration order, 8-byte-aligned slots; int
// fields occupy 8 bytes (value in slot 0). %List matches {i64,i64,ptr}.

class Fld {
    public string name;
    public int off;
    public string ty;   // "int" / "string" / class name
    public Fld(string n, int o, string t) { name = n; off = o; ty = t; }
}

class Cls {
    public string name;
    public List<Fld> flds;
    public int size;
    public string baseName;  // ": Base" clause, null when none
    public int based;        // base fields already merged into flds
    public Cls(string n) { name = n; flds = new List<Fld>(); size = 0; baseName = null; based = 0; }
}

class DGlob {
    public string name; // data global name (without the l_.g. prefix)
    public int size;
    public int off;     // offset within __DATA,__data
    public DGlob(string n, int s, int o) { name = n; size = s; off = o; }
}

partial class Ngen {
    List<Cls> classes;
    List<DGlob> dglbs;
    int dataLen;
    List<string> sfNames;   // static field names
    List<string> sfCls;     // static field declaring class
    List<string> sfSyms;    // static field data-global symbol
    List<string> sfTy;      // static field declared type
    int fmtiIdx;
    int fmtsIdx;
    int fmtnIdx;
    int fmtuIdx;
    int fmtuNIdx;
    int fmtwIdx;
    int fmtcIdx;
    int emptyIdx;

    Cls FindClass(string n) {
        int i = 0;
        while (i < classes.Count) { if (classes[i].name == n) { return classes[i]; } i = i + 1; }
        return null;
    }

    Fld FindField(Cls c, string n) {
        if (c == null) { return null; }
        int i = 0;
        while (i < c.flds.Count) { if (c.flds[i].name == n) { return c.flds[i]; } i = i + 1; }
        return null;
    }

    int FieldOff(string cls, string fld) {
        Fld f = FindField(FindClass(cls), fld);
        if (f == null) { return -1; }
        return f.off;
    }

    void CollectClasses(Node unit) {
        classes = new List<Cls>();
        dglbs = new List<DGlob>();
        sfNames = new List<string>();
        sfCls = new List<string>();
        sfSyms = new List<string>();
        sfTy = new List<string>();
        dataLen = 0;
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.ClassDecl() || dcl.kind == AK.StructDecl()) { CollectClass(dcl); }
            i = i + 1;
        }
        // fold inherited instance fields into each subclass (base fields
        // first, own fields shifted after); recursion handles chains
        i = 0;
        while (i < classes.Count) { MergeBaseFields(classes[i]); i = i + 1; }
    }

    void MergeBaseFields(Cls c) {
        if (c.based != 0) { return; }
        c.based = 1;
        if (c.baseName == null) { return; }
        Cls b = FindClass(c.baseName);
        if (b == null || b == c) { return; }
        MergeBaseFields(b);
        int shift = b.size;
        if (shift <= 0) { return; }
        List<Fld> merged = new List<Fld>();
        int k = 0;
        while (k < b.flds.Count) { merged.Add(b.flds[k]); k = k + 1; }
        k = 0;
        while (k < c.flds.Count) {
            Fld f = c.flds[k];
            merged.Add(new Fld(f.name, f.off + shift, f.ty));
            k = k + 1;
        }
        c.flds = merged;
        c.size = c.size + shift;
    }

    // static field storage: one 8-byte data-global slot per field; lookup
    // prefers the given class, then falls back to any (ngen dispatches by
    // name everywhere else too)
    string FindStaticSym(string cls, string name) {
        if (cls != null) {
            int i = 0;
            while (i < sfNames.Count) {
                if (sfNames[i] == name && sfCls[i] == cls) { return sfSyms[i]; }
                i = i + 1;
            }
        }
        int j = 0;
        while (j < sfNames.Count) {
            if (sfNames[j] == name) { return sfSyms[j]; }
            j = j + 1;
        }
        return null;
    }

    string FindStaticTy(string cls, string name) {
        if (cls != null) {
            int i = 0;
            while (i < sfNames.Count) {
                if (sfNames[i] == name && sfCls[i] == cls) { return sfTy[i]; }
                i = i + 1;
            }
        }
        int j = 0;
        while (j < sfNames.Count) {
            if (sfNames[j] == name) { return sfTy[j]; }
            j = j + 1;
        }
        return null;
    }

    void CollectClass(Node dcl) {
        Cls c = new Cls(dcl.sval);
        c.baseName = dcl.sval2;
        int off = 0;
        int k = 0;
        while (k < dcl.kids.Count) {
            Node m = dcl.kids[k];
            if (m.kind == AK.FieldDecl() && m.type != null) {
                if (HasMod(m, MOD.Static())) {
                    string dn = "fld." + c.name + "." + m.sval;
                    dglbs.Add(new DGlob(dn, 8, dataLen));
                    dataLen = dataLen + 8;
                    sfNames.Add(m.sval);
                    sfCls.Add(c.name);
                    sfSyms.Add(DGlobalSym(dn));
                    sfTy.Add(TypeFullName(m.type));
                } else {
                    c.flds.Add(new Fld(m.sval, off, m.type.sval));
                    off = off + 8;
                }
            }
            k = k + 1;
        }
        c.size = off;
        classes.Add(c);
    }

    // ---- register-op helpers (encodings verified against clang -arch arm64) ----
    void MovRR(int rd, int rm) { E4(0xAA000000 | (rm << 16) | (31 << 5) | rd); } // mov rd, rm (orr with xzr)
    void AddRR(int rd, int rn, int rm) { E4(0x8B000000 | (rm << 16) | (rn << 5) | rd); }
    void SubImm(int rd, int rn, int imm) { E4(0xD1000000 | (imm << 10) | (rn << 5) | rd); }
    void CbzReg(int rt, int lbl) { E4(0xB4000000 | rt); fixups.Add(new Fixup(txt.Count - 4, 1, lbl, 0, null)); }
    void CbnzReg(int rt, int lbl) { E4(0xB5000000 | rt); fixups.Add(new Fixup(txt.Count - 4, 1, lbl, 0, null)); }
    void LdrU(int rd, int rn, int off) { E4(0xF9400000 | ((off / 8) << 10) | (rn << 5) | rd); }
    void StrU(int rt, int rn, int off) { E4(0xF9000000 | ((off / 8) << 10) | (rn << 5) | rt); }
    void Strb0(int rn) { E4(0x39000000 | (rn << 5) | 31); } // strb wzr, [rn]

    // stur/ldur with explicit base register, signed 9-bit unscaled offset
    void RtStur(int rt, int rn, int off) {
        E4(0xF8000000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
    }
    void RtLdur(int rd, int rn, int off) {
        E4(0xF8400000 | ((off & 0x1FF) << 12) | (rn << 5) | rd);
    }

    // ---- hand-emitted runtime core ----
    void RtPrologue() {
        E4(0xA9BF7BFD); // stp x29, x30, [sp, #-16]!
        E4(0x910003FD); // mov x29, sp
    }
    void RtEpilogue() {
        E4(0xA8C17BFD); // ldp x29, x30, [sp], #16
        E4(0xD65F03C0); // ret
    }
    void RtOom() { // prints the oom message and exits; clobbers everything
        LoadSymRef("l_.str." + oomIdx, 0);
        BLExtern("_printf");
        LoadImm(0, 1);
        BLExtern("_exit");
    }

    int oomIdx;

    void EmitRtCore() {
        strs.Add("zan: out of memory\n");
        oomIdx = strs.Count - 1;
        strs.Add("%lld\n");
        fmtiIdx = strs.Count - 1;
        strs.Add("%s\n");
        fmtsIdx = strs.Count - 1;
        strs.Add("%lld");
        fmtnIdx = strs.Count - 1;
        strs.Add("%llu");
        fmtuIdx = strs.Count - 1;
        strs.Add("%llu\n");
        fmtuNIdx = strs.Count - 1;
        strs.Add("%s");
        fmtwIdx = strs.Count - 1;
        strs.Add("%lc");
        fmtcIdx = strs.Count - 1;
        strs.Add("");
        emptyIdx = strs.Count - 1;
        dglbs.Add(new DGlob("zan_eh", 8, dataLen));
        dataLen = dataLen + 8;
        RtEmitAlloc();
        RtEmitStrAlloc();
        RtEmitStrCat2();
        RtEmitPrintInt();
        RtEmitPrintln();
        RtEmitInt2Str();
        RtEmitDbl2Str();
        RtEmitPrintDouble();
        RtEmitUint2Str();
        RtEmitPrintUint();
        RtEmitChrstr();
        RtEmitSubstr2();
        RtEmitStrjoin();
        RtEmitEhState();
    }

    // ptr zan_rt_int2str(i64 v) -- malloc a 32-byte scratch buffer and
    // sprintf("%lld", v) into it; 32 bytes hold any 64-bit decimal + NUL.
    // Darwin arm64 passes variadic arguments on the stack (at [sp] at the
    // call), not in x2..x7, so v gets a dedicated stack slot.
    void RtEmitInt2Str() {
        syms.Add(new Sym("_zan_rt_int2str", txt.Count));
        RtPrologue();
        E4(0xF81F0FE0);                        // str x0, [sp, #-16]! (save v)
        LoadImm(0, 32);
        BLExtern("_malloc");                  // x0 = buf
        E4(0xF81F0FE0);                        // str x0, [sp, #-16]! (save buf)
        LdrU(2, 31, 16);                       // x2 = v (reload)
        AddSPImm(16, false);                   // variadic argument slot
        StrU(2, 31, 0);                        // [sp] = v
        LdrU(0, 31, 16);                       // x0 = buf
        LoadSymRef("l_.str." + fmtnIdx, 1);    // x1 = "%lld"
        BLExtern("_sprintf");
        AddSPImm(16, true);                    // drop the vararg slot
        LdrU(0, 31, 0);                        // x0 = buf
        AddSPImm(32, true);                    // pop buf + v
        RtEpilogue();
    }

    // zan_rt_print_double(double v) -- gen0 embeds this shim in its IR (the
    // C objects only carry the underlying zan_rt_dbl_str writer), so the
    // native backend mirrors it: 40-byte stack buffer, %g render, println.
    void RtEmitPrintDouble() {
        syms.Add(new Sym("_zan_rt_print_double", txt.Count));
        RtPrologue();
        AddSPImm(48, false);                   // 40-byte buffer, 16-aligned
        E4(0x910003E0);                        // mov x0, sp
        LoadImm(1, 40);
        BLExtern("_zan_rt_dbl_str");           // v flows through in d0
        E4(0x910003E0);                        // x0 = buf
        BLInternal("_zan_rt_println");         // printf("%s\n", buf)
        AddSPImm(48, true);
        RtEpilogue();
    }

    // ptr zan_rt_uint2str(i64 v) -- as int2str but "%llu", matching
    // gen0's ulong rendering (the high bit prints unsigned)
    void RtEmitUint2Str() {
        syms.Add(new Sym("_zan_rt_uint2str", txt.Count));
        RtPrologue();
        E4(0xF81F0FE0);                        // str x0, [sp, #-16]! (save v)
        LoadImm(0, 32);
        BLExtern("_malloc");                  // x0 = buf
        E4(0xF81F0FE0);                        // str x0, [sp, #-16]! (save buf)
        LdrU(2, 31, 16);                       // x2 = v (reload)
        AddSPImm(16, false);                   // variadic argument slot
        StrU(2, 31, 0);                        // [sp] = v
        LdrU(0, 31, 16);                       // x0 = buf
        LoadSymRef("l_.str." + fmtuIdx, 1);    // x1 = "%llu"
        BLExtern("_sprintf");
        AddSPImm(16, true);                    // drop the vararg slot
        LdrU(0, 31, 0);                        // x0 = buf
        AddSPImm(32, true);                    // pop buf + v
        RtEpilogue();
    }

    // zan_rt_print_uint(i64 v) -- gen0 embeds this shim in its IR
    // (printf("%llu\n", v); Darwin arm64 takes the variadic on the stack)
    void RtEmitPrintUint() {
        syms.Add(new Sym("_zan_rt_print_uint", txt.Count));
        RtPrologue();
        AddSPImm(16, false);                   // variadic argument slot
        StrU(0, 31, 0);                        // [sp] = v
        LoadSymRef("l_.str." + fmtuNIdx, 0);   // x0 = "%llu\n"
        BLExtern("_printf");
        AddSPImm(16, true);
        RtEpilogue();
    }

    // ptr zan_rt_dbl2str(i64 bits) -- the value arrives as the i64 bit
    // pattern our expression model carries; renders with the C runtime's
    // %g writer into a 40-byte stack buffer and returns a heap string
    // (a copy through strcat2's allocator, so it outlives the buffer)
    void RtEmitDbl2Str() {
        syms.Add(new Sym("_zan_rt_dbl2str", txt.Count));
        RtPrologue();
        E4(0x9E670000);                        // fmov d0, x0
        AddSPImm(48, false);                   // 40-byte buffer, 16-aligned
        E4(0x910003E0);                        // mov x0, sp
        LoadImm(1, 40);
        BLExtern("_zan_rt_dbl_str");
        E4(0x910003E0);                        // x0 = buf
        MovRR(9, 0);                           // x9 = buf
        LoadSymRef("l_.str." + emptyIdx, 0);   // x0 = ""
        MovRR(1, 9);                           // x1 = buf
        BLInternal("_zan_rt_strcat2");
        AddSPImm(48, true);
        RtEpilogue();
    }

    // ptr zan_rt_chrstr(i64 cp) -- render one codepoint as a heap string
    // via snprintf("%lc") (libc does the UTF-8 multibyte encoding), then a
    // strcat2 copy so the result carries a stamped header like gen0's
    void RtEmitChrstr() {
        syms.Add(new Sym("_zan_rt_chrstr", txt.Count));
        RtPrologue();
        AddSPImm(32, false);                   // buf[16] | variadic slot
        StrU(0, 31, 0);                        // [sp] = cp (first stack variadic)
        E4(0x910043E0);                        // x0 = buf (sp+16)
        LoadImm(1, 16);
        LoadSymRef("l_.str." + fmtcIdx, 2);    // x2 = "%lc"
        BLExtern("_snprintf");
        E4(0x910043E0);                        // x0 = buf (sp+16)
        MovRR(9, 0);
        LoadSymRef("l_.str." + emptyIdx, 0);   // x0 = ""
        MovRR(1, 9);
        BLInternal("_zan_rt_strcat2");
        AddSPImm(32, true);
        RtEpilogue();
    }

    // ptr zan_rt_substr2(ptr s, i64 start) -- caller checked start <= len
    // (gen0 folds an out-of-range start to 0 at the call site). Builds the
    // substring with str_alloc/memcpy and stamps the real length header.
    void RtEmitSubstr2() {
        syms.Add(new Sym("_zan_rt_substr2", txt.Count));
        RtPrologue();
        E4(0xF81F0FE0);                        // push s
        E4(0xF81F0FE1);                        // push start
        LdrU(1, 31, 16);                       // x1 = s
        E4(0xD1002022);                        // sub x2, x1, #8
        E4(0xF9400042);                        // ldr x2, [x2]
        E4(0xD3407C42);                        // ubfm x2, x2, #0, #31 (len)
        LdrU(3, 31, 0);                        // x3 = start
        E4(0xCB030044);                        // sub x4, x2, x3 (subl)
        E4(0xEB1F009F);                        // cmp x4, xzr
        EmitBcond(10, NL());
        int ok = lblPos.Count - 1;
        LoadImm(4, 0);
        Mark(ok);
        E4(0x91000480);                        // add x0, x4, #1 (size)
        E4(0xF81F0FE4);                        // push subl
        BLInternal("_zan_rt_str_alloc");       // x0 = dst
        E4(0xF81F0FE0);                        // push dst
        LdrU(0, 31, 0);                        // dst
        LdrU(1, 31, 48);                       // s
        LdrU(2, 31, 32);                       // start
        E4(0x8B020021);                        // add x1, x1, x2 (s + start)
        LdrU(2, 31, 16);                       // subl
        BLExtern("_memcpy");
        LdrU(0, 31, 0);                        // dst
        LdrU(1, 31, 16);                       // subl
        E4(0x8B010000);                        // add x0, x0, x1
        Strb0(0);                              // *end = 0
        LdrU(0, 31, 0);                        // dst
        E4(0xD1002009);                        // sub x9, x0, #8
        LoadImm(1, 0x5A414E5300000000);
        LdrU(2, 31, 16);                       // subl
        E4(0xAA020020);                        // orr x0, x1, x2 (hdr | len)
        StrU(0, 9, 0);
        LdrU(0, 31, 0);                        // return dst
        AddSPImm(64, true);                    // pop dst/subl/start/s
        RtEpilogue();
    }

    // ptr zan_rt_strjoin(sep, list) -- string.Join(sep, List<string>).
    // Two passes exactly like gen0's __zan_str_join: one strlen pass for
    // the total (sep counted n-1 times, only when n > 0), then str_alloc
    // of align32(total + 1) (min 32) and a copy pass with the sep between
    // elements. Null elements count as "". No length header is written.
    // Frame slots: [0]=total [8]=i [16]=list [24]=sep [32]=seplen
    // [40]=pos [48]=buf [56]=elem [64]=sl.
    void RtEmitStrjoin() {
        syms.Add(new Sym("_zan_rt_strjoin", txt.Count));
        RtPrologue();
        AddSPImm(80, false);
        StrU(1, 31, 16);                       // [sp+16] = list (x1)
        StrU(0, 31, 24);                       // [sp+24] = sep (x0)
        LdrU(0, 31, 24);
        BLExtern("_strlen");                   // x0 = seplen
        StrU(0, 31, 32);
        // total = n > 0 ? seplen * (n - 1) : 0
        E4(0xD2800004);                        // movz x4, #0
        LdrU(2, 31, 16);
        LdrU(2, 2, 0);                         // x2 = n
        int sepskip = NL();
        CbzReg(2, sepskip);
        LdrU(3, 31, 32);
        E4(0xD1000442);                        // sub x2, x2, #1
        E4(0x9B027C64);                        // mul x4, x3, x2
        Mark(sepskip);
        StrU(4, 31, 0);                        // [sp] = total
        E4(0xD2800000);                        // movz x0, #0
        StrU(0, 31, 8);                        // i = 0
        // pass 1: total += strlen(elem or "")
        int l1 = NL();
        int d1 = NL();
        int isn1 = NL();
        int isa1 = NL();
        Mark(l1);
        LdrU(0, 31, 8);                        // i
        LdrU(2, 31, 16);
        LdrU(2, 2, 0);                         // n
        E4(0xEB02001F);                        // cmp x0, x2
        EmitBcond(10, d1);                     // b.ge d1
        LdrU(3, 31, 16);
        LdrU(3, 3, 16);                        // x3 = data
        E4(0xF8607860);                        // ldr x0, [x3, x0, lsl #3]
        CbzReg(0, isn1);
        BLExtern("_strlen");                   // x0 = sl
        EmitB(isa1);
        Mark(isn1);
        E4(0xD2800000);                        // movz x0, #0
        Mark(isa1);
        LdrU(1, 31, 0);
        AddRR(1, 1, 0);
        StrU(1, 31, 0);                        // total += sl
        LdrU(0, 31, 8);
        AddImm(0, 0, 1);
        StrU(0, 31, 8);                        // i++
        EmitB(l1);
        Mark(d1);
        // buf = str_alloc(max(align32(total + 1), 32))
        LdrU(0, 31, 0);
        AddImm(0, 0, 1);
        AddImm(0, 0, 31);
        E4(0x927BE800);                        // and x0, x0, #-32
        LoadImm(9, 32);
        E4(0xEB09001F);                        // cmp x0, x9
        int ok32 = NL();
        EmitBcond(2, ok32);                    // b.hs ok32
        LoadImm(0, 32);
        Mark(ok32);
        BLInternal("_zan_rt_str_alloc");
        StrU(0, 31, 48);                       // [sp+48] = buf
        E4(0xD2800000);                        // movz x0, #0
        StrU(0, 31, 40);                       // pos = 0
        StrU(0, 31, 8);                        // i = 0
        // pass 2: copy element, sep when i + 1 < n, NUL at the end
        int l2 = NL();
        int d2 = NL();
        int nosep = NL();
        int isn2 = NL();
        int isa2 = NL();
        Mark(l2);
        LdrU(0, 31, 8);                        // i
        LdrU(2, 31, 16);
        LdrU(2, 2, 0);                         // n
        E4(0xEB02001F);                        // cmp x0, x2
        EmitBcond(10, d2);                     // b.ge d2
        LdrU(3, 31, 16);
        LdrU(3, 3, 16);                        // x3 = data
        E4(0xF8607863);                        // ldr x3, [x3, x0, lsl #3]
        StrU(3, 31, 56);                       // [sp+56] = elem
        CbzReg(3, isn2);
        LdrU(0, 31, 56);
        BLExtern("_strlen");
        StrU(0, 31, 64);                       // [sp+64] = sl
        EmitB(isa2);
        Mark(isn2);
        E4(0xD2800000);                        // movz x0, #0
        StrU(0, 31, 64);
        Mark(isa2);
        LdrU(0, 31, 48);                       // buf
        LdrU(9, 31, 40);                       // pos
        E4(0x8B090000);                        // add x0, x0, x9 (dst)
        LdrU(1, 31, 56);                       // elem
        LdrU(2, 31, 64);                       // sl
        BLExtern("_memcpy");
        LdrU(1, 31, 64);
        LdrU(2, 31, 40);
        AddRR(2, 2, 1);
        StrU(2, 31, 40);                       // pos += sl
        LdrU(0, 31, 8);                        // i
        AddImm(0, 0, 1);                       // i + 1
        LdrU(2, 31, 16);
        LdrU(2, 2, 0);                         // n
        E4(0xEB02001F);                        // cmp i+1, n
        EmitBcond(10, nosep);                  // b.ge nosep
        LdrU(0, 31, 48);                       // buf
        LdrU(9, 31, 40);                       // pos
        E4(0x8B090000);                        // add x0, x0, x9 (dst)
        LdrU(1, 31, 24);                       // sep
        LdrU(2, 31, 32);                       // seplen
        BLExtern("_memcpy");
        LdrU(1, 31, 32);
        LdrU(2, 31, 40);
        AddRR(2, 2, 1);
        StrU(2, 31, 40);                       // pos += seplen
        Mark(nosep);
        LdrU(0, 31, 8);
        AddImm(0, 0, 1);
        StrU(0, 31, 8);                        // i++
        EmitB(l2);
        Mark(d2);
        LdrU(0, 31, 48);                       // buf
        LdrU(9, 31, 40);                       // pos
        E4(0x8B090000);                        // add x0, x0, x9
        Strb0(0);                              // buf[pos] = NUL
        LdrU(0, 31, 48);                       // return buf
        AddSPImm(80, true);
        RtEpilogue();
    }

    // initialise the string-literal pool: every interned literal becomes a
    // stamped heap string (rc=1, SNAZ header with the real length) stored
    // in a l_.g.strp.N slot; LoadStr loads the pointer from that slot. This
    // mirrors gen0's stamped literal constants and lets Length/index probe
    // the header. Runs once from _main before user code.
    void RtEmitStrpool() {
        syms.Add(new Sym("_zan_rt_strpool_init", txt.Count));
        RtPrologue();
        int i = 0;
        while (i < strs.Count) {
            dglbs.Add(new DGlob("strp." + i, 8, dataLen));
            dataLen = dataLen + 8;
            LoadSymRef("l_.str." + i, 0);      // x0 = literal text
            E4(0xF81F0FE0);                    // push text
            BLExtern("_strlen");               // x0 = len
            E4(0xF81F0FE0);                    // push len
            AddImm(0, 0, 1);                   // size = len + 1
            BLInternal("_zan_rt_str_alloc");   // x0 = dst (stamped unknown)
            E4(0xF81F0FE0);                    // push dst
            LdrU(0, 31, 0);
            LdrU(1, 31, 32);                   // text
            LdrU(2, 31, 16);                   // len
            BLExtern("_memcpy");
            LdrU(0, 31, 0);
            LdrU(1, 31, 16);
            AddRR(0, 0, 1);
            Strb0(0);                          // dst[len] = 0
            LdrU(0, 31, 0);
            E4(0xD1002009);                    // sub x9, x0, #8
            LoadImm(1, 0x5A414E5300000000);
            LdrU(2, 31, 16);                   // len
            E4(0xAA020020);                    // orr x0, x1, x2
            StrU(0, 9, 0);                     // stamp real length
            LoadSymRef("l_.g.strp." + i, 9);
            LdrU(0, 31, 0);
            StrU(0, 9, 0);                     // strp.slot = dst
            AddSPImm(48, true);                // pop dst/len/text
            i = i + 1;
        }
        RtEpilogue();
    }

    // ptr _zan_rt_eh_state(): the exception-state block, allocated on first
    // use: { i32 top, ptr exc, 64 x 1024-byte setjmp slots }
    void RtEmitEhState() {
        syms.Add(new Sym("_zan_rt_eh_state", txt.Count));
        RtPrologue();
        LoadSymRef("l_.g.zan_eh", 0);
        LdrU(0, 0, 0);
        CbzReg(0, NL());
        int alloc = lblPos.Count - 1;
        RtEpilogue();
        Mark(alloc);
        LoadImm(0, 16 + 64 * 1024);
        LoadImm(1, 0);
        BLExtern("_calloc");
        E4(0xF81F0FE0);                              // push state
        LoadSymRef("l_.g.zan_eh", 1);
        StrU(0, 1, 0);                               // global = state
        E4(0xF84107E0);                              // pop x0 (state)
        RtEpilogue();
    }

    // ptr zan_rt_alloc(i64 size, i64 desc): zeroed (calloc), rc=1, desc at raw+8
    void RtEmitAlloc() {
        syms.Add(new Sym("_zan_rt_alloc", txt.Count));
        RtPrologue();
        AddSPImm(16, false);      // sub sp, sp, #16 (scratch below the saved pair)
        StrU(1, 31, 0);           // str x1, [sp]      (save desc)
        AddImm(0, 0, 16);
        LoadImm(1, 1);
        BLExtern("_calloc");
        CbzReg(0, NL());
        int oom = lblPos.Count - 1;
        LoadImm(2, 1);
        StrU(2, 0, 0);
        LdrU(1, 31, 0);
        StrU(1, 0, 8);
        AddImm(0, 0, 16);
        AddSPImm(16, true);       // add sp, sp, #16
        RtEpilogue();
        Mark(oom);
        RtOom();
    }

    // ptr zan_rt_str_alloc(i64 total): malloc'd, rc=1, magic|sentinel at raw+8
    void RtEmitStrAlloc() {
        syms.Add(new Sym("_zan_rt_str_alloc", txt.Count));
        RtPrologue();
        AddImm(0, 0, 16);
        BLExtern("_malloc");
        CbzReg(0, NL());
        int oom = lblPos.Count - 1;
        LoadImm(2, 1);
        StrU(2, 0, 0);
        LoadImm(2, 0x5A414E5354524D47);
        StrU(2, 0, 8);
        AddImm(0, 0, 16);
        RtEpilogue();
        Mark(oom);
        RtOom();
    }

    // ptr zan_rt_strcat2(ptr a, ptr b)
    // frame 96: a@-96, b@-80, l1@-64, l2@-48, buf@-32 (l1+l2 recomputed via slots)
    void RtEmitStrCat2() {
        syms.Add(new Sym("_zan_rt_strcat2", txt.Count));
        RtPrologue();
        E4(0xD10403FF);           // sub sp, sp, #96
        RtStur(0, 29, -96);       // a
        RtStur(1, 29, -80);       // b
        RtLdur(0, 29, -96);
        BLExtern("_strlen");
        RtStur(0, 29, -64);       // l1
        RtLdur(0, 29, -80);
        BLExtern("_strlen");
        RtStur(0, 29, -48);       // l2
        // memcpy(buf, a, l1) -- buf allocated after lengths so total is known
        RtLdur(0, 29, -64);       // l1
        RtLdur(1, 29, -48);       // l2
        AddRR(0, 0, 1);           // x0 = l1 + l2
        AddImm(0, 0, 1);          // total (bytes incl NUL)
        BLInternal("_zan_rt_str_alloc");
        RtStur(0, 29, -32);       // buf
        RtLdur(0, 29, -32);
        RtLdur(1, 29, -96);
        RtLdur(2, 29, -64);
        BLExtern("_memcpy");
        // memcpy(buf + l1, b, l2)
        RtLdur(0, 29, -32);
        RtLdur(3, 29, -64);
        AddRR(0, 0, 3);
        RtLdur(1, 29, -80);
        RtLdur(2, 29, -48);
        BLExtern("_memcpy");
        // *end = 0 at buf + l1 + l2 (memcpy returned buf+l1, so recompute)
        RtLdur(0, 29, -32);
        RtLdur(1, 29, -64);
        AddRR(0, 0, 1);
        RtLdur(1, 29, -48);
        AddRR(0, 0, 1);
        Strb0(0);
        // stamp header at buf-8: 0x5A414E53_00000000 | (l1 + l2)
        RtLdur(1, 29, -64);
        RtLdur(2, 29, -48);
        AddRR(1, 1, 2);           // len
        LoadImm(4, 0x5A414E5300000000);
        E4(0xAA040021);           // orr x1, x1, x4
        RtLdur(5, 29, -32);
        SubImm(5, 5, 8);
        RtStur(1, 5, 0);          // str x1, [x5] (== buf-8)
        RtLdur(0, 29, -32);
        E4(0x910403FF);           // add sp, sp, #96
        RtEpilogue();
    }

    // void zan_rt_print_int(i64 v) -- printf("%lld\n", v on stack)
    void RtEmitPrintInt() {
        syms.Add(new Sym("_zan_rt_print_int", txt.Count));
        RtPrologue();
        E4(0xF81F0FE0);           // str x0, [sp, #-16]!
        LoadSymRef("l_.str." + fmtiIdx, 0);
        BLExtern("_printf");
        E4(0xF84107E0);           // ldr x0, [sp], #16
        RtEpilogue();
    }

    // void zan_rt_println(ptr s) -- printf("%s\n", s on stack)
    void RtEmitPrintln() {
        syms.Add(new Sym("_zan_rt_println", txt.Count));
        RtPrologue();
        E4(0xF81F0FE0);
        LoadSymRef("l_.str." + fmtsIdx, 0);
        BLExtern("_printf");
        E4(0xF84107E0);
        RtEpilogue();
    }

    // ---- List<T>, ABI-identical to gen0's %List = {i64 count, i64 cap, ptr data} ----

    // new List<T>(): alloc 24+16 (calloc-zeroed count), cap = 8,
    // data = calloc(8, 8) -- mirrors gen0's collection initializer
    void GenListNew() {
        LoadImm(0, 24 + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        E4(0xF81F0FE0);                              // str x0, [sp, #-16]! (obj)
        LoadImm(1, 8);
        StrU(1, 0, 8);                               // obj->cap = 8
        LoadImm(0, 8);
        LoadImm(1, 8);
        BLExtern("_calloc");                         // data = calloc(8, 8)
        E4(0xF84107E1);                              // ldr x1, [sp], #16 (obj)
        StrU(0, 1, 16);                              // obj->data = x0
        MovRR(0, 1);                                 // result = obj
    }

    // new T[count]: gen0's inline array allocation. Layout from the user
    // pointer arr: count = i64 at arr-16, magic2 at arr-24, data at arr+0.
    // raw = calloc(count*esz + 32): [raw]=rc 1, [raw+8]=25404552263127619,
    // [raw+16]=count, [raw+24]=6503565379360670041. A negative count reports
    // "negative array length" and then fails the overflow guard (which
    // zeroes count, like gen0's select pair); a failed calloc reports and
    // stores into null exactly like gen0's continue-after-guard flow.
    void GenArrNew(Node countExpr, int esz) {
        if (countExpr == null) {
            LoadImm(0, 0);
        } else {
            GenExpr(countExpr);                          // x0 = count
        }
        // negative guard: report, keep the value (gen0's rt.cont keeps %0)
        E4(0xEB1F001F);                              // cmp x0, xzr
        int okneg = NL();
        EmitBcond(10, okneg);                        // b.ge okneg
        E4(0xF81F0FE0);                              // keep count
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrNeg, 3);
        BLExtern("_zan_rt_guard_fail3");
        E4(0xF84107E0);                              // pop count
        Mark(okneg);
        // total = count * esz; overflow = total > 2^64-33 (unsigned)
        MovRR(1, 0);                                 // x1 = count
        if (esz == 4) {
            E4(0xD37EF400);                          // lsl x0, x0, #2
        } else {
            E4(0xD37DF000);                          // lsl x0, x0, #3
        }
        LoadImm(9, -33);                             // x9 = 0xFFFF...FFDF
        E4(0xEB09001F);                              // cmp x0, x9
        int okovf = NL();
        EmitBcond(9, okovf);                         // b.ls okovf (unsigned <=)
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrOvf, 3);
        BLExtern("_zan_rt_guard_fail3");
        LoadImm(0, 0);                               // safe total = 0
        LoadImm(1, 0);                               // safe count = 0
        Mark(okovf);
        // bytes = total + 32; raw = calloc(bytes, 1)
        E4(0x91008000);                              // add x0, x0, #32
        E4(0xF81F0FE1);                              // push count
        LoadImm(1, 1);
        BLExtern("_calloc");                         // x0 = raw
        E4(0xF84107E1);                              // pop count -> x1
        // null guard: gen0 reports and continues into the stores
        int okalloc = NL();
        CbnzReg(0, okalloc);
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrFail, 3);
        BLExtern("_zan_rt_guard_fail3");
        Mark(okalloc);
        E4(0xF81F0FE0);                              // push raw
        LoadImm(2, 1);
        StrU(2, 0, 0);                               // raw->rc = 1
        LoadImm(2, 25404552263127619);
        StrU(2, 0, 8);                               // raw->rcmagic
        StrU(1, 0, 16);                              // raw->count
        LoadImm(2, 6503565379360670041);
        StrU(2, 0, 24);                              // raw->magic2
        E4(0xF84107E0);                              // pop raw -> x0
        E4(0x91008000);                              // add x0, x0, #32 (arr)
    }

    // list.Count: load field 0
    void GenListCount(Node recv) {
        GenExpr(recv);
        LdrU(0, 0, 0);
    }

    // list.Add(v) inlined: grow when count == cap (cap*2, realloc data),
    // then data[count++] = v -- mirrors gen0's inline Add sequence
    void GenListAdd(Node recv, Node arg) {
        GenExpr(recv);
        E4(0xF81F0FE0);                              // push list
        GenExpr(arg);
        E4(0xF81F0FE0);                              // push value
        E4(0xF84107E1);                              // ldr x1, [sp], #16 (value)
        E4(0xF84107E0);                              // ldr x0, [sp], #16 (list)
        // re-push list+value as one pair: the str-only push leaves the
        // upper half of the slot stale (callee-saved LR from earlier calls)
        E4(0xA9BF07E0);                              // stp x0, x1, [sp, #-16]!
        LdrU(2, 0, 0);                               // count
        LdrU(3, 0, 8);                               // cap
        E4(0xEB03005F);                              // cmp x2, x3
        int skip = NL();
        EmitBcond(1, skip);                          // b.ne skip (cond 1 = NE)
        AddRR(3, 3, 3);                              // ncap = cap * 2
        StrU(3, 0, 8);                               // cap = ncap
        LdrU(4, 0, 16);                              // old data
        MovRR(9, 3);
        AddRR(9, 9, 9);
        AddRR(9, 9, 9);
        AddRR(9, 9, 9);                              // x9 = ncap * 8 bytes
        MovRR(0, 4);
        MovRR(1, 9);
        BLExtern("_realloc");
        LdrU(5, 31, 0);                              // x5 = list
        StrU(0, 5, 16);                              // list->data = new data
        Mark(skip);
        LdrU(0, 31, 0);                              // list
        LdrU(2, 0, 0);                               // count
        LdrU(3, 0, 16);                              // data
        LdrU(1, 31, 8);                              // value
        E4(0xF8207800 | (2 << 16) | (3 << 5) | 1);   // str x1, [x3, x2, lsl #3]
        AddImm(2, 2, 1);                             // count + 1
        StrU(2, 0, 0);                               // list->count
        AddSPImm(16, true);                          // pop the stp'd pair
    }
}
