using System;
using System.Collections;
namespace Zan;

// macOS arm64, hand-emitted libSystem-only guard runtime.
// Integration (this partial deliberately changes no existing source):
//  1. Include ngen_guard.zan in every compiler-stage source list.
//  2. Call EmitGuardRuntime() once at the END of EmitRtCore(), or immediately
//     after EmitRtCore() in Ngen.Gen (one location only, never both).
//     CollectClasses must already have initialized dglbs; emit before
//     RtEmitStrpool/Patch/BuildMachO. No startup/main hook is needed.
//  3. Change ALL BLExtern("_zan_rt_guard_fail3") to BLInternal in ngen*.zan.
//     Do not link rt_timer.o (duplicate guard/strict symbols). Other unrelated
//     C runtime dependencies are outside this partial's scope.
//  4. A future --strict-runtime main prologue can BLInternal
//     ("_zan_rt_set_strict") before user code/first policy query.
//
// Source of truth: zan-lang/src/runtime/rt_timer.c:160-457, POSIX branch.
// It reads ZAN_RT_HARD, NOT ZAN_RUNTIME_ERRORS. Unset uses baked strict (0
// initially); empty or first byte '0' explicitly opts out; any other first
// byte opts in. Policy is cached on first query, including strict's value.
// On macOS hard means exit(70), WITHOUT stderr/log (those are Windows-only).
// Soft always appends a newline, even if msg already has one; 1400-byte
// snprintf output clamps to 1398 before adding newline/NUL. Dedup uses the
// ORIGINAL file pointer plus unsigned 32-bit line/col; 256 stored sites,
// overflow sites keep reporting. Null file/msg render as <unknown>/empty.
// ZAN_LOG_DIR must be nonempty and shorter than 4096. Otherwise the current
// C code tries /proc/self/exe and falls back to cwd-relative "logs", NOT
// _NSGetExecutablePath. Likewise log headers normally say exe=<unknown>.
// Log path: logdir/YYYYMM/DD.log, mkdir 0755 (not recursive), fopen "ab",
// header only for size==0; timestamp/localtime, close/flush each report.
// Path/date/open failures degrade as in the reference (zan_soft.log fallback
// on localtime/path overflow; no abort on filesystem/allocation failure).
//
// Lock: zero-initialized Darwin os_unfair_lock (actual libSystem mutex, not
// a placeholder/spin flag). Serializes cache, strict, dedup AND log I/O, a
// stronger race-free version of the reference's timer-lock critical section.
// No heap allocation of our own. All libc-crossing live values are in real
// allocated frames. SP stays 16-aligned, x18 and x19..x28 untouched; fp/lr
// saved. Darwin variadic arguments occupy 8-byte stack slots, including %u.
partial class Ngen {
    void GuardString(string text, int reg) {
        LoadSymRef("l_.str." + InternStr(text), reg);
    }
    void GuardGlobal(string name, int size) {
        dglbs.Add(new DGlob("guard." + name, size, dataLen));
        dataLen = dataLen + size;
    }
    void GuardAddr(string name, int reg) { LoadSymRef("l_.g.guard." + name, reg); }
    void GuardFrame(string name, int size) {
        syms.Add(new Sym(name, txt.Count));
        RtPrologue();
        GuardStack(size, false);
    }
    void GuardStack(int size, bool add) {
        // Existing AddSPImm only accepts imm12. Chunk large frames without
        // accidentally setting the shift bit; <=4080 also touches no red zone.
        while (size > 4080) { AddSPImm(4080, add); size = size - 4080; }
        if (size > 0) { AddSPImm(size, add); }
    }
    void GuardReturn(int size) { GuardStack(size, true); RtEpilogue(); }
    void GuardSp(int reg, int off) { AddImm(reg, 31, off); }
    void GuardCmp(int a, int b) { E4(0xEB00001F | (b << 16) | (a << 5)); }
    void GuardCmpImm(int a, int imm) { E4(0xF100001F | (imm << 10) | (a << 5)); }
    void GuardByte(int rd, int rn) { E4(0x39400000 | (rn << 5) | rd); }
    void GuardLock() { GuardAddr("lock", 0); BLExtern("_os_unfair_lock_lock"); }
    void GuardUnlock() { GuardAddr("lock", 0); BLExtern("_os_unfair_lock_unlock"); }
    void GuardStderr(int reg) {
        LoadSymRefGOT("___stderrp", reg);
        LdrU(reg, reg, 0);
    }

    void EmitGuardRuntime() {
        GuardGlobal("lock", 8); // os_unfair_lock is 4 bytes; 8 preserves alignment
        GuardGlobal("policy", 8); // 0=unqueried, 1=soft, 2=hard
        GuardGlobal("strict", 8);
        GuardGlobal("count", 8);
        GuardGlobal("sites", 256 * 24); // {ptr, zero-extended unsigned, unsigned}
        GuardGlobal("logdir", 4096);
        GuardEmitPolicy();
        GuardEmitFail3();
        GuardEmitLogdir();
        GuardEmitPath();
        GuardEmitAppend();
    }

    void GuardEmitPolicy() {
        // Caller holds the lock. x0 returns bool; no global -1 initializer.
        GuardFrame("_zan_guard_policy_locked", 16);
        GuardAddr("policy", 9); LdrU(0, 9, 0);
        int cached = NL(); CbnzReg(0, cached);
        GuardString("ZAN_RT_HARD", 0); BLExtern("_getenv");
        int absent = NL(); int store = NL(); int soft = NL();
        CbzReg(0, absent);
        GuardByte(1, 0); CbzReg(1, soft);
        GuardCmpImm(1, 48); EmitBcond(0, soft);
        LoadImm(0, 2); EmitB(store);
        Mark(soft); LoadImm(0, 1); EmitB(store);
        Mark(absent); GuardAddr("strict", 9); LdrU(0, 9, 0); AddImm(0, 0, 1);
        Mark(store); GuardAddr("policy", 9); StrU(0, 9, 0);
        Mark(cached); SubImm(0, 0, 1); GuardReturn(16);

        GuardFrame("_zan_rt_soft_is_hard", 16);
        GuardLock(); BLInternal("_zan_guard_policy_locked"); StrU(0, 31, 0);
        GuardUnlock(); LdrU(0, 31, 0); GuardReturn(16);

        GuardFrame("_zan_rt_set_strict", 16);
        GuardLock(); GuardAddr("strict", 9); LoadImm(0, 1); StrU(0, 9, 0);
        GuardUnlock(); GuardReturn(16);
    }

    void GuardEmitFail3() {
        // Frame: varargs[0..31], file32,line40,col48,msg56, buf[64..1463].
        GuardFrame("_zan_rt_guard_fail3", 1472);
        StrU(0, 31, 32);
        E4(0x2A0103E1); // mov w1,w1: unsigned arguments ignore upper 32 bits
        E4(0x2A0203E2); // mov w2,w2
        StrU(1, 31, 40); StrU(2, 31, 48); StrU(3, 31, 56);
        GuardLock(); BLInternal("_zan_guard_policy_locked");
        int soft = NL(); CbzReg(0, soft);
        GuardUnlock(); LoadImm(0, 70); BLExtern("_exit");
        E4(0xD4200000); // unreachable BRK if a broken exit interposer returns
        Mark(soft);
        LdrU(0, 31, 32); int fileOk = NL(); CbnzReg(0, fileOk);
        GuardString("<unknown>", 0); Mark(fileOk); StrU(0, 31, 0);
        LdrU(0, 31, 40); StrU(0, 31, 8);
        LdrU(0, 31, 48); StrU(0, 31, 16);
        LdrU(0, 31, 56); int msgOk = NL(); CbnzReg(0, msgOk);
        GuardString("", 0); Mark(msgOk); StrU(0, 31, 24);
        GuardSp(0, 64); LoadImm(1, 1400);
        GuardString("%s:%u:%u: runtime error: %s", 2); BLExtern("_snprintf");
        E4(0x93407C00); // sxtw x0,w0: snprintf returns signed int
        int done = NL(); GuardCmpImm(0, 0); EmitBcond(13, done);
        int shortText = NL(); GuardCmpImm(0, 1399); EmitBcond(3, shortText);
        LoadImm(0, 1398); Mark(shortText);
        GuardSp(9, 64); AddRR(9, 9, 0); LoadImm(10, 10);
        E4(0x3900012A); // strb w10,[x9]
        AddImm(9, 9, 1); Strb0(9);
        // No calls during scan: x9=entry, x10=count, x11=index.
        GuardAddr("sites", 9); GuardAddr("count", 10); LdrU(10, 10, 0);
        LoadImm(11, 0);
        LdrU(0, 31, 32); LdrU(1, 31, 40); LdrU(2, 31, 48);
        int scan = NL(); int next = NL(); int insert = NL(); int report = NL();
        Mark(scan); GuardCmp(11, 10); EmitBcond(2, insert);
        LdrU(12, 9, 0); GuardCmp(12, 0); EmitBcond(1, next);
        LdrU(12, 9, 8); GuardCmp(12, 1); EmitBcond(1, next);
        LdrU(12, 9, 16); GuardCmp(12, 2); EmitBcond(0, done);
        Mark(next); AddImm(9, 9, 24); AddImm(11, 11, 1); EmitB(scan);
        Mark(insert); GuardCmpImm(10, 256); EmitBcond(2, report);
        StrU(0, 9, 0); StrU(1, 9, 8); StrU(2, 9, 16);
        AddImm(10, 10, 1); GuardAddr("count", 9); StrU(10, 9, 0);
        Mark(report);
        GuardSp(0, 64); StrU(0, 31, 0);
        GuardStderr(0); GuardString("%s", 1); BLExtern("_fprintf");
        GuardStderr(0); BLExtern("_fflush");
        GuardSp(0, 64); BLInternal("_zan_guard_append");
        Mark(done); GuardUnlock(); GuardReturn(1472);
    }

    void GuardEmitLogdir() {
        GuardFrame("_zan_guard_init_logdir", 32);
        GuardString("ZAN_LOG_DIR", 0); BLExtern("_getenv");
        int fallback = NL(); int done = NL();
        CbzReg(0, fallback); GuardByte(1, 0); CbzReg(1, fallback);
        StrU(0, 31, 0); BLExtern("_strlen");
        LoadImm(9, 4096); GuardCmp(0, 9); EmitBcond(2, fallback);
        AddImm(2, 0, 1); LdrU(1, 31, 0); GuardAddr("logdir", 0);
        BLExtern("_memcpy"); EmitB(done);
        Mark(fallback);
        GuardAddr("logdir", 0); GuardString("logs", 1); LoadImm(2, 5); BLExtern("_memcpy");
        GuardString("/proc/self/exe", 0); GuardAddr("logdir", 1);
        LoadImm(2, 4090); BLExtern("_readlink");
        GuardCmpImm(0, 0); EmitBcond(13, done);
        GuardAddr("logdir", 9); AddRR(9, 9, 0); Strb0(9);
        GuardAddr("logdir", 0); LoadImm(1, 47); BLExtern("_strrchr");
        int slash = NL(); CbnzReg(0, slash);
        GuardAddr("logdir", 0); GuardString("logs", 1); LoadImm(2, 5);
        BLExtern("_memcpy"); EmitB(done);
        Mark(slash); AddImm(0, 0, 1); Strb0(0);
        // readlink cap 4090 guarantees room for "logs\0" after last slash.
        GuardString("logs", 1); LoadImm(2, 5); BLExtern("_memcpy");
        Mark(done); GuardReturn(32);
    }

    void GuardEmitPath() {
        // x0=path[4096]. Frame varargs0..31,path32,now48,tm56..111,
        // month112..127,day128..143,dir144..4239 (Darwin struct tm=56).
        GuardFrame("_zan_guard_log_path", 4240); StrU(0, 31, 32);
        GuardAddr("logdir", 9); GuardByte(9, 9);
        int initialized = NL(); CbnzReg(9, initialized);
        BLInternal("_zan_guard_init_logdir"); Mark(initialized);
        LoadImm(0, 0); BLExtern("_time"); StrU(0, 31, 48);
        GuardSp(0, 48); GuardSp(1, 56); BLExtern("_localtime_r");
        int fallback = NL(); int done = NL(); CbzReg(0, fallback);
        GuardSp(0, 112); LoadImm(1, 16); GuardString("%Y%m", 2); GuardSp(3, 56);
        BLExtern("_strftime");
        GuardSp(0, 128); LoadImm(1, 16); GuardString("%d", 2); GuardSp(3, 56);
        BLExtern("_strftime");
        GuardAddr("logdir", 0); StrU(0, 31, 0);
        GuardSp(0, 112); StrU(0, 31, 8);
        GuardSp(0, 144); LoadImm(1, 4096); GuardString("%s/%s", 2);
        BLExtern("_snprintf"); E4(0x93407C00); // sign extend before size_t compare
        LoadImm(9, 4096); GuardCmp(0, 9); EmitBcond(2, fallback);
        GuardAddr("logdir", 0); LoadImm(1, 493); BLExtern("_mkdir");
        GuardSp(0, 144); LoadImm(1, 493); BLExtern("_mkdir");
        GuardSp(0, 144); StrU(0, 31, 0); GuardSp(0, 128); StrU(0, 31, 8);
        LdrU(0, 31, 32); LoadImm(1, 4096); GuardString("%s/%s.log", 2);
        BLExtern("_snprintf"); EmitB(done);
        Mark(fallback); LdrU(0, 31, 32); GuardString("zan_soft.log", 1);
        LoadImm(2, 13); BLExtern("_memcpy");
        Mark(done); GuardReturn(4240);
    }

    void GuardEmitAppend() {
        // Frame varargs0..31,text32,FILE40,now48,tm56..111,stamp112..143,
        // path/exe144..4239. Reuse path as exe only AFTER fopen.
        GuardFrame("_zan_guard_append", 4240); StrU(0, 31, 32);
        GuardSp(0, 144); BLInternal("_zan_guard_log_path");
        GuardSp(0, 144); GuardString("ab", 1); BLExtern("_fopen");
        int done = NL(); CbzReg(0, done); StrU(0, 31, 40);
        LoadImm(1, 0); LoadImm(2, 2); BLExtern("_fseek");
        LdrU(0, 31, 40); BLExtern("_ftell");
        int stamp = NL(); CbnzReg(0, stamp);
        GuardString("/proc/self/exe", 0); GuardSp(1, 144); LoadImm(2, 4095);
        BLExtern("_readlink");
        int unknown = NL(); int header = NL();
        GuardCmpImm(0, 0); EmitBcond(13, unknown);
        GuardSp(9, 144); AddRR(9, 9, 0); Strb0(9); EmitB(header);
        Mark(unknown); GuardSp(0, 144); GuardString("<unknown>", 1);
        LoadImm(2, 10); BLExtern("_memcpy");
        Mark(header); GuardSp(0, 144); StrU(0, 31, 0);
        LdrU(0, 31, 40); GuardString("==== ZAN RUNTIME (soft) ====\nexe=%s\n", 1);
        BLExtern("_fprintf");
        Mark(stamp); LoadImm(0, 0); BLExtern("_time"); StrU(0, 31, 48);
        GuardSp(0, 48); GuardSp(1, 56); BLExtern("_localtime_r");
        // The reference ignores this second localtime_r failure (undefined
        // tm contents). Avoid consuming uninitialized memory: omit this log
        // entry and close, rather than crash in the error handler itself.
        int close = NL(); CbzReg(0, close);
        GuardSp(0, 112); LoadImm(1, 32); GuardString("%Y-%m-%d %H:%M:%S", 2);
        GuardSp(3, 56); BLExtern("_strftime");
        GuardSp(0, 112); StrU(0, 31, 0); LdrU(0, 31, 32); StrU(0, 31, 8);
        LdrU(0, 31, 40); GuardString("%s soft runtime error: %s", 1);
        BLExtern("_fprintf");
        Mark(close); LdrU(0, 31, 40); BLExtern("_fclose");
        Mark(done); GuardReturn(4240);
    }
}
