using System;
using System.Collections;
namespace Zan;

// Optional macOS arm64 host intrinsics. Integration contract (no existing
// source is changed by this file):
//  * Gen: call EmitHostRuntime() once AFTER EmitRtCore(), BEFORE EmitMainShim
//    and before RtEmitStrpool()/Patch()/BuildMachO(). All emitted functions
//    below are unconditional; host intrinsics themselves need ONLY libSystem.
//  * EmitMainShim: call EmitHostEntryArgs() AFTER saving fp/lr but BEFORE the
//    first BL or any instruction which destroys entry x0=argc, x1=argv.
//  * GenCall, GenNew: first try TryGenHostCall(e), TryGenHostNew(e); return
//    when true. Put calls before generic builtin/user-method fallback.
//  * GenExpr MemberAccess: first try TryGenHostMember(e); return when true.
//  * CallRetTy: string ht = HostCallRetTy(e); if (ht != null) return ht.
//    IsStrExpr must consult this for host calls (== "string"). StaticTyOf
//    must return HostCallRetTy for calls and "int" for HostIsLength(e).
//    HostCallRetTy also returns "StringBuilder" for new/Append/AppendLine.
//    This keeps chained calls typed without any fake user class declaration.
// Add this file explicitly to ALL compiler-stage source lists.
//
// Runtime ABI: x0..x2 inputs, x0 result; 16-byte aligned stack, fp/lr saved;
// x19..x28 NEVER touched. Values live in stack slots across libc calls; no
// condition flags survive a call. All produced strings use _zan_rt_str_alloc
// (16-byte header, magic|actual byte length at ptr-8) and are NUL terminated.
// SB payload: {byte count, byte capacity, malloc buffer}; buffer doubles,
// ToString copies into a NEW header-bearing string. No concatenation loop.
// Like the current native core, SB lifetime is process/GC-lane lifetime;
// no new ARC/destructor protocol is invented here.
// File I/O failures and OOM fail closed via puts/exit(1), never success with
// partial data. Exists is a readable-file probe, matching IR fopen semantics.
// ExeDir uses libSystem _NSGetExecutablePath + realpath (not Linux /proc).
// Directory.ListNames uses libSystem glob/globfree/strrchr. Its 65536-byte,
// newline-separated basename/truncation contract matches the existing IR shim.
// No zan_exe_dir_into/zan_dir_list_into or other C shim is required here.
// The surrounding core may still need RT_OBJS (numeric rendering/guards);
// adding this partial alone is NOT proof of C-removal completion.
partial class Ngen {
    int hostError;
    int hostRB;
    int hostWB;
    int hostNL;
    int hostTrue;
    int hostFalse;

    bool HostStatic(Node e, string cls, string name, int count) {
        if (e == null || e.kind != AK.Call() || e.a == null) { return false; }
        Node m = e.a;
        return m.kind == AK.MemberAccess() && m.a != null
            && m.a.kind == AK.Ident() && m.a.sval == cls && m.sval == name
            && e.kids.Count == count && !UserDefinesClsMember(cls, name);
    }

    bool HostIsBuilder(Node e) {
        if (e == null || FindClass("StringBuilder") != null) { return false; }
        if (e.kind == AK.NewExpr()) {
            return e.type != null && e.type.sval == "StringBuilder" && e.ival == 0;
        }
        if (e.kind == AK.Call() && e.a != null && e.a.kind == AK.MemberAccess()
                && (e.a.sval == "Append" || e.a.sval == "AppendLine")) {
            return HostIsBuilder(e.a.a);
        }
        return StaticTyOf(e) == "StringBuilder";
    }

    bool HostIsLength(Node e) {
        return e != null && e.kind == AK.MemberAccess() && e.sval == "Length"
            && HostIsBuilder(e.a);
    }

    string HostCallRetTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.NewExpr() && e.type != null && e.type.sval == "StringBuilder"
                && e.ival == 0 && FindClass("StringBuilder") == null) { return "StringBuilder"; }
        if (HostIsLength(e)) { return "int"; }
        if (HostStatic(e, "File", "ReadAllText", 1)
                || HostStatic(e, "Environment", "ArgAt", 1)
                || HostStatic(e, "Environment", "ExeDir", 0)
                || HostStatic(e, "Directory", "ListNames", 1)) { return "string"; }
        if (HostStatic(e, "File", "WriteAllText", 2)) { return "void"; }
        if (HostStatic(e, "File", "Exists", 1)) { return "bool"; }
        if (HostStatic(e, "Environment", "ArgCount", 0)) { return "int"; }
        if (e.kind == AK.Call() && e.a != null && e.a.kind == AK.MemberAccess()
                && HostIsBuilder(e.a.a)) {
            if (e.a.sval == "ToString" && e.kids.Count == 0) { return "string"; }
            if ((e.a.sval == "Append" && e.kids.Count == 1)
                    || (e.a.sval == "AppendLine" && e.kids.Count <= 1)) { return "StringBuilder"; }
        }
        return null;
    }

    bool TryGenHostNew(Node e) {
        if (e.type == null || e.type.sval != "StringBuilder" || e.ival != 0
                || FindClass("StringBuilder") != null) { return false; }
        if (e.kids.Count != 0) {
            diags.Error("ngen host: StringBuilder constructor requires zero arguments", e.line, e.col);
        } else { BLInternal("_zan_host_sb_new"); }
        return true;
    }

    bool TryGenHostMember(Node e) {
        if (!HostIsLength(e)) { return false; }
        GenExpr(e.a);
        LdrU(0, 0, 0);
        return true;
    }

    void HostCallArgs(Node e, string sym) {
        int i = 0;
        while (i < e.kids.Count) {
            GenExpr(e.kids[i]);
            E4(0xF81F0FE0); // push x0, 16 bytes
            i = i + 1;
        }
        i = e.kids.Count - 1;
        while (i >= 0) { E4(0xF84107E0 | i); i = i - 1; }
        BLInternal(sym);
    }

    // Render supported scalar Append arguments just as IR's ToCStr does.
    // Strings are already byte pointers; never stringify an untyped pointer.
    void HostStringArg(Node a) {
        bool str = IsStrExpr(a) || HostCallRetTy(a) == "string";
        GenExpr(a);
        if (str) { return; }
        if (IsBoolExpr(a)) {
            int no = NL(); int done = NL();
            CbzReg(0, no);
            LoadStr(hostTrue, 0); EmitB(done);
            Mark(no); LoadStr(hostFalse, 0); Mark(done);
        } else if (IsCharExpr(a)) { BLInternal("_zan_rt_chrstr"); }
        else if (IsDblExpr(a)) { BLInternal("_zan_rt_dbl2str"); }
        else if (IsUlongExpr(a)) { BLInternal("_zan_rt_uint2str"); }
        else {
            string ty = StaticTyOf(a);
            if (a.kind == AK.IntLit() || ty == "int" || ty == "long"
                    || (a.kind == AK.Binary() && !IsStrExpr(a))) {
                BLInternal("_zan_rt_int2str");
            } else {
                diags.Error("ngen host: unsupported StringBuilder Append argument type", a.line, a.col);
            }
        }
    }

    bool TryGenHostCall(Node e) {
        if (HostStatic(e, "File", "ReadAllText", 1)) { HostCallArgs(e, "_zan_host_read"); return true; }
        if (HostStatic(e, "File", "WriteAllText", 2)) { HostCallArgs(e, "_zan_host_write"); return true; }
        if (HostStatic(e, "File", "Exists", 1)) { HostCallArgs(e, "_zan_host_exists"); return true; }
        if (HostStatic(e, "Environment", "ArgCount", 0)) { BLInternal("_zan_host_argc"); return true; }
        if (HostStatic(e, "Environment", "ArgAt", 1)) { HostCallArgs(e, "_zan_host_argat"); return true; }
        if (HostStatic(e, "Environment", "ExeDir", 0)) { BLInternal("_zan_host_exedir"); return true; }
        if (HostStatic(e, "Directory", "ListNames", 1)) { HostCallArgs(e, "_zan_host_dir"); return true; }
        if (e.a == null || e.a.kind != AK.MemberAccess() || !HostIsBuilder(e.a.a)) { return false; }
        string name = e.a.sval;
        if (name == "ToString" && e.kids.Count == 0) {
            GenExpr(e.a.a); BLInternal("_zan_host_sb_string"); return true;
        }
        if ((name == "Append" && e.kids.Count == 1)
                || (name == "AppendLine" && e.kids.Count <= 1)) {
            GenExpr(e.a.a);
            if (e.kids.Count == 1) {
                E4(0xF81F0FE0);
                HostStringArg(e.kids[0]);
                MovRR(1, 0); E4(0xF84107E0);
                BLInternal("_zan_host_sb_append");
            }
            if (name == "AppendLine") {
                LoadStr(hostNL, 1);
                BLInternal("_zan_host_sb_append");
            }
            return true;
        }
        diags.Error("ngen host: unsupported StringBuilder method or arity", e.line, e.col);
        return true;
    }

    // Runtime helpers use a fixed 128-byte frame; slots at sp+0..120.
    // Neither code nor flags rely on scratch register values after a BL.
    void HostBegin(string sym) {
        syms.Add(new Sym(sym, txt.Count));
        RtPrologue(); AddSPImm(128, false);
    }
    void HostEnd() { AddSPImm(128, true); RtEpilogue(); }
    void HostSave(int reg, int slot) { StrU(reg, 31, slot * 8); }
    void HostLoad(int reg, int slot) { LdrU(reg, 31, slot * 8); }
    void HostCmp(int a, int b) { E4(0xEB00001F | (b << 16) | (a << 5)); }
    // x0 string, x1 byte length. Preserve both; clobber x2/x3.
    // Native Length/indexing reads the low 32 bits at ptr-8, NOT strlen.
    void HostStamp() {
        LoadImm(2, 0x5A414E5300000000);
        E4(0xD3407C23); // ubfm x3, x1, #0, #31
        E4(0xAA030042); // orr x2, x2, x3
        RtStur(2, 0, -8);
    }
    // Each failure site supplies a stable subsystem.operation label. The
    // failure runtime takes x0=message; it never inspects stale errno/flags.
    void HostFailAt(string site) {
        LoadStr(InternStr("zan host: " + site), 0);
        BLInternal("_zan_host_fail");
    }
    void HostNonzero(int reg, string site) {
        int ok = NL(); CbnzReg(reg, ok);
        HostFailAt(site); Mark(ok);
    }
    void HostZero32(string site) {
        int ok = NL();
        E4(0x7100001F); // cmp w0, #0 (C int results, NOT x0)
        EmitBcond(0, ok); HostFailAt(site); Mark(ok);
    }
    void HostEqual(int a, int b, string site) {
        int ok = NL(); HostCmp(a, b); EmitBcond(0, ok);
        HostFailAt(site); Mark(ok);
    }
    // slot 7 retains the original File path across fopen. Print delimiters
    // on separate lines so embedded/trailing LF in a malformed path is visible.
    void HostFileOpened(string site) {
        int ok = NL(); CbnzReg(0, ok);
        LoadStr(InternStr("zan host: failed File path begins >>>"), 0); BLExtern("_puts");
        HostLoad(0, 7); BLExtern("_puts");
        LoadStr(InternStr("<<< failed File path ends"), 0); BLExtern("_puts");
        HostFailAt(site); Mark(ok);
    }

    void EmitHostEntryArgs() {
        LoadSymRef("l_.g.host_argc", 9); StrU(0, 9, 0);
        LoadSymRef("l_.g.host_argv", 9); StrU(1, 9, 0);
    }

    void EmitHostRuntime() {
        hostError = InternStr("zan host: I/O, allocation or argument failure");
        hostRB = InternStr("rb"); hostWB = InternStr("wb");
        hostNL = InternStr("\n"); hostTrue = InternStr("true"); hostFalse = InternStr("false");
        dglbs.Add(new DGlob("host_argc", 8, dataLen)); dataLen = dataLen + 8;
        dglbs.Add(new DGlob("host_argv", 8, dataLen)); dataLen = dataLen + 8;
        HostBegin("_zan_host_fail");
        // x0 is the per-site diagnostic supplied by HostFailAt.
        BLExtern("_puts");
        LoadImm(0, 1); BLExtern("_exit"); E4(0xD4200000); // brk if exit returns
        HostEnd();
        HostEmitCopy(); HostEmitArgs(); HostEmitFiles(); HostEmitPaths(); HostEmitSb();
    }

    // x0 = C string, x1 = byte count; copy to an owning native string.
    void HostEmitCopy() {
        HostBegin("_zan_host_copy");
        HostSave(0, 0); HostSave(1, 1);
        AddImm(0, 1, 1); BLInternal("_zan_rt_str_alloc"); HostSave(0, 2);
        HostLoad(1, 0); HostLoad(2, 1); BLExtern("_memcpy");
        HostLoad(0, 2); HostLoad(1, 1); AddRR(2, 0, 1); Strb0(2); HostStamp();
        HostEnd();
    }

    void HostEmitArgs() {
        HostBegin("_zan_host_argc");
        LoadSymRef("l_.g.host_argc", 9); LdrU(0, 9, 0);
        SubImm(0, 0, 1); HostEnd();
        HostBegin("_zan_host_argat");
        // C host irgen_call.c: idx >= 0 && unsigned(idx + 1) < argc.
        // Check BEFORE adding one: negative indices and INT64_MAX must not
        // wrap into a valid argv slot. Out-of-range returns a stamped empty
        // string, not a diagnostic, a null pointer, or argv[0].
        int empty = NL(); int done = NL();
        LoadImm(1, 0); HostCmp(0, 1); EmitBcond(11, empty); // signed lt
        AddImm(0, 0, 1);
        LoadSymRef("l_.g.host_argc", 9); LdrU(1, 9, 0);
        HostCmp(0, 1); EmitBcond(2, empty); // unsigned hs
        LoadSymRef("l_.g.host_argv", 9); LdrU(1, 9, 0);
        E4(0xF8607820); // ldr x0, [x1, x0, lsl #3]
        HostSave(0, 0); BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 0); BLInternal("_zan_host_copy"); EmitB(done);
        Mark(empty); LoadStr(emptyIdx, 0);
        Mark(done); HostEnd();
    }

    void HostEmitFiles() {
        HostBegin("_zan_host_exists");
        LoadStr(hostRB, 1); BLExtern("_fopen");
        int missing = NL(); int done = NL(); CbzReg(0, missing);
        BLExtern("_fclose"); LoadImm(0, 1); EmitB(done);
        Mark(missing); LoadImm(0, 0); Mark(done); HostEnd();

        HostBegin("_zan_host_read");
        HostSave(0, 7);
        LoadStr(hostRB, 1); BLExtern("_fopen"); HostFileOpened("file.read.fopen"); HostSave(0, 0);
        LoadImm(1, 0); LoadImm(2, 2); BLExtern("_fseek"); HostZero32("file.read.seek_end");
        HostLoad(0, 0); BLExtern("_ftell");
        LoadImm(1, 0); HostCmp(0, 1);
        int sizeOK = NL(); EmitBcond(10, sizeOK); HostFailAt("file.read.ftell"); Mark(sizeOK);
        HostSave(0, 1);
        HostLoad(0, 0); LoadImm(1, 0); LoadImm(2, 0); BLExtern("_fseek"); HostZero32("file.read.seek_start");
        HostLoad(0, 1); AddImm(0, 0, 1); BLInternal("_zan_rt_str_alloc"); HostSave(0, 2);
        LoadImm(1, 1); HostLoad(2, 1); HostLoad(3, 0); BLExtern("_fread");
        HostLoad(1, 1); HostEqual(0, 1, "file.read.short_read");
        HostLoad(0, 2); HostLoad(1, 1); AddRR(2, 0, 1); Strb0(2); HostStamp();
        HostLoad(0, 0); BLExtern("_fclose"); HostZero32("file.read.fclose");
        HostLoad(0, 2); HostEnd();

        HostBegin("_zan_host_write");
        HostSave(0, 7);
        HostSave(1, 1); LoadStr(hostWB, 1); BLExtern("_fopen");
        HostFileOpened("file.write.fopen"); HostSave(0, 0);
        HostLoad(0, 1); BLExtern("_strlen"); HostSave(0, 2);
        MovRR(2, 0); HostLoad(0, 1); LoadImm(1, 1); HostLoad(3, 0); BLExtern("_fwrite");
        HostLoad(1, 2); HostEqual(0, 1, "file.write.short_write");
        HostLoad(0, 0); BLExtern("_fclose"); HostZero32("file.write.fclose"); LoadImm(0, 0); HostEnd();
    }

    void HostEmitPaths() {
        HostBegin("_zan_host_dir");
        HostSave(0, 0); LoadImm(0, 65536); BLInternal("_zan_rt_str_alloc"); HostSave(0, 1);
        Strb0(0);
        // Darwin arm64 glob_t: size 88, gl_pathc@0, gl_pathv@32.
        // Verified against MacOSX26.2.sdk/usr/include/glob.h and clang
        // _Static_assert(sizeof/offsetof); symbols verified as _glob/_globfree.
        // The struct is heap allocated, separate from our fixed stack frame.
        LoadImm(0, 1); LoadImm(1, 88); BLExtern("_calloc"); HostNonzero(0, "dir.glob_state.calloc"); HostSave(0, 2);
        MovRR(3, 0); HostLoad(0, 0); LoadImm(1, 0); LoadImm(2, 0); BLExtern("_glob");
        int cleanup = NL(); int loop = NL(); int haveBase = NL();
        E4(0x7100001F); EmitBcond(1, cleanup); // any glob error -> empty, matching shim
        LoadImm(0, 0); HostSave(0, 3); HostSave(0, 4); // i, output count
        Mark(loop);
        HostLoad(0, 2); LdrU(1, 0, 0); HostLoad(2, 3); HostCmp(2, 1); EmitBcond(2, cleanup);
        LdrU(0, 0, 32);
        E4(0xF8627800); // ldr x0, [x0, x2, lsl #3]
        HostSave(0, 5); LoadImm(1, 47); BLExtern("_strrchr");
        CbzReg(0, haveBase); AddImm(0, 0, 1); HostSave(0, 5); Mark(haveBase);
        HostLoad(0, 5); BLExtern("_strlen"); HostSave(0, 6);
        HostLoad(1, 4); AddRR(2, 0, 1); AddImm(2, 2, 2); LoadImm(3, 65536);
        HostCmp(2, 3); EmitBcond(8, cleanup); // keep room for newline + NUL
        HostLoad(0, 1); AddRR(0, 0, 1); HostLoad(1, 5); HostLoad(2, 6); BLExtern("_memcpy");
        HostLoad(0, 1); HostLoad(1, 4); HostLoad(2, 6); AddRR(1, 1, 2); AddRR(2, 0, 1);
        LoadImm(3, 10); E4(0x39000043); // strb w3, [x2]
        AddImm(2, 2, 1); Strb0(2); AddImm(1, 1, 1); HostSave(1, 4);
        HostLoad(0, 3); AddImm(0, 0, 1); HostSave(0, 3); EmitB(loop);
        Mark(cleanup);
        HostLoad(0, 2); BLExtern("_globfree"); HostLoad(0, 2); BLExtern("_free");
        HostLoad(0, 1); BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 1); HostStamp(); HostEnd();

        HostBegin("_zan_host_exedir");
        // Query required uint32 capacity, then retry with an allocated buffer.
        LoadImm(0, 0); HostSave(0, 0); AddImm(1, 31, 0);
        BLExtern("__NSGetExecutablePath");
        E4(0xB94003E0); // ldr w0, [sp] (size is uint32)
        HostNonzero(0, "exedir.query_size"); BLExtern("_malloc"); HostNonzero(0, "exedir.path.malloc"); HostSave(0, 1);
        AddImm(1, 31, 0); BLExtern("__NSGetExecutablePath"); HostZero32("exedir.get_path");
        HostLoad(0, 1); LoadImm(1, 0); BLExtern("_realpath"); HostNonzero(0, "exedir.realpath"); HostSave(0, 2);
        HostLoad(0, 1); BLExtern("_free");
        HostLoad(0, 2); LoadImm(1, 47); BLExtern("_strrchr"); HostNonzero(0, "exedir.dirname");
        HostLoad(1, 2); E4(0xCB010002); // sub x2, x0, x1 (dirname length)
        int nonroot = NL(); CbnzReg(2, nonroot); LoadImm(2, 1); Mark(nonroot);
        MovRR(0, 1); MovRR(1, 2); BLInternal("_zan_host_copy"); HostSave(0, 3);
        HostLoad(0, 2); BLExtern("_free"); HostLoad(0, 3); HostEnd();
    }

    void HostEmitSb() {
        HostBegin("_zan_host_sb_new");
        LoadImm(0, 40); LoadImm(1, 0); BLInternal("_zan_rt_alloc");
        // Core alloc is zero-filled, 40 = 16-byte header + 24-byte payload.
        HostEnd();

        HostBegin("_zan_host_sb_append");
        HostSave(0, 0); HostSave(1, 1);
        int empty = NL(); CbzReg(1, empty); // null append is empty
        MovRR(0, 1); BLExtern("_strlen"); HostSave(0, 2);
        HostLoad(1, 0); LdrU(2, 1, 0); HostSave(2, 3);
        // need=count+len, reject carry and signed overflow before allocation.
        E4(0xAB020000); // adds x0, x0, x2
        int sumOK = NL(); EmitBcond(3, sumOK); HostFailAt("sb.append.size_carry"); Mark(sumOK);
        LoadImm(1, 0); HostCmp(0, 1);
        int positive = NL(); EmitBcond(10, positive); HostFailAt("sb.append.size_signed_overflow"); Mark(positive);
        HostSave(0, 4);
        HostLoad(1, 0); LdrU(2, 1, 8); HostCmp(0, 2);
        int enough = NL(); EmitBcond(9, enough); // unsigned ls
        // capacity = max(need, cap*2, 64); cap <= INT64_MAX / 2 else need.
        LoadImm(3, 4611686018427387903); HostCmp(2, 3);
        int useNeed = NL(); EmitBcond(8, useNeed);
        AddRR(2, 2, 2); HostCmp(2, 0); EmitBcond(2, useNeed);
        MovRR(2, 0);
        Mark(useNeed);
        // Overflow branch above must select need, not retain oversized cap.
        HostCmp(2, 3); int bounded = NL(); EmitBcond(9, bounded);
        HostLoad(2, 4); Mark(bounded);
        LoadImm(3, 64); HostCmp(2, 3); int minOK = NL(); EmitBcond(2, minOK);
        MovRR(2, 3); Mark(minOK); HostSave(2, 5);
        HostLoad(0, 0); LdrU(0, 0, 16); MovRR(1, 2); BLExtern("_realloc"); HostNonzero(0, "sb.grow.realloc");
        HostLoad(1, 0); StrU(0, 1, 16); HostLoad(2, 5); StrU(2, 1, 8);
        Mark(enough);
        HostLoad(0, 0); LdrU(0, 0, 16); HostLoad(1, 3); AddRR(0, 0, 1);
        HostLoad(1, 1); HostLoad(2, 2);
        int noCopy = NL(); CbzReg(2, noCopy); BLExtern("_memcpy"); Mark(noCopy);
        HostLoad(0, 0); HostLoad(1, 4); StrU(1, 0, 0);
        Mark(empty); HostLoad(0, 0); HostEnd();

        HostBegin("_zan_host_sb_string");
        LdrU(1, 0, 0); LdrU(0, 0, 16);
        // Empty builders have a null buffer: avoid even a zero-byte memcpy
        // with null by substituting a valid empty literal.
        int hasData = NL(); CbnzReg(0, hasData); LoadStr(emptyIdx, 0); Mark(hasData);
        BLInternal("_zan_host_copy"); HostEnd();
    }
}
