using System;
using System.Collections;
namespace Zan;

// Optional macOS arm64 host intrinsics. Integration contract (no existing
// source is changed by this file):
//  * Gen: call EmitHostRuntime() once AFTER EmitRtCore(), BEFORE EmitMainShim
//    and before RtEmitStrpool()/Patch()/BuildMachO(). All emitted functions
//    below are unconditional; host intrinsics themselves need ONLY libSystem.
//  * EmitMainShim: call EmitHostEntryArgs() AFTER saving fp/lr but BEFORE the
//    first BL or any instruction which destroys entry x0=argc, x1=argv.
//  * GenCall, GenNew: first try TryGenHostCall(e), TryGenHostNew(e); return
//    when true. Put calls before generic builtin/user-method fallback.
//  * GenExpr MemberAccess: first try TryGenHostMember(e); return when true.
//  * CallRetTy: string ht = HostCallRetTy(e); if (ht != null) return ht.
//    IsStrExpr must consult this for host calls (== "string"). StaticTyOf
//    must return HostCallRetTy for calls and "int" for HostIsLength(e).
//    HostCallRetTy also returns "StringBuilder" for new/Append/AppendLine.
//    This keeps chained calls typed without any fake user class declaration.
// Add this file explicitly to ALL compiler-stage source lists.
//
// Runtime ABI: x0..x2 inputs, x0 result; 16-byte aligned stack, fp/lr saved;
// x19..x28 NEVER touched. Values live in stack slots across libc calls; no
// condition flags survive a call. All produced strings use _zan_rt_str_alloc
// (16-byte header, magic|actual byte length at ptr-8) and are NUL terminated.
// SB payload: {byte count, byte capacity, malloc buffer}; buffer doubles,
// ToString copies into a NEW header-bearing string. No concatenation loop.
// Like the current native core, SB lifetime is process/GC-lane lifetime;
// no new ARC/destructor protocol is invented here.
// File I/O failures and OOM fail closed via puts/exit(1), never success with
// partial data. Exists is a readable-file probe, matching IR fopen semantics.
// ExeDir uses libSystem _NSGetExecutablePath + realpath (not Linux /proc).
// Directory.ListNames uses libSystem glob/globfree/strrchr. Its 65536-byte,
// newline-separated basename/truncation contract matches the existing IR shim.
// No zan_exe_dir_into/zan_dir_list_into or other C shim is required here.
// The surrounding core may still need RT_OBJS (numeric rendering/guards);
// adding this partial alone is NOT proof of C-removal completion.
partial class Ngen {
    int hostError;
    int hostRB;
    int hostWB;
    int hostNL;
    int hostTrue;
    int hostFalse;

    bool HostStatic(Node e, string cls, string name, int count) {
        if (e == null || e.kind != AK.Call() || e.a == null) { return false; }
        Node m = e.a;
        return m.kind == AK.MemberAccess() && m.a != null
            && m.a.kind == AK.Ident() && m.a.sval == cls && m.sval == name
            && e.kids.Count == count && !UserDefinesClsMember(cls, name);
    }

    bool HostIsBuilder(Node e) {
        if (e == null || FindClass("StringBuilder") != null) { return false; }
        if (e.kind == AK.NewExpr()) {
            return e.type != null && e.type.sval == "StringBuilder" && e.ival == 0;
        }
        if (e.kind == AK.Call() && e.a != null && e.a.kind == AK.MemberAccess()
                && (e.a.sval == "Append" || e.a.sval == "AppendLine")) {
            return HostIsBuilder(e.a.a);
        }
        return StaticTyOf(e) == "StringBuilder";
    }

    bool HostIsLength(Node e) {
        return e != null && e.kind == AK.MemberAccess() && e.sval == "Length"
            && HostIsBuilder(e.a);
    }

    // cheap name gate: could (name, argc) name a DateTime instance member?
    // Host arms MUST gate on this before StaticTyOf(e.a.a): typing the
    // receiver re-walks fluent-chain prefixes at every level (exponential in
    // chain length) whenever the stdlib class is absent from the compile.
    bool IsDateTimeMemberName(string n, int argc) {
        if (argc == 0) {
            return n == "ToString" || n == "ToDateString" || n == "ToTimeString"
                || n == "ToUnixSeconds" || n == "Year" || n == "Month"
                || n == "Day" || n == "Hour" || n == "Minute" || n == "Second"
                || n == "DayOfWeek";
        }
        if (argc == 1) {
            return n == "AddSeconds" || n == "AddMinutes" || n == "AddHours"
                || n == "AddDays" || n == "Equals" || n == "IsBefore" || n == "IsAfter";
        }
        return false;
    }

    string HostCallRetTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.NewExpr() && e.type != null && e.type.sval == "StringBuilder"
                && e.ival == 0 && FindClass("StringBuilder") == null) { return "StringBuilder"; }
        if (HostIsLength(e)) { return "int"; }
        if (HostStatic(e, "File", "ReadAllText", 1)
                || HostStatic(e, "Environment", "ArgAt", 1)
                || HostStatic(e, "Environment", "ExeDir", 0)
                || HostStatic(e, "Directory", "ListNames", 1)) { return "string"; }
        if (HostStatic(e, "File", "WriteAllText", 2)) { return "void"; }
        if (HostStatic(e, "File", "Exists", 1)) { return "bool"; }
        if (HostStatic(e, "Environment", "ArgCount", 0)) { return "int"; }
        if (HostStatic(e, "Path", "GetFileName", 1)
                || HostStatic(e, "Path", "GetExtension", 1)
                || HostStatic(e, "Path", "GetDirectoryName", 1)
                || HostStatic(e, "Path", "GetFileNameWithoutExtension", 1)
                || HostStatic(e, "Path", "ChangeExtension", 2)
                || HostStatic(e, "Path", "Combine", 2)
                || HostStatic(e, "Path", "GetTempPath", 0)) { return "string"; }
        if (HostStatic(e, "Path", "HasExtension", 1)) { return "bool"; }
        if (HostStatic(e, "DateTime", "FromUnixSeconds", 1)
                || HostStatic(e, "DateTime", "FromDate", 3)
                || HostStatic(e, "DateTime", "FromParts", 6)) { return "DateTime"; }
        if (HostStatic(e, "DateTime", "DaysFromCivil", 3)
                || HostStatic(e, "DateTime", "DaysInMonth", 2)) { return "int"; }
        if (HostStatic(e, "DateTime", "IsLeapYear", 1)) { return "bool"; }
        // DateTime instance members (stdlib class absent from the compile)
        if (e.kind == AK.Call() && e.a != null && e.a.kind == AK.MemberAccess()
                && e.a.a != null && FindClass("DateTime") == null
                && IsDateTimeMemberName(e.a.sval, e.kids.Count)
                && StaticTyOf(e.a.a) == "DateTime"
                && !UserDefinesClsMember("DateTime", e.a.sval)) {
            string mn2 = e.a.sval;
            if ((mn2 == "ToString" || mn2 == "ToDateString"
                    || mn2 == "ToTimeString") && e.kids.Count == 0) {
                return "string";
            }
            if (mn2 == "ToUnixSeconds" && e.kids.Count == 0) { return "long"; }
            if ((mn2 == "Year" || mn2 == "Month" || mn2 == "Day"
                    || mn2 == "Hour" || mn2 == "Minute" || mn2 == "Second"
                    || mn2 == "DayOfWeek") && e.kids.Count == 0) { return "int"; }
            if ((mn2 == "AddSeconds" || mn2 == "AddMinutes"
                    || mn2 == "AddHours" || mn2 == "AddDays")
                    && e.kids.Count == 1) { return "DateTime"; }
            if ((mn2 == "Equals" || mn2 == "IsBefore" || mn2 == "IsAfter")
                    && e.kids.Count == 1) { return "bool"; }
        }
        if (e.kind == AK.Call() && e.a != null && e.a.kind == AK.MemberAccess()
                && (e.a.sval == "ToString" || e.a.sval == "Append"
                    || e.a.sval == "AppendLine")
                && HostIsBuilder(e.a.a)) {
            if (e.a.sval == "ToString" && e.kids.Count == 0) { return "string"; }
            if ((e.a.sval == "Append" && e.kids.Count == 1)
                    || (e.a.sval == "AppendLine" && e.kids.Count <= 1)) { return "StringBuilder"; }
        }
        // ---- threading / process / environment statics ----
        if (HostStatic(e, "Thread", "Sleep", 1)) { return "void"; }
        if (HostStatic(e, "Thread", "Start", 1)) { return "bool"; }
        if (HostStatic(e, "Thread", "CurrentId", 0)) { return "long"; }
        if (HostStatic(e, "ProcessList", "SelfPid", 0)) { return "int"; }
        if (HostStatic(e, "Interop", "getenv", 1)) { return "string"; }
        // ---- dynamic library loading (System.Interop) ----
        if (HostStatic(e, "Interop", "Load", 1)
                || HostStatic(e, "Interop", "Symbol", 2)) { return "long"; }
        if (HostStatic(e, "Interop", "LastError", 0)) { return "string"; }
        if (HostStatic(e, "Interop", "Unload", 1)) { return "void"; }
        // ---- raw memory intrinsics (System.Runtime.InteropServices) ----
        if (HostStatic(e, "NativeMemory", "Alloc", 1)
                || HostStatic(e, "NativeMemory", "Sha256", 2)
                || HostStatic(e, "NativeMemory", "FindNotAnyOf", 4)) { return "long"; }
        // Crc32 is typed by its stdlib extern decl (int) and CallStaticNg
        // skips the sext for it; no ret-ty arm here -- with the stdlib
        // pulled this gate never fires anyway.
        if (HostStatic(e, "NativeMemory", "GetString", 3)) { return "string"; }
        if (HostStatic(e, "NativeMemory", "Free", 1)
                || HostStatic(e, "NativeMemory", "PutString", 4)) { return "void"; }
        // ---- current working directory ----
        if (HostStatic(e, "Directory", "GetCurrentDirectory", 0)) { return "string"; }
        // ---- numeric TryParse with an out slot ----
        if ((HostStatic(e, "int", "TryParse", 2)
                || HostStatic(e, "long", "TryParse", 2))) { return "bool"; }
        // ---- AtomicInt instance members (stdlib class absent) ----
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.a != null) {
            // name gate BEFORE typing the receiver (chain-prefix re-walks
            // compound exponentially when the stdlib class is absent)
            string an = e.a.sval;
            if ((an == "Load" || an == "Add" || an == "Increment"
                    || an == "Decrement" || an == "Exchange"
                    || an == "CompareExchange" || an == "Store")
                    && HostAtomicRecvTy(e.a.a) != null
                    && !UserDefinesClsMember("AtomicInt", an)) {
                if ((an == "Load" || an == "Add" || an == "Increment"
                        || an == "Decrement" || an == "Exchange"
                        || an == "CompareExchange") && (e.kids.Count == 0
                        || e.kids.Count == 1 || (an == "CompareExchange"
                            && e.kids.Count == 2))) { return "long"; }
                if (an == "Store" && e.kids.Count == 1) { return "void"; }
            }
        }
        if (HostStatic(e, "KnownFolders", "Home", 0)
                || HostStatic(e, "KnownFolders", "Temp", 0)
                || HostStatic(e, "KnownFolders", "AppData", 0)
                || HostStatic(e, "KnownFolders", "GetEnv", 1)
                || HostStatic(e, "KnownFolders", "Expand", 1)) { return "string"; }
        if (HostStatic(e, "KnownFolders", "SetEnv", 2)) { return "void"; }
        // ---- file system statics ----
        if (HostStatic(e, "Directory", "Exists", 1)) { return "bool"; }
        if (HostStatic(e, "Directory", "CreateDirectory", 1)
                || HostStatic(e, "Directory", "Delete", 1)
                || HostStatic(e, "File", "Delete", 1)) { return "void"; }
        if (HostStatic(e, "Directory", "GetFiles", 1)
                || HostStatic(e, "Directory", "GetDirectories", 1)
                || HostStatic(e, "Directory", "GetPaths", 1)
                || HostStatic(e, "Directory", "GetDirectoryPaths", 1)) { return "List<string>"; }
        if (HostStatic(e, "Directory", "CreateDirectoryRecursive", 1)) { return "void"; }
        if (HostStatic(e, "Directory", "DeleteRecursive", 1)) { return "bool"; }
        if (HostStatic(e, "Stopwatch", "Frequency", 0)
                || HostStatic(e, "Stopwatch", "GetMilliseconds", 0)) { return "long"; }
        if (HostStatic(e, "Semaphore", "Create", 2)) { return "string"; }
        if (HostStatic(e, "Semaphore", "Wait", 1)
                || HostStatic(e, "Semaphore", "Release", 1)
                || HostStatic(e, "Semaphore", "Destroy", 1)) { return "void"; }
        // ---- Stopwatch / Timer / FileInfo instance members (stdlib classes
        // absent from the compile) ----
        if (e.kind == AK.Call() && e.a != null && e.a.kind == AK.MemberAccess()
                && e.a.a != null) {
            string mn3 = e.a.sval;
            int n3 = e.kids.Count;
            if (FindClass("Stopwatch") == null
                    && (mn3 == "Start" || mn3 == "Stop" || mn3 == "Reset"
                        || mn3 == "ElapsedMilliseconds")
                    && StaticTyOf(e.a.a) == "Stopwatch"
                    && !UserDefinesClsMember("Stopwatch", mn3)) {
                if ((mn3 == "Start" || mn3 == "Stop" || mn3 == "Reset")
                        && n3 == 0) { return "void"; }
                if (mn3 == "ElapsedMilliseconds" && n3 == 0) { return "double"; }
            }
            if (FindClass("Timer") == null && (mn3 == "Start" || mn3 == "Stop")
                    && StaticTyOf(e.a.a) == "Timer"
                    && !UserDefinesClsMember("Timer", mn3)) {
                if (mn3 == "Start" && n3 == 0) { return "bool"; }
                if (mn3 == "Stop" && n3 == 0) { return "void"; }
            }
            if (FindClass("FileInfo") == null
                    && (mn3 == "Exists" || mn3 == "IsDirectory" || mn3 == "IsReadOnly"
                        || mn3 == "NewerThan" || mn3 == "SetReadOnly" || mn3 == "Length"
                        || mn3 == "LastWriteTime" || mn3 == "CreationTime" || mn3 == "FullName")
                    && StaticTyOf(e.a.a) == "FileInfo"
                    && !UserDefinesClsMember("FileInfo", mn3)) {
                if ((mn3 == "Exists" || mn3 == "IsDirectory" || mn3 == "IsReadOnly"
                        || mn3 == "NewerThan" || mn3 == "SetReadOnly") && n3 <= 1) { return "bool"; }
                if ((mn3 == "Length" || mn3 == "LastWriteTime" || mn3 == "CreationTime")
                        && n3 == 0) { return "long"; }
                if (mn3 == "FullName" && n3 == 0) { return "string"; }
            }
        }
        // FileInfo static shortcuts
        if (HostStatic(e, "FileInfo", "GetLength", 1)) { return "long"; }
        if (HostStatic(e, "FileInfo", "GetLastWriteTime", 1)) { return "long"; }
        string et = HostExtRetTy(e);
        if (et != null) { return et; }
        return null;
    }

    bool TryGenHostNew(Node e) {
        if (e.type == null || e.ival != 0) { return false; }
        string hcls = e.type.sval;
        // Stopwatch: {start@0, accumulated@8, running@16}, zero-filled.
        if (hcls == "Stopwatch" && FindClass("Stopwatch") == null) {
            if (e.kids.Count != 0) {
                diags.Error("ngen host: Stopwatch constructor requires zero arguments", e.line, e.col);
                return true;
            }
            LoadImm(0, 32); LoadImm(1, 0);
            BLInternal("_zan_rt_alloc");
            return true;
        }
        // Timer: {intervalMs@0, closure@8, running@16, pthread@24}. The
        // callback argument is a method group; GenExpr lowers it to the
        // delegate {thunk, env} pair via the standard untargeted conversion.
        if (hcls == "Timer" && FindClass("Timer") == null) {
            if (e.kids.Count != 2) {
                diags.Error("ngen host: Timer constructor requires (intervalMs, callback)", e.line, e.col);
                return true;
            }
            GenExpr(e.kids[0]);
            ExtPush(0);
            GenExpr(e.kids[1]);
            ExtPush(0);
            LoadImm(0, 40); LoadImm(1, 0);
            BLInternal("_zan_rt_alloc");
            ExtPop(1);                           // closure
            StrU(1, 0, 8);
            ExtPop(1);                           // interval
            StrU(1, 0, 0);
            return true;
        }
        // AtomicInt: {long value@0}, seeded with the constructor argument.
        if (hcls == "AtomicInt" && FindClass("AtomicInt") == null) {
            if (e.kids.Count != 1) {
                diags.Error("ngen host: AtomicInt constructor requires one initial value", e.line, e.col);
                return true;
            }
            GenExpr(e.kids[0]);
            ExtPush(0);
            LoadImm(0, 8); LoadImm(1, 0);
            BLInternal("_zan_rt_alloc");
            ExtPop(1);
            StrU(1, 0, 0);
            return true;
        }
        // FileInfo: {path@0} — methods re-stat on every call.
        if (hcls == "FileInfo" && FindClass("FileInfo") == null) {
            if (e.kids.Count != 1) {
                diags.Error("ngen host: FileInfo constructor requires one path argument", e.line, e.col);
                return true;
            }
            GenExpr(e.kids[0]);
            ExtPush(0);
            LoadImm(0, 24); LoadImm(1, 0);
            BLInternal("_zan_rt_alloc");
            ExtPop(1);
            StrU(1, 0, 0);
            return true;
        }
        if (hcls != "StringBuilder" || FindClass("StringBuilder") != null) { return false; }
        if (e.kids.Count != 0) {
            diags.Error("ngen host: StringBuilder constructor requires zero arguments", e.line, e.col);
        } else { BLInternal("_zan_host_sb_new"); }
        return true;
    }

    bool TryGenHostMember(Node e) {
        if (TryGenHostExtMember(e)) { return true; }
        if (!HostIsLength(e)) { return false; }
        GenExpr(e.a);
        LdrU(0, 0, 0);
        return true;
    }

    void HostCallArgs(Node e, string sym) {
        int i = 0;
        while (i < e.kids.Count) {
            GenExpr(e.kids[i]);
            E4(0xF81F0FE0); // push x0, 16 bytes
            i = i + 1;
        }
        i = e.kids.Count - 1;
        while (i >= 0) { E4(0xF84107E0 | i); i = i - 1; }
        BLInternal(sym);
    }

    // Does this subtree contain an integer literal inside arithmetic? The
    // reference compiler types bare literals as long, so any literal
    // operand promotes the enclosing node to 64-bit arithmetic; nodes
    // built only from int-typed values stay 32-bit and wrap.
    bool HostLitArith(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.IntLit()) { return true; }
        if (e.kind == AK.Unary() && e.op == TK.Minus()) { return HostLitArith(e.a); }
        if (e.kind == AK.Binary()
                && (e.op == TK.Plus() || e.op == TK.Minus() || e.op == TK.Star())) {
            return HostLitArith(e.a) || HostLitArith(e.b);
        }
        return false;
    }

    // Generate an argument for a long-typed host parameter with the
    // reference compiler's mixed-width rule: a literal operand promotes
    // the node to 64-bit (no mid-expression wrap); literal-free subtrees
    // go through the generic path unchanged.
    void HostGenI64Arg(Node e) {
        if (e == null) { GenExpr(e); return; }
        if (e.kind == AK.IntLit()) { LoadImm(0, e.ival); return; }
        if (e.kind == AK.Unary() && e.op == TK.Minus() && e.a != null
                && e.a.kind == AK.IntLit()) { LoadImm(0, 0 - e.a.ival); return; }
        if (e.kind == AK.Binary() && (e.op == TK.Star() || e.op == TK.Plus()
                || e.op == TK.Minus()) && HostLitArith(e)) {
            if (HostLitArith(e.a)) { HostGenI64Arg(e.a); } else { GenExpr(e.a); }
            E4(0xF81F0FE0);                        // push x0
            if (HostLitArith(e.b)) { HostGenI64Arg(e.b); } else { GenExpr(e.b); }
            E4(0xF84107E1);                        // pop x1
            if (e.op == TK.Star()) { E4(0x9B007C20); }       // mul x0, x1, x0
            else if (e.op == TK.Plus()) { E4(0x8B000020); }  // add x0, x1, x0
            else { E4(0xCB000020); }                         // sub x0, x1, x0
            return;
        }
        GenExpr(e);
    }

    // DateTime AddSeconds/Minutes/Hours/Days: fresh object at epoch+n*unit.
    void GenDtAdd(Node recv, Node arg, long unit) {
        GenExpr(recv);
        LdrU(0, 0, 0);                         // epoch
        ExtPush(0);
        HostGenI64Arg(arg);                    // n
        LoadImm(1, unit);
        E4(0x9B017C00);                        // mul x0, x0, x1
        ExtPop(1);
        AddRR(0, 1, 0);                        // epoch + n*unit
        BLInternal("_zan_dt_from_unix");
    }

    // Render supported scalar Append arguments just as IR's ToCStr does.
    // Strings are already byte pointers; never stringify an untyped pointer.
    void HostStringArg(Node a) {
        bool str = IsStrExpr(a) || HostCallRetTy(a) == "string";
        GenExpr(a);
        if (str) { return; }
        if (IsBoolExpr(a)) {
            int no = NL(); int done = NL();
            CbzReg(0, no);
            LoadStr(hostTrue, 0); EmitB(done);
            Mark(no); LoadStr(hostFalse, 0); Mark(done);
        } else if (IsCharExpr(a)) { BLInternal("_zan_rt_chrstr"); }
        else if (IsDblExpr(a)) { BLInternal("_zan_rt_dbl2str"); }
        else if (IsUlongExpr(a)) { BLInternal("_zan_rt_uint2str"); }
        else {
            string ty = StaticTyOf(a);
            if (a.kind == AK.IntLit() || ty == "int" || ty == "long"
                    || (a.kind == AK.Binary() && !IsStrExpr(a))) {
                BLInternal("_zan_rt_int2str");
            } else {
                diags.Error("ngen host: unsupported StringBuilder Append argument type", a.line, a.col);
            }
        }
    }

    // instance-call recognition on a stdlib class absent from the compile:
    // the receiver must statically type as `cls`, the class must not exist,
    // and no user method may shadow the member
    bool HostInst(Node e, string cls, string name, int count) {
        if (e == null || e.kind != AK.Call() || e.a == null) { return false; }
        Node m = e.a;
        if (m.kind != AK.MemberAccess() || m.sval != name
                || e.kids.Count != count) { return false; }
        if (m.a == null || FindClass(cls) != null) { return false; }
        return StaticTyOf(m.a) == cls && !UserDefinesClsMember(cls, name);
    }

    // does this expression denote an AtomicInt object? Locals, fields,
    // class-qualified statics and calls; null when it does not. The stdlib
    // class is absent from the compile, so ordinary field typing misses the
    // class-qualified static shape (`Prog.counter`) that the Threading
    // tests use.
    string HostAtomicRecvTy(Node e) {
        if (e == null || FindClass("AtomicInt") != null) { return null; }
        if (e.kind == AK.Ident()) {
            return NamedSlotTy(e.sval) == "AtomicInt" ? "AtomicInt" : null;
        }
        if (e.kind == AK.MemberAccess() && e.a != null) {
            string t = StaticTyOf(e);
            if (t == "AtomicInt") { return t; }
            if (e.a.kind == AK.Ident() && FindClass(e.a.sval) != null) {
                string st = FindStaticTy(QualifiedCls(e.a.sval, e.a.sval2), e.sval);
                if (st == "AtomicInt") { return st; }
            }
            return null;
        }
        if (e.kind == AK.Call()) {
            return CallRetTy(e) == "AtomicInt" ? "AtomicInt" : null;
        }
        return null;
    }

    // declared return type of the desugared `get_<name>` property accessor
    // on the receiver's class (no base-chain walk; properties used with
    // ToString() sit on the receiver's own class), or null
    string HostPropGetterTy(Node mem) {
        if (mem == null || mem.kind != AK.MemberAccess() || mem.a == null) { return null; }
        string gc = ExprCls(mem.a);
        if (gc == null) { return null; }
        string want = "get_" + mem.sval;
        List<int> cs = MethCandsClsName(gc, want);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methNodes[cs[i]].type != null) {
                return TypeFullName(methNodes[cs[i]].type);
            }
            i = i + 1;
        }
        return null;
    }

    // how would ToString() render this receiver? "int" (value already in
    // x0 after GenExpr(r)), "strlen" (receiver in r.a is a string pointer
    // whose stamp must be read), "bool" / "char" / "double" / "ulong", or
    // null when the receiver is not a host-rendered scalar. Covers
    // built-in property chains (string/array Length, List/Dictionary
    // Count, StringBuilder.Length) whose member access has no field
    // symbol and therefore no static type for the generic path.
    string HostToStrArgKind(Node r) {
        if (r == null) { return null; }
        if (HostIsLength(r)) { return "int"; }
        if (r.kind == AK.MemberAccess() && r.a != null) {
            if (r.sval == "Length") {
                if (ArrContainerTy(r.a) != null) { return "int"; }
                if (IsStrExpr(r.a)) { return "int"; }
                if (HostPropGetterTy(r.a) == "string") { return "strlen"; }
            }
            else if (r.sval == "Count") {
                if (IsStrExpr(r.a)) { return "int"; }
                string ct = StaticTyOf(r.a);
                if (ct != null && (ct.IndexOf("List") == 0
                        || ct.IndexOf("Dict") == 0)) { return "int"; }
            }
            else {
                string pt = HostPropGetterTy(r);
                if (pt == "int" || pt == "long") { return "int"; }
            }
        }
        if (ExtIsIntExpr(r)) { return "int"; }
        if (IsBoolExpr(r)) { return "bool"; }
        if (IsCharExpr(r)) { return "char"; }
        if (IsDblExpr(r)) { return "double"; }
        if (IsUlongExpr(r)) { return "ulong"; }
        string pg = HostPropGetterTy(r);
        if (pg == "int" || pg == "long") { return "int"; }
        return null;
    }

    bool TryGenHostCall(Node e) {
        if (HostStatic(e, "File", "ReadAllText", 1)) { HostCallArgs(e, "_zan_host_read"); return true; }
        if (HostStatic(e, "File", "WriteAllText", 2)) { HostCallArgs(e, "_zan_host_write"); return true; }
        if (HostStatic(e, "File", "Exists", 1)) { HostCallArgs(e, "_zan_host_exists"); return true; }
        if (HostStatic(e, "Environment", "ArgCount", 0)) { BLInternal("_zan_host_argc"); return true; }
        if (HostStatic(e, "Environment", "ArgAt", 1)) { HostCallArgs(e, "_zan_host_argat"); return true; }
        if (HostStatic(e, "Environment", "ExeDir", 0)) { BLInternal("_zan_host_exedir"); return true; }
        if (HostStatic(e, "Directory", "ListNames", 1)) { HostCallArgs(e, "_zan_host_dir"); return true; }
        // ---- System.IO.Path statics ----
        if (HostStatic(e, "Path", "GetFileName", 1)) { HostCallArgs(e, "_zan_ext_path_filename"); return true; }
        if (HostStatic(e, "Path", "GetExtension", 1)) { HostCallArgs(e, "_zan_ext_path_extension"); return true; }
        if (HostStatic(e, "Path", "GetDirectoryName", 1)) { HostCallArgs(e, "_zan_ext_path_dirname"); return true; }
        if (HostStatic(e, "Path", "GetFileNameWithoutExtension", 1)) { HostCallArgs(e, "_zan_ext_path_stem"); return true; }
        if (HostStatic(e, "Path", "ChangeExtension", 2)) { HostCallArgs(e, "_zan_ext_path_changeext"); return true; }
        if (HostStatic(e, "Path", "Combine", 2)) { HostCallArgs(e, "_zan_ext_path_combine"); return true; }
        if (HostStatic(e, "Path", "GetTempPath", 0)) { BLInternal("_zan_ext_path_temppath"); return true; }
        if (HostStatic(e, "Path", "HasExtension", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_path_extension");
            LoadStr(extEmpty, 1);
            BLExtern("_strcmp");
            int nz = NL(); CbnzReg(0, nz);
            LoadImm(0, 0);                         // ext == "": no extension
            int hFin = NL(); EmitB(hFin);
            Mark(nz);
            LoadImm(0, 1);
            Mark(hFin);
            return true;
        }
        // ---- System.DateTime statics ----
        if (HostStatic(e, "DateTime", "FromUnixSeconds", 1)) {
            HostGenI64Arg(e.kids[0]);
            BLInternal("_zan_dt_from_unix");
            return true;
        }
        if (HostStatic(e, "DateTime", "FromDate", 3)) { HostCallArgs(e, "_zan_dt_from_date"); return true; }
        if (HostStatic(e, "DateTime", "FromParts", 6)) { HostCallArgs(e, "_zan_dt_from_parts"); return true; }
        if (HostStatic(e, "DateTime", "DaysFromCivil", 3)) { HostCallArgs(e, "_zan_dt_dfc"); return true; }
        if (HostStatic(e, "DateTime", "IsLeapYear", 1)) { HostCallArgs(e, "_zan_dt_isleap"); return true; }
        if (HostStatic(e, "DateTime", "DaysInMonth", 2)) { HostCallArgs(e, "_zan_dt_daysinmonth"); return true; }
        // ---- DateTime instance accessors/formatting (stdlib class absent) ----
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.a != null
                && FindClass("DateTime") == null
                && IsDateTimeMemberName(e.a.sval, e.kids.Count)
                && StaticTyOf(e.a.a) == "DateTime") {
            string mn = e.a.sval;
            int n = e.kids.Count;
            if (n == 0 && !UserDefinesClsMember("DateTime", mn)) {
                if (mn == "Year") { GenExpr(e.a.a); LdrU(0, 0, 8); return true; }
                if (mn == "Month") { GenExpr(e.a.a); LdrU(0, 0, 16); return true; }
                if (mn == "Day") { GenExpr(e.a.a); LdrU(0, 0, 24); return true; }
                if (mn == "Hour") { GenExpr(e.a.a); LdrU(0, 0, 32); return true; }
                if (mn == "Minute") { GenExpr(e.a.a); LdrU(0, 0, 40); return true; }
                if (mn == "Second") { GenExpr(e.a.a); LdrU(0, 0, 48); return true; }
                if (mn == "DayOfWeek") { GenExpr(e.a.a); LdrU(0, 0, 56); return true; }
                if (mn == "ToUnixSeconds") { GenExpr(e.a.a); LdrU(0, 0, 0); return true; }
                if (mn == "ToString") { GenExpr(e.a.a); BLInternal("_zan_dt_tostring"); return true; }
                if (mn == "ToDateString") { GenExpr(e.a.a); BLInternal("_zan_dt_todatestring"); return true; }
                if (mn == "ToTimeString") { GenExpr(e.a.a); BLInternal("_zan_dt_totimestring"); return true; }
            }
            if (n == 1 && !UserDefinesClsMember("DateTime", mn)) {
                if (mn == "AddSeconds") { GenDtAdd(e.a.a, e.kids[0], 1); return true; }
                if (mn == "AddMinutes") { GenDtAdd(e.a.a, e.kids[0], 60); return true; }
                if (mn == "AddHours") { GenDtAdd(e.a.a, e.kids[0], 3600); return true; }
                if (mn == "AddDays") { GenDtAdd(e.a.a, e.kids[0], 86400); return true; }
                if (mn == "Equals" || mn == "IsBefore" || mn == "IsAfter") {
                    GenExpr(e.a.a); LdrU(0, 0, 0);      // this.epoch
                    ExtPush(0);
                    GenExpr(e.kids[0]); LdrU(0, 0, 0);  // other.epoch
                    MovRR(1, 0);
                    ExtPop(0);
                    HostCmp(0, 1);
                    int rT = NL(); int cmpFin = NL();
                    EmitBcond(mn == "Equals" ? 0 : (mn == "IsBefore" ? 11 : 12), rT);
                    LoadImm(0, 0); EmitB(cmpFin);
                    Mark(rT);
                    LoadImm(0, 1);
                    Mark(cmpFin);
                    return true;
                }
            }
        }
        // ---- threading / process / environment statics ----
        if (HostStatic(e, "Thread", "Sleep", 1)) {
            GenExpr(e.kids[0]);                  // ms
            LoadImm(1, 1000);
            E4(0x9AC10C02);                      // sdiv x2, x0, x1   tv_sec
            E4(0x9B018043);                      // msub x3, x2, x1, x0  ms%1000
            LoadImm(1, 1000000);
            E4(0x9B017C63);                      // mul x3, x3, x1    tv_nsec
            E4(0xA9BF0FE2);                      // stp x2, x3, [sp, #-0x10]! (contiguous timespec)
            AddImm(0, 31, 0);                    // x0 = sp
            LoadImm(1, 0);                       // rem = NULL
            BLExtern("_nanosleep");
            AddSPImm(16, true);
            return true;
        }
        if (HostStatic(e, "ProcessList", "SelfPid", 0)) { BLExtern("_getpid"); return true; }
        if (HostStatic(e, "Interop", "getenv", 1)) {
            GenExpr(e.kids[0]);
            // raw libc result: null when unset (the null test is the API)
            BLExtern("_getenv");
            return true;
        }
        if (HostStatic(e, "KnownFolders", "Home", 0)) {
            LoadStr(ioHome, 0);
            BLInternal("_zan_ext_getenv");
            return true;
        }
        if (HostStatic(e, "KnownFolders", "Temp", 0)) {
            // oracle order: TEMP -> TMP -> TMPDIR -> /tmp (POSIX)
            LoadStr(ioTemp, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            int tDone = NL(); CbnzReg(9, tDone);
            LoadStr(ioTmp, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            CbnzReg(9, tDone);
            LoadStr(ioTmpdir, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            CbnzReg(9, tDone);
            LoadStr(ioSlashTmp, 0);
            int tFin = NL(); EmitB(tFin);
            Mark(tDone);
            return true;
        }
        if (HostStatic(e, "KnownFolders", "AppData", 0)) {
            // XDG_CONFIG_HOME, else $HOME + "/.config"
            LoadStr(ioXdgCfg, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            int aFin = NL(); int aEmpty = NL();
            CbnzReg(9, aFin);
            LoadStr(ioHome, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            CbzReg(9, aEmpty);
            ExtPush(0);
            LoadStr(ioDotConfig, 0);
            ExtMov(1, 0);
            ExtPop(0);
            BLInternal("_zan_ext_path_combine");
            EmitB(aFin);
            Mark(aEmpty);
            LoadStr(extEmpty, 0);
            Mark(aFin);
            return true;
        }
        if (HostStatic(e, "KnownFolders", "GetEnv", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_getenv");
            return true;
        }
        if (HostStatic(e, "KnownFolders", "SetEnv", 2)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            ExtPop(1);                           // value
            ExtPop(0);                           // name
            ExtLenOf(1, 9);
            int sUnset = NL(); CbzReg(9, sUnset);
            int sFin = NL();
            LoadImm(2, 1);                       // overwrite = 1
            BLExtern("_setenv");
            EmitB(sFin);
            Mark(sUnset);
            BLExtern("_unsetenv");
            Mark(sFin);
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "KnownFolders", "Expand", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_expand");
            return true;
        }
        // ---- file system statics ----
        if (HostStatic(e, "Directory", "Exists", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_host_direxists");
            return true;
        }
        if (HostStatic(e, "Directory", "CreateDirectory", 1)) {
            GenExpr(e.kids[0]);
            LoadImm(1, 511);                     // 0o777, umask applies
            BLExtern("_mkdir");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "Directory", "Delete", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_rmdir");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "File", "Delete", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_unlink");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "Directory", "GetFiles", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_host_getfiles");
            return true;
        }
        if (HostStatic(e, "Directory", "GetDirectories", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_host_getdirs");
            return true;
        }
        // full-path variants and the recursive create/delete pair
        if (HostStatic(e, "Directory", "GetPaths", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_getpaths");
            return true;
        }
        if (HostStatic(e, "Directory", "GetDirectoryPaths", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_getdirpaths");
            return true;
        }
        if (HostStatic(e, "Directory", "CreateDirectoryRecursive", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_mkdirs");
            return true;
        }
        if (HostStatic(e, "Directory", "DeleteRecursive", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_delrec");
            return true;
        }
        // ---- Stopwatch statics ----
        if (HostStatic(e, "Stopwatch", "Frequency", 0)) {
            LoadImm(0, 1000000000);              // clock_gettime nanoseconds
            return true;
        }
        if (HostStatic(e, "Stopwatch", "GetMilliseconds", 0)) {
            BLInternal("_zan_host_mono_ms");
            return true;
        }
        // ---- Semaphore (GCD dispatch on macOS, per the stdlib) ----
        if (HostStatic(e, "Semaphore", "Create", 2)) {
            GenExpr(e.kids[0]);                  // initial count
            LoadImm(1, 0);
            BLExtern("_dispatch_semaphore_create");
            return true;
        }
        if (HostStatic(e, "Semaphore", "Wait", 1)) {
            GenExpr(e.kids[0]);
            LoadImm(1, -1);                      // DISPATCH_TIME_FOREVER
            BLExtern("_dispatch_semaphore_wait");
            return true;
        }
        if (HostStatic(e, "Semaphore", "Release", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_dispatch_semaphore_signal");
            return true;
        }
        if (HostStatic(e, "Semaphore", "Destroy", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_dispatch_release");
            return true;
        }
        // ---- Stopwatch / Timer / FileInfo instance members ----
        if (HostInst(e, "Stopwatch", "Start", 0)) {
            GenExpr(e.a.a); BLInternal("_zan_host_sw_start"); return true;
        }
        if (HostInst(e, "Stopwatch", "Stop", 0)) {
            GenExpr(e.a.a); BLInternal("_zan_host_sw_stop"); return true;
        }
        if (HostInst(e, "Stopwatch", "Reset", 0)) {
            GenExpr(e.a.a); BLInternal("_zan_host_sw_reset"); return true;
        }
        if (HostInst(e, "Stopwatch", "ElapsedMilliseconds", 0)) {
            GenExpr(e.a.a); BLInternal("_zan_host_sw_elapsed"); return true;
        }
        if (HostInst(e, "Timer", "Start", 0)) {
            GenExpr(e.a.a);                      // x0 = timer
            E4(0xB9800009);                      // ldrsw x9, [x0]  interval
            ExtCmpImm(9, 1);
            int tmBad = NL(); EmitBcond(11, tmBad);   // interval < 1 -> false
            LdrU(9, 0, 16);
            int tmOk = NL(); CbnzReg(9, tmOk);        // already running -> true
            LoadImm(9, 1);
            StrU(9, 0, 16);                      // running = 1
            ExtPush(0);                          // timer for the arg slot
            AddImm(0, 0, 24);                    // x0 = &timer->pthread
            LoadImm(1, 0);                       // attr
            LoadSymRef("_zan_host_timer_thread", 2);
            ExtPop(3);                           // x3 = timer
            BLExtern("_pthread_create");
            LoadImm(0, 1);
            int tmFin = NL(); EmitB(tmFin);
            Mark(tmBad);
            LoadImm(0, 0);
            EmitB(tmFin);
            Mark(tmOk);
            LoadImm(0, 1);
            Mark(tmFin);
            return true;
        }
        if (HostInst(e, "Timer", "Stop", 0)) {
            GenExpr(e.a.a);
            LoadImm(9, 0);
            StrU(9, 0, 16);                      // running = 0
            return true;
        }
        if (HostInst(e, "FileInfo", "Exists", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            BLInternal("_zan_host_fattr");
            LoadImm(1, 0);
            HostCmp(0, 1);
            int feT = NL(); int feFin = NL();
            EmitBcond(10, feT);                  // b.ge attr >= 0
            LoadImm(0, 0); EmitB(feFin);
            Mark(feT); LoadImm(0, 1);
            Mark(feFin);
            return true;
        }
        if (HostInst(e, "FileInfo", "Length", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            BLInternal("_zan_host_flength");
            return true;
        }
        if (HostInst(e, "FileInfo", "IsDirectory", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            BLInternal("_zan_host_fattr");
            ExtUbfmR(0, 0, 2, 2);                // attribute bit 2
            return true;
        }
        if (HostInst(e, "FileInfo", "IsReadOnly", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            BLInternal("_zan_host_fattr");
            ExtUbfmR(0, 0, 0, 0);                // attribute bit 0
            return true;
        }
        if (HostInst(e, "FileInfo", "LastWriteTime", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            LoadImm(1, 0);
            BLInternal("_zan_host_ftime");
            return true;
        }
        if (HostInst(e, "FileInfo", "CreationTime", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            LoadImm(1, 1);
            BLInternal("_zan_host_ftime");
            return true;
        }
        if (HostInst(e, "FileInfo", "FullName", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            return true;
        }
        if (HostInst(e, "FileInfo", "NewerThan", 1)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);       // obj.path
            ExtPush(0);
            GenExpr(e.kids[0]);
            MovRR(1, 0);
            ExtPop(0);
            BLInternal("_zan_host_fnewer");
            return true;
        }
        if (HostInst(e, "FileInfo", "SetReadOnly", 1)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);       // obj.path
            ExtPush(0);
            GenExpr(e.kids[0]);
            MovRR(1, 0);
            ExtPop(0);
            BLInternal("_zan_host_setreadonly");
            return true;
        }
        if (HostStatic(e, "FileInfo", "GetLength", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_host_flength");
            return true;
        }
        if (HostStatic(e, "FileInfo", "GetLastWriteTime", 1)) {
            GenExpr(e.kids[0]);
            LoadImm(1, 0);
            BLInternal("_zan_host_ftime");
            return true;
        }
        // ---- dynamic library loading (System.Interop) ----
        if (HostStatic(e, "Interop", "Load", 1)) {
            GenExpr(e.kids[0]);
            LoadImm(1, 1);                         // RTLD_LAZY
            BLExtern("_dlopen");                   // 0 handle when missing
            return true;
        }
        if (HostStatic(e, "Interop", "Symbol", 2)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            ExtPop(1);                             // x1 = symbol name
            ExtPop(0);                             // x0 = module handle
            int symFin = NL(); int symNull = NL();
            CbzReg(0, symNull);                    // null handle resolves to 0
            BLExtern("_dlsym");
            EmitB(symFin);
            Mark(symNull);
            LoadImm(0, 0);
            Mark(symFin);
            return true;
        }
        if (HostStatic(e, "Interop", "LastError", 0)) {
            BLInternal("_zan_host_dlerror_str");   // owned "" when no error
            return true;
        }
        if (HostStatic(e, "Interop", "Unload", 1)) {
            GenExpr(e.kids[0]);
            int unlFin = NL();
            CbzReg(0, unlFin);                     // null handle is a no-op
            BLExtern("_dlclose");
            Mark(unlFin);
            LoadImm(0, 0);
            return true;
        }
        // ---- raw memory intrinsics ----
        if (HostStatic(e, "NativeMemory", "Alloc", 1)) {
            HostGenI64Arg(e.kids[0]);
            BLExtern("_malloc");
            return true;
        }
        if (HostStatic(e, "NativeMemory", "Free", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_free");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "NativeMemory", "PutString", 4)) {
            GenExpr(e.kids[0]); ExtPush(0);        // dst
            GenExpr(e.kids[1]); ExtPush(0);        // offset
            GenExpr(e.kids[2]); ExtPush(0);        // source string
            GenExpr(e.kids[3]); ExtPush(0);        // count
            ExtPop(3); ExtPop(2); ExtPop(1); ExtPop(0);
            AddRR(0, 0, 1);                        // dst + offset
            MovRR(1, 2);
            MovRR(2, 3);
            BLExtern("_memcpy");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "NativeMemory", "GetString", 3)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            ExtPop(2); ExtPop(1); ExtPop(0);
            BLInternal("_zan_nm_getstring");
            return true;
        }
        if (HostStatic(e, "NativeMemory", "Sha256", 2)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            ExtPop(1); ExtPop(0);
            BLInternal("_zan_nm_sha256");
            return true;
        }
        // FindNotAnyOf(p, off, rejectSet, n) -> strcspn(p + off, rejectSet),
        // offset of the first byte in the reject set relative to p, or -1
        // when the window holds none (oracle irgen_expr.c:785; the reject
        // set is a strpool literal, NUL-terminated by _zan_rt_strpool_init)
        if (HostStatic(e, "NativeMemory", "FindNotAnyOf", 4)) {
            GenExpr(e.kids[0]); ExtPush(0);        // p (nint)
            GenExpr(e.kids[1]); ExtPush(0);        // offset
            GenExpr(e.kids[2]); ExtPush(0);        // reject set
            GenExpr(e.kids[3]); ExtPush(0);        // limit n
            ExtPop(3); ExtPop(2); ExtPop(1); ExtPop(0);
            AddRR(0, 0, 1);                        // start = p + off
            MovRR(1, 2);                           // x1 = reject set
            ExtPush(3);                            // keep n across the call
            BLExtern("_strcspn");                  // x0 = run (stops at NUL)
            ExtPop(1);                             // x1 = n
            ExtMov(2, 0);                          // x2 = run
            E4(0xEB01005F);                        // cmp x2, x1 (unsigned)
            int clean = NL(); int done2 = NL();
            EmitBcond(2, clean);                   // b.hs clean: run >= n
            EmitB(done2);                          // hit: x0 = run
            Mark(clean);
            E4(0x92800000);                        // movn x0, #0 (-1)
            Mark(done2);
            return true;
        }
        // ---- current working directory ----
        if (HostStatic(e, "Directory", "GetCurrentDirectory", 0)) {
            BLInternal("_zan_host_getcwd");
            return true;
        }
        // ---- string statics: IsNullOrEmpty. The stamp word at ptr-8 is
        // magic|len, so only the low 32 bits are the length; a null string
        // counts as empty. ExtLenOf already handles both. ----
        if (HostStatic(e, "string", "IsNullOrEmpty", 1)
                || HostStatic(e, "String", "IsNullOrEmpty", 1)) {
            GenExpr(e.kids[0]);
            ExtLenOf(0, 0);                        // x0 = len (0 for null)
            ExtCmpImm(0, 0);
            int sneFin = NL();
            LoadImm(0, 1);
            EmitBcond(0, sneFin);                  // len == 0 -> true
            LoadImm(0, 0);
            Mark(sneFin);
            return true;
        }
        // ---- numeric TryParse: full-string decimal parse (strtoll
        // semantics); on failure the out slot receives 0 ----
        if (HostStatic(e, "int", "TryParse", 2)
                || HostStatic(e, "long", "TryParse", 2)) {
            GenRefArg(e.kids[1]);                  // x0 = out address
            ExtPush(0);
            GenExpr(e.kids[0]);                    // x0 = text
            ExtMov(1, 0);                          // x1 = text
            ExtPop(0);                             // x0 = out address
            BLInternal("_zan_host_int_tryparse");
            return true;
        }
        // ---- background threads over the delegate closure ABI ----
        if (HostStatic(e, "Thread", "Start", 1)) {
            GenExpr(e.kids[0]);                    // closure {thunk, env}
            ExtPush(0);
            LoadImm(0, 24); BLExtern("_malloc");   // {tid@0, thunk@8, env@16}
            ExtMov(9, 0);                          // block
            ExtPop(1);
            LdrU(2, 1, 0); StrU(2, 9, 8);          // thunk
            LdrU(2, 1, 8); StrU(2, 9, 16);         // env
            ExtMov(0, 9);                          // x0 = &tid
            LoadImm(1, 0);                         // attr
            LoadSymRef("_zan_host_thread_trampoline", 2);
            ExtMov(3, 9);                          // x3 = block
            BLExtern("_pthread_create");
            LoadImm(0, 1);                         // started
            return true;
        }
        if (HostStatic(e, "Thread", "CurrentId", 0)) {
            BLInternal("_zan_host_thread_id");
            return true;
        }
        // ---- AtomicInt instance members ----
        if (FindClass("AtomicInt") == null && e.a != null
                && e.a.kind == AK.MemberAccess() && e.a.a != null) {
            string an2 = e.a.sval;
            int an = e.kids.Count;
            if (!(an2 == "Load" || an2 == "Add" || an2 == "Increment"
                    || an2 == "Decrement" || an2 == "Exchange"
                    || an2 == "CompareExchange" || an2 == "Store")) { an2 = null; }
            if (an2 != null && HostAtomicRecvTy(e.a.a) != null
                    && !UserDefinesClsMember("AtomicInt", an2)) {
            if (an2 == "Load" && an == 0) {
                GenExpr(e.a.a);
                E4(0xC8DFFC00);                    // ldar x0, [x0]
                return true;
            }
            if (an2 == "Store" && an == 1) {
                GenExpr(e.a.a); ExtPush(0);
                GenExpr(e.kids[0]);
                MovRR(1, 0);
                ExtPop(0);
                E4(0xC89FFC01);                    // stlr x1, [x0]
                LoadImm(0, 0);
                return true;
            }
            if ((an2 == "Add" && an == 1) || ((an2 == "Increment"
                    || an2 == "Decrement") && an == 0)) {
                GenExpr(e.a.a); ExtPush(0);
                if (an2 == "Add") { HostGenI64Arg(e.kids[0]); }
                else { LoadImm(1, an2 == "Increment" ? 1 : 0 - 1); }
                MovRR(1, 0);
                ExtPop(0);
                E4(0xF8E10009);                    // ldaddal x1, x9, [x0]
                AddRR(0, 9, 1);                    // Add/Increment return NEW
                return true;
            }
            if (an2 == "Exchange" && an == 1) {
                GenExpr(e.a.a); ExtPush(0);
                GenExpr(e.kids[0]);
                MovRR(1, 0);
                ExtPop(0);
                E4(0xF8E18009);                    // swpal x1, x9, [x0]
                ExtMov(0, 9);                      // old value
                return true;
            }
            if (an2 == "CompareExchange" && an == 2) {
                GenExpr(e.a.a); ExtPush(0);
                GenExpr(e.kids[0]); ExtPush(0);
                GenExpr(e.kids[1]); ExtPush(0);
                ExtPop(2);                         // x2 = desired
                ExtPop(1);                         // x1 = expected
                ExtPop(0);                         // x0 = object
                E4(0xC8E1FC02);                    // casal x1, x2, [x0]
                ExtMov(0, 1);                      // old value
                return true;
            }
            }
        }
        if (TryGenHostExtCall(e)) { return true; }
        if (e.a == null || e.a.kind != AK.MemberAccess()) { return false; }
        // name gate before HostIsBuilder: typing the receiver re-walks
        // fluent-chain prefixes at every level
        string name = e.a.sval;
        if (!(name == "ToString" || name == "Append" || name == "AppendLine")) { return false; }
        if (!HostIsBuilder(e.a.a)) { return false; }
        if (name == "ToString" && e.kids.Count == 0) {
            GenExpr(e.a.a); BLInternal("_zan_host_sb_string"); return true;
        }
        if ((name == "Append" && e.kids.Count == 1)
                || (name == "AppendLine" && e.kids.Count <= 1)) {
            GenExpr(e.a.a);
            if (e.kids.Count == 1) {
                // sb rides the stack across the length helper (and across
                // HostStringArg, which clobbers x0): the raw fallback's
                // strlen may trash caller-saved x0/x1.
                E4(0xF81F0FE0);                    // push sb
                HostStringArg(e.kids[0]);
                MovRR(1, 0);                       // x1 = rendered
                BLInternal("_zan_host_sblen");     // x0 = byte length
                MovRR(2, 0);                       // x2 = len
                E4(0xF84107E0);                    // pop sb
                BLInternal("_zan_host_sb_append");
            }
            if (name == "AppendLine") {
                LoadStr(hostNL, 1);
                LoadImm(2, 1);
                BLInternal("_zan_host_sb_append");
            }
            return true;
        }
        diags.Error("ngen host: unsupported StringBuilder method or arity", e.line, e.col);
        return true;
    }

    // Runtime helpers use a fixed 128-byte frame; slots at sp+0..120.
    // Neither code nor flags rely on scratch register values after a BL.
    void HostBegin(string sym) {
        syms.Add(new Sym(sym, txt.Count));
        RtPrologue(); AddSPImm(128, false);
    }
    void HostEnd() { AddSPImm(128, true); RtEpilogue(); }
    void HostSave(int reg, int slot) { StrU(reg, 31, slot * 8); }
    void HostLoad(int reg, int slot) { LdrU(reg, 31, slot * 8); }
    void HostCmp(int a, int b) { E4(0xEB00001F | (b << 16) | (a << 5)); }
    // x0 string, x1 byte length. Preserve both; clobber x2/x3.
    // Native Length/indexing reads the low 32 bits at ptr-8, NOT strlen.
    void HostStamp() {
        LoadImm(2, 0x5A414E5300000000);
        E4(0xD3407C23); // ubfm x3, x1, #0, #31
        E4(0xAA030042); // orr x2, x2, x3
        RtStur(2, 0, -8);
    }
    // Each failure site supplies a stable subsystem.operation label. The
    // failure runtime takes x0=message; it never inspects stale errno/flags.
    void HostFailAt(string site) {
        LoadStr(InternStr("zan host: " + site), 0);
        BLInternal("_zan_host_fail");
    }
    void HostNonzero(int reg, string site) {
        int ok = NL(); CbnzReg(reg, ok);
        HostFailAt(site); Mark(ok);
    }
    void HostZero32(string site) {
        int ok = NL();
        E4(0x7100001F); // cmp w0, #0 (C int results, NOT x0)
        EmitBcond(0, ok); HostFailAt(site); Mark(ok);
    }
    void HostEqual(int a, int b, string site) {
        int ok = NL(); HostCmp(a, b); EmitBcond(0, ok);
        HostFailAt(site); Mark(ok);
    }
    // slot 7 retains the original File path across fopen. Print delimiters
    // on separate lines so embedded/trailing LF in a malformed path is visible.
    void HostFileOpened(string site) {
        int ok = NL(); CbnzReg(0, ok);
        LoadStr(InternStr("zan host: failed File path begins >>>"), 0); BLExtern("_puts");
        HostLoad(0, 7); BLExtern("_puts");
        LoadStr(InternStr("<<< failed File path ends"), 0); BLExtern("_puts");
        HostFailAt(site); Mark(ok);
    }

    void EmitHostEntryArgs() {
        LoadSymRef("l_.g.host_argc", 9); StrU(0, 9, 0);
        LoadSymRef("l_.g.host_argv", 9); StrU(1, 9, 0);
    }

    void EmitHostRuntime() {
        hostError = InternStr("zan host: I/O, allocation or argument failure");
        hostRB = InternStr("rb"); hostWB = InternStr("wb");
        hostNL = InternStr("\n"); hostTrue = InternStr("true"); hostFalse = InternStr("false");
        dglbs.Add(new DGlob("host_argc", 8, dataLen)); dataLen = dataLen + 8;
        dglbs.Add(new DGlob("host_argv", 8, dataLen)); dataLen = dataLen + 8;
        HostBegin("_zan_host_fail");
        // x0 is the per-site diagnostic supplied by HostFailAt.
        BLExtern("_puts");
        LoadImm(0, 1); BLExtern("_exit"); E4(0xD4200000); // brk if exit returns
        HostEnd();
        HostEmitCopy(); HostEmitSbLen(); HostEmitArgs(); HostEmitFiles(); HostEmitPaths(); HostEmitSb();
        HostEmitExt();
        HostEmitHost2();
    }

    // x0 = C string, x1 = byte count; copy to an owning native string.
    void HostEmitCopy() {
        HostBegin("_zan_host_copy");
        HostSave(0, 0); HostSave(1, 1);
        AddImm(0, 1, 1); BLInternal("_zan_rt_str_alloc"); HostSave(0, 2);
        HostLoad(1, 0); HostLoad(2, 1); BLExtern("_memcpy");
        HostLoad(0, 2); HostLoad(1, 1); AddRR(2, 0, 1); Strb0(2); HostStamp();
        HostEnd();
    }

    // x0 = string value -> x0 = byte length, trusting nothing about the
    // producer. Managed strings carry a stamp at ptr-8: the low 32 bits
    // hold the byte length and the high word the magic 0x5A414E53. That
    // magic alone is not proof -- the str_alloc sentinel 0x54524D47_.53
    // lives at raw+8 and shares the same high word, and an unstamped
    // pointer can land right after one -- so the sentinel slot itself is
    // ruled out too. Anything failing the check is raw (extern renders,
    // getenv, digit buffers), where strlen is exact; raw consumers can
    // reach this helper through locals and returns that call-shape
    // peepholing cannot follow. Null -> 0.
    void HostEmitSbLen() {
        HostBegin("_zan_host_sblen");
        HostSave(0, 0); HostSave(1, 1);
        int isNull = NL(); CbzReg(0, isNull);
        AddImm(9, 0, -8);
        E4(0xF9400129);                        // ldr x9, [x9] (stamp)
        E4(0xD360FD2A);                        // lsr x10, x9, #32 (magic word)
        LoadImm(11, 0x5A414E53);
        HostCmp(10, 11);
        int rawLen = NL(); EmitBcond(1, rawLen);
        E4(0xD3407D2A);                        // ubfm x10, x9, #0, #31 (len)
        LoadImm(11, 0x54524D47);
        HostCmp(10, 11);
        EmitBcond(0, rawLen);                  // len == sentinel low word: it is
                                               // the str_alloc sentinel, not a stamp
        MovRR(0, 10);
        int fin = NL(); EmitB(fin);
        Mark(rawLen);
        HostLoad(0, 0); BLExtern("_strlen"); EmitB(fin);
        Mark(isNull); LoadImm(0, 0);
        Mark(fin);
        HostLoad(1, 1);                        // x1 is caller-saved: strlen
        HostEnd();                             // may trash the rendered ptr
    }

    void HostEmitArgs() {
        HostBegin("_zan_host_argc");
        LoadSymRef("l_.g.host_argc", 9); LdrU(0, 9, 0);
        SubImm(0, 0, 1); HostEnd();
        HostBegin("_zan_host_argat");
        // C host irgen_call.c: idx >= 0 && unsigned(idx + 1) < argc.
        // Check BEFORE adding one: negative indices and INT64_MAX must not
        // wrap into a valid argv slot. Out-of-range returns a stamped empty
        // string, not a diagnostic, a null pointer, or argv[0].
        int empty = NL(); int done = NL();
        LoadImm(1, 0); HostCmp(0, 1); EmitBcond(11, empty); // signed lt
        AddImm(0, 0, 1);
        LoadSymRef("l_.g.host_argc", 9); LdrU(1, 9, 0);
        HostCmp(0, 1); EmitBcond(2, empty); // unsigned hs
        LoadSymRef("l_.g.host_argv", 9); LdrU(1, 9, 0);
        E4(0xF8607820); // ldr x0, [x1, x0, lsl #3]
        HostSave(0, 0); BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 0); BLInternal("_zan_host_copy"); EmitB(done);
        Mark(empty); LoadStr(emptyIdx, 0);
        Mark(done); HostEnd();
    }

    void HostEmitFiles() {
        HostBegin("_zan_host_exists");
        LoadStr(hostRB, 1); BLExtern("_fopen");
        int missing = NL(); int done = NL(); CbzReg(0, missing);
        BLExtern("_fclose"); LoadImm(0, 1); EmitB(done);
        Mark(missing); LoadImm(0, 0); Mark(done); HostEnd();

        HostBegin("_zan_host_read");
        HostSave(0, 7);
        LoadStr(hostRB, 1); BLExtern("_fopen"); HostFileOpened("file.read.fopen"); HostSave(0, 0);
        LoadImm(1, 0); LoadImm(2, 2); BLExtern("_fseek"); HostZero32("file.read.seek_end");
        HostLoad(0, 0); BLExtern("_ftell");
        LoadImm(1, 0); HostCmp(0, 1);
        int sizeOK = NL(); EmitBcond(10, sizeOK); HostFailAt("file.read.ftell"); Mark(sizeOK);
        HostSave(0, 1);
        HostLoad(0, 0); LoadImm(1, 0); LoadImm(2, 0); BLExtern("_fseek"); HostZero32("file.read.seek_start");
        HostLoad(0, 1); AddImm(0, 0, 1); BLInternal("_zan_rt_str_alloc"); HostSave(0, 2);
        LoadImm(1, 1); HostLoad(2, 1); HostLoad(3, 0); BLExtern("_fread");
        HostLoad(1, 1); HostEqual(0, 1, "file.read.short_read");
        HostLoad(0, 2); HostLoad(1, 1); AddRR(2, 0, 1); Strb0(2); HostStamp();
        HostLoad(0, 0); BLExtern("_fclose"); HostZero32("file.read.fclose");
        HostLoad(0, 2); HostEnd();

        HostBegin("_zan_host_write");
        HostSave(0, 7);
        HostSave(1, 1); LoadStr(hostWB, 1); BLExtern("_fopen");
        HostFileOpened("file.write.fopen"); HostSave(0, 0);
        HostLoad(0, 1); BLExtern("_strlen"); HostSave(0, 2);
        MovRR(2, 0); HostLoad(0, 1); LoadImm(1, 1); HostLoad(3, 0); BLExtern("_fwrite");
        HostLoad(1, 2); HostEqual(0, 1, "file.write.short_write");
        HostLoad(0, 0); BLExtern("_fclose"); HostZero32("file.write.fclose"); LoadImm(0, 0); HostEnd();
    }

    void HostEmitPaths() {
        HostBegin("_zan_host_dir");
        HostSave(0, 0); LoadImm(0, 65536); BLInternal("_zan_rt_str_alloc"); HostSave(0, 1);
        Strb0(0);
        // Darwin arm64 glob_t: size 88, gl_pathc@0, gl_pathv@32.
        // Verified against MacOSX26.2.sdk/usr/include/glob.h and clang
        // _Static_assert(sizeof/offsetof); symbols verified as _glob/_globfree.
        // The struct is heap allocated, separate from our fixed stack frame.
        LoadImm(0, 1); LoadImm(1, 88); BLExtern("_calloc"); HostNonzero(0, "dir.glob_state.calloc"); HostSave(0, 2);
        MovRR(3, 0); HostLoad(0, 0); LoadImm(1, 0); LoadImm(2, 0); BLExtern("_glob");
        int cleanup = NL(); int loop = NL(); int haveBase = NL();
        E4(0x7100001F); EmitBcond(1, cleanup); // any glob error -> empty, matching shim
        LoadImm(0, 0); HostSave(0, 3); HostSave(0, 4); // i, output count
        Mark(loop);
        HostLoad(0, 2); LdrU(1, 0, 0); HostLoad(2, 3); HostCmp(2, 1); EmitBcond(2, cleanup);
        LdrU(0, 0, 32);
        E4(0xF8627800); // ldr x0, [x0, x2, lsl #3]
        HostSave(0, 5); LoadImm(1, 47); BLExtern("_strrchr");
        CbzReg(0, haveBase); AddImm(0, 0, 1); HostSave(0, 5); Mark(haveBase);
        HostLoad(0, 5); BLExtern("_strlen"); HostSave(0, 6);
        HostLoad(1, 4); AddRR(2, 0, 1); AddImm(2, 2, 2); LoadImm(3, 65536);
        HostCmp(2, 3); EmitBcond(8, cleanup); // keep room for newline + NUL
        HostLoad(0, 1); AddRR(0, 0, 1); HostLoad(1, 5); HostLoad(2, 6); BLExtern("_memcpy");
        HostLoad(0, 1); HostLoad(1, 4); HostLoad(2, 6); AddRR(1, 1, 2); AddRR(2, 0, 1);
        LoadImm(3, 10); E4(0x39000043); // strb w3, [x2]
        AddImm(2, 2, 1); Strb0(2); AddImm(1, 1, 1); HostSave(1, 4);
        HostLoad(0, 3); AddImm(0, 0, 1); HostSave(0, 3); EmitB(loop);
        Mark(cleanup);
        HostLoad(0, 2); BLExtern("_globfree"); HostLoad(0, 2); BLExtern("_free");
        HostLoad(0, 1); BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 1); HostStamp(); HostEnd();

        HostBegin("_zan_host_exedir");
        // Query required uint32 capacity, then retry with an allocated buffer.
        LoadImm(0, 0); HostSave(0, 0); AddImm(1, 31, 0);
        BLExtern("__NSGetExecutablePath");
        E4(0xB94003E0); // ldr w0, [sp] (size is uint32)
        HostNonzero(0, "exedir.query_size"); BLExtern("_malloc"); HostNonzero(0, "exedir.path.malloc"); HostSave(0, 1);
        AddImm(1, 31, 0); BLExtern("__NSGetExecutablePath"); HostZero32("exedir.get_path");
        HostLoad(0, 1); LoadImm(1, 0); BLExtern("_realpath"); HostNonzero(0, "exedir.realpath"); HostSave(0, 2);
        HostLoad(0, 1); BLExtern("_free");
        HostLoad(0, 2); LoadImm(1, 47); BLExtern("_strrchr"); HostNonzero(0, "exedir.dirname");
        HostLoad(1, 2); E4(0xCB010002); // sub x2, x0, x1 (dirname length)
        int nonroot = NL(); CbnzReg(2, nonroot); LoadImm(2, 1); Mark(nonroot);
        MovRR(0, 1); MovRR(1, 2); BLInternal("_zan_host_copy"); HostSave(0, 3);
        HostLoad(0, 2); BLExtern("_free"); HostLoad(0, 3); HostEnd();
    }

    void HostEmitSb() {
        HostBegin("_zan_host_sb_new");
        LoadImm(0, 40); LoadImm(1, 0); BLInternal("_zan_rt_alloc");
        // Core alloc is zero-filled, 40 = 16-byte header + 24-byte payload.
        HostEnd();

        HostBegin("_zan_host_sb_append");
        // (ptr sb, ptr s, i64 len): the CALL SITE supplies the length --
        // the managed stamp word for strings, strlen for the digit renders
        // (int2str's raw malloc buffer has no stamp, but its digits can
        // never hold a NUL). A strlen on a managed string would drop any
        // embedded NUL (UrlDecode's %00), so it is wrong there.
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        int empty = NL(); CbzReg(1, empty); // null append is empty
        HostLoad(1, 0); LdrU(2, 1, 0); HostSave(2, 3);
        HostLoad(0, 2);                        // x0 = len (call-site supplied)
        // need=count+len, reject carry and signed overflow before allocation.
        E4(0xAB020000); // adds x0, x0, x2
        int sumOK = NL(); EmitBcond(3, sumOK); HostFailAt("sb.append.size_carry"); Mark(sumOK);
        LoadImm(1, 0); HostCmp(0, 1);
        int positive = NL(); EmitBcond(10, positive); HostFailAt("sb.append.size_signed_overflow"); Mark(positive);
        HostSave(0, 4);
        HostLoad(1, 0); LdrU(2, 1, 8); HostCmp(0, 2);
        int enough = NL(); EmitBcond(9, enough); // unsigned ls
        // capacity = max(need, cap*2, 64); cap <= INT64_MAX / 2 else need.
        LoadImm(3, 4611686018427387903); HostCmp(2, 3);
        int useNeed = NL(); EmitBcond(8, useNeed);
        AddRR(2, 2, 2); HostCmp(2, 0); EmitBcond(2, useNeed);
        MovRR(2, 0);
        Mark(useNeed);
        // Overflow branch above must select need, not retain oversized cap.
        HostCmp(2, 3); int bounded = NL(); EmitBcond(9, bounded);
        HostLoad(2, 4); Mark(bounded);
        LoadImm(3, 64); HostCmp(2, 3); int minOK = NL(); EmitBcond(2, minOK);
        MovRR(2, 3); Mark(minOK); HostSave(2, 5);
        HostLoad(0, 0); LdrU(0, 0, 16); MovRR(1, 2); BLExtern("_realloc"); HostNonzero(0, "sb.grow.realloc");
        HostLoad(1, 0); StrU(0, 1, 16); HostLoad(2, 5); StrU(2, 1, 8);
        Mark(enough);
        HostLoad(0, 0); LdrU(0, 0, 16); HostLoad(1, 3); AddRR(0, 0, 1);
        HostLoad(1, 1); HostLoad(2, 2);
        int noCopy = NL(); CbzReg(2, noCopy); BLExtern("_memcpy"); Mark(noCopy);
        HostLoad(0, 0); HostLoad(1, 4); StrU(1, 0, 0);
        Mark(empty); HostLoad(0, 0); HostEnd();

        HostBegin("_zan_host_sb_string");
        LdrU(1, 0, 0); LdrU(0, 0, 16);
        // Empty builders have a null buffer: avoid even a zero-byte memcpy
        // with null by substituting a valid empty literal.
        int hasData = NL(); CbnzReg(0, hasData); LoadStr(emptyIdx, 0); Mark(hasData);
        BLInternal("_zan_host_copy"); HostEnd();
    }

    // ===================== extended conformance families =====================
    // Additive host surfaces behind the same hooks (HostExtRetTy feeds
    // HostCallRetTy, TryGenHostExtCall sits behind TryGenHostCall,
    // TryGenHostExtMember behind TryGenHostMember, HostEmitExt behind
    // EmitHostRuntime). Recognition only fires for members the user has not
    // defined, mirroring HostStatic's UserDefinesClsMember guard.
    //
    // Families: Hex, Base64, Sha256/Sha1/Md5/Sha512, Hmac.Sha256Mac (the
    // CommonCrypto entry points are re-exported by libSystem, so -lSystem
    // alone resolves them), Encoding.Base64Encode/UrlDecode/UrlEncode/
    // WebSocketAccept, Encoding.UTF8.GetBytes/GetString (U+FFFD replacement
    // identical to the stdlib Zan), string.ToBytes, byte[].ToStr,
    // Guid.New/Parse/ToString, Otp hash-algorithm constants and the missing
    // string ops (LastIndexOf/Trim/ToUpper/ToLower/StartsWith/EndsWith/
    // Equals/CompareTo/String.Format/string.Join). The byte-shaping helpers
    // reproduce the stdlib Zan implementations observable-for-observable.
    //
    // Layouts (must stay in lockstep with the core emitters):
    //  * string: 16-byte header, magic|byte length at ptr-8, NUL at ptr+len
    //  * array:  user ptr = raw+32; count at ptr-16; data at ptr+0 with
    //    8-byte element slots (byte arrays store one byte per slot)
    //  * List<T>: count at +0, cap at +8, data at +16 (8-byte slots)
    //
    // Runtime-ABI discipline is the host one: x0..x7 inputs, x0 result,
    // 128-byte frames, sp slots carry values across libc, loop bodies either
    // keep state in registers (no calls) or spill to slots (strncmp loops).

        int extTblHex;
        int extSlash;
        int extBSlash;
        int extDot;
        int extTmp;
        int extTmpDir;
        int extZero;
        int extDash;
        int extColon;
        int extSpace;
    int extTblB64;
    int extWsGuid;
    int extEmpty;
    int extTrue;
    int extFalse;
    int ioHome;
    int ioTemp;
    int ioTmp;
    int ioTmpdir;
    int ioXdgCfg;
    int ioDotConfig;
    int ioSlashTmp;
    int extDollar;

    // ---- codegen shorthands ----
    void ExtLsl(int rd, int rn, int n) { E4(0xD3400000 | (((64 - n) & 63) << 16) | ((63 - n) << 10) | (rn << 5) | rd); }
    void ExtLsr(int rd, int rn, int n) { E4(0xD3400000 | ((n & 63) << 16) | (63 << 10) | (rn << 5) | rd); }
    void ExtUbfmLo(int rd, int rn, int hi) { E4(0xD3400000 | ((hi & 63) << 10) | (rn << 5) | rd); } // rd = rn & ((1<<(hi+1))-1)
    void ExtLdrbImm(int rt, int rn, int imm) { E4(0x39400000 | (imm << 10) | (rn << 5) | rt); }
    void ExtStrbImm(int rt, int rn, int imm) { E4(0x39000000 | (imm << 10) | (rn << 5) | rt); }
    void ExtLdrbReg(int rt, int rn, int rm) { E4(0x38606800 | (rm << 16) | (rn << 5) | rt); }
    void ExtStrbReg(int rt, int rn, int rm) { E4(0x38206800 | (rm << 16) | (rn << 5) | rt); }
    void ExtOrr(int rd, int rn, int rm) { E4(0xAA000000 | (rm << 16) | (rn << 5) | rd); }
    void ExtSubRR(int rd, int rn, int rm) { E4(0xCB000000 | (rm << 16) | (rn << 5) | rd); }
    void ExtCmpImm(int rn, int imm) { E4(0xF1000000 | (imm << 10) | (rn << 5) | 31); }
    void ExtPush(int r) { E4(0xF81F0FE0 | r); }
    void ExtPop(int r) { E4(0xF84107E0 | r); }
    void ExtMov(int rd, int rm) { E4(0xAA000000 | (rm << 16) | (31 << 5) | rd); } // mov rd, rm (rn = xzr)
    void ExtStrScaled(int rt, int rn, int rm) { E4(0xF8207800 | (rm << 16) | (rn << 5) | rt); } // str xt, [xn, xm, lsl #3]
    void ExtUbfmR(int rd, int rn, int immr, int imms) { E4(0xD3400000 | ((immr & 63) << 16) | ((imms & 63) << 10) | (rn << 5) | rd); }
    void ExtUdiv(int rd, int rn, int rm) { E4(0x9AC00800 | (rm << 16) | (rn << 5) | rd); }
    void ExtMsub(int rd, int rn, int rm, int ra) { E4(0x9B008000 | (rm << 16) | (ra << 10) | (rn << 5) | rd); } // rd = ra - rn*rm
    void ExtMadd(int rd, int rn, int rm, int ra) { E4(0x9B000000 | (rm << 16) | (ra << 10) | (rn << 5) | rd); } // rd = ra + rn*rm

    // x0 = string -> x0 = byte length (header low 32 bits; null = 0)
    void ExtLenOf(int src, int dst) {
        int isn = NL(); int fin = NL();
        CbnzReg(src, isn);
        LoadImm(dst, 0); EmitB(fin);
        Mark(isn);
        AddImm(dst, src, -8);
        LdrU(dst, dst, 0);
        ExtUbfmLo(dst, dst, 31);
        Mark(fin);
    }

    // x0 = array -> x0 = element count (null = 0)
    void ExtCountOf(int src, int dst) {
        int isn = NL(); int fin = NL();
        CbnzReg(src, isn);
        LoadImm(dst, 0); EmitB(fin);
        Mark(isn);
        E4(0xF85F0000 | (src << 5) | dst);       // ldur dst, [src, #-16]
        Mark(fin);
    }

    // x0 = min(max(x0, 0), x1)
    void ExtClampLen() {
        ExtCmpImm(0, 0);
        int nonneg = NL();
        EmitBcond(10, nonneg);
        LoadImm(0, 0);
        Mark(nonneg);
        E4(0xEB01001F);                          // cmp x0, x1
        int ok = NL();
        EmitBcond(9, ok);                        // b.ls keep x0
        ExtMov(0, 1);
        Mark(ok);
    }

    // ---- recognition helpers ----

    // does this expression carry a scalar integer value? (Length member
    // accesses, integer literals, integer-typed locals/fields/statics/calls)
    bool ExtIsIntExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.IntLit()) { return true; }
        if (e.kind == AK.MemberAccess() && e.sval == "Length") { return true; }
        string t = null;
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { t = locTy[li]; }
            if (t == null) { Fld f = CurField(e.sval); if (f != null) { t = f.ty; } }
            if (t == null) { t = FindStaticTy(curCls, e.sval); }
        } else if (e.kind == AK.Call()) {
            t = CallRetTy(e);
        } else if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null) { t = f.ty; }
        }
        return t == "int" || t == "long" || t == "short" || t == "byte"
            || t == "sbyte" || t == "uint" || t == "ushort";
    }

    // dotted static-path receiver: matches Encoding.UTF8.GetBytes(...)
    bool ExtStaticQ(Node e, string path, string name, int count) {
        if (e == null || e.kind != AK.Call() || e.a == null) { return false; }
        Node m = e.a;
        if (m.kind != AK.MemberAccess() || m.sval != name) { return false; }
        Node r = m.a;
        bool walking = true;
        while (walking) {
            int dot = -1;
            int i = 0;
            while (i < path.Length) {
                if (path.Substring(i, 1) == ".") { dot = i; }
                i = i + 1;
            }
            string tail = dot >= 0 ? path.Substring(dot + 1, path.Length - dot - 1) : path;
            if (r == null || (r.kind != AK.Ident() && r.kind != AK.MemberAccess())
                    || r.sval != tail) { return false; }
            r = r.a;
            if (dot < 0) { walking = false; }
            else {
                path = path.Substring(0, dot);
                if (path.Length == 0) { return false; }
            }
        }
        return r == null && e.kids.Count == count;
    }

    // does this expression carry host byte-array identity (declared
    // array-typed local/field/static, a new array, or a call the host
    // itself types as an array)?
    bool ExtIsBytes(Node a) {
        if (a == null) { return false; }
        if (a.kind == AK.Call()) {
            string t = HostCallRetTy(a);
            if (t != null && t.Length > 1 && t.Substring(t.Length - 2, 2) == "[]") { return true; }
            // a stdlib/user static call declares its own result type:
            // Cls.Method(...) whose return type is an array
            if (a.a != null && a.a.kind == AK.MemberAccess() && a.a.a != null
                    && a.a.a.kind == AK.Ident()) {
                if (StatMethRetArrTy(a.a.a.sval, a.a.sval)) { return true; }
            }
            return false;
        }
        if (a.kind == AK.NewExpr() && a.ival == 1) { return true; }
        if (a.kind == AK.MemberAccess()) {
            // this.field / obj.field receivers (WebSocket's this.dataBuf,
            // TlsStream's this.scratch): the declared field type decides
            Fld f = FieldOf(a);
            return f != null && IsArrTy(f.ty);
        }
        if (a.kind == AK.Ident()) {
            int li = LocalIdx(a.sval);
            if (li >= 0) { return IsArrTy(locTy[li]); }
            Fld f = CurField(a.sval);
            if (f != null) { return IsArrTy(f.ty); }
            return IsArrTy(FindStaticTy(curCls, a.sval));
        }
        return false;
    }

    // is there a static method Cls.name whose declared return type is an
    // array type? (typing `Cls.name(...)` receivers for the ToStr/ToBytes
    // builtins, e.g. Hex.Decode(...).ToStr(...))
    bool StatMethRetArrTy(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return false; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) {
                string rt = TypeFullName(methNodes[cs[i]].type);
                return rt != null && rt.Length > 1
                    && rt.Substring(rt.Length - 2, 2) == "[]";
            }
            i = i + 1;
        }
        return false;
    }

    // ---- typing (consumed by CallRetTy through HostCallRetTy) ----

    string HostExtRetTy(Node e) {
        if (e == null || e.kind != AK.Call() || e.a == null
                || e.a.kind != AK.MemberAccess()) { return null; }
        string name = e.a.sval;
        Node r = e.a.a;
        int n = e.kids.Count;
        // instance families on string receivers (r may be any string expr);
        // name gate BEFORE IsStrExpr: typing the receiver re-walks
        // fluent-chain prefixes at every level (exponential in chain length)
        if (r != null && (name == "ToBytes" || name == "LastIndexOf"
                || name == "Contains" || name == "Split" || name == "Trim"
                || name == "ToUpper" || name == "ToLower" || name == "StartsWith"
                || name == "EndsWith" || name == "Equals" || name == "CompareTo")
                && IsStrExpr(r)) {
            if (name == "ToBytes" && n == 0 && !UserDefinesClsMember(null, "ToBytes")) { return "byte[]"; }
            if (!UserDefinesClsMember(null, name)) {
                if (name == "LastIndexOf" && n == 1) { return "int"; }
                if (name == "Contains" && n == 1) { return "bool"; }
                if (name == "Split" && n == 1) { return "List<string>"; }
                if (name == "Trim" && n == 0) { return "string"; }
                if ((name == "ToUpper" || name == "ToLower") && n == 0) { return "string"; }
                if ((name == "StartsWith" || name == "EndsWith") && n == 1) { return "bool"; }
                if (name == "Equals" && n == 1) { return "bool"; }
                if (name == "CompareTo" && n == 1) { return "int"; }
            }
        }
        // instance family on array receivers
        if (name == "ToStr" && (n == 0 || n == 2) && ExtIsBytes(r)
                && !UserDefinesClsMember(null, "ToStr")) { return "string"; }
        // scalar.ToString(): built-in property chains (Length/Count), plain
        // scalars and int property getters — the receiver carries no field
        // symbol, so the generic member path cannot type the call
        if (name == "ToString" && n == 0 && r != null
                && !UserDefinesClsMember(null, "ToString")
                && HostToStrArgKind(r) != null) { return "string"; }
        // dotted static families (Encoding.UTF8.*): the receiver is a
        // MemberAccess, so these must be claimed before the Ident-only gate
        if (ExtStaticQ(e, "Encoding.UTF8", "GetBytes", 1)) { return "byte[]"; }
        if (ExtStaticQ(e, "Encoding.UTF8", "GetString", 1)
                || ExtStaticQ(e, "Encoding.UTF8", "GetString", 3)) { return "string"; }
        if (r == null || r.kind != AK.Ident()) { return null; }
        string cls = r.sval;
        if ((cls == "Sha256" || cls == "Sha1" || cls == "Md5" || cls == "Sha512")
                && name == "Hash" && n == 2 && !UserDefinesClsMember(cls, "Hash")) { return "byte[]"; }
        if (cls == "Hmac" && name == "Sha256Mac" && n == 4
                && !UserDefinesClsMember("Hmac", "Sha256Mac")) { return "byte[]"; }
        if (cls == "Hex" && !UserDefinesClsMember("Hex", name)) {
            if (name == "Encode" && n == 2) { return "string"; }
            if (name == "Decode" && n == 1) { return "byte[]"; }
        }
        if (cls == "Base64" && name == "Encode" && n == 2
                && !UserDefinesClsMember("Base64", "Encode")) { return "string"; }
        if (cls == "Guid" && !UserDefinesClsMember("Guid", name)) {
            if (name == "New" && n == 0) { return "string"; }
            if (name == "Parse" && n == 1) { return "Guid"; }
            if (name == "ToString" && n == 1) { return "string"; }
        }
        if (cls == "Encoding" && !UserDefinesClsMember("Encoding", name)) {
            if (name == "Base64Encode" && n == 1) { return "string"; }
            if (name == "UrlDecode" && n == 1) { return "string"; }
            if (name == "UrlEncode" && n == 1) { return "string"; }
            if (name == "WebSocketAccept" && n == 1) { return "string"; }
        }
        if (cls == "Convert" && name == "ToString" && n == 1
                && !UserDefinesClsMember("Convert", "ToString")) {
            Node ca = e.kids[0];
            if (ExtIsIntExpr(ca) || IsBoolExpr(ca) || IsStrExpr(ca)) { return "string"; }
        }
        // String.Format / string.Join (both spellings of the class name)
        if ((cls == "String" || cls == "string") && !UserDefinesClsMember(cls, name)) {
            if (name == "Format" && n >= 1 && n <= 4) { return "string"; }
            if (name == "Join" && n == 2) { return "string"; }
        }
        return null;
    }

    // static constant reads (Otp.SHA1 / SHA256 / SHA512)
    bool TryGenHostExtMember(Node e) {
        if (e == null || e.kind != AK.MemberAccess() || e.a == null) { return false; }
        if (e.a.kind == AK.Ident() && e.a.sval == "Otp" && !UserDefinesClsMember("Otp", e.sval)) {
            if (e.sval == "SHA1") { LoadImm(0, 1); return true; }
            if (e.sval == "SHA256") { LoadImm(0, 2); return true; }
            if (e.sval == "SHA512") { LoadImm(0, 3); return true; }
        }
        return false;
    }

    // ---- call generation ----

    bool TryGenHostExtCall(Node e) {
        if (e == null || e.kind != AK.Call() || e.a == null
                || e.a.kind != AK.MemberAccess()) { return false; }
        string name = e.a.sval;
        Node r = e.a.a;
        int n = e.kids.Count;

        // ---- string instance ops ----
        if (r != null && IsStrExpr(r)) {
            if (n == 0 && name == "ToBytes" && !UserDefinesClsMember(null, "ToBytes")) {
                GenExpr(r);
                BLInternal("_zan_ext_to_bytes");
                return true;
            }
            if (!UserDefinesClsMember(null, name)) {
                if (n == 0 && (name == "ToLower" || name == "ToUpper" || name == "Trim")) {
                    GenExpr(r);
                    BLInternal(name == "ToLower" ? "_zan_ext_str_lower"
                        : name == "ToUpper" ? "_zan_ext_str_upper" : "_zan_ext_str_trim");
                    return true;
                }
                if (n == 1 && name == "Contains") {
                    GenExpr(r);
                    ExtPush(0);
                    GenExpr(e.kids[0]);
                    if (IsCharExpr(e.kids[0])) { BLInternal("_zan_rt_chrstr"); }
                    ExtPush(0);
                    ExtPop(1);                     // x1 = the needle
                    ExtPop(0);                     // x0 = the receiver
                    BLInternal("_zan_ext_str_contains");
                    return true;
                }
                if (n == 1 && name == "Split") {
                    // str.Split(sep) -> fresh List<string> of every segment
                    // (empty separator yields the whole string; empty
                    // segments are kept, including the tail)
                    GenExpr(r);
                    ExtPush(0);
                    GenExpr(e.kids[0]);
                    if (IsCharExpr(e.kids[0])) { BLInternal("_zan_rt_chrstr"); }
                    ExtPush(0);
                    LoadImm(0, 4);
                    BLInternal("_zan_host_list_new");
                    ExtPush(0);                    // list (top of stack)
                    ExtPop(2);                     // x2 = list
                    ExtPop(1);                     // x1 = sep
                    ExtPop(0);                     // x0 = receiver
                    BLInternal("_zan_str_split");  // returns the list in x0
                    return true;
                }
                if (n == 1 && (name == "StartsWith" || name == "EndsWith"
                        || name == "Equals" || name == "CompareTo" || name == "LastIndexOf")) {
                    GenExpr(r);
                    ExtPush(0);
                    GenExpr(e.kids[0]);
                    ExtPush(0);
                    ExtPop(1);                     // x1 = the argument
                    ExtPop(0);                     // x0 = the receiver
                    BLInternal(name == "StartsWith" ? "_zan_ext_str_startswith"
                        : name == "EndsWith" ? "_zan_ext_str_endswith"
                        : name == "Equals" ? "_zan_ext_str_equals"
                        : name == "CompareTo" ? "_zan_ext_str_compareto"
                        : "_zan_ext_str_lastidx");
                    return true;
                }
            }
        }
        // ---- scalar.ToString(): built-in property chains (xs.Count,
        // sb.Length, arr.Length, s.Length), plain int/bool/char/double/ulong
        // values and int property getters ----
        if (n == 0 && name == "ToString" && r != null
                && !UserDefinesClsMember(null, "ToString")) {
            string k = HostToStrArgKind(r);
            if (k != null) {
                if (k == "strlen") {
                    GenExpr(r.a);                  // string pointer
                    E4(0xD1002009);                // sub x9, x0, #8
                    E4(0xF9400120);                // ldr x0, [x9]
                    E4(0xD3407C00);                // ubfm x0, x0, #0, #31
                } else {
                    GenExpr(r);
                }
                if (k == "bool") {
                    int bf = NL(); int bd = NL();
                    CbzReg(0, bf);
                    LoadStr(extTrue, 0);
                    EmitB(bd);
                    Mark(bf);
                    LoadStr(extFalse, 0);
                    Mark(bd);
                }
                else if (k == "char") { BLInternal("_zan_rt_chrstr"); }
                else if (k == "double") { BLInternal("_zan_rt_dbl2str"); }
                else if (k == "ulong") { BLInternal("_zan_rt_uint2str"); }
                else { BLInternal("_zan_rt_int2str"); }
                return true;
            }
        }
        // ---- String.Format / string.Join (both class spellings) ----
        if (r != null && r.kind == AK.Ident()
                && (r.sval == "String" || r.sval == "string")) {
            if (name == "Format" && n >= 1 && n <= 4
                    && !UserDefinesClsMember(r.sval, "Format")) {
                GenExpr(e.kids[0]);
                ExtPush(0);                        // fmt
                int ai = 1;
                while (ai < n) {
                    Node ag = e.kids[ai];
                    if (IsStrExpr(ag)) { GenExpr(ag); }
                    else if (ExtIsIntExpr(ag)) { GenExpr(ag); BLInternal("_zan_rt_int2str"); }
                    else if (IsBoolExpr(ag)) {
                        GenExpr(ag);
                        int bf = NL(); int bd = NL();
                        CbzReg(0, bf);
                        LoadStr(extTrue, 0);
                        EmitB(bd);
                        Mark(bf);
                        LoadStr(extFalse, 0);
                        Mark(bd);
                    }
                    else if (IsCharExpr(ag)) { GenExpr(ag); BLInternal("_zan_rt_chrstr"); }
                    else if (IsDblExpr(ag)) { GenExpr(ag); BLInternal("_zan_rt_dbl2str"); }
                    else if (IsUlongExpr(ag)) { GenExpr(ag); BLInternal("_zan_rt_uint2str"); }
                    else {
                        diags.Error("ngen host: unsupported String.Format argument type", ag.line, ag.col);
                        LoadStr(extEmpty, 0);
                    }
                    ExtPush(0);
                    ai = ai + 1;
                }
                if (n >= 4) { ExtPop(4); }         // arg2
                if (n >= 3) { ExtPop(3); }         // arg1
                if (n >= 2) { ExtPop(2); }         // arg0
                ExtPop(0);                         // fmt
                LoadImm(1, n - 1);                 // argc
                BLInternal("_zan_ext_str_format");
                return true;
            }
            if (name == "Join" && n == 2
                    && !UserDefinesClsMember(r.sval, "Join")) {
                GenExpr(e.kids[1]);
                ExtPush(0);                        // list
                GenExpr(e.kids[0]);                // sep -> x0
                ExtPop(1);                         // x1 = list
                BLInternal("_zan_ext_str_join");
                return true;
            }
        }
        // ---- Encoding.UTF8 static family ----
        if (ExtStaticQ(e, "Encoding.UTF8", "GetBytes", 1)
                && !UserDefinesClsMember("Encoding", "GetBytes")) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_to_bytes");
            return true;
        }
        if (ExtStaticQ(e, "Encoding.UTF8", "GetString", 1)
                && !UserDefinesClsMember("Encoding", "GetString")) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_utf8_getstring1");
            return true;
        }
        if (ExtStaticQ(e, "Encoding.UTF8", "GetString", 3)
                && !UserDefinesClsMember("Encoding", "GetString")) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            ExtPop(2); ExtPop(1); ExtPop(0);
            BLInternal("_zan_ext_utf8_getstring3");
            return true;
        }
        // ---- byte[] instance ops ----
        if ((n == 0 || n == 2) && name == "ToStr" && ExtIsBytes(r)
                && !UserDefinesClsMember(null, "ToStr")) {
            GenExpr(r);
            ExtPush(0);                        // arr
            if (n == 2) {
                GenExpr(e.kids[0]);
                ExtPush(0);
                GenExpr(e.kids[1]);
                ExtPush(0);
            } else {
                ExtCountOf(0, 9);              // whole-array length (x0 = arr)
                LoadImm(0, 0);                 // start
                ExtPush(0);                    // start
                ExtPush(9);                    // len (top -> x2)
            }
            // stack (top down): len, start, arr
            ExtPop(2); ExtPop(1); ExtPop(0);
            BLInternal("_zan_ext_arr_slice_str");
            return true;
        }
        if (r == null || r.kind != AK.Ident()) { return false; }
        string cls = r.sval;

        // ---- Convert.ToString: int-ish -> decimal, bool -> true/false,
        // string -> identity ----
        if (cls == "Convert" && name == "ToString" && n == 1
                && !UserDefinesClsMember("Convert", "ToString")) {
            Node ca = e.kids[0];
            if (ExtIsIntExpr(ca)) { GenExpr(ca); BLInternal("_zan_rt_int2str"); return true; }
            if (IsBoolExpr(ca)) {
                // the reference renders Convert.ToString(bool) as "1"/"0"
                GenExpr(ca);
                int cbf = NL(); int cbd = NL();
                CbzReg(0, cbf);
                LoadImm(0, 1);
                EmitB(cbd);
                Mark(cbf);
                LoadImm(0, 0);
                Mark(cbd);
                BLInternal("_zan_rt_int2str");
                return true;
            }
            if (IsStrExpr(ca)) { GenExpr(ca); return true; }
        }
        // ---- Guid family (Parse returns an opaque handle that IS the
        // canonical lowercase text; ToString is the identity on it) ----
        if (cls == "Guid" && !UserDefinesClsMember("Guid", name)) {
            if (name == "New" && n == 0) { BLInternal("_zan_ext_guid_new"); return true; }
            if (name == "Parse" && n == 1) {
                GenExpr(e.kids[0]);
                BLInternal("_zan_ext_guid_parse");
                return true;
            }
            if (name == "ToString" && n == 1) {
                GenExpr(e.kids[0]);                // identity on the handle
                return true;
            }
        }
        // ---- Encoding.UrlDecode / UrlEncode / WebSocketAccept ----
        if (cls == "Encoding" && n == 1 && !UserDefinesClsMember("Encoding", name)) {
            if (name == "UrlDecode") { GenExpr(e.kids[0]); BLInternal("_zan_ext_urldecode"); return true; }
            if (name == "UrlEncode") { GenExpr(e.kids[0]); BLInternal("_zan_ext_urlencode"); return true; }
            if (name == "WebSocketAccept") { GenExpr(e.kids[0]); BLInternal("_zan_ext_wsaccept"); return true; }
        }

        // ---- digests ----
        if ((cls == "Sha256" || cls == "Sha1" || cls == "Md5" || cls == "Sha512")
                && name == "Hash" && n == 2 && !UserDefinesClsMember(cls, "Hash")) {
            GenExpr(e.kids[0]);
            ExtPush(0);
            GenExpr(e.kids[1]);
            ExtPush(0);
            ExtPop(1);
            ExtPop(0);
            BLInternal(cls == "Sha256" ? "_zan_ext_sha256" : cls == "Sha1" ? "_zan_ext_sha1" : cls == "Md5" ? "_zan_ext_md5" : "_zan_ext_sha512");
            return true;
        }
        if (cls == "Hmac" && name == "Sha256Mac" && n == 4
                && !UserDefinesClsMember("Hmac", "Sha256Mac")) {
            int hi = 0;
            while (hi < 4) { GenExpr(e.kids[hi]); ExtPush(0); hi = hi + 1; }
            ExtPop(3); ExtPop(2); ExtPop(1); ExtPop(0);
            BLInternal("_zan_ext_hmac_sha256");
            return true;
        }
        // ---- Hex ----
        if (cls == "Hex" && name == "Encode" && n == 2
                && !UserDefinesClsMember("Hex", "Encode")) {
            bool fromBytes = ExtIsBytes(e.kids[0]);
            GenExpr(e.kids[0]);
            ExtPush(0);
            GenExpr(e.kids[1]);
            ExtPush(0);
            ExtPop(1);
            ExtPop(0);
            if (fromBytes) { ExtCountOf(0, 9); } else { ExtLenOf(0, 9); }
            E4(0xEB09003F);                    // cmp x1, x9
            int okh = NL();
            EmitBcond(9, okh);                 // b.ls keep the request
            ExtMov(1, 9);                      // clamp to available
            Mark(okh);
            LoadImm(2, fromBytes ? 8 : 1);
            BLInternal("_zan_ext_hex_encode");
            return true;
        }
        if (cls == "Hex" && name == "Decode" && n == 1
                && !UserDefinesClsMember("Hex", "Decode")) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_hex_decode");
            return true;
        }
        // ---- Base64 ----
        if (cls == "Base64" && name == "Encode" && n == 2
                && !UserDefinesClsMember("Base64", "Encode")) {
            bool fromBytes = ExtIsBytes(e.kids[0]);
            GenExpr(e.kids[0]);
            ExtPush(0);
            GenExpr(e.kids[1]);
            ExtPush(0);
            ExtPop(1);
            ExtPop(0);
            if (fromBytes) { ExtCountOf(0, 9); } else { ExtLenOf(0, 9); }
            E4(0xEB09003F);
            int okb = NL();
            EmitBcond(9, okb);
            ExtMov(1, 9);
            Mark(okb);
            LoadImm(2, fromBytes ? 8 : 1);
            BLInternal("_zan_ext_b64_encode");
            return true;
        }
        if (cls == "Encoding" && name == "Base64Encode" && n == 1
                && !UserDefinesClsMember("Encoding", "Base64Encode")) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_b64_str");
            return true;
        }
        return false;
    }

    // ===================== extended runtime emitters =====================

    void HostEmitExt() {
        extTblHex = InternStr("0123456789abcdef");
        extTblB64 = InternStr("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/");
        extWsGuid = InternStr("258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
        extEmpty = InternStr("");
        extTrue = InternStr("true");
        extFalse = InternStr("false");
        extSlash = InternStr("/");
        extBSlash = InternStr("\\");
        extDot = InternStr(".");
        extTmp = InternStr("/tmp/");
        extTmpDir = InternStr("TMPDIR");
        extZero = InternStr("0");
        extDash = InternStr("-");
        extColon = InternStr(":");
        extSpace = InternStr(" ");
        HostEmitArrNew();
        HostEmitSlotCopy();
        HostEmitToBytes();
        HostEmitSlice();
        HostEmitHexDecode();
        HostEmitB64();
        HostEmitDigests();
        HostEmitUtf8();
        HostEmitUrl();
        HostEmitWsAccept();
        HostEmitGuid();
        HostEmitStrOps();
        HostEmitStrFormat();
        HostEmitStrJoin();
        HostEmitPath();
        HostEmitDt();
        HostEmitIo();
    }

    // host frame with room for a 160-byte struct stat buffer above the
    // 16 slot words (buffer base = sp + 128)
    void HostBeginN(string sym, int extra) {
        syms.Add(new Sym(sym, txt.Count));
        RtPrologue(); AddSPImm(128 + extra, false);
    }
    void HostEndN(int extra) { AddSPImm(128 + extra, true); RtEpilogue(); }

    // 32-bit status register tests (C int results do not sign-extend x0)
    void HostCbzW(int lbl) { E4(0x7100001F); EmitBcond(0, lbl); }
    void HostCbnzW(int lbl) { E4(0x7100001F); EmitBcond(1, lbl); }

    // ---- System.IO.Path: pure string surgery over '/' and '\\' ----

    // x0 = string, x1 = start, x2 = count -> owned stamped copy of
    // s[start..start+count). Clamps negative start/count and counts past
    // the end, mirroring String.Substring.
    void HostEmitPathSlice() {
        HostBegin("_zan_ext_path_slice");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        HostLoad(9, 0);
        ExtLenOf(9, 11);                       // len
        LoadImm(10, 0);
        HostLoad(1, 1);
        HostCmp(1, 10);
        int sOk = NL(); EmitBcond(10, sOk);    // start >= 0
        HostSave(10, 1);                       // start = 0
        Mark(sOk);
        HostLoad(2, 2);
        HostCmp(2, 10);
        int cOk = NL(); EmitBcond(10, cOk);    // count >= 0
        HostSave(10, 2);                       // count = 0
        Mark(cOk);
        HostLoad(1, 1);
        ExtSubRR(11, 11, 1);                   // avail = len - start
        HostLoad(2, 2);
        HostCmp(2, 11);
        int c2Ok = NL(); EmitBcond(11, c2Ok);  // count <= avail
        ExtMov(2, 11);
        HostSave(2, 2);
        Mark(c2Ok);
        HostLoad(0, 2); AddImm(0, 0, 1);       // + NUL
        BLExtern("_malloc");
        HostNonzero(0, "ext.path.slice.malloc");
        HostSave(0, 3);                        // base
        MovRR(14, 0);                          // cursor
        HostLoad(9, 0); HostLoad(12, 1); AddRR(9, 9, 12); // src = s + start
        HostLoad(13, 2);                       // remaining
        int pFin = NL(); int pLoop = NL();
        EmitB(pLoop);
        Mark(pLoop);
        HostCmp(13, 31);
        EmitBcond(0, pFin);                    // remaining == 0
        ExtLdrbReg(0, 9, 31);                  // *src
        ExtStrbImm(0, 14, 0);
        AddImm(9, 9, 1);
        AddImm(14, 14, 1);
        AddImm(13, 13, -1);
        EmitB(pLoop);
        Mark(pFin);
        ExtStrbImm(31, 14, 0);                 // NUL
        HostLoad(10, 3);
        ExtMov(0, 14);
        ExtSubRR(1, 0, 10);                    // produced
        ExtMov(0, 10);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 5); HostSave(1, 6);
        HostLoad(0, 6);
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();
    }

    // x0 = path -> index of the last '/' or '\\' (max of both), else -1.
    void HostEmitPathAfterSep() {
        HostBegin("_zan_ext_path_aftersep");
        HostSave(0, 0);
        HostLoad(0, 0);
        LoadStr(extSlash, 1);
        BLInternal("_zan_ext_str_lastidx");
        HostSave(0, 1);                        // slash idx (x10 is caller-saved)
        HostLoad(0, 0);
        LoadStr(extBSlash, 1);
        BLInternal("_zan_ext_str_lastidx");    // bslash idx
        HostLoad(10, 1);
        HostCmp(10, 0);
        int keep = NL(); EmitBcond(10, keep);  // slash >= bslash (signed)
        ExtMov(10, 0);
        Mark(keep);
        ExtMov(0, 10);
        HostEnd();
    }

    // x0 = path -> filename portion after the last separator.
    void HostEmitPathFile() {
        HostBegin("_zan_ext_path_filename");
        HostSave(0, 0);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_aftersep");
        ExtMov(10, 0);                         // sep idx (-1 included)
        HostLoad(0, 0);
        ExtLenOf(0, 11);                       // len
        AddImm(1, 10, 1);                      // start = idx + 1
        ExtSubRR(2, 11, 1);                    // count = len - start
        BLInternal("_zan_ext_path_slice");
        HostEnd();
    }

    // x0 = path -> portion before the last separator ("" if none).
    void HostEmitPathDir() {
        HostBegin("_zan_ext_path_dirname");
        HostSave(0, 0);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_aftersep");
        ExtMov(10, 0);
        LoadImm(9, 0);
        HostCmp(10, 9);
        int has = NL(); EmitBcond(10, has);    // idx >= 0
        LoadStr(extEmpty, 0);
        int fin = NL(); EmitB(fin);
        Mark(has);
        HostLoad(0, 0);
        LoadImm(1, 0);
        ExtMov(2, 10);                         // count = idx
        BLInternal("_zan_ext_path_slice");
        Mark(fin);
        HostEnd();
    }

    // x0 = path -> extension including the dot ("" if none). The dot must
    // lie in the filename portion: "a.b/c" has no extension.
    void HostEmitPathExt() {
        HostBegin("_zan_ext_path_extension");
        HostSave(0, 0);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_filename");
        HostSave(0, 1);                        // filename
        HostLoad(0, 1);
        LoadStr(extDot, 1);
        BLInternal("_zan_ext_str_lastidx");
        HostSave(0, 2);                        // dot idx
        LoadImm(9, 0);
        HostLoad(11, 2);
        HostCmp(11, 9);
        int has = NL(); EmitBcond(10, has);
        LoadStr(extEmpty, 0);
        int fin = NL(); EmitB(fin);
        Mark(has);
        HostLoad(0, 1);
        ExtLenOf(0, 9);                        // flen
        HostLoad(1, 2);                        // start = dot
        ExtSubRR(2, 9, 1);                     // count = flen - dot
        BLInternal("_zan_ext_path_slice");
        Mark(fin);
        HostEnd();
    }

    // x0 = path -> filename without its extension.
    void HostEmitPathStem() {
        HostBegin("_zan_ext_path_stem");
        HostSave(0, 0);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_filename");
        HostSave(0, 1);                        // filename
        HostLoad(0, 1);
        LoadStr(extDot, 1);
        BLInternal("_zan_ext_str_lastidx");
        HostSave(0, 2);                        // dot idx
        LoadImm(9, 0);
        HostLoad(11, 2);
        HostCmp(11, 9);
        int has = NL(); EmitBcond(10, has);
        HostLoad(0, 1);                        // no dot: filename itself
        HostEnd();
        Mark(has);
        HostLoad(0, 1);
        LoadImm(1, 0);
        HostLoad(2, 2);                        // count = dot
        BLInternal("_zan_ext_path_slice");
        HostEnd();
    }

    // x0 = path, x1 = new extension. A filename dot (after the last
    // separator) is replaced; otherwise the extension is appended.
    void HostEmitPathChangeExt() {
        HostBegin("_zan_ext_path_changeext");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_aftersep");
        HostSave(0, 2);                        // sep idx
        HostLoad(0, 0);
        LoadStr(extDot, 1);
        BLInternal("_zan_ext_str_lastidx");
        HostSave(0, 3);                        // dot idx
        HostLoad(11, 3);
        HostLoad(10, 2);
        HostCmp(11, 10);
        int keep = NL(); EmitBcond(10, keep);  // dot in filename portion
        LoadImm(11, -1);
        HostSave(11, 3);
        Mark(keep);
        LoadImm(9, 0);
        HostLoad(11, 3);
        HostCmp(11, 9);
        int nodot = NL(); EmitBcond(11, nodot);
        int fin = NL(); EmitB(fin);
        Mark(nodot);
        HostLoad(0, 0); HostLoad(1, 1);
        BLInternal("_zan_rt_strcat2");
        HostEnd();
        Mark(fin);
        HostLoad(0, 0);
        LoadImm(1, 0);
        HostLoad(2, 3);
        BLInternal("_zan_ext_path_slice");     // base
        HostLoad(1, 1);                        // ext
        BLInternal("_zan_rt_strcat2");
        HostEnd();
    }

    // x0, x1 -> a + "/" + b (the oracle concatenates unconditionally).
    void HostEmitPathCombine() {
        HostBegin("_zan_ext_path_combine");
        HostSave(1, 0);                        // b
        LoadStr(extSlash, 1);
        BLInternal("_zan_rt_strcat2");         // a + "/"
        HostLoad(1, 0);
        BLInternal("_zan_rt_strcat2");
        HostEnd();
    }

    // -> $TMPDIR (stamped) or "/tmp/".
    void HostEmitPathTemp() {
        HostBegin("_zan_ext_path_temppath");
        LoadStr(extTmpDir, 0);
        BLExtern("_getenv");
        int have = NL(); CbnzReg(0, have);
        LoadStr(extTmp, 0);
        HostEnd();
        Mark(have);
        HostSave(0, 0);
        HostLoad(0, 0);
        BLExtern("_strlen");
        ExtMov(1, 0);
        HostLoad(0, 0);
        BLInternal("_zan_host_copy");
        HostEnd();
    }

    void HostEmitPath() {
        HostEmitPathSlice();
        HostEmitPathAfterSep();
        HostEmitPathFile();
        HostEmitPathDir();
        HostEmitPathExt();
        HostEmitPathStem();
        HostEmitPathChangeExt();
        HostEmitPathCombine();
        HostEmitPathTemp();
    }

    // ---- System.DateTime: civil calendar math, no clock reads ----

    // x0 = a, x1 = b (> 0) -> floor remainder a mod b.
    void HostEmitDtFloormod() {
        HostBegin("_zan_dt_floormod");
        E4(0x9AC10C09);                        // sdiv x9, x0, x1
        E4(0x9B01812A);                        // msub x10 = x0 - x9*x1 (r)
        ExtMov(11, 0);                         // a
        ExtMov(0, 10);                         // r
        int done = NL();
        HostCmp(10, 31);
        EmitBcond(0, done);                    // r == 0
        HostCmp(11, 31);
        EmitBcond(10, done);                   // a >= 0
        AddRR(0, 0, 1);                        // r + b
        Mark(done);
        HostEnd();
    }

    // x0 = a, x1 = b (> 0) -> floor(a / b).
    void HostEmitDtFloordiv() {
        HostBegin("_zan_dt_floordiv");
        HostSave(0, 0); HostSave(1, 1);
        BLInternal("_zan_dt_floormod");        // r
        HostLoad(9, 0);
        HostLoad(10, 1);
        ExtSubRR(9, 9, 0);                     // a - r
        E4(0x9ACA0D20);                        // sdiv x0, x9, x10
        HostEnd();
    }

    // x0 = unix seconds -> fresh 64-byte DateTime object
    // {epoch@0, year@8, month@16, day@24, hour@32, minute@40, second@48,
    // dayOfWeek@56}, desc stamped with the throw-magic site.
    void HostEmitDtFromUnix() {
        HostBegin("_zan_dt_from_unix");
        HostSave(0, 0);                        // ts
        HostLoad(0, 0); LoadImm(1, 86400);
        BLInternal("_zan_dt_floordiv");
        HostSave(0, 1);                        // days
        // sod = ts - days * 86400
        HostLoad(9, 1); LoadImm(10, 86400); HostLoad(11, 0);
        E4(0x9B008000 | (10 << 16) | (11 << 10) | (9 << 5)); // msub x0,x9,x10,x11
        HostSave(0, 2);                        // sod
        HostLoad(9, 2); LoadImm(10, 3600);
        E4(0x9ACA0D20);                        // sdiv x0, x9, x10
        HostSave(0, 3);                        // hour
        HostLoad(9, 2); LoadImm(10, 60);
        E4(0x9ACA0D20);                        // x0 = sod / 60
        HostLoad(10, 3); LoadImm(11, 60);
        E4(0x9B008000 | (11 << 16) | (0 << 10) | (10 << 5)); // - hour*60
        HostSave(0, 4);                        // minute
        HostLoad(9, 2); HostLoad(10, 3); LoadImm(11, 3600);
        E4(0x9B008000 | (11 << 16) | (9 << 10) | (10 << 5)); // sod - hour*3600
        HostLoad(10, 4); LoadImm(11, 60);
        E4(0x9B008000 | (11 << 16) | (0 << 10) | (10 << 5)); // - minute*60
        HostSave(0, 5);                        // second
        HostLoad(0, 1); LoadImm(9, 4); AddRR(0, 0, 9); LoadImm(1, 7);
        BLInternal("_zan_dt_floormod");
        HostSave(0, 6);                        // dayOfWeek
        // civil-from-days (Hinnant); intermediates are all non-negative.
        HostLoad(0, 1); LoadImm(9, 719468); AddRR(0, 0, 9);
        HostSave(0, 7);                        // z
        HostLoad(0, 7); LoadImm(1, 146097);
        BLInternal("_zan_dt_floordiv");
        HostSave(0, 8);                        // era
        HostLoad(9, 7); HostLoad(10, 8); LoadImm(11, 146097);
        E4(0x9B008000 | (11 << 16) | (9 << 10) | (10 << 5)); // doe = z - era*146097
        HostSave(0, 9);                        // doe
        HostLoad(9, 9); LoadImm(10, 1460);
        E4(0x9ACA0D20);                        // doe / 1460
        ExtMov(12, 0);
        HostLoad(9, 9); LoadImm(10, 36524);
        E4(0x9ACA0D20);                        // doe / 36524
        ExtMov(13, 0);
        HostLoad(9, 9); LoadImm(10, 146096);
        E4(0x9ACA0D20);                        // doe / 146096
        ExtMov(14, 0);
        HostLoad(9, 9);
        ExtSubRR(9, 9, 12); AddRR(9, 9, 13); ExtSubRR(9, 9, 14);
        LoadImm(10, 365);
        E4(0x9ACA0D20);                        // yoe
        HostSave(0, 10);
        HostLoad(9, 10); HostLoad(10, 8); LoadImm(11, 400);
        E4(0x9B000000 | (11 << 16) | (9 << 10) | (10 << 5)); // y = yoe + era*400
        HostSave(0, 11);                       // y
        HostLoad(9, 10); LoadImm(10, 4);
        E4(0x9ACA0D20);                        // yoe / 4
        ExtMov(12, 0);
        HostLoad(9, 10); LoadImm(10, 100);
        E4(0x9ACA0D20);                        // yoe / 100
        ExtMov(13, 0);
        LoadImm(10, 365); HostLoad(9, 10); LoadImm(11, 0);
        E4(0x9B000000 | (9 << 16) | (11 << 10) | (10 << 5)); // 365*yoe
        AddRR(0, 0, 12); ExtSubRR(0, 0, 13);   // inner
        HostLoad(9, 9);
        ExtSubRR(0, 9, 0);                     // doy = doe - inner
        HostSave(0, 12);
        HostLoad(9, 12); LoadImm(10, 5); LoadImm(11, 2);
        E4(0x9B000000 | (9 << 16) | (11 << 10) | (10 << 5)); // 5*doy + 2
        LoadImm(10, 153);
        E4(0x9ACA0C00);                        // sdiv x0, x0, x10
        HostSave(0, 13);                       // mp
        HostLoad(9, 13); LoadImm(10, 153); LoadImm(11, 2);
        E4(0x9B000000 | (9 << 16) | (11 << 10) | (10 << 5)); // 153*mp + 2
        LoadImm(10, 5);
        E4(0x9ACA0C00);                        // / 5
        HostLoad(9, 12);
        ExtSubRR(0, 9, 0); AddImm(0, 0, 1);    // d
        HostSave(0, 14);
        HostLoad(0, 13); AddImm(0, 0, 3);
        HostSave(0, 15);                       // m = mp + 3
        HostLoad(9, 13); LoadImm(10, 10); HostCmp(9, 10);
        int lt = NL(); EmitBcond(11, lt);
        HostLoad(0, 13); AddImm(0, 0, -9); HostSave(0, 15);
        Mark(lt);
        HostLoad(9, 15); LoadImm(10, 2); HostCmp(9, 10);
        int gt = NL(); EmitBcond(12, gt);
        HostLoad(0, 11); AddImm(0, 0, 1); HostSave(0, 11);
        Mark(gt);
        LoadImm(0, 64); LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        HostNonzero(0, "dt.fromunix.alloc");
        LoadImm(2, 0x5A414E5300000000);
        RtStur(2, 0, -8);                      // throw-magic desc site
        HostLoad(9, 0); StrU(9, 0, 0);         // epoch
        HostLoad(9, 11); StrU(9, 0, 8);        // year
        HostLoad(9, 15); StrU(9, 0, 16);       // month
        HostLoad(9, 14); StrU(9, 0, 24);       // day
        HostLoad(9, 3); StrU(9, 0, 32);        // hour
        HostLoad(9, 4); StrU(9, 0, 40);        // minute
        HostLoad(9, 5); StrU(9, 0, 48);        // second
        HostLoad(9, 6); StrU(9, 0, 56);        // dayOfWeek
        HostEnd();
    }

    // x0 = y, x1 = m, x2 = d -> days since 1970-01-01 (DaysFromCivil).
    void HostEmitDtDfc() {
        HostBegin("_zan_dt_dfc");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        // y2 = m <= 2 ? y - 1 : y
        HostLoad(9, 1); LoadImm(10, 2); HostCmp(9, 10);
        int le = NL(); EmitBcond(13, le);      // b.le
        HostLoad(9, 0);                        // m > 2: y
        int sk = NL(); EmitB(sk);
        Mark(le);
        HostLoad(9, 0); AddImm(9, 9, -1);      // m <= 2: y - 1
        Mark(sk);
        HostSave(9, 3);                        // y2
        HostLoad(0, 3); LoadImm(1, 400);
        BLInternal("_zan_dt_floordiv");
        HostSave(0, 4);                        // era
        HostLoad(9, 3); HostLoad(10, 4); LoadImm(11, 400);
        E4(0x9B008000 | (11 << 16) | (9 << 10) | (10 << 5)); // yoe = y2 - era*400
        HostSave(0, 5);
        // mp = m <= 2 ? m + 9 : m - 3
        HostLoad(9, 1); LoadImm(10, 2); HostCmp(9, 10);
        int le2 = NL(); EmitBcond(13, le2);    // b.le
        HostLoad(9, 1); LoadImm(10, 3); ExtSubRR(9, 9, 10);   // m > 2: m - 3
        int sk2 = NL(); EmitB(sk2);
        Mark(le2);
        HostLoad(9, 1); AddImm(9, 9, 9);       // m <= 2: m + 9
        Mark(sk2);
        HostSave(9, 6);                        // mp
        // doy = (153*mp + 2) / 5 + d - 1
        HostLoad(9, 6); LoadImm(10, 153); LoadImm(11, 2);
        E4(0x9B000000 | (9 << 16) | (11 << 10) | (10 << 5));
        LoadImm(10, 5);
        E4(0x9ACA0C00);                        // sdiv x0, x0, x10
        HostLoad(9, 2);
        AddRR(0, 0, 9); AddImm(0, 0, -1);
        HostSave(0, 7);                        // doy
        // doe = yoe*365 + yoe/4 - yoe/100 + doy
        HostLoad(9, 5); LoadImm(10, 4);
        E4(0x9ACA0D20);                        // yoe / 4
        ExtMov(12, 0);
        HostLoad(9, 5); LoadImm(10, 100);
        E4(0x9ACA0D20);                        // yoe / 100
        ExtMov(13, 0);
        LoadImm(10, 365); HostLoad(9, 5); LoadImm(11, 0);
        E4(0x9B000000 | (9 << 16) | (11 << 10) | (10 << 5)); // 365*yoe
        AddRR(0, 0, 12); ExtSubRR(0, 0, 13);
        HostLoad(9, 7);
        AddRR(0, 0, 9);
        HostSave(0, 8);                        // doe
        // era*146097 + doe - 719468
        HostLoad(9, 4); LoadImm(10, 146097); HostLoad(11, 8);
        E4(0x9B000000 | (10 << 16) | (11 << 10) | (9 << 5));
        LoadImm(9, 719468);
        ExtSubRR(0, 0, 9);
        HostEnd();
    }

    // x0 = y, x1 = m, x2 = d -> DateTime at midnight UTC.
    void HostEmitDtFromDate() {
        HostBegin("_zan_dt_from_date");
        BLInternal("_zan_dt_dfc");
        LoadImm(9, 86400);
        E4(0x9B097C00);                        // mul x0, x0, x9
        BLInternal("_zan_dt_from_unix");
        HostEnd();
    }

    // x0..x5 = y, m, d, h, mi, s -> DateTime.
    void HostEmitDtFromParts() {
        HostBegin("_zan_dt_from_parts");
        HostSave(3, 3); HostSave(4, 4); HostSave(5, 5);
        BLInternal("_zan_dt_dfc");             // x0..x2 intact
        LoadImm(9, 86400);
        E4(0x9B097C00);                        // days * 86400
        HostLoad(10, 3); LoadImm(11, 3600);
        E4(0x9B000000 | (11 << 16) | (0 << 10) | (10 << 5)); // + h*3600
        HostLoad(10, 4); LoadImm(11, 60);
        E4(0x9B000000 | (11 << 16) | (0 << 10) | (10 << 5)); // + mi*60
        HostLoad(10, 5);
        AddRR(0, 0, 10);                       // + s
        BLInternal("_zan_dt_from_unix");
        HostEnd();
    }

    // x0 = year -> leap-year verdict per the 4/100/400 rule.
    void HostEmitDtIsLeap() {
        HostBegin("_zan_dt_isleap");
        HostSave(0, 0);
        HostLoad(0, 0); LoadImm(1, 4);
        BLInternal("_zan_dt_floormod");
        int r4 = NL(); CbzReg(0, r4);
        LoadImm(0, 0);
        HostEnd();
        Mark(r4);
        HostLoad(0, 0); LoadImm(1, 100);
        BLInternal("_zan_dt_floormod");
        int r1 = NL(); CbzReg(0, r1);
        LoadImm(0, 1);
        HostEnd();
        Mark(r1);
        HostLoad(0, 0); LoadImm(1, 400);
        BLInternal("_zan_dt_floormod");
        int nz = NL(); CbnzReg(0, nz);
        LoadImm(0, 1);
        int fin = NL(); EmitB(fin);
        Mark(nz);
        LoadImm(0, 0);
        Mark(fin);
        HostEnd();
    }

    // x0 = year, x1 = month -> days in month (0 when out of range).
    void HostEmitDtDim() {
        HostBegin("_zan_dt_daysinmonth");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 1); LoadImm(10, 1); HostCmp(9, 10);
        int mOk = NL(); EmitBcond(10, mOk);
        LoadImm(0, 0);
        HostEnd();
        Mark(mOk);
        HostLoad(9, 1); LoadImm(10, 12); HostCmp(9, 10);
        int mOk2 = NL(); EmitBcond(13, mOk2);
        LoadImm(0, 0);
        HostEnd();
        Mark(mOk2);
        HostLoad(9, 1); LoadImm(10, 2); HostCmp(9, 10);
        int notFeb = NL(); EmitBcond(1, notFeb);
        HostLoad(0, 0);
        BLInternal("_zan_dt_isleap");
        int noLeap = NL(); CbzReg(0, noLeap);
        LoadImm(0, 29);
        HostEnd();
        Mark(noLeap);
        LoadImm(0, 28);
        HostEnd();
        Mark(notFeb);
        HostLoad(9, 1); LoadImm(10, 4); HostCmp(9, 10);
        int is30 = NL(); EmitBcond(0, is30);
        HostLoad(9, 1); LoadImm(10, 6); HostCmp(9, 10);
        EmitBcond(0, is30);
        HostLoad(9, 1); LoadImm(10, 9); HostCmp(9, 10);
        EmitBcond(0, is30);
        HostLoad(9, 1); LoadImm(10, 11); HostCmp(9, 10);
        EmitBcond(0, is30);
        LoadImm(0, 31);
        int fin = NL(); EmitB(fin);
        Mark(is30);
        LoadImm(0, 30);
        Mark(fin);
        HostEnd();
    }

    // x0 = value 0..99 -> "0" prefix below 10.
    void HostEmitDtPad2() {
        HostBegin("_zan_dt_pad2");
        LoadImm(9, 10); HostCmp(0, 9);
        int ge = NL(); EmitBcond(10, ge);
        ExtMov(10, 0);
        ExtMov(0, 10);
        BLInternal("_zan_rt_int2str");
        ExtMov(1, 0);
        LoadStr(extZero, 0);
        BLInternal("_zan_rt_strcat2");
        HostEnd();
        Mark(ge);
        BLInternal("_zan_rt_int2str");
        HostEnd();
    }

    // x0 = DateTime -> "YYYY-MM-DD". Slot 1 holds the accumulated text
    // across calls: x0-x18 are caller-saved and do not survive BLs.
    void HostEmitDtDateStr() {
        HostBegin("_zan_dt_todatestring");
        HostSave(0, 0);
        HostLoad(0, 0); LdrU(0, 0, 8);
        BLInternal("_zan_rt_int2str");         // year
        LoadStr(extDash, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 1);
        HostLoad(0, 0); LdrU(0, 0, 16);
        BLInternal("_zan_dt_pad2");            // month
        ExtMov(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_rt_strcat2");
        LoadStr(extDash, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 1);
        HostLoad(0, 0); LdrU(0, 0, 24);
        BLInternal("_zan_dt_pad2");            // day
        ExtMov(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_rt_strcat2");
        HostEnd();
    }

    // x0 = DateTime -> "HH:MM:SS".
    void HostEmitDtTimeStr() {
        HostBegin("_zan_dt_totimestring");
        HostSave(0, 0);
        HostLoad(0, 0); LdrU(0, 0, 32);
        BLInternal("_zan_dt_pad2");            // hour
        LoadStr(extColon, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 1);
        HostLoad(0, 0); LdrU(0, 0, 40);
        BLInternal("_zan_dt_pad2");            // minute
        ExtMov(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_rt_strcat2");
        LoadStr(extColon, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 1);
        HostLoad(0, 0); LdrU(0, 0, 48);
        BLInternal("_zan_dt_pad2");            // second
        ExtMov(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_rt_strcat2");
        HostEnd();
    }

    // x0 = DateTime -> "YYYY-MM-DD HH:MM:SS".
    void HostEmitDtToStr() {
        HostBegin("_zan_dt_tostring");
        HostSave(0, 0);
        BLInternal("_zan_dt_todatestring");
        LoadStr(extSpace, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 1);
        HostLoad(0, 0); LdrU(0, 0, 32);
        BLInternal("_zan_dt_pad2");
        ExtMov(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_rt_strcat2");
        LoadStr(extColon, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 1);
        HostLoad(0, 0); LdrU(0, 0, 40);
        BLInternal("_zan_dt_pad2");
        ExtMov(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_rt_strcat2");
        LoadStr(extColon, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 1);
        HostLoad(0, 0); LdrU(0, 0, 48);
        BLInternal("_zan_dt_pad2");
        ExtMov(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_rt_strcat2");
        HostEnd();
    }

    void HostEmitDt() {
        HostEmitDtFloormod();
        HostEmitDtFloordiv();
        HostEmitDtFromUnix();
        HostEmitDtDfc();
        HostEmitDtFromDate();
        HostEmitDtFromParts();
        HostEmitDtIsLeap();
        HostEmitDtDim();
        HostEmitDtPad2();
        HostEmitDtDateStr();
        HostEmitDtTimeStr();
        HostEmitDtToStr();
    }

    // ===================== threads / env / filesystem =====================
    // KnownFolders, Stopwatch/Timer, File/Directory listings, FileInfo.
    // Darwin arm64 struct stat is 144 bytes: st_mode u16 @ +4, st_size @
    // +96, st_mtimespec.tv_sec @ +48, st_ctimespec.tv_sec @ +64 (verified
    // against the macOS SDK); with the 176-byte HostBeginN extension the
    // buffer base is sp + 128. struct dirent: d_type @ +20, d_name @ +21.

    // x0 = name (NUL-terminated) -> stamped copy of the value, or "".
    void HostEmitGetenv() {
        HostBegin("_zan_ext_getenv");
        HostSave(0, 0);
        BLExtern("_getenv");
        int isNull = NL(); CbzReg(0, isNull);    // unset -> ""
        HostSave(0, 1);
        BLExtern("_strlen");
        MovRR(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_host_copy");
        int fin = NL(); EmitB(fin);
        Mark(isNull);
        LoadStr(extEmpty, 0);
        Mark(fin);
        HostEnd();
    }

    // x0 = text -> $NAME (POSIX letter/digit/underscore run) substituted
    // from the process environment; missing or empty values keep the
    // literal token, matching KnownFolders.Expand in the stdlib.
    void HostEmitExpand() {
        HostBegin("_zan_ext_expand");
        HostSave(0, 0);                          // text
        LoadStr(extEmpty, 0);
        HostSave(0, 3);                          // result
        HostLoad(9, 0);
        ExtLenOf(9, 10);
        HostSave(10, 2);                         // len
        LoadImm(9, 0);
        HostSave(9, 1);                          // i
        int fin = NL(); int loop = NL(); int next = NL();
        int plain = NL(); int dollarBody = NL(); int dollarLit = NL();
        int nameScan = NL(); int nameDone = NL(); int nameOk = NL();
        int notLetter = NL(); int noVal = NL(); int vEmpty = NL();
        EmitB(loop);
        Mark(loop);
        HostLoad(9, 1); HostLoad(10, 2);
        HostCmp(9, 10);
        EmitBcond(2, fin);                       // i >= len
        HostLoad(0, 0);
        ExtLdrbReg(0, 0, 9);                     // c = text[i]
        ExtCmpImm(0, 36);                        // '$'
        EmitBcond(0, dollarBody);
        EmitB(plain);
        Mark(dollarBody);
        // scan the name run: end starts at i + 1 and extends over
        // [A-Za-z0-9_]
        HostLoad(9, 1); AddImm(9, 9, 1);
        HostSave(9, 4);                          // end
        EmitB(nameScan);
        Mark(nameScan);
        HostLoad(9, 4); HostLoad(10, 2);
        HostCmp(9, 10);
        EmitBcond(2, nameDone);
        HostLoad(0, 0);
        HostLoad(12, 4);
        ExtLdrbReg(0, 0, 12);                    // c = text[end]
        ExtCmpImm(0, 95);
        EmitBcond(0, nameOk);                    // '_'
        LoadImm(1, 32);
        E4(0xAA000020);                          // orr x0, x1, x0 -> c|32
        ExtCmpImm(0, 97);
        EmitBcond(11, notLetter);                // b.lt (unsigned)
        ExtCmpImm(0, 122);
        EmitBcond(12, nameOk);                   // b.gt
        EmitB(nameOk);
        Mark(notLetter);
        AddImm(0, 0, -48);
        ExtCmpImm(0, 9);
        EmitBcond(9, nameOk);                    // digit (unsigned ls)
        EmitB(nameDone);
        Mark(nameOk);
        HostLoad(9, 4); AddImm(9, 9, 1); HostSave(9, 4);
        EmitB(nameScan);
        Mark(nameDone);
        HostLoad(9, 4); HostLoad(10, 1); AddImm(10, 10, 1);
        HostCmp(9, 10);
        EmitBcond(9, dollarLit);                 // end <= i+1 -> bare '$'
        // name = text[i+1 .. end)
        HostLoad(0, 0);
        HostLoad(1, 1); AddImm(1, 1, 1);
        HostLoad(2, 4); HostLoad(9, 1);
        ExtSubRR(2, 2, 9); AddImm(2, 2, -1);
        BLInternal("_zan_ext_path_slice");
        HostSave(0, 5);                          // name (stamped)
        HostLoad(0, 5);
        BLExtern("_getenv");
        int haveV = NL(); CbzReg(0, noVal);
        HostSave(0, 6);                          // raw value
        HostLoad(0, 6);
        BLExtern("_strlen");
        MovRR(1, 0);
        CbzReg(1, vEmpty);                       // empty value = unset
        HostLoad(0, 6);
        BLInternal("_zan_host_copy");
        ExtMov(1, 0);
        HostLoad(0, 3);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(9, 4); HostSave(9, 1);          // i = end
        EmitB(next);
        Mark(vEmpty);
        Mark(noVal);
        // unknown token stays literal: result + "$" + name
        HostLoad(0, 3); LoadStr(extDollar, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(0, 3); HostLoad(1, 5);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(9, 4); HostSave(9, 1);
        EmitB(next);
        Mark(dollarLit);
        HostLoad(0, 3); LoadStr(extDollar, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(9, 1); AddImm(9, 9, 1); HostSave(9, 1);
        EmitB(next);
        // plain byte: a one-byte stamped string appended to the result
        Mark(plain);
        ExtPush(0);                              // [sp] = c (low byte)
        AddImm(0, 31, 0);
        LoadImm(1, 1);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        MovRR(1, 0);
        HostLoad(0, 3);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(9, 1); AddImm(9, 9, 1); HostSave(9, 1);
        Mark(next);
        EmitB(loop);
        Mark(fin);
        HostLoad(0, 3);
        HostEnd();
    }

    // -> monotonic nanoseconds (CLOCK_MONOTONIC = 6 on Darwin).
    void HostEmitMono() {
        HostBegin("_zan_host_mono_ns");
        AddSPImm(16, false);                     // timespec
        LoadImm(0, 6);
        AddImm(1, 31, 0);
        BLExtern("_clock_gettime");
        LdrU(9, 31, 0);                          // tv_sec
        LoadImm(10, 1000000000);
        E4(0x9B097D49);                          // mul x9, x10, x9
        LdrU(10, 31, 8);                         // tv_nsec
        AddRR(0, 9, 10);
        AddSPImm(16, true);
        HostEnd();

        // MonoScaled(1000): (t/f)*unit + (t%f)*unit/f, divide-first like
        // the stdlib so the multiply cannot overflow i64
        HostBegin("_zan_host_mono_ms");
        BLInternal("_zan_host_mono_ns");
        HostSave(0, 0);                          // t
        LoadImm(1, 1000000000);
        E4(0x9AC10C02);                          // sdiv x2, x0, x1
        LoadImm(3, 1000);
        E4(0x9B037C40);                          // mul x0, x2, x3
        HostLoad(4, 0);
        E4(0x9B019044);                          // msub x4 = x4 - x2*x1 (rem)
        E4(0x9B037C84);                          // mul x4, x4, x3
        E4(0x9AC10C84);                          // sdiv x4, x4, x1
        AddRR(0, 0, 4);
        HostEnd();
    }

    // Stopwatch: {start@0, accumulated@8, running@16}; x0 = object.
    void HostEmitStopwatch() {
        HostBegin("_zan_host_sw_start");
        HostSave(0, 0);
        LdrU(9, 0, 16);
        int done = NL(); CbnzReg(9, done);
        LoadImm(9, 1);
        HostLoad(0, 0);
        StrU(9, 0, 16);
        BLInternal("_zan_host_mono_ns");
        HostLoad(9, 0);
        StrU(0, 9, 0);
        Mark(done);
        HostEnd();

        HostBegin("_zan_host_sw_stop");
        HostSave(0, 0);
        LdrU(9, 0, 16);
        int sDone = NL(); CbzReg(9, sDone);
        LoadImm(9, 0);
        HostLoad(0, 0);
        StrU(9, 0, 16);
        BLInternal("_zan_host_mono_ns");         // now
        HostLoad(9, 0);
        LdrU(10, 9, 0);                          // start
        LdrU(11, 9, 8);                          // accumulated
        ExtSubRR(10, 0, 10);                     // now - start
        AddRR(10, 11, 10);
        StrU(10, 9, 8);
        Mark(sDone);
        HostEnd();

        HostBegin("_zan_host_sw_reset");
        HostSave(0, 0);
        LoadImm(9, 0);
        HostLoad(0, 0);
        StrU(9, 0, 8);
        StrU(9, 0, 16);
        HostEnd();

        HostBegin("_zan_host_sw_elapsed");
        HostSave(0, 0);
        LdrU(9, 0, 8);                           // accumulated
        LdrU(10, 0, 16);                         // running
        int have = NL(); CbzReg(10, have);
        BLInternal("_zan_host_mono_ns");
        MovRR(10, 0);                            // now
        HostLoad(9, 0);
        LdrU(11, 9, 0);                          // start
        ExtSubRR(10, 10, 11);
        LdrU(9, 9, 8);                           // reload accumulated
        AddRR(9, 9, 10);
        Mark(have);
        ExtMov(0, 9);                            // ticks
        E4(0x9E620000);                          // scvtf d0, x0
        LoadImm(1, 1000000);
        E4(0x9E620021);                          // scvtf d1, x1
        E4(0x1E611800);                          // fdiv d0, d0, d1
        E4(0x9E660000);                          // fmov x0, d0
        HostEnd();
    }

    // pthread body: sleep the interval, fire the delegate, repeat until
    // Stop clears `running`. The timer pointer rides in x20 (callee-saved:
    // usleep/libSystem preserve it; compiled Zan code never touches x19+),
    // so the loop keeps zero stack dependence. The entry LR rides in x21:
    // every `bl` below would otherwise clobber it, and the exit `ret` must
    // still land in the pthread trampoline. Frameless: no HostBegin.
    void HostEmitTimerThread() {
        syms.Add(new Sym("_zan_host_timer_thread", txt.Count));
        E4(0xAA0003F4);                          // mov x20, x0 (timer)
        E4(0xAA1E03F5);                          // mov x21, x30 (thread exit)
        int tLoop = NL(); int tDone = NL();
        EmitB(tLoop);
        Mark(tLoop);
        E4(0xB9400281);                          // ldr w1, [x20] (interval)
        E4(0x52807D02);                          // mov w2, #1000
        E4(0x1B027C20);                          // mul w0, w1, w2 (usec)
        BLExtern("_usleep");
        LdrU(1, 20, 16);                         // running
        CbzReg(1, tDone);
        LdrU(1, 20, 8);                          // closure
        LdrU(0, 1, 8);                           // env
        LdrU(9, 1, 0);                           // thunk
        E4(0xD63F0120);                          // blr x9
        EmitB(tLoop);
        Mark(tDone);
        LoadImm(0, 0);                           // pthread return value
        E4(0xD65F02A0);                          // ret x21
    }

    // x0 = path -> -1 or attribute bits (bit0 readable? no: W_OK fails,
    // bit1 basename starts '.', bit2 directory) — matches
    // zan_file_attributes_at in the reference runtime.
    void HostEmitFattr() {
        HostBeginN("_zan_host_fattr", 176);
        HostSave(0, 0);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); HostCbnzW(miss);
        LoadImm(9, 0);
        HostSave(9, 1);                          // bits
        HostLoad(0, 0);
        LoadImm(1, 2);                           // W_OK
        BLExtern("_access");
        int yesW = NL(); HostCbzW(yesW);         // writable -> no bit
        LoadImm(9, 1);
        HostSave(9, 1);
        Mark(yesW);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_filename");
        ExtLdrbImm(9, 0, 0);
        ExtCmpImm(9, 46);                        // '.'
        int noDot = NL(); EmitBcond(1, noDot);   // not hidden -> no bit
        HostLoad(9, 1); LoadImm(10, 2); AddRR(9, 9, 10);
        HostSave(9, 1);
        Mark(noDot);
        E4(0x79400000 | (66 << 10) | (31 << 5) | 9);   // ldrh w9, [sp, #132]
        E4(0x530C3D29);                                // ubfm w9, w9, #12, #15
        ExtCmpImm(9, 4);                               // S_IFDIR
        int noDirB = NL(); EmitBcond(1, noDirB);       // not a dir -> no bit
        HostLoad(9, 1); AddImm(9, 9, 4);
        HostSave(9, 1);
        Mark(noDirB);
        HostLoad(0, 1);
        int fin = NL(); EmitB(fin);
        Mark(miss);
        LoadImm(0, -1);
        Mark(fin);
        HostEndN(176);
    }

    // x0 = path -> size in bytes, or -1 when missing.
    void HostEmitFlength() {
        HostBeginN("_zan_host_flength", 176);
        HostSave(0, 0);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); HostCbnzW(miss);
        LdrU(0, 31, 128 + 96);                   // st_size
        int fin = NL(); EmitB(fin);
        Mark(miss);
        LoadImm(0, -1);
        Mark(fin);
        HostEndN(176);
    }

    // x0 = path, x1 = which (0 mtime, 1 ctime) -> Unix seconds, 0 when
    // missing (zan_file_time semantics).
    void HostEmitFtime() {
        HostBeginN("_zan_host_ftime", 176);
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); HostCbnzW(miss);
        HostLoad(9, 1);
        ExtCmpImm(9, 1);
        int isC = NL(); EmitBcond(0, isC);
        LdrU(0, 31, 128 + 48);                   // st_mtimespec.tv_sec
        int got = NL(); EmitB(got);
        Mark(isC);
        LdrU(0, 31, 128 + 64);                   // st_ctimespec.tv_sec
        Mark(got);
        int fin = NL(); EmitB(fin);
        Mark(miss);
        LoadImm(0, 0);
        Mark(fin);
        HostEndN(176);
    }

    // x0 = path, x1 = on -> 1 when the mode change succeeded. Setreadonly
    // clears the 0o222 write bits; making writable restores S_IWUSR, the
    // minimum the reference shim grants back.
    void HostEmitSetReadonly() {
        HostBeginN("_zan_host_setreadonly", 176);
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); int fail = NL(); int fin = NL(); int chmodL = NL();
        HostCbnzW(miss);
        E4(0x79400000 | (66 << 10) | (31 << 5) | 9);   // ldrh w9, [sp, #132]
        HostLoad(10, 1);
        ExtCmpImm(10, 0);
        int wOn0 = NL(); EmitBcond(0, wOn0);
        LoadImm(10, 146);                        // 0o222
        E4(0x0A2A0129);                          // bic w9, w9, w10
        EmitB(chmodL);
        Mark(wOn0);
        LoadImm(10, 128);                        // S_IWUSR
        E4(0x2A0A0129);                          // orr w9, w9, w10
        Mark(chmodL);
        HostLoad(0, 0);
        ExtMov(1, 9);
        BLExtern("_chmod");
        HostCbnzW(fail);
        LoadImm(0, 1);
        EmitB(fin);
        Mark(fail);
        LoadImm(0, 0);
        EmitB(fin);
        Mark(miss);
        LoadImm(0, 0);
        Mark(fin);
        HostEndN(176);
    }

    // x0 = mine, x1 = other -> other is missing (mtime 0) or mine is newer.
    void HostEmitFnewer() {
        HostBegin("_zan_host_fnewer");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 1); LoadImm(1, 0);
        BLInternal("_zan_host_ftime");
        HostSave(0, 2);                          // theirs
        HostLoad(0, 0); LoadImm(1, 0);
        BLInternal("_zan_host_ftime");
        MovRR(10, 0);                            // mine
        HostLoad(9, 2);
        int fin = NL(); int cmpP = NL(); int bigger = NL();
        CbnzReg(9, cmpP);                        // theirs != 0 -> compare
        LoadImm(0, 1);                           // missing target: stale
        EmitB(fin);
        Mark(cmpP);
        HostCmp(10, 9);
        EmitBcond(12, bigger);                   // b.gt mine > theirs
        LoadImm(0, 0);
        EmitB(fin);
        Mark(bigger);
        LoadImm(0, 1);
        Mark(fin);
        HostEnd();
    }

    // x0 = path -> 1 when a directory exists there (stat + S_ISDIR).
    void HostEmitDirExists() {
        HostBeginN("_zan_host_direxists", 176);
        HostSave(0, 0);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); int fin = NL(); int isD = NL();
        HostCbnzW(miss);
        E4(0x79400000 | (66 << 10) | (31 << 5) | 9);
        E4(0x530C3D29);
        ExtCmpImm(9, 4);
        EmitBcond(0, isD);
        LoadImm(0, 0);
        EmitB(fin);
        Mark(isD);
        LoadImm(0, 1);
        EmitB(fin);
        Mark(miss);
        LoadImm(0, 0);
        Mark(fin);
        HostEndN(176);
    }

    // Host List<string>: {count@0, cap@8, data@16}, identical layout to
    // GenListNew/ListAppendRaw so user code can Add/index the result.
    void HostEmitList() {
        HostBegin("_zan_host_list_new");
        HostSave(0, 0);                          // cap
        LoadImm(0, 24); LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        HostSave(0, 1);                          // list
        HostLoad(0, 0);
        LoadImm(1, 8);
        BLExtern("_calloc");
        MovRR(9, 0);                             // data
        HostLoad(1, 1);
        StrU(9, 1, 16);
        HostLoad(0, 0);
        StrU(0, 1, 8);                           // cap
        LoadImm(9, 0);
        StrU(9, 1, 0);                           // count
        HostLoad(0, 1);
        HostEnd();

        HostBegin("_zan_host_list_push");
        HostSave(0, 0); HostSave(1, 1);
        LdrU(2, 0, 0);                           // count
        LdrU(3, 0, 8);                           // cap
        HostCmp(2, 3);
        int skip = NL(); EmitBcond(1, skip);
        AddRR(3, 3, 3);                          // ncap = cap * 2
        HostLoad(9, 0);
        StrU(3, 9, 8);
        LdrU(0, 9, 16);                          // old data
        LoadImm(4, 8);
        E4(0x9B047C61);                          // mul x1, x3, x4
        BLExtern("_realloc");
        HostLoad(9, 0);
        StrU(0, 9, 16);
        Mark(skip);
        HostLoad(0, 0);
        LdrU(2, 0, 0);
        LdrU(3, 0, 16);
        HostLoad(1, 1);
        E4(0xF8207800 | (2 << 16) | (3 << 5) | 1);   // str x1, [x3, x2, lsl 3]
        AddImm(2, 2, 1);
        StrU(2, 0, 0);
        HostEnd();
    }

    // x0 = path, wantDirs selects files (0) or directories (1). Bare
    // names, hidden entries included, non-recursive — the stdlib
    // GetFiles/GetDirectories contract. full=true instead pushes the
    // combined path + "/" + name (the GetPaths/GetDirectoryPaths
    // contract); a missing directory yields an empty list either way.
    void HostEmitDirList(string sym, int wantDirs, bool full) {
        HostBeginN(sym, 176);
        HostSave(0, 0);                          // path
        LoadImm(0, 8);
        BLInternal("_zan_host_list_new");
        HostSave(0, 1);                          // list
        HostLoad(0, 0);
        BLExtern("_opendir");
        int noDir = NL(); CbzReg(0, noDir);
        HostSave(0, 2);                          // DIR*
        int rLoop = NL(); int rNext = NL(); int rDone = NL();
        int keep = NL(); int pushIt = NL(); int badStat = NL(); int cls = NL();
        int d0 = NL(); int d1 = NL();
        EmitB(rLoop);
        Mark(rLoop);
        HostLoad(0, 2);
        BLExtern("_readdir");
        CbzReg(0, rDone);
        HostSave(0, 3);                          // dirent*
        // skip "." and ".." only (hidden entries are listed)
        AddImm(9, 0, 21);                        // d_name
        ExtLdrbImm(10, 9, 0);
        ExtCmpImm(10, 46);
        EmitBcond(0, d0);
        EmitB(keep);
        Mark(d0);
        ExtLdrbImm(10, 9, 1);
        ExtCmpImm(10, 0);
        EmitBcond(0, rNext);                     // "."
        ExtCmpImm(10, 46);
        EmitBcond(0, d1);
        EmitB(keep);
        Mark(d1);
        ExtLdrbImm(10, 9, 2);
        ExtCmpImm(10, 0);
        EmitBcond(0, rNext);                     // ".."
        Mark(keep);
        // classify via stat on the combined path (d_type is unreliable on
        // some filesystems)
        HostLoad(0, 0);
        HostLoad(9, 3);
        AddImm(1, 9, 21);                        // d_name
        BLInternal("_zan_ext_path_combine");
        HostSave(0, 5);                          // full path
        HostLoad(0, 5);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        HostCbnzW(badStat);
        E4(0x79400000 | (66 << 10) | (31 << 5) | 9);
        E4(0x530C3D29);
        LoadImm(10, 4);
        HostCmp(9, 10);
        int isD = NL(); EmitBcond(0, isD);
        LoadImm(9, 0);
        EmitB(cls);
        Mark(isD);
        LoadImm(9, 1);
        Mark(cls);
        HostSave(9, 6);                          // is_dir
        HostLoad(9, 6);
        ExtCmpImm(9, wantDirs);
        EmitBcond(0, pushIt);
        EmitB(rNext);
        Mark(pushIt);
        if (full) {
            // stamped copy of d_name, then dir + "/" + name (strcat2
            // requires stamped strings)
            HostLoad(9, 3);
            AddImm(0, 9, 21);
            BLExtern("_strlen");
            MovRR(1, 0);
            HostLoad(9, 3);
            AddImm(0, 9, 21);
            BLInternal("_zan_host_copy");
            MovRR(1, 0);
            HostLoad(0, 0);
            BLInternal("_zan_ext_path_combine");
            MovRR(1, 0);
        } else {
            HostLoad(9, 3);
            AddImm(0, 9, 21);                    // d_name
            BLExtern("_strlen");
            MovRR(1, 0);
            HostLoad(9, 3);
            AddImm(0, 9, 21);
            BLInternal("_zan_host_copy");
            MovRR(1, 0);
        }
        HostLoad(0, 1);
        BLInternal("_zan_host_list_push");
        EmitB(rNext);
        Mark(badStat);
        EmitB(rLoop);
        Mark(rNext);
        EmitB(rLoop);
        Mark(rDone);
        HostLoad(0, 2);
        BLExtern("_closedir");
        Mark(noDir);
        HostLoad(0, 1);
        HostEndN(176);
    }

    void HostEmitIo() {
        ioHome = InternStr("HOME");
        ioTemp = InternStr("TEMP");
        ioTmp = InternStr("TMP");
        ioTmpdir = InternStr("TMPDIR");
        ioXdgCfg = InternStr("XDG_CONFIG_HOME");
        ioDotConfig = InternStr(".config");
        ioSlashTmp = InternStr("/tmp");
        extDollar = InternStr("$");
        HostEmitGetenv();
        HostEmitExpand();
        HostEmitMono();
        HostEmitStopwatch();
        HostEmitTimerThread();
        HostEmitFattr();
        HostEmitFlength();
        HostEmitFtime();
        HostEmitSetReadonly();
        HostEmitFnewer();
        HostEmitDirExists();
        HostEmitList();
        HostEmitDirList("_zan_host_getfiles", 0, false);
        HostEmitDirList("_zan_host_getdirs", 1, false);
        HostEmitDirList("_zan_dir_getpaths", 0, true);
        HostEmitDirList("_zan_dir_getdirpaths", 1, true);
    }

    // x0 = fmt, x1 = argc, x2..x4 = pre-rendered argument strings. Scans
    // {N} placeholders: a digit run naming an argument below argc and
    // closed by '}' substitutes it; anything else stays literal text.
    void HostEmitStrFormat() {
        HostBegin("_zan_ext_str_format");
        HostSave(0, 0); HostSave(1, 1);
        HostSave(2, 2); HostSave(3, 3); HostSave(4, 4);
        int gFin = NL(); int gLoop = NL(); int gBrace = NL(); int gDig = NL();
        int gDigEnd = NL(); int gBad = NL(); int gAdv = NL(); int gArgDone = NL();
        int gArgCp = NL(); int gSatC = NL(); int gSat = NL();
        int gA0 = NL(); int gA1 = NL(); int gA2 = NL();
        int gN0 = NL(); int gN1 = NL(); int gN2 = NL();
        // buffer = fmtlen + arg lens + 1 (only args below argc were passed).
        // Arg lengths use strlen: rendered results (int2str etc.) need not
        // carry the Zan length header. Lengths live in slots 7/8/10.
        HostLoad(9, 0);
        ExtLenOf(9, 11);                       // x11 = total (fmtlen)
        HostSave(11, 9);
        HostLoad(1, 1);                        // argc
        ExtCmpImm(1, 0);
        EmitBcond(9, gN0);
        HostLoad(0, 2);
        CbzReg(0, gA0);
        ExtPush(0);
        BLExtern("_strlen");
        ExtMov(12, 0);
        ExtPop(0);
        HostSave(12, 7);
        HostLoad(11, 9); HostLoad(12, 7); AddRR(11, 11, 12); HostSave(11, 9);
        Mark(gA0);
        Mark(gN0);
        HostLoad(1, 1);
        ExtCmpImm(1, 1);
        EmitBcond(9, gN1);
        HostLoad(0, 3);
        CbzReg(0, gA1);
        ExtPush(0);
        BLExtern("_strlen");
        ExtMov(12, 0);
        ExtPop(0);
        HostSave(12, 8);
        HostLoad(11, 9); HostLoad(12, 8); AddRR(11, 11, 12); HostSave(11, 9);
        Mark(gA1);
        Mark(gN1);
        HostLoad(1, 1);
        ExtCmpImm(1, 2);
        EmitBcond(9, gN2);
        HostLoad(0, 4);
        CbzReg(0, gA2);
        ExtPush(0);
        BLExtern("_strlen");
        ExtMov(12, 0);
        ExtPop(0);
        HostSave(12, 10);
        HostLoad(11, 9); HostLoad(12, 10); AddRR(11, 11, 12); HostSave(11, 9);
        Mark(gA2);
        Mark(gN2);
        HostLoad(11, 9);
        AddImm(0, 11, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.fmt.malloc");
        HostSave(0, 5);                        // base (cursor tracked in x13)
        HostLoad(9, 0);                        // fmt (no calls during scan)
        ExtLenOf(9, 11);                       // fmtlen
        LoadImm(10, 0);                        // i
        MovRR(12, 0);                          // base
        MovRR(13, 0);                          // cursor
        EmitB(gLoop);
        Mark(gLoop);
        HostCmp(10, 11);
        EmitBcond(2, gFin);                    // i >= fmtlen -> done
        ExtLdrbReg(0, 9, 10);                  // c
        ExtCmpImm(0, 123);                     // '{'
        EmitBcond(0, gBrace);
        ExtStrbImm(0, 13, 0);                  // plain byte
        AddImm(13, 13, 1);
        AddImm(10, 10, 1);
        EmitB(gLoop);
        Mark(gBrace);
        AddImm(15, 10, 1);                     // j = i + 1
        LoadImm(14, 0);                        // val
        EmitB(gDig);
        Mark(gDig);
        HostCmp(15, 11);
        EmitBcond(2, gBad);                    // j >= fmtlen -> literal
        ExtLdrbReg(0, 9, 15);
        ExtCmpImm(0, 48);
        EmitBcond(11, gDigEnd);                // < '0'
        ExtCmpImm(0, 57);
        EmitBcond(12, gDigEnd);                // > '9'
        // val = sat(val * 10 + (c - 48)) with 2^30 as the saturation mark
        ExtLsl(1, 14, 3);
        ExtLsl(2, 14, 1);
        AddRR(1, 1, 2);
        AddRR(1, 1, 0);                        // + c
        AddImm(1, 1, -48);
        LoadImm(2, 1073741824);
        HostCmp(1, 2);
        EmitBcond(2, gSat);                    // hs -> saturate
        ExtMov(14, 1);
        EmitB(gSatC);
        Mark(gSat);
        LoadImm(14, 1073741824);
        Mark(gSatC);
        AddImm(15, 15, 1);
        EmitB(gDig);
        Mark(gDigEnd);
        AddImm(2, 10, 2);
        HostCmp(15, 2);
        EmitBcond(11, gBad);                   // no digits -> literal
        HostCmp(15, 11);
        EmitBcond(2, gBad);                    // '}' out of range -> literal
        ExtLdrbReg(0, 9, 15);
        ExtCmpImm(0, 125);
        EmitBcond(1, gBad);                    // not '}' -> literal
        HostLoad(1, 1);
        HostCmp(14, 1);
        EmitBcond(2, gBad);                    // val >= argc -> literal
        // length: sp + 56 + val * 8; arg pointer: sp + 16 + val * 8
        ExtLsl(0, 14, 3);
        AddImm(0, 0, 56);
        E4(0xF8606BE1);                        // ldr x1, [sp, x0] = alen
        ExtLsl(0, 14, 3);
        AddImm(0, 0, 16);
        E4(0xF8606BE0);                        // ldr x0, [sp, x0] = argp
        CbzReg(0, gAdv);                       // null arg -> nothing
        MovRR(2, 15);                          // j -> x2 (x15 becomes src)
        MovRR(15, 0);
        LoadImm(3, 0);                         // k
        EmitB(gArgCp);
        Mark(gArgCp);
        HostCmp(3, 1);
        EmitBcond(2, gArgDone);
        ExtLdrbReg(4, 15, 3);                  // src[k]
        ExtStrbImm(4, 13, 0);
        AddImm(13, 13, 1);
        AddImm(3, 3, 1);
        EmitB(gArgCp);
        Mark(gArgDone);
        AddImm(10, 2, 1);                      // i = j + 1
        EmitB(gLoop);
        Mark(gAdv);
        AddImm(10, 2, 1);
        EmitB(gLoop);
        Mark(gBad);
        LoadImm(0, 123);                       // literal '{'
        ExtStrbImm(0, 13, 0);
        AddImm(13, 13, 1);
        AddImm(10, 10, 1);
        EmitB(gLoop);
        Mark(gFin);
        ExtStrbImm(31, 13, 0);
        ExtMov(0, 13);
        ExtSubRR(1, 0, 12);                    // produced length
        ExtMov(0, 12);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 7);
        HostSave(1, 8);
        HostLoad(0, 8);
        BLExtern("_free");
        HostLoad(0, 7);
        HostEnd();
    }

    // x0 = separator, x1 = List<string> (count +0, cap +8, data +16).
    // Null list and null elements behave as empty strings.
    void HostEmitStrJoin() {
        HostBegin("_zan_ext_str_join");
        HostSave(0, 0);                        // sep
        HostSave(1, 1);                        // list
        int jNull = NL(); int jLoop = NL(); int jDone = NL();
        int jHaveE = NL(); int jFirst = NL(); int jSepOk = NL();
        HostLoad(0, 0);
        CbnzReg(0, jSepOk);
        LoadStr(extEmpty, 0);
        HostSave(0, 0);
        Mark(jSepOk);
        HostLoad(0, 1);
        CbzReg(0, jNull);
        LoadStr(extEmpty, 0);
        HostSave(0, 2);                        // acc
        HostLoad(10, 1);
        LdrU(10, 10, 0);                       // count
        HostSave(10, 5);
        HostLoad(11, 1);
        LdrU(11, 11, 16);                      // data
        HostSave(11, 6);
        LoadImm(9, 0);                         // i
        HostSave(9, 4);
        EmitB(jLoop);
        Mark(jLoop);
        HostLoad(9, 4);                        // i (x9 dies in strcat2)
        HostLoad(10, 5);                       // count
        HostCmp(9, 10);
        EmitBcond(2, jDone);
        HostLoad(11, 6);                       // data
        ExtLsl(0, 9, 3);
        E4(0xF8606961);                        // ldr x1, [x11, x0]
        CbnzReg(1, jHaveE);
        LoadStr(extEmpty, 1);
        Mark(jHaveE);
        HostSave(1, 3);                        // element
        HostLoad(9, 4);
        ExtCmpImm(9, 0);
        EmitBcond(0, jFirst);                  // i == 0 -> no separator
        HostLoad(0, 2);
        HostLoad(1, 0);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 2);
        Mark(jFirst);
        HostLoad(0, 2);
        HostLoad(1, 3);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 2);
        HostLoad(9, 4);
        AddImm(9, 9, 1);
        HostSave(9, 4);
        EmitB(jLoop);
        Mark(jDone);
        HostLoad(0, 2);
        HostEnd();
        Mark(jNull);
        LoadStr(extEmpty, 0);
        HostEnd();
    }

    // ASCII case fold: x0 = string -> copy with [lo..hi] shifted by delta.
    void HostEmitStrCase(string sym, int lo, int hi, int delta) {
        HostBegin(sym);
        HostSave(0, 0);
        int fin = NL(); int loop = NL(); int skip = NL();
        HostLoad(9, 0);
        ExtLenOf(9, 10);
        HostLoad(0, 0);
        AddImm(0, 10, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.case.malloc");
        MovRR(11, 0);                          // cursor
        MovRR(12, 0);                          // base
        HostLoad(9, 0);                        // s
        LoadImm(13, 0);                        // i
        HostLoad(0, 0);
        ExtLenOf(0, 10);                       // len (reloaded post-call)
        Mark(loop);
        HostCmp(13, 10);
        EmitBcond(2, fin);
        ExtLdrbReg(0, 9, 13);
        ExtCmpImm(0, lo);
        EmitBcond(11, skip);
        ExtCmpImm(0, hi);
        EmitBcond(8, skip);
        AddImm(0, 0, delta);
        Mark(skip);
        ExtStrbImm(0, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(loop);
        Mark(fin);
        ExtStrbImm(31, 11, 0);
        ExtMov(0, 11);
        ExtSubRR(1, 0, 12);
        ExtMov(0, 12);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 5);
        HostSave(1, 6);
        HostLoad(0, 6);
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();
    }

    // x0 = string -> trimmed copy ({' ', '\t', '\r', '\n'} at both ends).
    // Registers: x9 s, x10 base, x11 end, x12 start, x13 produced,
    // x14 cursor, x15 k.
    void HostEmitStrTrim() {
        HostBegin("_zan_ext_str_trim");
        HostSave(0, 0);
        int fFin = NL(); int fLoop = NL(); int fChk = NL();
        int bFin = NL(); int bLoop = NL(); int bChk = NL();
        int cFin = NL(); int cLoop = NL();
        HostLoad(9, 0);
        ExtLenOf(9, 11);                       // len
        HostLoad(9, 0);                        // s
        MovRR(11, 11);                         // end = len (already in x11)
        LoadImm(12, 0);                        // start
        Mark(fLoop);
        HostCmp(12, 11);
        EmitBcond(2, fFin);
        ExtLdrbReg(0, 9, 12);
        ExtCmpImm(0, 32);
        EmitBcond(0, fChk);
        ExtCmpImm(0, 9);
        EmitBcond(0, fChk);
        ExtCmpImm(0, 10);
        EmitBcond(0, fChk);
        ExtCmpImm(0, 13);
        EmitBcond(0, fChk);
        EmitB(fFin);
        Mark(fChk);
        AddImm(12, 12, 1);
        EmitB(fLoop);
        Mark(fFin);
        Mark(bLoop);
        HostCmp(11, 12);
        EmitBcond(9, bFin);                    // end <= start -> stop
        AddImm(0, 11, -1);
        ExtLdrbReg(0, 9, 0);
        ExtCmpImm(0, 32);
        EmitBcond(0, bChk);
        ExtCmpImm(0, 9);
        EmitBcond(0, bChk);
        ExtCmpImm(0, 10);
        EmitBcond(0, bChk);
        ExtCmpImm(0, 13);
        EmitBcond(0, bChk);
        EmitB(bFin);
        Mark(bChk);
        AddImm(11, 11, -1);
        EmitB(bLoop);
        Mark(bFin);
        ExtSubRR(13, 11, 12);                  // produced = end - start
        HostSave(11, 7); HostSave(12, 8);      // end/start survive malloc
        AddImm(0, 13, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.trim.malloc");
        MovRR(10, 0);                          // base (len slot is dead now)
        MovRR(14, 0);                          // cursor
        HostLoad(9, 0);                        // s (reloaded post-call)
        HostLoad(11, 7); HostLoad(12, 8);      // end, start (x9-x15 are dead)
        ExtSubRR(13, 11, 12);                  // produced (reloaded post-call)
        LoadImm(15, 0);
        Mark(cLoop);
        HostCmp(15, 13);
        EmitBcond(2, cFin);
        E4(0x8B0F0180);                        // add x0, x12, x15
        ExtLdrbReg(1, 9, 0);
        ExtStrbImm(1, 14, 0);
        AddImm(14, 14, 1);
        AddImm(15, 15, 1);
        EmitB(cLoop);
        Mark(cFin);
        ExtStrbImm(31, 14, 0);
        ExtMov(0, 14);
        ExtSubRR(1, 0, 10);
        ExtMov(0, 10);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 5);
        HostSave(1, 6);
        HostLoad(0, 6);
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();
    }

    // Two-arg string helpers. Registers: x9 a, x10 b, x11 la, x12 lb,
    // x13 index, x14 scratch, x15 scratch. All are call-free bodies
    // returning in x0. which: 0 Equals, 1 CompareTo, 2 StartsWith,
    // 3 EndsWith, 4 LastIndexOf.
    void HostEmitStrCmp2(string sym, int which) {
        HostBegin(sym);
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0);
        ExtLenOf(9, 11);                       // la
        HostLoad(10, 1);
        ExtLenOf(10, 12);                      // lb
        LoadImm(13, 0);                        // i
        if (which == 4) {
            // LastIndexOf: the LAST i with a match, else -1
            int loop = NL(); int done = NL();
            int mHit = NL(); int mNext = NL();
            LoadImm(14, -1);                   // best = -1
            HostCmp(12, 11);
            EmitBcond(8, done);                // lb > la -> -1
            Mark(loop);
            ExtSubRR(15, 11, 12);              // limit = la - lb
            HostCmp(13, 15);
            EmitBcond(8, done);                // i > limit -> report best
            LoadImm(15, 0);                    // k
            int mLoop = NL();
            Mark(mLoop);
            HostCmp(15, 12);
            EmitBcond(2, mHit);                // k == lb -> full match
            E4(0x8B0D0120);                    // add x0, x9, x13
            ExtLdrbReg(0, 0, 15);              // a[i + k]
            E4(0x8B0F0141);                    // add x1, x10, x15
            ExtLdrbReg(1, 1, 15);              // b[k]
            HostCmp(0, 1);
            EmitBcond(1, mNext);               // mismatch
            AddImm(15, 15, 1);
            EmitB(mLoop);
            Mark(mHit);
            MovRR(14, 13);                     // best = i
            Mark(mNext);
            AddImm(13, 13, 1);
            EmitB(loop);
            Mark(done);
            ExtMov(0, 14);
            HostEnd();
            return;
        }
        int zero = NL(); int one = NL(); int done = NL();
        int loop = NL(); int diff = NL();
        if (which == 0) {
            // Equals: lengths equal and every byte equal
            HostCmp(11, 12);
            EmitBcond(1, zero);
            Mark(loop);
            HostCmp(13, 11);
            EmitBcond(2, one);
            ExtLdrbReg(0, 9, 13);
            ExtLdrbReg(1, 10, 13);
            HostCmp(0, 1);
            EmitBcond(1, zero);
            AddImm(13, 13, 1);
            EmitB(loop);
        } else if (which == 1) {
            // CompareTo: first differing byte decides, else length diff
            Mark(loop);
            HostCmp(13, 12);
            EmitBcond(2, diff);
            ExtLdrbReg(0, 9, 13);
            ExtLdrbReg(1, 10, 13);
            HostCmp(0, 1);
            EmitBcond(1, diff);
            AddImm(13, 13, 1);
            EmitB(loop);
            Mark(diff);
            ExtSubRR(0, 0, 1);                 // wa - wb
            EmitB(done);
        } else if (which == 2) {
            // StartsWith
            HostCmp(12, 11);
            EmitBcond(8, zero);                // lb > la -> false
            Mark(loop);
            HostCmp(13, 12);
            EmitBcond(2, one);
            ExtLdrbReg(0, 9, 13);
            ExtLdrbReg(1, 10, 13);
            HostCmp(0, 1);
            EmitBcond(1, zero);
            AddImm(13, 13, 1);
            EmitB(loop);
        } else {
            // EndsWith
            HostCmp(12, 11);
            EmitBcond(8, zero);
            ExtSubRR(14, 11, 12);              // offset = la - lb
            Mark(loop);
            HostCmp(13, 12);
            EmitBcond(2, one);
            E4(0x8B0D01C0);                    // add x0, x14, x13
            ExtLdrbReg(0, 9, 0);
            ExtLdrbReg(1, 10, 13);
            HostCmp(0, 1);
            EmitBcond(1, zero);
            AddImm(13, 13, 1);
            EmitB(loop);
        }
        Mark(one);
        LoadImm(0, 1);
        EmitB(done);
        Mark(zero);
        LoadImm(0, 0);
        Mark(done);
        HostEnd();
    }

    void HostEmitStrOps() {
        HostEmitStrCase("_zan_ext_str_lower", 65, 90, 32);
        HostEmitStrCase("_zan_ext_str_upper", 97, 122, -32);
        HostEmitStrTrim();
        HostEmitStrCmp2("_zan_ext_str_equals", 0);
        HostEmitStrCmp2("_zan_ext_str_compareto", 1);
        HostEmitStrCmp2("_zan_ext_str_startswith", 2);
        HostEmitStrCmp2("_zan_ext_str_endswith", 3);
        HostEmitStrCmp2("_zan_ext_str_lastidx", 4);
    }

    // ---- x0 = char -> x0 = value 0..15, or -1 when not a hex digit
    // (frameless leaf: only x0 is touched, every return is a bare ret).
    // Unlike _zan_ext_nibble this distinguishes invalid from '0'.
    void HostEmitHexVal() {
        syms.Add(new Sym("_zan_ext_hexval", txt.Count));
        int hBad = NL(); int hLet = NL(); int hUp = NL();
        ExtCmpImm(0, 57);
        EmitBcond(12, hLet);
        ExtCmpImm(0, 48);
        EmitBcond(11, hBad);
        AddImm(0, 0, -48);
        E4(0xD65F03C0);
        Mark(hLet);
        ExtCmpImm(0, 102);
        EmitBcond(12, hBad);
        ExtCmpImm(0, 97);
        EmitBcond(11, hUp);
        AddImm(0, 0, -87);
        E4(0xD65F03C0);
        Mark(hUp);
        ExtCmpImm(0, 70);
        EmitBcond(12, hBad);
        ExtCmpImm(0, 65);
        EmitBcond(11, hBad);
        AddImm(0, 0, -55);
        E4(0xD65F03C0);
        Mark(hBad);
        LoadImm(0, -1);
        E4(0xD65F03C0);
    }

    // x0 = bytes, x1 = offset, x2 = count -> validated UTF-8 string. Invalid
    // leads / lone continuations / overlong encodings / window-truncated
    // tails each become U+FFFD (EF BF BD), matching the stdlib Zan.
    // Loop state lives in registers (no calls in the body):
    // x9 arr, x10 alen, x11 avail, x12 end, x13 i, x14 base, x15 cursor.
    void HostEmitUtf8() {
        HostEmitHexVal();
        HostBegin("_zan_ext_utf8_getstring3");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        int uHave = NL(); int uFin = NL(); int uLoop = NL(); int uMulti = NL();
        int uRet = NL();
        int uHaveNeed = NL(); int uFfd = NL(); int uOk = NL();
        int gA = NL(); int lA = NL(); int lB = NL(); int lC = NL();
        int kDone = NL(); int kLoop = NL(); int kBad = NL();
        int m1 = NL(); int m2 = NL();
        int rDone = NL(); int rLoop = NL();
        HostLoad(0, 0);
        CbzReg(0, uHave);
        // clamps
        ExtCountOf(0, 10);                     // alen
        HostLoad(0, 1);                        // offset
        ExtCmpImm(0, 0);
        int uOp = NL(); EmitBcond(10, uOp); LoadImm(0, 0); Mark(uOp);
        E4(0xEB0A001F);                        // cmp x0, x10
        int uOo = NL(); EmitBcond(9, uOo); ExtMov(0, 10); Mark(uOo);
        ExtSubRR(11, 10, 0);                   // avail
        HostLoad(1, 2);                        // count
        ExtCmpImm(1, 0);
        int uCp = NL(); EmitBcond(10, uCp); LoadImm(1, 0); Mark(uCp);
        E4(0xEB0B003F);                        // cmp x1, x11
        int uCo = NL(); EmitBcond(9, uCo); ExtMov(1, 11); Mark(uCo);
        HostSave(1, 2);                        // clamped count (x1 dies in malloc)
        // out = malloc(3 * count + 1): every input byte at worst becomes 3
        ExtLsl(0, 1, 1);
        AddRR(0, 0, 1);
        AddImm(0, 0, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.utf8.malloc");
        MovRR(15, 0);                          // cursor
        MovRR(14, 0);                          // base
        HostLoad(9, 0);                        // arr data
        HostLoad(13, 1);                       // i = offset (post-call)
        HostLoad(1, 2);                        // count (clamped, post-call)
        AddRR(12, 13, 1);                      // end = i + count
        EmitB(uLoop);
        Mark(uHave);
        LoadStr(extEmpty, 0);
        EmitB(uRet);
        Mark(uLoop);
        HostCmp(13, 12);
        EmitBcond(2, uFin);                    // i >= end -> done
        ExtLsl(16, 13, 3);                     // byte[] slots stride 8
        ExtLdrbReg(0, 9, 16);                  // b0
        ExtCmpImm(0, 128);
        EmitBcond(2, uMulti);                  // hs -> multibyte
        ExtStrbImm(0, 15, 0);                  // ascii: copy one byte
        AddImm(15, 15, 1);
        AddImm(13, 13, 1);
        EmitB(uLoop);
        Mark(uMulti);
        LoadImm(1, 0);                         // need = 0
        ExtCmpImm(0, 194);
        EmitBcond(2, gA);                      // >= 194
        EmitB(uFfd);
        Mark(gA);
        ExtCmpImm(0, 223);
        EmitBcond(9, lA);                      // <= 223 -> need 1
        ExtCmpImm(0, 239);
        EmitBcond(9, lB);                      // <= 239 -> need 2
        ExtCmpImm(0, 244);
        EmitBcond(9, lC);                      // <= 244 -> need 3
        EmitB(uFfd);                           // invalid lead
        Mark(lA);
        ExtUbfmLo(2, 0, 4);                    // cp = b0 & 31
        LoadImm(1, 1);
        EmitB(uHaveNeed);
        Mark(lB);
        ExtUbfmLo(2, 0, 3);                    // cp = b0 & 15
        LoadImm(1, 2);
        EmitB(uHaveNeed);
        Mark(lC);
        ExtUbfmLo(2, 0, 2);                    // cp = b0 & 7
        LoadImm(1, 3);
        Mark(uHaveNeed);
        // window truncation: i + need >= end -> FFFD
        E4(0x8B0101A3);                        // add x3, x13, x1
        HostCmp(3, 12);
        EmitBcond(2, uFfd);
        // continuation loop: k = 1 (x3), bad = x4
        LoadImm(3, 1);
        LoadImm(4, 0);
        Mark(kLoop);
        E4(0xEB01007F);                        // cmp x3, x1 (k, need)
        EmitBcond(8, kDone);                   // k > need -> done
        ExtLsl(16, 13, 3);                     // slot stride: src[i + k]
        ExtLsl(17, 3, 3);
        AddRR(5, 16, 17);                      // x5 = (i + k) * 8
        ExtLdrbReg(5, 9, 5);                   // bx
        // continuation bytes are exactly 128..191
        ExtCmpImm(5, 128);
        EmitBcond(3, kBad);
        ExtCmpImm(5, 191);
        EmitBcond(8, kBad);
        ExtLsl(2, 2, 6);                       // cp = (cp << 6) | (bx & 63)
        ExtUbfmLo(5, 5, 5);
        ExtOrr(2, 2, 5);
        AddImm(3, 3, 1);
        EmitB(kLoop);
        Mark(kBad);
        LoadImm(4, 1);
        Mark(kDone);
        CbnzReg(4, uFfd);                      // bad continuation -> FFFD
        // overlong: min = 128 / 2048 / 65536 by need
        ExtCmpImm(1, 1);
        EmitBcond(0, m1);
        ExtCmpImm(1, 2);
        EmitBcond(0, m2);
        ExtCmpImm(2, 65536);
        EmitBcond(3, uFfd);
        EmitB(uOk);
        Mark(m1);
        ExtCmpImm(2, 128);
        EmitBcond(3, uFfd);
        EmitB(uOk);
        Mark(m2);
        ExtCmpImm(2, 2048);
        EmitBcond(3, uFfd);
        Mark(uOk);
        // append the raw sequence: need + 1 bytes from i
        AddImm(6, 1, 1);                       // n = need + 1
        ExtLsl(16, 13, 3);                     // src slot offset = i * 8
        LoadImm(5, 0);                         // j
        Mark(rLoop);
        HostCmp(5, 6);
        EmitBcond(2, rDone);                   // j >= n -> done
        ExtLdrbReg(7, 9, 16);                  // src[i + j], stride 8
        ExtStrbImm(7, 15, 0);
        AddImm(15, 15, 1);
        AddImm(16, 16, 8);
        AddImm(5, 5, 1);
        EmitB(rLoop);
        Mark(rDone);
        E4(0x8B0601AD);                        // add x13, x13, x6 (i += need+1)
        EmitB(uLoop);
        Mark(uFfd);
        LoadImm(7, 239);
        ExtStrbImm(7, 15, 0);
        AddImm(15, 15, 1);
        LoadImm(7, 191);
        ExtStrbImm(7, 15, 0);
        AddImm(15, 15, 1);
        LoadImm(7, 189);
        ExtStrbImm(7, 15, 0);
        AddImm(15, 15, 1);
        AddImm(13, 13, 1);
        EmitB(uLoop);
        Mark(uFin);
        ExtStrbImm(31, 15, 0);
        ExtMov(0, 15);                         // cursor
        ExtSubRR(1, 0, 14);                    // produced = cursor - base
        ExtMov(0, 14);                         // base
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);                             // base
        HostSave(0, 5);                        // result
        HostSave(1, 6);                        // base
        HostLoad(0, 6);
        BLExtern("_free");
        HostLoad(0, 5);
        Mark(uRet);
        HostEnd();

        // x0 = bytes -> GetString(bytes, 0, length); null -> ""
        HostBegin("_zan_ext_utf8_getstring1");
        int s1N = NL(); int s1Fin = NL();
        HostSave(0, 0);
        HostLoad(0, 0);
        CbzReg(0, s1N);
        ExtCountOf(0, 2);                      // count (x2)
        LoadImm(1, 0);                         // offset (x1)
        BLInternal("_zan_ext_utf8_getstring3");
        EmitB(s1Fin);
        Mark(s1N);
        LoadStr(extEmpty, 0);
        Mark(s1Fin);
        HostEnd();
    }

    // x0 = string -> x0 = form-decoded string. Uses the string-header byte
    // length, so decoded NUL bytes survive. Malformed escapes keep '%'.
    // Loop registers: x9 s, x10 len, x11 cursor, x12 base, x13 i.
    void HostEmitUrl() {
        HostBegin("_zan_ext_urldecode");
        HostSave(0, 0);
        int dFin = NL(); int dLoop = NL();
        int dPlus = NL(); int dPct = NL(); int dHave2 = NL(); int dBadEsc = NL();
        HostLoad(9, 0);
        ExtLenOf(9, 10);
        HostLoad(0, 0);
        AddImm(0, 10, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.url.malloc");
        MovRR(11, 0);                          // cursor
        MovRR(12, 0);                          // base
        HostLoad(9, 0);                        // s
        LoadImm(13, 0);                        // i
        HostLoad(0, 0);
        ExtLenOf(0, 10);                       // len (reloaded post-call)
        Mark(dLoop);
        HostCmp(13, 10);
        EmitBcond(2, dFin);
        ExtLdrbReg(0, 9, 13);                  // c
        ExtCmpImm(0, 43);
        EmitBcond(0, dPlus);
        ExtCmpImm(0, 37);
        EmitBcond(0, dPct);
        ExtStrbImm(0, 11, 0);                  // default: copy c
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(dLoop);
        Mark(dPlus);
        LoadImm(0, 32);                        // '+' -> ' '
        ExtStrbImm(0, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(dLoop);
        Mark(dPct);
        AddImm(0, 13, 2);
        HostCmp(0, 10);
        EmitBcond(3, dHave2);                  // i + 2 < len
        EmitB(dBadEsc);
        Mark(dHave2);
        AddImm(0, 13, 1);
        ExtLdrbReg(1, 9, 0);                   // c1
        AddImm(0, 13, 2);
        ExtLdrbReg(2, 9, 0);                   // c2
        int dHO = NL(); int dLO = NL();
        ExtMov(0, 1);
        BLInternal("_zan_ext_hexval");
        ExtMov(3, 0);                          // h
        ExtMov(0, 2);
        BLInternal("_zan_ext_hexval");
        ExtMov(4, 0);                          // l
        ExtCmpImm(3, 0);
        EmitBcond(10, dHO);                    // h >= 0
        EmitB(dBadEsc);
        Mark(dHO);
        ExtCmpImm(4, 0);
        EmitBcond(10, dLO);                    // l >= 0
        EmitB(dBadEsc);
        Mark(dLO);
        ExtLsl(3, 3, 4);
        ExtOrr(3, 3, 4);
        ExtStrbImm(3, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 3);
        EmitB(dLoop);
        Mark(dBadEsc);
        LoadImm(0, 37);
        ExtStrbImm(0, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(dLoop);
        Mark(dFin);
        ExtStrbImm(31, 11, 0);
        ExtMov(0, 11);
        ExtSubRR(1, 0, 12);                    // produced
        ExtMov(0, 12);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 5);
        HostSave(1, 6);
        HostLoad(0, 6);
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();

        // x0 = string -> x0 = %XX-encoded string (RFC 3986 unreserved kept,
        // space becomes '+', lowercase hex escapes). Loop registers:
        // x9 s, x10 len, x11 cursor, x12 base, x13 i, x14 hex table.
        HostBegin("_zan_ext_urlencode");
        HostSave(0, 0);
        int eFin = NL(); int eLoop = NL();
        int eSp = NL(); int eUn = NL();
        int eA1 = NL(); int eA2 = NL(); int eA3 = NL();
        HostLoad(9, 0);
        ExtLenOf(9, 10);
        HostLoad(0, 0);
        ExtLsl(0, 10, 1);                      // worst case: 3 bytes per input
        AddRR(0, 0, 10);
        AddImm(0, 0, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.url.malloc");
        MovRR(11, 0);                          // cursor
        MovRR(12, 0);                          // base
        HostLoad(9, 0);                        // s
        LoadImm(13, 0);                        // i
        LoadStr(extTblHex, 14);
        HostLoad(0, 0);
        ExtLenOf(0, 10);                       // len (reloaded post-call)
        Mark(eLoop);
        HostCmp(13, 10);
        EmitBcond(2, eFin);
        ExtLdrbReg(0, 9, 13);                  // c
        ExtCmpImm(0, 65);
        EmitBcond(11, eA1);                    // < 'A'
        ExtCmpImm(0, 90);
        EmitBcond(9, eUn);                     // <= 'Z'
        Mark(eA1);
        ExtCmpImm(0, 97);
        EmitBcond(11, eA2);                    // < 'a'
        ExtCmpImm(0, 122);
        EmitBcond(9, eUn);                     // <= 'z'
        Mark(eA2);
        ExtCmpImm(0, 48);
        EmitBcond(11, eA3);                    // < '0'
        ExtCmpImm(0, 57);
        EmitBcond(9, eUn);                     // <= '9'
        Mark(eA3);
        ExtCmpImm(0, 45);
        EmitBcond(0, eUn);                     // '-'
        ExtCmpImm(0, 95);
        EmitBcond(0, eUn);                     // '_'
        ExtCmpImm(0, 46);
        EmitBcond(0, eUn);                     // '.'
        ExtCmpImm(0, 126);
        EmitBcond(0, eUn);                     // '~'
        ExtCmpImm(0, 32);
        EmitBcond(0, eSp);                     // ' '
        LoadImm(1, 37);                        // '%'
        ExtStrbImm(1, 11, 0);
        AddImm(11, 11, 1);
        ExtLsr(2, 0, 4);
        ExtLdrbReg(1, 14, 2);                  // high nibble digit
        ExtStrbImm(1, 11, 0);
        AddImm(11, 11, 1);
        ExtUbfmLo(2, 0, 3);
        ExtLdrbReg(1, 14, 2);                  // low nibble digit
        ExtStrbImm(1, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(eLoop);
        Mark(eSp);
        LoadImm(1, 43);                        // '+'
        ExtStrbImm(1, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(eLoop);
        Mark(eUn);
        ExtStrbImm(0, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(eLoop);
        Mark(eFin);
        ExtStrbImm(31, 11, 0);
        ExtMov(0, 11);
        ExtSubRR(1, 0, 12);
        ExtMov(0, 12);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 5);
        HostSave(1, 6);
        HostLoad(0, 6);
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();
    }

    // x0 = Sec-WebSocket-Key -> base64(SHA1(key + "258EAFA5-...")) (RFC 6455).
    void HostEmitWsAccept() {
        HostBegin("_zan_ext_wsaccept");
        HostSave(0, 0);
        int wKd = NL(); int wKl = NL(); int wSd = NL(); int wSl = NL();
        HostLoad(9, 0);
        ExtLenOf(9, 10);                       // key length
        HostLoad(0, 0);
        AddImm(0, 10, 37);                     // key + 36 suffix + NUL
        BLExtern("_malloc");
        HostNonzero(0, "ext.ws.malloc");
        MovRR(11, 0);                          // cursor
        MovRR(12, 0);                          // base
        HostLoad(9, 0);                        // key
        LoadImm(13, 0);
        HostLoad(0, 0);
        ExtLenOf(0, 10);                       // key length (reloaded post-call)
        Mark(wKl);
        HostCmp(13, 10);
        EmitBcond(2, wKd);
        ExtLdrbReg(0, 9, 13);
        ExtStrbImm(0, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(wKl);
        Mark(wKd);
        LoadStr(extWsGuid, 9);                 // suffix literal
        LoadImm(13, 0);
        Mark(wSl);
        ExtCmpImm(13, 36);
        EmitBcond(2, wSd);
        ExtLdrbReg(0, 9, 13);
        ExtStrbImm(0, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(wSl);
        Mark(wSd);
        ExtMov(0, 11);
        ExtSubRR(0, 0, 12);                    // total bytes
        BLInternal("_zan_ext_sha1");           // slot array, 20 bytes
        LoadImm(1, 20);
        LoadImm(2, 8);
        BLInternal("_zan_ext_b64_encode");
        HostEnd();
    }

    // Guid.New(): 16 random bytes, version nibble 4, RFC 4122 variant,
    // formatted 8-4-4-4-12 lowercase hex.
    void HostEmitGuid() {
        HostBegin("_zan_ext_guid_new");
        int gFin = NL(); int gLoop = NL(); int gDash = NL(); int gNoDash = NL();
        LoadImm(0, 17);
        BLExtern("_malloc");
        HostNonzero(0, "ext.guid.malloc");
        HostSave(0, 0);                        // buf (spilled: libc calls next)
        MovRR(9, 0);
        MovRR(0, 9);
        LoadImm(1, 16);
        BLExtern("_arc4random_buf");
        HostLoad(9, 0);                        // buf (reloaded post-call)
        ExtLdrbImm(0, 9, 6);
        ExtUbfmLo(0, 0, 3);                    // & 0x0F
        LoadImm(1, 64);
        ExtOrr(0, 0, 1);                       // | 0x40
        ExtStrbImm(0, 9, 6);
        ExtLdrbImm(0, 9, 8);
        ExtUbfmLo(0, 0, 5);                    // & 0x3F
        LoadImm(1, 128);
        ExtOrr(0, 0, 1);                       // | 0x80
        ExtStrbImm(0, 9, 8);
        LoadImm(0, 37);
        BLExtern("_malloc");
        HostNonzero(0, "ext.guid.malloc");
        MovRR(10, 0);                          // out cursor
        HostSave(0, 1);                        // out base (cursor advances)
        LoadImm(11, 0);                        // byte index
        LoadStr(extTblHex, 12);
        HostLoad(9, 0);                        // buf (reloaded post-call)
        Mark(gLoop);
        ExtCmpImm(11, 16);
        EmitBcond(2, gFin);
        ExtLdrbReg(0, 9, 11);                  // b
        ExtLsr(1, 0, 4);
        ExtLdrbReg(1, 12, 1);
        ExtStrbImm(1, 10, 0);
        AddImm(10, 10, 1);
        ExtUbfmLo(1, 0, 3);
        ExtLdrbReg(1, 12, 1);
        ExtStrbImm(1, 10, 0);
        AddImm(10, 10, 1);
        ExtCmpImm(11, 3);
        EmitBcond(0, gDash);
        ExtCmpImm(11, 5);
        EmitBcond(0, gDash);
        ExtCmpImm(11, 7);
        EmitBcond(0, gDash);
        ExtCmpImm(11, 9);
        EmitBcond(0, gDash);
        EmitB(gNoDash);
        Mark(gDash);
        LoadImm(1, 45);
        ExtStrbImm(1, 10, 0);
        AddImm(10, 10, 1);
        Mark(gNoDash);
        AddImm(11, 11, 1);
        EmitB(gLoop);
        Mark(gFin);
        ExtStrbImm(31, 10, 0);
        LoadImm(1, 36);
        HostLoad(0, 1);                        // out base
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);                             // x1 = out base
        HostSave(0, 5);                        // result
        HostSave(1, 6);                        // out base
        HostLoad(0, 0);                        // buf
        BLExtern("_free");
        HostLoad(0, 6);
        BLExtern("_free");                     // out scratch
        HostLoad(0, 5);
        HostEnd();

        // Guid.Parse(s): 36 chars, dashes at 8/13/18/23, hex elsewhere
        // (either case); returns the lowercased canonical text as the
        // Guid handle, or null.
        HostBegin("_zan_ext_guid_parse");
        HostSave(0, 0);
        int pFin = NL(); int pOk = NL(); int pDone = NL();
        int pLen = NL(); int pLoop = NL(); int pDash = NL();
        int cFin = NL(); int cLoop = NL(); int cGeA = NL(); int cLeZ = NL();
        HostLoad(9, 0);
        ExtLenOf(9, 10);
        ExtCmpImm(10, 36);
        EmitBcond(0, pLen);
        LoadImm(0, 0);
        EmitB(pFin);
        Mark(pLen);
        HostLoad(9, 0);                        // s
        LoadImm(11, 0);                        // i
        Mark(pLoop);
        ExtCmpImm(11, 36);
        EmitBcond(2, pOk);
        ExtCmpImm(11, 8);
        EmitBcond(0, pDash);
        ExtCmpImm(11, 13);
        EmitBcond(0, pDash);
        ExtCmpImm(11, 18);
        EmitBcond(0, pDash);
        ExtCmpImm(11, 23);
        EmitBcond(0, pDash);
        ExtLdrbReg(0, 9, 11);
        BLInternal("_zan_ext_hexval");
        ExtCmpImm(0, 0);
        EmitBcond(11, pFin);                   // -1 -> reject
        AddImm(11, 11, 1);
        EmitB(pLoop);
        Mark(pDash);
        ExtLdrbReg(0, 9, 11);
        ExtCmpImm(0, 45);
        EmitBcond(11, pFin);                   // < '-' -> reject
        EmitBcond(12, pFin);                   // > '-' -> reject
        AddImm(11, 11, 1);
        EmitB(pLoop);
        Mark(pOk);
        LoadImm(0, 37);
        BLExtern("_malloc");
        HostNonzero(0, "ext.guid.malloc");
        MovRR(10, 0);                          // out cursor
        HostSave(0, 1);                        // out base (cursor advances)
        LoadImm(11, 0);                        // i
        HostLoad(9, 0);                        // s reload
        int cCopy = NL();
        Mark(cLoop);
        ExtCmpImm(11, 36);
        EmitBcond(2, cFin);
        ExtLdrbReg(0, 9, 11);
        ExtCmpImm(0, 65);
        EmitBcond(2, cGeA);                    // >= 'A'
        EmitB(cCopy);                          // else copy as-is
        Mark(cGeA);
        ExtCmpImm(0, 90);
        EmitBcond(9, cLeZ);                    // <= 'Z' -> lowercase
        EmitB(cCopy);                          // else copy as-is
        Mark(cLeZ);
        AddImm(0, 0, 32);                      // + 32
        Mark(cCopy);
        ExtStrbImm(0, 10, 0);
        AddImm(10, 10, 1);
        AddImm(11, 11, 1);
        EmitB(cLoop);
        Mark(cFin);
        ExtStrbImm(31, 10, 0);
        LoadImm(1, 36);
        HostLoad(0, 1);                        // out base
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);                             // x1 = out base
        HostSave(0, 5);                        // result
        HostSave(1, 6);                        // out base
        HostLoad(0, 6);
        BLExtern("_free");                     // out scratch
        HostLoad(0, 5);
        EmitB(pDone);
        Mark(pFin);
        LoadImm(0, 0);
        Mark(pDone);
        HostEnd();
    }

    // x0 = count -> x0 = zero-filled array (8-byte slots). Negative counts
    // behave as 0; callers keep counts <= 2^28 so the slot math cannot wrap.
    void HostEmitArrNew() {
        HostBegin("_zan_ext_arr_new");
        ExtCmpImm(0, 0);
        int nonneg = NL();
        EmitBcond(10, nonneg);
        LoadImm(0, 0);
        Mark(nonneg);
        ExtPush(0);                            // count (clamped)
        ExtLsl(0, 0, 3);                       // bytes = count * 8
        AddImm(0, 0, 32);
        LoadImm(1, 1);
        BLExtern("_calloc");
        HostNonzero(0, "ext.arr.calloc");
        MovRR(1, 0);                           // x1 = raw
        LoadImm(2, 1);
        StrU(2, 1, 0);                         // raw->rc = 1
        LoadImm(2, 25404552263127619);
        StrU(2, 1, 8);                         // raw->rcmagic
        ExtPop(2);
        StrU(2, 1, 16);                        // raw->count
        LoadImm(2, 6503565379360670041);
        StrU(2, 1, 24);                        // raw->magic2
        AddImm(0, 1, 32);                      // arr
        HostEnd();
    }

    // x0 = dst array, x1 = src buffer, x2 = count -> copies count bytes
    // into the array in the packed layout Zan element reads use (ArrElemSize:
    // byte[] elements are one byte).
    void HostEmitSlotCopy() {
        HostBegin("_zan_ext_slot_copy");
        LoadImm(9, 0);                         // i
        int done = NL(); int loop = NL();
        Mark(loop);
        E4(0xEB02013F);                        // cmp x9, x2
        EmitBcond(2, done);                    // hs -> done
        ExtLdrbReg(10, 1, 9);                  // w10 = src[i]
        E4(0x8B09000B);                        // add x11, x0, x9
        ExtStrbImm(10, 11, 0);                 // dst[i] = w10
        AddImm(9, 9, 1);
        EmitB(loop);
        Mark(done);
        HostEnd();
    }

    void HostEmitToBytes() {
        HostBegin("_zan_ext_to_bytes");
        HostSave(0, 0);                        // src
        HostLoad(9, 0);
        ExtLenOf(9, 9);
        HostSave(9, 2);                        // len (x9 dies across the call)
        ExtMov(0, 9);
        BLInternal("_zan_ext_arr_new");
        HostSave(0, 1);                        // arr
        ExtMov(10, 0);                         // dst cursor (packed bytes)
        HostLoad(11, 2);                       // remaining
        HostLoad(12, 0);                       // src cursor
        int tbDone = NL();
        int tbLoop = NL();
        Mark(tbLoop);
        CbzReg(11, tbDone);
        ExtLdrbImm(13, 12, 0);                 // byte -> w13
        ExtStrbImm(13, 10, 0);                 // dst[i] = byte (packed layout)
        AddImm(10, 10, 1);
        AddImm(12, 12, 1);
        AddImm(11, 11, -1);
        EmitB(tbLoop);
        Mark(tbDone);
        HostLoad(0, 1);
        HostEnd();
    }

    // x0 = arr, x1 = start, x2 = len -> stamped string copy. One byte per
    // 8-byte slot, low byte of each slot. Clamps mirror the stdlib ToStr:
    // start<0 -> 0, start>count -> count, len<0 -> 0, len beyond the tail
    // truncates; null converges to the empty string.
    void HostEmitSlice() {
        HostBegin("_zan_ext_arr_slice_str");
        HostSave(0, 0);
        HostSave(1, 1);
        HostSave(2, 2);
        HostLoad(0, 0);
        ExtCountOf(0, 9);                      // x9 = count
        HostLoad(1, 1);
        ExtCmpImm(1, 0);
        int sPos = NL();
        EmitBcond(10, sPos);
        LoadImm(1, 0);
        Mark(sPos);
        HostCmp(1, 9);                         // cmp start, count
        int sIn = NL();
        EmitBcond(9, sIn);                     // b.ls keep
        ExtMov(1, 9);
        Mark(sIn);
        HostLoad(2, 2);
        ExtCmpImm(2, 0);
        int lPos = NL();
        EmitBcond(10, lPos);
        LoadImm(2, 0);
        Mark(lPos);
        ExtSubRR(9, 9, 1);                     // avail = count - start
        HostCmp(2, 9);
        int lIn = NL();
        EmitBcond(9, lIn);
        ExtMov(2, 9);
        Mark(lIn);
        HostSave(1, 1);                        // clamped start
        HostSave(2, 2);                        // clamped len
        HostLoad(0, 2);
        AddImm(0, 0, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.slice.malloc");
        HostSave(0, 3);                        // out
        ExtMov(10, 0);                         // out cursor
        HostLoad(11, 2);                       // remaining (x2 died in malloc)
        HostLoad(12, 0);                       // arr
        HostLoad(13, 1);                       // start
        ExtLsl(13, 13, 3);
        AddRR(12, 12, 13);                     // slot cursor
        int slDone = NL();
        int slLoop = NL();
        Mark(slLoop);
        CbzReg(11, slDone);
        LdrU(14, 12, 0);                       // slot value
        ExtUbfmLo(14, 14, 7);                  // low byte
        ExtStrbImm(14, 10, 0);
        AddImm(10, 10, 1);
        AddImm(12, 12, 8);
        AddImm(11, 11, -1);
        EmitB(slLoop);
        Mark(slDone);
        ExtStrbImm(31, 10, 0);                 // NUL
        HostLoad(0, 3);
        HostLoad(1, 2);
        BLInternal("_zan_host_copy");          // stamps + NUL
        HostSave(0, 4);
        HostLoad(0, 3);
        BLExtern("_free");
        HostLoad(0, 4);
        HostEnd();
    }

    // x0 = hex string -> byte[]; invalid digits read as 0 (stdlib nibble)
    void HostEmitHexDecode() {
        // x0 = base, x1 = len (>= 0), x2 = stride -> lowercase hex string
        HostBegin("_zan_ext_hex_encode");
        HostSave(0, 0);                        // base
        HostSave(1, 1);                        // len
        HostSave(2, 2);                        // stride
        ExtLsl(0, 1, 1);
        AddImm(0, 0, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.hex.malloc");
        ExtMov(10, 0);                         // write cursor
        HostSave(0, 3);                        // out
        HostLoad(14, 1);
        ExtLsl(11, 14, 1);
        AddRR(11, 11, 10);                     // write end = out + 2*len
        LoadStr(extTblHex, 13);
        HostLoad(9, 0);                        // read cursor
        HostLoad(12, 2);                       // stride
        int hxDone = NL();
        int hxLoop = NL();
        Mark(hxLoop);
        HostCmp(10, 11);
        EmitBcond(2, hxDone);
        ExtLdrbImm(4, 9, 0);                   // b
        ExtLsr(5, 4, 4);
        ExtLdrbReg(5, 13, 5);                  // tbl[b >> 4]
        ExtStrbImm(5, 10, 0);
        AddImm(10, 10, 1);
        ExtUbfmLo(5, 4, 3);                    // b & 15
        ExtLdrbReg(5, 13, 5);
        ExtStrbImm(5, 10, 0);
        AddImm(10, 10, 1);
        AddRR(9, 9, 12);
        EmitB(hxLoop);
        Mark(hxDone);
        ExtStrbImm(31, 10, 0);
        HostLoad(0, 3);                        // out (string start)
        HostLoad(1, 1);
        ExtLsl(1, 1, 1);                       // produced length
        ExtPush(0);                            // keep out across the copy
        BLInternal("_zan_host_copy");
        ExtPop(1);                             // x1 = out (sp restored, x0 = result)
        HostSave(0, 4);                        // result
        HostSave(1, 5);                        // out
        HostLoad(0, 5);                        // free(out)
        BLExtern("_free");
        HostLoad(0, 4);
        HostEnd();

        // frameless leaf: nibble only reads and writes x0 and never calls,
        // so every return path below is a bare ret
        syms.Add(new Sym("_zan_ext_nibble", txt.Count));
        int nBad = NL(); int nLet = NL(); int nUp = NL();
        ExtCmpImm(0, 57);
        EmitBcond(12, nLet);                   // > '9' -> letters
        ExtCmpImm(0, 48);
        EmitBcond(11, nBad);                   // < '0' -> invalid
        AddImm(0, 0, -48);
        E4(0xD65F03C0);                        // ret (0-9)
        Mark(nLet);
        ExtCmpImm(0, 102);
        EmitBcond(12, nBad);                   // > 'f' -> invalid
        ExtCmpImm(0, 97);
        EmitBcond(11, nUp);                    // < 'a' -> uppercase
        AddImm(0, 0, -87);
        E4(0xD65F03C0);                        // ret (a-f)
        Mark(nUp);
        ExtCmpImm(0, 70);
        EmitBcond(12, nBad);                   // > 'F' -> invalid
        ExtCmpImm(0, 65);
        EmitBcond(11, nBad);                   // < 'A' -> invalid
        AddImm(0, 0, -55);
        E4(0xD65F03C0);                        // ret (A-F)
        Mark(nBad);
        LoadImm(0, 0);
        E4(0xD65F03C0);

        HostBegin("_zan_ext_hex_decode");
        HostSave(0, 0);                        // s
        HostLoad(9, 0);
        ExtLenOf(9, 9);
        ExtLsr(0, 9, 1);                       // n = len / 2
        HostSave(9, 2);                        // n (x9 dies across the call)
        BLInternal("_zan_ext_arr_new");
        HostSave(0, 1);                        // arr
        ExtMov(10, 0);                         // slot cursor
        HostLoad(11, 2);                       // n remaining
        HostLoad(12, 0);                       // s cursor
        int hdDone = NL();
        int hdLoop = NL();
        Mark(hdLoop);
        CbzReg(11, hdDone);
        ExtLdrbImm(13, 12, 0);                 // c1
        ExtMov(0, 13);
        BLInternal("_zan_ext_nibble");         // nibble only touches x0/x9
        ExtMov(13, 0);
        ExtLdrbImm(14, 12, 1);                 // c2
        ExtMov(0, 14);
        BLInternal("_zan_ext_nibble");
        ExtMov(14, 0);
        ExtLsl(13, 13, 4);
        ExtOrr(13, 13, 14);                    // byte = (c1 << 4) | c2
        StrU(13, 10, 0);
        AddImm(10, 10, 8);
        AddImm(12, 12, 2);
        AddImm(11, 11, -1);
        EmitB(hdLoop);
        Mark(hdDone);
        HostLoad(0, 1);
        HostEnd();
    }

    // x0 = base, x1 = len (>= 0), x2 = stride -> standard base64, padded
    void HostEmitB64() {
        HostBegin("_zan_ext_b64_encode");
        HostSave(0, 0);                        // base
        HostSave(1, 1);                        // len
        HostSave(2, 2);                        // stride
        LoadImm(4, 3);
        ExtUdiv(5, 1, 4);                      // groups = len / 3
        HostSave(5, 3);                        // groups
        ExtMsub(6, 5, 4, 1);                   // rem = len - groups * 3
        ExtLsl(7, 5, 2);                       // outlen = groups * 4
        int rem0 = NL();
        CbzReg(6, rem0);
        AddImm(7, 7, 4);
        Mark(rem0);
        AddImm(0, 7, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.b64.malloc");
        ExtMov(10, 0);                         // out cursor
        HostSave(0, 4);                        // out
        HostLoad(9, 0);                        // base cursor
        HostLoad(11, 3);                       // groups remaining
        HostLoad(12, 2);                       // stride
        AddRR(15, 12, 12);                     // 2 * stride
        LoadStr(extTblB64, 13);
        int gDone = NL();
        int gLoop = NL();
        Mark(gLoop);
        CbzReg(11, gDone);
        ExtLdrbImm(3, 9, 0);                   // b0
        ExtLdrbReg(4, 9, 12);                  // b1
        ExtLdrbReg(5, 9, 15);                  // b2
        ExtLsl(6, 3, 16);
        ExtLsl(7, 4, 8);
        ExtOrr(6, 6, 7);
        ExtOrr(6, 6, 5);                       // n = (b0<<16)|(b1<<8)|b2
        ExtLsr(3, 6, 18);
        ExtLdrbReg(3, 13, 3);                  // c0
        ExtStrbImm(3, 10, 0);
        ExtUbfmR(3, 6, 12, 17);                // (n >> 12) & 63
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 1);
        ExtUbfmR(3, 6, 6, 11);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 2);
        ExtUbfmLo(3, 6, 5);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 3);
        AddImm(10, 10, 4);
        LoadImm(4, 3);
        ExtMadd(9, 12, 4, 9);                  // base += 3 * stride
        AddImm(11, 11, -1);
        EmitB(gLoop);
        Mark(gDone);
        HostLoad(6, 1);                        // len
        LoadImm(4, 3);
        ExtUdiv(7, 6, 4);                      // groups
        ExtMsub(7, 7, 4, 6);                   // rem
        // the group cursor (x10) already points past the full groups
        int tRem2 = NL();
        ExtCmpImm(7, 2);
        int tIs2 = NL();
        EmitBcond(0, tIs2);                    // eq -> rem == 2
        ExtCmpImm(7, 1);
        int tIs1 = NL();
        EmitBcond(0, tIs1);                    // eq -> rem == 1
        EmitB(tRem2);                          // rem == 0: nothing
        Mark(tIs1);
        ExtLdrbImm(3, 9, 0);                   // b0
        ExtLsl(6, 3, 16);
        ExtLsr(3, 6, 18);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 0);
        ExtUbfmR(3, 6, 12, 17);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 1);
        LoadImm(3, 61);                        // '='
        ExtStrbImm(3, 10, 2);
        ExtStrbImm(3, 10, 3);
        AddImm(10, 10, 4);
        EmitB(tRem2);
        Mark(tIs2);
        ExtLdrbImm(3, 9, 0);
        ExtLdrbReg(4, 9, 12);
        ExtLsl(6, 3, 16);
        ExtLsl(7, 4, 8);
        ExtOrr(6, 6, 7);
        ExtLsr(3, 6, 18);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 0);
        ExtUbfmR(3, 6, 12, 17);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 1);
        ExtUbfmR(3, 6, 6, 11);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 2);
        LoadImm(3, 61);
        ExtStrbImm(3, 10, 3);
        AddImm(10, 10, 4);
        Mark(tRem2);
        ExtStrbImm(31, 10, 0);
        ExtMov(0, 10);                         // x0 = end cursor
        HostLoad(1, 4);
        ExtSubRR(1, 0, 1);                     // produced length = end - out
        HostLoad(0, 4);                        // out (string start)
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);                             // x1 = out (sp restored, x0 = result)
        HostSave(0, 5);                        // result
        HostSave(1, 6);                        // out
        HostLoad(0, 6);                        // free(out)
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();

        HostBegin("_zan_ext_b64_str");
        HostSave(0, 0);
        HostLoad(9, 0);
        ExtLenOf(9, 9);
        HostLoad(0, 0);
        ExtMov(1, 9);
        LoadImm(2, 1);
        BLInternal("_zan_ext_b64_encode");
        HostEnd();
    }

    // x0 = msg string, x1 = len -> byte[] digest (len clamped to the string).
    // CommonCrypto is re-exported by libSystem, so -lSystem resolves it.
    void HostEmitDigests() {
        HostBegin("_zan_ext_sha256");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0); ExtLenOf(9, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 2);
        HostLoad(0, 0); HostLoad(1, 2); AddImm(2, 31, 64);
        BLExtern("_CC_SHA256");
        LoadImm(0, 32); BLInternal("_zan_ext_arr_new"); HostSave(0, 3);
        HostLoad(0, 3); AddImm(1, 31, 64); LoadImm(2, 32);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 3);
        HostEnd();

        HostBegin("_zan_ext_sha1");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0); ExtLenOf(9, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 2);
        HostLoad(0, 0); HostLoad(1, 2); AddImm(2, 31, 64);
        BLExtern("_CC_SHA1");
        LoadImm(0, 20); BLInternal("_zan_ext_arr_new"); HostSave(0, 3);
        HostLoad(0, 3); AddImm(1, 31, 64); LoadImm(2, 20);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 3);
        HostEnd();

        HostBegin("_zan_ext_md5");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0); ExtLenOf(9, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 2);
        HostLoad(0, 0); HostLoad(1, 2); AddImm(2, 31, 64);
        BLExtern("_CC_MD5");
        LoadImm(0, 16); BLInternal("_zan_ext_arr_new"); HostSave(0, 3);
        HostLoad(0, 3); AddImm(1, 31, 64); LoadImm(2, 16);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 3);
        HostEnd();

        HostBegin("_zan_ext_sha512");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0); ExtLenOf(9, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 2);
        HostLoad(0, 0); HostLoad(1, 2); AddImm(2, 31, 64);
        BLExtern("_zan_sha512");
        LoadImm(0, 64); BLInternal("_zan_ext_arr_new"); HostSave(0, 3);
        HostLoad(0, 3); AddImm(1, 31, 64); LoadImm(2, 64);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 3);
        HostEnd();

        // x0 = key, x1 = keyLen, x2 = msg, x3 = msgLen -> 32-byte MAC
        HostBegin("_zan_ext_hmac_sha256");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2); HostSave(3, 3);
        HostLoad(4, 0); ExtLenOf(4, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 4);
        HostLoad(4, 2); ExtLenOf(4, 9);
        HostLoad(0, 3); ExtMov(1, 9); ExtClampLen(); HostSave(0, 5);
        LoadImm(0, 2);                          // kCCHmacAlgSHA256
        HostLoad(1, 0); HostLoad(2, 4); HostLoad(3, 2); HostLoad(4, 5);
        AddImm(5, 31, 64);
        BLExtern("_CCHmac");
        LoadImm(0, 32); BLInternal("_zan_ext_arr_new"); HostSave(0, 6);
        HostLoad(0, 6); AddImm(1, 31, 64); LoadImm(2, 32);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 6);
        HostEnd();
    }

    // ===================== interop / threading emitters =====================
    // Everything here is emitted AFTER HostEmitExt, so the list/string
    // helpers it builds on (_zan_host_list_new/_push, _zan_host_copy,
    // _zan_rt_str_alloc) already exist.

    void HostEmitHost2() {
        HostEmitStrSplit();
        HostEmitStrContains();
        HostEmitDlErrorStr();
        HostEmitGetCwd();
        HostEmitNmGetStr();
        HostEmitNmSha();
        HostEmitThreadHelpers();
        HostEmitIntTryParse();
        HostEmitMkdirs();
        HostEmitDelRec();
    }

    // x0 = path -> void. mkdir every "/"- or "\\"-delimited prefix
    // (mkdir -p); existing prefixes are ignored (mkdir EEXIST).
    void HostEmitMkdirs() {
        HostBeginN("_zan_dir_mkdirs", 2048);
        HostSave(0, 0);                          // path (buffer at sp+128)
        HostLoad(0, 0);
        BLExtern("_strlen");
        HostSave(0, 1);                          // len
        LoadImm(0, 1);
        HostSave(0, 2);                          // i = 1
        int mLoop = NL(); int mNext = NL(); int mDone = NL();
        int mSlash = NL(); int mEqLen = NL();
        EmitB(mLoop);
        Mark(mLoop);
        HostLoad(9, 2);
        HostLoad(10, 1);
        HostCmp(9, 10);
        EmitBcond(12, mDone);                    // i > len
        AddImm(9, 9, -1);
        HostLoad(10, 0);                         // path
        AddRR(10, 10, 9);                        // path + i - 1
        ExtLdrbImm(11, 10, 0);
        ExtCmpImm(11, 47);
        EmitBcond(0, mSlash);                    // '/'
        ExtCmpImm(11, 92);
        EmitBcond(0, mSlash);                    // '\\'
        HostLoad(9, 2);
        HostLoad(10, 1);
        HostCmp(9, 10);
        EmitBcond(0, mEqLen);                    // i == len: full path
        EmitB(mNext);
        Mark(mEqLen);
        Mark(mSlash);
        AddImm(0, 31, 128);                      // dst = buffer
        HostLoad(1, 0);                          // src = path
        HostLoad(2, 2);                          // n = i
        BLExtern("_memcpy");
        AddImm(9, 31, 128);
        HostLoad(10, 2);
        AddRR(9, 9, 10);                         // buffer + i
        E4(0x3900013F);                          // strb wzr, [x9]
        AddImm(0, 31, 128);
        LoadImm(1, 511);                         // 0o777, umask applies
        BLExtern("_mkdir");
        Mark(mNext);
        HostLoad(9, 2);
        AddImm(9, 9, 1);
        HostSave(9, 2);
        EmitB(mLoop);
        Mark(mDone);
        HostEndN(2048);
    }

    // x0 = path -> bool. Recursively removes the tree: files unlinked,
    // subdirectories recursed, then rmdir; a missing path is success,
    // anything that survives the attempt fails. Mirrors the reference
    // Directory.DeleteRecursive contract.
    void HostEmitDelRec() {
        HostBeginN("_zan_dir_delrec", 176);      // stat buffer at sp+128
        HostSave(0, 0);                          // path
        int Lmiss = NL(); int Lfile = NL(); int Lrm = NL(); int Lret = NL();
        int Lloop = NL(); int Lnext = NL(); int Ldone = NL();
        int Ldot = NL(); int Lkeep = NL(); int Ld1 = NL(); int Ldir2 = NL();
        int Lmerge = NL(); int Lunlok = NL(); int Lgone = NL();
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        HostCbnzW(Lmiss);                        // stat failed: missing
        E4(0x79400000 | (66 << 10) | (31 << 5) | 9);   // ldrh w9,[sp,#132]
        E4(0x530C3D29);                          // ubfm w9, w9, #12, #15
        LoadImm(10, 4);
        HostCmp(9, 10);
        int Lisdir = NL();
        EmitBcond(0, Lisdir);
        EmitB(Lfile);
        Mark(Lisdir);
        HostLoad(0, 0);
        BLExtern("_opendir");
        CbzReg(0, Lrm);                          // unreadable: go rmdir
        HostSave(0, 1);                          // DIR*
        LoadImm(0, 1);
        HostSave(0, 2);                          // ok = 1
        EmitB(Lloop);
        Mark(Lloop);
        HostLoad(0, 1);
        BLExtern("_readdir");
        CbzReg(0, Ldone);
        HostSave(0, 3);                          // dirent*
        AddImm(9, 0, 21);                        // d_name
        ExtLdrbImm(10, 9, 0);
        ExtCmpImm(10, 46);
        EmitBcond(0, Ldot);
        EmitB(Lkeep);
        Mark(Ldot);
        ExtLdrbImm(10, 9, 1);
        ExtCmpImm(10, 0);
        EmitBcond(0, Lnext);                     // "."
        ExtCmpImm(10, 46);
        EmitBcond(0, Ld1);
        EmitB(Lkeep);
        Mark(Ld1);
        ExtLdrbImm(10, 9, 2);
        ExtCmpImm(10, 0);
        EmitBcond(0, Lnext);                     // ".."
        Mark(Lkeep);
        // full = path + "/" + name, over a stamped copy of d_name
        // (strcat2 requires stamped strings)
        HostLoad(9, 3);
        AddImm(0, 9, 21);
        BLExtern("_strlen");
        MovRR(1, 0);
        HostLoad(9, 3);
        AddImm(0, 9, 21);
        BLInternal("_zan_host_copy");
        MovRR(1, 0);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_combine");
        HostSave(0, 4);                          // full path (owning string)
        HostLoad(0, 4);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        HostCbnzW(Lnext);                        // unstatable: skip entry
        E4(0x79400000 | (66 << 10) | (31 << 5) | 9);
        E4(0x530C3D29);
        LoadImm(10, 4);
        HostCmp(9, 10);
        EmitBcond(0, Ldir2);
        HostLoad(0, 4);
        BLExtern("_unlink");
        ExtCmpImm(0, 0);
        LoadImm(9, 1);
        EmitBcond(0, Lunlok);
        LoadImm(9, 0);
        EmitB(Lmerge);
        Mark(Lunlok);
        EmitB(Lmerge);
        Mark(Ldir2);
        HostLoad(0, 4);
        BLInternal("_zan_dir_delrec");           // recurse
        MovRR(9, 0);
        Mark(Lmerge);
        HostLoad(10, 2);
        E4(0x8A09014A);                          // and x10, x10, x9
        HostSave(10, 2);                         // ok &= sub-result
        Mark(Lnext);
        EmitB(Lloop);
        Mark(Ldone);
        HostLoad(0, 1);
        BLExtern("_closedir");
        EmitB(Lrm);
        Mark(Lrm);
        HostLoad(0, 0);
        BLExtern("_rmdir");
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        HostCbnzW(Lgone);                        // stat failed: gone
        LoadImm(0, 0);                           // still present: fail
        EmitB(Lret);
        Mark(Lgone);
        HostLoad(0, 2);                          // gone: return ok
        Mark(Lret);
        Mark(Lfile);
        HostLoad(0, 0);
        BLExtern("_unlink");
        LoadImm(0, 1);
        EmitB(Lret);
        Mark(Lmiss);
        LoadImm(0, 1);
        Mark(Lret);
        HostEndN(176);
    }

    // x0 = text, x1 = out address -> bool. strtoll(base 10); ok = the whole
    // text was consumed (endp moved past the start AND stopped at NUL);
    // *out = ok ? value : 0.
    void HostEmitIntTryParse() {
        // entry: x0 = out address, x1 = text. Slots: 0=out, 1=text,
        // 2=endp, 3=parsed value. ok = endp != text && *endp == 0.
        HostBegin("_zan_host_int_tryparse");
        HostSave(0, 0); HostSave(1, 1);
        LoadImm(0, 0); HostSave(0, 2);         // endp = NULL
        HostLoad(0, 1);                        // x0 = nptr (text)
        AddImm(1, 31, 16);                     // x1 = &endp (char**)
        LoadImm(2, 10);                        // base 10
        BLExtern("_strtoll");
        HostSave(0, 3);                        // parsed value
        HostLoad(0, 2);                        // endp
        HostLoad(1, 1);                        // text
        HostCmp(0, 1);
        int tpFail = NL(); int tpOk = NL(); int tpFin = NL();
        EmitBcond(0, tpFail);                  // endp == text: no digits
        ExtLdrbImm(9, 0, 0);                   // w9 = *endp
        ExtCmpImm(9, 0);
        EmitBcond(0, tpOk);                    // NUL: whole text consumed
        EmitB(tpFail);
        Mark(tpOk);
        LoadImm(0, 1); EmitB(tpFin);
        Mark(tpFail);
        LoadImm(0, 0);
        Mark(tpFin);
        int tpZero = NL(); int tpStore = NL();
        CbzReg(0, tpZero);                     // failure stores 0
        HostLoad(0, 3); EmitB(tpStore);
        Mark(tpZero); LoadImm(0, 0);
        Mark(tpStore);
        HostLoad(1, 0); StrU(0, 1, 0);         // *out = value
        HostEnd();
    }

    // x0 = string, x1 = separator, x2 = list. Pushes every occurrence-free
    // segment as a fresh owning string; an empty separator yields the whole
    // string once; empty segments (including the tail) are kept. Mirrors the
    // reference __zan_str_split exactly.
    void HostEmitStrSplit() {
        HostBegin("_zan_str_split");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        HostLoad(0, 1); BLExtern("_strlen"); HostSave(0, 3);
        HostLoad(9, 3); ExtCmpImm(9, 0);
        int spEmpty = NL(); int spDone = NL();
        int spLoop = NL(); int spTail = NL();
        EmitBcond(0, spEmpty);                 // seplen == 0 -> one element
        HostLoad(0, 0); HostSave(0, 4);        // cur = s
        EmitB(spLoop);
        Mark(spEmpty);
        HostLoad(0, 0); BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 0); BLInternal("_zan_host_copy");
        MovRR(1, 0); HostLoad(0, 2); BLInternal("_zan_host_list_push");
        EmitB(spDone);
        Mark(spLoop);
        HostLoad(0, 4); HostLoad(1, 1); BLExtern("_strstr");
        CbzReg(0, spTail);                     // no more separators
        HostSave(0, 5);                        // hit
        HostLoad(0, 5); HostLoad(1, 4); ExtSubRR(0, 0, 1);   // seglen
        MovRR(1, 0); HostLoad(0, 4); BLInternal("_zan_host_copy");
        MovRR(1, 0); HostLoad(0, 2); BLInternal("_zan_host_list_push");
        HostLoad(0, 5); HostLoad(1, 3); AddRR(0, 0, 1);      // cur = hit + seplen
        HostSave(0, 4);
        EmitB(spLoop);
        Mark(spTail);
        HostLoad(0, 4); BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 4); BLInternal("_zan_host_copy");
        MovRR(1, 0); HostLoad(0, 2); BLInternal("_zan_host_list_push");
        Mark(spDone);
        HostLoad(0, 2);
        HostEnd();
    }

    // x0 = string, x1 = needle -> bool via strstr (null-safe for the empty
    // needle: strstr(s, "") == s, so "" is contained everywhere).
    void HostEmitStrContains() {
        HostBegin("_zan_ext_str_contains");
        BLExtern("_strstr");
        int ctNo = NL(); int ctFin = NL();
        ExtCmpImm(0, 0);
        EmitBcond(0, ctNo);
        LoadImm(0, 1); EmitB(ctFin);
        Mark(ctNo); LoadImm(0, 0);
        Mark(ctFin);
        HostEnd();
    }

    // x0 = char* from dlerror -> owning stamped string ("" when null). The
    // error state is consumed by the call, matching libc.
    void HostEmitDlErrorStr() {
        HostBegin("_zan_host_dlerror_str");
        BLExtern("_dlerror");
        int dlNull = NL(); int dlFin = NL();
        CbzReg(0, dlNull);
        HostSave(0, 0);
        BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 0); BLInternal("_zan_host_copy");
        EmitB(dlFin);
        Mark(dlNull);
        LoadStr(extEmpty, 0);
        Mark(dlFin);
        HostEnd();
    }

    // getcwd -> owning stamped string (2048-byte buffer above the frame;
    // the whole frame must stay under the imm12 SP-adjust limit of 4096).
    void HostEmitGetCwd() {
        HostBeginN("_zan_host_getcwd", 2048);
        AddImm(0, 31, 128); LoadImm(1, 2048);
        BLExtern("_getcwd");
        int cwFail = NL(); int cwFin = NL();
        CbzReg(0, cwFail);                     // null result -> fail closed
        HostSave(0, 0);
        BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 0); BLInternal("_zan_host_copy");
        EmitB(cwFin);
        Mark(cwFail);
        HostFailAt("dir.getcwd");
        Mark(cwFin);
        HostEndN(2048);
    }

    // x0 = byte[] object, x1 = offset, x2 = count -> owning string of the
    // byte elements [offset, offset+count). Elements live one per 8-byte
    // slot; off/count are clamped to the array (null array -> "").
    void HostEmitNmGetStr() {
        HostBegin("_zan_nm_getstring");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        HostLoad(0, 2); ExtCmpImm(0, 0);
        int gsCPos = NL(); EmitBcond(10, gsCPos); LoadImm(0, 0);
        Mark(gsCPos); HostSave(0, 2);
        HostLoad(0, 1); ExtCmpImm(0, 0);
        int gsOPos = NL(); EmitBcond(10, gsOPos); LoadImm(0, 0);
        Mark(gsOPos); HostSave(0, 1);
        HostLoad(0, 0); ExtCountOf(0, 9);
        HostLoad(1, 1); ExtSubRR(9, 9, 1);     // avail = count - off
        ExtCmpImm(9, 0);
        int gsAPos = NL(); EmitBcond(10, gsAPos); LoadImm(9, 0);
        Mark(gsAPos);
        HostLoad(0, 2); HostCmp(0, 9);         // n = min(count, avail)
        int gsKeep = NL(); EmitBcond(9, gsKeep); ExtMov(0, 9);
        Mark(gsKeep); HostSave(0, 2);
        HostLoad(0, 2); AddImm(0, 0, 1);
        BLInternal("_zan_rt_str_alloc"); HostSave(0, 3);
        LoadImm(4, 0);
        int gsLoop = NL(); int gsDone = NL();
        Mark(gsLoop);
        HostLoad(5, 2); HostCmp(4, 5);
        EmitBcond(2, gsDone);                  // i >= n -> done
        HostLoad(5, 1); AddRR(5, 5, 4); ExtLsl(5, 5, 3);      // (off+i)*8
        HostLoad(6, 0); AddRR(5, 5, 6);
        ExtLdrbImm(5, 5, 0);
        HostLoad(6, 3); AddRR(6, 6, 4);
        ExtStrbReg(5, 6, 4);                   // strb w5, [dst, i]
        AddImm(4, 4, 1);
        EmitB(gsLoop);
        Mark(gsDone);
        HostLoad(0, 3); HostLoad(1, 2); AddRR(2, 0, 1); Strb0(2);
        HostStamp();
        HostLoad(0, 3);
        HostEnd();
    }

    // x0 = raw pointer, x1 = length -> owning 32-byte SHA-256 digest string
    // (a negative length hashes zero bytes, never wraps).
    void HostEmitNmSha() {
        HostBeginN("_zan_nm_sha256", 64);
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 1); ExtCmpImm(0, 0);
        int nmPos = NL(); EmitBcond(10, nmPos); LoadImm(0, 0);
        Mark(nmPos); HostSave(0, 1);
        HostLoad(0, 0); HostLoad(1, 1); AddImm(2, 31, 128);
        BLExtern("_CC_SHA256");
        LoadImm(0, 33); BLInternal("_zan_rt_str_alloc"); HostSave(0, 2);
        HostLoad(0, 2); AddImm(1, 31, 128); LoadImm(2, 32);
        BLExtern("_memcpy");
        HostLoad(0, 2); HostLoad(1, 1); AddRR(2, 0, 1); Strb0(2);
        HostStamp();
        HostLoad(0, 2);
        HostEndN(64);
    }

    // pthread entry: x0 = {tid@0, thunk@8, env@16} block built by
    // Thread.Start; invoke the delegate, then return 0 to pthreads.
    void HostEmitThreadHelpers() {
        syms.Add(new Sym("_zan_host_thread_trampoline", txt.Count));
        LdrU(9, 0, 8);                         // thunk
        LdrU(0, 0, 16);                        // env
        E4(0xD63F0120);                        // blr x9
        LoadImm(0, 0);
        E4(0xD65F03C0);                        // ret (pthread start routine)

        // per-thread id: pthread_threadid_np(pthread_self(), &id)
        HostBegin("_zan_host_thread_id");
        BLExtern("_pthread_self");
        AddImm(1, 31, 0);                      // &slot
        BLExtern("_pthread_threadid_np");
        LdrU(0, 31, 0);
        HostEnd();
    }
}
