    public static extern int cinet_pton(int af, nint src, nint dst);
    // 变参 snprintf 无 DllImport:ngen 的变参调用降级传参不可用
    // (寄存器在入口已验证正确,被调方仍读到压栈槽地址),net 行拼装
    // 因此改为手工 memcpy,见 udec_into/plat_net_interfaces。
    [DllImport("crt", EntryPoint = "socket")]
    public static extern int csocket(int domain, int type, int proto);
    [DllImport("crt", EntryPoint = "sendto")]
    public static extern long csendto(int fd, nint buf, long len, int flags, nint addr, int addrlen);
    [DllImport("crt", EntryPoint = "recvfrom")]
    public static extern long crecvfrom(int fd, nint buf, long len, int flags, nint addr, nint addrlen);
    [DllImport("crt", EntryPoint = "poll")]
    public static extern int cpoll(nint fds, int nfds, int timeout);
    [DllImport("crt", EntryPoint = "getpid")]
    public static extern int cgetpid();
    [DllImport("crt", EntryPoint = "__error")]
    public static extern nint cerror();
    // 第五批:sockets/resolver 全部 ≤6 参非变参(变参 fcntl 在 3 参
    // 形态下与普通调用同 ABI,fixture 有Alive 断言覆盖)
    [DllImport("crt", EntryPoint = "send")]
    public static extern long csend(int fd, nint buf, long len, int flags);
    [DllImport("crt", EntryPoint = "recv")]
    public static extern long crecv(int fd, nint buf, long len, int flags);
    [DllImport("crt", EntryPoint = "signal")]
    public static extern nint csignal(int sig, nint handler);
    [DllImport("crt", EntryPoint = "fcntl")]
    public static extern int cfcntl(int fd, int cmd, int arg);
    [DllImport("crt", EntryPoint = "connect")]
    public static extern int cconnect(int fd, nint sa, int len);
    [DllImport("crt", EntryPoint = "select")]
    public static extern int cselect(int nfds, nint rfds, nint wfds, nint efds, nint timeout);
    [DllImport("crt", EntryPoint = "getsockopt")]
    public static extern int cgetsockopt(int fd, int level, int optname, nint optval, nint optlen);
    [DllImport("crt", EntryPoint = "getpeername")]
    public static extern int cgetpeername(int fd, nint sa, nint lenp);
    [DllImport("crt", EntryPoint = "getaddrinfo")]
    public static extern int cgetaddrinfo(nint name, nint service, nint hints, nint res);
    [DllImport("crt", EntryPoint = "freeaddrinfo")]
    public static extern void cfreeaddrinfo(nint res);
    [DllImport("crt", EntryPoint = "memcmp")]
    public static extern int cmemcmp(nint a, nint b, long n);

    // errno 是每线程全局:__error() 返回 int*
    static int err_now() {
        nint ep = cerror();
        Span<byte> ev = new Span<byte>(ep, 4);
        return ev[0] | (ev[1] << 8) | (ev[2] << 16) | (ev[3] << 24);
    }

    // ICMP 校验和:大端 16 位字累加 + 折叠,返回反码(与 C 版一致)
    static int icmp_checksum(nint data, int len) {
        Span<byte> b = new Span<byte>(data, len);
        long sum = 0;
        int i = 0;
        while (i + 1 < len) {
            sum = sum + ((b[i] << 8) | b[i + 1]);
            i = i + 2;
        }
        if (i < len) { sum = sum + (b[i] << 8); }
        while (sum >>> 16 != 0) { sum = (sum & 0xFFFFL) + (sum >>> 16); }
        return (int)(~sum & 0xFFFFL);
    }

    // AF_LINK sockaddr → "AA:BB:..." 大写十六进制(对照 zan_mac_from_
    // sockaddr:sdl_nlen@5 sdl_alen@6 LLADDR=data+nlen,alen 限 1..8)
    static void mac_from_sa(nint sa, nint outp) {
        Span<byte> sv = new Span<byte>(sa, 32);
        int fam = sv[1];   // sa_family_t 是 u8;sv[2] 起是 sdl_index,不能并入
        if (fam != 18) { return; }                  // AF_LINK
        int nlen = sv[5];
        int alen = sv[6];
        if (alen <= 0 || alen > 8) { return; }
        Span<byte> ov = new Span<byte>(outp, 32);
        int used = 0;
        int i = 0;
        while (i < alen && used + 3 < 32) {
            int b = sv[8 + nlen + i];
            int hi = b >>> 4;
            int lo = b & 15;
            if (i != 0) { ov[used] = 58; used = used + 1; }
            ov[used] = (byte)(hi < 10 ? 48 + hi : 55 + hi);
            ov[used + 1] = (byte)(lo < 10 ? 48 + lo : 55 + lo);
            used = used + 2;
            i = i + 1;
        }
        ov[used] = 0;
    }

    // 静态暂存区布局(懒分配一次,与 C 的 static zan_net_text 等价):
    // net_text@0 (65536) | addrs@65536 (2048) | mac@67584 (32) | ntop@67616 (64)
    static nint net_buf;

    // 十进制写入 dst(至少 11 字节),返回字节数。只用"临时 malloc +
    // Span(新局部)"的已证模式。
    static long udec_into(long v, nint dst) {
        nint tmp = malloc(24);
        Span<byte> tv = new Span<byte>(tmp, 24);
        if (v < 0) { v = 0 - v; }
        int n = 0;
        if (v == 0) { tv[0] = 48; n = 1; }
        while (v > 0) {
            tv[n] = (byte)(48 + v % 10);
            n = n + 1;
            v = v / 10;
        }
        int i = 0;
        while (i < n) {
            memcpy(dst + i, tmp + (n - 1 - i), 1);
            i = i + 1;
        }
        cfree(tmp);
        return n;
    }

    // '\n' 分隔的适配器快照,每行 name \t index \t up(0|1) \t mac \t
    // addr[,addr...]:getifaddrs 每地址一节点,地址折叠进所属接口行;
    // 同名首节点才有输出。行拼装全程手工(memcpy + 字面字节):ngen 的
    // 变参调用(snprintf)与静态字段指针上的 Span 写均已证实不可用,
    // 见 README"已发现编译器缺口"。
    public static nint plat_net_interfaces() {
        if (net_buf == 0) { net_buf = calloc(1, 67680); }
        lit_init();
        memset(net_buf, 0, 1);
        nint listp = malloc(8);
        Span<long> lv = new Span<long>(listp, 1);
        if (cgetifaddrs(listp) != 0) { cfree(listp); return net_buf; }
        long used = 0;
        long done = 0;
        nint it = (nint)lv[0];
        while (it != 0 && done == 0) {
            Span<long> iv = new Span<long>(it, 7);
            nint name = (nint)iv[1];
            if (name != 0) {
                nint p = (nint)lv[0];
                long seen = 0;
                while (p != it && seen == 0) {
                    Span<long> pv = new Span<long>(p, 7);
                    nint pname = (nint)pv[1];
                    if (pname != 0 && cstrcmp(pname, name) == 0) { seen = 1; }
                    if (seen == 0) { p = (nint)pv[0]; }
                }
                if (seen == 0) {
                    long flags = iv[2] & 0xFFFFFFFFL;
                    int up = (flags & 1) != 0 && (flags & 64) != 0 ? 1 : 0;
                    memset(net_buf + 67584L, 0, 1);
                    memset(net_buf + 65536L, 0, 2048);
                    long addrUsed = 0;
                    nint q = (nint)lv[0];
                    while (q != 0) {
                        Span<long> qv = new Span<long>(q, 7);
                        nint qname = (nint)qv[1];
                        if (qname != 0 && cstrcmp(qname, name) == 0) {
                            nint sa = (nint)qv[3];
                            if (sa != 0) {
                                if (cstrlen(net_buf + 67584L) == 0) {
                                    mac_from_sa(sa, net_buf + 67584L);
                                }
                                Span<byte> sv = new Span<byte>(sa, 3);
                                int fam = sv[1];  // sa_family_t 是 u8
                                if (fam == 2 || fam == 30) {
                                    nint src = fam == 2 ? sa + 4L : sa + 8L;
                                    nint ntopp = net_buf + 67616L;
                                    cinet_ntop(fam, src, ntopp, 64);
                                    long tl = cstrlen(ntopp);
                                    if (tl != 0 && addrUsed + tl + 2 < 2048) {
                                        nint addrp = net_buf + 65536L;
                                        if (addrUsed != 0) {
                                            memcpy(addrp + addrUsed, lit_buf + 50L, 1);
                                            addrUsed = addrUsed + 1;
                                        }
                                        memcpy(addrp + addrUsed, ntopp, tl + 1);
                                        addrUsed = addrUsed + tl;
                                    }
                                }
                            }
                        }
                        q = (nint)qv[0];
                    }
                    long nl = cstrlen(name);
                    long dg = udec_into(cif_nametoindex(name), net_buf + 67616L);
                    long ml = cstrlen(net_buf + 67584L);
                    long al = cstrlen(net_buf + 65536L);
                    long need = nl + dg + ml + al + 5;
                    if (used + need >= 65536) { done = 1; }
                    else {
                        nint linep = net_buf + used;
                        long w = 0;
                        memcpy(linep, name, nl + 1);
                        w = nl;
                        memcpy(linep + w, lit_buf + 51L, 1);
                        w = w + 1;
                        memcpy(linep + w, net_buf + 67616L, dg);
                        w = w + dg;
                        memcpy(linep + w, lit_buf + 51L, 1);
                        w = w + 1;
                        memcpy(linep + w, lit_buf + 48L + up, 1);
                        w = w + 1;
                        memcpy(linep + w, lit_buf + 51L, 1);
                        w = w + 1;
                        if (ml > 0) { memcpy(linep + w, net_buf + 67584L, ml); }
                        w = w + ml;
                        memcpy(linep + w, lit_buf + 51L, 1);
                        w = w + 1;
                        memcpy(linep + w, net_buf + 65536L, al);
                        w = w + al;
                        memcpy(linep + w, lit_buf + 52L, 1);
                        used = used + w + 1;
                    }
                }
            }
            it = (nint)iv[0];
        }
        // freeifaddrs 要链表头(*listp),不是持有者本身——传错会把
        // listp 先释放一遍,随后 cfree(listp) 变 double free。
        cfreeifaddrs((nint)lv[0]);
        cfree(listp);
        return net_buf;
    }

    // 一条 ICMP echo 到 IPv4 字面量,至多 timeout_ms。返回 RTT 毫秒
    // (>=0),或 -1 超时 / -2 不可达 / -3 socket/权限错误 / -4 地址非法。
    // 先试 SOCK_DGRAM 的 ICMP ping 套接字,失败退 SOCK_RAW。errno 经
    // __error() 读取;pollfd={int fd; short events; short revents}。
    // ping 的缓冲经静态槽保存、每个用点现取新局部:跨 poll 循环存活的
    // 指针局部量在当前 ngen 下不可靠(见 README"已发现编译器缺口")。
    static nint ping_dst;
    static nint ping_packet;
    static nint ping_pfd;
    static nint ping_reply;
    static nint ping_from;
    static nint ping_fromlen;

    public static int plat_icmp_ping(nint address, int timeoutMs) {
        if (address == 0) { return -4; }
        Span<byte> a0 = new Span<byte>(address, 1);
        if (a0[0] == 0) { return -4; }
        if (ping_dst != 0) { cfree(ping_dst); }
        ping_dst = malloc(16);
        memset(ping_dst, 0, 16);
        nint dst = ping_dst;
        Span<byte> dv = new Span<byte>(dst, 16);
        dv[1] = 2;                                 // sin_family @1 = AF_INET
        if (cinet_pton(2, address, dst + 4L) != 1) {
            cfree(ping_dst);
            ping_dst = 0;
            return -4;
        }
        if (timeoutMs < 0) { timeoutMs = 0; }
        int fd = csocket(2, 2, 1);                 // SOCK_DGRAM, IPPROTO_ICMP
        int datagram = fd >= 0 ? 1 : 0;
        if (fd < 0) { fd = csocket(2, 3, 1); }     // SOCK_RAW
        if (fd < 0) { cfree(ping_dst); ping_dst = 0; return -3; }
        if (ping_packet != 0) { cfree(ping_packet); }
        ping_packet = malloc(16);
        memset(ping_packet, 0, 16);
        nint pk = ping_packet;
        Span<byte> pv = new Span<byte>(pk, 16);
        pv[0] = 8;                                 // ICMP_ECHO
        int ident = cgetpid() & 0xFFFF;
        pv[4] = (byte)(ident >>> 8);
        pv[5] = (byte)(ident & 255);
        pv[6] = 0;
        pv[7] = 1;                                 // sequence
        // "zan-ping" 载荷按字节写(避免数据槽未初始化的字符串字面量)
        Span<byte> pl = new Span<byte>(pk + 8L, 8);
        pl[0] = 122; pl[1] = 97; pl[2] = 110; pl[3] = 45;
        pl[4] = 112; pl[5] = 105; pl[6] = 110; pl[7] = 103;
        int sum = icmp_checksum(ping_packet, 16);
        nint pk2 = ping_packet;
        Span<byte> pv2 = new Span<byte>(pk2, 16);
        pv2[2] = (byte)(sum >>> 8);
        pv2[3] = (byte)(sum & 255);
        long start = monotonic_us();
        nint dst2 = ping_dst;
        if (csendto(fd, pk2, 16, 0, dst2, 16) < 0) {
            int err = err_now();
            cclose(fd);
            cfree(ping_packet); ping_packet = 0;
            cfree(ping_dst); ping_dst = 0;
            return err == 65 || err == 51 ? -2 : -3;   // EHOSTUNREACH/ENETUNREACH
        }
        if (ping_pfd != 0) { cfree(ping_pfd); }
        if (ping_reply != 0) { cfree(ping_reply); }
        if (ping_from != 0) { cfree(ping_from); }
        if (ping_fromlen != 0) { cfree(ping_fromlen); }
        ping_pfd = malloc(8);
        ping_reply = malloc(1024);
        ping_from = malloc(16);
        ping_fromlen = malloc(8);
        int result = -3;
        long state = 0;
        while (state == 0) {
            long elapsed = (monotonic_us() - start) / 1000;
            int remain = (int)((long)timeoutMs - elapsed);
            if (remain <= 0) {
                result = -1;
                state = 1;
            }
            else {
                nint pfd = ping_pfd;
                Span<long> plv = new Span<long>(pfd, 1);
                plv[0] = fd & 0xFFFFFFFFL;             // fd,events/revents 清零
                Span<byte> pev = new Span<byte>(pfd + 4L, 1);
                pev[0] = 1;                            // POLLIN
                int ready = cpoll(pfd, 1, remain);
                if (ready == 0) {
                    result = -1;
                    state = 1;
                }
                else if (ready < 0) {
                    if (err_now() != 4) { result = -3; state = 1; }   // EINTR 重试
                }
                else {
                    nint rp = ping_reply;
                    nint fm = ping_from;
                    nint fl = ping_fromlen;
                    Span<long> flv = new Span<long>(fl, 1);
                    flv[0] = 16;
                    long got = crecvfrom(fd, rp, 1024, 0, fm, fl);
                    if (got < 0) {
                        if (err_now() != 4) { result = -3; state = 1; }
                    }
                    else {
                        long offset = 0;
                        long skip = 0;
                        if (datagram == 0) {
                            if (got < 20) { skip = 1; }
                            else {
                                Span<byte> rv = new Span<byte>(rp, 1024);
                                offset = (rv[0] & 15) * 4L;
                                if (got < offset + 8) { skip = 1; }
                            }
                        }
                        else if (got < 8) { skip = 1; }
                        if (skip == 0) {
                            Span<byte> rv = new Span<byte>(rp, 1024);
                            int type = rv[(int)offset];
                            if (type == 0) {                       // ECHOREPLY
                                long rtt = (monotonic_us() - start) / 1000;
                                result = rtt > 2147483647L ? 2147483647 : (int)rtt;
                                state = 1;
                            }
                            else if (type == 3 || type == 11) {    // 不可达/TTL
                                result = -2;
                                state = 1;
                            }
                            // 其余类型不是应答:继续等
                        }
                    }
                }
            }
        }
        cclose(fd);
        cfree(ping_pfd); ping_pfd = 0;
        cfree(ping_reply); ping_reply = 0;
        cfree(ping_from); ping_from = 0;
        cfree(ping_fromlen); ping_fromlen = 0;
        cfree(ping_packet); ping_packet = 0;
        cfree(ping_dst); ping_dst = 0;
        return result;
    }

    // ------------------------------------------------------------------
    // 第五批:sockets/resolver(语义对照 zanstubs.c 与 oracle rt_io.c),
    // 取代 zanstubs.c 的 zan_io_* 纯函数族;reactor 段(wait_co/recv_co/
    // accept_co/poll/close_notify + DNS worker)留 C。常量(offsetof 已
    // 证):addrinfo 48B flags@0 fam@4 sock@8 addrlen@16 addr@32
    // next@40;fd_set/sockaddr_storage 128B;timeval{i64,i64};
    // AF_INET=2 AF_INET6=30;SOCK_STREAM=1;EAGAIN=35 EINTR=4
    // EINPROGRESS=36 EALREADY=37;O_NONBLOCK=4;F_GETFD=1 F_GETFL=3
    // F_SETFL=4;SOL_SOCKET=0xffff(65535) SO_ERROR=0x1007(4103);
    // SIGPIPE=13 SIG_DFL=0 SIG_IGN=1;SA_STRIDE=32;sin=16(sin_addr@4)
    // sin6=28(sin6_addr@8)。
    // ------------------------------------------------------------------

    // sockaddr_ip_str 的文本缓冲(C 为 __thread 128B;本车道单线程假设
    // 一致,契约同为"返回值活到下次调用")。
    static nint io_addr_buf;

    // SIGPIPE 惰性忽略:rt_io.c 语义是"当前 handler 非 DFL 则不动"。
    // signal() 版先装 IGN,再按返回值恢复旧 handler——单线程下逐次等价。
    static void io_ignore_sigpipe() {
        nint old = csignal(13, 1);
        if (old != 0) { csignal(13, old); }
    }

    // rt_io.c:552 拷出:长度不含 NUL;buf 空或 cap<=0 或放不下 → -1。
    static int io_ip_copy_out(nint text, nint buf, int cap) {
        if (buf == 0 || cap <= 0) { return -1; }
        long n = cstrlen(text);
        if (cap <= n) { return -1; }
        memcpy(buf, text, n + 1);
        return (int)n;
    }

    // rt_io.c:509:v4/v6 文本;其他族或转换失败 → 空串。
    public static nint io_sockaddr_ip_str(nint sa) {
        if (io_addr_buf == 0) { io_addr_buf = calloc(1, 128); }
        nint ab = io_addr_buf;
        if (sa != 0) {
            Span<byte> sv = new Span<byte>(sa, 2);
            int fam = sv[1];                       // sa_family u8
            if (fam == 2) {
                if (cinet_ntop(2, sa + 4L, ab, 128) != 0) { return ab; }
            }
            else if (fam == 30) {
                if (cinet_ntop(30, sa + 8L, ab, 128) != 0) { return ab; }
            }
        }
        memset(ab, 0, 1);
        return ab;
    }

    public static nint io_socket_peer_ip(long fd) {
        nint ss = malloc(128);
        memset(ss, 0, 128);
        nint lenp = malloc(4);
        Span<long> lv = new Span<long>(lenp, 1);
        lv[0] = 128;
        nint r = 0;
        if (cgetpeername((int)fd, ss, lenp) != 0) {
            r = io_sockaddr_ip_str(0);
        }
        else {
            r = io_sockaddr_ip_str(ss);
        }
        cfree(lenp);
        cfree(ss);
        return r;
    }

    public static int io_socket_peer_ip_into(long fd, nint buf, int cap) {
        nint ss = malloc(128);
        memset(ss, 0, 128);
        nint lenp = malloc(4);
        Span<long> lv = new Span<long>(lenp, 1);
        lv[0] = 128;
        int r = -1;
        if (cgetpeername((int)fd, ss, lenp) == 0) {
            nint txt = io_sockaddr_ip_str(ss);
            r = io_ip_copy_out(txt, buf, cap);
        }
        cfree(lenp);
        cfree(ss);
        return r;
    }

    public static int io_sockaddr_ip_str_into(nint sa, nint buf, int cap) {
        nint txt = io_sockaddr_ip_str(sa);
        return io_ip_copy_out(txt, buf, cap);
    }

    // rt_io.c:615:AF_INET 需 len>=16,AF_INET6 需 len>=28,否则 0。
    public static int io_sockaddr_family(nint sa, int len) {
        if (sa == 0 || len < 2) { return 0; }
        Span<byte> sv = new Span<byte>(sa, 2);
        int fam = sv[1];                           // sa_family u8
        if (fam == 2 && len >= 16) { return 2; }
        if (fam == 30 && len >= 28) { return 30; }
        return 0;
    }

    // 主机序 32 位 v4 的可用性规则(rt_io.c:638)。
    static int v4_safe_bytes(long a, int allowLoopback) {
        long first = a >>> 24;
        long second = (a >>> 16) & 255;
        if (first == 127) { return allowLoopback != 0 ? 1 : 0; }
        if (first == 0 || first == 10 || first >= 224) { return 0; }
        if (first == 169 && second == 254) { return 0; }
        if (first == 172 && second >= 16 && second <= 31) { return 0; }
        if (first == 192 && second == 168) { return 0; }
        if (first == 192 && second == 0) { return 0; }
        long third = (a >>> 8) & 255;
        if (first == 192 && second == 2) { return 0; }
        if (first == 192 && second == 88 && third == 99) { return 0; }
        if (first == 198 && second >= 18 && second <= 19) { return 0; }
        if (first == 198 && second == 51 && third == 100) { return 0; }
        if (first == 203 && second == 0 && third == 113) { return 0; }
        if (first == 100 && second >= 64 && second <= 127) { return 0; }
        if (a == 4294967295L) { return 0; }
        return 1;
    }

    // rt_io.c:638:1 仅当可用公网地址(或显式回环豁免);嵌入 v4 形态
    // (mapped/Teredo/6to4/NAT64)按 v4 规则判定——v4 判定折进
    // v4_safe_bytes,无递归。
    public static int io_sockaddr_is_safe(nint sa, int len, int allowLoopback) {
        int family = io_sockaddr_family(sa, len);
        if (family == 2) {
            Span<byte> sv = new Span<byte>(sa, 8);
            long a = (sv[4] << 24) | (sv[5] << 16) | (sv[6] << 8) | sv[7];
            return v4_safe_bytes(a, allowLoopback);
        }
        if (family == 30) {
            Span<byte> bv = new Span<byte>(sa, 24);
            long zeros = 0;
            long headZero = 0;
            int i = 0;
            while (i < 16) {
                if (bv[8 + i] != 0) { zeros = 1; }
                if (i < 15 && bv[8 + i] != 0) { headZero = 1; }
                i = i + 1;
            }
            if (zeros == 0) { return 0; }                       // 未指定 ::
            if (headZero == 0 && bv[23] == 1) {                 // ::1
                return allowLoopback != 0 ? 1 : 0;
            }
            if ((bv[8] & 254) == 252) { return 0; }             // fc00::/7
            if ((bv[8] & 254) == 254 && (bv[9] & 192) == 128) { return 0; }  // fe80::/10
            if (bv[8] == 255) { return 0; }                     // ff00::/8
            if (bv[8] == 32 && bv[9] == 1 && bv[10] == 13 && bv[11] == 184) { return 0; }  // 2001:db8
            long mapped = 1;
            i = 0;
            while (i < 10) {
                if (bv[8 + i] != 0) { mapped = 0; }
                i = i + 1;
            }
            if (mapped == 1 && bv[18] == 255 && bv[19] == 255) {
                long m4 = (bv[20] << 24) | (bv[21] << 16) | (bv[22] << 8) | bv[23];
                return v4_safe_bytes(m4, allowLoopback);
            }
            if (bv[8] == 32 && bv[9] == 1 && bv[10] == 0 && bv[11] == 0) {
                // Teredo 2001:0000::/32:服务器 v4(b12..15 前四 b4..7)与
                // 混淆 v4(b12..15 取反)都要过 v4 规则
                long t4 = (bv[12] << 24) | (bv[13] << 16) | (bv[14] << 8) | bv[15];
                if (v4_safe_bytes(t4, allowLoopback) == 0) { return 0; }
                long c4 = ((255 - bv[20]) << 24) | ((255 - bv[21]) << 16) | ((255 - bv[22]) << 8) | (255 - bv[23]);
                return v4_safe_bytes(c4, allowLoopback);
            }
            long v4off = -1L;
            if (bv[8] == 32 && bv[9] == 2) { v4off = 2L; }      // 6to4
            else if (bv[8] == 0 && bv[9] == 100 && bv[10] == 255 && bv[11] == 155) { v4off = 12L; }  // NAT64
            else if (mapped == 1) { v4off = 12L; }
            if (v4off >= 0) {
                int o = (int)(8 + v4off);
                long e4 = (bv[o] << 24) | (bv[o + 1] << 16) | (bv[o + 2] << 8) | bv[o + 3];
                return v4_safe_bytes(e4, allowLoopback);
            }
            return 1;
        }
        return 0;
    }

    // rt_io.c:573:含 ':' 的名字按 v6-or-nothing,其余先 v4、失败回退
    // AF_UNSPEC。返回长度 16/28 或 0。
    public static int io_resolve_sa(nint name, int port, nint buf, int cap) {
        if (name == 0) { return 0; }
        Span<byte> n0 = new Span<byte>(name, 1);
        if (n0[0] == 0) { return 0; }
        lit_init();
        nint portstr = malloc(16);
        long d = udec_into(port, portstr);
        Span<byte> pz = new Span<byte>(portstr + d, 1);
        pz[0] = 0;
        nint hints = malloc(48);
        memset(hints, 0, 48);
        Span<long> hv = new Span<long>(hints, 6);
        long fam0 = cstrrchr(name, 58) != 0 ? 0L : 2L;
        hv[0] = fam0 << 32;                        // ai_flags=0, ai_family
        hv[1] = 1;                                 // ai_socktype=SOCK_STREAM
        nint resp = malloc(8);
        Span<long> rv = new Span<long>(resp, 1);
        rv[0] = 0;
        int rc = cgetaddrinfo(name, portstr, hints, resp);
        if (rc != 0 || rv[0] == 0) {
            if (fam0 == 2L) {
                hv[0] = 0;                         // 回退 AF_UNSPEC
                rv[0] = 0;
                rc = cgetaddrinfo(name, portstr, hints, resp);
            }
            if (rc != 0 || rv[0] == 0) {
                cfree(resp); cfree(hints); cfree(portstr);
                return 0;
            }
        }
        nint p = rv[0];
        Span<long> pv = new Span<long>(p, 6);
        int fam = (int)(pv[0] >>> 32);
        long len = fam == 30 ? 28L : fam == 2 ? 16L : 0L;
        long addrlen = pv[2] & 0xFFFFFFFFL;
        int r = 0;
        if (len != 0 && len <= cap && addrlen == len) {
            nint addr = (nint)pv[4];
            memcpy(buf, addr, len);
            r = (int)len;
        }
        cfreeaddrinfo(p);
        cfree(resp); cfree(hints); cfree(portstr);
        return r;
    }

    // rt_io.c:607:v4 地址按 s_addr 内存序(LE 读 u32),失败 0。
    public static int io_resolve_ipv4(nint hostname) {
        if (hostname == 0) { return 0; }
        Span<byte> h0 = new Span<byte>(hostname, 1);
        if (h0[0] == 0) { return 0; }
        nint hints = malloc(48);
        memset(hints, 0, 48);
        Span<long> hv = new Span<long>(hints, 6);
        hv[0] = 2L << 32;                          // AF_INET
        hv[1] = 1;                                 // SOCK_STREAM
        nint resp = malloc(8);
        Span<long> rv = new Span<long>(resp, 1);
        rv[0] = 0;
        if (cgetaddrinfo(hostname, 0, hints, resp) != 0 || rv[0] == 0) {
            cfree(resp); cfree(hints);
            return 0;
        }
        nint p = rv[0];
        Span<long> pv = new Span<long>(p, 6);
        int addr = 0;
        if ((int)(pv[0] >>> 32) == 2) {
            nint sa = (nint)pv[4];
            Span<byte> sv = new Span<byte>(sa, 8);
            if (sv[1] == 2) {
                addr = (int)((sv[4] & 255L) | ((sv[5] & 255L) << 8) | ((sv[6] & 255L) << 16) | ((sv[7] & 255L) << 24));
            }
        }
        cfreeaddrinfo(p);
        cfree(resp); cfree(hints);
        return addr;
    }

    // rt_io.c:727:stride-32 去重写入;溢出清空整个缓冲并返回 0。
    public static int io_resolve_all(nint name, int port, nint buf, int cap) {
        if (buf == 0 || cap <= 0) { return 0; }
        long bad = 0;
        if (name == 0 || cap < 32) { bad = 1; }
        else {
            Span<byte> n0 = new Span<byte>(name, 1);
            if (n0[0] == 0) { bad = 1; }
        }
        if (bad == 1) { memset(buf, 0, cap); return 0; }
        lit_init();
        nint portstr = malloc(16);
        long d = udec_into(port, portstr);
        Span<byte> pz = new Span<byte>(portstr + d, 1);
        pz[0] = 0;
        nint hints = malloc(48);
        memset(hints, 0, 48);
        Span<long> hv = new Span<long>(hints, 6);
        hv[1] = 1;                                 // family=AF_UNSPEC 已零
        nint resp = malloc(8);
        Span<long> rv = new Span<long>(resp, 1);
        rv[0] = 0;
        if (cgetaddrinfo(name, portstr, hints, resp) != 0 || rv[0] == 0) {
            memset(buf, 0, cap);
            cfree(resp); cfree(hints); cfree(portstr);
            return 0;
        }
        nint head = rv[0];
        long capacity = cap / 32;
        long count = 0;
        nint p = head;
        while (p != 0) {
            Span<long> pv = new Span<long>(p, 6);
            nint addr = (nint)pv[4];
            long addrlen = pv[2] & 0xFFFFFFFFL;
            int fam = io_sockaddr_family(addr, (int)addrlen);
            long len = fam == 30 ? 28L : fam == 2 ? 16L : 0L;
            if (len != 0 && addrlen >= len) {
                long dup = 0;
                long i = 0;
                while (i < count && dup == 0) {
                    nint oldp = buf + i * 32;
                    if (io_sockaddr_family(oldp, (int)len) == fam && cmemcmp(oldp, addr, len) == 0) { dup = 1; }
                    i = i + 1;
                }
                if (dup == 0) {
                    if (count >= capacity) {
                        memset(buf, 0, cap);
                        cfreeaddrinfo(head);
                        cfree(resp); cfree(hints); cfree(portstr);
                        return 0;
                    }
                    nint dstp = buf + count * 32;
                    memset(dstp, 0, 32);
                    memcpy(dstp, addr, len);
                    count = count + 1;
                }
            }
            p = (nint)pv[5];
        }
        cfreeaddrinfo(head);
        cfree(resp); cfree(hints); cfree(portstr);
        return (int)count;
    }

    public static long io_resolve_all_async(long namePtr, int port, long bufPtr, int cap) {
        return io_resolve_all((nint)namePtr, port, (nint)bufPtr, cap);
    }

    static int io_set_nonblocking(long fd) {
        int flags = cfcntl((int)fd, 3, 0);         // F_GETFL
        if (flags < 0) { return -1; }
        return cfcntl((int)fd, 4, flags | 4);      // F_SETFL|O_NONBLOCK
    }

    // rt_io.c:881:非阻塞 connect;0 已建立,-2 进行中,其余正 errno 或 -1。
    static int io_connect_sa_start(long fd, nint sa, int salen) {
        if (sa == 0 || io_sockaddr_family(sa, salen) == 0) { return -1; }
        if (io_set_nonblocking(fd) != 0) { return -1; }
        int r = cconnect((int)fd, sa, salen);
        if (r == 0) { return 0; }
        int e = err_now();
        if (e == 36 || e == 35 || e == 37) { return -2; }
        return e > 0 ? e : -1;
    }

    // rt_io.c:903:本车道内联执行;0 已建立,正 SO_ERROR,-3 超时,-1 失败。
    public static long io_connect_sa(long fd, nint sa, int salen, int timeoutMs) {
        io_ignore_sigpipe();
        int r = io_connect_sa_start(fd, sa, salen);
        if (r == 0 || r != -2) { return r; }
        if (fd < 0 || fd >= 1024) { return -1L; }
        nint wfds = malloc(128);
        nint efds = malloc(128);
        memset(wfds, 0, 128);
        memset(efds, 0, 128);
        long bit = 1L << (fd % 64);
        int slot = (int)(fd / 64);
        Span<long> wv = new Span<long>(wfds, 16);
        wv[slot] = wv[slot] | bit;
        Span<long> evv = new Span<long>(efds, 16);
        evv[slot] = evv[slot] | bit;
        nint ptv = 0;
        nint tv = 0;
        if (timeoutMs >= 0) {
            tv = malloc(16);
            Span<long> tvv = new Span<long>(tv, 2);
            tvv[0] = timeoutMs / 1000;
            tvv[1] = (timeoutMs % 1000) * 1000;
            ptv = tv;
        }
        int sr = 0;
        long state = 0;
        while (state == 0) {
            sr = cselect((int)fd + 1, 0, wfds, efds, ptv);
            if (!(sr < 0 && err_now() == 4)) { state = 1; }   // EINTR 重试
        }
        long result = -1L;
        if (sr <= 0) {
            result = sr == 0 ? -3L : -1L;
        }
        else {
            nint errp = malloc(8);
            nint elenp = malloc(8);
            Span<long> elv = new Span<long>(elenp, 1);
            elv[0] = 4;
            if (cgetsockopt((int)fd, 65535, 4103, errp, elenp) != 0) {
                result = -1L;
            }
            else {
                Span<long> erv = new Span<long>(errp, 1);
                long ev = erv[0] & 0xFFFFFFFFL;
                result = ev == 0 ? 0L : ev;
            }
            cfree(errp);
            cfree(elenp);
        }
        cfree(tv);
        cfree(wfds);
        cfree(efds);
        return result;
    }

    // rt_io.c:853:0 已建立,正 SO_ERROR(或 -1),-2 进行中。
    public static int io_connect_status(long fd) {
        if (fd < 0 || fd >= 1024) { return -1; }
        nint wfds = malloc(128);
        nint efds = malloc(128);
        memset(wfds, 0, 128);
        memset(efds, 0, 128);
        long bit = 1L << (fd % 64);
        int slot = (int)(fd / 64);
        Span<long> wv = new Span<long>(wfds, 16);
        wv[slot] = wv[slot] | bit;
        Span<long> evv = new Span<long>(efds, 16);
        evv[slot] = evv[slot] | bit;
        nint tv = malloc(16);
        Span<long> tvv = new Span<long>(tv, 2);
        tvv[0] = 0;
        tvv[1] = 0;
        int r = -1;
        if (cselect((int)fd + 1, 0, wfds, efds, tv) >= 0) {
            Span<long> wv2 = new Span<long>(wfds, 16);
            Span<long> evv2 = new Span<long>(efds, 16);
            long eset = evv2[slot] & bit;
            long wset = wv2[slot] & bit;
            nint errp = malloc(8);
            nint elenp = malloc(8);
            Span<long> elv = new Span<long>(elenp, 1);
            elv[0] = 4;
            if (cgetsockopt((int)fd, 65535, 4103, errp, elenp) != 0) {
                r = -1;
            }
            else {
                Span<long> erv = new Span<long>(errp, 1);
                long ev = erv[0] & 0xFFFFFFFFL;
                if (eset != 0) { r = ev != 0 ? (int)ev : -1; }
                else if (wset != 0) { r = (int)ev; }
                else { r = -2; }
            }
            cfree(errp);
            cfree(elenp);
        }
        cfree(tv);
        cfree(wfds);
        cfree(efds);
        return r;
    }

    // rt_io.c:833:select 即时就绪探测。
    public static int io_socket_ready(long fd, int writeReady) {
        if (fd < 0 || fd >= 1024) { return -1; }
        nint fds = malloc(128);
        memset(fds, 0, 128);
        long bit = 1L << (fd % 64);
        int slot = (int)(fd / 64);
        Span<long> fv = new Span<long>(fds, 16);
        fv[slot] = fv[slot] | bit;
        nint tv = malloc(16);
        Span<long> tvv = new Span<long>(tv, 2);
        tvv[0] = 0;
        tvv[1] = 0;
        int r = cselect((int)fd + 1, writeReady != 0 ? 0 : fds, writeReady != 0 ? fds : 0, 0, tv);
        cfree(tv);
        cfree(fds);
        return r;
    }

    // rt_io.c:869:F_GETFD 探活。
    public static int io_socket_alive(long fd) {
        if (fd < 0) { return 0; }
        return cfcntl((int)fd, 1, 0) != -1 ? 1 : 0;
    }

    // rt_io.c:444:>=0 已收字节;-1 会阻塞;-2 致命;SIGPIPE 惰性忽略。
    public static long io_socket_send(long fd, nint buf, long len, int flags) {
        io_ignore_sigpipe();
        if (len <= 0) { return len == 0 ? 0L : -2L; }
        if (len > 2147483647L) { len = 2147483647L; }
        long result = -2L;
        long state = 0;
        while (state == 0) {
            long r = csend((int)fd, buf, len, flags);
            if (r >= 0) { result = r; state = 1; }
            else {
                int e = err_now();
                if (e == 35) { result = -1L; state = 1; }        // EAGAIN
                else if (e != 4) { result = -2L; state = 1; }    // EINTR 重试
            }
        }
        return result;
    }

    // rt_io.c:459:负返回值透传(0=对端关闭,-1=错误)。
    public static long io_socket_recv(long fd, nint buf, long len, int flags) {
        if (len < 0) { return -2L; }
        if (len > 2147483647L) { len = 2147483647L; }
        return crecv((int)fd, buf, len, flags);
    }

    public static void io_socket_cleanup() {
    }

    // ---- 第六批:zan_atomic_int_*(spec: oracle rt_sync.c,C11 __atomic)----
    // RMW 走 libSystem 的 OSAtomicAdd64Barrier / OSAtomicCompareAndSwap64
    // Barrier(仍在导出表;add 直接等于 add_fetch)。exchange 用 CAS 循环,
    // compare_exchange 失败路径取 load-after-fail 作"看到的旧值"——本车道
    // 单线程,循环一过、两次读等值,与 oracle 的 seen 语义一致;多线程
    // 竞争下这是文档化偏差(oracle 用真 __atomic)。load/store 是对齐 8 字
    // 节访问(arm64 单拷贝原子);线程族仍在 C,跨线程排序语义未承载。
    [DllImport("crt", EntryPoint = "OSAtomicAdd64Barrier")]
    public static extern long osatomic_add(long delta, nint p);
    [DllImport("crt", EntryPoint = "OSAtomicCompareAndSwap64Barrier")]
    public static extern nint osatomic_cas(long oldv, long newv, nint p);

    // 返回句柄(指针);0 = 分配失败。创建与 C 版同为普通写(线程内约定)。
    public static long atomic_int_create(long initial_value) {
        nint p = calloc(1, 8);
        if (p == 0) { return 0; }
        Span<long> v = new Span<long>(p, 1);
        v[0] = initial_value;
        return (long)p;
    }

    public static void atomic_int_destroy(long handle) {
        cfree((nint)handle);
    }

    public static long atomic_int_load(long handle) {
        nint p = (nint)handle;
        if (p == 0) { return 0; }
        Span<long> v = new Span<long>(p, 1);
        return v[0];
    }

    public static void atomic_int_store(long handle, long new_value) {
        nint p = (nint)handle;
        if (p == 0) { return; }
        Span<long> v = new Span<long>(p, 1);
        v[0] = new_value;
    }

    // 返回新值(add_fetch 语义);空句柄 0。
    public static long atomic_int_add(long handle, long delta) {
        nint p = (nint)handle;
        if (p == 0) { return 0; }
        return osatomic_add(delta, p);
    }

    // 返回旧值(exchange 语义);CAS 循环,单线程一过。
    public static long atomic_int_exchange(long handle, long new_value) {
        nint p = (nint)handle;
        if (p == 0) { return 0; }
        long seen = atomic_int_load(handle);
        long state = 0;
        while (state == 0) {
            nint ok = osatomic_cas(seen, new_value, p);
            if ((ok & 255L) != 0) { state = 1; }
            else { seen = atomic_int_load(handle); }
        }
        return seen;
    }

    // oracle 语义:无论成败都返回比较时看到的旧值;空句柄 0。
    public static long atomic_int_compare_exchange(
            long handle, long expected, long desired) {
        nint p = (nint)handle;
        if (p == 0) { return 0; }
        nint ok = osatomic_cas(expected, desired, p);
        if ((ok & 255L) != 0) { return expected; }
        return atomic_int_load(handle);
    }

