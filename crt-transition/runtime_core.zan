    // 每次产出全新的、调用方拥有的 ""(对应 C 版 strdup 契约——不能
    // 返回共享块,托管侧会释放它)
    static nint empty_str() {
        nint e = malloc(1);
        Span<byte> ev = new Span<byte>(e, 1);
        ev[0] = 0;
        return e;
    }

    // FILE *zan_pkg_fopen(...):此车道不烘焙包内资源,等价 fopen
    public static nint pkg_fopen(nint path, nint mode) {
        return cfopen(path, mode);
    }

    public static nint file_fopen(nint path, nint mode) {
        return cfopen(path, mode);
    }

    public static int file_remove(nint path) {
        return cremove(path);
    }

    public static int file_rename(nint oldp, nint newp) {
        return crename(oldp, newp);
    }

    // 只读缓存的可执行文件目录(对照 zanh_app_dir:ZAN_APP_DIR 优先,
    // 否则 _NSGetExecutablePath 去尾)。内部专用,不交给调用方释放。
    static nint app_dir_buf;
    static long app_dir_done;

    // 环境变量名/拼装常量字节不能写字面量:ngen 的字符串字面量经数据
    // 槽间接寻址,槽由本对象的静态初始化填充,而 runtime_core.o 作为
    // 第二个 ngen 对象其 init 不会被调用,槽恒为 0。这里在静态暂存区
    // 逐字节备好:"ZAN_APP_DIR"(0..11)"ZAN_PKG_DIR"(12..23)、
    // '0'(48) '1'(49) ','(50) '\t'(51) '\n'(52)。
    static nint lit_buf;

    static void lit_init() {
        if (lit_buf != 0) { return; }
        lit_buf = calloc(1, 128);
        Span<byte> lb = new Span<byte>(lit_buf, 128);
        lb[0] = 90; lb[1] = 65; lb[2] = 78; lb[3] = 95;
        lb[4] = 65; lb[5] = 80; lb[6] = 80; lb[7] = 95;
        lb[8] = 68; lb[9] = 73; lb[10] = 82;
        lb[12] = 90; lb[13] = 65; lb[14] = 78; lb[15] = 95;
        lb[16] = 80; lb[17] = 75; lb[18] = 71; lb[19] = 95;
        lb[20] = 68; lb[21] = 73; lb[22] = 82;
        lb[48] = 48; lb[49] = 49; lb[50] = 44; lb[51] = 9; lb[52] = 10;
        lb[32] = 115; lb[33] = 116; lb[34] = 117; lb[35] = 98; lb[36] = 0;
        // 第八批:rate/lock 的常量列名。
        lb[38] = 99; lb[39] = 111; lb[40] = 117; lb[41] = 110;
        lb[42] = 116; lb[43] = 0;
        lb[64] = 119; lb[65] = 105; lb[66] = 110; lb[67] = 100;
        lb[68] = 111; lb[69] = 119; lb[70] = 95; lb[71] = 115;
        lb[72] = 116; lb[73] = 97; lb[74] = 114; lb[75] = 116;
        lb[76] = 0;
        lb[80] = 111; lb[81] = 119; lb[82] = 110; lb[83] = 101;
        lb[84] = 114; lb[85] = 0;
    }

    static nint app_dir() {
        lit_init();
        nint env = cgetenv(lit_buf);
        if (env != 0 && cstrlen(env) != 0 && cstrlen(env) < 4096) { return env; }
        if (app_dir_done == 0) {
            app_dir_done = 1;
            app_dir_buf = calloc(1, 4096);          // C 静态缓冲零初始化
            nint exe = malloc(4096);
            nint cap = malloc(8);
            Span<long> cv = new Span<long>(cap, 1);
            cv[0] = 4096;
            if (cnsgetpath(exe, cap) == 0) {
                nint sep = cstrrchr(exe, 47);
                if (sep != 0 && sep != exe) {
                    Span<byte> zv = new Span<byte>(sep, 1);
                    zv[0] = 0;
                    long el = cstrlen(exe);
                    if (el < 4096) { memcpy(app_dir_buf, exe, el + 1); }
                }
            }
            cfree(cap);
            cfree(exe);
        }
        return app_dir_buf;
    }

    // char *zan_file_read_path(const char *):语义对照 rt_file.c——不是
    // realpath。工作目录里存在 → "";缺失的相对路径退到 $ZAN_PKG_DIR 或
    // 可执行文件旁;绝对路径与未命中返回 ""。绝不返回参数本身(托管侧
    // 会释放一个未保留的托管串)。
    public static nint file_read_path(nint path) {
        if (path == 0) { return empty_str(); }
        long plen = cstrlen(path);
        nint sb = malloc(144);
        if (plen != 0 && cstat(path, sb) == 0) { cfree(sb); return empty_str(); }
        Span<byte> p0 = new Span<byte>(path, 1);
        int b0 = p0[0];
        Span<byte> p1 = new Span<byte>(path + 1L, 1);
        int b1 = p1[0];
        if (b0 != 47 && b0 != 92 && b1 != 58) {
            int which = 0;
            while (which < 2) {
                lit_init();
                nint basep = which == 0 ? cgetenv(lit_buf + 12L) : app_dir();
                if (basep != 0) {
                    long lb = cstrlen(basep);
                    if (lb != 0 && lb + plen + 2 <= 4096) {
                        nint alt = malloc(lb + plen + 2);
                        memcpy(alt, basep, lb);
                        Span<byte> sl = new Span<byte>(alt + lb, 1);
                        sl[0] = 47;
                        memcpy(alt + lb + 1L, path, plen + 1);
                        if (cstat(alt, sb) == 0) { cfree(sb); return alt; }
                        cfree(alt);
                    }
                }
                which = which + 1;
            }
        }
        cfree(sb);
        return empty_str();
    }

    // ---- FileStream.zan:FILE* 句柄,0 = 关闭/失败 ----
    public static long file_open(nint path, nint mode) {
        nint f = cfopen(path, mode);
        return (long)f;
    }

    public static long file_read(long h, nint buf, long count) {
        if (h == 0) { return -1; }
        return cfread(buf, 1, count, (nint)h);
    }

    public static long file_write(long h, nint buf, long count) {
        if (h == 0) { return -1; }
        return cfwrite(buf, 1, count, (nint)h);
    }

    // 返回结果偏移(不是 fseek 成功旗标)——FileStream.Length 以
    // seek(0, SEEK_END) 读长度
    public static long file_seek(long h, long off, int origin) {
        if (h == 0) { return -1; }
        if (cfseek((nint)h, off, origin) != 0) { return -1; }
        return cftell((nint)h);
    }

    public static long file_tell(long h) {
        if (h == 0) { return -1; }
        return cftell((nint)h);
    }

    public static long file_flush(long h) {
        if (h == 0) { return -1; }
        return (long)cfflush((nint)h);
    }

    public static long file_close(long h) {
        if (h == 0) { return 0; }
        return (long)cfclose((nint)h);
    }

    public static long file_eof(long h) {
        if (h == 0) { return 1; }
        return cfeof((nint)h) != 0 ? 1L : 0L;
    }

    // ---- FileInfo.zan / FileInfoEx.zan ----
    // struct stat(macOS arm64,144 字节,偏移经 offsetof 验证):
    // mode@4(u16) atime@32 mtime@48 ctime@64 size@96
    public static long file_length(nint path) {
        nint sb = malloc(144);
        long r = -1;
        if (cstat(path, sb) == 0) {
            Span<long> lv = new Span<long>(sb, 18);
            r = lv[12];
        }
        cfree(sb);
        return r;
    }

    // 位:0 只读(W_OK 失败) 1 隐藏(基名 '.') 2 目录;-1 = stat 失败
    public static long file_attributes(nint path) {
        nint sb = malloc(144);
        if (cstat(path, sb) != 0) { cfree(sb); return -1; }
        long a = 0;
        if (caccess(path, 2) != 0) { a |= 1; }
        nint slash = cstrrchr(path, 47);
        nint basep = slash == 0 ? path : slash + 1L;
        Span<byte> bv = new Span<byte>(basep, 1);
        if (bv[0] == 46) { a |= 2; }
        Span<byte> mb = new Span<byte>(sb, 144);
        long modev = mb[4] | (mb[5] << 8);
        if ((modev & 61440) == 16384) { a |= 4; }
        cfree(sb);
        return a;
    }

    // which: 0=mtime 1=ctime(oracle 语义) 2=atime;缺失/空路径 → 0
    public static long file_time(nint path, int which) {
        if (path == 0 || cstrlen(path) == 0) { return 0; }
        nint sb = malloc(144);
        if (cstat(path, sb) != 0) { cfree(sb); return 0; }
        Span<long> lv = new Span<long>(sb, 18);
        long t = which == 1 ? lv[8] : (which == 2 ? lv[4] : lv[6]);
        cfree(sb);
        return t;
    }

    public static long file_set_readonly(nint path, int on) {
        nint sb = malloc(144);
        if (cstat(path, sb) != 0) { cfree(sb); return 0; }
        Span<byte> mb = new Span<byte>(sb, 144);
        long modev = mb[4] | (mb[5] << 8);
        long nm = on != 0 ? (modev & ~146L) : (modev | 146L);   // 0222
        long r = cchmod(path, (int)nm) == 0 ? 1L : 0L;
        cfree(sb);
        return r;
    }

    // which 0=mtime 2=atime 可设;1=birthtime 诚实拒绝(与 oracle 一致)
    public static long file_set_time(nint path, int which, long unixSec) {
        nint sb = malloc(144);
        if (cstat(path, sb) != 0) { cfree(sb); return 0; }
        if (which == 1) { cfree(sb); return 0; }
        nint ts = malloc(32);
        Span<long> lv = new Span<long>(sb, 18);
        Span<long> tv = new Span<long>(ts, 4);
        tv[0] = lv[4]; tv[1] = lv[5];
        tv[2] = lv[6]; tv[3] = lv[7];
        if (which == 0) { tv[2] = unixSec; tv[3] = 0; }
        else { tv[0] = unixSec; tv[1] = 0; }
        long r = cutimensat(-100, path, ts, 0) == 0 ? 1L : 0L;  // AT_FDCWD
        cfree(ts);
        cfree(sb);
        return r;
    }

    // ---- File.zan TryLock/Unlock:句柄编码 (gen << 32) | slot 的 32 槽
    // 表,代际使同一句柄值的第二次 unlock 失败;锁本体是 BSD flock;
    // 单线程假设与 C 版一致。
    static nint lk_fd_tbl;
    static nint lk_used_tbl;
    static nint lk_gen_tbl;

    static void lk_init() {
        if (lk_used_tbl != 0) { return; }
        lk_fd_tbl = calloc(32, 8);
        lk_used_tbl = calloc(32, 8);
        lk_gen_tbl = calloc(32, 8);
    }

    // O_RDWR|O_CREAT|O_CLOEXEC(macOS)= 0x01000202;0644 = 420;
    // LOCK_EX|LOCK_NB = 6
    public static long file_try_lock(nint path) {
        if (path == 0 || cstrlen(path) == 0) { return 0; }
        lk_init();
        Span<long> fv = new Span<long>(lk_fd_tbl, 32);
        Span<long> uv = new Span<long>(lk_used_tbl, 32);
        Span<long> gv = new Span<long>(lk_gen_tbl, 32);
        long slot = -1;
        int i = 0;
        while (slot < 0 && i < 32) {
            if (uv[i] == 0) { slot = i; uv[i] = 1; }
            i = i + 1;
        }
        if (slot < 0) { return 0; }
        // open 在 C 里是变参函数:ngen 的变参调用降级缺口(头注 1)让
        // 第三参 mode 落到寄存器残留值,文件以 040/100/200/740 等垃圾
        // 模式创建,确定性随链接布局漂移。此前试过 stat+fchmod 启发式
        // 守卫(缺属主写位才修),在 mode 恰落 0200 的布局下漏防——
        // 0o200 有属主写无属主读,O_RDWR 二次打开即 EACCES(file_lock
        // 的 relocked=0)。zanstubs.c 的二参包装 zan_open_creat 从根上
        // 绕开变参降级,mode 由 C 车道按正确约定传 0644,与 C 版创建
        // 语义逐位一致。
        int fd = copen2(path, 16777730);
        if (fd < 0) { uv[(int)slot] = 0; return 0; }
        if (cflock(fd, 6) != 0) { cclose(fd); uv[(int)slot] = 0; return 0; }
        long next = gv[(int)slot] + 1;
        if (next == 4294967296L) {              // u32 代际回卷:退役该槽
            cclose(fd);
            uv[(int)slot] = 2;
            return 0;
        }
        gv[(int)slot] = next;
        fv[(int)slot] = fd;
        return next * 4294967296L + slot;
    }

    public static long file_unlock(long h) {
        if (h <= 0) { return 0; }
        lk_init();
        long gen = h >>> 32;
        long slot = h & 0xFFFFFFFFL;
        if (slot >= 32) { return 0; }
        int s = (int)slot;
        Span<long> fv = new Span<long>(lk_fd_tbl, 32);
        Span<long> uv = new Span<long>(lk_used_tbl, 32);
        Span<long> gv = new Span<long>(lk_gen_tbl, 32);
        if (uv[s] == 0 || gv[s] != gen) { return 0; }
        int fd = (int)fv[s];
        fv[s] = -1;
        uv[s] = 0;
        long ng = gv[s] + 1;
        if (ng == 4294967296L) { ng = 1; }      // 同一句柄值二次 unlock 失败
        gv[s] = ng;
        cclose(fd);
        return 1;
    }

