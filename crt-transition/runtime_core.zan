// crt-transition/runtime_core.zan — Zan 实现的过渡期运行时(第一批)。
//
// 取代 zanstubs.c 中的(用 -DZAN_RT_CORE_ZAN 从 C 侧编出):
//   zan_monotonic_ns / zan_monotonic_us / zan_sha256 / zan_sha512
// 由原生自举编译器(ngen)编译为 arm64 可重定位对象,再经
// localize_syms.py 把 API 面之外的符号本地化——ngen 会把整套运行时
// 帮助函数以全局符号发射进每个对象,不本地化则与程序对象撞符号。
//
// 语义与 zanstubs.c 逐符号一致(CLOCK_MONOTONIC、FIPS 180-4、
// len<0 钳 0、大端摘要输出)。SHA 输入经 memcpy 整块搬入暂存缓冲再
// 调度,与 C 版的逐块指针遍历等价。
//
// 已知代价:每次调用为 Span 视图泄漏 2×16 字节(视图按迁就设计
// 短命、不回收,与 ngen 的 Span 实现一致)。Crc32 仍在 C 侧:其
// 导出名 `_Crc32` 无法由 `_类名_方法名` 的 mangle 规则表达,需要
// ngen 侧给它换名(如 _zan_crc32)后才能收编。
//
// 约束:不 using stdlib(Span 是 binder 内建,libc 直调);数值一律
// long + >>>(恒逻辑右移)+ 掩码,不依赖 uint/ulong 的移位语义;
// 消息长度限 int 正范围(<2^31),与 ngen 调用方的钳制一致。

class zan {
    [DllImport("crt", EntryPoint = "malloc")]
    public static extern nint malloc(long size);
    [DllImport("crt", EntryPoint = "free")]
    public static extern void free(nint p);
    [DllImport("crt", EntryPoint = "memset")]
    public static extern nint memset(nint p, int v, long n);
    [DllImport("crt", EntryPoint = "memcpy")]
    public static extern nint memcpy(nint dst, nint src, long n);
    [DllImport("crt", EntryPoint = "clock_gettime")]
    public static extern int clock_gettime(int clk, nint ts);

    // long long zan_monotonic_ns(void):macOS CLOCK_MONOTONIC=6
    // (_time.h:159);struct timespec = {long tv_sec; long tv_nsec}。
    public static long monotonic_ns() {
        nint ts = malloc(16);
        clock_gettime(6, ts);
        Span<long> v = new Span<long>(ts, 2);
        long ns = v[0] * 1000000000L + v[1];
        free(ts);
        return ns;
    }

    // int64_t zan_monotonic_us(void)
    public static long monotonic_us() {
        return monotonic_ns() / 1000;
    }

    static long rot32(long x, int n) {
        return ((x >>> n) | (x << (32 - n))) & 0xFFFFFFFFL;
    }

    static long rot64(long x, int n) {
        return (x >>> n) | (x << (64 - n));
    }

    // SHA-256 压缩函数:w 为已展开的 64 字消息调度
    static void rounds256(long[] h, long[] K, long[] w) {
        int i = 16;
        while (i < 64) {
            long wm15 = w[i - 15];
            long s0 = (rot32(wm15, 7)) ^ (rot32(wm15, 18)) ^ (wm15 >>> 3);
            long wm2 = w[i - 2];
            long s1 = (rot32(wm2, 17)) ^ (rot32(wm2, 19)) ^ (wm2 >>> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xFFFFFFFFL;
            i = i + 1;
        }
        long a = h[0]; long b = h[1]; long c = h[2]; long d = h[3];
        long e = h[4]; long f = h[5]; long g = h[6]; long hh = h[7];
        i = 0;
        while (i < 64) {
            long S1 = (rot32(e, 6)) ^ (rot32(e, 11)) ^ (rot32(e, 25));
            long ch = (e & f) ^ (~e & g);
            long t1 = (hh + S1 + ch + K[i] + w[i]) & 0xFFFFFFFFL;
            long S0 = (rot32(a, 2)) ^ (rot32(a, 13)) ^ (rot32(a, 22));
            long maj = (a & b) ^ (a & c) ^ (b & c);
            long t2 = (S0 + maj) & 0xFFFFFFFFL;
            hh = g; g = f; f = e;
            e = (d + t1) & 0xFFFFFFFFL;
            d = c; c = b; b = a;
            a = (t1 + t2) & 0xFFFFFFFFL;
            i = i + 1;
        }
        h[0] = (h[0] + a) & 0xFFFFFFFFL;
        h[1] = (h[1] + b) & 0xFFFFFFFFL;
        h[2] = (h[2] + c) & 0xFFFFFFFFL;
        h[3] = (h[3] + d) & 0xFFFFFFFFL;
        h[4] = (h[4] + e) & 0xFFFFFFFFL;
        h[5] = (h[5] + f) & 0xFFFFFFFFL;
        h[6] = (h[6] + g) & 0xFFFFFFFFL;
        h[7] = (h[7] + hh) & 0xFFFFFFFFL;
    }

    // 从暂存块视图展开前 16 个字(写进 w);与 rounds256 分离是因为
    // Span 视图只能作局部变量,不能作形参。
    static void sched256(long[] w, Span<byte> b) {
        int j = 0;
        while (j < 16) {
            w[j] = (b[j * 4] << 24) | (b[j * 4 + 1] << 16) | (b[j * 4 + 2] << 8) | b[j * 4 + 3];
            j = j + 1;
        }
    }

    // void zan_sha256(const void *data, long long len, unsigned char *md)
    public static void sha256(nint data, long len, nint md) {
        long[] K = new long[] {
            0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
            0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
            0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
            0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
            0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
            0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
            0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
            0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
        };
        long[] h = new long[] {
            0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
            0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
        };
        long total = len > 0 ? len : 0;
        long off = 0;
        nint blk = malloc(64);
        Span<byte> b = new Span<byte>(blk, 64);
        while (off + 64 <= total) {
            memcpy(blk, data + off, 64);
            long[] w = new long[64];
            sched256(w, b);
            rounds256(h, K, w);
            off = off + 64;
        }
        memset(blk, 0, 64);
        int t = (int)(total - off);
        memcpy(blk, data + off, t);
        b[t] = 0x80;
        if (t + 1 > 56) {
            long[] w = new long[64];
            sched256(w, b);
            rounds256(h, K, w);
            memset(blk, 0, 64);
        }
        long bits = total * 8;
        int i8 = 0;
        while (i8 < 8) {
            b[56 + i8] = (byte)((bits >>> (56 - 8 * i8)) & 255);
            i8 = i8 + 1;
        }
        long[] wf = new long[64];
        sched256(wf, b);
        rounds256(h, K, wf);
        Span<byte> outv = new Span<byte>(md, 32);
        int i = 0;
        while (i < 8) {
            outv[i * 4] = (byte)(h[i] >>> 24);
            outv[i * 4 + 1] = (byte)((h[i] >>> 16) & 255);
            outv[i * 4 + 2] = (byte)((h[i] >>> 8) & 255);
            outv[i * 4 + 3] = (byte)(h[i] & 255);
            i = i + 1;
        }
        free(blk);
    }

    // SHA-512 压缩函数
    static void rounds512(long[] h, long[] K, long[] w) {
        int i = 16;
        while (i < 80) {
            long wm15 = w[i - 15];
            long s0 = (rot64(wm15, 1)) ^ (rot64(wm15, 8)) ^ (wm15 >>> 7);
            long wm2 = w[i - 2];
            long s1 = (rot64(wm2, 19)) ^ (rot64(wm2, 61)) ^ (wm2 >>> 6);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
            i = i + 1;
        }
        long a = h[0]; long b = h[1]; long c = h[2]; long d = h[3];
        long e = h[4]; long f = h[5]; long g = h[6]; long hh = h[7];
        i = 0;
        while (i < 80) {
            long S1 = (rot64(e, 14)) ^ (rot64(e, 18)) ^ (rot64(e, 41));
            long ch = (e & f) ^ (~e & g);
            long t1 = hh + S1 + ch + K[i] + w[i];
            long S0 = (rot64(a, 28)) ^ (rot64(a, 34)) ^ (rot64(a, 39));
            long maj = (a & b) ^ (a & c) ^ (b & c);
            long t2 = S0 + maj;
            hh = g; g = f; f = e;
            e = d + t1;
            d = c; c = b; b = a;
            a = t1 + t2;
            i = i + 1;
        }
        h[0] = h[0] + a;
        h[1] = h[1] + b;
        h[2] = h[2] + c;
        h[3] = h[3] + d;
        h[4] = h[4] + e;
        h[5] = h[5] + f;
        h[6] = h[6] + g;
        h[7] = h[7] + hh;
    }

    static void sched512(long[] w, Span<byte> b) {
        int j = 0;
        while (j < 16) {
            long word = 0;
            int k = 0;
            while (k < 8) {
                word = (word << 8) | b[j * 8 + k];
                k = k + 1;
            }
            w[j] = word;
            j = j + 1;
        }
    }

    // void zan_sha512(const void *data, long long len, unsigned char *md)
    public static void sha512(nint data, long len, nint md) {
        long[] K = new long[] {
            0x428a2f98d728ae22L, 0x7137449123ef65cdL, 0xb5c0fbcfec4d3b2fL, 0xe9b5dba58189dbbcL,
            0x3956c25bf348b538L, 0x59f111f1b605d019L, 0x923f82a4af194f9bL, 0xab1c5ed5da6d8118L,
            0xd807aa98a3030242L, 0x12835b0145706fbeL, 0x243185be4ee4b28cL, 0x550c7dc3d5ffb4e2L,
            0x72be5d74f27b896fL, 0x80deb1fe3b1696b1L, 0x9bdc06a725c71235L, 0xc19bf174cf692694L,
            0xe49b69c19ef14ad2L, 0xefbe4786384f25e3L, 0x0fc19dc68b8cd5b5L, 0x240ca1cc77ac9c65L,
            0x2de92c6f592b0275L, 0x4a7484aa6ea6e483L, 0x5cb0a9dcbd41fbd4L, 0x76f988da831153b5L,
            0x983e5152ee66dfabL, 0xa831c66d2db43210L, 0xb00327c898fb213fL, 0xbf597fc7beef0ee4L,
            0xc6e00bf33da88fc2L, 0xd5a79147930aa725L, 0x06ca6351e003826fL, 0x142929670a0e6e70L,
            0x27b70a8546d22ffcL, 0x2e1b21385c26c926L, 0x4d2c6dfc5ac42aedL, 0x53380d139d95b3dfL,
            0x650a73548baf63deL, 0x766a0abb3c77b2a8L, 0x81c2c92e47edaee6L, 0x92722c851482353bL,
            0xa2bfe8a14cf10364L, 0xa81a664bbc423001L, 0xc24b8b70d0f89791L, 0xc76c51a30654be30L,
            0xd192e819d6ef5218L, 0xd69906245565a910L, 0xf40e35855771202aL, 0x106aa07032bbd1b8L,
            0x19a4c116b8d2d0c8L, 0x1e376c085141ab53L, 0x2748774cdf8eeb99L, 0x34b0bcb5e19b48a8L,
            0x391c0cb3c5c95a63L, 0x4ed8aa4ae3418acbL, 0x5b9cca4f7763e373L, 0x682e6ff3d6b2b8a3L,
            0x748f82ee5defb2fcL, 0x78a5636f43172f60L, 0x84c87814a1f0ab72L, 0x8cc702081a6439ecL,
            0x90befffa23631e28L, 0xa4506cebde82bde9L, 0xbef9a3f7b2c67915L, 0xc67178f2e372532bL,
            0xca273eceea26619cL, 0xd186b8c721c0c207L, 0xeada7dd6cde0eb1eL, 0xf57d4f7fee6ed178L,
            0x06f067aa72176fbaL, 0x0a637dc5a2c898a6L, 0x113f9804bef90daeL, 0x1b710b35131c471bL,
            0x28db77f523047d84L, 0x32caab7b40c72493L, 0x3c9ebe0a15c9bebcL, 0x431d67c49c100d4cL,
            0x4cc5d4becb3e42b6L, 0x597f299cfc657e2aL, 0x5fcb6fab3ad6faecL, 0x6c44198c4a475817L
        };
        long[] h = new long[] {
            0x6a09e667f3bcc908L, 0xbb67ae8584caa73bL, 0x3c6ef372fe94f82bL, 0xa54ff53a5f1d36f1L,
            0x510e527fade682d1L, 0x9b05688c2b3e6c1fL, 0x1f83d9abfb41bd6bL, 0x5be0cd19137e2179L
        };
        long total = len > 0 ? len : 0;
        long off = 0;
        nint blk = malloc(128);
        Span<byte> b = new Span<byte>(blk, 128);
        while (off + 128 <= total) {
            memcpy(blk, data + off, 128);
            long[] w = new long[80];
            sched512(w, b);
            rounds512(h, K, w);
            off = off + 128;
        }
        memset(blk, 0, 128);
        int t = (int)(total - off);
        memcpy(blk, data + off, t);
        b[t] = 0x80;
        if (t + 1 > 112) {
            long[] w = new long[80];
            sched512(w, b);
            rounds512(h, K, w);
            memset(blk, 0, 128);
        }
        long bits = total * 8;
        int i8 = 0;
        while (i8 < 8) {
            b[120 + i8] = (byte)((bits >>> (56 - 8 * i8)) & 255);
            i8 = i8 + 1;
        }
        long[] wf = new long[80];
        sched512(wf, b);
        rounds512(h, K, wf);
        Span<byte> outv = new Span<byte>(md, 64);
        int i = 0;
        while (i < 8) {
            int j = 0;
            while (j < 8) {
                outv[i * 8 + j] = (byte)((h[i] >>> (56 - 8 * j)) & 255);
                j = j + 1;
            }
            i = i + 1;
        }
        free(blk);
    }
}

// ngen 要求入口:占位 Main,链接前由 localize_syms.py 本地化,
// 不会与程序的 _main 冲突。
class zancrt {
    public static void Main() {
    }
}
